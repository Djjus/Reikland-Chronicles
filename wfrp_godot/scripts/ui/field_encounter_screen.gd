## same "open_menu" action (M) so the keybinding matches everywhere else
## in the game. Gated to exploration mode only (see _unhandled_input) —
## this doesn't touch monster-combat turns at all.
const CHARACTER_MENU_SCENE := preload("res://scenes/CharacterMenu.tscn")
var character_menu: CanvasLayer = null

## True for the WHOLE visit once exploration mode has been activated —
