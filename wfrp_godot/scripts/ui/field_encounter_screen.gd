## Each active Fear/Terror source's own Rating, per ally (same nesting
## as _fear_sources) — the Extended Test target SL needs to reach/
## exceed to overcome it (see _tick_fear_extended_tests()).
var _fear_rating: Dictionary = {}
## Running Extended Test (p.126) total toward overcoming Fear, per ally
## per source — see _tick_fear_extended_tests().
var _fear_extended_sl: Dictionary = {}

## Records `ally` as newly Subject to Fear (or Terror, which causes Fear
## at the same Rating once its own Psychology Test resolves) from `m`,
## resetting the Extended Test tally that will chip away at it every
## Round from here — see _tick_fear_extended_tests().
func _mark_fear_source(ally: Character, m: Character, rating: int) -> void:
	if not _fear_sources.has(ally):
		_fear_sources[ally] = {}
	_fear_sources[ally][m] = true
	if not _fear_rating.has(ally):
		_fear_rating[ally] = {}
	_fear_rating[ally][m] = rating
	if not _fear_extended_sl.has(ally):
		_fear_extended_sl[ally] = {}
	_fear_extended_sl[ally][m] = 0

## Reverse direction of the three Dictionaries above: monsters made
## Subject to Fear of an ALLY, via that ally's own Frightening Talent
## (toggled on — see frightening_active) rather than a monster's Fear/
## Terror Creature Trait. Same nesting shape with the roles of "the
## scared one" and "the source" swapped (Character (monster) ->
## Dictionary (Character (ally) -> true/rating/running SL)) — see
## _check_reverse_fear_from_frightening(), _tick_fear_extended_tests()'s
## own monster loop, and _apply_reverse_fear_approach_checks().
var _monster_fear_sources: Dictionary = {}
var _monster_fear_rating: Dictionary = {}
var _monster_fear_extended_sl: Dictionary = {}
## Which (monster, ally-source) pairs have already had their one-shot
## initial Fear Psychology Test resolved (pass or fail) — see
## _check_reverse_fear_from_frightening()'s own comment for why this
## exists (stops toggle-spam from re-rolling the same monster). Character
## (monster) -> Dictionary (Character (ally) -> true).
var _monster_fear_tested: Dictionary = {}

## Reverse-direction mirror of _mark_fear_source() above, for a monster
## newly Subject to Fear of a Frightening ally.
func _mark_monster_fear_source(m: Character, ally: Character, rating: int) -> void:
	if not _monster_fear_sources.has(m):
		_monster_fear_sources[m] = {}
	_monster_fear_sources[m][ally] = true
	if not _monster_fear_rating.has(m):
		_monster_fear_rating[m] = {}
	_monster_fear_rating[m][ally] = rating
	if not _monster_fear_extended_sl.has(m):
		_monster_fear_extended_sl[m] = {}
	_monster_fear_extended_sl[m][ally] = 0
