## Safety net for a real, reported bug: "combat flow stopped and i cant
## do anything" — a screenshot showed a live battle, Round 2, several
## turns already resolved in the Combat Log, with the Turn Order panel
## confirming it was a monster's own turn (an already-badly-hurt Highway
## Bandit) — and then nothing: no further log entry, no defense prompt,
## no Continue/Fortune choice, the bottom action panel empty, completely
## unresponsive. Nothing here throws a catchable error (GDScript has no
## try/catch), and an exported build shows the player no console — so if
## _do_monster_turn()/_monster_attack() (or anything they call) ever hits
## an edge case that halts the coroutine partway through — a bad
## dictionary lookup, or some other not-yet-understood gap — the whole
## encounter is wedged forever with zero visible symptom to explain why,
## and the only way out is abandoning the run. Every legitimate "waiting
## on the player" state already has its own flag (pending_defense,
## awaiting_continue/awaiting_fortune_choice, awaiting_player_target,
## awaiting_deathblow_choice) — _start_monster_turn_watchdog() below
## fires once per monster turn dispatch and, if none of those are set and
## the turn genuinely hasn't moved on after a generous grace period,
## force-ends the stalled turn itself rather than leaving the player with
## a dead game and no way to even see the fight was still winnable.
var _monster_turn_watchdog_token: int = 0
## Generous on purpose — a boss chaining Additional Effort/Extra Action
## through 2-3 attacks, each with its own 0.6s "thinking beat" plus
## roll-card review, can legitimately take several real seconds. This
## only ever fires for a turn that's gone far beyond any of that. A
## plain var (not a const) purely so a test can shrink it instead of
## genuinely waiting 15 real seconds to exercise this.
var _monster_turn_watchdog_grace_seconds: float = 15.0

## Per the reported combat stall (Round 18, frozen on the Wight's turn,
## action panel completely empty, nothing clickable): the flags check
## just below used to be the WHOLE test, on the assumption that any of
## these being set always means a real prompt is on screen. That broke
## for exactly this bug — a crash (e.g. the old unguarded
## `weapons[player]` index _weapon_for() now replaces) inside a
## flag-setting function like _prompt_player_defense() can set
## pending_defense/awaiting_player_target and then abort BEFORE any
## Button actually gets added to the screen, leaving the watchdog
## permanently convinced this is a "legitimate wait" with nothing the
## player can ever click. _has_any_actionable_button() closes that gap
## structurally — for ANY future flag-setting function, not just this
## one line — by also requiring real, visible proof of a live prompt,
## not just the flag's word for it.
func _has_any_actionable_button() -> bool:
	return _subtree_has_button(target_container) or _subtree_has_button(side_actions_container)

func _subtree_has_button(node: Node) -> bool:
	if node == null:
		return false
	if node is Button:
		return true
	for child in node.get_children():
		if _subtree_has_button(child):
			return true
	return false

func _start_monster_turn_watchdog(actor: Character) -> void:
	_monster_turn_watchdog_token += 1
	var my_token := _monster_turn_watchdog_token
	await get_tree().create_timer(_monster_turn_watchdog_grace_seconds).timeout
	if my_token != _monster_turn_watchdog_token:
		return   ## a newer turn (this actor's or anyone else's) already started
	if battle_over or not is_instance_valid(self):
		return
	if encounter.get_current_combatant() != actor:
		return   ## the turn already progressed normally — nothing to do
	var flag_claims_legitimate_wait: bool = not pending_defense.is_empty() or awaiting_continue \
			or awaiting_fortune_choice or awaiting_player_target or awaiting_deathblow_choice
	if not flag_claims_legitimate_wait or not _has_any_actionable_button():
		## Real bug fix, per the report ("monster turns are stalling"):
		## confirmed via a live repro harness that this force-skip used to
		## call _next_turn() WITHOUT ever clearing whichever "waiting on
		## the player" flag caused it to look stuck in the first place —
		## most importantly pending_defense, which is ONLY ever cleared by
		## _prompt_player_turn() (the next fresh ALLY turn) or
		## _resolve_player_defense() (an actual answered defense choice).
		## Neither of those runs here. The result: once a single defense
		## prompt was ever abandoned this way, pending_defense stayed
		## permanently non-empty for every Turn in between right up until
		## the next ally Turn happened to reset it — and EVERY monster
		## Turn in that window shares this same pending_defense Dictionary,
		## so every one of them hit its own `if not pending_defense.
		## is_empty(): return` guard (meant to catch "my own attack this
		## Turn just triggered a fresh defense choice") and bailed out
		## immediately without ever actually acting, which this same
		## watchdog then (correctly, given the stale flag) flagged as
		## ANOTHER stall — cascading into exactly the repeated "so-and-
		## so's turn stalled" pattern for multiple different monsters in
		## the same fight the report described, from a single root
		## cause. Clearing every one of these sticky flags here, right
		## before force-advancing, means a forced skip actually starts
		## the next Turn with a clean slate instead of poisoning every
		## Turn until the next ally Turn happens to come around.
		pending_defense = {}
		awaiting_continue = false
		awaiting_fortune_choice = false
		awaiting_overcast_choice = false
		awaiting_deathblow_choice = false
		_add_notice("[color=#c9564b][b]%s[/b]'s turn stalled unexpectedly — skipping it so the fight can continue.[/color]" % actor.character_name)
		_render_status()
		_next_turn()

## Combat Encounter rework, Phase 1b: the tactical battle grid this
## encounter is playing out on (see battle_grid.gd), and every living
## combatant's current square on it. Built once by _setup_battle_grid()
## right after every combatant is added in _start_encounter(), then kept
## up to date as Move/Run/Charge/monster-movement change positions.
var battle_grid: BattleGrid = null
var battle_positions: Dictionary = {}   ## Character -> Vector2i
## Per the request ("correctly implement and add the duration based
## element for Great Fires of U'Zhul and Firewall. Lingering AoE
## effects should be fully removed after combat"): a real ground
## hazard system -- neither spell's own lingering fire is tied to any
## Character (unlike active_buffs or the flaming_sword_* fields), it
## belongs to the SQUARES themselves, so anyone who stands there
## (including someone who wasn't even present at the original cast)
## takes it. Each entry: {name: String, squares: Dictionary
## (Vector2i -> true), rounds_remaining: int, damage_dice: String
## ("1d10" or "" for none), damage_flat: int, ignore_armour: bool,
## ablaze_stacks: int}. Ticked once per real Round wrap by
## _tick_persistent_aoe_hazards() (see _next_turn()'s own
## round_number != round_before gate), and explicitly cleared in
## _end_battle() AND both _start_encounter()/_start_exploration_mode()
## sites (a dungeon room-to-room transition never calls _end_battle()
## at all) so a hazard from one fight can never leak into the next.
var persistent_aoe_hazards: Array = []
## Breath spell (p.166, Smoke type — see _apply_cast_spell_outcome's own
## "Breath" branch and _breath_type_for_lore): "The area fills with
## smoke, blocking Line of Sight for Toughness Bonus Rounds." Unlike
## persistent_aoe_hazards above (which deal damage but never touch
## targeting), a smoke cloud actually blocks sight — its squares are
## added straight into battle_grid.blocks_los (the same Dictionary
## has_line_of_sight()/get_ranged_cover() already read walls and
## obstacles from) for as long as any cloud still covers them.
## _smoke_square_refcount counts how many currently-active clouds cover
## each square, so a square shared by two overlapping casts (or one
## that also happens to already be a real wall) isn't un-blocked the
## instant just ONE of them expires. Each entry: {squares: Dictionary
## (Vector2i -> true), rounds_remaining: int}. Ticked alongside
## persistent_aoe_hazards by _tick_persistent_aoe_hazards(), and
## cleared at the exact same three reset points (see that var's own
## declaration comment) so a cloud from one fight can never leak into
## the next.
var active_smoke_clouds: Array = []
var _smoke_square_refcount: Dictionary = {}   ## Vector2i -> int
## Flight (Rating) (p.343): "As the creature's Move, it can fly up to
## Rating yards... At the end of the move, it decides whether it has
## landed or is still flying." This project has no altitude/height
## tracking at all, so "flying" is modelled as a sparse per-battle
## runtime flag (Character -> true once airborne), same Dictionary-
## keyed-by-Character convention as battle_positions/_fear_sources
## above rather than a field on Character itself — this is transient
## combat state, not a persistent stat. Absence means grounded. Once a
## Flight-capable creature takes to the air (see _monster_move_toward/
## _advance_toward_flying) it simply stays flying for the rest of the
## battle in this simplified model — cleared only by a real Falling
## trigger (see _apply_falling_damage) or a fresh battle. See
## get_creature_trait_rating("Flight") for the yards-per-Turn budget,
## and BattleGrid.YARDS_PER_SQUARE for the yards<->squares conversion.
var currently_flying: Dictionary = {}   ## Character -> true while airborne this battle
## Per the request: Move/Run were merged into a single Move — there was
## never a functional difference between them here (neither costs the
## Action, only the distance differed), so Move now covers the full old
## Run range and is a spendable numeric budget rather than an
## all-or-nothing flag: `movement_remaining` starts at
## get_movement()*2 each fresh turn and drops by however many squares
## are actually used each time Move is committed, so it can be spent
## across several separate moves in the same turn (move partway, do
## something else, move again) rather than one use-it-or-lose-it click.
var movement_remaining: int = 0
## Per the request ("moving before firing a ranged weapon during the
## same turn should cause a -10 penalty to the attack roll"): Move and
## Fire (p.204). Set the instant any real movement (a committed Move,
## or the movement portion of a Charge) happens this Turn — see
## _try_commit_move() and _on_player_attack()'s own Charge branch —
## and only ever cleared at the start of a fresh Turn (same reset
## point movement_remaining itself uses), so it stays correctly set
## even if the ranged shot comes from a later Action this same Turn
## (Act Again) rather than immediately after the move.
var moved_this_turn: bool = false
## True while the click-to-move "arrow preview" is active — hovering
## the battle map shows a path from the mover's square to the cursor
## (see BattleGridView.square_hovered/set_preview_path), and clicking a
## highlighted square commits that leg of the move. Clicking Move again
## while this is true cancels the preview without moving.
var move_mode_active: bool = false
var _move_mode_reachable: Array = []   ## cached valid destinations for the current move_mode session, so a click can be validated without recomputing reachable_squares every time
## Per the request: right-click locks in a waypoint mid-move — a corner
## the eventual path is guaranteed to go through, letting the player
## change direction for the next leg — without committing anything; only
## a real left click ends move mode and actually relocates the mover
## (see _try_commit_move). Vector2i squares, in the order they were set.
## Cleared whenever a move-mode session starts or ends (see
## _enter_move_mode/_exit_move_mode/_on_sprint), so a stale waypoint from
## an earlier Move never bleeds into a later one.
var _move_waypoints: Array = []
## True only while move_mode_active is specifically the "where do you
## want to end up" step right after a successful Sprint (see _on_sprint)
## — committing that move ends the turn (Sprint already spent the
## Action) instead of reopening the normal action menu.
var sprint_finish_pending: bool = false
## Core rulebook Sprint (see _on_sprint): spends the Action itself for
## bonus movement, once per turn — only ever offered once
## movement_remaining has been fully spent, per the request.
var sprint_used_this_turn: bool = false
## Charge (p.157): "you cannot move backwards first and then charge on
## the same turn — a Charge requires using your turn's movement to rush
## directly toward an unengaged target; breaking away or stepping back
## first invalidates a direct charge sequence." Per-target (not a single
## turn-wide flag): a character may still Charge someone they've moved
## steadily TOWARD all turn even after stepping away from a DIFFERENT
## target earlier in the same turn — see _try_commit_move, the single
## real commit point for every player Move, for where this gets set.
## Reset at the start of every fresh turn alongside movement_remaining.
var _charge_blocked_targets: Dictionary = {}   ## Character -> true once the player has moved farther from them this turn

## Free-target AoE spells/prayers (Blast, Twin-tailed Comet): per the
## request, these place their effect by clicking a square on the battle
## map — mirrors move_mode_active's "highlight then click" flow, but for
## picking a point rather than a destination (see
## _enter_aoe_target_mode/_on_grid_square_clicked/_on_grid_square_hovered).
## Casting/Praying otherwise never touches the battle map, so this and
## move_mode_active are never both true at once in practice, but every
## check below still orders aoe_target_mode_active first defensively.
var aoe_target_mode_active: bool = false
## {"is_spell": bool, "name": String, "is_war_wizard_free": bool} for
## whichever cast is waiting on a map click — cleared by
## _exit_aoe_target_mode.
var _pending_aoe_cast: Dictionary = {}

## Single-target ranged Attack / Magic-Prayer targeting (per the
## request): "allow user to select the target after clicking the
## ranged attack/cast button but before the roll takes place ...
## complete attack roll once user clicks on a target." Mirrors
## aoe_target_mode_active's own "click Cast, then click the map"
## two-step shape, except the click has to land on one of the
## precomputed valid (in-range) targets rather than an arbitrary
## square — see _enter_ranged_target_mode/_resolve_ranged_target.
## Deliberately doesn't apply to melee (adjacency already gates it) or
## to self/AoE/"Special"-target spells and prayers (Breath's cone,
## every buff/utility effect) — those keep their existing flow.
var ranged_target_mode_active: bool = false
## {"kind": "attack"|"spell"|"prayer", plus whatever _resolve_ranged_target
## needs to finish the job: "weapon_override" for an attack,
## "spell_name"/"prayer_name" and "is_war_wizard_free" for a cast} —
## cleared by _exit_ranged_target_mode.
var _pending_ranged_action: Dictionary = {}
## Every living adversary currently within range of the pending ranged
## action, computed once at _enter_ranged_target_mode time (positions
## don't change mid-Turn — only the acting character's own Turn is
## live) — both what the map draws an arrow to and the only characters
## a click is allowed to resolve against.
var _ranged_valid_targets: Array = []
## Per the follow-up request ("do not lock in the pre-selected target
## right away, instead allow user to target freely, like when
## moving"): whichever of _ranged_valid_targets is currently under the
## cursor, live-tracked via _on_grid_square_hovered exactly the way
## move_mode_active already previews a path before a click commits it.
## Null until the player actually hovers a valid target — nothing is
## focused just from opening targeting mode. Cleared by
## _exit_ranged_target_mode.
var _ranged_focus_target: Character = null

## Exploration-mode rework: FieldEncounterScreen now natively supports an
## optional exploration phase before combat (map movement, fog of war, a
## party-only turn order, room/patrol triggers) in addition to its
## original job of running combat outright — see the big "Exploration
## mode" section below (right after _wire_combat_controls()) for the
## whole thing. Whether that phase runs at all is decided here, once, by
## _has_pending_exploration_map(): normal combat encounters (the vast
## majority) see no behavior change whatsoever — _start_encounter() runs
## immediately, exactly as before. Only when exploration content is
## actually pending (today: the Sewer dungeon, via GameState.dungeon_state
## / pending_dungeon_theme_id, set by RatCatcherGuildScreen's quest
## hand-off) does this screen start in the exploration layer instead,
## deferring _start_encounter() until a real trigger fires it in place.
## This used to live on a separate DungeonScreen.tscn/dungeon_screen.gd
## inherited scene/script that overrode _ready()/_on_return_pressed() —
## folded directly in here so the capability is a first-class, reusable
## part of the combat screen itself instead of a one-off subclass. See
## the project doc "Dungeon Encounter Screen Spec v1" for the history.
func _ready() -> void:
	## Prone auto-recovery spec: true for this screen's entire lifetime
	## (both combat and exploration submodes) — see
	## GameState.in_field_encounter's own declaration and
	## Character.wounds_current's setter for what this actually gates.
	## Cleared in _exit_tree() below.
	GameState.in_field_encounter = true
	_wire_combat_controls()
	## Per the request ("allow opening Character Menu during dungeon
	## exploring") — see character_menu's own declaration comment.
	character_menu = CHARACTER_MENU_SCENE.instantiate()
	add_child(character_menu)
	character_menu.closed.connect(_on_field_encounter_character_menu_closed)
	if _has_pending_exploration_map():
		## One-shot: consumed the moment this real dungeon entry is
		## actually acted on, same convention as pending_dungeon_theme_id
		## just below in _load_or_generate_dungeon(). See GameState.
		## dungeon_entry_requested's own header comment for why this
		## exists at all.
		GameState.dungeon_entry_requested = false
		## Real bug fix: BattleGridView.center_on() (used throughout
		## exploration mode to keep the cropped viewport on the party —
		## see _render_status()'s own dungeon-aware branch) needs the
		## view's real, laid-out pixel size to compute a correct
		## pan_offset. Called synchronously from _ready() before a
		## single frame has actually been drawn, grid_view.size is
		## still whatever placeholder the .tscn shipped with, not the
		## real on-screen size — producing a wildly wrong initial pan
		## that nothing corrects until some later, unrelated state
		## change happens to call _render_status() again with the by-
		## then-correct size. Waiting one frame here (layout has
		## already run by the time this resumes) costs nothing visible
		## and guarantees the very first dungeon view starts centered
		## correctly instead of looking like an empty black room.
		await get_tree().process_frame
		_start_exploration_mode()
	else:
		_start_encounter()

## Autosaves whenever the Character Menu closes while exploring a
## dungeon — same reasoning as Overworld's own _on_character_menu_closed
## (covers XP spends/equipment changes made while it was open, which
## don't otherwise trigger a save), and refreshes this screen's own
## status panel in case an equipped light source or armour changed.
func _on_field_encounter_character_menu_closed() -> void:
	GameState.autosave()
	if _exploration_mode:
		_render_status()

## _wire_combat_controls() stays split out of _ready() (unchanged from the
## original Dungeon Encounter Screen follow-up) so _start_exploration_mode()
## below can call this same wiring once, right before it shows the
## exploration layer — rather than duplicating these connections, or
## wiring a battle grid/return button that don't apply yet while the
## party is still exploring.
func _wire_combat_controls() -> void:
	return_button.pressed.connect(_on_return_pressed)
	return_button.disabled = true
	return_button.visible = false
	## Per the follow-up request ("instead of auto picking up loot, i
	## want a new pop up window with the battle report"): Close now
	## does what the old Return button used to (see
	## _on_close_battle_report), so the Return button itself is never
	## surfaced any more — left wired/hidden rather than removed
	## outright, in case a future screen needs a plain "return with no
	## report" path again.
	battle_report_close_button.pressed.connect(_on_close_battle_report)
	## Per the request: scrolls to the bottom automatically every time
	## the log's own layout genuinely finishes changing — sort_children
	## is VBoxContainer's own signal for exactly that moment, fired
	## after every child add/remove/resize has been fully accounted
	## for. Event-driven rather than guessing how many frames a
	## dynamically-wrapped RichTextLabel needs to finish sizing itself.
	history_list.sort_children.connect(_do_scroll_history_to_bottom)
	## Per the request: clicking an enemy's own token directly on the
	## battle map selects it as the target, same as clicking its portrait
	## in the top strip — unless move_mode_active, in which case the
	## click means "move here instead" (see _on_grid_square_clicked).
	grid_view.square_clicked.connect(_on_grid_square_clicked)
	## Right-click sets a waypoint mid-move (see _on_grid_square_right_clicked)
	## rather than committing anything.
	grid_view.square_right_clicked.connect(_on_grid_square_right_clicked)
	## Follow-up request ("allow zoomable maps to be dragged with left
	## click... or in move mode"): lets grid_view decide, live, whether
	## the current square click should stay immediate/precise (move
	## mode) or is free to become a drag-to-pan — see
	## BattleGridView.suppress_left_click_pan's own declaration comment.
	grid_view.suppress_left_click_pan = Callable(self, "_is_move_mode_active")
	## Drives the live Move arrow preview — see _on_grid_square_hovered.
	grid_view.square_hovered.connect(_on_grid_square_hovered)
	_setup_wasd_navigation()

## --- Exploration mode (Sewer dungeon today; general-purpose) -----------
## An optional phase FieldEncounterScreen can run instead of jumping
## straight into _start_encounter(): the generated dungeon tile grid
## REPLACES the normal terrain-snapshot battle map (same BattleGrid/
## BattleGridView this screen always uses — see BattleGrid.
## generate_from_dungeon_grid()), the party moves on it using the exact
## same Move action/movement rules combat already has, and the turn menu
## simply has no combat actions to offer while no monsters are present —
## Open Door/Exit are folded into the same "Movement / Free Actions"
## column combat already uses (see _render_turn_action_menu()). There is only ONE live
## CombatEncounter and ONE turn order for the whole visit — never a
## separate "exploration" encounter — so when a room's door opens or a
## hallway patrol rolls, the monsters that spawn are added directly to
## THIS SAME encounter/turn_order (see CombatEncounter.
## add_combatant_mid_round()) rather than starting a fresh fight; once
## they're all defeated, they simply drop out of contention the same way
## a defeated monster always does, and the very next turn's menu reverts
## to the exploration-only one automatically. No change_scene_to_file
## anywhere in the whole visit except the final "leave" (see
## _do_exit_dungeon() at the end of this section).
##
## Only ever activated when _has_pending_exploration_map() is true at
## _ready() — every other encounter on this screen behaves exactly as it
## always has; _exploration_mode defaults to false and every method below
## is only ever reached once that's been explicitly turned on. Data-wise
## this only ever reads/writes GameState.dungeon_state /
## pending_dungeon_theme_id today (the Sewer dungeon is the only
## producer), but nothing below assumes the content is specifically
## dungeon-shaped beyond that — a future second producer of the same
## fields would work here unmodified.

## True when there is exploration content waiting to be entered instead
## of jumping straight into combat.
##
## Real bug fix ("all outdoor field combat encounters jump to the Goblin
## Fort dungeon"): this used to be `not GameState.dungeon_state.is_empty()
## or GameState.pending_dungeon_theme_id != ""` — but dungeon_state
## deliberately survives a save/reload and is only ever cleared by a
## proper Exit at the dungeon's own entrance, so a party that left a
## dungeon visit unfinished (the Goblin Fort's own entry ambush now fires
## clear across the map from the entrance — see _maybe_fire_goblin_fort_
## entry_ambush() — so winning it and quitting without walking all the
## way back to Exit is an easy trap to fall into) got stuck with
## dungeon_state permanently non-empty. Since every field encounter of
## any kind — dungeon or not — transitions through this same
## FieldEncounter.tscn, that stale dungeon_state silently hijacked every
## later Overworld encounter (random ambush, wilderness tables, ambush
## markers, Gotheim's mob, etc.) into resuming the abandoned dungeon
## instead. See GameState.dungeon_entry_requested's own header comment
## for the full fix: only the real dungeon-entry call sites (walking onto
## a dungeon's own gate/entrance tile) ever set that flag, so it alone —
## not raw dungeon_state/pending_dungeon_theme_id presence — decides
## whether THIS PARTICULAR FieldEncounter.tscn load should resume
## exploration. Consumed immediately below so it's a genuine one-shot.
func _has_pending_exploration_map() -> bool:
	return GameState.dungeon_entry_requested

## The exploration-mode equivalent of _start_encounter() — sets up ONE
## real CombatEncounter for the whole visit (party only, no monsters yet)
## and drives it through the exact same _next_turn()/_prompt_player_turn()/
## _do_monster_turn() loop every normal fight uses, just starting with an
## all-ally turn_order and the dungeon itself as the battle_grid.
func _start_exploration_mode() -> void:
	GameState.ensure_player_character()
	player = GameState.player_character
	_pre_battle_equip.clear()
	for member in GameState.party:
		_pre_battle_equip[member] = {"weapon": member.equipped_weapon, "offhand": member.equipped_offhand}
	monsters.clear()
	monster_defs.clear()
	## See persistent_aoe_hazards' own declaration comment — a dungeon
	## room-to-room transition reaches this function without ever
	## calling _end_battle(), so it needs its own explicit clear too.
	persistent_aoe_hazards.clear()
	_clear_active_smoke_clouds()
	encounter = CombatEncounter.new()
	for member in GameState.party:
		encounter.add_combatant(member)
		weapons[member] = _resolve_weapon(member)
	## dungeon_theme has to be known before the darkness flags below can
	## be set correctly (an outdoor theme like the Goblin Fort reads
	## real time-of-day darkness, everything else stays fixed pitch
	## black), so the dungeon load moved ahead of them.
	_load_or_generate_dungeon()
	## Every dungeon theme so far (Sewer, Cave) is pitch black by
	## nature — these two flags drive the real combat-mechanics darkness
	## penalty (attacks in the dark are genuinely harder, see
	## DarknessVisionTest) for any fight that starts inside the dungeon.
	## Per the request ("the Greenskin fort dungeon map light should
	## match the time of day, as its got no roof"): an is_outdoor theme
	## instead reads the SAME real-clock darkness an ordinary outdoor
	## Overworld encounter already uses (GameState.get_night_darkness(),
	## see Overworld._enter_field_encounter()'s own pending_battle_is_dark
	## assignment) — dark at night, fully lit in daylight — and is never
	## treated as sealed pitch-black (there's always at least ambient sky
	## light with no roof overhead, so Night Vision/a faint light source
	## still works exactly like it does outdoors at night). The VISUAL
	## side of "dark unless lit" is handled entirely separately by
	## fog-of-war (grid.fog_of_war, see BattleGridView._draw_dungeon_
	## square()) — grid_view is always told is_dark=false for a dungeon
	## grid (see _render_status()'s own dungeon-aware branch below) so
	## the two darkness systems never double up.
	if dungeon_theme != null and dungeon_theme.is_outdoor:
		battle_is_dark = GameState.get_night_darkness() > 0.0
		battle_is_pitch_black = false
	else:
		battle_is_dark = true
		battle_is_pitch_black = true
	_setup_dungeon_battle_grid()
	encounter.roll_initiative()
	_snapshot_round_start()
	battle_over = false
	## Party-wipe rework: a fresh encounter starting inside the same
	## field_encounter_screen instance (dungeon room-to-room fights all
	## reuse this one node — see _hosted_by_exploration's own comment)
	## must not carry a stale _party_wiped=true forward from a PREVIOUS
	## fight's Battle Report into this new one.
	_party_wiped = false
	melee_has_begun = false
	_last_logged_round = -1
	_battle_loot_log.clear()
	_pending_loot.clear()
	_battle_gold_found = 0
	_battle_silver_found = 0
	_battle_brass_found = 0
	_fled_monsters.clear()
	monster_turn_count.clear()
	xp_awarded_for.clear()
	history.clear()
	selected_target = null
	defensive_stance_active = false
	_exploration_mode = true
	_hosted_by_exploration = true
	$OuterVBox.visible = true
	battle_report_overlay.visible = false
	return_button.disabled = true
	return_button.visible = false
	_maybe_fire_goblin_fort_entry_ambush()
	_refresh_enemy_display()
	_build_player_display()
	_next_turn()

## Per the Goblin Fort request ("random greenskin fight when they
## enter"): unlike the Sewer's per-segment wandering-monster roll (see
## _check_wandering_monsters()), this dungeon forces its one fight
## immediately and unconditionally the very first time the party sets
## foot inside — no detection roll, no way to avoid it, matching the
## request's own "fires immediately on entry, then explore to the
## chest" framing. Gated on dungeon_state's own entry_ambush_fired flag
## (see DungeonGenerator.generate_fixed_room()) so resuming an
## already-in-progress Goblin Fort visit (e.g. after a save/reload, or
## simply walking back onto the entrance tile) never re-fires it.
##
## Per the follow-up request ("the Greenskin should start at the other
## side of the map near the treasure chest"): spawned at the fort's own
## chest_pos (the far end from the entrance, per generate_fixed_room()'s
## own layout) rather than right on top of the party at their own
## entrance square — the greenskins are guarding their own loot, not
## waiting in the doorway, so the party has the whole fort to fight
## through/explore before actually reaching them.
func _maybe_fire_goblin_fort_entry_ambush() -> void:
	if dungeon_theme == null or dungeon_theme.theme_id != "goblin_fort":
		return
	if dungeon_state.get("entry_ambush_fired", false):
		return
	dungeon_state["entry_ambush_fired"] = true
	GameState.dungeon_state = dungeon_state
	var chest_pos: Vector2i = dungeon_state.get("chest_pos", dungeon_state.get("entrance_pos", Vector2i.ZERO))
	_spawn_monsters_during_exploration(_random_goblin_fort_ambush_names(), chest_pos, null)

## Randomized greenskin composition per the locked-in answer ("mix of
## Goblin/Forest Goblin/Orc, randomized count") — 3 to 5 attackers,
## weighted towards plain Goblins with Forest Goblins common and a
## real but lower chance of an Orc mixed in, matching how these three
## already read relative to each other elsewhere in this project (Orc
## is the toughest of the three, so it stays the rarest).
func _random_goblin_fort_ambush_names() -> Array[String]:
	var names: Array[String] = []
	var total := randi_range(3, 5)
	for i in range(total):
		var roll := randf()
		if roll < 0.15:
			names.append("Orc")
		elif roll < 0.55:
			names.append("Goblin")
		else:
			names.append("Forest Goblin")
	return names

## --- Goblin Fort chest -----------------------------------------------
## Ported 1:1 from Overworld's own hand-placed overworld-tile chest
## (see that script's own removed header comment for the original
## request) — same lock/trap/loot mechanics, "chest reward same as
## before," just addressed at dungeon_state's own chest_pos instead of
## a fixed world-map tile, driven by the exploration action-menu
## buttons below instead of Overworld's right-click radial menu, and
## surfaced through _add_notice() (this screen's own combat-log/notice
## mechanism) rather than Overworld's _show_info_popup(). State that
## used to live on GameState (goblin_fort_chest_locked/looted/
## trap_spotted) now lives directly on dungeon_state, which is
## regenerated fresh every time the party re-enters the fort — that
## naturally replaces the old fixed-8am relock/restock timer. The
## stashed-coin fields (goblin_fort_chest_stashed_bp/ss/gc) stay on
## GameState exactly as before, since they have to survive a party
## wipe even though dungeon_state itself gets wiped on one.

func _on_open_chest() -> void:
	if dungeon_state.get("chest_locked", true):
		return
	if not dungeon_state.get("chest_trap_spotted", false) and not dungeon_state.get("chest_looted", false):
		_trigger_chest_trap()
		return
	_loot_chest()

## Forces the chest open without needing to unlock it first — but, per
## the original request's own trap mechanic, forcing it open without
## having spotted the trap first is exactly as risky as opening it
## normally.
func _on_break_chest() -> void:
	if not dungeon_state.get("chest_locked", true):
		return
	if not dungeon_state.get("chest_trap_spotted", false) and not dungeon_state.get("chest_looted", false):
		_trigger_chest_trap()
		return
	dungeon_state["chest_locked"] = false
	GameState.dungeon_state = dungeon_state
	_loot_chest()

## +0 Perception Test to spot the trap, per the original request.
## Rolled by every present party member, same as the overworld version.
func _on_perception_chest() -> void:
	if dungeon_state.get("chest_looted", false):
		_add_notice("[i]The chest sits open and empty — whatever was here, someone's already taken it.[/i]")
		return
	var perception_def: SkillDefinition = GameData.skill_db.find_by_name("Perception")
	if perception_def == null:
		return
	var party_result := TestResolver.resolve_party_skill_test(GameState.party, perception_def)
	var result: TestResolver.TestResult = party_result["result"]
	var roller: Character = party_result["roller"]
	if result.success:
		dungeon_state["chest_trap_spotted"] = true
		GameState.dungeon_state = dungeon_state
		_add_notice("[i]%s spots it: a faint line in the wood, easy to miss — a needle trap, rigged to the lid. You'll know to avoid it now.[/i]" % roller.character_name)
	else:
		_add_notice("[i]Nothing obviously wrong with it, but that doesn't mean nothing's there.[/i]")

## Requires the real Pick Lock Skill to even attempt, same as before —
## rolled by whichever qualified party member is present.
func _on_pick_lock_chest() -> void:
	if not dungeon_state.get("chest_locked", true):
		return
	var pick_lock_def: SkillDefinition = GameData.skill_db.find_by_name("Pick Lock")
	if pick_lock_def == null:
		return
	var qualified: Array[Character] = []
	for member in GameState.party:
		if int(member.skill_advances.get("Pick Lock", 0)) > 0:
			qualified.append(member)
	if qualified.is_empty():
		return
	if not dungeon_state.get("chest_trap_spotted", false) and not dungeon_state.get("chest_looted", false):
		_trigger_chest_trap()
		return
	var party_result := TestResolver.resolve_party_skill_test(qualified, pick_lock_def)
	var result: TestResolver.TestResult = party_result["result"]
	var roller: Character = party_result["roller"]
	if result.success:
		dungeon_state["chest_locked"] = false
		GameState.dungeon_state = dungeon_state
		_add_notice("[i]%s works the lock — it gives with a satisfying click.[/i]" % roller.character_name)
		_loot_chest()
	else:
		_add_notice("[i]The lock doesn't budge. Maybe try again, or just break it open.[/i]")

## A hidden needle trap — real Wounds damage, not just a scare, exactly
## as before.
func _trigger_chest_trap() -> void:
	dungeon_state["chest_trap_spotted"] = true   ## sprung once, no longer a surprise
	GameState.dungeon_state = dungeon_state
	var dmg := 1 + randi() % 3
	player.wounds_current = max(0, player.wounds_current - dmg)
	_add_notice("[color=salmon]A needle springs from the lock as it gives — you feel a sharp sting. (%d Wound(s) lost.)[/color]" % dmg)

func _loot_chest() -> void:
	if dungeon_state.get("chest_looted", false):
		_add_notice("[i]Empty. Whatever was in here, it's already gone.[/i]")
		return
	var bp := Dice.roll_dice_string("2d20")
	var ss := Dice.roll_dice_string("1d10")
	var gc := 0
	## Coin lost to a failed idol-ambush fight was stashed rather than
	## deleted outright — added on top of this roll (never replacing
	## it) and cleared once claimed. Same as before.
	var had_stash: bool = GameState.goblin_fort_chest_stashed_bp > 0 or GameState.goblin_fort_chest_stashed_ss > 0 or GameState.goblin_fort_chest_stashed_gc > 0
	if had_stash:
		bp += GameState.goblin_fort_chest_stashed_bp
		ss += GameState.goblin_fort_chest_stashed_ss
		gc += GameState.goblin_fort_chest_stashed_gc
		GameState.goblin_fort_chest_stashed_bp = 0
		GameState.goblin_fort_chest_stashed_ss = 0
		GameState.goblin_fort_chest_stashed_gc = 0
	player.brass_pennies += bp
	player.silver_shillings += ss
	player.gold_crowns += gc
	dungeon_state["chest_looted"] = true
	GameState.dungeon_state = dungeon_state

	## The idol is only ever in this chest while the Elder's own quest
	## chain is genuinely at Stage 3 — same gating as before.
	var elder_q: Dictionary = player.get_elder_quest()
	var idol_stage_active: bool = not elder_q.is_empty() and int(elder_q.get("elder_stage", 0)) == 3 and not player.inventory.has("Stolen Idol")
	var coin_text := "%d Brass Pennies and %d Silver Shillings" % [bp, ss]
	if gc > 0:
		coin_text = "%d Gold Crowns, %s" % [gc, coin_text]
	if idol_stage_active:
		player.inventory.append("Stolen Idol")
		GameState.autosave()
		var recovered_note := " Whatever the goblins took off you last time is back too." if had_stash else ""
		_add_notice("[i]Inside: %s — and, wrapped in a scrap of oilcloth at the bottom, a small stone idol. Giessingen's idol.%s[/i]" % [coin_text, recovered_note])
		_trigger_idol_ambush()
		return

	GameState.autosave()
	_add_notice("[i]Inside: %s — goblin coin, but coin all the same.[/i]" % coin_text)

## Adapted from Overworld's own _trigger_idol_ambush(): the same
## instant, unavoidable idol-retrieval fight (2 Orc, 2 Goblin, "no
## chance to stop it") — but spawned directly into THIS already-active
## exploration encounter via _spawn_monsters_during_exploration() (the
## same mechanism the entry ambush and hallway wandering-monsters use)
## instead of transitioning to a brand new FieldEncounter scene, since
## the party is already standing in one.
## GameState.pending_idol_ambush still drives the "goblins recover
## everything on a party wipe" branch in _end_battle(), unchanged.
func _trigger_idol_ambush() -> void:
	GameState.pending_idol_ambush = true
	var names: Array[String] = ["Orc", "Orc", "Goblin", "Goblin"]
	_spawn_monsters_during_exploration(names, dungeon_state.get("chest_pos", Vector2i.ZERO), null)

## --- Setup ---------------------------------------------------------------

func _load_or_generate_dungeon() -> void:
	if not GameState.dungeon_state.is_empty():
		## Re-entering an already-generated dungeon (e.g. after a save/
		## reload mid-dungeon) — never regenerate over real progress.
		dungeon_state = GameState.dungeon_state
		dungeon_theme = GameData.dungeon_themes.get(str(dungeon_state.get("theme_id", "")))
		## Same-session floor-memory cache (see GameState.
		## dungeon_floor_states' own comment): make sure the floor we're
		## actually resuming on is recorded as cached too, so a later
		## _take_stairs_down()/_take_stairs_up() back to THIS floor
		## reuses it instead of finding the cache empty and regenerating
		## fresh.
		GameState.dungeon_floor_states[int(dungeon_state.get("dungeon_floor", 0))] = dungeon_state
	else:
		var theme_id: String = GameState.pending_dungeon_theme_id
		GameState.pending_dungeon_theme_id = ""
		dungeon_theme = GameData.dungeon_themes.get(theme_id)
		if dungeon_theme == null:
			dungeon_theme = GameData.dungeon_themes.get("sewer")
		var rng := RandomNumberGenerator.new()
		rng.randomize()
		if theme_id == "goblin_fort":
			## Per the request ("single large square area 8x16 cells"):
			## the Goblin Fort Dungeon is a hand-authored fixed room, not
			## a procedurally-branching layout — see
			## DungeonGenerator.generate_fixed_room()'s own header
			## comment for why this bypasses the normal generate().
			dungeon_state = DungeonGenerator.generate_fixed_room(dungeon_theme, 8, 16)
		else:
			dungeon_state = DungeonGenerator.generate(dungeon_theme, rng)
		GameState.dungeon_state = dungeon_state
		GameState.autosave()
		## Seed the same-session floor-memory cache with this freshly
		## generated ground floor (see GameState.dungeon_floor_states'
		## own comment) — _take_stairs_down()/_take_stairs_up() below
		## consult this cache before generating any later floor, so a
		## floor visited earlier this delve is resumed rather than
		## regenerated from scratch.
		GameState.dungeon_floor_states[int(dungeon_state.get("dungeon_floor", 0))] = dungeon_state
	## Real bug fix ("Goblin has 25 WS, this seems too low... not the
	## +20 to every Characteristic the fort's own Tier 2 should give"):
	## every DungeonThemeDefinition (Goblin Fort, Cave, Sewer all
	## currently declare difficulty_tier = 2) carries its own intended
	## Tier, but _spawn_monsters_during_exploration() — the ONE spawn
	## path every dungeon fight goes through (entry ambush, Quest/Lair/
	## Patrol rooms, hallway wandering monsters) — never reads that
	## field directly. It only ever reads GameState.current_field_
	## difficulty_tier, same shared value Overworld's own outdoor field
	## encounters use, and nothing on the way into a dungeon ever set it
	## to the dungeon's own tier — so every dungeon fight was silently
	## scaled to whatever tier the party's last OVERWORLD tile happened
	## to be, not the dungeon they were actually standing in. Set once,
	## right here, for every theme and on both the fresh-generate and
	## resume-an-existing-visit paths above (so a save/reload mid-
	## dungeon can't leave it stale either) — covers every dungeon fight
	## uniformly instead of the one-off fix _trigger_idol_ambush() used
	## to apply only for its own fight.
	##
	## Per the "Sewer/Cave Dungeons update 2" request ("Each floor down
	## will increase Difficulty tier by 1"): dungeon_state's own
	## dungeon_floor (0 on the ground floor, set by DungeonGenerator.
	## generate()/_take_stairs_down() below) is added on top of the
	## theme's own base tier. DifficultyTiers.get_bonus() self-clamps to
	## tier 5, and base tier 2 + the deepest floor (3) never exceeds that
	## ceiling, so this can never silently overflow.
	GameState.current_field_difficulty_tier = dungeon_theme.difficulty_tier + int(dungeon_state.get("dungeon_floor", 0))

## Builds battle_grid directly from the dungeon (BattleGrid.
## generate_from_dungeon_grid() — the real, 1:1 combat map, not a
## re-synthesized battlefield) and places every party member near the
## entrance. Called once at entry and again any time the dungeon's own
## grid_rows changes (a door opens) — see _refresh_dungeon_battle_grid().
##
## `spawn_anchor` lets a caller override WHERE "near the entrance" means
## for a fresh (battle_positions-empty) placement — per the bug report
## ("player is moved back to the down stairs in the quest room when
## coming back up from a lower dungeon level, right now its returning
## them to the Exit/Up"): _take_stairs_up() passes the arriving floor's
## own Quest room stairs_pos here instead of letting this default to
## entrance_pos, since entrance_pos on the ground floor is the dungeon's
## real world-map exit door, not a stairwell landing. Defaults to
## Vector2i(-1,-1), meaning "no override" — every other caller
## (dungeon entry, _take_stairs_down(), and the door-open/fog refresh
## path, which never even reaches the auto-placement branch) is
## unaffected and keeps anchoring on entrance_pos exactly as before.
func _setup_dungeon_battle_grid(spawn_anchor: Vector2i = Vector2i(-1, -1)) -> void:
	battle_grid = BattleGrid.new()
	battle_grid.generate_from_dungeon_grid(dungeon_theme, dungeon_state.get("grid_rows", []), dungeon_state.get("visibility", {}), dungeon_state.get("rooms", []))
	## Not derived from `rooms` (generate_from_dungeon_grid()'s own job)
	## since the fixed-room generator never populates rooms at all —
	## read straight from dungeon_state instead. (-1, -1) on any theme
	## without a chest_pos key, so this is a no-op for every dungeon
	## that isn't the Goblin Fort.
	battle_grid.chest_marker_pos = dungeon_state.get("chest_pos", Vector2i(-1, -1))
	## Per the request ("show the location of the entrance/exit... every
	## dungeon theme has an entrance_pos, not just the Goblin Fort, so
	## this is set unconditionally rather than gated to one theme like
	## the chest is.
	battle_grid.entrance_marker_pos = dungeon_state.get("entrance_pos", Vector2i(-1, -1))
	if battle_positions.is_empty():
		var entrance: Vector2i = spawn_anchor if spawn_anchor != Vector2i(-1, -1) else dungeon_state.get("entrance_pos", Vector2i.ZERO)
		var blocked: Dictionary = {}
		for member in GameState.party:
			var square: Vector2i = battle_grid.find_open_square_near(entrance, blocked)
			battle_positions[member] = square
			blocked[square] = true
		_reveal_around_party()
	else:
		## Rebuilding after a door opened/fog changed — every existing
		## party/monster position is kept exactly as-is; only the grid
		## itself (impassable/cell_texture/fog_of_war) is fresh.
		battle_grid.refresh_fog_of_war(dungeon_state.get("visibility", {}))

## Rebuilds battle_grid from the CURRENT dungeon_state (after a door
## opens, or just to push a fresh fog-of-war snapshot) and re-renders —
## dungeons are modest-sized and this only ever runs on a discrete,
## turn-based player action, so a full rebuild is simpler and safer than
## incrementally patching the grid's own impassable/cell_texture dicts.
func _refresh_dungeon_battle_grid() -> void:
	_setup_dungeon_battle_grid()
	_render_status()

## --- Fog of war / darkness ------------------------------------------------

## BFS from a single `center` out to `radius`, along open floor/door cells
## only (never through a still-closed door — this IS the mechanic that
## makes "open the door to see what's on the other side" true, not just
## narrative) — accumulates into the CALLER's own `reached`/`boundary`
## dictionaries rather than owning/committing them itself, so multiple
## light sources (every party member's own position, plus e.g. a just-
## opened door) can be unioned together into one shared visibility update
## instead of each stomping on the others' results (see _reveal_around_
## party()'s own comment for why that stomping used to be a real bug).
## Walls and closed doors themselves land in `boundary` wherever they
## border a reached floor/door cell — light stops AT their surface (never
## stepped through, so nothing beyond is revealed), but the surface
## itself is what's actually being looked at. Called twice per center
## by _commit_visibility_from_centers() — once at the bright (lit)
## radius, once at the dim (Initiative-Bonus ambient) radius — so this
## function itself has no opinion on bright vs dim; that's entirely the
## caller's choice of which radius (and which output dict) to pass in.
##
## Real bug fix, per the request ("light should not illuminate tiles a
## character holding a light source can not see"): the flood-fill walk
## below only ever stops at an actual wall/door/sealed-edge surface, so
## it happily wraps light around a 90-degree corner as long as there's
## a continuous run of open floor within `radius` steps — a torch held
## in a straight corridor doesn't actually bend around a corner like
## that; a tile still needs a genuinely unobstructed straight line back
## to `center` to count as lit, not just a short walkable path. The
## flood-fill itself is still what governs HOW FAR light reaches through
## a corridor (a straight Bresenham ray alone can't know to stop at
## radius along a winding path), so this keeps the walk as the first
## pass and then filters `local_reached` down to only the cells
## `battle_grid.has_line_of_sight(center, cell)` actually agrees are
## visible in a straight line — the exact same LOS check combat ranged
## attacks already use, reused here instead of inventing a second,
## subtly-different notion of "can see."
##
## `boundary` cells (a wall/door/sealed-edge surface right at the edge
## of a reached cell) are filtered differently: by whether the INTERIOR
## cell that discovered them (`boundary_source`) survives the same LOS
## filter, not by running has_line_of_sight on the boundary cell itself.
## This matters specifically for a sealed wall_edge boundary — its own
## "cells" pair (see BattleGrid.wall_edges) IS the exact edge
## has_line_of_sight()'s own _crosses_wall_edge check refuses to cross,
## so calling has_line_of_sight(center, boundary_cell) directly on one
## of those would always fail even for the immediately-adjacent case
## you're clearly meant to still see (the wall's own near face, right
## in front of you) — it was answering "can I see past this edge"
## instead of "can I see the surface of this edge," which are two
## different questions. Checking the source cell instead sidesteps that
## entirely: if you can see the floor tile right next to a wall, you
## can see that wall's surface too.
func _light_bfs(center: Vector2i, radius: int, reached: Dictionary, boundary: Dictionary) -> void:
	var local_reached: Dictionary = {}
	var local_boundary: Dictionary = {}
	var boundary_source: Dictionary = {}   ## boundary cell -> the interior reached cell that discovered it
	local_reached[center] = true
	if radius > 0:
		var frontier: Array = [center]
		for step in range(radius):
			var next_frontier: Array = []
			for cell in frontier:
				for d in [Vector2i(0, -1), Vector2i(0, 1), Vector2i(-1, 0), Vector2i(1, 0)]:
					var nxt: Vector2i = cell + d
					if local_reached.has(nxt):
						continue
					var ch := _char_at(nxt)
					if ch == "":
						continue
					if ch == dungeon_theme.wall_char or ch == dungeon_theme.door_closed_char:
						local_boundary[nxt] = true   ## visible surface — light doesn't pass through it
						if not boundary_source.has(nxt):
							boundary_source[nxt] = cell
						continue
					## Per the request ("places where passage walls touch
					## rooms and there is no door... player should [not] be
					## able to see through them"): battle_grid's own
					## wall_edges (see its declaration comment) seal a
					## specific cell-to-cell boundary even though BOTH cells
					## stay independently walkable, so a raw _char_at() check
					## alone can't catch this case — it only ever sees solid
					## wall/door tiles.
					if battle_grid != null and battle_grid._edge_blocked(cell, nxt):
						local_boundary[nxt] = true   ## the far cell's own near face is still a visible surface, same as a wall
						if not boundary_source.has(nxt):
							boundary_source[nxt] = cell
						continue
					local_reached[nxt] = true
					next_frontier.append(nxt)
			frontier = next_frontier
	## The actual line-of-sight filter (see this function's own comment
	## above) — a no-op when there's no battle_grid to check against yet
	## (falls back to the old flood-fill-only behaviour rather than
	## discarding everything), which keeps this safe to call before the
	## very first _refresh_dungeon_battle_grid() of a fresh encounter.
	if battle_grid == null:
		for cell in local_reached.keys():
			reached[cell] = true
		for cell in local_boundary.keys():
			boundary[cell] = true
		return
	var filtered_reached: Dictionary = {}
	for cell in local_reached.keys():
		if battle_grid.has_line_of_sight(center, cell):
			filtered_reached[cell] = true
			reached[cell] = true
	for cell in local_boundary.keys():
		var source: Vector2i = boundary_source.get(cell, center)
		if filtered_reached.has(source):
			boundary[cell] = true

## Commits a fresh visibility snapshot built from the union of every
## `centers` entry's own `_light_bfs()` result, at TWO separate radii:
## per the request ("by default character should not be able to see
## further than their Initiative Bonus squares, this should be fog of
## war like brightness... lamp/lantern light distance should follow the
## normal rules") — every center gets a dim, fog-of-war-brightness ring
## out to _current_ambient_vision_radius() (always active, no light
## needed) UNDERNEATH a bright, fully-lit ring out to its OWN bright
## radius (only as far as THAT center's own active light source, or
## Dark Vision, actually reaches — see the `entry` handling below).
## Every previously currently-visible (2) cell downgrades to "explored
## memory" (1) first; dim is written before bright so a cell inside
## both rings ends up bright (2), never downgraded back to dim.
##
## Each entry in `centers` is either a bare Vector2i (uses
## _current_light_radius(), the best light anywhere in the party — for
## one-off reveals like a just-opened door, where there's no single
## "owner" character to check) or a {"pos": Vector2i, "bright_radius":
## int} Dictionary for a specific character's own personal light reach
## (see _reveal_around_party(), which builds one of these per party
## member so only whoever's actually carrying a lit source gets a
## bright circle of their own).
func _commit_visibility_from_centers(centers: Array) -> void:
	var visibility: Dictionary = dungeon_state.get("visibility", {})
	for key in visibility.keys():
		if int(visibility[key]) == 2:
			visibility[key] = 1
	var default_bright_radius: int = _current_light_radius()
	var dim_radius: int = _current_ambient_vision_radius()
	var bright_reached: Dictionary = {}
	var bright_boundary: Dictionary = {}
	var dim_reached: Dictionary = {}
	var dim_boundary: Dictionary = {}
	for entry in centers:
		var pos: Vector2i
		var bright_radius: int = default_bright_radius
		if entry is Dictionary:
			pos = entry["pos"]
			bright_radius = int(entry.get("bright_radius", default_bright_radius))
		else:
			pos = entry
		_light_bfs(pos, bright_radius, bright_reached, bright_boundary)
		_light_bfs(pos, dim_radius, dim_reached, dim_boundary)
	for cell in dim_reached.keys():
		visibility[cell] = 1
	for cell in dim_boundary.keys():
		visibility[cell] = 1
	for cell in bright_reached.keys():
		visibility[cell] = 2
	for cell in bright_boundary.keys():
		visibility[cell] = 2
	## Per the request ("player can still see the tiles behind door...
	## fix it so they can't"): _light_bfs() itself already refuses to
	## walk light PAST a closed door (see its own header comment) — every
	## cell it just added above is either the near-face surface (a real
	## boundary, correctly still visible) or genuinely reached through an
	## open path. But nothing before this point ever PRUNED a cell that
	## became visible some other way and is now stale: a room with two
	## doors where only one is open still has its OWN closed door's
	## interior tagged visible (arrived at via the open one — an existing
	## Dictionary entry this commit's own bright/dim reached-or-boundary
	## sets never touch, since visibility only ever gets ADDED to, never
	## taken away, once a cell has been seen). Swept here every commit:
	## for every room whose door is still closed, any of ITS OWN interior
	## floor cells (past its own near-face row — the near-face row itself
	## is deliberately skipped, same "see the surface, not through it"
	## rule as everywhere else) that isn't justified by THIS commit's own
	## reached/boundary sets gets its visibility cleared outright, rather
	## than being left however some earlier commit happened to leave it.
	## A room reachable via a different, already-open door of its own
	## keeps its real visibility untouched (it IS in one of the four sets
	## above); only genuinely-stale "seen once, shouldn't be any more"
	## memory behind a still-closed door gets pruned.
	for room in dungeon_state.get("rooms", []):
		if room.get("door_open", false):
			continue
		var anchor_v = room.get("door_pos")
		var dir_v = room.get("door_dir")
		var rect_v = room.get("rect")
		if anchor_v == null or dir_v == null or rect_v == null:
			continue
		var anchor: Vector2i = anchor_v
		var dir: Vector2i = dir_v
		var rect: Rect2i = rect_v
		if dir == Vector2i.ZERO:
			continue
		for y in range(rect.position.y, rect.position.y + rect.size.y):
			for x in range(rect.position.x, rect.position.x + rect.size.x):
				var cell := Vector2i(x, y)
				var diff: Vector2i = cell - anchor
				var along: int = diff.x * dir.x + diff.y * dir.y
				if along <= 0:
					continue   ## the door's own near-face row (door + pad cells) -- a real visible surface, untouched
				if bright_reached.has(cell) or dim_reached.has(cell) or bright_boundary.has(cell) or dim_boundary.has(cell):
					continue   ## justified by THIS commit -- e.g. reached via the room's own other, already-open door
				visibility.erase(cell)
	dungeon_state["visibility"] = visibility
	if battle_grid != null:
		battle_grid.refresh_fog_of_war(visibility)

## Recomputes visibility around a single `center` only — kept for
## call sites (and FieldEncounterExplorationTest) that genuinely want
## just one light source lit, not the whole party's.
func _reveal_around(center: Vector2i) -> void:
	_commit_visibility_from_centers([center])

## The REAL gameplay entry point: every LIVING party member currently on
## the dungeon grid lights up their own position (per the explicit
## request: "allow the same movement rules" — exploration mode gives
## every party member their own real, independent battle-grid position,
## not one shared leader token), unioned together so "what the party can
## see" is everyone's own light radius at once, not just whoever most
## recently moved. `extra_centers` lets a caller add one-off light
## sources on top (see _open_door_at(), which also lights the door cell
## itself even though the character opening it may not have moved).
##
## Real bug fix: this used to be built by calling the single-center
## _reveal_around() once per party member in a loop — but since each
## call independently re-demoted EVERY currently-visible cell back to
## "explored memory" before revealing its own one center, only the LAST
## party member processed in the loop ever ended up actually lit; every
## earlier member's own light silently regressed to memory the instant
## the next member's call ran. Fixed by computing every center's BFS
## into one shared reached/boundary set (via _light_bfs) and committing
## them all together in a single visibility update.
##
## Second real bug fix, per the request ("light sources should only
## cast light around the player holding it"): each member used to be
## handed the same _current_light_radius() — the single BEST light
## radius found ANYWHERE in the party — for their own bright circle,
## so a party member with no light of their own standing in a
## completely separate corridor from whoever actually held the lit
## lantern still got a full bright circle, as if they were personally
## carrying it too. Each center now carries its OWN _member_light_
## radius() instead, so only whoever's actually got an active light
## source (or their own Dark Vision) gets a bright circle; everyone
## else still gets the normal shared dim ambient ring around their own
## position (unaffected by this fix — see _current_ambient_vision_
## radius's own comment for why that one stays party-wide).
func _reveal_around_party(extra_centers: Array = []) -> void:
	var centers: Array = []
	for member in GameState.party:
		if battle_positions.has(member):
			centers.append({"pos": battle_positions[member], "bright_radius": _member_light_radius(member)})
	centers.append_array(extra_centers)
	_commit_visibility_from_centers(centers)

## Per-member version of _current_light_radius() below — the same
## yards -> squares conversion and Dark Vision fallback, but scoped to
## a single character's own light source/traits rather than the best
## found anywhere in the party. See _reveal_around_party()'s own
## comment for why this exists.
func _member_light_radius(member: Character) -> int:
	if member == null:
		return 0
	## Per the request ("the Greenskin fort dungeon map light should
	## match the time of day, as its got no roof") read as a VISIBILITY
	## statement, not just the combat-penalty one _start_exploration_
	## mode() already handles — a roofless fort in broad daylight is lit
	## by the sun itself, not limited to whatever a party lantern happens
	## to reach, exactly like an ordinary outdoor Overworld encounter is
	## never light-radius-limited in daylight either. Returned as a
	## BRIGHT (vis=2, no dark overlay — see _draw_dungeon_square()) radius
	## rather than merely widening the dim ambient ring, so the fort
	## actually reads as fully lit, not just a bigger grey fog patch.
	## _OUTDOOR_DAYLIGHT_RADIUS comfortably exceeds the Goblin Fort's own
	## fixed 8x16 room (see generate_fixed_room()'s own call site), so
	## this reveals the whole fort at once. Night falls through to the
	## normal light-source-driven radius below unchanged — an outdoor
	## theme after dark is still genuinely dark and still needs a real
	## light source to see past it, same as any other dungeon today.
	if dungeon_theme != null and dungeon_theme.is_outdoor and not battle_is_dark:
		return _OUTDOOR_DAYLIGHT_RADIUS
	var r_yd: int = member.get_active_light_radius_tiles()
	if r_yd > 0:
		return int(ceil(float(r_yd) / float(BattleGrid.YARDS_PER_SQUARE)))
	if member.has_creature_trait("Dark Vision"):
		return 10   ## same bright radius as a fully-open lantern — "as if it were daylight"
	return 0

## The BRIGHT (fully-lit, vis=2) radius in battle-grid squares — a real
## active light source, or (absent any light at all) Dark Vision's own
## "sees in the dark as if it were daylight" treated the same as a lit
## source rather than the dimmer ambient vision below. Per the request
## ("lamp/lantern light distance should follow the normal rules, 5
## squares when shuttered and 10 squares when fully opened"):
## Character.get_active_light_radius_tiles() actually returns YARDS
## (ItemDefinition.light_radius_tiles is yards despite its name — see
## the Lantern's own "Provides illumination for 20 yards" — 20yd/10yd
## low), so this now converts yards -> squares via BattleGrid.
## YARDS_PER_SQUARE, exactly matching normal combat's own
## _gather_battle_light_sources() conversion (20yd -> 10 squares lit,
## 10yd low -> 5 squares shuttered). A real bug fix: this used to feed
## the raw un-converted yards value straight in as a squares radius,
## lighting roughly DOUBLE the intended area (and, combined with the
## v0.2.516 "vision freezes once combat starts" bug, made it look like
## lighting a lantern mid-fight did nothing at all).
## Night Vision is deliberately NOT a fallback here any more — its own
## card text only ever extends an EXISTING light source's reach (see
## _darkness_penalty()'s own comment), it doesn't conjure light from
## nothing — so a Night Vision character with no light source now
## correctly falls through to the same Initiative-Bonus-based ambient
## vision everyone else gets, rather than a flat bright radius.
## The best radius found anywhere in the party — used only as the
## fallback for one-off, no-specific-owner reveals (see
## _commit_visibility_from_centers's own comment) and single-center
## test/utility call sites. Real per-party-member reveals go through
## _member_light_radius() instead, so only whoever's actually carrying
## the light gets a bright circle of their own — see
## _reveal_around_party()'s own comment for why that split exists.
func _current_light_radius() -> int:
	## Same outdoor-daylight override as _member_light_radius() above —
	## kept in sync so a one-off, no-specific-owner reveal (e.g. a door
	## just opened) gets the same full-fort daylight coverage a party
	## member's own reveal already does, rather than falling back to
	## whatever lantern radius happens to be lit.
	if dungeon_theme != null and dungeon_theme.is_outdoor and not battle_is_dark:
		return _OUTDOOR_DAYLIGHT_RADIUS
	var best := 0
	for member in GameState.party:
		if member == null:
			continue
		var r_yd: int = member.get_active_light_radius_tiles()
		if r_yd <= 0:
			continue
		var r_sq := int(ceil(float(r_yd) / float(BattleGrid.YARDS_PER_SQUARE)))
		if r_sq > best:
			best = r_sq
	if best > 0:
		return best
	for member in GameState.party:
		if member != null and member.has_creature_trait("Dark Vision"):
			return 10   ## same bright radius as a fully-open lantern — "as if it were daylight"
	return 0

## The DIM (fog-of-war brightness, vis=1 — never vis=2) radius in
## battle-grid squares, always active regardless of light. Per the
## request: "while in darkness by default character should not be able
## to see further then their Initiative Bonus squares, this should be
## fog of war like brightness (not like it is when lit up with light)."
## Best Initiative Bonus across the (living) party — same "shared party
## vision, not just whoever's turn it is" pattern _current_light_radius()
## already uses above.
func _current_ambient_vision_radius() -> int:
	var best := 0
	for member in GameState.party:
		if member == null:
			continue
		var ib: int = member.get_characteristic_bonus("initiative")
		if ib > best:
			best = ib
	return best

## --- Position/grid helpers --------------------------------------------

func _char_at(pos: Vector2i) -> String:
	var rows: Array = dungeon_state.get("grid_rows", [])
	if pos.y < 0 or pos.y >= rows.size():
		return ""
	var row: String = rows[pos.y]
	if pos.x < 0 or pos.x >= row.length():
		return ""
	return row[pos.x]

func _set_char_at(pos: Vector2i, ch: String) -> void:
	var rows: Array = dungeon_state.get("grid_rows", [])
	if pos.y < 0 or pos.y >= rows.size():
		return
	var row: String = rows[pos.y]
	if pos.x < 0 or pos.x >= row.length():
		return
	rows[pos.y] = row.substr(0, pos.x) + ch + row.substr(pos.x + 1)
	dungeon_state["grid_rows"] = rows

## A room's door is NOT its own separate tile — per the follow-up
## request ("have door attachable to existing passage and room tiles,
## don't make they have their own 2x2 tile") the generator now marks a
## CORRIDOR_SCALE-long, 1-cell-thick span of the ROOM's own near-face
## cells (the ones that directly border the corridor's rail) as the
## door, anchored at `room["door_pos"]` and running along whichever axis
## is perpendicular to `room["door_dir"]` (see _door_span_cells() below).
## _adjacent_closed_door() below can return ANY cell in that span —
## whichever one happens to be nearest the player — so this has to match
## every cell in the span, not just the anchor corner.
func _room_at_door(door_pos: Vector2i) -> Dictionary:
	for room in dungeon_state.get("rooms", []):
		if _door_span_cells(room).has(door_pos):
			return room
	return {}

## The CORRIDOR_SCALE cells that make up a room's own door span — see
## _room_at_door()'s own comment above for why a room's door is a short
## span of its own cells, not a single one and not a tile of its own.
func _door_block_cells(room: Dictionary) -> Array:
	return _door_span_cells(room).keys()

## Shared helper: builds the door span as a Dictionary (Vector2i -> true)
## for O(1) membership checks, since _room_at_door() above is called
## once per candidate cell in _adjacent_closed_door()'s own 3x3 scan.
func _door_span_cells(room: Dictionary) -> Dictionary:
	var anchor: Vector2i = room.get("door_pos")
	var dir: Vector2i = room.get("door_dir")
	var perp: Vector2i = Vector2i(0, 1) if dir.x != 0 else Vector2i(1, 0)
	var scale: int = DungeonGenerator.CORRIDOR_SCALE
	var cells: Dictionary = {}
	for i in range(scale):
		cells[anchor + perp * i] = true
	return cells

## Any closed-door cell within Chebyshev distance 1 of `pos` (including
## diagonals), or Vector2i(-1,-1) if none — the Open Door action's own
## "is this even available right now" gate. A room's door spans
## CORRIDOR_SCALE cells (see _door_span_cells() above), so any one of
## them being adjacent is enough — this check is purely char-based
## (whatever's actually rendered as door_closed_char), so it doesn't
## need to know the span's own shape at all.
func _adjacent_closed_door(pos: Vector2i) -> Vector2i:
	for dy in range(-1, 2):
		for dx in range(-1, 2):
			var cand: Vector2i = pos + Vector2i(dx, dy)
			if _char_at(cand) == dungeon_theme.door_closed_char:
				return cand
	return Vector2i(-1, -1)

## Per the bug report ("player can open/search furniture from other
## side of closed doors, fix that too"): a shared adjacency+clear-path
## gate for every interactable-object check below (chest, furniture,
## quest chest, stairs). Chebyshev distance 1 alone (the old check every
## one of these used) says nothing about whether a wall or a still-
## closed door actually separates `pos` from `target` — a corridor cell
## right outside a closed room's door is Chebyshev-adjacent to that
## room's near-face row despite the door being shut, which is exactly
## the false-positive the report's screenshot shows ("Search the
## Cupboard (Free)" enabled from the far side of a closed door).
##
## A REAL BUG FIX caught by testing before this shipped: the first cut
## of this routed through BattleGrid.has_clear_direct_path() (the
## existing movement/pathing primitive), reasoning that its destination
## square is "exempted" from the walkability check the same way a
## caller pathing onto an occupied/marker square already is elsewhere.
## That's wrong — _footprint_clear() actually checks
## _footprint_walkable(anchor) UNCONDITIONALLY first and only exempts
## the destination from the separate `blocked` (occupancy) dictionary
## afterward — so has_clear_direct_path() always returns false against
## any target square that's plain impassable, which furniture cells
## deliberately are (see "Character should not be able to walk on these
## new items"), and broke DungeonFurnitureSearchTest's own legitimate
## standing-right-beside-it case outright.
##
## What actually needs checking for an INTERACTION (never "walk onto
## it") adjacency, as opposed to a MOVEMENT destination, is only whether
## the single step between `pos` and `target` crosses a sealed boundary
## — a wall_edge (the cell-to-cell seal _add_wall_edge()/_edge_blocked()
## records for a room's own near-face wall segments) or, for a diagonal
## step, a corner-cut around one (_edge_blocked_diagonal(), which itself
## also folds in a genuinely impassable flank cell — e.g. a closed door
## sitting at the corner). `target`'s own walkability is deliberately
## never checked here.
func _has_clear_adjacency(pos: Vector2i, target: Vector2i) -> bool:
	if pos == target:
		return true
	if maxi(absi(pos.x - target.x), absi(pos.y - target.y)) > 1:
		return false
	if battle_grid == null:
		return true
	return not (battle_grid._edge_blocked(pos, target) or battle_grid._edge_blocked_diagonal(pos, target))

## Per the request ("allow players to interact with the chest when
## standing next to it, and do allow them to stand on it"): true when
## `pos` is the Goblin Fort's own chest_pos OR any of its 8 neighbours
## (Chebyshev distance 1) — same "on it or right next to it" shape as
## _adjacent_closed_door() above. The chest tile itself was never
## impassable to begin with (it's plain floor under the marker, see
## BattleGrid.chest_marker_pos's own comment — the marker is a pure
## visual overlay, not a blocking obstacle), so standing directly on it
## already worked and keeps working unchanged; this only widens the
## interaction range to also include the tiles around it, rather than
## requiring the party to physically stand exactly on the chest square.
##
## Now routed through _has_clear_adjacency() (see its own comment) so a
## chest just across a closed door/wall no longer reads as "near."
func _is_near_chest(pos: Vector2i) -> bool:
	var chest_pos: Vector2i = dungeon_state.get("chest_pos", Vector2i(-999, -999))
	return _has_clear_adjacency(pos, chest_pos)

## --- Room Furniture / procedural Quest room Treasure Chest ("Sewer/Cave
## Dungeons update") ------------------------------------------------------

const FURNITURE_LABELS := {
	"weapon_rack": "Weapon Rack",
	"cupboard": "Cupboard",
	"alchemy_table": "Alchemy Table",
	"torture_rack": "Torture Rack",
}

## Any room with an un-searched piece of furniture within a single
## Chebyshev step of `pos` (the item's own footprint cells OR any of
## their neighbours) — same "adjacency, not exact-tile" convention
## _is_near_chest()/_adjacent_chasm_jump() already use. Returns {} if
## nothing's in reach.
##
## Routed through _has_clear_adjacency() (see its own comment, added
## for the "player can open/search furniture from other side of closed
## doors" report) so a furniture piece one step INSIDE a still-closed
## room's door no longer counts as reachable from the corridor cell
## right outside it.
func _adjacent_furniture(pos: Vector2i) -> Dictionary:
	for room in dungeon_state.get("rooms", []):
		if room.get("furniture_type", "none") == "none":
			continue
		for c in room.get("furniture_cells", []):
			if _has_clear_adjacency(pos, c):
				return room
	return {}

## Same shape as _adjacent_furniture() above, for the procedural Quest
## room's own Treasure Chest (DungeonGenerator only ever sets a room's
## own chest_pos on the Quest room — see that field's own comment).
## Same closed-door fix as _adjacent_furniture() above.
func _adjacent_quest_chest(pos: Vector2i) -> Dictionary:
	for room in dungeon_state.get("rooms", []):
		var chest_pos: Vector2i = room.get("chest_pos", Vector2i(-1, -1))
		if chest_pos == Vector2i(-1, -1):
			continue
		if _has_clear_adjacency(pos, chest_pos):
			return room
	return {}

## Same shape as _adjacent_quest_chest() above, for the procedural Quest
## room's own stairs down to the next dungeon floor ("Sewer/Cave
## Dungeons update 2" request). Naturally returns {} on a Quest room
## that's already at the dungeon's deepest floor (DungeonGenerator
## leaves stairs_pos at (-1, -1) there — see MAX_DUNGEON_FLOOR). Same
## closed-door fix as _adjacent_furniture() above.
func _adjacent_stairs(pos: Vector2i) -> Dictionary:
	for room in dungeon_state.get("rooms", []):
		var stairs_pos: Vector2i = room.get("stairs_pos", Vector2i(-1, -1))
		if stairs_pos == Vector2i(-1, -1):
			continue
		if _has_clear_adjacency(pos, stairs_pos):
			return room
	return {}

## Resolves one piece of furniture's own Loot Table (D12), per the
## request's own exact wording for each of the four — Weapon Rack (1-6
## Nothing, 7-12 a random standard-quality Weapon), Cupboard (1-6
## Nothing, 7-10 3d6 Silver Shillings, 11-12 a random standard-quality
## Armour piece), Alchemy Table (1-6 Nothing, 7-9 3d6 Silver Shillings,
## 10-12 a Healing Draught), Torture Rack (1-6 Nothing, 7-12 Rope, 10
## yards). "Standard quality" per this project's own item_qualities/
## item_flaws convention (see ItemQualityRules) just means picking a
## base WeaponDefinition/ArmourDefinition by name with neither — this
## project's inventory is a flat Array[String] of names, so there's no
## separate "quality" to track beyond whichever base item got picked.
## A Free Action, same as the Goblin Fort chest's own Search — no roll
## on this ever costs the character's turn.
## Per the "Sewer/Cave Dungeons update 2" request ("Money rewards should
## multiply for each level after ground too"): 1 on the ground floor
## (no change from before this feature), 2 on floor 1, 3 on floor 2, and
## so on — a flat multiplier applied to the FINAL rolled Silver
## Shillings amount (rather than, say, scaling the number of dice
## rolled), the interpretation that most directly matches the word
## "multiply" in the request.
func _dungeon_money_multiplier() -> int:
	return 1 + int(dungeon_state.get("dungeon_floor", 0))

## Per the request above ("Weapon/Armor rewards should add 1 random Item
## quality per Dungeon level after the ground level"): rolls `count`
## random General Trapping Item Qualities (Durable/Fine/Lightweight/
## Practical — see ItemQualityRules.QUALITY_NAMES). A repeat roll of one
## of the two STACKABLE_QUALITIES (Durable/Fine) raises that quality's
## own rating ("Durable 2"); a repeat roll of either non-stackable
## quality (Lightweight/Practical) is simply dropped rather than counted
## twice, since RAW only allows those two to be taken once. Returns an
## empty Array for count <= 0 (the ground floor), same as before this
## feature existed.
func _roll_random_item_qualities(count: int) -> Array[String]:
	var counts: Dictionary = {}
	for i in range(count):
		var q_name: String = ItemQualityRules.QUALITY_NAMES.pick_random()
		if not ItemQualityRules.STACKABLE_QUALITIES.has(q_name) and counts.has(q_name):
			continue
		counts[q_name] = int(counts.get(q_name, 0)) + 1
	var out: Array[String] = []
	for q_name in counts.keys():
		var rating: int = counts[q_name]
		out.append(q_name if rating <= 1 else "%s %d" % [q_name, rating])
	return out

## Grants a Weapon Rack reward, rolling `dungeon_state`'s own
## dungeon_floor worth of random Item Qualities onto it first (0 on the
## ground floor grants the plain base weapon, unchanged from before this
## feature). Mirrors shop_screen.gd's own Crafting order flow
## (_on_place_craft_order()) exactly — the only established precedent in
## this project for a quality-tagged item: compose a name, duplicate-
## and-register a new WeaponDefinition the first time that exact
## combination is ever seen (reused afterward, same "same name, same
## stats, share one definition" convention the rest of this project's
## item system already follows), then add the composed name to
## inventory like any other item. Returns the name actually granted, for
## the caller's own "found a %s" notice text.
func _grant_weapon_reward(base: WeaponDefinition) -> String:
	var count: int = int(dungeon_state.get("dungeon_floor", 0))
	## _roll_random_item_qualities() already returns an empty Array[String]
	## for count <= 0 -- a ternary with a bare [] else-branch here would
	## silently degrade the whole expression to untyped Array and fail at
	## runtime when assigned to this typed var, so just call it directly.
	var item_qualities: Array[String] = _roll_random_item_qualities(count)
	if item_qualities.is_empty():
		player.inventory.append(base.weapon_name)
		return base.weapon_name
	var composed_name := "%s %s" % [" ".join(item_qualities), base.weapon_name]
	if GameData.weapon_db.find_by_name(composed_name) == null:
		var wd: WeaponDefinition = base.duplicate()
		wd.weapon_name = composed_name
		wd.item_qualities = item_qualities.duplicate()
		wd.item_flaws = []
		var derived := ItemQualityRules.compute_derived(base.price_pennies, base.availability, item_qualities, [], base.encumbrance)
		wd.price_pennies = int(derived["price_pennies"])
		wd.availability = String(derived["availability"])
		GameData.weapon_db.weapons.append(wd)
	player.inventory.append(composed_name)
	return composed_name

## Same as _grant_weapon_reward() above, for a Cupboard's Armour piece
## reward.
func _grant_armour_reward(base: ArmourDefinition) -> String:
	var count: int = int(dungeon_state.get("dungeon_floor", 0))
	## _roll_random_item_qualities() already returns an empty Array[String]
	## for count <= 0 -- a ternary with a bare [] else-branch here would
	## silently degrade the whole expression to untyped Array and fail at
	## runtime when assigned to this typed var, so just call it directly.
	var item_qualities: Array[String] = _roll_random_item_qualities(count)
	if item_qualities.is_empty():
		player.inventory.append(base.armour_name)
		return base.armour_name
	var composed_name := "%s %s" % [" ".join(item_qualities), base.armour_name]
	if GameData.armour_db.find_by_name(composed_name) == null:
		var ad: ArmourDefinition = base.duplicate()
		ad.armour_name = composed_name
		ad.item_qualities = item_qualities.duplicate()
		ad.item_flaws = []
		var derived := ItemQualityRules.compute_derived(base.price_pennies, base.availability, item_qualities, [], base.encumbrance)
		ad.price_pennies = int(derived["price_pennies"])
		ad.availability = String(derived["availability"])
		GameData.armour_db.pieces.append(ad)
	player.inventory.append(composed_name)
	return composed_name

func _search_furniture(room: Dictionary) -> void:
	if room.get("furniture_looted", false):
		return
	var ftype: String = room.get("furniture_type", "none")
	var label: String = FURNITURE_LABELS.get(ftype, "Furniture")
	var money_mult: int = _dungeon_money_multiplier()
	var found := ""
	match ftype:
		"weapon_rack":
			if Dice.roll_dice_string("1d12") >= 7:
				var w: WeaponDefinition = GameData.weapon_db.weapons.pick_random()
				if w != null:
					var granted_w: String = _grant_weapon_reward(w)
					found = "a %s" % granted_w
		"cupboard":
			var d: int = Dice.roll_dice_string("1d12")
			if d >= 7 and d <= 10:
				var ss: int = Dice.roll_dice_string("3d6") * money_mult
				player.add_pennies(ss * Character.PENNIES_PER_SHILLING)
				found = "%d Silver Shillings" % ss
			elif d >= 11:
				var a: ArmourDefinition = GameData.armour_db.pieces.pick_random()
				if a != null:
					var granted_a: String = _grant_armour_reward(a)
					found = "a %s" % granted_a
		"alchemy_table":
			var d2: int = Dice.roll_dice_string("1d12")
			if d2 >= 7 and d2 <= 9:
				var ss2: int = Dice.roll_dice_string("3d6") * money_mult
				player.add_pennies(ss2 * Character.PENNIES_PER_SHILLING)
				found = "%d Silver Shillings" % ss2
			elif d2 >= 10:
				player.inventory.append(HEALING_DRAUGHT)
				found = "a %s" % HEALING_DRAUGHT
		"torture_rack":
			if Dice.roll_dice_string("1d12") >= 7:
				player.inventory.append("Rope, 10 yards")
				found = "Rope, 10 yards"
	room["furniture_looted"] = true
	_persist_hazard_room(room)
	if found != "":
		_add_notice("[i]You search the %s and find %s![/i]" % [label, found])
	else:
		_add_notice("[i]You search the %s but find nothing of use.[/i]" % label)

## The procedural Quest room's own Treasure Chest — per the request,
## always UNTRAPPED (no Perception/Pick Lock dance the way the Goblin
## Fort's own chest gets — see _on_perception_chest()/_on_pick_lock_
## chest() for that separate, locked-and-trapped system), a flat 12d6
## Silver Shillings, and a Free Action to search, same as furniture
## above.
func _search_quest_chest(room: Dictionary) -> void:
	if room.get("chest_looted", false):
		return
	var ss: int = Dice.roll_dice_string("12d6") * _dungeon_money_multiplier()
	player.add_pennies(ss * Character.PENNIES_PER_SHILLING)
	room["chest_looted"] = true
	_persist_hazard_room(room)
	_add_notice("[i]You search the Treasure Chest and find %d Silver Shillings![/i]" % ss)

## Rooms are read back out of dungeon_state["rooms"] by value each time
## (Dictionaries are passed by reference in GDScript, but the room
## Dictionary itself was fetched from the SAME array already stored on
## dungeon_state — this just makes that "already mutated in place"
## relationship explicit at each call site instead of relying on it
## silently, in case a future edit copies the room instead).
func _persist_room(room: Dictionary) -> void:
	var rooms: Array = dungeon_state.get("rooms", [])
	for i in range(rooms.size()):
		if rooms[i].get("door_pos") == room.get("door_pos"):
			rooms[i] = room
			break
	dungeon_state["rooms"] = rooms

## --- Movement hook (called from _try_commit_move once a move commits) --

## A real bug fix: fog-of-war/vision has to keep tracking the party's
## current position and light sources for as long as they're standing on
## the dungeon tile grid at all — including once monsters are
## encountered and _exploration_mode flips false (see the big
## "Exploration mode" section above _exit_tree() — the SAME live
## encounter and SAME dungeon battle_grid carry straight through into
## combat, they're never rebuilt fresh). Before this fix, only
## _handle_exploration_move_arrival() below (itself only ever called
## while _exploration_mode) ran this — so the instant a fight started,
## the party's vision froze at whatever was lit the moment combat began
## and never updated again, no matter how far anyone moved or whether a
## lantern got lit or dimmed mid-fight. Monster tokens standing outside
## that frozen lit area (see BattleGridView's own fog_of_war < 2 check)
## stayed invisible forever even while actively attacking.
func _update_dungeon_visibility(square: Vector2i) -> void:
	dungeon_state["player_grid_pos"] = square
	_reveal_around_party()
	GameState.dungeon_state = dungeon_state
	_refresh_dungeon_battle_grid()

## Per the explicit request ("explorer mode should simply disable combat
## actions... and allow the same movement rules"): this is the ONLY
## exploration-specific code _try_commit_move() itself calls — everything
## else about a Move (Fear checks, Disengage free attacks, movement_
## remaining accounting) already runs completely unchanged, exactly as
## real combat's own Move already works. This just reacts to WHERE the
## mover ended up: reveals fog around them, rebuilds the battle grid
## (_update_dungeon_visibility() above — shared with real combat's own
## movement, see that function's own comment), and checks the two
## exploration-only automatic triggers (a hallway patrol roll — per the
## request, monsters "spawn in on the map, roll initiative and join the
## combat order" the moment they're encountered, no separate confirm
## step) and — since standing at the entrance is itself always safe —
## makes the Exit action available rather than firing anything
## automatically (see _render_turn_action_menu()'s own "Exploration mode"
## Exit button).
func _handle_exploration_move_arrival(square: Vector2i) -> void:
	_update_dungeon_visibility(square)
	_check_wandering_monsters(square)

## Wandering-monsters spawn: per the "New Dungeon building rules" Passage
## Features Table, a segment either DOES or DOESN'T have wandering
## monsters — decided once, at generation time (see DungeonGenerator's
## own has_wandering_monsters field), not a per-visit chance roll like
## the old hallway-patrol mechanic this replaces. Triggers once per
## segment, the first time ANY party member sets foot anywhere in it —
## no confirm prompt, matching the request's own "monsters spawn on the
## map, roll initiative and join the combat order" convention.
func _check_wandering_monsters(pos: Vector2i) -> void:
	var segments: Array = dungeon_state.get("hallway_segments", [])
	for i in range(segments.size()):
		var seg: Dictionary = segments[i]
		if not seg.get("has_wandering_monsters", false) or seg.get("monsters_spawned", false):
			continue
		if not seg.get("cells", []).has(pos):
			continue
		seg["monsters_spawned"] = true
		segments[i] = seg
		dungeon_state["hallway_segments"] = segments
		GameState.dungeon_state = dungeon_state
		_spawn_monsters_during_exploration(dungeon_theme.monster_patrol_monster_names.duplicate(), pos, null)
		return

## --- Dungeon hazard tiles (Chasm / Spike trap, Hazard Table D3) -----------

const CHASM_FALL_YARDS := 4

## The one still-unresolved Spike-trap room whose own hazard_pos matches
## `square`, or an empty Dictionary if none — Monster Patrol (the Hazard
## Table's third outcome) isn't a physical tile at all, it's just that
## room's own monster_names, spawned the normal door-opening way like
## any other room. Chasm is deliberately NOT handled here any more: per
## the request ("do not let a player move into or over a chasm"), a
## chasm's own cells (hazard_cells) are now genuinely impassable (see
## BattleGrid._build_hazard_markers()), so `square` can never legally BE
## a chasm cell in the first place — _move_mode_reachable, which gates
## every move destination, is built from battle_grid.reachable_squares()
## and already refuses them. Crossing one is now its own explicit action
## (see _adjacent_chasm_jump()/_attempt_chasm_jump() below), not
## something that can fire on ordinary arrival.
func _find_hazard_room_at(square: Vector2i) -> Dictionary:
	for room in dungeon_state.get("rooms", []):
		var htype: String = room.get("hazard_type", "none")
		if htype == "spike_trap" and not room.get("hazard_resolved", false):
			if room.get("hazard_pos", Vector2i(-1, -1)) == square:
				return room
	return {}

func _persist_hazard_room(room: Dictionary) -> void:
	var rooms: Array = dungeon_state.get("rooms", [])
	for i in range(rooms.size()):
		if rooms[i].get("door_pos") == room.get("door_pos"):
			rooms[i] = room
			break
	dungeon_state["rooms"] = rooms
	GameState.dungeon_state = dungeon_state

## Spike trap: "need perception test to avoid, failed test causes 1d12
## Damage" — a failed Test damages the mover directly (no armour/
## Toughness soak specified, unlike falling damage) but does NOT undo
## the move; they stepped on it and kept going. Resolves (pass or fail)
## exactly once per room — once sprung/spotted, it doesn't re-trigger on
## a later pass through the same tile.
##
## Chasm no longer has a branch here at all — see _find_hazard_room_at()'s
## own comment for why: it's genuinely impassable now, so ordinary
## arrival can never land on one; see _attempt_chasm_jump() below for its
## replacement, the explicit "Jump the Chasm" action.
func _maybe_trigger_hazard(character: Character, square: Vector2i, pre_move_pos: Vector2i) -> void:
	var room: Dictionary = _find_hazard_room_at(square)
	if room.is_empty():
		return
	var hazard_type: String = room.get("hazard_type", "none")
	var side: String = "ally" if character.allegiance == "ally" else "adversary"
	if hazard_type == "spike_trap":
		var skill2: SkillDefinition = GameData.skill_db.find_by_name("Perception")
		var test2 := TestResolver.resolve_skill_test(character, skill2, "")
		var extra2: Array[String] = []
		if test2.success:
			extra2.append("%s spots the spike trap and steps around it." % character.character_name)
		else:
			var dmg: int = Dice.roll_dice_string("1d12")
			character.wounds_current = maxi(0, character.wounds_current - dmg)
			extra2.append("%s triggers a spike trap! (%d damage)" % [character.character_name, dmg])
		_show_single_card(character, "Spike Trap: Perception Test", "", side, test2, extra2)
		_render_status()
		await _wait_for_continue()
		room["hazard_resolved"] = true
		_persist_hazard_room(room)

## --- Jump the Chasm (per the request "do not let a player move into or
## over a chasm, when they are beside it they should have a button to
## Jump the chasm") ------------------------------------------------------

## Any chasm within a single orthogonal step of `pos`, and where it's
## even possible to land — mirrors _adjacent_closed_door()'s own
## "is the action even available right now" role, but has to do a bit
## more work: a chasm can in principle be more than 1 cell thick (this
## generator only ever builds 1-thick spans today, but this walks
## however many consecutive hazard_cells sit in that direction rather
## than assuming exactly one, so a future wider chasm doesn't silently
## strand a jumper mid-air), so it keeps stepping past chasm cells until
## it finds solid ground to land on. Returns {} if `pos` isn't next to
## any chasm, or if the only side reachable from `pos` has no valid
## landing cell (off the map, or blocked by a wall) to jump to.
func _adjacent_chasm_jump(pos: Vector2i) -> Dictionary:
	for room in dungeon_state.get("rooms", []):
		if room.get("hazard_type", "none") != "chasm":
			continue
		var cells: Array = room.get("hazard_cells", [])
		if cells.is_empty():
			continue
		var cell_set: Dictionary = {}
		for c in cells:
			cell_set[c] = true
		for dir in [Vector2i(0, -1), Vector2i(0, 1), Vector2i(-1, 0), Vector2i(1, 0)]:
			var cand: Vector2i = pos + dir
			if not cell_set.has(cand):
				continue
			var landing: Vector2i = cand
			while cell_set.has(landing):
				landing += dir
			if battle_grid != null and not battle_grid.is_walkable(landing):
				continue   ## nowhere safe to land jumping this particular direction
			return {"room": room, "dir": dir, "landing": landing}
	return {}

## The Jump action itself: an Athletics Test exactly like the old
## automatic-on-arrival chasm trigger used (see _maybe_trigger_hazard()'s
## own comment on why that trigger no longer exists), but now attempted
## by explicit choice from a standing start beside the gap, and
## independently for each character/each attempt — per the request,
## chasm no longer has the old "resolved once, free for everyone after"
## behavior spike_trap still has; every jump gets its own roll, win or
## lose, every time. Success lands the jumper on the far side (reusing
## the same fog-of-war/wandering-monster arrival hook a normal Move
## triggers); failure leaves them where they stood and applies the same
## falling-damage formula the old mechanic used.
func _attempt_chasm_jump(character: Character, jump: Dictionary) -> void:
	var side: String = "ally" if character.allegiance == "ally" else "adversary"
	var skill: SkillDefinition = GameData.skill_db.find_by_name("Athletics")
	var test := TestResolver.resolve_skill_test(character, skill, "")
	var extra: Array[String] = []
	if test.success:
		extra.append("%s leaps across the chasm safely." % character.character_name)
	else:
		extra.append("%s plunges into the chasm!" % character.character_name)
	_show_single_card(character, "Jump the Chasm: Athletics Test", "", side, test, extra)
	_render_status()
	await _wait_for_continue()
	if test.success:
		var landing: Vector2i = jump["landing"]
		battle_positions[character] = landing
		if character == player:
			_handle_exploration_move_arrival(landing)
			if grid_view != null:
				grid_view.center_on(landing)
		_render_status()
	else:
		_apply_falling_damage(character, CHASM_FALL_YARDS, false)
		_render_status()

## --- Exploration mode's own actions -----------------------------------

## Open Door and Exit are the only two actions exploration adds — both
## folded directly into _render_turn_action_menu()'s own "Movement / Free
## Actions" column (see that function's own "Exploration mode" comment)
## rather than a separate custom menu, per the user's own correction:
## "can we just reuse the normal move / free button section... rather
## then use this new Explore menu buttons." Move/Sprint/End Turn need no
## exploration-specific handling at all — they're the exact same buttons,
## same movement_remaining/move_mode_active/_try_commit_move machinery,
## combat has always used.

func _on_open_door_pressed() -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	var pos: Vector2i = battle_positions.get(player, Vector2i(-1, -1))
	var door_pos := _adjacent_closed_door(pos)
	if door_pos == Vector2i(-1, -1):
		return
	action_used_this_turn = true
	_open_door_at(door_pos)
	if movement_remaining <= 0:
		_next_turn()
	else:
		_prompt_player_turn(false)

## Same shape as _on_open_door_pressed() above (costs the character's
## Action, same as a real Athletics Test would) — see
## _attempt_chasm_jump()'s own comment for what the Test itself does.
func _on_jump_chasm_pressed() -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	var pos: Vector2i = battle_positions.get(player, Vector2i(-1, -1))
	var jump: Dictionary = _adjacent_chasm_jump(pos)
	if jump.is_empty():
		return
	action_used_this_turn = true
	await _attempt_chasm_jump(player, jump)
	if movement_remaining <= 0:
		_next_turn()
	else:
		_prompt_player_turn(false)

## Same shape as _on_open_door_pressed()/_on_jump_chasm_pressed() above —
## the four Goblin Fort chest buttons all follow this pattern, just each
## calling straight into the ported chest function (see that section's
## own header comment) that does the actual work. Per the request
## ("Search/Open Chest as Free Actions... adjacency, not exact-tile"):
## Search and Open no longer cost the character's Action and use
## _is_near_chest() (the chest tile OR any of its 8 neighbours) instead
## of the old exact-position check. Break Chest and Pick Lock still cost
## the Action (they represent real physical effort/risk), but they also
## now use _is_near_chest() for the same adjacency reason.
func _on_open_chest_pressed() -> void:
	if not awaiting_player_target:
		return
	if not _is_near_chest(battle_positions.get(player, Vector2i(-1, -1))):
		return
	_on_open_chest()
	_render_status()
	_prompt_player_turn(false)

func _on_break_chest_pressed() -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	if not _is_near_chest(battle_positions.get(player, Vector2i(-1, -1))):
		return
	action_used_this_turn = true
	_on_break_chest()
	if movement_remaining <= 0:
		_next_turn()
	else:
		_prompt_player_turn(false)

func _on_perception_chest_pressed() -> void:
	if not awaiting_player_target:
		return
	if not _is_near_chest(battle_positions.get(player, Vector2i(-1, -1))):
		return
	_on_perception_chest()
	_render_status()
	_prompt_player_turn(false)

func _on_pick_lock_chest_pressed() -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	if not _is_near_chest(battle_positions.get(player, Vector2i(-1, -1))):
		return
	action_used_this_turn = true
	_on_pick_lock_chest()
	if movement_remaining <= 0:
		_next_turn()
	else:
		_prompt_player_turn(false)

## Same shape as _on_perception_chest_pressed() above (a Free Action,
## no Action cost) — see _search_furniture()/_search_quest_chest()'s own
## comments for what the search itself rolls.
func _on_search_furniture_pressed() -> void:
	if not awaiting_player_target:
		return
	var room: Dictionary = _adjacent_furniture(battle_positions.get(player, Vector2i(-1, -1)))
	if room.is_empty():
		return
	_search_furniture(room)
	_render_status()
	_prompt_player_turn(false)

func _on_search_quest_chest_pressed() -> void:
	if not awaiting_player_target:
		return
	var room: Dictionary = _adjacent_quest_chest(battle_positions.get(player, Vector2i(-1, -1)))
	if room.is_empty():
		return
	_search_quest_chest(room)
	_render_status()
	_prompt_player_turn(false)

## Per the "Sewer/Cave Dungeons update 2" request ("let place stairs
## going down in the Quest room, this will lead to the next floor which
## will generate using the same rules"): swaps the CURRENT dungeon_state
## for a freshly generated one at the next floor down, entirely in
## place — same live FieldEncounter screen, battle_grid, and party the
## whole time, just standing on a new layout, rather than a scene
## reload the way leaving the dungeon entirely (_do_exit_dungeon) works.
## Guarded against ever exceeding MAX_DUNGEON_FLOOR ("Upto 3 floors
## down, so total of 4 floors including the ground floor") — defensive
## only, since the stairs button itself is never shown once a Quest
## room's own stairs_pos comes back (-1, -1) at that depth (see
## _adjacent_stairs()).
func _take_stairs_down() -> void:
	var next_floor: int = int(dungeon_state.get("dungeon_floor", 0)) + 1
	if next_floor > DungeonGenerator.MAX_DUNGEON_FLOOR:
		return
	## Real bug fix (user report: "the dungeon should also remember which
	## doors have been opened when going back up or down"): reuse a
	## floor already visited this delve — with its own doors/encountered/
	## chest_looted flags and explored fog-of-war exactly as the party
	## left them — instead of unconditionally generating a brand new
	## layout every single time. See GameState.dungeon_floor_states' own
	## comment for the full story.
	if GameState.dungeon_floor_states.has(next_floor):
		dungeon_state = GameState.dungeon_floor_states[next_floor]
	else:
		var rng := RandomNumberGenerator.new()
		rng.randomize()
		dungeon_state = DungeonGenerator.generate(dungeon_theme, rng, next_floor)
		GameState.dungeon_floor_states[next_floor] = dungeon_state
	GameState.dungeon_state = dungeon_state
	## A fresh floor is an entirely fresh layout -- nothing from the floor
	## just left behind carries over (mirrors _do_exit_dungeon()'s own
	## full reset, just without actually leaving the screen). Clearing
	## battle_positions also makes _setup_dungeon_battle_grid() below
	## re-place the party at the NEW floor's own entrance, the same
	## "battle_positions.is_empty() means auto-place" mechanic dungeon
	## entry already relies on.
	battle_positions.clear()
	monsters.clear()
	monster_defs.clear()
	## Per the request ("Each floor down will increase Difficulty tier by
	## 1") — same formula as _load_or_generate_dungeon()'s own tier
	## assignment, just re-applied here since that function only runs
	## once, on the very first entry into the dungeon.
	GameState.current_field_difficulty_tier = dungeon_theme.difficulty_tier + next_floor
	_setup_dungeon_battle_grid()
	GameState.autosave()
	_add_notice("[i]You descend the stairs into the depths — Floor %d.[/i]" % next_floor)

func _on_take_stairs_pressed() -> void:
	if not awaiting_player_target:
		return
	var room: Dictionary = _adjacent_stairs(battle_positions.get(player, Vector2i(-1, -1)))
	if room.is_empty():
		return
	_take_stairs_down()
	_render_status()
	_prompt_player_turn(false)

## Real bug fix ("going back up stairs in a dungeon should not allow the
## player to jump from deeper to outside the dungeon, it should always
## lead to the next level up/down/out"): standing on a floor's own
## entrance_pos used to always offer "Leave the Dungeon" — see the old
## version of the entrance-tile button block in _render_turn_action_menu
## — straight back out to the world map, REGARDLESS of dungeon_floor.
## Since entrance_pos on floor 2 or 3 is really just where that floor's
## own up-stairway lands the party (each floor is a fresh, independently
## generated layout — see _take_stairs_down()'s own comment), that let a
## party standing on Floor 2 skip Floor 1 and the ground floor entirely
## in one click. This is the symmetric counterpart of _take_stairs_down()
## for going the other way: swaps the current dungeon_state for a freshly
## generated one exactly one floor SHALLOWER, in place, same as going
## down does. Only ever called from a floor where dungeon_floor > 0 —
## see the entrance-tile button block, which shows this instead of "Leave
## the Dungeon" in that case, and shows the real exit button once
## dungeon_floor is back down to 0 (the true ground floor).
func _take_stairs_up() -> void:
	var next_floor: int = int(dungeon_state.get("dungeon_floor", 0)) - 1
	if next_floor < 0:
		return
	## Same same-session floor-memory reuse as _take_stairs_down() -- see
	## that function's own comment and GameState.dungeon_floor_states'
	## comment for the full story.
	if GameState.dungeon_floor_states.has(next_floor):
		dungeon_state = GameState.dungeon_floor_states[next_floor]
	else:
		var rng := RandomNumberGenerator.new()
		rng.randomize()
		dungeon_state = DungeonGenerator.generate(dungeon_theme, rng, next_floor)
		GameState.dungeon_floor_states[next_floor] = dungeon_state
	GameState.dungeon_state = dungeon_state
	## Same full reset as _take_stairs_down() -- nothing from the floor
	## just left behind carries over, and battle_positions.clear() makes
	## _setup_dungeon_battle_grid() below re-place the party.
	battle_positions.clear()
	monsters.clear()
	monster_defs.clear()
	## Same formula _take_stairs_down()/_load_or_generate_dungeon() use --
	## naturally settles back to the theme's own base tier once next_floor
	## reaches 0.
	GameState.current_field_difficulty_tier = dungeon_theme.difficulty_tier + next_floor
	## Real bug fix ("player is moved back to the down stairs in the
	## quest room when coming back up from a lower dungeon level, right
	## now its returning them to the Exit/Up"): climbing UP should land
	## the party at the ARRIVING (shallower) floor's own Quest room
	## stairs_pos — the same stairwell they'd use to go back down — not
	## at that floor's entrance_pos, which on the ground floor is the
	## dungeon's real world-map exit door, not a stairwell at all. Every
	## floor short of MAX_DUNGEON_FLOOR has a Quest room with a real
	## stairs_pos (see DungeonGenerator's own MAX_DUNGEON_FLOOR comment),
	## and next_floor here is always < MAX_DUNGEON_FLOOR (we just came
	## from one floor deeper than it), so this is always found in
	## practice; entrance_pos stays the fallback for the defensive case.
	var up_landing: Vector2i = dungeon_state.get("entrance_pos", Vector2i(-1, -1))
	for room in dungeon_state.get("rooms", []):
		var room_stairs_pos: Vector2i = room.get("stairs_pos", Vector2i(-1, -1))
		if room_stairs_pos != Vector2i(-1, -1):
			up_landing = room_stairs_pos
			break
	_setup_dungeon_battle_grid(up_landing)
	GameState.autosave()
	if next_floor == 0:
		_add_notice("[i]You climb the stairs back up to the ground floor.[/i]")
	else:
		_add_notice("[i]You climb the stairs up — Floor %d.[/i]" % next_floor)

func _on_take_stairs_up_pressed() -> void:
	if not awaiting_player_target:
		return
	if battle_positions.get(player, Vector2i(-1, -1)) != dungeon_state.get("entrance_pos"):
		return
	_take_stairs_up()
	_render_status()
	_prompt_player_turn(false)

## Opens the door, reveals it for vision, and — the moment it's opened
## for the first time — spawns its monsters immediately (per the
## explicit request: combat starts "when [a] monster [is] encountered").
## Idempotent: re-opening an already-open door (e.g. clicking it again
## after re-entering the dungeon on a later visit) does nothing further.
## Opens every cell of the room's own 2x2 door block (see _room_at_
## door()'s own comment) — not just whichever single cell the player
## happened to be standing next to — so the whole doorway actually
## clears, not just 1 of its 4 tiles.
func _open_door_at(door_pos: Vector2i) -> void:
	var room := _room_at_door(door_pos)
	if room.is_empty() or room.get("door_open", false):
		return
	var door_cells: Array = _door_block_cells(room)
	for cell in door_cells:
		_set_char_at(cell, dungeon_theme.door_open_char)
	room["door_open"] = true
	_persist_room(room)
	_reveal_around_party(door_cells)
	GameState.dungeon_state = dungeon_state
	_refresh_dungeon_battle_grid()
	if not room.get("encountered", false):
		room["encountered"] = true
		_persist_room(room)
		_spawn_monsters_during_exploration(room.get("monster_names", []), room.get("spawn_far_corner", door_pos), room)

## --- Combat hand-off, in the SAME live encounter ---------------------------

## Exploration mode's own monster-arrival hand-off. Unlike a normal
## encounter's _start_encounter() (which builds an entirely FRESH
## CombatEncounter/turn_order/battle_grid from scratch), this only ever
## ADDS to the encounter that's already been running since exploration
## began — same combatants list, same battle_grid the party has been
## standing on, same turn_order with everyone who's already acted this
## Round left completely untouched (see CombatEncounter.
## add_combatant_mid_round() — per the explicit request, new monsters
## "roll initiative and join the combat order" immediately, mid-round,
## rather than waiting for a fresh Round to start).
func _spawn_monsters_during_exploration(monster_names: Array, spawn_square: Vector2i, room) -> void:
	var group: Array[MonsterDefinition] = []
	for n in monster_names:
		var found := GameData.monster_db.find_by_name(str(n))
		if found != null:
			group.append(found)
	if group.is_empty():
		return
	_exploration_mode = false
	var blocked: Dictionary = {}
	for c in battle_positions:
		blocked[battle_positions[c]] = true
	var monster_count := group.size()
	var first_new_monster: Character = null
	for i in range(monster_count):
		var mdef: MonsterDefinition = group[i]
		var m: Character
		if mdef.uses_career_template:
			m = BanditGenerator.build_bandit(mdef.monster_name, GameState.current_field_difficulty_tier)
		else:
			m = mdef.to_character()
			DifficultyTiers.apply_tier_bonus(m, GameState.current_field_difficulty_tier)
		## Per the request ("actually dont number enemies at all"): this
		## used to suffix every monster in the group with its raw index
		## (" 1", " 2", ...) whenever more than one monster was present
		## in the group at all, even a lone Wolf standing next to two
		## Bears — removed outright, no replacement disambiguation.
		## Every other piece of monster-identity tracking in this file
		## (battle_positions, monster_defs, weapons, monster_focus_
		## target, ...) is keyed by the Character object itself, not by
		## character_name, so two same-named monsters are still tracked
		## and targeted correctly — this only ever affected the
		## displayed name.
		## Per the request ("humanoid enemies will usually carry their own
		## light sources at night time in combat") — same treatment
		## _start_encounter() already gives every normal dark-battle
		## monster group. Explicitly gated on battle_is_dark here too
		## (harmless no-op before — every dungeon theme used to be
		## unconditionally dark — but a real distinction now that an
		## is_outdoor theme like the Goblin Fort can genuinely be lit by
		## daytime: no reason for a greenskin to be carrying a lit lantern
		## in broad daylight).
		if battle_is_dark and mdef.creature_type == "Humanoid" and not m.has_creature_trait("Dark Vision") and not m.has_creature_trait("Night Vision") and not m.main_weapon_is_two_handed() and randf() < 0.75:
			m.inventory.append("Lantern")
			m.equipped_offhand = "Lantern"
			m.light_mode = "on"
			m.light_fuel_minutes = Character.LAMP_OIL_MINUTES
		monsters.append(m)
		monster_defs[m] = mdef
		weapons[m] = _resolve_weapon(m)
		var m_size: int = m.get_footprint_size()
		var square: Vector2i = battle_grid.find_open_square_near(spawn_square, blocked, m_size)
		battle_positions[m] = square
		for sq in BattleGrid.footprint_cells(square, m_size):
			blocked[sq] = true
		encounter.add_combatant_mid_round(m)
		if first_new_monster == null:
			first_new_monster = m
	_active_combat_room = room
	if selected_target == null or encounter.is_defeated(selected_target):
		selected_target = first_new_monster
	_ensure_valid_target()
	_add_notice("[i]Monsters emerge from the dark![/i]")
	if room != null and room.get("quest", false):
		_maybe_grant_quest_bonus_reward()
	_render_status()

## Quest room bonus reward (a flat chance judgment call, no numeric table
## given in the original request; renamed from the earlier boss-room
## version now that "boss room" has been replaced by "Quest room"):
## rolled once, right as the Quest room fight starts, and folded straight
## into the SAME battle-report gold total every other fight's loot
## already uses (_battle_gold_found) rather than a separate reward popup
## — so it shows up in the normal "Gold Found" line the player already
## knows to look at.
func _maybe_grant_quest_bonus_reward() -> void:
	if randf() >= dungeon_theme.quest_bonus_reward_chance:
		return
	var bonus: int = Dice.d10() + Dice.d10()
	_battle_gold_found += bonus
	_add_notice("[i]A locked strongbox lies half-buried in the filth — %d extra Gold Crowns![/i]" % bonus)

## --- Leaving the exploration content ---------------------------------------

func _do_exit_dungeon() -> void:
	GameState.dungeon_state = {}
	## Leaving the dungeon entirely ends this delve -- any cached earlier
	## floors (see GameState.dungeon_floor_states' own comment) belong to
	## a delve that's now over, not to whatever dungeon the party enters
	## next.
	GameState.dungeon_floor_states = {}
	dungeon_state = {}
	GameState.autosave()
	## Same "which screen to return to" convention as every other
	## sub-screen — falls back to Overworld if no city was recorded (a
	## future non-city dungeon entrance).
	if GameState.last_active_city_id != "":
		GameState.pending_city_id = GameState.last_active_city_id
		get_tree().change_scene_to_file("res://scenes/CityScreen.tscn")
	else:
		get_tree().change_scene_to_file("res://scenes/Overworld.tscn")

## --- End of exploration mode ---------------------------------------------


## Real bug fix (root cause of "can't use the shop or healer right after
## combat"): _exit_tree() used to restore the InputMap by calling
## InputMap.load_from_project_settings() — a wholesale reload that
## rebuilds EVERY action from scratch, including "ui_accept"'s own
## Space binding, which _setup_wasd_navigation() below never actually
## touched. The problem: Space is exactly the key that triggers this
## screen's own Return-to-the-Oldworld transition (see the
## battle_report_overlay.visible KEY_SPACE branch at the top of
## _unhandled_input, _on_close_battle_report, _on_return_pressed), so
## it's still
## physically held down — its key-up event hasn't been dispatched yet
## — at the exact moment _exit_tree() runs, mid-scene-change. Rebuilding
## "ui_accept" out from under that still-active press desyncs Godot's
## own Input singleton: the key-up event that follows a frame later (by
## which point the new Overworld has already loaded) can no longer be
## matched against the old, now-replaced action binding, so it never
## clears — "ui_accept" is left permanently reporting as pressed.
## Consequence, confirmed directly via a headless repro that presses
## Space to leave a real battle and then simulates a real Enter press
## at an NPC in the Overworld immediately after:
## Input.is_action_just_pressed("ui_accept") never fires on that first
## interact attempt (it can't produce a fresh 0->1 transition while the
## action already reads as pressed), so player_controller.gd's own
## ui_accept-gated interact silently does nothing — try_interact() is
## never even called. The failed attempt's own key-up happens to
## finally clear the stuck state, so only the SECOND interact attempt
## after any battle ever works — which reads exactly like "the shop/
## healer don't work" to a player whose first stop after a fight is
## naturally the shop or healer, while a quest NPC or dialogue tile
## tried afterward (or as a lucky first attempt) works fine.
## Fixed by precisely undoing only the specific events
## _setup_wasd_navigation() itself added/removed — remembered below —
## instead of reloading the whole InputMap. "ui_accept"'s own Space
## event is never touched at all, so its underlying binding (and
## Input's own pressed-state tracking for it) stays valid continuously
## across the whole press/release cycle and can never desync this way.
func _exit_tree() -> void:
	if _wasd_nav_up_event != null:
		InputMap.action_erase_event("ui_up", _wasd_nav_up_event)
	if _wasd_nav_down_event != null:
		InputMap.action_erase_event("ui_down", _wasd_nav_down_event)
	if _wasd_nav_left_event != null:
		InputMap.action_erase_event("ui_left", _wasd_nav_left_event)
	if _wasd_nav_right_event != null:
		InputMap.action_erase_event("ui_right", _wasd_nav_right_event)
	for accept_event in _wasd_nav_removed_accept_events:
		InputMap.action_add_event("ui_accept", accept_event)
	_wasd_nav_removed_accept_events.clear()
	## Prone auto-recovery spec, other half of _ready()'s own set above:
	## covers both combat and exploration submodes tearing down (win,
	## flee, or returning from exploration). Also sweeps the whole party
	## for anyone left Prone with 1+ Wounds the instant this screen
	## actually goes away — covers the edge case where
	## _clear_conditions_at_battle_end()'s own "you gain Prone back if
	## you were Unconscious" re-application lands on someone already
	## healed above 0 mid-battle, who never got a chance to click Stand
	## Up before the fight simply ended. Without this sweep, the
	## out-of-combat auto-clear rule would only apply the NEXT time that
	## character's wounds_current happens to be reassigned, rather than
	## holding true the moment combat genuinely ends.
	GameState.in_field_encounter = false
	for member in GameState.party:
		if member != null and member.conditions.has("Prone") and member.wounds_current > 0:
			member.remove_condition("Prone")

## Per the request: WASD moves keyboard focus between the action
## menu's buttons; Space activates whichever one is focused (swapped
## from Enter per the follow-up request — see the comment inside this
## function). Rather than hand-rolling spatial nearest-neighbor logic,
## this leans on Godot's own built-in Control focus-neighbor system —
## the exact thing Up/Down/Left/Right/Space (the "ui_up"/"ui_down"/
## "ui_left"/"ui_right"/"ui_accept" actions) already drive for any
## focused Button/OptionButton, with zero extra bookkeeping needed
## elsewhere
## in this file. Scoped to only this screen: added here, removed in
## _exit_tree(), so it doesn't affect the overworld (which already
## uses WASD for its own separate move_up/move_down/move_left/
## move_right actions — see project.godot) or any other screen.
## The exact events _setup_wasd_navigation() itself adds/removes,
## remembered so _exit_tree() can precisely undo only these — see that
## function's own comment for why a wholesale
## InputMap.load_from_project_settings() reload is deliberately not
## used instead (real bug: it desyncs Input's own pressed-state
## tracking for "ui_accept" if Space, which this screen never removes
## from it, is still physically held when the reload happens).
var _wasd_nav_up_event: InputEventKey = null
var _wasd_nav_down_event: InputEventKey = null
var _wasd_nav_left_event: InputEventKey = null
var _wasd_nav_right_event: InputEventKey = null
var _wasd_nav_removed_accept_events: Array[InputEventKey] = []

func _setup_wasd_navigation() -> void:
	_wasd_nav_up_event = InputEventKey.new()
	_wasd_nav_up_event.keycode = KEY_W
	InputMap.action_add_event("ui_up", _wasd_nav_up_event)
	_wasd_nav_down_event = InputEventKey.new()
	_wasd_nav_down_event.keycode = KEY_S
	InputMap.action_add_event("ui_down", _wasd_nav_down_event)
	_wasd_nav_left_event = InputEventKey.new()
	_wasd_nav_left_event.keycode = KEY_A
	InputMap.action_add_event("ui_left", _wasd_nav_left_event)
	_wasd_nav_right_event = InputEventKey.new()
	_wasd_nav_right_event.keycode = KEY_D
	InputMap.action_add_event("ui_right", _wasd_nav_right_event)
	## Per the follow-up request ("swap around all functionality for
	## Enter and Space hotkeys"): Enter now drives the large custom
	## hotkey system throughout this screen (see _unhandled_input's own
	## big Enter branch, swapped from Space), while Space is the
	## "activate the currently WASD-focused button" key (ui_accept).
	## ui_accept's own default Enter/Kp Enter binding would let a
	## currently-focused button silently eat an Enter press meant for
	## the combat hotkey instead (a focused Button reacts to ui_accept
	## before _unhandled_input ever sees the event), so both are
	## removed for the duration of this screen — the mirror image of
	## v0.2.295's original Space removal. Space itself stays bound to
	## ui_accept (the engine default already includes it — nothing to
	## add back) and is never touched here, on purpose — see
	## _exit_tree()'s own comment for why that matters.
	_wasd_nav_removed_accept_events.clear()
	for accept_event in InputMap.action_get_events("ui_accept"):
		if accept_event is InputEventKey and (accept_event as InputEventKey).keycode in [KEY_ENTER, KEY_KP_ENTER]:
			_wasd_nav_removed_accept_events.append(accept_event as InputEventKey)
	for accept_event in _wasd_nav_removed_accept_events:
		InputMap.action_erase_event("ui_accept", accept_event)

## Allows clicking an enemy icon directly on the battle map to select it
## as the current target. Used to be a second, alongside-the-existing-
## portrait-click way to pick a target; the top strip's per-monster
## portraits are gone now (replaced by the Attacker/Defender boxes —
## see _build_combat_status_box), so clicking the map is the only way
## to change target directly.
##
## Per the request: while move_mode_active (the player has Move or
## Sprint's bonus movement pending), every click is instead routed to
## _try_commit_move — a click on the battle map during move mode always
## means "go here," never "select this as my target."
##
## Per the follow-up request ("if a player clicks on the battle map, but
## not a targetable enemy, assume he wants to move" — corrected to "let
## it activate the move process, i.e. like clicking the Move button"):
## a click that lands on neither a live enemy nor an already-active
## special mode (AoE targeting, move mode — both handled above) is
## assumed to mean "I want to move" and simply activates move mode,
## exactly as if the Move button had been clicked — highlighting
## reachable squares and reopening the menu. It deliberately does NOT
## also treat the clicked square itself as the destination (an earlier
## version of this fix did, committing the move in the same click) —
## the player still gets the normal highlighted-range preview and
## clicks again to actually commit, same as the Move button's existing
## two-step flow.
func _on_grid_square_clicked(square: Vector2i) -> void:
	if aoe_target_mode_active:
		_resolve_aoe_cast(square)
		return
	## Ranged Attack / Magic-Prayer targeting (per the request): a click
	## has to land on one of the arrowed target tokens — anything else
	## (empty ground, an out-of-range enemy) is refused with a notice
	## rather than falling through to the "assume they want to move"
	## fallback below, which would otherwise fire on a stray miss here.
	if ranged_target_mode_active:
		## Per the request ("allow large creatures to be hit in any of the
		## cells it occupies, not only top left one") — same footprint-
		## aware check as _living_character_at_square, so a Large/
		## Enormous/Monstrous target can be clicked anywhere its token
		## covers, not just its anchor cell.
		##
		## Real bug fix ("player should not be able to target monster
		## they can not see yet... with ranged attacks"): this loop used
		## to iterate every living `monsters` entry regardless of range
		## OR visibility — the header comment just above already claimed
		## "an out-of-range enemy... is refused," but nothing here
		## actually enforced that; only the arrows drawn (from
		## _ranged_valid_targets) ever reflected range/visibility.
		## Restricted to _ranged_valid_targets itself (already filtered
		## by both range and _can_see_target() — see
		## _targets_in_weapon_range()/_targets_in_spell_range()) so a
		## click can never resolve against anything that isn't one of the
		## actual arrowed targets, closing both gaps at once.
		for m in _ranged_valid_targets:
			if encounter.is_defeated(m):
				continue
			if not battle_positions.has(m):
				continue
			if BattleGrid.footprint_cells(battle_positions[m], m.get_footprint_size()).has(square):
				_resolve_ranged_target(m)
				return
		_add_notice("Click one of the arrowed targets to attack, or Cancel Targeting.")
		return
	if move_mode_active:
		## Per the follow-up request ("while select a place to move to,
		## if the player click on a monster/player tiles, disable move
		## mode and select the target"): checked before _try_commit_move
		## so a click on any living combatant's own token always reads
		## as "target them" — an occupied square was never a valid move
		## destination to begin with (see _try_commit_move's own
		## occupancy handling), so this doesn't take away any move click
		## that used to actually land.
		var occupant: Character = _living_character_at_square(square)
		if occupant != null and occupant != player:
			_exit_move_mode()
			_select_target(occupant)
			_prompt_player_turn(false)
			return
		_try_commit_move(square)
		return
	## Per the request ("allow targeting of allies"): clicking any living
	## combatant's own token — ally or monster — selects them (see
	## _select_target). Widened from monsters-only; actually firing an
	## offensive action against an ally selection is separately blocked
	## (see _render_turn_action_menu's own `target` filter and
	## _on_player_attack's own guard), so this is safe.
	var clicked: Character = _living_character_at_square(square)
	if clicked != null and clicked != player:
		_select_target(clicked)
		return
	if not awaiting_player_target:
		return
	_enter_move_mode()

## Any living (non-defeated) combatant occupying `square`, ally or
## monster alike — shared by the move-mode "clicked an occupied square"
## fix above, the general click-to-target loop just below it, and the
## hover tooltip (see _on_grid_square_hovered).
##
## Per the request ("allow large creatures to be hit in any of the cells
## it occupies, not only top left one"): checks every cell of the
## combatant's own footprint (BattleGrid.footprint_cells, anchored at
## its battle_positions entry) rather than just that anchor cell itself
## — a plain equality check here meant a multi-square creature (Large/
## Enormous/Monstrous, e.g. a Rat Ogre) could only ever be clicked,
## hovered, or selected via its top-left cell, with every other square
## its token visually covers reading as empty ground.
func _living_character_at_square(square: Vector2i) -> Character:
	for c in battle_positions.keys():
		if encounter.is_defeated(c):
			continue
		if BattleGrid.footprint_cells(battle_positions[c], c.get_footprint_size()).has(square):
			return c
	return null

## The small hover-tooltip content for `m` (see _on_grid_square_hovered):
## name, HP (colour-shifts the same green/amber/red bands the HP bars
## everywhere else in this project already use), and Conditions —
## folding any active Critical Wounds into that same line as a plain
## count, same compact treatment _refresh_enemy_display's old per-
## monster panel used to give them. Deliberately lean (no Fate/Fortune/
## Resilience/Resolve/Corruption) — that fuller readout already lives
## in the Attacker/Defender boxes; this is meant to be a quick glance
## at any character on the map, not a duplicate of those.
func _hover_tooltip_lines(m: Character) -> Array:
	var lines: Array = []
	lines.append({"text": m.character_name, "bold": true, "color": Color(0.95, 0.9, 0.75)})
	var pct: float = float(m.wounds_current) / float(max(m.wounds_max, 1))
	var hp_color: Color = Color(0.55, 0.9, 0.55) if pct > 0.5 else (Color(0.9, 0.75, 0.35) if pct > 0.25 else Color(0.9, 0.4, 0.35))
	lines.append({"text": "HP: %d/%d" % [m.wounds_current, m.wounds_max], "color": hp_color})
	var cond_parts: Array[String] = []
	for cond_name in m.conditions.keys():
		var stacks: int = m.conditions[cond_name]
		cond_parts.append("%s x%d" % [cond_name, stacks] if stacks > 1 else cond_name)
	if m.active_critical_wound_count > 0:
		cond_parts.append("%d Critical Wound(s)" % m.active_critical_wound_count)
	if not cond_parts.is_empty():
		lines.append({"text": ", ".join(cond_parts), "color": Color(0.85, 0.6, 0.5)})
	else:
		lines.append({"text": "No Conditions", "color": Color(0.6, 0.58, 0.52)})
	return lines

## Live arrow-preview while move_mode_active: shows the already-locked
## waypoint path (see _move_confirmed_path) plus a live leg from the
## current waypoint anchor to wherever the mouse is currently over,
## truncated to however much movement is actually left from that anchor
## — "up to the distance they can actually [move]," per the request. A
## no-op (and clears any stale preview) whenever move mode isn't active,
## or the cursor's left the grid (square_hovered emits Vector2i(-1, -1)
## for that — see BattleGridView's own comment).
func _on_grid_square_hovered(square: Vector2i) -> void:
	## Per the request ("hovering over any character or monster on the
	## battle map should bring up a small tooltip box with their vital
	## stats — HP, wounds and conditions"): checked first, ahead of every
	## mode branch below, so it works regardless of what else is going on
	## (idle, mid-Move, mid-targeting, watching a monster's own Turn) —
	## this is purely a read-only info popup, independent of whatever
	## those modes are doing with the same hover signal.
	if grid_view != null and battle_grid != null:
		var hovered: Character = _living_character_at_square(square) if square != Vector2i(-1, -1) else null
		grid_view.set_hover_tooltip(_hover_tooltip_lines(hovered) if hovered != null else [])
	if aoe_target_mode_active:
		if battle_grid == null or square == Vector2i(-1, -1):
			grid_view.set_aoe_preview([])
			grid_view.set_hover_target(Vector2i(-1, -1), false)
			return
		var radius: int = _aoe_radius_squares(_pending_aoe_cast.get("is_spell", true))
		grid_view.set_aoe_preview(battle_grid.squares_within_radius(square, radius))
		grid_view.set_hover_target(square, true)
		return
	## Per the request: ranged/magic targeting no longer just draws a
	## static arrow to every valid target — the player looks around
	## freely (mirroring Move's own live hover preview below) and
	## whichever valid target the cursor is actually over becomes
	## focused, with its own crosshair and a live distance/range-band
	## readout. Hovering empty ground (or leaving the grid entirely)
	## simply un-focuses — nothing is ever pre-locked from just moving
	## the mouse across the map on the way to the target you want.
	if ranged_target_mode_active:
		_ranged_focus_target = _ranged_target_at(square) if square != Vector2i(-1, -1) else null
		_update_ranged_focus_visual()
		return
	if not move_mode_active or battle_grid == null or not battle_positions.has(player) or square == Vector2i(-1, -1):
		grid_view.set_preview_path([])
		grid_view.set_hover_target(Vector2i(-1, -1), false)
		grid_view.set_charge_preview([], Vector2i(-1, -1))
		return
	var anchor: Vector2i = _move_anchor()
	var confirmed: Array = _move_confirmed_path()
	## Stopping exactly at the last waypoint (no further movement this
	## leg) is always a valid thing to click, even though reachable
	## squares (which never include their own starting square) wouldn't
	## otherwise offer it.
	if square == anchor and not _move_waypoints.is_empty():
		grid_view.set_preview_path(confirmed)
		grid_view.set_hover_target(square, true)
		## Per the request: the secondary Charge-range arrow applies here
		## too — standing pat at an already-locked waypoint still spends
		## whatever movement got there, so the remaining budget is
		## movement_remaining minus that confirmed path, same formula as
		## the main branch below.
		var stand_remaining: int = max(0, movement_remaining - confirmed.size())
		grid_view.set_charge_preview(_charge_range_targets_from(square, stand_remaining), square)
		return
	var remaining_from_anchor: int = max(0, movement_remaining - confirmed.size())
	var leg: Array = battle_grid.find_path(anchor, square, _occupied_squares_excluding(player), player.get_footprint_size())
	var is_valid_target: bool = _move_mode_reachable.has(square)
	if leg.size() > remaining_from_anchor:
		leg = leg.slice(0, remaining_from_anchor)
	var full_preview: Array = confirmed.duplicate()
	full_preview.append_array(leg)
	grid_view.set_preview_path(full_preview)
	grid_view.set_hover_target(square, is_valid_target)
	## Per the request ("show a secondary arrow when character moves
	## within charge range of any enemy target"): only for an actually
	## committable destination — an invalid (red) hover square is never
	## somewhere the player could really end their Move, so there's
	## nothing meaningful to preview a follow-up Charge from.
	if is_valid_target:
		var hover_remaining: int = max(0, movement_remaining - full_preview.size())
		grid_view.set_charge_preview(_charge_range_targets_from(square, hover_remaining), square)
	else:
		grid_view.set_charge_preview([], Vector2i(-1, -1))

## The square the next Move leg is measured from — the last locked
## waypoint if the player's already set one or more via right-click (see
## _on_grid_square_right_clicked), otherwise the mover's own current
## square.
func _move_anchor() -> Vector2i:
	return _move_waypoints.back() if not _move_waypoints.is_empty() else battle_positions[player]

## The full path already locked in via right-click waypoints, from the
## mover's actual current square through each waypoint in order —
## concatenated leg-by-leg (each leg its own shortest/most-direct path,
## same as a normal single-leg Move) so a multi-corner route still costs
## exactly the sum of its real per-leg distances, no shortcuts.
func _move_confirmed_path() -> Array:
	var full: Array = []
	var anchor: Vector2i = battle_positions[player]
	for wp in _move_waypoints:
		full.append_array(battle_grid.find_path(anchor, wp, _occupied_squares_excluding(player), player.get_footprint_size()))
		anchor = wp
	return full

## Right-click: locks `square` in as a waypoint (a corner the eventual
## path is guaranteed to pass through) rather than committing the move —
## per the request, lets the player change direction for the next leg,
## repeatably, until they run out of movement to spend. Only accepts a
## square that's actually reachable from the current anchor with
## whatever movement is left. Per the follow-up request: a right-click
## OUTSIDE that highlighted range no longer just does nothing — it
## cancels Move mode entirely, same as clicking the Move button again
## would (see _on_move_button_pressed's own toggle-to-cancel).
func _on_grid_square_right_clicked(square: Vector2i) -> void:
	if not move_mode_active or battle_grid == null or not battle_positions.has(player):
		return
	if not _move_mode_reachable.has(square):
		_exit_move_mode()
		_add_notice("%s: move cancelled." % player.character_name)
		_prompt_player_turn(false)
		return
	_move_waypoints.append(square)
	var confirmed: Array = _move_confirmed_path()
	var remaining: int = max(0, movement_remaining - confirmed.size())
	var reachable: Array = battle_grid.reachable_squares(square, remaining, _occupied_squares_excluding(player), player.get_footprint_size()) if remaining > 0 else []
	_move_mode_reachable = reachable
	## The waypoint square itself is always a valid "stop here" click (see
	## _try_commit_move's stopping_at_anchor case) even though
	## reachable_squares never includes its own starting square — added
	## to the HIGHLIGHT set only, not _move_mode_reachable itself, so it
	## reads as clickable without changing how far-away clicks are judged.
	var highlight_set: Array = reachable.duplicate()
	highlight_set.append(square)
	grid_view.highlight_squares(highlight_set)
	grid_view.set_preview_path(confirmed)
	grid_view.set_hover_target(square, true)
	if remaining > 0:
		_add_notice("%s: waypoint set — %d square(s) of movement left to spend from here." % [player.character_name, remaining])
	else:
		_add_notice("%s: waypoint set — out of movement. Left-click this square to finish the move here." % player.character_name)

func _start_encounter() -> void:
	GameState.ensure_player_character()
	player = GameState.player_character

	## See _pre_battle_equip's declaration and _restore_pre_battle_
	## equipment() — must run before the "auto-equip a Sword if empty-
	## handed" mutation immediately below, and before the per-member
	## loop's own copy of the same, so a character who walked in
	## holding nothing but a lit lantern doesn't have that recorded as
	## having started the fight with a Sword.
	_pre_battle_equip.clear()
	for pm in GameState.party:
		_pre_battle_equip[pm] = {"weapon": pm.equipped_weapon, "offhand": pm.equipped_offhand}

	battle_is_dark = GameState.pending_battle_is_dark
	battle_is_pitch_black = GameState.pending_battle_is_pitch_black

	if player.equipped_weapon == "":
		player.equipped_weapon = "Sword"

	## See persistent_aoe_hazards' own declaration comment.
	persistent_aoe_hazards.clear()
	_clear_active_smoke_clouds()
	encounter = CombatEncounter.new()
	## Per the request: every present party member fights, not just the
	## one the player directly controls — armed with their own real
	## equipped weapon.
	## Camp rework, per the request: this used to also fully heal every
	## party member's Wounds to max right here ("no rest/healing system
	## yet, same as the previous single-character behavior") — now that
	## a real out-of-combat Wounds recovery system exists (Camp's Heal
	## Skill action, Cook/Hunt/Trap Endeavours, and Endurance-based sleep
	## recovery), that auto-full-heal was removed per the user's explicit
	## confirmation: Wounds now genuinely persist between fights, and
	## camp/rest is what recovers them.
	for member in GameState.party:
		if member.equipped_weapon == "":
			member.equipped_weapon = "Sword"
		encounter.add_combatant(member)
		weapons[member] = _resolve_weapon(member)
		## Camp rework, per the request: "this timer clears if a battle
		## starts" — see last_heal_skill_time_minutes' own comment.
		member.last_heal_skill_time_minutes = -999999

	monsters.clear()
	monster_defs.clear()
	## Per the ambush-detection request: Overworld.gd may have already
	## decided this encounter's exact monster group — either because
	## the player failed to detect it (so combat starts immediately
	## with the same group the detection roll was made against) or
	## because the player clicked the ambush marker (so the group
	## has to match what that marker's own detection roll used). Only
	## fall back to a fresh roll here when nothing was pre-selected —
	## e.g. this scene ever being entered some other way in the future.
	var group: Array[MonsterDefinition] = []
	if not GameState.pending_encounter_monster_names.is_empty():
		for n in GameState.pending_encounter_monster_names:
			var found := GameData.monster_db.find_by_name(n)
			if found != null:
				group.append(found)
	if group.is_empty():
		group = EncounterGroupBuilder.select_group(GameState.current_field_monster_pool, GameState.current_field_difficulty_tier, GameState.current_field_habitat)
	var is_player_ambush: bool = GameState.pending_encounter_is_player_ambush
	GameState.pending_encounter_monster_names = []
	GameState.pending_encounter_is_player_ambush = false
	var wound_overrides: Dictionary = GameState.pending_encounter_wound_override
	var condition_overrides: Dictionary = GameState.pending_encounter_condition_override
	GameState.pending_encounter_wound_override = {}
	GameState.pending_encounter_condition_override = {}

	var monster_count := group.size()
	for i in range(monster_count):
		var mdef: MonsterDefinition = group[i]
		var m: Character
		if mdef.uses_career_template:
			m = BanditGenerator.build_bandit(mdef.monster_name, GameState.current_field_difficulty_tier)
		else:
			m = mdef.to_character()
			DifficultyTiers.apply_tier_bonus(m, GameState.current_field_difficulty_tier)
		## Per the request ("actually dont number enemies at all"): this
		## used to suffix every monster with its raw index in the group
		## ("disambiguate for the target list") whenever more than one
		## monster was present at all — removed outright, no replacement
		## disambiguation. See _spawn_monsters_during_exploration()'s own
		## comment on this same removal; nothing here keys off
		## character_name for target selection either (battle_positions/
		## monster_defs/weapons/monster_focus_target are all keyed by the
		## Character object itself).
		## Per the request: a successful player ambush gives every
		## enemy Surprised for the first Round — "can take no Action or
		## Move" (p.167-169), the same Condition already used whenever
		## the player is the one caught by surprise, just applied to
		## the other side this time.
		if is_player_ambush:
			m.add_condition("Surprised")
		## Per the request: a real monster-spawn override — a
		## starting Wounds value and a starting Conditions set, read
		## from a quest's own data (via GameState's pending override
		## dictionaries, set up by whatever triggered this encounter)
		## rather than the monster always spawning at full health.
		if wound_overrides.has(mdef.monster_name):
			var override_wounds: int = int(wound_overrides[mdef.monster_name])
			m.wounds_current = clampi(override_wounds, 0, m.wounds_max)
		if condition_overrides.has(mdef.monster_name):
			var cond_overrides: Dictionary = condition_overrides[mdef.monster_name]
			for cond_name in cond_overrides:
				m.add_condition(cond_name, int(cond_overrides[cond_name]))
		## Per the request ("humanoid enemies will usually carry their
		## own light sources at night time in combat"): a lit Lantern in
		## their off-hand, so they aren't left just as blind in the dark
		## as an unlit one would leave them. Skipped for anyone who
		## already sees fine in the dark on their own (Dark Vision/Night
		## Vision) — no reason to burden them with a lantern they don't
		## need — and for a two-handed main weapon, which leaves no free
		## off-hand to hold one. "Usually," not "always" — a random
		## chance, same as a real warband wouldn't be uniformly equipped.
		if battle_is_dark and mdef.creature_type == "Humanoid" and not m.has_creature_trait("Dark Vision") and not m.has_creature_trait("Night Vision") and not m.main_weapon_is_two_handed() and randf() < 0.75:
			m.inventory.append("Lantern")
			m.equipped_offhand = "Lantern"
			m.light_mode = "on"
			m.light_fuel_minutes = Character.LAMP_OIL_MINUTES
		monsters.append(m)
		monster_defs[m] = mdef
		encounter.add_combatant(m)
		weapons[m] = _resolve_weapon(m)

	_setup_battle_grid()
	encounter.roll_initiative()
	_snapshot_round_start()
	battle_over = false
	## Party-wipe rework: a fresh encounter starting inside the same
	## field_encounter_screen instance (dungeon room-to-room fights all
	## reuse this one node — see _hosted_by_exploration's own comment)
	## must not carry a stale _party_wiped=true forward from a PREVIOUS
	## fight's Battle Report into this new one.
	_party_wiped = false
	melee_has_begun = false
	_last_logged_round = -1
	_battle_loot_log.clear()
	_pending_loot.clear()
	_battle_gold_found = 0
	_battle_silver_found = 0
	_battle_brass_found = 0
	_fled_monsters.clear()
	monster_turn_count.clear()
	xp_awarded_for.clear()
	history.clear()
	selected_target = monsters[0] if not monsters.is_empty() else null
	defensive_stance_active = false
	## Per the request: these two ON/OFF toggles now start each new
	## battle exactly where the player left them in a previous one
	## (GameState.dual_wield_toggle_remembered/magic_colour_effect_remembered),
	## rather than always resetting to a hardcoded default.
	dual_wield_active = GameState.dual_wield_toggle_remembered
	strike_to_stun_active = false
	frightening_active = false
	## Stride (p.343): "Multiply Run Movement by 1.5 when Running" — see
	## Character.get_stride_multiplier()'s own comment for why this
	## whole pool (Move/Run merged into one budget in this project) is
	## the "Run Movement" that trait means.
	movement_remaining = int(round(player.get_movement() * 2 * player.get_stride_multiplier()))
	moved_this_turn = false
	## Entangled (p.168): "On your turn, you may not Move" — a full
	## block, not merely a penalty (the Condition's own -10 Test penalty,
	## applied via get_condition_test_penalty_breakdown, covers movement-
	## related Skill Tests separately; this covers the raw ability to
	## Move at all).
	if player.conditions.has("Entangled"):
		movement_remaining = 0
	move_mode_active = false
	sprint_finish_pending = false
	sprint_used_this_turn = false
	_charge_blocked_targets.clear()
	magic_colour_effect_active = GameState.magic_colour_effect_remembered
	_fear_sources.clear()
	_fear_rating.clear()
	_fear_extended_sl.clear()
	_monster_fear_sources.clear()
	_monster_fear_rating.clear()
	_monster_fear_extended_sl.clear()
	_monster_fear_tested.clear()
	currently_flying.clear()
	_refresh_enemy_display()
	_build_player_display()
	## Per the request ("remove everything inside the [Attacker/Defender]
	## window"): this used to be a static title label sitting inside that
	## panel. Relocated into the combat log instead of dropped outright,
	## so the flavour text survives — the panel itself is Attacker/
	## Defender boxes only now.
	_add_notice(("[i]A wild %s blocks your path![/i]" % monsters[0].character_name) if monster_count == 1 \
		else "[i]%d enemies close in around you![/i]" % monster_count)
	if _weapon_for(player).is_ranged:
		_add_notice("[i]You open the fight at range with your %s.[/i]" % _weapon_for(player).weapon_name)
	else:
		_add_notice("[i]Neither side has closed to melee yet — you can Charge, or use a Skill/spell/prayer from range before it comes to blows.[/i]")
	_add_notice("Turn order rolled by Initiative: " + _turn_order_string())
	_render_status()
	await _check_fear_and_terror()
	## Frightening (p.190): a present ally OTHER than the player has no
	## per-ally toggle UI in this project (same simplification every other
	## passive ally Talent already gets), so theirs is always assumed
	## active from the very start of the fight. The player's OWN copy is
	## gated behind frightening_active instead — always OFF at this point
	## (see _start_encounter's own reset above) — and only checked against
	## monsters once the player actually toggles it on (_on_toggle_
	## frightening), a Free Action they take mid-fight.
	var passive_frightening_allies: Array[Character] = []
	for ally in (encounter.get_living("ally") if encounter != null else []):
		if ally != player and ally.get_talent_rank("Frightening") > 0:
			passive_frightening_allies.append(ally)
	await _check_reverse_fear_from_frightening(passive_frightening_allies)
	_next_turn()

## --- Combat Encounter rework, Phase 1b: the tactical battle grid --------

## Builds this encounter's BattleGrid from whatever terrain snapshot
## Overworld captured right before entering this scene (falls back to an
## all-open grid if none was set — see generate_from_terrain_snapshot's
## own doc comment), then places every living combatant on it.
##
## Per the request: a normal (non-ambush) encounter starts both sides
## "about just out of average (Move 4) charge range" — allies clustered
## near BattleGrid.ALLY_START_COL, adversaries near
## BattleGrid.ADVERSARY_START_COL (see that class's own comment for how
## those columns are derived). Per the follow-up request ("place the
## player party character closer together... within 2 cells of another
## character at a minimum"), allies now pack tightly around a single
## anchor point on their own start column rather than spreading across
## the grid's full height — see _place_standard()'s own comment.
## Adversaries are unaffected, still spread across the grid's rows via
## _spread_rows exactly as before, keeping the two sides' own distance
## from each other unchanged. When one side starts genuinely Surprised,
## though, _place_ambush instead puts the OTHER side within
## charge range from the very start, partially surrounding the surprised
## side — who start clustered tightly together rather than spread out —
## per the follow-up request. Checked directly against each Character's
## own Conditions (rather than trusting GameState.pending_encounter_
## is_player_ambush) so this works symmetrically whichever side ends up
## Surprised, current player-ambushes-monsters case or any future
## monster-ambushes-player case alike.
##
## Every square resolves to an actual open, unoccupied square via
## find_open_square_near. Must run after every combatant has already
## been added to `encounter` (weapons/monster_defs too) and after any
## start-of-encounter Surprised Conditions have been applied, so it's
## called from _start_encounter() right after both add loops (and the
## ambush Surprised-condition loop), before roll_initiative().
func _setup_battle_grid() -> void:
	battle_grid = BattleGrid.new()
	battle_grid.generate_from_terrain_snapshot(GameState.pending_battle_terrain, GameState.pending_battle_cover, GameState.pending_battle_water)
	battle_positions.clear()

	var allies: Array[Character] = []
	var adversaries: Array[Character] = []
	for c in encounter.combatants:
		if c.allegiance == "ally":
			allies.append(c)
		else:
			adversaries.append(c)

	var allies_surprised: bool = allies.any(func(c: Character): return c.conditions.has("Surprised"))
	var adversaries_surprised: bool = adversaries.any(func(c: Character): return c.conditions.has("Surprised"))

	var blocked: Dictionary = {}
	if adversaries_surprised and not allies_surprised:
		_place_ambush(allies, adversaries, blocked)
	elif allies_surprised and not adversaries_surprised:
		_place_ambush(adversaries, allies, blocked)
	else:
		_place_standard(allies, adversaries, blocked)

## The default (no ambush) formation: each side clustered near its own
## start column.
##
## Per the request ("place the player party character closer together,
## they should be with[in] 2 cells of another character at a minimum...
## keep the min[imum] distance to enemy as it is"): allies no longer
## spread across the FULL height of the grid via _spread_rows — for a
## small party on a tall grid that could put the two flanking members
## many cells apart, well past any reasonable "sticking together" read.
## Instead every ally is packed toward the SAME preferred anchor
## (BattleGrid.ALLY_START_COL, grid-vertical-center) — repeatedly asking
## find_open_square_near for that one square naturally fills the nearest
## still-open square to it first (exactly the same clustering trick
## _place_ambush already uses for the Surprised side's own huddle, see
## that function's comment), so a normal 4-6 person party lands
## completely within the 8 squares immediately touching the anchor —
## Chebyshev distance 1 from the anchor and therefore at most 2 from
## each other, comfortably inside the requested minimum. ALLY_START_COL
## itself is untouched, so the ally-vs-adversary distance ("about just
## out of average Move 4 charge range," per this function's own header
## above) is exactly what it was before this change.
func _place_standard(allies: Array[Character], adversaries: Array[Character], blocked: Dictionary) -> void:
	var ally_cluster_anchor := Vector2i(BattleGrid.ALLY_START_COL, int(BattleGrid.ROWS / 2.0))
	for i in range(allies.size()):
		var a_size: int = allies[i].get_footprint_size()
		var square: Vector2i = battle_grid.find_open_square_near(ally_cluster_anchor, blocked, a_size)
		battle_positions[allies[i]] = square
		for sq in BattleGrid.footprint_cells(square, a_size):
			blocked[sq] = true
	for i in range(adversaries.size()):
		var row2 := _spread_rows(i, adversaries.size())
		var preferred2 := Vector2i(BattleGrid.ADVERSARY_START_COL, row2)
		var adv_size: int = adversaries[i].get_footprint_size()
		var square2: Vector2i = battle_grid.find_open_square_near(preferred2, blocked, adv_size)
		battle_positions[adversaries[i]] = square2
		for sq in BattleGrid.footprint_cells(square2, adv_size):
			blocked[sq] = true

## Ambush formation (per the request): `victims` (the Surprised side)
## start clustered tightly around the grid's own center — repeatedly
## asking find_open_square_near for the SAME center square naturally
## packs each successive Character into the nearest still-open square to
## it, reading as genuinely "grouped up" rather than merely closer than
## usual. `attackers` (the non-Surprised side) then fan out across a
## half-circle arc facing that cluster, at BattleGrid.
## AMBUSH_DISTANCE_SQUARES — well within an average Move-4 Charge — so
## they read as having crept up and partially surrounded the huddle
## rather than fully encircling it (a full ring would read as "already
## won" before Round 1 even starts). The arc faces from whichever side
## this attacking allegiance would normally approach from (west for
## allies, east for adversaries), so the encounter still reads as
## "allies vs. adversaries" rather than a random scatter.
func _place_ambush(attackers: Array[Character], victims: Array[Character], blocked: Dictionary) -> void:
	var center := Vector2i(BattleGrid.COLS / 2, BattleGrid.ROWS / 2)
	for victim in victims:
		var v_size: int = victim.get_footprint_size()
		var square: Vector2i = battle_grid.find_open_square_near(center, blocked, v_size)
		battle_positions[victim] = square
		for sq in BattleGrid.footprint_cells(square, v_size):
			blocked[sq] = true

	var facing := PI if (attackers.is_empty() or attackers[0].allegiance == "ally") else 0.0
	var count := attackers.size()
	for i in range(count):
		var t: float = 0.5 if count <= 1 else float(i) / float(count - 1)   ## 0..1 across the group
		var angle: float = facing - (PI / 2.0) + t * PI   ## spans a 180-degree arc centered on `facing`
		var offset := Vector2i(roundi(cos(angle) * BattleGrid.AMBUSH_DISTANCE_SQUARES), roundi(sin(angle) * BattleGrid.AMBUSH_DISTANCE_SQUARES))
		var preferred: Vector2i = center + offset
		var atk_size: int = attackers[i].get_footprint_size()
		var square2: Vector2i = battle_grid.find_open_square_near(preferred, blocked, atk_size)
		battle_positions[attackers[i]] = square2
		for sq in BattleGrid.footprint_cells(square2, atk_size):
			blocked[sq] = true

## Distributes `count` combatants evenly across the grid's rows — index 0
## near the top, index count-1 near the bottom, with even spacing between.
func _spread_rows(index: int, count: int) -> int:
	if count <= 0:
		return int(BattleGrid.ROWS / 2.0)
	return clampi(int((index + 0.5) * BattleGrid.ROWS / count), 0, BattleGrid.ROWS - 1)

## battle_positions filtered to exclude `exclude`'s own square, keyed by
## square (Vector2i -> true) — the `blocked` param find_path/
## reachable_squares expect, so combatants can't path through each other
## but a combatant is never blocked by its own current square.
## Per the multi-square footprint feature: every OTHER combatant
## contributes its WHOLE footprint (not just its anchor square) — a
## Large/Enormous/Monstrous creature blocks passage/targeting across its
## entire body, same as it visually occupies every one of those tiles.
## Per the request: "while in dungeon and in exploration mode/out of
## combat, allow character to move over each other" — exploration
## mode's battle_positions only ever holds living party members (see
## _spawn_monsters_during_exploration, which flips _exploration_mode
## false the instant real monsters actually join the grid, before any
## of them are added to battle_positions), so while still exploring
## there's no tactical reason for one ally's own square to block
## another's pathing/reachability — they can freely pass through (and
## end a move stacked on) each other. Real combat (monsters present,
## _exploration_mode false) is untouched: every combatant still blocks
## every other one exactly as before.
func _occupied_squares_excluding(exclude: Character) -> Dictionary:
	var result: Dictionary = {}
	if _exploration_mode:
		return result
	for c in battle_positions:
		if c == exclude:
			continue
		for sq in BattleGrid.footprint_cells(battle_positions[c], c.get_footprint_size()):
			result[sq] = true
	return result

## Moves `actor` up to `max_squares` along a path toward the open square
## adjacent to `target`'s current square that's closest to `actor`'s own
## starting position — shared by monster melee-closing
## (_monster_move_toward) and the player's own Charge (_on_player_attack).
## No-ops quietly if the grid/positions aren't set up or no path exists
## (e.g. `target` is fully boxed in).
##
## Bug fix: used to pick the destination via find_open_square_near, which
## always answers "nearest open square to target" via a fixed scan order
## — on an open battlefield that always resolved to the target's NW
## neighbour, so every Charge/melee-close landed the mover NW of the
## target regardless of which direction they actually approached from.
## find_open_square_adjacent_to instead picks whichever open neighbour of
## `target` is closest to `actor`'s own square, so the mover ends up on
## the side they're actually coming from.
## Returns the number of squares actually moved (0 if none), so a
## caller that needs to charge this against a movement budget — see
## _on_player_attack's Charge handling — can do so; callers that don't
## care (e.g. monster melee-closing) can simply ignore the return
## value, same as before this was added.
## Per the request ("Monsters need a movement-cost penalty so
## pathfinding prefers routes around burning squares"): how much extra
## a single step onto a burning square costs on top of its normal cost
## of 1 (see BattleGrid.find_path()'s own `avoid_cost` parameter) —
## high enough that a real detour of several squares is preferred over
## walking straight through, but never infinite: a mover with no way
## around the fire at all still walks through it rather than freezing
## up with nowhere to go.
const GROUND_FIRE_AVOID_COST := 8

## Used for both monster AI closing on a target (_monster_move_toward)
## AND the player's own Charge action (Charge auto-paths toward its
## target rather than taking manual square-by-square input, same as a
## monster's own approach) — a genuine hand-picked player Move never
## goes through here, so it's never auto-rerouted around fire the mover
## didn't ask to avoid.
func _advance_toward(actor: Character, target: Character, max_squares: int) -> int:
	if battle_grid == null or not battle_positions.has(actor) or not battle_positions.has(target):
		return 0
	if max_squares <= 0:
		return 0
	var actor_size: int = actor.get_footprint_size()
	var target_size: int = target.get_footprint_size()
	var target_square: Vector2i = battle_positions[target]
	var dest_blocked := _occupied_squares_excluding(actor)
	for sq in BattleGrid.footprint_cells(target_square, target_size):
		dest_blocked[sq] = true
	var dest: Vector2i = battle_grid.find_open_square_adjacent_to(target_square, battle_positions[actor], dest_blocked, target_size, actor_size)
	## Ground Fire avoidance (see GROUND_FIRE_AVOID_COST's own comment):
	## a soft per-square cost, not a hard block — find_path() still
	## finds a route straight through the flame if that's genuinely the
	## only way, it just prefers a real detour when one exists.
	var avoid_cost: Dictionary = {}
	if not persistent_aoe_hazards.is_empty():
		for sq in _ground_fire_squares_union():
			avoid_cost[sq] = GROUND_FIRE_AVOID_COST
	var path: Array = battle_grid.find_path(battle_positions[actor], dest, _occupied_squares_excluding(actor), actor_size, avoid_cost)
	if path.is_empty():
		return 0
	var steps: int = min(max_squares, path.size())
	battle_positions[actor] = path[steps - 1]
	## Ground Fire mechanics (see _check_ground_fire_crossing()'s own
	## comment): only the portion of `path` actually travelled this
	## Turn (`steps` may truncate a longer path short of `dest`), same
	## "entered squares, not the whole route" convention as the player's
	## own move-commit handling above.
	_check_ground_fire_crossing(actor, path.slice(0, steps))
	return steps

## Flight (Rating) (p.343): "As the creature's Move, it can fly up to
## Rating yards." Rating is stated in yards, not squares — converts via
## BattleGrid.YARDS_PER_SQUARE the same way every other yards<->squares
## boundary in this file does (see _aoe_radius_squares and friends).
## Deliberately NOT scaled by Stride's own get_stride_multiplier() —
## Flight's Rating is already its own flat distance, not derived from
## get_movement() the way Stride's ×1.5 Run bonus is, so a creature with
## both (e.g. Pegasus) gets Stride's benefit only while genuinely
## grounded. Returns 0 for a creature without the Flight trait at all.
func _flight_budget_squares(actor: Character) -> int:
	if not actor.has_creature_trait("Flight"):
		return 0
	var rating_yd: int = actor.get_creature_trait_rating("Flight")
	return int(rating_yd / float(BattleGrid.YARDS_PER_SQUARE))

## Flight's own movement, mirroring _advance_toward's "pick an open
## square adjacent to target, path toward it, truncate to this Turn's
## budget" shape — except per the book's own wording ("ignores all
## intervening terrain, obstacles, or characters") there's no pathfind
## at all: only the FINAL square (where it lands or ends up hovering)
## needs to be a real, legal, unoccupied square — everything between
## start and destination, terrain/obstacles/other combatants alike, is
## simply flown over. Tries the same adjacent-to-target landing spot
## _advance_toward would use first; if that's out of this Turn's Flight
## budget (or otherwise unusable), flies as far toward it in a straight
## line as the budget allows, then backs off square-by-square until
## landing somewhere legal — still never blocked by what's in between,
## only by where it would actually finish the move. Returns the number
## of squares actually covered (0 if it couldn't move at all, e.g. no
## legal square exists anywhere in range).
func _advance_toward_flying(actor: Character, target: Character, max_squares: int) -> int:
	if battle_grid == null or not battle_positions.has(actor) or not battle_positions.has(target):
		return 0
	if max_squares <= 0:
		return 0
	var actor_size: int = actor.get_footprint_size()
	var target_size: int = target.get_footprint_size()
	var start: Vector2i = battle_positions[actor]
	var target_square: Vector2i = battle_positions[target]
	var blocked := _occupied_squares_excluding(actor)
	var dest_blocked := blocked.duplicate()
	for sq in BattleGrid.footprint_cells(target_square, target_size):
		dest_blocked[sq] = true
	var dest: Vector2i = battle_grid.find_open_square_adjacent_to(target_square, start, dest_blocked, target_size, actor_size)
	if BattleGrid.distance_squares(start, dest) <= max_squares and _footprint_landable(dest, actor_size, blocked):
		battle_positions[actor] = dest
		return BattleGrid.distance_squares(start, dest)
	var line: Array = BattleGrid.direct_line(start, dest)
	var steps: int = min(max_squares, line.size())
	while steps > 0:
		var candidate: Vector2i = line[steps - 1]
		if _footprint_landable(candidate, actor_size, blocked):
			battle_positions[actor] = candidate
			return steps
		steps -= 1
	return 0

## Whether a `size`x`size` footprint anchored at `anchor` is a legal
## FINAL landing square for Flight movement — every cell walkable and
## none of them in `blocked` (no exemption; Flight only cares about
## where it ends up, per _advance_toward_flying's own doc comment above).
func _footprint_landable(anchor: Vector2i, size: int, blocked: Dictionary) -> bool:
	for sq in BattleGrid.footprint_cells(anchor, size):
		if not battle_grid.is_walkable(sq) or blocked.has(sq):
			return false
	return true

## Falling (p.166): "you suffer 1d10 Damage, plus 3 Damage for every
## yard you fall" — reduced by Toughness Bonus only, explicitly NOT
## Armour Points (per the rule's own wording, unlike every normal
## attack's soak). `fall_yards` is how far it actually fell BEFORE any
## Athletics reduction; `voluntary` gates whether the Average (+20)
## Athletics Test to lessen the damage is even offered at all — an
## involuntary fall (a Flight creature that couldn't choose to Fly for
## its Move, e.g. Stunned/Unconscious while airborne) gets no chance to
## brace for it, only "purposefully falling — or jumping downwards" does.
## Gains the Prone Condition if the Wounds actually lost (post-TB-soak)
## exceed Toughness Bonus, same as the book's own threshold. Logged as
## a plain notice — falling isn't a Test against another Character, so
## it doesn't fit the roll-card machinery the way an attack does.
func _apply_falling_damage(character: Character, fall_yards: int, voluntary: bool = false) -> void:
	if character == null or fall_yards <= 0:
		return
	var effective_yards: int = fall_yards
	if voluntary:
		var skill: SkillDefinition = GameData.skill_db.find_by_name("Athletics")
		if skill != null:
			var test := TestResolver.resolve_skill_test(character, skill, "", 20, [{"name": "Falling (Average)", "amount": 20}])
			if test.success:
				effective_yards = max(0, fall_yards - 1 - test.success_levels)
	if effective_yards <= 0:
		_add_notice("[i]%s falls but lands safely, taking no damage.[/i]" % character.character_name)
		return
	var toughness_bonus: int = character.get_characteristic_bonus("toughness")
	var raw_damage: int = Dice.d10() + 3 * effective_yards
	var wounds_lost: int = max(0, raw_damage - toughness_bonus)
	character.take_wounds(wounds_lost)
	if wounds_lost > toughness_bonus:
		character.add_condition("Prone")
	_add_notice("[i]%s falls %d yard(s) and suffers %d Wound(s)%s.[/i]" % [character.character_name, effective_yards, wounds_lost, " (knocked Prone)" if wounds_lost > toughness_bonus else ""])
	_render_status()

## Flight (p.343): "If it starts its turn flying, it must choose to Fly
## for its Move. If it cannot do this, the GM decides how far it
## falls." The only thing that stops a creature choosing to Fly in this
## project is being unable to act at all (Surprised/Stunned/Unconscious)
## — checked right where each of those already skips the owner's Turn.
## This project has no altitude tracking, so "how far" is a flat,
## representative combat-altitude constant rather than anything
## precisely simulated — enough to genuinely hurt a grounded flier
## without being an automatic kill. A no-op for a creature that wasn't
## actually flying (the overwhelmingly common case).
const INCAPACITATED_FALL_YARDS := 8
func _ground_flying_creature_if_incapacitated(actor: Character) -> void:
	if not currently_flying.get(actor, false):
		return
	currently_flying.erase(actor)
	_apply_falling_damage(actor, INCAPACITATED_FALL_YARDS, false)

## Bestial (p.338, "attempt to Flee") / Broken (p.168, "flee from
## combat") forced movement, per the request ("Let enemies run away if
## they need to and if they reach the edge of the battle map remove
## them from the battle"): the mirror-image of _advance_toward above —
## same "pick a far destination, path toward it, truncate to whatever
## this turn can actually cover" shape, just aimed away from the
## centroid of `threats` instead of toward a single target. Picks a
## destination point BEYOND_MAX squares out along that away-direction
## (always outside the grid — is_in_bounds is never true for it — so
## find_open_square_near naturally resolves to whatever's genuinely
## farthest along that heading, including all the way to the grid's own
## edge when nothing blocks the path there) and paths to the nearest
## open square near it. Returns the number of squares actually moved (0
## if already cornered with no open ground to retreat onto).
func _advance_away_from(actor: Character, threats: Array[Character], max_squares: int) -> int:
	if battle_grid == null or not battle_positions.has(actor) or max_squares <= 0 or threats.is_empty():
		return 0
	var centroid := Vector2.ZERO
	var n := 0
	for t in threats:
		if battle_positions.has(t):
			centroid += Vector2(battle_positions[t])
			n += 1
	if n == 0:
		return 0
	centroid /= float(n)
	var from_sq: Vector2i = battle_positions[actor]
	var away_dir: Vector2 = Vector2(from_sq) - centroid
	if away_dir.length() < 0.01:
		away_dir = Vector2(1, 0)   ## degenerate (standing exactly on the threats' own centroid) -- pick an arbitrary direction rather than not moving at all
	away_dir = away_dir.normalized()
	var beyond_max: float = float(BattleGrid.COLS + BattleGrid.ROWS)   ## always lands off-grid, whichever direction — see comment above
	var far_point := Vector2(from_sq) + away_dir * beyond_max
	var dest_raw := Vector2i(int(round(far_point.x)), int(round(far_point.y)))
	var actor_size: int = actor.get_footprint_size()
	var blocked := _occupied_squares_excluding(actor)
	var dest: Vector2i = battle_grid.find_open_square_near(dest_raw, blocked, actor_size)
	var path: Array = battle_grid.find_path(from_sq, dest, blocked, actor_size)
	if path.is_empty():
		return 0
	var steps: int = min(max_squares, path.size())
	battle_positions[actor] = path[steps - 1]
	return steps

## Flight's own version of _advance_away_from immediately above — same
## "away from the threats' centroid" direction, but per Flight's own
## "ignores all intervening terrain, obstacles, or characters" wording,
## flies straight toward the far point instead of pathfinding around
## whatever's in the way, backing off square-by-square from the edge of
## its budget until it lands somewhere legal (walkable, unoccupied) —
## same shape as _advance_toward_flying.
func _advance_away_from_flying(actor: Character, threats: Array[Character], max_squares: int) -> int:
	if battle_grid == null or not battle_positions.has(actor) or max_squares <= 0 or threats.is_empty():
		return 0
	var centroid := Vector2.ZERO
	var n := 0
	for t in threats:
		if battle_positions.has(t):
			centroid += Vector2(battle_positions[t])
			n += 1
	if n == 0:
		return 0
	centroid /= float(n)
	var from_sq: Vector2i = battle_positions[actor]
	var away_dir: Vector2 = Vector2(from_sq) - centroid
	if away_dir.length() < 0.01:
		away_dir = Vector2(1, 0)
	away_dir = away_dir.normalized()
	var far_point := Vector2(from_sq) + away_dir * float(max_squares)
	var dest_raw := Vector2i(int(round(far_point.x)), int(round(far_point.y)))
	var actor_size: int = actor.get_footprint_size()
	var blocked := _occupied_squares_excluding(actor)
	var line: Array = BattleGrid.direct_line(from_sq, dest_raw)
	var steps: int = min(max_squares, line.size())
	while steps > 0:
		var candidate: Vector2i = line[steps - 1]
		if _footprint_landable(candidate, actor_size, blocked):
			battle_positions[actor] = candidate
			return steps
		steps -= 1
	return 0

## "reach the edge of the battle map" (per the request) — true once a
## square touches the grid's own boundary on any side.
func _is_at_battle_edge(square: Vector2i) -> bool:
	return square.x <= 0 or square.x >= BattleGrid.COLS - 1 or square.y <= 0 or square.y >= BattleGrid.ROWS - 1

## Whether `target` can actually be reached this turn by Charging — i.e.
## there's an open path to a square adjacent to `target` of at least
## the character's own current Movement (see the follow-up note below)
## but no more than the player's own remaining Move this turn
## (movement_remaining) — rather than just "some path exists, however
## long it is".
##
## Per the follow-up request ("charge does not add movement... Minimum
## charge distance is 3 squares"): this used to check against
## player.get_movement()*2 (Run distance) regardless of how much of the
## turn's actual movement had already been spent — meaning Charge
## effectively granted free bonus movement on top of the normal
## movement economy, and the button could still be offered even with
## 0 movement_remaining left. Now gated on the character's real
## remaining Move (charging never grants movement beyond what they
## already have).
##
## Per the second follow-up request ("change the minimum Charge range
## requirement to the character's current Move value, including any
## modifiers"): the floor itself is no longer a flat 3 squares — it's
## player.get_movement(), read fresh on every check, so Fleet Footed
## (+1), Crippled Leg (halved), Encumbrance, and anything else that
## moves a character's own Movement value automatically raises or
## lowers how far they need to close to Charge, without this needing
## its own separate tuning. A target already within that distance
## (including already-adjacent, where the old code special-cased
## "true" since find_path reports no path for a zero-length move)
## doesn't qualify for a Charge at all, since there's no distance to
## charge across; Attack normally instead.
##
## Also no longer gated on melee_has_begun (previously restricted to
## the Opening Exchange only) — per the request, Charge should be
## available on any turn a character has enough Move left, not just
## the very first exchange of a fight.
##
## Deliberately doesn't pre-filter on straight-line (Chebyshev)
## distance before pathing — obstacles can only make a real path
## LONGER than that straight-line distance, never shorter, so a target
## that looks "too close" in a straight line can still legitimately
## need a longer detour around blocked squares to meet the Movement
## floor. The real, obstacle-aware path length from find_path() below
## is the only number that actually matters.
## Charge (p.157): "no back-stepping to charge" — a direct charge or
## forward move (closing the distance toward a target) still allows
## Charging that target later this turn; stepping AWAY from one breaks
## it. Checked per-target (not a single turn-wide flag) — see
## _charge_blocked_targets' own comment — and evaluated against every
## OTHER combatant currently on the grid, not just adversaries, since a
## future target isn't known at the moment of the move that breaks it.
## Called from _try_commit_move (the single real commit point for every
## player Move) with the square being LEFT and the square being MOVED
## TO for one leg; kept as its own function, separate from that leg's
## other bookkeeping, so it can be exercised directly with hand-picked
## squares rather than only through real grid pathing. Once broken
## against a target, no later leg this turn re-enables Charging them
## again — this only ever adds `true` entries, never clears one — same
## as the book's own "invalidates a direct charge sequence" framing,
## not just "net distance at the end of the turn."
func _update_charge_blocked_targets(from_square: Vector2i, to_square: Vector2i) -> void:
	var player_size: int = player.get_footprint_size()
	for m in battle_positions.keys():
		if m == player or encounter.is_defeated(m):
			continue
		var m_size: int = m.get_footprint_size()
		var before_dist := BattleGrid.footprint_distance(from_square, player_size, battle_positions[m], m_size)
		var after_dist := BattleGrid.footprint_distance(to_square, player_size, battle_positions[m], m_size)
		if after_dist > before_dist:
			_charge_blocked_targets[m] = true

func _target_in_charge_range(target: Character) -> bool:
	if battle_grid == null or not battle_positions.has(player) or not battle_positions.has(target):
		return true   ## no grid/positions set up yet — nothing to gate on
	## Charge (p.157): "no back-stepping to charge" — see
	## _charge_blocked_targets' own comment for why this is per-target
	## rather than a single turn-wide flag, and _update_charge_blocked_
	## targets (called from _try_commit_move) for where it actually gets set.
	if _charge_blocked_targets.get(target, false):
		return false
	var player_size: int = player.get_footprint_size()
	var target_size: int = target.get_footprint_size()
	var target_square: Vector2i = battle_positions[target]
	var dest_blocked := _occupied_squares_excluding(player)
	for sq in BattleGrid.footprint_cells(target_square, target_size):
		dest_blocked[sq] = true
	var dest: Vector2i = battle_grid.find_open_square_adjacent_to(target_square, battle_positions[player], dest_blocked, target_size, player_size)
	## Bug fix (user report: "nobody should be able to charge over
	## impassable terrain"): find_path() below deliberately detours
	## around impassable terrain/other combatants rather than failing
	## outright (the right behaviour for a normal Move), which meant
	## Charge used to stay available even when the only way to actually
	## get there was to walk around an obstacle. A Charge (p.157) is a
	## straight rush at the target, not a controlled Move that can pick
	## its way around obstacles — so it's simply not offered at all once
	## anything blocks that direct line.
	if not battle_grid.has_clear_direct_path(battle_positions[player], dest, _occupied_squares_excluding(player), player_size):
		return false
	## find_path() reports no path for a zero-length move (already
	## standing on `dest`, i.e. already adjacent to the target) — that
	## naturally fails the charge_min floor below anyway, since an
	## empty path never satisfies path.size() >= charge_min (charge_min
	## is at least 1 for any character who can move at all), so no
	## separate "already adjacent" special case is needed here.
	var charge_min: int = player.get_movement()
	var path: Array = battle_grid.find_path(battle_positions[player], dest, _occupied_squares_excluding(player), player_size)
	return not path.is_empty() and path.size() >= charge_min and path.size() <= movement_remaining

## Unlike _target_in_charge_range just above, this has no charge_min
## floor (an ordinary Move is happy to close ANY distance) and routes
## around obstacles via the normal find_path() rather than requiring
## has_clear_direct_path()'s straight line. Purely a "is Attack even
## reachable THIS turn" check for _render_turn_action_menu's own
## Enter-hotkey default — doesn't affect whether the Attack button
## itself is shown or enabled, only what pressing Enter (or
## WASD-focus-and-activate) with nothing else selected actually does.
func _can_reach_melee_range_of_any_living_enemy() -> bool:
	if battle_grid == null or not battle_positions.has(player):
		return true
	var player_size: int = player.get_footprint_size()
	for m in encounter.get_living("adversary"):
		if not battle_positions.has(m):
			continue
		var target_size: int = m.get_footprint_size()
		var target_square: Vector2i = battle_positions[m]
		if BattleGrid.footprint_distance(battle_positions[player], player_size, target_square, target_size) <= 1:
			return true
		var dest_blocked := _occupied_squares_excluding(player)
		for sq in BattleGrid.footprint_cells(target_square, target_size):
			dest_blocked[sq] = true
		var dest: Vector2i = battle_grid.find_open_square_adjacent_to(target_square, battle_positions[player], dest_blocked, target_size, player_size)
		var path: Array = battle_grid.find_path(battle_positions[player], dest, _occupied_squares_excluding(player), player_size)
		if not path.is_empty() and path.size() <= movement_remaining:
			return true
	return false

## Per the request ("show a secondary arrow when character moves within
## charge range of any enemy target"): the exact same floor/ceiling rule
## as _target_in_charge_range above — must close at least the mover's own
## full Movement, capped at whatever Movement budget is actually left —
## just evaluated from a hypothetical `square` (wherever the Move preview
## is currently hovering) instead of the player's real current square,
## and against `remaining` (this turn's movement_remaining minus however
## much the preview path already spends getting to `square`) instead of
## movement_remaining directly. Used purely for the live hover preview in
## _on_grid_square_hovered — draws a secondary arrow from the hovered
## destination to every enemy that would become chargeable from there,
## so the player can see "moving here sets up a Charge on that target"
## without having to commit the move first and check.
func _charge_range_targets_from(square: Vector2i, remaining: int) -> Array:
	var result: Array = []
	if battle_grid == null:
		return result
	var charge_min: int = player.get_movement()
	if remaining < charge_min:
		return result
	var player_size: int = player.get_footprint_size()
	## Per the follow-up request ("dont show charge line to targets not
	## in the direction player is moving (no backstep to charge rule)"):
	## even though nothing here literally walks the player backward this
	## turn, a target roughly BEHIND the hovered destination (relative to
	## the player's own real current square) reads exactly like one — you
	## would have just moved away from it to reach this hover square, so
	## a Charge line drawn back to it looks like precisely the kind of
	## backstep-then-charge this project's own _charge_blocked_targets
	## rule (see its own comment just below) already forbids once a move
	## actually commits. Filtering the PREVIEW the same way keeps the two
	## consistent: only a target roughly ahead of (or level with) the
	## real direction of travel ever gets a line here. Skipped entirely
	## while hovering on/near the player's own real square (no meaningful
	## direction yet to judge "ahead" against).
	var real_sq: Vector2i = battle_positions.get(player, square)
	var move_dir: Vector2 = Vector2(square - real_sq)
	var have_move_dir: bool = move_dir.length_squared() > 0.01
	if have_move_dir:
		move_dir = move_dir.normalized()
	for m in encounter.get_living("adversary"):
		if not battle_positions.has(m):
			continue
		## No back-stepping to charge (see _charge_blocked_targets' own
		## comment): once broken against a target, no later destination
		## this turn re-enables Charging them — so the preview arrow
		## shouldn't dangle that possibility either.
		if _charge_blocked_targets.get(m, false):
			continue
		if have_move_dir:
			var target_dir: Vector2 = Vector2(battle_positions[m] - real_sq)
			if target_dir.length_squared() > 0.01 and target_dir.normalized().dot(move_dir) <= 0.0:
				continue   ## behind the real direction of travel -- would read as backstepping to charge
		var target_size: int = m.get_footprint_size()
		var target_square: Vector2i = battle_positions[m]
		var dest_blocked := _occupied_squares_excluding(player)
		for sq in BattleGrid.footprint_cells(target_square, target_size):
			dest_blocked[sq] = true
		var dest: Vector2i = battle_grid.find_open_square_adjacent_to(target_square, square, dest_blocked, target_size, player_size)
		## Same fix as _target_in_charge_range's own comment: a Charge
		## needs a genuinely clear straight line, not just any routed-
		## around path.
		if not battle_grid.has_clear_direct_path(square, dest, dest_blocked, player_size):
			continue
		var path: Array = battle_grid.find_path(square, dest, dest_blocked, player_size)
		if not path.is_empty() and path.size() >= charge_min and path.size() <= remaining:
			result.append(target_square)
	return result

## Every living adversary currently within melee range (Chebyshev
## distance 1 — same adjacency metric as every other melee check in this
## file, e.g. line 776 above) of the player's CURRENT square AND
## genuinely Engaged with the player per combat_encounter.gd's own
## definition (has actually traded a melee blow with them at some point
## this encounter — see is_engaged_with). Used both to gate Disengage
## (only meaningful while actually engaged) and by _try_commit_move to
## work out which adversaries get a free attack when the player moves
## away without having Disengaged first.
##
## Real bug fix (per the request: "just standing next to a combatant
## does not mean your engaged... it also leads to moving away from
## enemies that you have not hit (nor they hit you) leads to a fleeing
## free hit which is not correct"): this used to be adjacency alone —
## an adversary who happened to be standing next to the player, even one
## neither side had ever actually swung at, counted as "engaged" and
## punished the player with a free hit for simply walking past/away from
## them. The is_engaged_with() check now requires a real hit exchange
## first, same as Outnumbering.
func _player_engaged_enemies() -> Array:
	var engaged: Array = []
	if battle_grid == null or not battle_positions.has(player):
		return engaged
	for m in encounter.get_living("adversary"):
		if battle_positions.has(m) and BattleGrid.footprint_distance(battle_positions[player], player.get_footprint_size(), battle_positions[m], m.get_footprint_size()) <= 1 and encounter.is_engaged_with(player, m):
			engaged.append(m)
	return engaged

## The mirror of _player_engaged_enemies, from a monster's own side —
## living party members currently adjacent to `actor` AND genuinely
## Engaged with it (see _player_engaged_enemies' own comment for both
## the adjacency-alone bug fix and the is_engaged_with requirement).
## Per the request ("enemy should suffer the same penalty from
## disengaging as player"): used by _monster_attack to detect a monster
## about to walk away from someone already engaging it in melee, so
## that party member can get the same free, undefended attack the
## player already gets against a monster it walks away from (see
## _resolve_free_attack and its own mirror, _resolve_monster_free_attack).
func _monster_engaged_allies(actor: Character) -> Array:
	var engaged: Array = []
	if battle_grid == null or not battle_positions.has(actor):
		return engaged
	for a in encounter.get_living("ally"):
		if battle_positions.has(a) and BattleGrid.footprint_distance(battle_positions[actor], actor.get_footprint_size(), battle_positions[a], a.get_footprint_size()) <= 1 and encounter.is_engaged_with(actor, a):
			engaged.append(a)
	return engaged

## Live BFS over CURRENT battle-grid adjacency (Chebyshev distance 1, same
## metric as every other melee check in this file) starting from `start`,
## walking through every living combatant regardless of side or Engaged
## status — a non-engaged bystander physically standing between two
## Engaged allies shouldn't sever their cluster just by being there. Only
## combatants who have actually traded a blow with SOMEONE (see
## CombatEncounter.has_fought_anyone, checked by the headcount math in
## get_outnumbering_bonus, not here) end up counting toward either side's
## Outnumbering headcount — this function only answers "who's physically
## part of the same local scrum right now." Recomputed fresh on every
## attack (not cached) so it correctly shrinks the instant a member dies
## or repositions away, and grows the instant a new combatant steps in,
## per the request's own "these 4 combatants all now count as 1v1... until
## one side looses a member" scaling.
func _local_melee_cluster(start: Character) -> Array:
	var visited: Dictionary = {}
	if battle_grid == null or not battle_positions.has(start) or encounter.is_defeated(start):
		return []
	visited[start] = true
	var queue: Array = [start]
	var all_living: Array = encounter.get_living("ally") + encounter.get_living("adversary")
	while not queue.is_empty():
		var cur: Character = queue.pop_front()
		if not battle_positions.has(cur):
			continue
		for other in all_living:
			if visited.has(other) or not battle_positions.has(other):
				continue
			if BattleGrid.footprint_distance(battle_positions[cur], cur.get_footprint_size(), battle_positions[other], other.get_footprint_size()) <= 1:
				visited[other] = true
				queue.append(other)
	## Real bug fix ("outnumbering bonus not being removed correctly...
	## the bonus should be removed if combatant move away and are no
	## longer engaged"): the BFS walk above still has to pass THROUGH
	## every living combatant regardless of side -- a non-engaged
	## bystander standing between two separate knots of actual fighters
	## shouldn't sever them from counting as one scrum just by being
	## there, which is the whole reason this walks ally-to-ally and
	## ally-to-enemy links alike rather than only ally-to-enemy ones.
	## But being REACHABLE via that walk isn't the same as being part of
	## the fight: someone who's backed off from every enemy (moved away,
	## fled while Broken, retreated to help elsewhere) yet happens to
	## remain adjacent to an ally who's still swinging was inflating
	## that ally's Outnumbering headcount forever, since has_fought_anyone
	## is permanent and _local_melee_cluster used to return the whole
	## reachable set unfiltered. Filtered here instead: only combatants
	## who are THEMSELVES currently within melee range of at least one
	## living opposing-side combatant actually count as part of "this
	## scrum" -- someone who's stepped back out of melee range of every
	## enemy stops contributing to either side's headcount the instant
	## they do, regardless of who they're still standing next to.
	var result: Array = []
	for c in visited.keys():
		var combatant: Character = c
		var opposing_side: String = "adversary" if combatant.allegiance == "ally" else "ally"
		for enemy in all_living:
			if enemy.allegiance != opposing_side or not battle_positions.has(enemy):
				continue
			if BattleGrid.footprint_distance(battle_positions[combatant], combatant.get_footprint_size(), battle_positions[enemy], enemy.get_footprint_size()) <= 1:
				result.append(combatant)
				break
	return result

## Drilled (Up in Arms p.141) Bonus Tests gate: "Melee Tests when beside
## an ally with Drilled" — sets every living combatant's own
## Character.drilled_beside_ally fresh from CURRENT battle-grid
## adjacency (Chebyshev distance 1, same metric as every other "beside"
## check in this file), true only for a Drilled character standing next
## to ANOTHER living character (either side, per the Talent's plain
## wording) who also has Drilled. Called from _render_status() — see
## its own comment for why that's a good enough refresh cadence.
func _refresh_drilled_adjacency() -> void:
	if battle_grid == null:
		return
	var all_living: Array = encounter.get_living("ally") + encounter.get_living("adversary")
	for c in all_living:
		c.drilled_beside_ally = false
	for a in all_living:
		if a.get_talent_rank("Drilled") <= 0 or not battle_positions.has(a):
			continue
		for b in all_living:
			if b == a or not battle_positions.has(b) or b.get_talent_rank("Drilled") <= 0:
				continue
			if BattleGrid.footprint_distance(battle_positions[a], a.get_footprint_size(), battle_positions[b], b.get_footprint_size()) <= 1:
				a.drilled_beside_ally = true
				break

## Rebuilds the LeftCol turn-order panel — highlighting whoever's turn
## it is and dimming defeated combatants — and keeps the grid view in
## sync with the latest positions/current-turn/selected-target. Called
## from _render_status(), guarded so it's a no-op before
## _setup_battle_grid() has run (defensive — _render_status() is
## called from many places).
##
## Per the request: rather than always listing every combatant in the
## same fixed initiative order, the acting combatant is pinned to the
## top and each combatant drops to the bottom of the list once their
## own Turn this Round has passed, with an "End of Round" marker row
## separating "still to come this Round" from "already went" — so the
## list reads top-to-bottom as current -> upcoming -> [End of Round] ->
## already acted, and visually empties out into the bottom section over
## the course of a Round. This is purely a display-order transform:
## encounter.turn_order itself (the real fixed array advance_turn()
## cycles through every Round) is never reordered, so nothing about
## actual turn resolution changes, only how it's presented here.
func _render_turn_order_panel() -> void:
	if battle_grid == null:
		return
	_clear(turn_order_list)
	## Per the request ("Light... when cast add it to the top of the
	## turn order with number of remaining turns (1 min per round)"):
	## one row per character with an active Light spell
	## (light_spell_rounds_remaining > 0 — see character.gd), pinned
	## above even the current combatant's own row, since illumination is
	## a standing battlefield effect rather than something scoped to a
	## single Turn. Independent per character — an ally and an
	## adversary (or two different allies) each casting their own Light
	## get their own row and their own independent countdown.
	for lit_c in encounter.turn_order:
		if lit_c.light_spell_rounds_remaining <= 0:
			continue
		var light_row := HBoxContainer.new()
		light_row.add_theme_constant_override("separation", 6)
		var light_label := Label.new()
		## Per the follow-up request's own Bright/Dim/Out buttons: shown
		## here too so the turn order panel reflects the current setting
		## at a glance, not just the countdown — "bright" is the common
		## case and left unlabeled to match this row's existing look.
		var light_mode_suffix: String = ""
		if lit_c.light_spell_mode == "dim":
			light_mode_suffix = " (Dim)"
		elif lit_c.light_spell_mode == "out":
			light_mode_suffix = " (Out)"
		light_label.text = "💡 %s's Light — %d%s" % [lit_c.character_name, lit_c.light_spell_rounds_remaining, light_mode_suffix]
		light_label.add_theme_font_size_override("font_size", 9)
		light_label.add_theme_color_override("font_color", Color(0.95, 0.85, 0.55))
		light_row.add_child(light_label)
		turn_order_list.add_child(light_row)
	## Per the follow-up request ("move blessing buff count to same place
	## as the Light spell counter and show it all the time its active"):
	## every timed buff (add_timed_buff() — Blessing prayers, Cordelia's
	## Apothecary draughts, even a fumble's own Off-Balance penalty; see
	## Character.active_buffs's own comment) gets the exact same pinned-
	## row treatment as a Light spell right above, one row per buff. This
	## used to be a single "Active: X (Y)" line built in _render_status()
	## below, but that line only ever read `player.active_buffs` — since
	## `player` is reassigned all over this script to whoever's turn/kill
	## is currently being attributed (see e.g. _resolve_monster_free_
	## attack's own comment on that), a Blessing cast on a different
	## party member than whoever `player` last pointed to simply never
	## showed at all. Looping every combatant in turn_order — same as the
	## Light loop right above — fixes that: a buff on ANY combatant, ally
	## or adversary, now shows for as long as it's actually active,
	## regardless of whose turn it is or who `player` currently points to.
	for buffed_c in encounter.turn_order:
		for buff in buffed_c.active_buffs:
			var buff_row := HBoxContainer.new()
			buff_row.add_theme_constant_override("separation", 6)
			var buff_label := Label.new()
			buff_label.text = "✨ %s's %s — %d" % [buffed_c.character_name, buff["name"], buff["rounds_remaining"]]
			buff_label.add_theme_font_size_override("font_size", 9)
			buff_label.add_theme_color_override("font_color", Color(0.65, 0.85, 0.55))
			buff_row.add_child(buff_label)
			turn_order_list.add_child(buff_row)
	var current := encounter.get_current_combatant()
	var order: Array[Character] = encounter.turn_order
	var idx: int = encounter.current_turn_index
	var upcoming: Array[Character] = []
	var already_acted: Array[Character] = []
	if idx >= 0 and idx < order.size():
		upcoming = order.slice(idx + 1, order.size())
		already_acted = order.slice(0, idx)
	else:
		## No Turn has started yet (e.g. before the very first
		## advance_turn() call) — nothing to reorder around.
		upcoming = order.duplicate()

	var display: Array = []
	if current != null:
		display.append(current)
	display.append_array(upcoming)
	## The marker always sits right after the last combatant still to
	## act this Round, even when that's nobody (current is last in
	## initiative order — marker lands right below current) or
	## everybody (Round 1, Turn 1 — marker lands at the very bottom) —
	## so it always marks the true boundary where the Round wraps back
	## to the top of initiative order.
	if current != null:
		display.append(_END_OF_ROUND_MARKER)
	display.append_array(already_acted)

	for entry in display:
		if entry is String and entry == _END_OF_ROUND_MARKER:
			var marker_label := Label.new()
			marker_label.text = "═══ End of Round ═══"
			marker_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			marker_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			marker_label.add_theme_font_size_override("font_size", 7)
			marker_label.add_theme_color_override("font_color", Color(0.55, 0.48, 0.35))
			turn_order_list.add_child(marker_label)
			continue
		var c: Character = entry
		var row := HBoxContainer.new()
		row.add_theme_constant_override("separation", 6)
		var label := Label.new()
		var defeated := encounter.is_defeated(c)
		var side_marker := "🛡" if c.allegiance == "ally" else "☠"
		label.text = "%s %s%s" % [side_marker, c.character_name, " (down)" if defeated else ""]
		label.add_theme_font_size_override("font_size", 9)
		if defeated:
			label.add_theme_color_override("font_color", Color(0.4, 0.37, 0.33))
		elif c == current:
			label.add_theme_color_override("font_color", Color(0.95, 0.85, 0.4))
			label.add_theme_font_size_override("font_size", 11)
		elif c.allegiance == "ally":
			label.add_theme_color_override("font_color", Color(0.55, 0.7, 0.95))
		else:
			label.add_theme_color_override("font_color", Color(0.9, 0.5, 0.5))
		row.add_child(label)
		turn_order_list.add_child(row)

	## Per the request: the battle-map token itself now shows a real
	## icon (the same monster-type art the top strip uses, or the
	## player's own current wound-tier portrait) plus a name tag below
	## it — built fresh each render so an ally's icon keeps following
	## their portrait through its own wound-tier changes. Per the
	## follow-up request, the name tag keeps the full character_name
	## (WITH its disambiguating number, e.g. "Wolf 2") rather than the
	## stripped version an earlier build used here — reverted back to
	## the same identifier shown everywhere else (top strip, turn
	## order). _display_name() is kept for _monster_icon_for()'s own
	## internal sprite lookup below, which still needs the base name.
	var icons: Dictionary = {}
	var icon_modulates: Dictionary = {}
	var names: Dictionary = {}
	for c in battle_positions:
		if c.allegiance == "ally":
			icons[c] = _player_portrait_for(c)
			## Per the follow-up request ("add a red tint at low health") —
			## ally tokens only, same as the Attacker/Defender boxes above;
			## monster icons are untinted.
			icon_modulates[c] = CareerPortraits.wound_modulate_for_character(c)
		else:
			icons[c] = _monster_icon_for(c.character_name)
		names[c] = c.character_name
	## Ground Fire visual (see persistent_aoe_hazards' own declaration
	## comment): union every currently-active hazard's own squares into
	## one flat list for the view to draw real flame art on — recomputed
	## fresh on every render here rather than at each individual mutation
	## site (_add_persistent_aoe_hazard/_tick_persistent_aoe_hazards/the
	## Fortune-redo pop-back/the three .clear() sites), since this is
	## already the single place every other piece of live battle-map
	## state (icons, light sources, wound tints...) gets recomputed and
	## handed to grid_view.set_state() each time something changes. Same
	## union _ground_fire_squares_union() also hands _advance_toward()
	## below for its own movement-cost avoidance.
	grid_view.set_state(battle_grid, battle_positions, current, enemy_attack_focus_target if enemy_attack_focus_target != null else selected_target, icons, names, battle_is_dark, _gather_battle_light_sources(), icon_modulates, _ground_fire_squares_union().keys(), _smoke_squares_union().keys())
	## "cropped viewport centered on the party": every dungeon grid is
	## far bigger than the fixed combat canvas the view's default pan
	## was designed around, so any dungeon visit (exploring OR fighting
	## on the dungeon tile grid — see _update_dungeon_visibility()'s own
	## comment for why this can no longer stay _exploration_mode-only)
	## keeps the view snapped to whoever's turn it currently is (falling
	## back to any party member if it isn't anyone's turn yet) on every
	## status refresh — covers turn changes, door-opens, and mid-turn
	## moves alike (which also call center_on() directly at the exact
	## moment they commit, for a snappier feel than waiting on this call)
	## with one single source of truth, rather than scattering
	## re-centering calls through every place dungeon state can change.
	if not dungeon_state.is_empty():
		var center_on_char: Character = player if battle_positions.has(player) else null
		if center_on_char == null:
			for member in GameState.party:
				if battle_positions.has(member):
					center_on_char = member
					break
		if center_on_char != null:
			grid_view.center_on(battle_positions[center_on_char])

## Resolves a character's effective weapon for combat: their equipped
## manufactured weapon if they have one, otherwise a natural weapon
## built from their Creature Traits (Weapon/Bite/Horns/Tail Attack/
## Tongue Attack — see CreatureTraits.build_natural_weapon), and only
## falling back to a bare Sword if neither applies — which shouldn't
## normally happen for a real monster, but keeps a player character
## with no weapon equipped from softlocking combat.
## Fear and Terror (p.190-191): resolved once at battle start against
## every monster present with the Fear or Terror Creature Trait — the
## book's own trigger is "when you first encounter" the creature,
## which this project simplifies to "the moment the encounter begins"
## rather than tracking line-of-sight/first-spotting separately.
## Terror is checked first since a Terror-causing creature also then
## causes Fear at the same Rating; a creature with only the Fear trait
## (no Terror) skips straight to that.
##
## Hatred's "immune to Fear/Intimidate (not Terror) caused by your
## hated foe" (p.190) is simplified here too: since this project
## doesn't tag which specific enemy a Hatred Talent targets, a
## character already Subject to Hatred is immune to Fear checks
## entirely (Terror still applies, matching the book's own carve-out).
## Per the request ("let implement ... Fear ... Terror fully"): every
## present, living ally is tested now, not just whoever `player` happens
## to point at — a real bug fix, see _fear_sources' own comment for why
## the old single-flag version silently only ever covered one character
## no matter how many were actually in the fight.
func _check_fear_and_terror() -> void:
	var living_allies: Array[Character] = encounter.get_living("ally") if encounter != null else []
	if living_allies.is_empty() and player != null:
		living_allies = [player]   ## defensive fallback for any path that reaches this before turn_order is fully populated
	for ally in living_allies:
		for m in monsters:
			var has_terror := m.has_creature_trait("Terror")
			var has_fear := m.has_creature_trait("Fear")
			if not has_terror and not has_fear:
				continue
			## Fearless (p.137): "a single Average (+20) Cool Test ignores
			## any Intimidate, Fear, or Terror effect from them" — applied
			## here as a flat +20 to this initial Cool Test rather than a
			## wholly separate Test type, same translation-to-modifier
			## approach this project uses throughout (e.g. Charging's own
			## flat roll bonus). This project doesn't tag which specific
			## enemy category (Beastmen, Undead, etc.) a Fearless Talent
			## targets — same documented simplification Hatred already
			## uses just below — so any character with the Talent gets the
			## bonus against every Fear/Terror source, not just a matched
			## situation_options entry.
			var fearless_bonus := 20 if ally.has_talent("Fearless") else 0
			var fearless_breakdown: Array = [{"name": "Fearless", "amount": 20}] if fearless_bonus > 0 else []
			if has_terror:
				var rating := m.get_creature_trait_rating("Terror")
				var test := TestResolver.resolve_skill_test(ally, GameData.skill_db.find_by_name("Cool"), "", fearless_bonus, fearless_breakdown)
				var extra: Array[String] = []
				if test.success:
					extra.append("%s holds their nerve against %s's Terror." % [ally.character_name, m.character_name])
				else:
					var broken_stacks: int = rating + max(0, -test.success_levels)
					ally.add_condition("Broken", broken_stacks)
					extra.append("%s is overcome with Terror — %d Broken Condition(s)!" % [ally.character_name, broken_stacks])
				_mark_fear_source(ally, m, rating)
				extra.append("%s now also causes Fear (Rating %d) in %s." % [m.character_name, rating, ally.character_name])
				_show_single_card(ally, "Terror (%s)" % m.character_name, "Psychology Test", "ally", test, extra)
				_render_status()
				await _wait_for_continue()
			elif has_fear:
				if ally.conditions.has("Hatred"):
					continue   ## immune to Fear from Hatred's carve-out (Terror above is unaffected)
				var rating2: int = max(1, m.get_creature_trait_rating("Fear"))
				var test2 := TestResolver.resolve_skill_test(ally, GameData.skill_db.find_by_name("Cool"), "", fearless_bonus, fearless_breakdown)
				var extra2: Array[String] = []
				if test2.success:
					extra2.append("%s holds their nerve against %s." % [ally.character_name, m.character_name])
				else:
					_mark_fear_source(ally, m, rating2)
					extra2.append("%s is Subject to Fear from %s — -1 SL on Tests against it." % [ally.character_name, m.character_name])
				_show_single_card(ally, "Fear (%s)" % m.character_name, "Psychology Test", "ally", test2, extra2)
				_render_status()
				await _wait_for_continue()

## Frightening (p.190), the reverse direction of Fear/Terror above: a
## source ally grants Fear (never Terror; Frightening's own summary is
## Fear-Rating only) to every living, not-yet-tested monster present, at
## a Rating equal to that ally's own Frightening rank ("Fear Rating of 1,
## plus 1 per extra time taken"). Called from two places, per `sources`:
## _start_encounter() passes every PASSIVE ally (not the player) with
## ranks in the Talent — no per-ally toggle UI in this project (same
## simplification every other passive ally Talent already gets), so
## theirs is always assumed active from the start of the fight. The
## player's own copy instead only gets checked from _on_toggle_
## frightening(), the moment they flick their Free Action toggle ON —
## frightening_active always starts OFF (see _start_encounter's reset),
## so the player's monsters aren't tested until that toggle actually
## fires, unlike every passive ally's.
## Mirrors _check_fear_and_terror()'s own structure with "the scared one"
## and "the source" swapped: each living monster tests Cool against each
## source in `sources`, and a failure marks the MONSTER as Subject to
## Fear via _mark_monster_fear_source (see its own comment, and
## _monster_fear_sources' declaration, for how this then feeds the
## attack-penalty code in _monster_attack/_resolve_player_defense, the
## per-Round Extended Test in _tick_fear_extended_tests(), and the
## approach-check in _apply_reverse_fear_approach_checks()).
## _monster_fear_tested (per monster, per source) makes sure a given
## monster/source pair is only ever tested once for the rest of the
## fight — without it, toggling frightening_active off then back on
## would let the player keep re-rolling the same monster's Cool Test
## over and over until it finally fails, which the book's own "when you
## first encounter" one-shot trigger never allows.
## This project has no monster-side "Fearless"-equivalent Creature Trait
## to carve out (only Fearless the player Talent exists), so no monster is
## assumed immune — same documented-simplification spirit as Hatred's own
## carve-out just above, just with nothing on this side to carve out yet.
func _check_reverse_fear_from_frightening(sources: Array[Character]) -> void:
	if sources.is_empty():
		return
	for m in (encounter.get_living("adversary") if encounter != null else monsters):
		for ally in sources:
			if _monster_fear_tested.get(m, {}).has(ally):
				continue   ## already resolved once against this specific source
			if not _monster_fear_tested.has(m):
				_monster_fear_tested[m] = {}
			_monster_fear_tested[m][ally] = true
			var rating: int = ally.get_talent_rank("Frightening")
			var test := TestResolver.resolve_skill_test(m, GameData.skill_db.find_by_name("Cool"), "")
			var extra: Array[String] = []
			if test.success:
				extra.append("%s holds its nerve against %s." % [m.character_name, ally.character_name])
			else:
				_mark_monster_fear_source(m, ally, rating)
				extra.append("%s is Subject to Fear from %s — -1 SL (-10) on Tests against them." % [m.character_name, ally.character_name])
			_show_single_card(m, "Fear (%s)" % ally.character_name, "Psychology Test", "adversary", test, extra)
			_render_status()
			await _wait_for_continue()

## Fear (Rating), p.190-191: "an Extended Cool Test... your SL must
## exceed the Fear Rating before you can be free of the effects." Per
## the request ("let implement ... Fear ... fully"): the initial
## Psychology Test above only ever set a permanent flag before this —
## there was no way to actually shake Fear off mid-fight. Attempted once
## per Round (called from _next_turn() only when a Round genuinely just
## ended, same gating as the Broken Condition's own end-of-Round Cool
## Test) for every living ally still Subject to Fear from a still-living
## source; each attempt's own SL (which can be negative, same as any
## other Extended Test) adds to a running total, and once that total
## reaches the source's own Fear Rating, the ally is free of it.
func _tick_fear_extended_tests() -> void:
	for ally in encounter.get_living("ally"):
		if not _fear_sources.has(ally):
			continue
		for m in _fear_sources[ally].keys().duplicate():
			if encounter.is_defeated(m):
				_fear_sources[ally].erase(m)   ## nothing left to be afraid of
				continue
			var rating: int = _fear_rating.get(ally, {}).get(m, 1)
			var test := TestResolver.resolve_skill_test(ally, GameData.skill_db.find_by_name("Cool"), "")
			var running: int = int(_fear_extended_sl.get(ally, {}).get(m, 0)) + test.success_levels
			if not _fear_extended_sl.has(ally):
				_fear_extended_sl[ally] = {}
			_fear_extended_sl[ally][m] = running
			if running >= rating:
				_fear_sources[ally].erase(m)
				_add_notice("[color=#8fbf6a]%s finally masters their fear of %s.[/color]" % [ally.character_name, m.character_name])
	## Reverse direction: monsters shaking off Fear caused by a
	## Frightening ally, same Extended Test cadence and math as the ally
	## loop just above — see _monster_fear_sources' own comment.
	for m in encounter.get_living("adversary"):
		if not _monster_fear_sources.has(m):
			continue
		for ally in _monster_fear_sources[m].keys().duplicate():
			if encounter.is_defeated(ally):
				_monster_fear_sources[m].erase(ally)   ## nothing left to be afraid of
				continue
			var rating2: int = _monster_fear_rating.get(m, {}).get(ally, 1)
			var test2 := TestResolver.resolve_skill_test(m, GameData.skill_db.find_by_name("Cool"), "")
			var running2: int = int(_monster_fear_extended_sl.get(m, {}).get(ally, 0)) + test2.success_levels
			if not _monster_fear_extended_sl.has(m):
				_monster_fear_extended_sl[m] = {}
			_monster_fear_extended_sl[m][ally] = running2
			if running2 >= rating2:
				_monster_fear_sources[m].erase(ally)
				_add_notice("[color=#8fbf6a]%s finally masters its fear of %s.[/color]" % [m.character_name, ally.character_name])

func _resolve_weapon(c: Character) -> WeaponDefinition:
	var w := c.get_equipped_weapon()
	if w != null:
		return w
	var natural := CreatureTraits.build_natural_weapon(c)
	if natural != null:
		return natural
	## Per the light-source follow-up request: a Lantern/Candle/etc now
	## occupies equipped_weapon/equipped_offhand exactly like a real
	## weapon would (see Character.get_equipped_light_item()) — so
	## equipped_weapon can be non-empty here without resolving to any
	## real WeaponDefinition. _start_encounter() above already force-
	## assigns a real "Sword" to anyone whose equipped_weapon is
	## genuinely EMPTY before this function ever runs, so reaching this
	## fallback now specifically means "occupied by something that
	## isn't a weapon" — fighting unarmed is the correct result, not a
	## phantom free Sword nobody actually equipped.
	return GameData.weapon_db.find_by_name("Unarmed")

## Per the reported combat stall (Round 18, frozen on the Wight's turn
## with the action panel completely empty): several call sites used to
## index `weapons[player]` directly. `player` gets reassigned mid-turn
## to whichever party member is actually defending (see
## _prompt_player_defense's own `player = attack_target` just above
## _monster_attack) — if that Character was ever missing from the
## `weapons` cache for any reason, the direct index throws and silently
## aborts the calling function right where it stands. In
## _prompt_player_defense() specifically, that landed AFTER
## pending_defense/awaiting_player_target were already set but BEFORE
## any button was actually rendered — exactly the "flag says legitimate
## wait, but nothing is on screen" state the watchdog just below
## couldn't distinguish from a real wait. Self-healing: falls back to
## _resolve_weapon() (never null — worst case "Unarmed") and caches the
## result so the cache repairs itself instead of throwing again next
## lookup for the same Character.
func _weapon_for(c: Character) -> WeaponDefinition:
	var w: WeaponDefinition = weapons.get(c)
	## Flaming Sword of Rhuin's own enchant self-expires on Character
	## (flaming_sword_rounds_remaining, ticked once per Round by
	## CombatEncounter._on_round_end() — outside this screen's own
	## reach, so this cache can't be told the instant that happens).
	## Treat a cached flaming clone as stale the moment the Character's
	## own timer says it's over, so the very next lookup after expiry
	## falls through to a fresh _resolve_weapon() (which reads
	## Character.get_equipped_weapon(), already flaming-aware) instead
	## of serving the stale enchanted stats forever.
	if w != null and w.weapon_name == "Flaming Sword of Rhuin" and c.flaming_sword_rounds_remaining <= 0:
		w = null
	## Sigmar's Fiery Hammer — same staleness problem, same fix: its
	## rename is tied to the "Sigmar's Fiery Hammer" active_buffs entry,
	## which also only ever ticks down/expires via CombatEncounter's own
	## per-Round tick_active_buffs() call, outside this screen's reach.
	## Matched by the renamed clone's own fixed name prefix
	## ("Sigmar's Fiery Hammer (1H)"/"(2H)" — see _apply_prayer_buff_
	## effect()), same begins_with() approach Flaming Sword's own exact-
	## name check uses just above.
	if w != null and w.weapon_name.begins_with("Sigmar's Fiery Hammer") and not c.has_active_buff("Sigmar's Fiery Hammer"):
		w = null
	if w == null:
		w = _resolve_weapon(c)
		weapons[c] = w
	return w

## Off-hand equivalent of _resolve_weapon() above, for the player's own
## 2nd Attack button and Dual Wielder's own follow-up strike (see
## both). No natural-weapon fallback (that's a whole-creature trait
## with no separate off-hand version of its own) — just the real
## off-hand item if it's a genuine weapon, else Unarmed, per the
## request ("allow switch to Unarmed on both hands and should be the
## default weapon if nothing is equipped in either hand"). Always
## returns a real WeaponDefinition, defaulting to Unarmed exactly like
## the main-hand resolver — callers that need to know whether the
## off-hand is actually SWINGABLE at all (a non-weapon item like a
## Lantern occupying it, or no free hand because the main weapon is
## two-handed) check that themselves first, same as the off-hand
## weapon-switch button already does.
func _resolve_offhand_weapon(c: Character) -> WeaponDefinition:
	var w := c.get_offhand_weapon()
	if w != null:
		return w
	return GameData.weapon_db.find_by_name("Unarmed")

## Per the follow-up request ("when using Dual Wield it should be
## possible to initiate a Dual wield attack both both main hand or off
## hand, so long both hand a weapon equipped"): Dual Wielder's
## two-strike combo needs a genuine weapon — a real WeaponDefinition,
## or an empty slot, which now defaults to Unarmed, itself a real
## Brawling weapon — in BOTH hands, not just whichever hand throws the
## first strike. A non-weapon item (a Lantern, etc.) occupying either
## slot means that hand has nothing to swing, so the combo can't
## happen at all — same principle as a two-handed main weapon leaving
## no free off-hand to begin with.
func _dual_wield_eligible(c: Character) -> bool:
	if c.main_weapon_is_two_handed():
		return false
	var main_ok := c.equipped_weapon == "" or GameData.weapon_db.find_by_name(c.equipped_weapon) != null
	var off_ok := c.equipped_offhand == "" or GameData.weapon_db.find_by_name(c.equipped_offhand) != null
	return main_ok and off_ok

## Every living combatant's own active light source, if any, as a
## battle-grid {"pos": Vector2i, "radius": int} pair (radius already
## converted from the item's own yards to whole battle-grid squares —
## see BattleGrid.YARDS_PER_SQUARE). Empty whenever the battle isn't
## dark in the first place, since nothing needs to punch a hole in
## darkness that was never applied. Used both to decide the Melee/
## Ranged Darkness penalty (_darkness_penalty()/_tile_is_lit()) and to
## paint the lit squares on the battle map itself (BattleGridView's own
## battle_dark_active/dark_light_sources, pushed in set_state()).
func _gather_battle_light_sources() -> Array:
	var out: Array = []
	if not battle_is_dark:
		return out
	for c in battle_positions.keys():
		if encounter.is_defeated(c) or not c.has_active_light_source():
			continue
		var radius_yd: int = c.get_active_light_radius_tiles()
		var radius_sq := int(ceil(float(radius_yd) / float(BattleGrid.YARDS_PER_SQUARE)))
		out.append({"pos": battle_positions[c], "radius": radius_sq})
	return out

## Is `pos` within reach of an active light source? Always true when the
## battle isn't dark in the first place. `extra_yards`, per Night
## Vision's own card text ("extend the effective illumination distance
## of any light sources by 20 yards per level"), widens every light
## source's own radius by that much for this one check — used only by
## _darkness_penalty()'s own Night-Vision-in-a-pitch-black-place branch,
## never for the battle map's own visual (which shows what's ACTUALLY
## lit, not what one particular character's Talent lets them see).
func _tile_is_lit(pos: Vector2i, extra_yards: int = 0) -> bool:
	if not battle_is_dark:
		return true
	var extra_sq := int(ceil(float(extra_yards) / float(BattleGrid.YARDS_PER_SQUARE))) if extra_yards > 0 else 0
	for src in _gather_battle_light_sources():
		if BattleGrid.distance_squares(src["pos"], pos) <= int(src["radius"]) + extra_sq:
			return true
	return false

## Darkness combat penalties, per the request: Melee attacks made from
## a dark square suffer -20; Ranged attacks against a target standing
## in a dark square suffer -30 — Ranged is about seeing the TARGET
## clearly, Melee is about the ATTACKER's own immediate vision, hence
## checking a different square for each. The Night Vision Talent (or
## the Creature Trait most non-humanoid night hunters carry instead)
## negates this as long as the attacker has at least a faint source of
## ambient light — true everywhere except a genuinely pitch-black
## battle_is_pitch_black location with no light source in reach (its
## own card text: "assuming you have at least a faint source of
## light..."); its own "extend the effective illumination distance of
## any light sources by 20 yards per level" is modelled as extra_yards
## on that same reach check. Dark Vision negates it unconditionally —
## "sees in the dark as if it were daylight," no light needed at all.
func _darkness_penalty(attacker: Character, target: Character, is_ranged: bool) -> int:
	if not battle_is_dark:
		return 0
	var relevant: Character = target if is_ranged else attacker
	if not battle_positions.has(relevant) or _tile_is_lit(battle_positions[relevant]):
		return 0
	if attacker.has_creature_trait("Dark Vision"):
		return 0
	var nv_rank: int = attacker.get_talent_rank("Night Vision")
	if nv_rank <= 0 and attacker.has_creature_trait("Night Vision"):
		nv_rank = 1
	if nv_rank > 0:
		if not battle_is_pitch_black:
			return 0
		if _tile_is_lit(battle_positions[relevant], nv_rank * 20):
			return 0
	return -30 if is_ranged else -20

## Preview-only "chance to hit" target number for the Attack button's own
## label (per the request: "Attack button text with '[Weapon Name] -
## [The target Roll Number including any modifiers for the current
## target]'"). Deliberately side-effect-free — no Advantage pool
## changes, no dice rolled — so it's safe to compute every time the
## action menu redraws, not just on an actual attack. Mirrors the real
## target-number math from TestResolver.resolve_skill_test() +
## CombatResolver.resolve_melee_attack()/resolve_ranged_attack() as
## closely as a preview reasonably can: base skill, Additional Effort,
## Fear, Darkness, Charge (melee, only while actually charging),
## Outnumbering (melee), Range + Cover (ranged), Weapon Length /
## Distracting / Size (melee — replicated here since resolve_melee_attack
## computes them internally rather than exposing them standalone),
## Accurate + target Size (ranged, same reason), and any Condition
## penalties (Fatigued, Blinded, etc.). Deliberately leaves out weapon-
## quality modifiers that only ever affect the DEFENDER's own roll
## (Wrap, Fast/Slow, big-creature defense penalties) — those don't
## belong in the attacker's own target number.
func _preview_attack_target_number(weapon: WeaponDefinition, tgt: Character, is_charge: bool, is_offhand: bool = false) -> int:
	var skill_def: SkillDefinition = GameData.skill_db.find_by_name("Ranged" if weapon.is_ranged else "Melee")
	var base_target: int = player.get_skill_value(skill_def, weapon.skill_group)
	var modifier := pending_effort_bonus
	modifier += -10 if _fear_sources.get(player, {}).has(tgt) else 0
	modifier += _darkness_penalty(player, tgt, weapon.is_ranged)
	## Off-hand penalty (p.136 sidebar): matches _on_player_attack's own
	## primary_off_hand_penalty exactly — melee only, rank-scaled by
	## Ambidextrous (see Character.get_offhand_penalty()) — so this
	## preview number never lies about what the attack will actually
	## need to roll under.
	if is_offhand and not weapon.is_ranged:
		modifier += player.get_offhand_penalty()

	if weapon.is_ranged:
		## Weapon Groups (p.296): Accurate is a Quality, lost when firing a
		## Ranged Group the player has no Advances in (see
		## Character.get_effective_weapon_qualities()).
		if player.get_effective_weapon_qualities(weapon).has("Accurate"):
			modifier += 10
		modifier += CombatResolver.RANGED_SIZE_MODIFIERS[tgt.get_size_step()]
		if battle_grid != null and battle_positions.has(player) and battle_positions.has(tgt):
			var dist_yd := BattleGrid.distance_yards(battle_positions[player], battle_positions[tgt])
			var range_band := BattleGrid.get_range_band(dist_yd, player.get_effective_weapon_range(weapon))
			if range_band != BattleGrid.RangeBand.OUT_OF_RANGE:
				modifier += BattleGrid.get_range_band_modifier(range_band)
			var cover_info: Dictionary = battle_grid.get_ranged_cover(battle_positions[player], battle_positions[tgt])
			if not cover_info.get("blocked", false):
				modifier += int(cover_info.get("penalty", 0))
	else:
		modifier += 10 if is_charge else 0
		if encounter != null:
			## Player is passed as pretend-already-has_fought_anyone (see
			## get_outnumbering_bonus's own comment) so this preview matches
			## what mark_melee_engaged()+get_outnumbering_bonus() will
			## actually produce once this attack is really thrown, without
			## prematurely recording an engagement the player might still
			## cancel out of. The physical cluster itself is real live
			## battle-grid adjacency, not pretend.
			modifier += encounter.get_outnumbering_bonus(player, _local_melee_cluster(player), true)
		var defender_weapon_for_length := tgt.get_equipped_weapon()
		if defender_weapon_for_length != null and not defender_weapon_for_length.is_ranged:
			var reach_rank := {"Personal": 0, "Very Short": 1, "Short": 2, "Average": 3, "Long": 4, "Very Long": 5, "Massive": 6}
			var attacker_reach_rank: int = reach_rank.get(weapon.reach, 3)
			var defender_reach_rank: int = reach_rank.get(defender_weapon_for_length.reach, 3)
			if defender_reach_rank > attacker_reach_rank:
				modifier -= 10
		if tgt.has_creature_trait("Distracting") and not player.has_creature_trait("Distracting"):
			modifier -= 20
		if player.get_size_step() < tgt.get_size_step():
			modifier += 10

	var scopes := [skill_def.skill_name, skill_def.display_name(weapon.skill_group), skill_def.linked_characteristic]
	var condition_penalties := player.get_condition_test_penalty_breakdown(scopes)
	for entry in condition_penalties:
		modifier += int(entry["amount"])

	return base_target + modifier

## --- Enemy display (basic visual: icon + name + HP bar) -------------------

## --- Combat Attacker / Defender status boxes -------------------------
##
## Per the request ("update the x enemies close in around you window...
## remove everything inside the window. Then split into left half
## Attacker / right half Defender... fill the attacker half with a box
## identical to the party character boxes used in the camp screen, this
## will always show whoever is current turn it is (player or monster).
## Then mirror this box for the Defender side exactly, this will always
## be whoever the attacker is actively targeting"): the old per-monster
## panel row (one box per enemy, with click-to-target and hover-to-
## focus wired onto each) is gone. Targeting the map is still done by
## clicking a token directly on the battle grid — that path
## (_on_grid_square_clicked) never went through these panels anyway.
##
## Deliberately mirrors camp_screen.gd's _build_character_box layout
## (portrait filling the left column, name/career, a 25%-width HP bar
## with the wound count overlaid, the Fate/Fortune/Resilience/Resolve
## grid, Corruption, Conditions, Critical Wounds) so the two screens'
## character boxes read as the same visual language, per the request.
## This is a separate copy, not shared code — the two screens are
## otherwise unrelated scenes. If camp_screen.gd's box design changes
## again later, bring the same change here to keep them matching.
const COMBAT_BOX_NAME_FONT_SIZE := 12
const COMBAT_BOX_SMALL_FONT_SIZE := 10
## Per the follow-up request ("give the top bar icons a lot more space"):
## the Attacker/Defender box portrait used to be a narrow 60px-wide sliver
## — fine for the old square 40x40 wound-tier sprites, but with real
## portrait art (especially a full-body creature action pose) a narrow
## STRETCH_KEEP_ASPECT_COVERED crop was zooming in tight and showing only
## a thin vertical strip of the middle of the image. Widened substantially
## so most/all of the actual art shows.
const COMBAT_BOX_PORTRAIT_WIDTH := 150

func _combat_box_small_label(text: String, color: Color = Color(0.75, 0.72, 0.66), align_right: bool = false) -> Label:
	var lbl := Label.new()
	lbl.text = text
	lbl.add_theme_font_size_override("font_size", COMBAT_BOX_SMALL_FONT_SIZE)
	lbl.add_theme_color_override("font_color", color)
	lbl.autowrap_mode = TextServer.AUTOWRAP_WORD
	if align_right:
		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	return lbl

## Same as _combat_box_small_label but WITHOUT autowrap — see camp_
## screen.gd's own _stat_label for why a wrapping label inside a
## multi-column grid is the wrong choice (collapses the grid's own
## width computation toward 0).
func _combat_box_stat_label(text: String, color: Color = Color(0.75, 0.72, 0.66), align_right: bool = false) -> Label:
	var lbl := Label.new()
	lbl.text = text
	lbl.add_theme_font_size_override("font_size", COMBAT_BOX_SMALL_FONT_SIZE)
	lbl.add_theme_color_override("font_color", color)
	if align_right:
		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	return lbl

## Per the request ("add floating test SL outcome for test in the
## fields for attacker/defender(if opposed), wining roll should have
## green box, losing roll a red box"): a small bordered chip showing
## that side's own signed Success Level ("%+d" reads "+1"/"-2"/"+0"
## the same way every other SL readout in this project already
## formats it), coloured by whether that side actually won the
## opposition — not simply by whether `sl` itself is positive, since a
## defender can roll a positive SL and still lose the opposition to an
## attacker who rolled higher.
func _build_vs_sl_chip(sl: int, won: bool) -> PanelContainer:
	var chip := PanelContainer.new()
	var style := StyleBoxFlat.new()
	var accent: Color = Color(0.3, 0.85, 0.35) if won else Color(0.85, 0.3, 0.3)
	style.bg_color = Color(accent.r, accent.g, accent.b, 0.12)
	style.border_width_left = 2
	style.border_width_top = 2
	style.border_width_right = 2
	style.border_width_bottom = 2
	style.border_color = accent
	style.corner_radius_top_left = 4
	style.corner_radius_top_right = 4
	style.corner_radius_bottom_left = 4
	style.corner_radius_bottom_right = 4
	style.content_margin_left = 10
	style.content_margin_right = 10
	style.content_margin_top = 4
	style.content_margin_bottom = 4
	chip.add_theme_stylebox_override("panel", style)

	var lbl := Label.new()
	lbl.text = "%+d" % sl
	lbl.add_theme_font_size_override("font_size", 20)
	lbl.add_theme_color_override("font_color", accent)
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	chip.add_child(lbl)
	return chip

## Per the follow-up request ("the defender box should be a MIRROR of
## the attacker box layout, not exactly the same"): `mirrored` flips
## the whole box left-right — portrait moves from the left column to
## the right column, and every text element that used to hug the
## portrait's immediate side (left-aligned, growing away from it) now
## hugs the portrait's new side instead (right-aligned, growing away
## from it the other direction), so the two boxes visually face each
## other across the panel's own center divide instead of both reading
## identically left-to-right.
func _build_combat_status_box(member: Character, mirrored: bool = false) -> PanelContainer:
	var panel := PanelContainer.new()
	var style := StyleBoxFlat.new()
	## Per the follow-up request ("make the attacker/defender box
	## background colour transparent"): alpha 0 instead of the solid
	## dark fill every other status box (camp screen, ally strip) still
	## uses — these two sit directly over the battle map now, so a
	## see-through background lets the map show through behind them
	## instead of covering it with an opaque panel.
	style.bg_color = Color(0.14, 0.11, 0.08, 0.0)
	style.corner_radius_top_left = 5
	style.corner_radius_top_right = 5
	style.corner_radius_bottom_left = 5
	style.corner_radius_bottom_right = 5
	style.content_margin_left = 8
	style.content_margin_right = 8
	style.content_margin_top = 6
	style.content_margin_bottom = 6
	if member.wounds_current <= 0:
		panel.modulate = Color(0.55, 0.55, 0.55, 1)
	panel.add_theme_stylebox_override("panel", style)

	var outer_hbox := HBoxContainer.new()
	outer_hbox.add_theme_constant_override("separation", 8)
	panel.add_child(outer_hbox)

	var portrait := TextureRect.new()
	portrait.texture = _player_portrait_for(member) if member.allegiance == "ally" else _monster_icon_for(member.character_name)
	## Per the follow-up request ("add a red tint at low health") — ally
	## side only, since Career portraits are the only art this applies
	## to; monster icons are a separate, untinted art set.
	if member.allegiance == "ally":
		portrait.modulate = CareerPortraits.wound_modulate_for_character(member)
	portrait.custom_minimum_size = Vector2(COMBAT_BOX_PORTRAIT_WIDTH, 0)
	portrait.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	portrait.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
	portrait.size_flags_vertical = Control.SIZE_EXPAND_FILL

	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override("separation", 6)
	vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	## HBoxContainer lays children out in add order — swapping which one
	## gets added first is the whole flip.
	if mirrored:
		outer_hbox.add_child(vbox)
		outer_hbox.add_child(portrait)
	else:
		outer_hbox.add_child(portrait)
		outer_hbox.add_child(vbox)

	## Per the follow-up request ("if the monster has no class show it's
	## faction instead"): a monster has no career (member.career stays
	## null — see MonsterDefinition.to_character()), so this used to
	## fall all the way back to a bare "?". monster_faction (Beast,
	## Greenskin, Undead, ...) is a real, meaningful fallback for those;
	## a career-templated Bandit/Outlaw already has a real career to
	## show and never reaches the faction fallback, and a genuine player
	## character's monster_faction is always "" so its own "?" fallback
	## is unchanged.
	var name_class_text: String
	if member.career:
		name_class_text = member.career.career_name
	elif member.monster_faction != "":
		name_class_text = member.monster_faction
	else:
		name_class_text = "?"
	var name_lbl := Label.new()
	## Flight (p.343): a flying Defender is genuinely harder to hit at
	## range (the +1 range-band step) and a flying Attacker is fighting
	## at -20 — both penalties are otherwise invisible outside a combat
	## breakdown tooltip, so this box (the one thing on screen a player
	## actually looks at before choosing to shoot) gets a plain textual
	## flag the moment currently_flying is set for this Character.
	var flying_tag: String = " (Flying)" if currently_flying.get(member, false) else ""
	name_lbl.text = "%s — %s%s" % [member.character_name, name_class_text, flying_tag]
	name_lbl.add_theme_font_size_override("font_size", COMBAT_BOX_NAME_FONT_SIZE)
	name_lbl.add_theme_color_override("font_color", Color(0.9, 0.85, 0.7))
	name_lbl.clip_text = true
	if mirrored:
		name_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	vbox.add_child(name_lbl)

	## Per the follow-up request ("give attacker/defender box HP bars
	## additional 20% height and make them 20% longer"): 16 -> 19 (+20%
	## height) and the bar's own share of the row's width 25% -> 30%
	## (+20% longer, i.e. 0.25 * 1.2).
	var hp_wrap := Control.new()
	hp_wrap.custom_minimum_size = Vector2(0, 19)
	hp_wrap.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vbox.add_child(hp_wrap)

	## The HP bar sits in the 30% of the row nearest the portrait in the
	## un-mirrored box (anchors 0.0-0.30, the left edge, right next to
	## the portrait to its left) — mirrored, the portrait's on the right,
	## so the bar moves to anchors 0.70-1.0 to keep hugging it.
	var hp_bar_box := Control.new()
	hp_bar_box.anchor_left = 0.70 if mirrored else 0.0
	hp_bar_box.anchor_top = 0.0
	hp_bar_box.anchor_right = 1.0 if mirrored else 0.30
	hp_bar_box.anchor_bottom = 1.0
	hp_wrap.add_child(hp_bar_box)

	var hp_bar := ProgressBar.new()
	hp_bar.max_value = max(member.wounds_max, 1)
	hp_bar.value = member.wounds_current
	hp_bar.show_percentage = false
	hp_bar.set_anchors_preset(Control.PRESET_FULL_RECT)
	var pct: float = float(member.wounds_current) / float(max(member.wounds_max, 1))
	var fill := StyleBoxFlat.new()
	fill.bg_color = Color(0.2, 0.75, 0.25) if pct > 0.5 else (Color(0.85, 0.65, 0.15) if pct > 0.25 else Color(0.75, 0.15, 0.15))
	fill.corner_radius_top_left = 2
	fill.corner_radius_top_right = 2
	fill.corner_radius_bottom_left = 2
	fill.corner_radius_bottom_right = 2
	hp_bar.add_theme_stylebox_override("fill", fill)
	var bg := StyleBoxFlat.new()
	bg.bg_color = Color(0.08, 0.07, 0.06)
	bg.border_width_left = 1
	bg.border_width_top = 1
	bg.border_width_right = 1
	bg.border_width_bottom = 1
	bg.border_color = Color(0.6, 0.55, 0.4)
	bg.corner_radius_top_left = 2
	bg.corner_radius_top_right = 2
	bg.corner_radius_bottom_left = 2
	bg.corner_radius_bottom_right = 2
	hp_bar.add_theme_stylebox_override("background", bg)
	hp_bar_box.add_child(hp_bar)
	var wound_lbl := Label.new()
	wound_lbl.text = "Defeated" if encounter.is_defeated(member) else "%d/%d" % [member.wounds_current, member.wounds_max]
	wound_lbl.add_theme_font_size_override("font_size", COMBAT_BOX_SMALL_FONT_SIZE)
	wound_lbl.add_theme_color_override("font_color", Color(1, 1, 1))
	wound_lbl.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.85))
	wound_lbl.add_theme_constant_override("outline_size", 2)
	wound_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	wound_lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	wound_lbl.set_anchors_preset(Control.PRESET_FULL_RECT)
	wound_lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hp_bar_box.add_child(wound_lbl)

	const STAT_COLOR := Color(0.75, 0.72, 0.66)
	const DEPLETED_COLOR := Color(0.85, 0.35, 0.3)
	var stats_grid := GridContainer.new()
	stats_grid.columns = 2
	stats_grid.add_theme_constant_override("h_separation", 20)
	stats_grid.add_theme_constant_override("v_separation", 6)
	## Per the follow-up request ("move fate/fort/resil/resolve to the
	## Right side... for defenders"): a GridContainer's own position
	## inside its parent VBoxContainer is governed by size_flags, not by
	## its children's text alignment — the labels themselves were
	## already right-aligned when mirrored (see _combat_box_stat_label's
	## align_right param below), but the grid control itself still sat
	## at the vbox's LEFT edge (SIZE_SHRINK_BEGIN, the container
	## default), far from the portrait now on the right. SHRINK_END
	## docks the whole grid to the vbox's right edge instead, right next
	## to the portrait — matching how the name/Corruption/Conditions
	## lines above and below it already hug that same side.
	stats_grid.size_flags_horizontal = Control.SIZE_SHRINK_END if mirrored else Control.SIZE_SHRINK_BEGIN
	## Per the follow-up request ("hide monster fate/fort/resil/resolve.
	## put the monsters Size there"): those four stats are a player-
	## character-shaped concept — an ordinary creature (see
	## monster_definition.gd's to_character(), which now zeroes all
	## four by default) essentially never has them, so showing "Fate 0
	## / Resilience 0 / Resolve 0/0" on every monster box was just
	## noise. Size (p.341's Size Creature Trait — Character.get_size_step(),
	## "Average" if the creature has no explicit Size Trait) is the
	## actually-relevant at-a-glance stat for a monster instead.
	##
	## Per the request's own follow-up ("make sure conditions and crit
	## wounds remain on the same line... do not get moved up due to
	## less lines"): the grid stays a full 2x2 (4-cell) grid either way
	## — an adversary's version just has 3 of those 4 cells filled with
	## an empty-text label instead of a real stat — so its total height
	## is identical to the ally version's, and every line below it
	## (Corruption, Conditions, Critical Wounds) lands at exactly the
	## same Y it always has, regardless of which box style is showing.
	if member.allegiance == "ally":
		## Per the request, the grid's own column ORDER mirrors too (not
		## just text alignment) — Fortune before Fate, Resolve before
		## Resilience — so a two-column grid genuinely reads right-to-left
		## like the rest of the mirrored box, not just right-aligned text
		## sitting in the same left-to-right column order as the Attacker's.
		var fate_lbl := _combat_box_stat_label("Fate %d" % member.fate_points, STAT_COLOR, mirrored)
		var fortune_lbl := _combat_box_stat_label("Fortune %d/%d" % [member.fortune_points, member.get_max_fortune_points()],
			DEPLETED_COLOR if member.fortune_points <= 0 else STAT_COLOR, mirrored)
		var resilience_lbl := _combat_box_stat_label("Resilience %d" % member.resilience, STAT_COLOR, mirrored)
		var resolve_lbl := _combat_box_stat_label("Resolve %d/%d" % [member.resolve, member.resilience],
			DEPLETED_COLOR if member.resolve <= 0 else STAT_COLOR, mirrored)
		if mirrored:
			stats_grid.add_child(fortune_lbl)
			stats_grid.add_child(fate_lbl)
			stats_grid.add_child(resolve_lbl)
			stats_grid.add_child(resilience_lbl)
		else:
			stats_grid.add_child(fate_lbl)
			stats_grid.add_child(fortune_lbl)
			stats_grid.add_child(resilience_lbl)
			stats_grid.add_child(resolve_lbl)
	else:
		var size_lbl := _combat_box_stat_label("Size: %s" % Character.SIZE_STEPS[member.get_size_step()], STAT_COLOR, mirrored)
		## Per the follow-up request ("add monster armor value next to
		## its size"): a single at-a-glance AP figure — natural hide/
		## carapace (the Armour Creature Trait, p.338, which applies to
		## every hit location) plus whatever's equipped covering the
		## Body, the same representative location the rest of the UI
		## already falls back to for a single-number armour readout
		## (see CombatResolver.HIT_LOCATIONS's own "Body" fallback).
		var armour_lbl := _combat_box_stat_label("AP: %d" % member.get_armour_points("Body"), STAT_COLOR, mirrored)
		if mirrored:
			stats_grid.add_child(armour_lbl)
			stats_grid.add_child(size_lbl)
		else:
			stats_grid.add_child(size_lbl)
			stats_grid.add_child(armour_lbl)
		stats_grid.add_child(_combat_box_stat_label("", STAT_COLOR, mirrored))
		stats_grid.add_child(_combat_box_stat_label("", STAT_COLOR, mirrored))
	vbox.add_child(stats_grid)

	var corruption_threshold: int = member.get_corruption_threshold()
	var corruption_color := Color(0.75, 0.72, 0.66)
	if member.corruption_points > 0:
		var corruption_ratio: float = clamp(float(member.corruption_points) / float(max(corruption_threshold, 1)), 0.0, 1.0)
		corruption_color = Color(0.78, 0.6, 0.88).lerp(Color(0.32, 0.14, 0.4), corruption_ratio)
	vbox.add_child(_combat_box_small_label("Corruption %d/%d" % [member.corruption_points, corruption_threshold], corruption_color, mirrored))

	var cond_parts: Array[String] = []
	for cond_name in member.conditions.keys():
		var stacks: int = member.conditions[cond_name]
		cond_parts.append("%s x%d" % [cond_name, stacks] if stacks > 1 else cond_name)
	if not cond_parts.is_empty():
		vbox.add_child(_combat_box_small_label(", ".join(cond_parts), Color(0.85, 0.75, 0.5), mirrored))

	if member.active_critical_wound_count > 0:
		vbox.add_child(_combat_box_small_label("%d Critical Wound(s):" % member.active_critical_wound_count, Color(0.85, 0.55, 0.5), mirrored))
		for penalty in member.critical_wound_penalties:
			var char_keys: Array = penalty["characteristic_bonuses"].keys()
			var detail := ""
			if not char_keys.is_empty():
				var char_key: String = char_keys[0]
				var amount: int = penalty["characteristic_bonuses"][char_key]
				detail = " (%+d %s, %d day(s) left)" % [amount, CharacteristicSet.SHORT_NAMES.get(char_key, char_key), penalty["rounds_remaining"]]
			vbox.add_child(_combat_box_small_label("  %s%s" % [penalty["name"], detail], Color(0.85, 0.55, 0.5), mirrored))
		var untracked: int = member.active_critical_wound_count - member.critical_wound_penalties.size()
		if untracked > 0:
			vbox.add_child(_combat_box_small_label("  %d other old wound(s), no ongoing penalty" % untracked, Color(0.85, 0.55, 0.5), mirrored))

	return panel

## Player's own status panel — same visual language as an enemy panel
## (portrait, name, HP bar, Conditions/Critical Wounds line — see
## _build_enemy_display's own condition_label, added later per a
## follow-up request).
##
## Per the request ("use the new portraits in all Icon, in and out of
## combat"): every ally-side portrait in this screen (Attacker/Defender
## boxes, the party status strip, and the turn-order icons below) now
## shows that Character's own Career portrait via CareerPortraits,
## instead of swapping between the old four generic wound-tier sprites
## by Wounds percentage — there's one image per Career, not per wound
## tier, so the swap-by-HP behaviour is gone along with it. Enemy-side
## icons are untouched (_monster_icon_for), since that's a separate,
## not-yet-integrated art set.
func _player_portrait_for(member: Character) -> Texture2D:
	return CareerPortraits.get_portrait_for_character(member)

## Per the request: one real, visible panel per present party member,
## not just whoever's currently acting — a separate, compact status
## strip from the Attacker/Defender boxes above (see
## _build_combat_status_box), which only ever show two characters at
## a time.
func _build_player_display() -> void:
	for child in player_display_panel.get_children():
		child.queue_free()
	ally_panels.clear()
	for member in GameState.party:
		var panel := PanelContainer.new()
		var style := StyleBoxFlat.new()
		style.bg_color = Color(0.16, 0.12, 0.09)
		## Per the request ("25% of their current size, but text
		## elements still readable, stack 2 beside each other"): every
		## dimension below (margins, portrait, hp_bar, separations) is
		## roughly a quarter of its old value — see FieldEncounter.tscn's
		## PlayerDisplayPanel, now a 2-column GridContainer instead of a
		## single-column VBoxContainer, which is what actually needs
		## these panels narrow enough to sit two to a row inside LeftCol's
		## fixed 340px width. Font sizes are shrunk too but floored well
		## above the point where they'd stop being legible.
		style.corner_radius_top_left = 4
		style.corner_radius_top_right = 4
		style.corner_radius_bottom_left = 4
		style.corner_radius_bottom_right = 4
		style.content_margin_left = 6
		style.content_margin_right = 6
		style.content_margin_top = 4
		style.content_margin_bottom = 4
		panel.add_theme_stylebox_override("panel", style)

		var row := HBoxContainer.new()
		row.add_theme_constant_override("separation", 5)
		var portrait := TextureRect.new()
		portrait.custom_minimum_size = Vector2(26, 26)
		portrait.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		portrait.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
		portrait.clip_contents = true
		portrait.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		## Per the request ("use the new portraits in all Icon"): the old
		## 40x40 sprite was small pixel art, so KEEP_ASPECT_CENTERED +
		## NEAREST kept it crisp. The new Career portraits are full
		## painterly art, not pixel art, so this icon now crops-to-fill
		## (COVERED) with the default smooth filter instead — NEAREST on
		## a detailed image downscaled to 26x26 would look jagged.
		portrait.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
		row.add_child(portrait)

		var box := VBoxContainer.new()
		box.add_theme_constant_override("separation", 1)
		box.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		var name_label := Label.new()
		name_label.text = member.character_name
		name_label.add_theme_font_size_override("font_size", 6)
		name_label.clip_text = true
		box.add_child(name_label)
		var hp_bar := ProgressBar.new()
		hp_bar.custom_minimum_size = Vector2(70, 7)
		hp_bar.show_percentage = false
		box.add_child(hp_bar)
		var wound_label := Label.new()
		wound_label.add_theme_font_size_override("font_size", 5)
		wound_label.add_theme_color_override("font_color", Color(0.8, 0.75, 0.65))
		box.add_child(wound_label)
		## Per the request: Fortune Points are otherwise invisible during
		## normal play — the only place they used to show up at all was
		## the transient Fatal-Moment/defense spend prompt itself, so
		## there was no way to see at a glance how much Fortune a party
		## member had left to plan around. Shown right under Wounds,
		## same small-label treatment, refreshed live in
		## _refresh_player_display() alongside everything else.
		var fortune_label := Label.new()
		fortune_label.add_theme_font_size_override("font_size", 5)
		fortune_label.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
		box.add_child(fortune_label)
		## Per the request: Corruption tracked "next to Fortune" in the
		## combat character icon boxes, same small-label treatment,
		## shown as current/Threshold (Willpower Bonus + Toughness
		## Bonus — see Character.get_corruption_threshold()).
		var corruption_label := Label.new()
		corruption_label.add_theme_font_size_override("font_size", 5)
		corruption_label.add_theme_color_override("font_color", Color(0.65, 0.45, 0.75))
		box.add_child(corruption_label)
		var condition_label := Label.new()
		condition_label.add_theme_font_size_override("font_size", 4)
		condition_label.add_theme_color_override("font_color", Color(0.85, 0.6, 0.5))
		condition_label.autowrap_mode = TextServer.AUTOWRAP_WORD
		box.add_child(condition_label)
		row.add_child(box)
		panel.add_child(row)
		panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		player_display_panel.add_child(panel)

		ally_panels[member] = {"panel": panel, "style": style, "hp_bar": hp_bar, "wound_label": wound_label, "fortune_label": fortune_label, "corruption_label": corruption_label, "portrait": portrait, "condition_label": condition_label}
	_refresh_player_display()

func _refresh_player_display() -> void:
	for member in GameState.party:
		if not ally_panels.has(member):
			continue
		var refs: Dictionary = ally_panels[member]
		var hp_bar: ProgressBar = refs["hp_bar"]
		var wound_label: Label = refs["wound_label"]
		var fortune_label: Label = refs["fortune_label"]
		var corruption_label: Label = refs["corruption_label"]
		var portrait: TextureRect = refs["portrait"]
		var condition_label: Label = refs["condition_label"]
		var panel: PanelContainer = refs["panel"]
		var style: StyleBoxFlat = refs["style"]

		hp_bar.max_value = max(member.wounds_max, 1)
		hp_bar.value = member.wounds_current
		var pct: float = float(member.wounds_current) / float(max(member.wounds_max, 1))
		var fill := StyleBoxFlat.new()
		fill.bg_color = Color(0.2, 0.75, 0.25) if pct > 0.5 else (Color(0.85, 0.65, 0.15) if pct > 0.25 else Color(0.75, 0.15, 0.15))
		fill.corner_radius_top_left = 2
		fill.corner_radius_top_right = 2
		fill.corner_radius_bottom_left = 2
		fill.corner_radius_bottom_right = 2
		hp_bar.add_theme_stylebox_override("fill", fill)
		wound_label.text = "%d/%d" % [member.wounds_current, member.wounds_max]
		fortune_label.text = "Fortune: %d" % member.fortune_points
		corruption_label.text = "Corruption: %d/%d" % [member.corruption_points, member.get_corruption_threshold()]
		portrait.texture = _player_portrait_for(member)
		## Per the follow-up request ("add a red tint at low health").
		portrait.modulate = CareerPortraits.wound_modulate_for_character(member)

		## Conditions and active Critical Wounds, in one compact line.
		var parts: Array[String] = []
		for cond_name in member.conditions.keys():
			var stacks: int = member.conditions[cond_name]
			parts.append("%s x%d" % [cond_name, stacks] if stacks > 1 else cond_name)
		if member.active_critical_wound_count > 0:
			parts.append("%d Critical Wound(s)" % member.active_critical_wound_count)
		condition_label.text = ", ".join(parts) if not parts.is_empty() else ""

		## Per the request: whichever party member is currently
		## acting/being controlled gets a real, visible highlight —
		## the same border-based approach already proven for the
		## Overworld HUD's own party panels.
		style.border_width_left = 2 if member == player else 0
		style.border_width_top = 2 if member == player else 0
		style.border_width_right = 2 if member == player else 0
		style.border_width_bottom = 2 if member == player else 0
		style.border_color = Color(0.72, 0.58, 0.27)
		panel.modulate = Color(1, 1, 1, 1) if not encounter.is_defeated(member) else Color(0.5, 0.5, 0.5, 1)

## Rebuilds the Attacker/Defender boxes (see _build_combat_status_box
## and its own leading comment). Kept the name _refresh_enemy_display
## and every one of its ~20 existing call sites (after every Wounds/
## Condition/target change, etc.) even though it's no longer an
## in-place update — a full rebuild is cheap here (exactly two boxes),
## and simplest: WHO is shown changes exactly as often as their stats
## do, so an in-place-update approach would still need to detect
## identity changes on top of everything else this already had to
## refresh.
func _refresh_enemy_display() -> void:
	_clear(attacker_box_container)
	_clear(defender_box_container)
	_clear(vs_sl_box)

	var attacker: Character = (encounter.get_current_combatant() if encounter != null else null)
	if attacker != null:
		attacker_box_container.add_child(_build_combat_status_box(attacker))

	## Same fallback _render_turn_order_panel()'s own grid_view.set_state()
	## call already uses for the battle-map crosshair: a monster's live
	## pick while it's actually that monster's Turn (enemy_attack_focus_
	## target), otherwise the player's own persistent target selector.
	var defender: Character = enemy_attack_focus_target if enemy_attack_focus_target != null else selected_target
	if defender != null:
		defender_box_container.add_child(_build_combat_status_box(defender, true))

	## Per the request: floating +N/-N SL chips between the two boxes —
	## only for the most recent OPPOSED test, and only while it's still
	## actually about this exact Attacker/Defender pairing (a new turn
	## or a re-targeted defender leaves _last_opposed_sl_result pointing
	## at characters no longer shown here, so it's simplest to just
	## check identity every rebuild rather than separately remembering
	## to clear it on every path that changes `attacker`/`defender`).
	if not _last_opposed_sl_result.is_empty() and attacker != null and defender != null \
			and _last_opposed_sl_result.get("attacker") == attacker and _last_opposed_sl_result.get("defender") == defender:
		vs_sl_box.add_child(_build_vs_sl_chip(_last_opposed_sl_result["attacker_sl"], _last_opposed_sl_result["attacker_won"]))
		vs_sl_box.add_child(_build_vs_sl_chip(_last_opposed_sl_result["defender_sl"], _last_opposed_sl_result["defender_won"]))

## Sets the persistent target selector. Stays selected across turns and
## actions — "remembers the last enemy hit" is satisfied automatically
## since nothing resets it except this call or the target dying.
## Per the request ("allow targeting of allies, but don't allow
## offensive actions against them"): `m` can now be an ally as well as
## a monster — selecting one is purely a display/focus action (the
## Defender box, the map's own crosshair ring), never something that
## can feed an actual Attack/Charge/Distract/Intimidate/Struggle Free
## (see _render_turn_action_menu's own `target` filter and
## _on_player_attack's own guard, both of which refuse anything but a
## living adversary). ally_focus_target is specifically this
## character's remembered ATTACK target, restored automatically at the
## start of their next turn (see _prompt_player_turn) — an ally
## selection is deliberately never written there, so it can never come
## back as tomorrow's default "who am I fighting."
func _select_target(m: Character) -> void:
	if encounter.is_defeated(m):
		return
	## Real bug fix ("player should not be able to target monster they
	## can not see yet with melee (including charge) and ranged
	## attacks"): refused right at this single choke point, before
	## selected_target ever changes, rather than only at the attack-
	## execution end — see _can_see_target()'s own comment. Allies are
	## never affected (_can_see_target always returns true for them).
	if not _can_see_target(m):
		_add_notice("You can't see %s well enough to target them." % m.character_name)
		return
	selected_target = m
	if player != null and m.allegiance != "ally":
		ally_focus_target[player] = m
	_refresh_enemy_display()
	## Per the request: move the battle-map focus ring the moment a new
	## target is picked, i.e. a direct click on the enemy's own icon on
	## the grid (_on_grid_square_clicked) — instead of it only catching
	## up on the next full _render_status() pass.
	if grid_view != null:
		grid_view.set_selected_target(m)
	if awaiting_player_target and pending_defense.is_empty():
		_prompt_player_turn(false)

## If the current selection is missing or dead, fall back to this
## character's own remembered target (ally_focus_target — see its own
## comment) if that's still alive, otherwise the first living enemy —
## so there's always a valid target to act against.
##
## Deliberately does NOT treat a currently-selected ALLY as invalid —
## per the request ("allow targeting of allies... but don't allow
## offensive actions against them"), an ally selection is legitimate
## for display (Defender box, map crosshair) and this function runs on
## every _prompt_player_turn() call, including the many mid-turn
## re-renders after an ordinary action — forcing it back to an
## adversary here would yank the ally selection away the instant the
## player so much as looked at it. See _prompt_player_turn's own
## is_fresh_turn block for where a stale ally selection genuinely does
## get cleared: only at the START of a fresh Turn, never mid-turn.
func _ensure_valid_target() -> void:
	## Real bug fix ("player should not be able to target monster they
	## can not see yet"): the existing-selection early-return, the
	## remembered-target restore, and the "first living enemy" default
	## all used to accept an adversary regardless of visibility — this
	## function runs on every _prompt_player_turn() call, so it's the
	## other main place (besides a direct click, see _select_target())
	## selected_target can change. See _can_see_target()'s own comment;
	## always true for an ally, so the ally-selection case just below is
	## unaffected.
	if selected_target != null and not encounter.is_defeated(selected_target) and _can_see_target(selected_target):
		return
	var remembered: Character = ally_focus_target.get(player)
	if remembered != null and not encounter.is_defeated(remembered) and _can_see_target(remembered):
		selected_target = remembered
		return
	var living := encounter.get_living("adversary")
	for m in living:
		if _can_see_target(m):
			selected_target = m
			return
	selected_target = null

## Core round loop: advances to the next living combatant's Turn (via
## CombatEncounter, which handles Round wrap-around and the Group
## Advantage round-end rule automatically), checks for a finished
## battle, then either prompts the player or runs a monster's Turn.
## Broken (p.168) end-of-Round recovery difficulty, scaled to
## circumstance per the book's own guidance ("Average (+20) if safe,
## Very Hard (-30) if still in danger") rather than a flat Challenging
## (+0) every time — approximated here off distance to the nearest
## living enemy, since this project has no separate "how dangerous does
## this feel" concept beyond the battle grid itself.
func _broken_recovery_modifier_for(actor: Character) -> int:
	if battle_grid == null or not battle_positions.has(actor):
		return 0
	var enemies: Array[Character] = encounter.get_living("adversary" if actor.allegiance == "ally" else "ally")
	var closest := 9999
	for e in enemies:
		if battle_positions.has(e):
			closest = min(closest, BattleGrid.footprint_distance(battle_positions[actor], actor.get_footprint_size(), battle_positions[e], e.get_footprint_size()))
	if closest <= 2:
		return -30   ## Very Hard -- still right on top of them
	if closest >= 8:
		return 20    ## Average -- genuinely clear of the fight
	return 0         ## Challenging -- this project's existing baseline

## Broken (p.168): "a full Round spent hidden and out of line of sight
## of the enemy" — true only when battle_grid.has_line_of_sight (which
## the random battle-obstacle scatter's Bush/High Grass/Tree/etc. now
## make genuinely achievable, not just a theoretical rule) fails against
## EVERY still-living opposing combatant. A snapshot taken once, right
## before the Round actually ends (see _next_turn()), rather than
## continuously tracked minute-by-minute — a documented simplification,
## same principle as this project's other "checked at the meaningful
## moment, not continuously" Psychology rules (_check_fear_and_terror's
## own comment makes the same call for when Fear/Terror first applies).
func _is_hidden_from_enemies(actor: Character) -> bool:
	if battle_grid == null or not battle_positions.has(actor):
		return false
	var enemies: Array[Character] = encounter.get_living("adversary" if actor.allegiance == "ally" else "ally")
	if enemies.is_empty():
		return false
	for e in enemies:
		if battle_positions.has(e) and battle_grid.has_line_of_sight(battle_positions[actor], battle_positions[e]):
			return false
	return true

## Real bug fix, per the report ("player should not be able to target
## monster they can not see yet with melee (including charge) and ranged
## attacks"): nothing anywhere previously checked line of sight before
## letting the player select or attack a monster — clicking a living
## adversary's own token always worked, and _targets_in_weapon_range()
## (which drives both the melee "is anything actually reachable" check
## and the ranged targeting arrow list) never excluded one hidden behind
## a battle obstacle (Bush/High Grass/Tree — see _is_hidden_from_enemies'
## own comment on how genuinely achievable that already is) or around a
## corner. Uses the exact same has_line_of_sight() check
## _is_hidden_from_enemies() already relies on for the reverse case
## (whether the PLAYER's side can be seen), rather than inventing a
## second notion of "can see." Checked against every cell of the
## target's own footprint (Large/Enormous/Monstrous creatures — same
## "any cell it occupies counts" convention _on_grid_square_clicked's own
## ranged-targeting click handler already uses), so a big creature only
## needs ONE visible cell to count as spotted. Always true for a non-
## adversary (allies are always known/tracked, never "hidden" in this
## sense) and fails open (true) whenever there's no real battle_grid or
## position to check against yet, matching every other targeting
## function's own existing fallback convention in this file.
func _can_see_target(m: Character) -> bool:
	if m == null or m.allegiance != "adversary":
		return true
	if battle_grid == null or not battle_positions.has(player) or not battle_positions.has(m):
		return true
	var footprint: Array = BattleGrid.footprint_cells(battle_positions[m], m.get_footprint_size())
	for cell in footprint:
		if battle_grid.has_line_of_sight(battle_positions[player], cell):
			return true
	return false

## Per the follow-up request ("clear the selected target (stop trying to
## remember the last one) after the turn"): reverses the "remembers the
## last enemy hit" behavior an earlier request explicitly asked for
## (v0.2.293, ally_focus_target — see _prompt_player_turn's own former
## restore block, removed alongside this). Called right at the top of
## _next_turn(), before advance_turn() runs, so `encounter.get_current_
## combatant()` here is still genuinely whoever's Turn is ending — that
## character's own remembered target is erased and the shared selector
## itself reset, before anything else about the next Turn gets decided.
## A fresh Turn's own _ensure_valid_target() call already knows how to
## pick a sensible default (first living enemy) for a selection that's
## simply missing, exactly as it always has — nothing downstream needs
## to know this was a memory wipe rather than an ordinary "no target
## yet" state.
##
## Pulled out into its own small function (rather than left inline in
## _next_turn()) specifically so a regression test can exercise this
## exact reset in isolation — see remembered_target_across_rounds_test.gd
## — without having to route through the rest of _next_turn()'s own
## Turn-dispatch (which would fire a real, uncontrolled monster AI
## coroutine whenever the resulting Turn happens to be an adversary's).
func _clear_target_memory_for_ending_turn() -> void:
	var turn_ending: Character = encounter.get_current_combatant() if encounter != null else null
	if turn_ending != null:
		ally_focus_target.erase(turn_ending)
	selected_target = null

func _next_turn() -> void:
	## Defensive clear — see _pending_decline_action's own declaration.
	## If the Turn is ending here (rather than the normal _finish_player_
	## action() -> _prompt_player_turn(false) continuation), a Free
	## Action/Act Again queued from a Fortune/Dark Deal preview click
	## never got its safe moment to fire this Turn (e.g. movement was
	## already exhausted) — discarded rather than left to fire later in
	## some future, unrelated turn's _prompt_player_turn() call.
	_pending_decline_action = Callable()
	_pending_decline_action_player = null
	if skip_next_turn_call_once:
		## This call is a deliberate no-op. Act Again's handler has ALREADY
		## rendered the fresh action menu for the same player
		## (awaiting_player_target/move_mode_active included) by the time
		## this suppressed call runs; the two defensive resets below must
		## not run on this path or they'd clobber that state right back out.
		skip_next_turn_call_once = false
		return
	_clear_target_memory_for_ending_turn()
	## Real bug fix: every normal move-commit path already exits move mode
	## itself before deciding whether to end the Turn, but
	## _on_end_turn_pressed() (and its Enter-hotkey equivalent) end the
	## Turn directly with no such call — a player who opened Move mode and
	## then ended their Turn without ever clicking a destination left it
	## active. Since _do_monster_turn() never touches target_container or
	## the battle-map overlay at all, that leftover "Cancel Move" UI simply
	## stayed on screen, untouched and still fully clickable, all the way
	## through every following monster Turn.
	if move_mode_active:
		_exit_move_mode()
	## Other half of the fix above: awaiting_player_target is what every
	## action button's own handler checks before doing anything. Nothing
	## ever reset it to false on the path INTO a monster's Turn, so a Turn
	## ended via End Turn left every one of the previous player's stale
	## buttons genuinely still live and clickable through the monster's
	## Turn — not just a leftover visual, but functionally still able to
	## fire. _prompt_player_turn() sets it back to true immediately on an
	## ally's own next Turn, so this only actually matters for monster
	## turns, which need it false anyway.
	awaiting_player_target = false
	## Follow-up real bug fix, per the user's own report + screenshot:
	## "another case of player controlling the monster during their
	## turn." The fix just above only ever made the previous ally's
	## leftover action menu functionally inert (every handler's own
	## awaiting_player_target guard) — it deliberately left the actual
	## Button nodes sitting in target_container/side_actions_container
	## untouched, on the (correct, but incomplete) assumption that an
	## inert button was harmless. In practice a whole Attack/Defence/
	## Movement menu — Cancel Move, weapon-switch, an actual weapon's
	## Attack button, Disengage, all still fully visible and readable —
	## left on screen throughout a monster's own Turn reads exactly like
	## "the player is still controlling someone" even though clicking
	## any of it is genuinely a no-op. _do_monster_turn() itself still
	## never touches these containers (a monster's Turn has no menu of
	## its own to show), so this is the one place — right where every
	## Turn transition already funnels through — that can guarantee no
	## stale menu ever survives past the Turn that built it, for both
	## the monster-turn and ally-turn cases alike (the ally branch just
	## below immediately rebuilds via _prompt_player_turn() anyway, so
	## clearing here first is harmless there, not just for monsters).
	_clear(target_container)
	_clear(side_actions_container)
	## Follow-up real bug fix, per the user's own report + screenshot:
	## "the player controlling monster bug again, the giant bat moved to
	## attack eric, but before he did we got the move arrow from the
	## monster." Root cause: grid_view.set_charge_ready() (the static red
	## "Charge" arrow drawn from _render_turn_action_menu()'s own
	## can_charge check) is ONLY ever called from inside
	## _render_turn_action_menu() — which only ever runs for an ally's own
	## turn — and was never added to this function's own turn-transition
	## reset checklist above (move_mode_active / awaiting_player_target /
	## the two menu containers) when it was introduced, since the Charge-
	## ready arrow feature was built after those three fixes. The arrow
	## itself is drawn in BattleGridView._draw() from
	## `positions[current_turn_character]` — which DOES correctly update
	## to the acting monster every Turn (see set_state(), called by
	## _render_status() below) — to whatever `charge_ready_target` was
	## last set to by the previous ally's own turn. The result: a
	## Charge-style arrow that visually starts at the CORRECT (monster)
	## square, same as this whole bug class always looks, pointing at a
	## stale target square left over from the ally who acted before it.
	## Cleared here unconditionally, same choke point as every other
	## piece of per-turn battle-map overlay state, so nothing from an
	## ally's own turn can ever survive to be misread as the monster
	## somehow being the one controlling it.
	if grid_view != null:
		grid_view.set_charge_ready(Vector2i(-1, -1))
	if battle_over:
		return
	## Exploration mode (see the big section above _exit_tree()): while
	## exploring, encounter.get_living("adversary") is legitimately empty
	## the whole time no monsters have been encountered yet — that must
	## NOT read as "victory" the way it would for a normal fight. Once
	## monsters spawn in (_spawn_monsters_during_exploration() sets
	## _exploration_mode = false for the fight's duration), this guard
	## naturally stops applying and a real empty-adversaries victory is
	## detected exactly as it always has been.
	if encounter.get_living("adversary").is_empty() and not _exploration_mode:
		_end_battle(true)
		return
	if encounter.get_living("ally").is_empty():
		_end_battle(false)
		return

	## Broken Condition (p.168) round-end recovery inputs — see
	## CombatEncounter.broken_recovery_modifier/hidden_from_enemies'
	## own comments. Refreshed right before every advance_turn() call
	## (cheap; only actually consumed by _on_round_end() inside it, once
	## per Round when the turn order wraps) rather than only when a
	## Round is about to end, since there's no cheap way to know that in
	## advance from out here — CombatEncounter itself decides that.
	var round_before := encounter.round_number
	for c in encounter.turn_order:
		if encounter.is_defeated(c):
			continue
		encounter.broken_recovery_modifier[c] = _broken_recovery_modifier_for(c)
		encounter.hidden_from_enemies[c] = _is_hidden_from_enemies(c)
	var current := encounter.advance_turn()
	if encounter.round_number != round_before:
		## Fear (Rating)'s own Extended Test (p.190-191) is attempted
		## once per Round, same cadence as Broken's own recovery Test
		## just above — but unlike that one (handled entirely inside
		## Character/CombatEncounter), this screen resolves the actual
		## Cool Tests and shows cards for them itself, so it needs an
		## explicit "did a Round genuinely just end" gate rather than
		## running on every single Turn.
		await _tick_fear_extended_tests()
		## Ground hazards (Great Fires of U'Zhul, Firewall) tick on the
		## exact same "a real Round genuinely just wrapped" cadence —
		## see _tick_persistent_aoe_hazards()'s own comment.
		_tick_persistent_aoe_hazards()
	_log_round_end_condition_results()
	## Per the request: round-end Condition ticks (Bleeding, Ablaze) run
	## inside advance_turn() itself, and can kill the last enemy on
	## their own — a check made only at the top of this function, before
	## advance_turn() ran, would miss that entirely and keep looping
	## toward a Turn prompt for a battle that's already over. Re-checked
	## here, and again after the defeated-combatant skip loop below,
	## since either round-end ticks or advancing past a Bleeding-out
	## combatant could be what finishes the enemy side off.
	if encounter.get_living("adversary").is_empty() and not _exploration_mode:
		_end_battle(true)
		return
	if encounter.get_living("ally").is_empty():
		_end_battle(false)
		return

	var safety := 0
	while current != null and encounter.is_defeated(current) and safety < 50:
		current = encounter.advance_turn()
		_log_round_end_condition_results()
		if encounter.get_living("adversary").is_empty() and not _exploration_mode:
			_end_battle(true)
			return
		if encounter.get_living("ally").is_empty():
			_end_battle(false)
			return
		safety += 1
	if current == null:
		return

	## Per the request: the enemy-attack focus ring only belongs on the
	## battle map during a monster's own turn (see
	## enemy_attack_focus_target's own comment) — cleared here, before
	## _render_status() below picks it up, the instant it's an ally's
	## turn again, so the ring reverts to that ally's own selected_target
	## instead of lingering on whoever the last monster attacked.
	if current.allegiance == "ally":
		enemy_attack_focus_target = null

	_render_status()
	## Per the request ("during combat always focus the camera on the
	## current attacker when at the start of their turn"): a plain,
	## instant snap — same math as the dungeon-exploration "camera
	## follows the party" re-center (see BattleGridView.center_on's own
	## comment) but reused here for every fresh Turn, ally or monster
	## alike, not just dungeon movement. Deliberately NOT animated: this
	## is "look here now, a new Turn just began," a hard cut same as a
	## real camera cutting to whoever's about to act — the eased/animated
	## version (center_on_animated, see _follow_camera_on_enemy_move) is
	## reserved for actually following a monster's own movement mid-turn.
	if grid_view != null and battle_positions.has(current):
		grid_view.center_on(battle_positions[current])
	if current.allegiance == "ally":
		defensive_stance_active = false   ## Defensive Stance only lasts until the start of the player's own next turn
		## Per the request: every present party member gets the real,
		## full interactive UI on their own turn — reassigning this
		## same `player` variable every other piece of this whole
		## screen already reads from is what makes that possible
		## without rewriting the UI itself per character; whoever's
		## turn it is becomes "player" for the duration of it.
		player = current
		## Real bug fix: the ally panel highlight (which party member
		## has a visible border) is driven by _refresh_player_display()
		## re-evaluating member == player for every panel — but nothing
		## ever called it again after this reassignment, so the
		## highlight stayed on whoever acted previously instead of
		## following the actual current turn. Placed here rather than
		## inside _prompt_player_turn() itself so it still runs even on
		## an incapacitated turn, which returns early before reaching
		## that function's own main body.
		_refresh_player_display()
		_prompt_player_turn()
	else:
		_do_monster_turn(current)
		_start_monster_turn_watchdog(current)

## Per the request: Move and Action can be spent in either order, so
## using the Action no longer ends the Turn outright — every Action-
## consuming handler (Attack, Cast, Sprint, etc.) sets
## action_used_this_turn = true itself once it actually commits, then
## calls this at the very end instead of _next_turn() directly. Only
## actually advances the Turn once there's no Move left either;
## otherwise reopens the menu (_prompt_player_turn(false) preserves all
## turn state) so the player can still spend their remaining Move.
## Mirrors the War Wizard free-cast precedent in _on_cast_spell, which
## already reopens rather than ends the Turn for its own reason.
func _finish_player_action() -> void:
	## Mirrors _next_turn()'s own top-of-function check: if Act Again was
	## triggered mid-resolution (see _on_additional_action), it already
	## reset action_used_this_turn and reopened a fresh action menu itself
	## — this trailing call is the original handler's own "I'm done" tail
	## and must be a no-op here rather than redundantly reopening (or
	## worse, ending) a Turn that Act Again just extended.
	if skip_next_turn_call_once:
		skip_next_turn_call_once = false
		return
	## Per the request: an action that just ended the battle outright (the
	## last adversary — or, in principle, ally — falling) must still go
	## straight through to _next_turn()'s own _end_battle() handling
	## rather than reopening a menu for a fight that's already over, even
	## if the player technically still had movement left to spend.
	if movement_remaining <= 0 or encounter.get_living("adversary").is_empty() or encounter.get_living("ally").is_empty():
		_next_turn()
	else:
		_prompt_player_turn(false)

## Reports Master Condition List round-end effects (p.167-169) — the
## Bleeding/Ablaze/Poisoned Wound loss encounter.advance_turn() just
## applied via CombatEncounter._on_round_end() — plus the Group
## Advantage Pool's "Losing Advantage" shift (p.134), to the combat
## log. Gated to only run once per actual Round wrap: this used to be
## called after every single advance_turn(), but the underlying data
## only changes on a wrap, so on ordinary turn-to-turn calls it was
## silently re-logging the exact same notices over and over until the
## next wrap — a real, previously-existing duplicate-logging bug.
## Snapshots wounds/Conditions for every combatant — the baseline a
## future call to _log_round_end_condition_results() compares against
## to build that Round's own consolidated report. Called once right
## after _start_encounter()'s own roll_initiative() (Round 1's start),
## and again every time a Round wrap is detected below (resetting the
## baseline for the Round that's now beginning).
func _snapshot_round_start() -> void:
	_round_start_wounds.clear()
	_round_start_conditions.clear()
	for c in encounter.combatants:
		_round_start_wounds[c] = c.wounds_current
		_round_start_conditions[c] = c.conditions.keys()

## Combat Encounter rework (per the request): "make an end of round
## report for the combat log" — a single consolidated notice per Round,
## rather than the several separate, scattered notices this used to
## emit piecemeal (Advantage shift, Condition ticks, damage taken all
## used to be their own independent _add_notice calls with nothing
## tying them together as "this is what happened in Round N"). Reports
## the Round that just ended (encounter.round_number has already been
## incremented to the NEW Round by the time advance_turn() returns, so
## the label below is round_number - 1), then re-snapshots for the
## Round that's now starting.
func _log_round_end_condition_results() -> void:
	if encounter.round_number == _last_logged_round:
		return
	_last_logged_round = encounter.round_number
	var ended_round: int = encounter.round_number - 1

	var report_lines: Array[String] = []

	## --- Wounds lost this Round (any source — attacks, Bleeding/Ablaze/
	## Poison, anything else that touched wounds_current), per combatant
	## still tracked from the snapshot taken at this Round's own start.
	for c in encounter.combatants:
		if not _round_start_wounds.has(c):
			continue   ## joined mid-round (shouldn't normally happen) — nothing to diff against
		var start_wounds: int = _round_start_wounds[c]
		var lost: int = start_wounds - c.wounds_current
		if lost > 0:
			report_lines.append("[color=#c9564b]%s took %d Wound(s) (now %d/%d).[/color]" % [c.character_name, lost, c.wounds_current, c.wounds_max])
		elif lost < 0:
			report_lines.append("[color=#8fbf6a]%s recovered %d Wound(s) (now %d/%d).[/color]" % [c.character_name, -lost, c.wounds_current, c.wounds_max])
		if encounter.is_defeated(c) and start_wounds > 0:
			report_lines.append("[color=#c9564b][b]%s is down![/b][/color]" % c.character_name)

	## --- New Conditions gained/lost this Round -------------------------
	for c in encounter.combatants:
		if not _round_start_conditions.has(c):
			continue
		var before: Array = _round_start_conditions[c]
		var after: Array = c.conditions.keys()
		for cond in after:
			if not before.has(cond):
				report_lines.append("[color=#a0708a]%s gained %s.[/color]" % [c.character_name, cond])
		for cond2 in before:
			if not after.has(cond2):
				report_lines.append("[color=#8fbf6a]%s lost %s.[/color]" % [c.character_name, cond2])

	## --- Bleeding/Ablaze/Poison round-end ticks and their own notes ----
	for c2 in encounter.last_round_end_condition_results.keys():
		var result: Dictionary = encounter.last_round_end_condition_results[c2]
		if result["died_from_bleeding"]:
			c2.wounds_current = 0
			report_lines.append("[color=#c9564b][b]%s bleeds out and dies.[/b][/color]" % c2.character_name)
		for note in result.get("notes", []):
			report_lines.append("[color=#8fbf6a]%s's %s.[/color]" % [c2.character_name, note])

	## --- Group Advantage's "Losing Advantage" shift (p.134) ------------
	var adv: Dictionary = encounter.last_round_end_advantage_summary
	if not adv.is_empty():
		var ally_delta: int = adv["ally_after"] - adv["ally_before"]
		var adversary_delta: int = adv["adversary_after"] - adv["adversary_before"]
		if ally_delta != 0 or adversary_delta != 0:
			report_lines.append("[color=#c9a04b]Advantage (%s dominant): Ally %d→%d (%+d), Adversary %d→%d (%+d).[/color]" % [
				adv["dominant_side"].capitalize(), adv["ally_before"], adv["ally_after"], ally_delta,
				adv["adversary_before"], adv["adversary_after"], adversary_delta,
			])

	## Per the request: the generic pattern for a bespoke, one-off
	## Creature Trait with its own sub-table (Maddening Aura being the
	## first concrete example) — checked once per Round, folded into the
	## same consolidated report as everything else above.
	var aura_lines := BespokeTraitAuras.check_round_start_auras(monsters + [player])
	for line in aura_lines:
		report_lines.append("[color=#a0708a]%s[/color]" % line)
	if not aura_lines.is_empty():
		_render_status()

	if not report_lines.is_empty():
		_add_notice("[b]═══ Round %d Report ═══[/b]\n%s" % [ended_round, "\n".join(report_lines)])

	_snapshot_round_start()

## --- Player turn: action menu -------------------------------------------

func _prompt_player_turn(is_fresh_turn: bool = true) -> void:
	if is_fresh_turn:
		pending_effort_bonus = 0
		additional_action_used_this_turn = false
		action_used_this_turn = false
		war_wizard_used_this_turn = false
		## Stride (p.343) — see the fresh-battle reset's own comment.
		movement_remaining = int(round(player.get_movement() * 2 * player.get_stride_multiplier()))
		moved_this_turn = false
		## Entangled (p.168): "On your turn, you may not Move" — see the
		## matching comment at battle-start above for why this is a full
		## block rather than just a Test penalty.
		if player.conditions.has("Entangled"):
			movement_remaining = 0
		move_mode_active = false
		sprint_finish_pending = false
		sprint_used_this_turn = false
		disengaged_this_turn = false
		main_weapon_switched_this_turn = false
		offhand_weapon_switched_this_turn = false
		ammo_switched_this_turn.clear()
		_charge_blocked_targets.clear()
		## Per the follow-up request ("clear the selected target (stop
		## trying to remember the last one) after the turn"): this used to
		## restore this character's own remembered target here
		## (ally_focus_target) -- that whole memory is now wiped the
		## instant their PREVIOUS turn actually ended (see _next_turn()'s
		## own turn-transition reset), so selected_target always arrives
		## here already null and _ensure_valid_target() below picks a
		## fresh "first living enemy" default every time, same as it
		## always has for a target that's simply missing. `remembered`
		## below is left hard-wired to null (rather than deleting this
		## whole block) so the history of the earlier "remembers the last
		## enemy hit" request this reverses stays visible right where
		## that logic used to live.
		var remembered: Character = null
		if remembered != null and not encounter.is_defeated(remembered):
			selected_target = remembered
		elif selected_target != null and selected_target.allegiance == "ally":
			## Per the request ("allow targeting of allies... but don't
			## allow offensive actions against them"): a fresh Turn must
			## never inherit an ally selection left over from whoever
			## acted last — _ensure_valid_target() below only resets a
			## null/dead selection (deliberately, so a mid-turn ally
			## look isn't yanked away — see that function's own
			## comment), so a stale ally selection is cleared here
			## instead, right where the rest of this fresh-turn reset
			## already happens.
			selected_target = null
	awaiting_player_target = true
	pending_defense.clear()
	_ensure_valid_target()

	## See _pending_decline_action's own declaration for the full "why."
	## This is the first safe moment to run a Free Action/Act Again that
	## was clicked from the Fortune/Dark Deal preview row: awaiting_
	## player_target/pending_defense are already back in their normal
	## live state (so the queued handler's own internal guards read
	## correctly), and — because _prompt_player_turn() is exactly the
	## function every action-resolution chain calls once it's genuinely
	## done and about to reopen the normal menu — nothing downstream can
	## still be mid-flight to race against. Guarded on the player still
	## matching whoever queued it, so a stale action (the turn ended and
	## moved on before this was ever reached — see _next_turn()'s own
	## defensive clear) never fires in the wrong context. `return` here
	## skips the rest of this call entirely — the queued handler ends by
	## calling _prompt_player_turn() itself for its own real rebuild, so
	## nothing here needs to also build a menu this pass.
	if _pending_decline_action.is_valid():
		var action := _pending_decline_action
		var queued_for: Character = _pending_decline_action_player
		_pending_decline_action = Callable()
		_pending_decline_action_player = null
		if queued_for == player:
			action.call()
			return

	_render_turn_action_menu()

## Per the user's own correction ("again do not hidden all the other
## actions buttons, just leave them grayed out"): the actual menu-
## building body used to live directly inside _prompt_player_turn()
## itself — extracted here, unchanged, so the exact same menu (Attack/
## Charge/Ranged/Magic/Prayers/Skills, now all shown-and-disabled rather
## than omitted once action_used_this_turn is true — see each button's
## own `action_used_this_turn` handling below, ACTION_USED_TOOLTIP) can
## also be reused for the live Fortune/Dark Deal prompt preview (see
## _render_fortune_prompt_turn_preview(), which now just calls this
## directly) instead of that preview needing its own separate, curated,
## drifting-out-of-sync copy of the same buttons. Safe to call from
## either context: every button here that actually consumes the Action
## is already double-gated on action_used_this_turn (both the `.disabled`
## set below AND, as a backstop, a matching check at the top of the real
## handler itself — see e.g. _on_player_attack, _on_sprint), and the
## still-free-to-use buttons (Move/End Turn/weapon switches/Disengage/
## the talent toggles/Act Again) are wired conditionally on
## awaiting_fortune_choice — see each one's own `.pressed.connect(...)`
## line — to either their real handler (normal turn) or
## _decline_fortune_prompt_and_run.bind(<real handler>) (a live Fortune/
## Dark Deal prompt is open right now, so a click must decline it first).
func _render_turn_action_menu() -> void:
	## Follow-up real bug fix, per the user's own report + screenshot:
	## "another [case of the] player controlling monster bug" — the
	## Attacker/Defender boxes correctly showed a MONSTER as the current
	## turn holder (encounter.get_current_combatant()), yet this full
	## own-turn menu (Movement/Attack-Defence/Magic columns, Act Again,
	## Effort, Advantage Actions) was still fully live underneath it,
	## built for whichever ally last had it — every legitimate caller of
	## this function (_prompt_player_turn's own two call sites, plus
	## _render_fortune_prompt_turn_preview's reuse of it) only ever fires
	## while it's genuinely `player`'s own Turn; the previous two fixes to
	## this exact bug class (see _next_turn()'s own two comments above)
	## only ever cleared this menu on a NORMAL Turn handoff, so any other
	## path that leaves `player` stale relative to the encounter's own
	## turn tracker (an ally reassigned to `player` for a defensive
	## Fortune-spend preview during a monster's OWN attack, say, if that
	## preview is ever reached with the wrong own_turn flag) still slipped
	## a full interactive menu onto screen during someone else's Turn.
	## Rather than chase down every individual call path that could ever
	## get this wrong, this is the one true choke point every one of them
	## already funnels through — so this guard makes showing this menu
	## during anyone else's Turn structurally impossible, not just
	## unlikely: if `player` doesn't match the encounter's own current
	## combatant, there is nothing left to build here.
	if encounter != null and encounter.get_current_combatant() != player:
		_clear(target_container)
		_clear(side_actions_container)
		if grid_view != null:
			grid_view.set_charge_ready(Vector2i(-1, -1))
		return
	_clear(target_container)
	_clear(side_actions_container)
	## Per the request ("if the active character is within charge range
	## of the selected target draw a Red arrow line from that character
	## to the target"): cleared up front on every call so an incapacitated/
	## Broken turn (both of which return below before the real can_charge
	## check further down) or a turn with no valid target never leaves a
	## stale arrow on screen from whoever acted last — the normal flow
	## overwrites this with the real, freshly-computed value once it
	## reaches can_charge below.
	if grid_view != null:
		grid_view.set_charge_ready(Vector2i(-1, -1))

	## Master Condition List (p.167-169): Stunned ("incapable of taking
	## an Action"), Surprised ("can take no Action or Move"), and
	## Unconscious ("can do nothing on your turn") all genuinely block
	## a normal turn — not just the Test-penalty half already applied
	## elsewhere, but a real inability to act at all. Auto-passes the
	## turn with a clear, distinct notice for each, rather than
	## rendering the normal action menu.
	if player.conditions.has("Unconscious") or player.conditions.has("Stunned") or player.conditions.has("Surprised"):
		_prompt_incapacitated_turn()
		return

	## Broken (p.168): "You must use your Move and Action to flee from
	## combat and attempt to hide... you cannot use your Action for
	## anything else." A real, previously-missing forced turn, per the
	## request ("IF players gain Broken... restrict their actions and
	## movement appropriately") — Broken used to only apply a Test
	## penalty and gate end-of-Round recovery, never actually stopping a
	## Broken character from fighting completely normally. The book
	## gives no real choice here ("must"), so this is a narrated,
	## auto-resolved pass — same shape as _prompt_incapacitated_turn()
	## just above — rather than a new interactive move-picking flow; see
	## _prompt_broken_turn() for the movement itself.
	if player.conditions.has("Broken"):
		_prompt_broken_turn()
		return

	## Exploration mode (see the big section above _exit_tree()): NOT a
	## separate menu — while no monsters are part of the fight yet, this
	## SAME function just falls all the way through with `target` stuck
	## at null (every Attack/Charge/Magic section below is gated on
	## `target != null`, so they naturally render nothing), and the
	## "Movement / Free Actions" column below gets two extra entries
	## (Open Door, Exit) alongside the exact same Move/Sprint/End Turn
	## buttons — and their hotkey/WASD-focus wiring — a normal combat
	## turn already uses (see that column's own "Exploration mode"
	## comment further down). The moment monsters spawn in
	## (_spawn_monsters_during_exploration()) _exploration_mode flips to
	## false and this whole menu renders completely normally again.

	var pool := encounter.advantage_pool
	## Per the request ("allow targeting of allies, but don't allow
	## offensive actions against them"): every action built below this
	## point that reads `target` — Attack, Charge, Distract, Intimidate,
	## Struggle Free of Entangled, Batter/Trick — is inherently hostile;
	## none of them make sense directed at your own side. Selecting an
	## ally on the map (see _on_grid_square_clicked/_select_target) is
	## allowed for display purposes (the Defender box, the map's own
	## focus ring), but never feeds this local `target` used to build
	## the actual hostile-action buttons — an ally selection simply
	## reads as "no target" down here, same as selected_target == null
	## always has.
	##
	## Real bug fix ("player should not be able to target monster they
	## can not see yet with melee (including charge)..."): _select_target()
	## and _ensure_valid_target() already refuse to ever put an invisible
	## adversary into selected_target in the first place (see their own
	## comments), but this extra _can_see_target() check is kept here too
	## as a belt-and-suspenders guard against a hidden monster becoming
	## `target` via any other/future direct selected_target assignment —
	## cheap, and this is the one choke point every hostile melee/charge
	## button below is actually built from.
	var target: Character = selected_target if (selected_target != null and selected_target.allegiance != "ally" and _can_see_target(selected_target)) else null

	if pending_effort_bonus > 0:
		var note := Label.new()
		note.text = "Additional Effort ready: +%d%% to your next Test." % pending_effort_bonus
		note.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
		target_container.add_child(note)

	## Per the follow-up request: the single packed row above (still
	## described in the older comment this replaces) turned into "the
	## long list with wrap" once enough talents/spells were in play —
	## not ideal. Split into 3 similarly-sized columns instead, each
	## with its own narrower HFlowContainer so wrapping happens sooner
	## per column but the 3 columns render their wrapped rows in
	## parallel, keeping the whole menu shorter overall:
	##   Column 1 — Movement / Intimidate / Effort / Advantage Actions
	##   Column 2 — Attack / Defence (all actions)
	##   Column 3 — Magic / Blessings & Miracles (Prayers)
	## `action_row` is kept as a mutable alias reassigned to col1/col2/
	## col3 right before each category below, so the category-building
	## code itself (each block's own `action_row.add_child(...)` calls)
	## didn't need to be rewritten — only which column it targets.
	var columns_row := HBoxContainer.new()
	columns_row.add_theme_constant_override("separation", 10)
	var col1 := _make_action_column("Movement / Free Actions")
	## Per the request ("While out of combat (explore mode), lets replace
	## the Attack / Defence section with a one called Actions, and move
	## the Dungeon action buttons there"): out of combat there's nothing
	## to attack or defend against yet, so the whole column is repurposed
	## for the dungeon's own exploration-only actions (Open Door/Jump the
	## Chasm/Exit the Sewers — see the "Exploration mode" block below,
	## which now builds into col2 instead of col1) rather than sitting
	## there half-empty with just Defensive Stance/Disengage. The moment
	## _exploration_mode flips false (monsters encountered), this column
	## reverts to its normal "Attack / Defence" combat content.
	var col2 := _make_action_column("Actions" if _exploration_mode else "Attack / Defence")
	var col3 := _make_action_column("Magic / Prayers")
	columns_row.add_child(col1.get_parent())
	columns_row.add_child(VSeparator.new())
	columns_row.add_child(col2.get_parent())
	columns_row.add_child(VSeparator.new())
	columns_row.add_child(col3.get_parent())
	var action_row: HFlowContainer = col1

	## Hoisted up from where it used to first appear (right before the
	## Attack section further down) so the Enter-hotkey default block,
	## just below, can already know whether the player's own equipped
	## weapon is melee before deciding what Enter should do.
	var weapon: WeaponDefinition = _weapon_for(player)
	## A ranged weapon never triggers this (no adjacency requirement at
	## all) — see _can_reach_melee_range_of_any_living_enemy()'s own
	## comment for why this is a real Move-based reachability check, not
	## just "is there a selected target in range."
	var melee_stuck_out_of_range: bool = battle_grid != null and not weapon.is_ranged and not _can_reach_melee_range_of_any_living_enemy()
	## Per the follow-up request ("when a character has used his move and
	## is not targeting a enemy monster, make End Turn the WASD focus"):
	## melee_stuck_out_of_range just above only ever covers a MELEE
	## weapon stuck out of reach — `not weapon.is_ranged` short-circuits
	## it to false unconditionally for a ranged character, so End Turn
	## never became the Enter/WASD default for one even with genuinely
	## nothing to shoot at (e.g. a Hunter in exploration mode before any
	## monster's been encountered — exactly the reported screenshot).
	## _targets_in_weapon_range() already returns an empty Array whenever
	## encounter.get_living("adversary") itself is empty (no monsters at
	## all yet) or nothing living is within this weapon's own range
	## bands, so this is the ranged-weapon mirror of melee_stuck_out_of_
	## range's own "nothing this character could actually act against
	## right now" check.
	var no_target_to_act_against: bool = melee_stuck_out_of_range or (weapon.is_ranged and _targets_in_weapon_range(weapon).is_empty())

	## —- Movement: a single Move (no separate Walk/Run — per the
	## request, neither ever cost the Action here, only the distance
	## differed, so Move now covers the full old Run range). Clicking it
	## enters move mode (arrow preview + click-to-commit, see
	## _enter_move_mode); movement_remaining can be spent across several
	## clicks in the same turn rather than one all-or-nothing use. Once
	## it's fully spent, Sprint appears alongside it — spending the
	## Action itself (core rulebook: an Average (+20) Athletics Test)
	## for Run distance + SL more squares this turn, see _on_sprint.
	if battle_grid != null:
		var move_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		move_btn.text = "Cancel Move" if move_mode_active else "Move (%d sq)" % movement_remaining
		move_btn.disabled = movement_remaining <= 0 and not move_mode_active
		if move_btn.disabled:
			move_btn.tooltip_text = "No movement remaining this turn."
		if awaiting_fortune_choice:
			move_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(Callable(self, "_on_move_button_pressed")))
		else:
			move_btn.pressed.connect(_on_move_button_pressed)
		action_row.add_child(move_btn)
		if movement_remaining <= 0 and not sprint_used_this_turn and not move_mode_active:
			var sprint_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			sprint_btn.text = "Sprint (Action)"
			sprint_btn.disabled = action_used_this_turn
			if action_used_this_turn:
				sprint_btn.tooltip_text = ACTION_USED_TOOLTIP
			sprint_btn.pressed.connect(_on_sprint)
			action_row.add_child(sprint_btn)
		## Per the request: Move and Action can be used in any order, so
		## nothing automatically ends the Turn until BOTH are spent (see
		## _finish_player_action) — this is the explicit escape hatch for
		## every other case: still has Move and/or the Action left, but the
		## player is done for this Turn anyway.
		if not move_mode_active:
			var end_turn_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			## Per the request: Enter now ends the Turn once the Action's
			## already spent — the hotkey hint only shows up then. Also
			## applies once the player's own melee weapon genuinely can't
			## reach anyone this turn — Attack would just refuse with "too
			## far away" if Enter defaulted to it.
			end_turn_btn.text = "End Turn  [Enter]" if (action_used_this_turn or no_target_to_act_against) else "End Turn"
			if no_target_to_act_against and not action_used_this_turn and _exploration_mode:
				pass   ## no monsters at all yet — no_target_to_act_against is trivially true and not worth a tooltip explaining "why"
			elif melee_stuck_out_of_range and not action_used_this_turn:
				end_turn_btn.tooltip_text = "No living enemy is within reach of your %s this turn, even with your remaining Movement." % weapon.weapon_name
			elif no_target_to_act_against and not action_used_this_turn:
				end_turn_btn.tooltip_text = "No living enemy is within range of your %s." % weapon.weapon_name
			if awaiting_fortune_choice:
				end_turn_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(Callable(self, "_on_end_turn_pressed")))
			else:
				end_turn_btn.pressed.connect(_on_end_turn_pressed)
			action_row.add_child(end_turn_btn)
			if action_used_this_turn or no_target_to_act_against:
				_active_primary_hotkey_button = end_turn_btn

	## Free-action weapon switching (per the request): swapping your
	## main-hand and/or off-hand weapon for a different one already
	## sitting in inventory costs neither the Action nor Advantage —
	## same gating as the Dual Wield/Strike to Stun toggles (only while
	## still choosing this turn's action, not mid-Defence). Each hand is
	## independently capped at one switch per Turn
	## (main_weapon_switched_this_turn / offhand_weapon_switched_this_turn,
	## reset in the fresh-turn block above) per the request's "used once
	## per turn" — and only offered when there's actually a different
	## weapon on hand to switch to.
	## Per the follow-up request ("move Weapon switch to the line below
	## the Movement buttons"): given its own row rather than flowing
	## straight on from the Movement buttons above — same "always a
	## fresh line regardless of available width" pattern the Skills row
	## below already uses (a new HFlowContainer added as its own child
	## of col1's wrapper VBox, not more content flowed into the
	## Movement row's own flow container).
	## Per the user's own correction: this used to also require
	## awaiting_player_target — true for a normal turn, but false while a
	## Fortune/Dark Deal prompt is still open (see _offer_fortune_spend),
	## which is exactly why weapon switching used to disappear during
	## that window instead of staying usable. pending_defense.is_empty()
	## is the actually load-bearing safety check (don't let a Free Action
	## interrupt a reactive Defence roll) — kept.
	if pending_defense.is_empty():
		var switchable_main := _switchable_weapons(player, player.equipped_weapon)
		var switchable_off := _switchable_weapons(player, player.equipped_offhand)
		var show_main_switch := not switchable_main.is_empty() and not main_weapon_switched_this_turn
		var show_off_switch := not switchable_off.is_empty() and not offhand_weapon_switched_this_turn and not player.main_weapon_is_two_handed()
		if show_main_switch or show_off_switch:
			var weapon_switch_row := HFlowContainer.new()
			weapon_switch_row.add_theme_constant_override("separation", 6)
			if show_main_switch:
				var switch_main_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
				switch_main_btn.text = "Switch Main Weapon"
				var open_main_switch := func(): _open_weapon_switch_menu(switchable_main, switch_main_btn, Callable(self, "_apply_main_weapon_switch"))
				if awaiting_fortune_choice:
					switch_main_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(open_main_switch))
				else:
					switch_main_btn.pressed.connect(open_main_switch)
				weapon_switch_row.add_child(switch_main_btn)
			if show_off_switch:
				var switch_off_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
				switch_off_btn.text = "Switch Off-hand"
				var open_off_switch := func(): _open_weapon_switch_menu(switchable_off, switch_off_btn, Callable(self, "_apply_offhand_weapon_switch"))
				if awaiting_fortune_choice:
					switch_off_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(open_off_switch))
				else:
					switch_off_btn.pressed.connect(open_off_switch)
				weapon_switch_row.add_child(switch_off_btn)
			action_row.get_parent().add_child(weapon_switch_row)

		## Ammunition (p.294): per the "allow switching ammo during
		## combat if available" request — a Free Action, same gating and
		## once-per-Turn-per-weapon cap pattern as the weapon switch
		## block just above (ammo_switched_this_turn mirrors main_weapon_
		## switched_this_turn/offhand_weapon_switched_this_turn, reset in
		## the same fresh-turn block). Offered for the main-hand and/or
		## off-hand weapon whenever it actually needs ammo AND this
		## character has 2+ different acceptable ammo types on hand right
		## now — a single type on hand has nothing to switch TO, so it's
		## silently skipped rather than shown disabled.
		var ammo_switch_weapons: Array[WeaponDefinition] = []
		var main_weapon_for_ammo: WeaponDefinition = GameData.weapon_db.find_by_name(player.equipped_weapon)
		if main_weapon_for_ammo != null:
			ammo_switch_weapons.append(main_weapon_for_ammo)
		if not player.main_weapon_is_two_handed():
			var off_weapon_for_ammo: WeaponDefinition = player.get_offhand_weapon()
			if off_weapon_for_ammo != null and off_weapon_for_ammo != main_weapon_for_ammo:
				ammo_switch_weapons.append(off_weapon_for_ammo)
		## Computed as plain data first (weapon + its owned ammo names)
		## rather than building UI Nodes eagerly, so a Turn with nothing
		## switchable never allocates an orphaned HFlowContainer.
		var ammo_switch_candidates: Array = []
		for aw in ammo_switch_weapons:
			if not AmmoLookup.needs_ammo(aw) or ammo_switched_this_turn.get(aw.weapon_name, false):
				continue
			var owned_ammo_names: Array[String] = []
			for ammo_name in AmmoLookup.required_ammo_names(aw):
				if player.inventory.has(ammo_name):
					owned_ammo_names.append(ammo_name)
			if owned_ammo_names.size() < 2:
				continue
			ammo_switch_candidates.append({"weapon": aw, "ammo_names": owned_ammo_names})
		if not ammo_switch_candidates.is_empty():
			var ammo_switch_row := HFlowContainer.new()
			ammo_switch_row.add_theme_constant_override("separation", 6)
			for candidate in ammo_switch_candidates:
				var bound_weapon: WeaponDefinition = candidate["weapon"]
				var owned_ammo_names: Array[String] = candidate["ammo_names"]
				var switch_ammo_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
				switch_ammo_btn.text = "Switch Ammo (%s)" % bound_weapon.weapon_name
				var open_ammo_switch := func(): _open_weapon_switch_menu(owned_ammo_names, switch_ammo_btn, func(ammo_name: String): _apply_ammo_switch(bound_weapon, ammo_name))
				if awaiting_fortune_choice:
					switch_ammo_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(open_ammo_switch))
				else:
					switch_ammo_btn.pressed.connect(open_ammo_switch)
				ammo_switch_row.add_child(switch_ammo_btn)
			action_row.get_parent().add_child(ammo_switch_row)

		## Light toggle (per the request: "add a way to turn off/on
		## lantern/lamp/candles if they are being held") — a Free Action,
		## same gating as Dual Wield/Strike to Stun/weapon switching above,
		## available only when the current player actually has a light
		## item equipped in either hand (get_equipped_light_item()'s own
		## "held" check — same one Character.has_active_light_source()
		## relies on). No once-per-turn cap: flicking a lantern on/off
		## isn't a limited resource the way a weapon switch is, it's just
		## state, same as the other toggles on this row.
		var held_light: ItemDefinition = player.get_equipped_light_item()
		if held_light != null:
			var light_row := HFlowContainer.new()
			light_row.add_theme_constant_override("separation", 6)
			var light_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			## Labelled by what the NEXT press actually does (mirrors the
			## real off -> on -> low -> off cycle in _on_toggle_light_
			## pressed() below), not just the current mode — an "on" light
			## with a dedicated low-flame radius dims on the next press,
			## it doesn't extinguish, so it must not say "Extinguish" here.
			match player.light_mode:
				"off":
					light_btn.text = "Light %s" % held_light.item_name
				"on":
					if held_light.light_radius_tiles_low > 0:
						light_btn.text = "Turn Down %s" % held_light.item_name
					else:
						light_btn.text = "Extinguish %s" % held_light.item_name
				_:   ## "low"
					light_btn.text = "Extinguish %s" % held_light.item_name
			if awaiting_fortune_choice:
				light_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(Callable(self, "_on_toggle_light_pressed")))
			else:
				light_btn.pressed.connect(_on_toggle_light_pressed)
			light_row.add_child(light_btn)
			action_row.get_parent().add_child(light_row)

		## Prone recovery (p.169/p.171), moved here per the request ("Stand
		## Up and Spend Resolve should be presented in the Movement / Free
		## Actions section") — this column renders in both combat and
		## exploration submodes, unlike the "Attack / Defence" column these
		## two used to live in (skipped entirely during exploration), which
		## used to leave a character knocked Prone by fall damage outside
		## combat with no way to stand back up until a fight started.
		## Stand Up: "You lose the Prone Condition when you stand up" — a
		## free choice (no Test), spending the Move rather than the Action,
		## so it's only offered while Move is actually still available and
		## the character isn't at 0 Wounds (RAW: "if you have 0 Wounds
		## remaining, you can only crawl").
		## Spend Resolve: offered whenever the player has a Resolve point
		## AND something worth spending it on (an active Critical Wound
		## penalty to ignore, or any Condition to remove) — only 2 of the
		## rulebook's 3 Resolve-spend options are offered here:
		## "become immune to Psychology until the end of the next round" is
		## deliberately NOT implemented — Fear/Terror/Broken/Stupid checks
		## are scattered across this entire file's monster-turn and
		## player-move code (see PsychologyTest's own header comment), and
		## a blanket "ignore all of it" flag would need to be threaded
		## through every one of those scattered checks individually to be
		## correct; that's a genuinely pervasive change, not a contained
		## one, so it's flagged here rather than guessed at.
		var prone_recovery_row := HFlowContainer.new()
		prone_recovery_row.add_theme_constant_override("separation", 6)
		var _has_prone_recovery_content := false
		if player.conditions.has("Prone") and movement_remaining > 0 and player.wounds_current > 0:
			var stand_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			stand_btn.text = "Stand Up"
			stand_btn.pressed.connect(_on_stand_up)
			prone_recovery_row.add_child(stand_btn)
			_has_prone_recovery_content = true
		var resolve_has_target := not player.critical_wound_penalties.is_empty() or not player.conditions.is_empty()
		if player.resolve > 0 and resolve_has_target:
			var resolve_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			resolve_btn.text = "Spend Resolve (%d)" % player.resolve
			resolve_btn.disabled = action_used_this_turn
			if action_used_this_turn:
				resolve_btn.tooltip_text = ACTION_USED_TOOLTIP
			resolve_btn.pressed.connect(_on_spend_resolve)
			prone_recovery_row.add_child(resolve_btn)
			_has_prone_recovery_content = true
		if _has_prone_recovery_content:
			action_row.get_parent().add_child(prone_recovery_row)

	## Exploration mode (see the big section above _exit_tree()): used to
	## be folded into the "Movement / Free Actions" column alongside
	## Move/Sprint/End Turn (per the user's own earlier correction: "can
	## we just reuse the normal move / free button section... rather
	## then use this new Explore menu buttons"). Per the follow-up
	## request ("replace the Attack / Defence section with one called
	## Actions, and move the Dungeon action buttons there"), these three
	## now build into col2 instead — the column just above already has
	## its header switched to "Actions" for exactly this case, and with
	## no target/monsters to fight, that column would otherwise sit
	## empty (Attack/Charge/Magic are all gated on `target != null`,
	## which naturally stays null the whole time there's nothing to
	## fight) — this is what fills it during exploration instead.
	if _exploration_mode and not move_mode_active:
		var explore_pos: Vector2i = battle_positions.get(player, Vector2i(-1, -1))
		var explore_door_pos := _adjacent_closed_door(explore_pos)
		var explore_row := HFlowContainer.new()
		explore_row.add_theme_constant_override("separation", 6)
		var door_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		door_btn.text = "Open Door"
		door_btn.disabled = action_used_this_turn or explore_door_pos == Vector2i(-1, -1)
		if action_used_this_turn:
			door_btn.tooltip_text = ACTION_USED_TOOLTIP
		elif explore_door_pos == Vector2i(-1, -1):
			door_btn.tooltip_text = "No closed door within reach."
		door_btn.pressed.connect(_on_open_door_pressed)
		explore_row.add_child(door_btn)
		var explore_jump: Dictionary = _adjacent_chasm_jump(explore_pos)
		var jump_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		jump_btn.text = "Jump the Chasm"
		jump_btn.disabled = action_used_this_turn or explore_jump.is_empty()
		if action_used_this_turn:
			jump_btn.tooltip_text = ACTION_USED_TOOLTIP
		elif explore_jump.is_empty():
			jump_btn.tooltip_text = "No chasm within reach."
		jump_btn.pressed.connect(_on_jump_chasm_pressed)
		explore_row.add_child(jump_btn)
		if explore_pos == dungeon_state.get("entrance_pos"):
			## Real bug fix ("going back up stairs... should not allow
			## the player to jump from deeper to outside the dungeon, it
			## should always lead to the next level up/down/out"): a
			## floor's own entrance_pos is only the TRUE way out to the
			## world map on the ground floor (dungeon_floor == 0) — on
			## any floor below that, it's really just where that floor's
			## own up-stairway lands the party (see _take_stairs_up()'s
			## own comment), so it must lead to the next floor UP, not
			## straight outside.
			if int(dungeon_state.get("dungeon_floor", 0)) > 0:
				var up_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
				var floor_above: int = int(dungeon_state.get("dungeon_floor", 0)) - 1
				up_btn.text = "Climb the Stairs Up to %s (Free)" % ("the Ground Floor" if floor_above == 0 else ("Floor %d" % floor_above))
				up_btn.pressed.connect(_on_take_stairs_up_pressed)
				explore_row.add_child(up_btn)
			else:
				var exit_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
				## Generic per-theme label — was hardcoded "Exit the Sewers"
				## back when the Sewers were the only dungeon theme; the
				## Goblin Fort Dungeon (and any future theme) needs its own
				## wording instead of a leftover sewer-specific string.
				## theme_name already reads as a full proper noun ("The
				## Sunken Warrens", "The Goblin Fort Dungeon"), so "Leave"
				## reads naturally without needing its own article.
				exit_btn.text = "Leave %s" % (dungeon_theme.theme_name if dungeon_theme != null and dungeon_theme.theme_name != "" else "the Dungeon")
				exit_btn.pressed.connect(_do_exit_dungeon)
				explore_row.add_child(exit_btn)
		## The Goblin Fort chest, at the far end of its own Dungeon Map —
		## Open/Break/Perception/Pick Lock, same as the old overworld
		## radial menu offered, just as explore-menu buttons here. Gated
		## to this one theme since no other dungeon has a chest yet. Per
		## the request ("chest adjacency... Search/Open Chest as Free
		## Actions"): uses _is_near_chest() (the chest tile or any of its
		## 8 neighbours) instead of requiring the exact tile, and Search/
		## Open no longer cost the character's Action (Break/Pick Lock
		## still do — see _on_break_chest_pressed()/_on_pick_lock_chest_
		## pressed() for that Action-cost handling).
		##
		## REAL BUG FIX: this whole block (through the stairs button at
		## the end) used to sit one indent level too deep, nested INSIDE
		## the "if explore_pos == dungeon_state.get('entrance_pos')"
		## check just above instead of being its own sibling — so the
		## Goblin Fort chest options, the Furniture/Treasure Chest search
		## buttons, and the stairs-down button only ever appeared while
		## standing on the exact entrance tile, which is essentially never
		## once the party has moved anywhere. Dedented to fix.
		if dungeon_theme != null and dungeon_theme.theme_id == "goblin_fort" and _is_near_chest(explore_pos):
			var chest_locked: bool = dungeon_state.get("chest_locked", true)
			var chest_looted: bool = dungeon_state.get("chest_looted", false)
			var can_pick_lock: bool = GameState.party.any(func(m): return int(m.skill_advances.get("Pick Lock", 0)) > 0)
			var perception_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			perception_btn.text = "Search the Chest (Free)"
			perception_btn.disabled = chest_looted
			perception_btn.pressed.connect(_on_perception_chest_pressed)
			explore_row.add_child(perception_btn)
			if not chest_locked:
				var open_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
				open_btn.text = "Open Chest (Free)"
				open_btn.pressed.connect(_on_open_chest_pressed)
				explore_row.add_child(open_btn)
			else:
				var break_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
				break_btn.text = "Break Chest"
				break_btn.disabled = action_used_this_turn
				if action_used_this_turn:
					break_btn.tooltip_text = ACTION_USED_TOOLTIP
				break_btn.pressed.connect(_on_break_chest_pressed)
				explore_row.add_child(break_btn)
				if can_pick_lock:
					var pick_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
					pick_btn.text = "Pick Lock"
					pick_btn.disabled = action_used_this_turn
					if action_used_this_turn:
						pick_btn.tooltip_text = ACTION_USED_TOOLTIP
					pick_btn.pressed.connect(_on_pick_lock_chest_pressed)
					explore_row.add_child(pick_btn)
		## Room Furniture / the procedural Quest room's own Treasure
		## Chest ("Sewer/Cave Dungeons update") — both Free Actions,
		## same as the Goblin Fort chest's own Search button above,
		## gated the same "adjacency, not exact-tile" way. Button stays
		## visible-but-disabled once searched (rather than vanishing)
		## so the player can see at a glance they already checked it,
		## matching the Goblin Fort chest's own Search button.
		var furniture_room: Dictionary = _adjacent_furniture(explore_pos)
		if not furniture_room.is_empty():
			var furniture_label: String = FURNITURE_LABELS.get(furniture_room.get("furniture_type", "none"), "Furniture")
			var furniture_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			furniture_btn.text = "Search the %s (Free)" % furniture_label
			furniture_btn.disabled = furniture_room.get("furniture_looted", false)
			furniture_btn.pressed.connect(_on_search_furniture_pressed)
			explore_row.add_child(furniture_btn)
		var quest_chest_room: Dictionary = _adjacent_quest_chest(explore_pos)
		if not quest_chest_room.is_empty():
			var quest_chest_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			quest_chest_btn.text = "Search the Treasure Chest (Free)"
			quest_chest_btn.disabled = quest_chest_room.get("chest_looted", false)
			quest_chest_btn.pressed.connect(_on_search_quest_chest_pressed)
			explore_row.add_child(quest_chest_btn)
		## "Sewer/Cave Dungeons update 2" — the Quest room's own stairs
		## down to the next floor, same adjacency-gated Free Action
		## convention as the furniture/chest buttons just above. Simply
		## never appears once the party reaches the dungeon's deepest
		## floor (_adjacent_stairs() returns {} there — see
		## DungeonGenerator.MAX_DUNGEON_FLOOR) — no extra "already at max
		## depth" gating needed here.
		var stairs_room: Dictionary = _adjacent_stairs(explore_pos)
		if not stairs_room.is_empty():
			var next_floor: int = int(dungeon_state.get("dungeon_floor", 0)) + 1
			var stairs_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			stairs_btn.text = "Take the Stairs Down to Floor %d (Free)" % next_floor
			stairs_btn.pressed.connect(_on_take_stairs_pressed)
			explore_row.add_child(stairs_btn)
		col2.get_parent().add_child(explore_row)

	## Free-target AoE spell/prayer (Blast, Twin-tailed Comet) is waiting
	## on a battle-map click to place its center — same "Cancel Move"
	## escape hatch as movement, so the player isn't stuck once they've
	## opened targeting mode.
	if aoe_target_mode_active:
		var cancel_aoe_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		cancel_aoe_btn.text = "Cancel Targeting  [Enter]"
		cancel_aoe_btn.pressed.connect(func():
			_exit_aoe_target_mode()
			_prompt_player_turn(false)
		)
		action_row.add_child(cancel_aoe_btn)
		_active_primary_hotkey_button = cancel_aoe_btn

	## Ranged Attack / Magic-Prayer targeting is waiting on a click on one
	## of the arrowed targets (see _enter_ranged_target_mode) — same
	## escape hatch as AoE targeting above.
	if ranged_target_mode_active:
		var cancel_ranged_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		cancel_ranged_btn.text = "Cancel Targeting  [Enter]"
		cancel_ranged_btn.pressed.connect(func():
			_exit_ranged_target_mode()
			_prompt_player_turn(false)
		)
		action_row.add_child(cancel_ranged_btn)
		_active_primary_hotkey_button = cancel_ranged_btn

	## --- Combat (top tier — used almost every turn) ------------------
	## Per the request ("let Melee and Defense actions have their own
	## line"): the primary weapon's Attack/Charge stays in col2's own
	## flow container (this line), while Defense gets its own separate
	## HFlowContainer below — same pattern as the Skills row further
	## down — so they always start on fresh lines instead of wrapping
	## together based on available width.
	## Per the request ("replace the Attack / Defence section with one
	## called Actions... while out of combat"): the entire Attack/
	## Charge/Defensive-Stance/Disengage block below is real
	## combat content -- during exploration, with no monsters and no
	## target, it would otherwise just sit there mostly empty (a stray
	## Defensive Stance/Disengage pair) underneath a column now labeled
	## "Actions" and showing the dungeon buttons instead -- skipped
	## outright while _exploration_mode is true, and runs completely
	## unchanged the moment it flips false (monsters encountered).
	if not _exploration_mode:
		action_row = col2
		## `weapon` itself is now hoisted above — still the same
		## weapons[player] lookup, just computed once, earlier.
		## Per the follow-up request ("remove the cross out text elements and
		## similar ones... these descriptions are not needed"): the small
		## gold "Sword (Melee):"-style section-header label that used to sit
		## above the Attack button (and, for a ranged weapon needing ammo,
		## its own ammo-count readout) is gone — the weapon's name and ammo
		## are still visible, folded into the Attack button's own text/
		## tooltip below instead.
		## Per the follow-up request ("make sure that character can always
		## charge if they have enough movement left... not only in the
		## opening turn"): no longer gated on melee_has_begun — Charge is
		## offered any turn the character actually has enough Move left to
		## cover their own current Movement value (see _target_in_charge_range,
		## which now checks movement_remaining directly), not just during
		## the Opening Exchange.
		var can_charge := target != null and not weapon.is_ranged and _target_in_charge_range(target)
		## Per the request ("if the active character is within charge range
		## of the selected target draw a Red arrow line from that character
		## to the target"): pushed down to the battle map the moment
		## can_charge is known, gated the same way the Charge button itself
		## is below (target != null and not action_used_this_turn) so the
		## arrow disappears exactly when that button would too — e.g. once
		## the Action's already spent this Turn.
		if grid_view != null:
			if can_charge and not action_used_this_turn and battle_positions.has(target):
				grid_view.set_charge_ready(battle_positions[target])
			else:
				grid_view.set_charge_ready(Vector2i(-1, -1))
		## Ammunition (p.294): whether the currently-equipped weapon can
		## actually fire right now — melee/Throwing are always true, a
		## Sling gets the free-rock Round-1 exception, everything else
		## needs real ammo in inventory. Gates the Attack button itself
		## below, and whether "Pick Up Rocks" is offered instead/alongside.
		var weapon_has_ammo := player.has_ammo_for(weapon, encounter.round_number)
		## Per the request: a ranged Attack no longer fires straight at
		## whatever selected_target happens to be — clicking Attack instead
		## opens targeting mode (arrows to every in-range enemy; see
		## _enter_ranged_target_mode), and the roll only happens once one of
		## them is actually clicked. Melee is untouched — adjacency already
		## gates it, and the request only asked for ranged/magic.
		var ranged_attack_targets: Array = _targets_in_weapon_range(weapon) if weapon.is_ranged else []
		var ranged_no_targets: bool = weapon.is_ranged and ranged_attack_targets.is_empty()
		## Per the request ("do not hide all the other action buttons, just
		## leave them grayed out"): the whole Attack/Off-hand/Charge block
		## used to be omitted entirely once action_used_this_turn was true —
		## an inconsistency against the rest of this menu (Cast/Pray/
		## Defensive Stance/Channel/Effort/Advantage Actions all already
		## stay visible and disable via ACTION_USED_TOOLTIP instead, per
		## that section's own comment: "matching how every other Action-
		## consuming option elsewhere in this menu already behaves"). Now
		## shown whenever there's a selected target, same as before, just no
		## longer additionally gated on the Action still being available —
		## each individual button inside disables itself on
		## action_used_this_turn instead, same pattern as everywhere else.
		if target != null:
			var attack_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			## Per the request ("replace the Attack button text with '[Weapon
			## Name] - [The target Roll Number including any modifiers for
			## the current target]'"): a real preview of what this attack
			## actually needs to roll under against `target` right now — see
			## _preview_attack_target_number's own comment for exactly what
			## it does and doesn't include.
			var attack_roll_number := _preview_attack_target_number(weapon, target, false)
			## Per the follow-up request ("IF a two-handed weapon is being
			## wielded just show the main hand button and prefix with 2H:"):
			## a two-handed weapon already leaves no free off-hand at all (no
			## Off: button is offered below in that case — see
			## player.main_weapon_is_two_handed()'s own gate on it), so this
			## main button's own text flags that plainly rather than leaving
			## it looking like any other single-weapon Attack.
			var two_handed_prefix := "2H: " if weapon.is_two_handed else ""
			attack_btn.text = "%s%s - %d" % [two_handed_prefix, weapon.weapon_name, attack_roll_number]
			## Ranged Weapon Groups (p.296): "You cannot attempt a Ranged Test
			## for a weapon you do not have the correct speciality for" —
			## unlike Melee (which always falls back to a Weapon Skill Test),
			## an untrained Ranged Group with no valid cross-training
			## exception (Crossbow/Throwing, Engineering<->Blackpowder — see
			## Character.can_use_ranged_weapon()) is a genuine hard block on
			## the Attack button itself, not just a worse roll.
			var ranged_untrained := weapon.is_ranged and not player.can_use_ranged_weapon(weapon)
			attack_btn.disabled = not weapon_has_ammo or ranged_no_targets or ranged_untrained or action_used_this_turn
			if action_used_this_turn:
				attack_btn.tooltip_text = ACTION_USED_TOOLTIP
			elif ranged_untrained:
				attack_btn.tooltip_text = "You have no Ranged (%s) training, and no Ranged speciality that lets you use this weapon." % weapon.skill_group
			elif ranged_no_targets:
				attack_btn.tooltip_text = "No targets within range for your %s." % weapon.weapon_name
			elif AmmoLookup.needs_ammo(weapon):
				## The ammo count used to live in this weapon's own removed
				## section-header label — kept alive here as a tooltip rather
				## than lost outright now that header's gone. Per the
				## "implement Ammunition fully" request: now also names
				## whichever specific ammo type is actually loaded (see
				## Character.get_active_ammo_item), since different types can
				## carry very different Range/Damage/Qualities now.
				var loaded_ammo: ItemDefinition = player.get_active_ammo_item(weapon, encounter.round_number)
				if loaded_ammo != null:
					attack_btn.tooltip_text = "%d %s remaining (%d ammo total)." % [player.inventory.count(loaded_ammo.item_name), loaded_ammo.item_name, player.get_ammo_count_for(weapon)]
				else:
					attack_btn.tooltip_text = "%d ammo remaining." % player.get_ammo_count_for(weapon)
			## melee_stuck_out_of_range (nothing reachable this turn even
			## spending all remaining Movement) keeps Attack from claiming the
			## Enter hotkey — End Turn already defaulted to it further up.
			if not can_charge and weapon_has_ammo and not ranged_no_targets and not ranged_untrained and not action_used_this_turn and not melee_stuck_out_of_range:
				attack_btn.text += "  [Enter]"
				_active_primary_hotkey_button = attack_btn
			attack_btn.pressed.connect(func() -> void:
				if weapon.is_ranged:
					_enter_ranged_target_mode("attack", {"weapon_override": null, "forced_hit_location": deadeye_shot_location}, _targets_in_weapon_range(weapon))
				else:
					_on_player_attack(target)
			)
			action_row.add_child(attack_btn)

			## Deadeye Shot (p.136): "Instead of reversing the dice to
			## determine which Hit Location is struck with your ranged
			## weapons, you may pick a location" — a small dropdown right
			## next to the Attack button, only shown once the Talent is
			## learned. Left on "(auto)" this shot resolves exactly as
			## normal (reversed dice, or a Careful Strike choice offered
			## afterward); picking a real location here skips the dice
			## entirely for hit-location purposes and is passed straight
			## into _on_player_attack as forced_hit_location.
			if weapon.is_ranged and player.has_talent("Deadeye Shot"):
				var deadeye_picker := OptionButton.new()
				deadeye_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
				var deadeye_options: Array[String] = ["Deadeye Shot: (auto)"]
				for entry in CombatResolver.HIT_LOCATIONS:
					deadeye_options.append(String(entry["location"]))
				for opt in deadeye_options:
					deadeye_picker.add_item(opt)
				var current_idx: int = deadeye_options.find(deadeye_shot_location) if deadeye_shot_location != "" else 0
				deadeye_picker.selected = max(current_idx, 0)
				deadeye_picker.tooltip_text = "Deadeye Shot: pick which Hit Location this shot strikes, instead of the reversed-dice roll."
				deadeye_picker.item_selected.connect(func(idx: int):
					deadeye_shot_location = "" if idx == 0 else deadeye_options[idx]
				)
				action_row.add_child(deadeye_picker)

			## --- Off-hand Attack button (per the request: "add a 2nd Attack
			## button for the Offhand weapon to the combat screen, next to
			## the main hand weapon button... use the same naming format but
			## add the prefix Off:"). Only offered when there's actually a
			## free off-hand to swing — a two-handed main weapon leaves none
			## (same gate the "Switch Off-hand" button above already uses).
			## An empty off-hand defaults to fighting Unarmed (a genuine
			## Brawling weapon, Undamaging quality and all — see
			## _resolve_offhand_weapon) rather than having nothing to offer
			## there, per the request's own "should be the default weapon if
			## nothing is equipped in either hand." A non-weapon item
			## occupying the slot (a Lantern, etc.) can't be swung at all, so
			## its own name is shown instead with the button disabled — per
			## the request's own "if the item is either hand is not a
			## weapon... just show the item name and keep the button
			## disabled." (The MAIN hand's own long-established behavior for
			## the same situation — silently fighting Unarmed rather than
			## disabling — is left untouched here; that predates this
			## feature and has its own regression coverage, see
			## light_source_test.gd.)
			if not player.main_weapon_is_two_handed():
				var off_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
				var offhand_item_name := player.equipped_offhand
				var offhand_is_weapon := offhand_item_name == "" or GameData.weapon_db.find_by_name(offhand_item_name) != null
				if not offhand_is_weapon:
					off_btn.text = "Off: %s" % offhand_item_name
					off_btn.disabled = true
					off_btn.tooltip_text = "%s isn't a weapon — nothing to attack with from that hand." % offhand_item_name
				else:
					var offhand_weapon: WeaponDefinition = _resolve_offhand_weapon(player)
					var offhand_has_ammo := player.has_ammo_for(offhand_weapon, encounter.round_number)
					var offhand_ranged_targets: Array = _targets_in_weapon_range(offhand_weapon) if offhand_weapon.is_ranged else []
					var offhand_ranged_no_targets: bool = offhand_weapon.is_ranged and offhand_ranged_targets.is_empty()
					var offhand_roll_number := _preview_attack_target_number(offhand_weapon, target, false, true)
					off_btn.text = "Off: %s - %d" % [offhand_weapon.weapon_name, offhand_roll_number]
					## Ranged Weapon Groups (p.296) — see the main Attack
					## button's own comment just above; same hard block, same
					## exceptions, applied to whatever's in the off-hand.
					var offhand_ranged_untrained := offhand_weapon.is_ranged and not player.can_use_ranged_weapon(offhand_weapon)
					off_btn.disabled = not offhand_has_ammo or offhand_ranged_no_targets or offhand_ranged_untrained or action_used_this_turn
					if action_used_this_turn:
						off_btn.tooltip_text = ACTION_USED_TOOLTIP
					elif offhand_ranged_untrained:
						off_btn.tooltip_text = "You have no Ranged (%s) training, and no Ranged speciality that lets you use this weapon." % offhand_weapon.skill_group
					elif offhand_ranged_no_targets:
						off_btn.tooltip_text = "No targets within range for your %s." % offhand_weapon.weapon_name
					elif AmmoLookup.needs_ammo(offhand_weapon):
						off_btn.tooltip_text = "%d ammo remaining." % player.get_ammo_count_for(offhand_weapon)
					off_btn.pressed.connect(func() -> void:
						if offhand_weapon.is_ranged:
							_enter_ranged_target_mode("attack", {"weapon_override": offhand_weapon, "is_offhand": true}, offhand_ranged_targets)
						else:
							_on_player_attack(target, offhand_weapon, false, true)
					)
				action_row.add_child(off_btn)

			if can_charge:
				## While Charge is available, it's the more useful default
				## for Enter to trigger — a normal Attack doesn't go away,
				## it's just one click instead of the hotkey.
				var charge_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
				charge_btn.text = "Charge  [Enter]" if not action_used_this_turn else "Charge"
				charge_btn.disabled = action_used_this_turn
				if action_used_this_turn:
					charge_btn.tooltip_text = ACTION_USED_TOOLTIP
				charge_btn.pressed.connect(func() -> void: _on_player_attack(target, null, true))
				action_row.add_child(charge_btn)
				if not action_used_this_turn:
					_active_primary_hotkey_button = charge_btn

		## Rock (p.294's own free-form Sling ammo, per the request): once
		## Round 1's free rock is no longer available and there's nothing in
		## inventory, finding another one costs the Action itself rather
		## than being another free option. Offered regardless of whether a
		## target is currently selected — no reason to require one just to
		## spend the turn scrounging. Not shown at all once real ammo
		## (Lead/Stone Bullet/a Rock already in hand) is on hand, or in
		## Round 1, where Attack itself already works for free.
		if AmmoLookup.is_sling(weapon) and not weapon_has_ammo:
			var pick_up_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			pick_up_btn.text = "Rock"
			pick_up_btn.disabled = action_used_this_turn
			if action_used_this_turn:
				pick_up_btn.tooltip_text = ACTION_USED_TOOLTIP
			pick_up_btn.pressed.connect(_on_pick_up_rocks)
			action_row.add_child(pick_up_btn)

		## Talent-driven attack modifiers — toggles that change how the next
		## Attack resolves, so they sit right with Attack itself. Only shown
		## at all if the player actually has the Talent, to keep this list
		## short for characters without it.
		## Per the follow-up request: only offered while genuinely usable —
		## see _dual_wield_eligible's own comment (a two-handed main weapon,
		## or a non-weapon item like a Lantern in either hand, means there's
		## no real two-weapon combo available right now regardless of the
		## Talent). Showing "Dual Wield: OFF" as if it were one click away
		## when it isn't would be misleading.
		if player.get_talent_rank("Dual Wielder") > 0 and _dual_wield_eligible(player):
			var dual_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			dual_btn.text = "Dual Wield: %s" % ("ON" if dual_wield_active else "OFF")
			if awaiting_fortune_choice:
				dual_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(Callable(self, "_on_toggle_dual_wield")))
			else:
				dual_btn.pressed.connect(_on_toggle_dual_wield)
			action_row.add_child(dual_btn)
		if player.get_talent_rank("Strike to Stun") > 0:
			var stun_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			stun_btn.text = "Strike to Stun: %s" % ("ON" if strike_to_stun_active else "OFF")
			if awaiting_fortune_choice:
				stun_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(Callable(self, "_on_toggle_strike_to_stun")))
			else:
				stun_btn.pressed.connect(_on_toggle_strike_to_stun)
			action_row.add_child(stun_btn)
		## Frightening (p.190): a Free Action ON/OFF toggle, same convention
		## as Dual Wield/Strike to Stun just above — per the request, always
		## starts OFF at the beginning of each fight rather than being
		## remembered across encounters. See _check_reverse_fear_from_
		## frightening() for what toggling this on actually does.
		if player.get_talent_rank("Frightening") > 0:
			var frightening_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			frightening_btn.text = "Frightening: %s" % ("ON" if frightening_active else "OFF")
			if awaiting_fortune_choice:
				frightening_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(Callable(self, "_on_toggle_frightening")))
			else:
				frightening_btn.pressed.connect(_on_toggle_frightening)
			action_row.add_child(frightening_btn)
		## Frenzy (p.190): a Willpower Test to enter it; once Frenzied, every
		## Attack this encounter also gets a Free Action bonus attack (see
		## _on_player_attack), +1 Strength Bonus (see get_characteristic_bonus),
		## and lasts until the fight ends here or Battle Rage ends it early —
		## simplified from the book's full "until pacified/Stunned" tracking
		## (see the README for what's not modelled).
		if player.get_talent_rank("Frenzy") > 0 and not player.conditions.has("Frenzy"):
			var frenzy_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			frenzy_btn.text = "Enter Frenzy"
			frenzy_btn.disabled = action_used_this_turn
			if action_used_this_turn:
				frenzy_btn.tooltip_text = ACTION_USED_TOOLTIP
			frenzy_btn.pressed.connect(_on_enter_frenzy)
			action_row.add_child(frenzy_btn)
		## Battle Rage (p.132): "You can end your Frenzy with a successful
		## Cool Test at the end of the round" — only offered while actually
		## Frenzied, since there's nothing to end otherwise.
		if player.get_talent_rank("Battle Rage") > 0 and player.conditions.has("Frenzy"):
			var battle_rage_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			battle_rage_btn.text = "End Frenzy (Battle Rage)"
			battle_rage_btn.disabled = action_used_this_turn
			if action_used_this_turn:
				battle_rage_btn.tooltip_text = ACTION_USED_TOOLTIP
			battle_rage_btn.pressed.connect(_on_end_frenzy_battle_rage)
			action_row.add_child(battle_rage_btn)
		## Hatred (p.190): "you must attempt a Psychology Test [on
		## encountering the hated group]... if failed, you are subject to
		## Hatred" — offered as a real activatable choice (a Cool Test)
		## rather than automatic, since this project doesn't track which
		## specific enemy "group" is present to auto-trigger it. Not
		## offered while already Subject to Hatred, since there's nothing
		## further to activate.
		if player.get_talent_rank("Hatred") > 0 and not player.conditions.has("Hatred"):
			var hatred_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			hatred_btn.text = "Succumb to Hatred"
			hatred_btn.disabled = action_used_this_turn
			if action_used_this_turn:
				hatred_btn.tooltip_text = ACTION_USED_TOOLTIP
			hatred_btn.pressed.connect(_on_succumb_to_hatred)
			action_row.add_child(hatred_btn)

		## --- Defense (second tier) -----------------------------------------
		var defense_row := HFlowContainer.new()
		defense_row.add_theme_constant_override("separation", 6)
		var stance_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		stance_btn.text = "Defensive Stance  [Z]"
		stance_btn.disabled = action_used_this_turn
		if stance_btn.disabled:
			stance_btn.tooltip_text = ACTION_USED_TOOLTIP
		stance_btn.pressed.connect(_on_defensive_stance)
		_active_stance_button = stance_btn
		defense_row.add_child(stance_btn)
		## Disengage — renamed from "Flee from Harm" per the request, and no
		## longer an instant flee-the-whole-encounter button. Spending it
		## (2 Adv, 1 with Relentless — see spend_flee_from_harm) marks the
		## player safe to Move away from melee this Turn without provoking
		## the free/undefended attack _try_commit_move otherwise applies —
		## only meaningful, so only enabled, while actually engaged (adjacent
		## to a living adversary).
		var disengage_cost := 1 if player.has_talent("Relentless") else 2
		var is_engaged := not _player_engaged_enemies().is_empty()
		var disengage_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		disengage_btn.text = "Disengage (%d Adv)" % disengage_cost
		if disengaged_this_turn:
			disengage_btn.text += "  (active)"
		disengage_btn.disabled = disengaged_this_turn or not is_engaged or pool.get_pool("ally") < disengage_cost
		if disengaged_this_turn:
			disengage_btn.tooltip_text = "Already active this turn."
		elif not is_engaged:
			disengage_btn.tooltip_text = "Only usable while engaged in melee combat."
		elif pool.get_pool("ally") < disengage_cost:
			disengage_btn.tooltip_text = "Not enough Advantage (%d available, need %d)." % [pool.get_pool("ally"), disengage_cost]
		else:
			disengage_btn.tooltip_text = "Move away safely this Turn without provoking a free attack."
		if awaiting_fortune_choice:
			disengage_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(Callable(self, "_on_disengage")))
		else:
			disengage_btn.pressed.connect(_on_disengage)
		defense_row.add_child(disengage_btn)

		## Entangled (p.168): "For your Action, you can remove an Entangled
		## Condition if you win an Opposed Strength Test against the source
		## of the entanglement." Offered whenever the player actually has
		## the Condition — the "source" isn't tracked as a distinct entity
		## in this project, so the Opposed Test is against the current
		## target as the nearest reasonable stand-in.
		if player.conditions.has("Entangled") and target != null:
			var entangled_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			entangled_btn.text = "Struggle Free of Entangled"
			entangled_btn.disabled = action_used_this_turn
			if action_used_this_turn:
				entangled_btn.tooltip_text = ACTION_USED_TOOLTIP
			entangled_btn.pressed.connect(func(): _on_struggle_free(target))
			defense_row.add_child(entangled_btn)

		## Ablaze (p.167): "One Ablaze Condition can be removed with a
		## successful Athletics Test." Same self-directed-Action shape as
		## Struggle Free above — offered whenever the player is actually on
		## fire, disabled once the Action's already spent.
		if player.conditions.has("Ablaze"):
			var douse_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			douse_btn.text = "Douse Flames (Ablaze)"
			douse_btn.disabled = action_used_this_turn
			if action_used_this_turn:
				douse_btn.tooltip_text = ACTION_USED_TOOLTIP
			douse_btn.pressed.connect(_on_douse_flames)
			defense_row.add_child(douse_btn)

		## Distract (Talent, p.142): "You may use your Move to perform a
		## Distraction" — spends the Move, not the Action.
		## Per the request ("Stand Up and Spend Resolve should be presented
		## in the Movement / Free Actions section"): those two used to live
		## here too, right alongside Distract — moved into col1 below (see
		## the "Prone recovery" row right after the light toggle) since this
		## whole defense_row/col2 section is skipped entirely during
		## dungeon exploration (if not _exploration_mode: guards it), which
		## left a character knocked Prone by fall damage outside combat with
		## no way to stand back up until a fight actually started. col1's
		## "Movement / Free Actions" header renders in both submodes.
		if player.has_talent("Distract") and movement_remaining > 0 and target != null:
			var distract_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			distract_btn.text = "Distract (%s)" % target.character_name
			distract_btn.tooltip_text = "Opposed Athletics/Cool Test. On a win, %s can generate no Advantage until the end of next Round." % target.character_name
			distract_btn.pressed.connect(func(): _on_distract(target))
			defense_row.add_child(distract_btn)
		col2.get_parent().add_child(defense_row)

	action_row = col3
	var channelling_specs := _get_known_channelling_specs()
	if not player.known_spells.is_empty() or not channelling_specs.is_empty():
		var arcane_lore := player.get_arcane_lore()
		var has_colour_effect := MAGIC_COLOUR_EFFECTS.has(arcane_lore)
		if not channelling_specs.is_empty():
			_add_channelling_row(channelling_specs, action_row)
		if has_colour_effect:
			var colour_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			colour_btn.text = "Colour Effect: %s" % ("ON" if magic_colour_effect_active else "OFF")
			var toggle_colour_effect := func():
				magic_colour_effect_active = not magic_colour_effect_active
				GameState.magic_colour_effect_remembered = magic_colour_effect_active
				_prompt_player_turn(false)
			if awaiting_fortune_choice:
				colour_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(toggle_colour_effect))
			else:
				colour_btn.pressed.connect(toggle_colour_effect)
			action_row.add_child(colour_btn)
		if not player.known_spells.is_empty():
			_add_spell_or_prayer_row(true, action_row)

	if not player.get_effective_known_prayers().is_empty():
		_add_spell_or_prayer_row(false, action_row)

	## Per the follow-up request ("light (petty spell)... should have
	## the same bright/dim/out options as lamps (but display these
	## buttons in the magic button section)"): only shown while this
	## player's own Light spell is genuinely running
	## (light_spell_rounds_remaining > 0 — see that field's own
	## comment); nothing to toggle otherwise. Three explicit buttons
	## rather than the single-button off->on->low->off CYCLE lamps use
	## via the L hotkey (see Overworld._toggle_light_source()) — the
	## request specifically asks for buttons here, in this column,
	## which reads more clearly as three direct choices than one more
	## cycling button. The currently-active mode's own button is
	## disabled (nothing to switch it to), same "can't press the state
	## you're already in" convention the Colour Effect button doesn't
	## use but most of this screen's other mode-select UI does. Free —
	## no action cost, no turn spent, mirrors the lamp toggle's own
	## "always works" framing exactly.
	if player.light_spell_rounds_remaining > 0:
		var light_mode_row := HFlowContainer.new()
		light_mode_row.add_theme_constant_override("separation", 6)
		var light_mode_label := Label.new()
		light_mode_label.text = "Light:"
		light_mode_row.add_child(light_mode_label)
		var light_modes: Array = [["bright", "Bright"], ["dim", "Dim"], ["out", "Out"]]
		for mode_spec in light_modes:
			var mode_value: String = mode_spec[0]
			var mode_label: String = mode_spec[1]
			var mode_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			mode_btn.text = mode_label
			mode_btn.disabled = player.light_spell_mode == mode_value
			var set_light_mode := func():
				player.light_spell_mode = mode_value
				## Same immediate-reveal fix as the cast branch above
				## (see its own comment) — switching Dim/Out/Bright
				## changes the radius right now, not on the next
				## incidental Move.
				if not dungeon_state.is_empty():
					_reveal_around_party()
				_prompt_player_turn(false)
			if awaiting_fortune_choice:
				mode_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(set_light_mode))
			else:
				mode_btn.pressed.connect(set_light_mode)
			light_mode_row.add_child(mode_btn)
		action_row.add_child(light_mode_row)

	## --- Skills, Items (moved below Magic/Prayers per the request) -----
	## Per the request: given their own row rather than flowing straight
	## on from the Movement buttons above — a new HFlowContainer, added
	## as its own child of col1's wrapper VBox rather than reusing the
	## Movement row's own flow container, so it always starts on a fresh
	## line regardless of how much horizontal space the column has, not
	## just whenever the Movement row happens to run out of width.
	var skills_row := HFlowContainer.new()
	skills_row.add_theme_constant_override("separation", 6)
	if target != null:
		var intimidate_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		intimidate_btn.text = "Intimidate"
		intimidate_btn.disabled = action_used_this_turn
		if action_used_this_turn:
			intimidate_btn.tooltip_text = ACTION_USED_TOOLTIP
		intimidate_btn.pressed.connect(func(): _on_intimidate(target))
		skills_row.add_child(intimidate_btn)
	## Per the request: Heal is an Advanced skill — it should never even
	## be offered to a character who hasn't actually learned it, the
	## same rule every other Advanced skill needs to follow. This was
	## specifically flagged as broken: the button showed (and worked)
	## for anyone regardless of training.
	var heal_skill_def: SkillDefinition = GameData.skill_db.find_by_name("Heal")
	if heal_skill_def != null and player.has_skill(heal_skill_def):
		var heal_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		heal_btn.text = "Heal Self"
		heal_btn.disabled = player.wounds_current >= player.wounds_max or action_used_this_turn
		if action_used_this_turn:
			heal_btn.tooltip_text = ACTION_USED_TOOLTIP
		elif player.wounds_current >= player.wounds_max:
			heal_btn.tooltip_text = "Already at full Wounds."
		heal_btn.pressed.connect(_on_heal_self)
		skills_row.add_child(heal_btn)
		## Field Dressing (p.138): "Trained to stabilise the wounded... in
		## the heat of battle" -- the one part of this project's Heal
		## action that was missing entirely until now: everything above
		## only ever treated yourself. Offered as a separate button (not
		## folded into "Heal Self" with a target popup every time) so the
		## common case stays a single click. Only lists living, CONSCIOUS
		## allies who actually need it (wounded, Bleeding, or Poisoned) --
		## an Unconscious ally is deliberately excluded: waking someone
		## mid-combat isn't modelled anywhere in this project yet (see
		## _clear_conditions_at_battle_end's own comment on that same
		## gap), so Field Dressing's "stabilise a dying companion" clause
		## stays unmodelled for that specific case, same honest treatment
		## as Flagellant's own unmodelled Wound-resistance clause.
		var heal_ally_candidates := _allies_needing_heal()
		var heal_ally_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		heal_ally_btn.text = "Heal Ally"
		heal_ally_btn.disabled = heal_ally_candidates.is_empty() or action_used_this_turn
		if action_used_this_turn:
			heal_ally_btn.tooltip_text = ACTION_USED_TOOLTIP
		elif heal_ally_candidates.is_empty():
			heal_ally_btn.tooltip_text = "No wounded, conscious ally to treat."
		heal_ally_btn.pressed.connect(func():
			_show_ally_target_popup(heal_ally_candidates, heal_ally_btn,
				func(c: Character): return "%s (%d/%d Wounds)" % [c.character_name, c.wounds_current, c.wounds_max],
				func(chosen: Character): _on_heal_ally(chosen))
		)
		skills_row.add_child(heal_ally_btn)
	if player.inventory.has(HEALING_DRAUGHT):
		var item_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		item_btn.text = "Drink Healing Draught (Free)"
		item_btn.disabled = player.wounds_current >= player.wounds_max
		if item_btn.disabled:
			item_btn.tooltip_text = "Already at full Wounds."
		if awaiting_fortune_choice:
			item_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(Callable(self, "_on_use_healing_draught")))
		else:
			item_btn.pressed.connect(_on_use_healing_draught)
		skills_row.add_child(item_btn)
	## Cordelia's Apothecary consumables (spec: "Implement Faxtoryll,
	## Salwort and Vitality Draught and add options to consume them and
	## gain their benefits during battle (hide these until they are
	## needed)"): Faxtoryll and Vitality Draught are offered here
	## whenever carried, same "(Free)" shape as Healing Draught above —
	## Salwort is deliberately NOT here; it only makes sense while
	## genuinely Stunned, so its own button lives in
	## _prompt_incapacitated_turn()'s Stunned branch instead (the one
	## place "hide until needed" actually applies to it — see that
	## function's own comment for why).
	if player.inventory.has(FAXTORYLL):
		var faxtoryll_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		faxtoryll_btn.text = "Chew Faxtoryll (Free)"
		faxtoryll_btn.tooltip_text = "+10 Weapon Skill, +10 Ballistic Skill for 3 Rounds."
		if awaiting_fortune_choice:
			faxtoryll_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(Callable(self, "_on_use_faxtoryll")))
		else:
			faxtoryll_btn.pressed.connect(_on_use_faxtoryll)
		skills_row.add_child(faxtoryll_btn)
	if player.inventory.has(VITALITY_DRAUGHT):
		var vitality_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		vitality_btn.text = "Drink Vitality Draught (Free)"
		vitality_btn.tooltip_text = "+10 Toughness, +2 Movement for 6 Rounds."
		if awaiting_fortune_choice:
			vitality_btn.pressed.connect(_decline_fortune_prompt_and_run.bind(Callable(self, "_on_use_vitality_draught")))
		else:
			vitality_btn.pressed.connect(_on_use_vitality_draught)
		skills_row.add_child(vitality_btn)
	if skills_row.get_child_count() > 0:
		col1.get_parent().add_child(skills_row)

	target_container.add_child(columns_row)

	## Kept as its own separate, small-font line below the 3 columns
	## rather than folded into any of them — it's a passive hint, not
	## an action, and reads better on its own line than competing with
	## buttons for a wrap slot in a column.
	var target_note := Label.new()
	target_note.text = "Target: click a portrait above to change."
	target_note.add_theme_font_size_override("font_size", 7)
	target_note.add_theme_color_override("font_color", Color(0.6, 0.55, 0.48))
	target_container.add_child(target_note)

	## --- Act Again — per the follow-up request ("move the Act Again
	## button above the Effort buttons, disable until conditions for
	## its usage are met" — clarified to be a COPY, not a replacement:
	## Act Again still also appears in its original spot too, the
	## Continue prompt at turn end — see _wait_for_continue()): a real,
	## permanent button, sitting right above the Effort row below,
	## always visible rather than only appearing once the Action's
	## fully resolved. Disabled until: this ally has the 4 Advantage it
	## costs, this Turn's Action has actually been used (using Act Again
	## before spending the first Action would be pointless — it grants a
	## SECOND Action), Act Again hasn't already fired this Turn, and the
	## fight is still actually going.
	##
	## Rebuilt every time this shared menu body runs — including while a
	## Fortune/Dark Deal prompt is open (see _render_fortune_prompt_turn_
	## preview(), which now just calls _render_turn_action_menu() like
	## everywhere else) — so its enabled state and wiring always reflect
	## the current moment rather than a stale snapshot. While
	## awaiting_fortune_choice is true, a click routes through
	## _decline_fortune_prompt_and_run() (decline the open prompt, then
	## run the real Act Again handler at the next safe moment) instead of
	## calling _on_additional_action directly — same pattern as every
	## other Free Action button above; Act Again itself doesn't consume
	## the Action, only Advantage, so there's no reason it has to wait
	## for the current roll to finish resolving first. Outside a Fortune
	## prompt this is unchanged: still only enabled once
	## _finish_player_action() reopens the menu with the Action actually
	## spent.
	_act_again_button = _make_button(ACTION_COLUMN_FONT_SIZE)
	_act_again_button.text = "Act Again (4 Adv)"
	var act_again_fight_active: bool = not encounter.get_living("adversary").is_empty()
	var act_again_eligible: bool = player != null and player.allegiance == "ally" \
		and pool.get_pool("ally") >= 4 and action_used_this_turn \
		and not additional_action_used_this_turn and act_again_fight_active \
		and _can_use_act_again(player)
	_act_again_button.disabled = not act_again_eligible
	if not act_again_fight_active:
		_act_again_button.tooltip_text = "The fight is already over."
	elif additional_action_used_this_turn:
		_act_again_button.tooltip_text = "Already used this Turn."
	elif not action_used_this_turn:
		_act_again_button.tooltip_text = "Spend your Action first — Act Again grants a second one."
	elif pool.get_pool("ally") < 4:
		_act_again_button.tooltip_text = "Not enough Advantage (%d available, need 4)." % pool.get_pool("ally")
	elif player != null and not _can_use_act_again(player):
		_act_again_button.tooltip_text = "Unconscious/Stunned/Surprised/Broken — cannot act again this Turn."
	if awaiting_fortune_choice:
		_act_again_button.pressed.connect(_decline_fortune_prompt_and_run.bind(Callable(self, "_on_additional_action")))
	else:
		_act_again_button.pressed.connect(_on_additional_action)
	side_actions_container.add_child(_act_again_button)

	## --- Effort / Advantage Actions — moved into the left sidebar's
	## SideActionsContainer (see @onready declaration), which sits right
	## below the Turn Order list and was otherwise just empty space, per
	## the request. No longer a collapsible section the player has to
	## expand ("stop hiding them") — always shown here, with individual
	## buttons greyed out (rather than the whole section disappearing)
	## once the Action's already spent this turn or Advantage is short,
	## matching how every other Action-consuming option elsewhere in this
	## menu already behaves (Cast/Pray/Defensive Stance/Channel).
	side_actions_container.add_child(_section_label("Effort [Shift]:"))
	var effort_row := HFlowContainer.new()
	effort_row.add_theme_constant_override("separation", 6)
	for spend in [2, 3, 4]:
		var eff_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		eff_btn.text = "%d Adv (+%d%%)" % [spend, (spend - 1) * 10]
		## Per the request: once the Action's already spent this Turn,
		## there's no next Test left this Turn to boost — pending_effort_bonus
		## resets on the next fresh turn (see _prompt_player_turn) rather
		## than carrying over, so spending Advantage here now would just be
		## wasted, same reasoning the other Advantage Actions below
		## (Assess/Batter/Trick) already disable on.
		eff_btn.disabled = pool.get_pool("ally") < spend or pending_effort_bonus > 0 or action_used_this_turn
		if action_used_this_turn:
			eff_btn.tooltip_text = ACTION_USED_TOOLTIP
		elif pending_effort_bonus > 0:
			eff_btn.tooltip_text = "Additional Effort is already queued for your next Test this turn."
		elif pool.get_pool("ally") < spend:
			eff_btn.tooltip_text = "Not enough Advantage (%d available, need %d)." % [pool.get_pool("ally"), spend]
		eff_btn.pressed.connect(func(): _on_additional_effort(spend))
		effort_row.add_child(eff_btn)
	side_actions_container.add_child(effort_row)

	side_actions_container.add_child(_section_label("Advantage Actions (%d available):" % pool.get_pool("ally")))
	var assess_row := HBoxContainer.new()
	assess_row.add_theme_constant_override("separation", 8)
	var assess_picker := OptionButton.new()
	assess_picker.add_theme_font_size_override("font_size", 9)
	for s in ASSESS_SKILLS:
		assess_picker.add_item(s)
	assess_row.add_child(assess_picker)
	var assess_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	assess_btn.text = "Assess (+2/+3 Adv)"
	assess_btn.disabled = action_used_this_turn
	if assess_btn.disabled:
		assess_btn.tooltip_text = ACTION_USED_TOOLTIP
	assess_btn.pressed.connect(func(): _on_assess(assess_picker.get_item_text(assess_picker.selected)))
	assess_row.add_child(assess_btn)
	side_actions_container.add_child(assess_row)

	if target != null:
		var batter_trick_row := HFlowContainer.new()
		batter_trick_row.add_theme_constant_override("separation", 8)
		var batter_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		batter_btn.text = "Batter (1 Adv)"
		batter_btn.disabled = pool.get_pool("ally") < 1 or action_used_this_turn
		if action_used_this_turn:
			batter_btn.tooltip_text = ACTION_USED_TOOLTIP
		elif pool.get_pool("ally") < 1:
			batter_btn.tooltip_text = "Not enough Advantage (need at least 1)."
		batter_btn.pressed.connect(func(): _on_batter(target))
		batter_trick_row.add_child(batter_btn)

		var trick_picker := OptionButton.new()
		trick_picker.add_theme_font_size_override("font_size", 9)
		for cond in TRICK_CONDITIONS:
			trick_picker.add_item(cond if cond != "" else "(no condition)")
		batter_trick_row.add_child(trick_picker)
		var trick_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		trick_btn.text = "Trick (1 Adv)"
		trick_btn.disabled = pool.get_pool("ally") < 1 or action_used_this_turn
		if action_used_this_turn:
			trick_btn.tooltip_text = ACTION_USED_TOOLTIP
		elif pool.get_pool("ally") < 1:
			trick_btn.tooltip_text = "Not enough Advantage (need at least 1)."
		trick_btn.pressed.connect(func():
			var cond: String = TRICK_CONDITIONS[trick_picker.selected]
			_on_trick(target, cond)
		)
		batter_trick_row.add_child(trick_btn)
		side_actions_container.add_child(batter_trick_row)

	## WASD navigation should never be able to land focus on a
	## greyed-out button — see _refresh_focus_for_disabled_buttons.
	_refresh_focus_for_disabled_buttons(self)
	_auto_focus_default_button()

## Live getter handed to grid_view as suppress_left_click_pan (see that
## field's own declaration comment in battle_grid_view.gd) — a plain
## poll instead of a pushed flag, so grid_view always sees the current
## truth regardless of which of move_mode_active's several set sites
## (the two _enter_/_exit_move_mode below, plus a couple of turn-start
## resets elsewhere in this file) last touched it.
func _is_move_mode_active() -> bool:
	return move_mode_active

## Real bug fix (root-cause hardening for the whole "player controlling
## monster" bug class — this is its 5th reported occurrence; see
## _next_turn()'s and _render_turn_action_menu()'s own comments for the
## first four fixes). Every previous fix cleared stale UI at one specific
## RENDER/TRANSITION choke point each time a new leak was found — but any
## future (or not-yet-found) code path that leaves live player-turn
## controls on screen without funnelling through that exact choke point
## (e.g. _spawn_monsters_during_exploration() adding a monster mid-round
## without itself calling _next_turn(), since the currently-acting
## character legitimately keeps their turn until they end it) can leak
## the same way all over again. Rather than chase yet another render
## site, this is a single, authoritative guard on whether the player is
## actually allowed to INITIATE an action right now, checked by the
## action-executing handlers themselves — so a stale button surviving on
## screen becomes structurally harmless to click, no matter how or why it
## was left there.
## `pending_defense` non-empty is the one legitimate case where `player`
## is deliberately NOT the current combatant: _monster_attack() reassigns
## `player` to the defending ally for a REACTIVE defense prompt (Parry/
## Dodge) while a monster's own attack Test resolves. That prompt's own
## Movement/Magic columns are always left empty (see _build_scoped_
## column), so nothing that calls this should ever legitimately fire
## during it — excluded here rather than by accident.
func _is_players_own_turn() -> bool:
	if not pending_defense.is_empty():
		return false
	if encounter != null and player != null and encounter.get_current_combatant() != player:
		return false
	return true

## Enters move mode: highlights every square reachable within
## movement_remaining, and switches battle-map clicks over to
## "move here" (see _on_grid_square_clicked/_try_commit_move) until
## either a move is committed or Move is clicked again to cancel.
func _enter_move_mode() -> void:
	if ranged_target_mode_active:
		_exit_ranged_target_mode()
	## See _is_players_own_turn()'s own comment: a stale Move button from
	## a previous Turn (however it got left on screen) can no longer
	## actually move anyone once it isn't genuinely player's own Turn.
	if not _is_players_own_turn():
		push_warning("Blocked a Move for %s while it wasn't their Turn (stale UI) — current combatant: %s" % [
			player.character_name if player != null else "?",
			encounter.get_current_combatant().character_name if (encounter != null and encounter.get_current_combatant() != null) else "none",
		])
		_clear(target_container)
		_clear(side_actions_container)
		if grid_view != null:
			grid_view.set_charge_ready(Vector2i(-1, -1))
		return
	if battle_grid == null or movement_remaining <= 0 or not battle_positions.has(player):
		return
	var reachable: Array = battle_grid.reachable_squares(battle_positions[player], movement_remaining, _occupied_squares_excluding(player), player.get_footprint_size())
	if reachable.is_empty():
		_add_notice("%s has nowhere to move." % player.character_name)
		return
	move_mode_active = true
	_move_waypoints = []
	_move_mode_reachable = reachable
	grid_view.highlight_squares(reachable)
	_add_notice("%s: click within the highlighted range to move there (right-click a square first to set a waypoint and change direction), or click Move again to cancel." % player.character_name)
	_prompt_player_turn(false)

## Leaves move mode without moving anyone — used both by the Move
## button's own cancel toggle and defensively whenever a move session
## needs to be torn down (e.g. a successful commit clears state via
## _try_commit_move before deciding what happens next, not this).
func _exit_move_mode() -> void:
	move_mode_active = false
	sprint_finish_pending = false
	_move_mode_reachable = []
	_move_waypoints = []
	grid_view.clear_highlight()
	grid_view.set_preview_path([])
	grid_view.set_hover_target(Vector2i(-1, -1), false)
	grid_view.set_charge_preview([], Vector2i(-1, -1))

## Enters AoE free-target mode for a spell/prayer that places its effect
## on a clicked square (Blast, Twin-tailed Comet) rather than a selected
## enemy — mirrors _enter_move_mode's "highlight then click" flow.
## Doesn't touch awaiting_player_target/action_used_this_turn: like the
## existing "select an enemy portrait first" gate for a normal damage
## spell, nothing about the turn is spent yet — only actually clicking a
## square (see _resolve_aoe_cast) commits the cast.
func _enter_aoe_target_mode(is_spell: bool, effect_name: String, is_war_wizard_free: bool) -> void:
	if ranged_target_mode_active:
		_exit_ranged_target_mode()
	aoe_target_mode_active = true
	_pending_aoe_cast = {"is_spell": is_spell, "name": effect_name, "is_war_wizard_free": is_war_wizard_free}
	_add_notice("%s: click a square on the battle map to place %s — hover to preview the affected radius." % [player.character_name, effect_name])
	_prompt_player_turn(false)

## Leaves AoE targeting mode without casting anything.
func _exit_aoe_target_mode() -> void:
	aoe_target_mode_active = false
	_pending_aoe_cast = {}
	grid_view.set_aoe_preview([])
	grid_view.set_hover_target(Vector2i(-1, -1), false)

## --- Ranged Attack / Magic-Prayer targeting -------------------------------
## Per the request: for a single-targeted ranged Attack or a damage
## spell/prayer (unless the target is the caster, an AoE effect, or a
## "Special"-target spell like Breath's cone — all of which keep their
## existing flow), clicking Attack/Cast/Pray no longer resolves against
## whatever selected_target happened to be. Instead it opens this
## targeting mode: every currently in-range living adversary gets an
## arrow on the battle map (see BattleGridView.set_target_arrows), and
## the actual roll only happens once the player clicks one of them.

## Every living adversary within `weapon`'s range — Point Blank through
## Extreme all count (matches the soft range-band system a ranged
## Attack roll already uses; only truly OUT_OF_RANGE is excluded), same
## definition of "in range" _on_player_attack itself already enforces,
## just computed up front here instead of discovered after the fact.
## Falls back to every living adversary if there's no real battle grid
## to measure distance on.
func _targets_in_weapon_range(weapon: WeaponDefinition) -> Array:
	var living: Array = encounter.get_living("adversary")
	if battle_grid == null or not battle_positions.has(player):
		return living
	var result: Array = []
	for m in living:
		if not battle_positions.has(m):
			continue
		## Real bug fix ("player should not be able to target monster
		## they can not see yet with melee (including charge) and ranged
		## attacks"): this list drives both the melee "is anything
		## reachable" check (_render_turn_action_menu's own melee_stuck_
		## out_of_range and the ranged-weapon "no targets" gate) and the
		## ranged targeting arrow list itself (_enter_ranged_target_mode)
		## — a monster hidden behind an obstacle or around a corner used
		## to still show up in both. See _can_see_target()'s own comment.
		if not _can_see_target(m):
			continue
		var dist_yd := BattleGrid.distance_yards(battle_positions[player], battle_positions[m])
		if BattleGrid.get_range_band(dist_yd, player.get_effective_weapon_range(weapon)) != BattleGrid.RangeBand.OUT_OF_RANGE:
			result.append(m)
	return result

## Parses a SpellDefinition/PrayerDefinition's own range_text (p.234-238/
## 217-218) into real yards for range-gating a damage cast — per the
## request, "add range data." The book expresses spell/prayer Range as
## free text rather than a flat number the way a weapon's range_yards
## already is, so this is computed from the caster's own Characteristics
## at cast time instead of being a static data field (a "WP Bonus
## yards" spell's real range depends on which character is casting it).
## Every format actually used by this project's spell/prayer data is
## covered: a flat "N yard(s)", "Touch" (must be adjacent — treated as
## one square, same reach as melee), and the three Characteristic-
## derived forms ("Fellowship yards", "WP yards", "WP Bonus yards").
## Unlike a weapon's soft Point-Blank..Extreme bands, the book gives
## spells/prayers no such tiering — Range is a hard cap, so callers
## treat this as an exact maximum, not a band boundary. An unrecognized
## format conservatively falls back to 0 (Touch-only) rather than
## silently allowing an unbounded cast.
func _spell_or_prayer_range_yards(range_text: String) -> int:
	var text := range_text.strip_edges()
	if text == "Touch":
		return BattleGrid.YARDS_PER_SQUARE
	var parts := text.split(" ")
	if parts.size() >= 2 and (parts[-1] == "yards" or parts[-1] == "yard"):
		var value_part := " ".join(parts.slice(0, parts.size() - 1))
		if value_part.is_valid_int():
			return value_part.to_int()
		if value_part == "WP Bonus":
			return player.get_characteristic_bonus("willpower")
		if value_part == "WP":
			return player.characteristics.get_value("willpower")
		if value_part == "Fellowship":
			return player.characteristics.get_value("fellowship")
	return 0

## Every living adversary within a damage spell/prayer's real range —
## a hard "distance <= range yards" cutoff (see
## _spell_or_prayer_range_yards's own comment on why this differs from
## a weapon's soft bands). Falls back to every living adversary if
## there's no real battle grid to measure distance on, same as
## _targets_in_weapon_range.
func _targets_in_spell_range(range_text: String) -> Array:
	var living: Array = encounter.get_living("adversary")
	if battle_grid == null or not battle_positions.has(player):
		return living
	var max_yd := _spell_or_prayer_range_yards(range_text)
	var result: Array = []
	for m in living:
		if not battle_positions.has(m):
			continue
		if BattleGrid.distance_yards(battle_positions[player], battle_positions[m]) <= max_yd:
			result.append(m)
	return result

## Opens targeting mode for one pending ranged Attack/Cast/Pray.
## `params` carries whatever _resolve_ranged_target needs to finish the
## job once a target's actually clicked (see _pending_ranged_action's
## own comment). Refuses (with a notice, spending nothing) if nothing's
## actually in range yet — "don't allow casting out of max spell
## range," applied by simply never offering an out-of-range target to
## click in the first place, rather than accepting the click and then
## refusing the roll.
func _enter_ranged_target_mode(kind: String, params: Dictionary, valid_targets: Array) -> void:
	if valid_targets.is_empty():
		_add_notice("[color=#c9a24b]No targets within range.[/color]")
		return
	if move_mode_active:
		_exit_move_mode()
	if aoe_target_mode_active:
		_exit_aoe_target_mode()
	ranged_target_mode_active = true
	_pending_ranged_action = {"kind": kind}
	for key in params:
		_pending_ranged_action[key] = params[key]
	_ranged_valid_targets = valid_targets
	## Per the request: nothing is pre-selected just from opening
	## targeting mode — the player looks around freely (see
	## _on_grid_square_hovered) and only the target they actually hover
	## gets the crosshair/readout.
	_ranged_focus_target = null
	_update_ranged_target_arrows()
	_add_notice("%s: hover a target for its range/distance, then click it to attack." % player.character_name)
	_prompt_player_turn(false)

## Leaves ranged targeting mode without attacking/casting anything.
func _exit_ranged_target_mode() -> void:
	ranged_target_mode_active = false
	_pending_ranged_action = {}
	_ranged_valid_targets = []
	_ranged_focus_target = null
	if grid_view != null:
		grid_view.set_target_arrows([])
		grid_view.set_target_focus(Vector2i(-1, -1), [])

func _update_ranged_target_arrows() -> void:
	if grid_view == null:
		return
	var squares: Array = []
	for m in _ranged_valid_targets:
		if battle_positions.has(m):
			squares.append(battle_positions[m])
	grid_view.set_target_arrows(squares)
	_update_ranged_focus_visual()

## Pushes whatever _ranged_focus_target currently is (or clears it)
## down to the grid view's crosshair + floating readout — called
## whenever focus changes (hover) or the underlying arrow set is
## rebuilt, so a stale crosshair never survives a rebuild it wasn't
## re-confirmed against.
func _update_ranged_focus_visual() -> void:
	if grid_view == null:
		return
	if _ranged_focus_target == null or not battle_positions.has(_ranged_focus_target):
		grid_view.set_target_focus(Vector2i(-1, -1), [])
		return
	grid_view.set_target_focus(battle_positions[_ranged_focus_target], _ranged_target_readout(_ranged_focus_target))

## The Character among _ranged_valid_targets standing on `square`, or
## null — used both to resolve a click (existing behavior) and now
## also to decide what the hover crosshair should focus on.
## Per the request ("allow large creatures to be hit in any of the cells
## it occupies, not only top left one") — footprint-aware, same as
## _living_character_at_square, so hovering ANY cell a multi-square
## target's token covers focuses it, not just its anchor cell.
func _ranged_target_at(square: Vector2i) -> Character:
	for m in _ranged_valid_targets:
		if not battle_positions.has(m):
			continue
		if BattleGrid.footprint_cells(battle_positions[m], m.get_footprint_size()).has(square):
			return m
	return null

## Colors used by the readout segments below — negative modifiers in
## red, positive ones in a soft green, matching the follow-up request
## ("add cover -xx (in red) after the range +/-xx modifier label").
const READOUT_NEGATIVE_COLOR := Color(1.0, 0.35, 0.3, 1.0)
const READOUT_POSITIVE_COLOR := Color(0.55, 0.95, 0.5, 1.0)

## The small "distance — range band [+ modifiers]" readout floated above
## the currently-focused target's crosshair (per the request: "show a
## little count with distance to target and if its within point blank
## +40/short +20/long +0/extreme -30 distance for ranged"; per the
## follow-up request: "add cover -xx (in red) after the range +/-xx
## modifier label where shown, and any other known test modifiers
## too"). Returns an Array of {"text": String, "color": Color} segments
## (rather than a plain String) so BattleGridView can render the base
## range readout and each modifier in its own color instead of one flat
## line — see BattleGridView.set_target_focus()/_draw()'s own
## target_focus_segments handling. A ranged weapon Attack shows the real
## range band name and roll modifier, plus every OTHER modifier that
## would actually apply to this exact shot if taken right now (Cover,
## Fear, Additional Effort) — the same set _on_player_attack's own
## do_attack closure below folds into the real roll, so this readout
## never promises something the attack itself doesn't deliver. Magic/
## Prayer casts show distance only: a spell/prayer's Range is a hard cap
## with no such tiering (see _spell_or_prayer_range_yards), so there's
## no band/modifier to show.
func _ranged_target_readout(m: Character) -> Array:
	if not battle_positions.has(player) or not battle_positions.has(m):
		return []
	var dist_yd := BattleGrid.distance_yards(battle_positions[player], battle_positions[m])
	var segments: Array = []
	if _pending_ranged_action.get("kind", "") == "attack":
		var weapon: WeaponDefinition = _pending_ranged_action.get("weapon_override", null)
		if weapon == null:
			weapon = weapons.get(player, null)
		if weapon != null:
			var band := BattleGrid.get_range_band(dist_yd, player.get_effective_weapon_range(weapon))
			var band_mod := BattleGrid.get_range_band_modifier(band)
			var mod_str := "+%d" % band_mod if band_mod > 0 else str(band_mod)
			segments.append({"text": "%d yd — %s %s" % [dist_yd, BattleGrid.get_range_band_name(band), mod_str]})
			if battle_grid != null:
				var cover_info: Dictionary = battle_grid.get_ranged_cover(battle_positions[player], battle_positions[m])
				if cover_info["blocked"]:
					segments.append({"text": "  No LOS", "color": READOUT_NEGATIVE_COLOR})
				elif cover_info["penalty"] != 0:
					var lvl_label: String = String(cover_info["level"]).capitalize()
					segments.append({"text": "  Cover (%s) %d" % [lvl_label, cover_info["penalty"]], "color": READOUT_NEGATIVE_COLOR})
			if _fear_sources.get(player, {}).has(m):
				segments.append({"text": "  Fear -10", "color": READOUT_NEGATIVE_COLOR})
			if pending_effort_bonus > 0:
				segments.append({"text": "  Effort +%d" % pending_effort_bonus, "color": READOUT_POSITIVE_COLOR})
			return segments
	segments.append({"text": "%d yd" % dist_yd})
	return segments

## The click (or portrait click) actually completing a pending ranged
## Attack/Cast/Pray — "only complete attack roll once user clicks on a
## target," per the request. Refuses with a notice (without leaving
## targeting mode) if `m` isn't one of the precomputed valid targets,
## so a stray click on something out of range doesn't silently do
## nothing or crash.
func _resolve_ranged_target(m: Character) -> void:
	if not ranged_target_mode_active:
		return
	if not _ranged_valid_targets.has(m):
		_add_notice("%s is out of range." % m.character_name)
		return
	var action := _pending_ranged_action.duplicate()
	_exit_ranged_target_mode()
	match action.get("kind", ""):
		"attack":
			_on_player_attack(m, action.get("weapon_override", null), false, action.get("is_offhand", false), action.get("forced_hit_location", ""))
		"spell":
			_on_cast_spell(action.get("spell_name", ""), m, action.get("is_war_wizard_free", false))
		"prayer":
			_on_pray(action.get("prayer_name", ""), m)

func _on_move_button_pressed() -> void:
	if not awaiting_player_target:
		return
	if move_mode_active:
		_exit_move_mode()
		_prompt_player_turn(false)
	else:
		_enter_move_mode()

## Voluntary early end of Turn — per the request, nothing else forces the
## Turn to end until both Move and the Action are spent, so the player
## needs an explicit way to stop early (e.g. Move is gone but they don't
## want to use their Action, or vice versa).
func _on_end_turn_pressed() -> void:
	if not awaiting_player_target:
		return
	## See _is_players_own_turn()'s own comment: a stale End Turn button
	## must never be able to advance the turn order out from under a
	## reactive defense prompt (or anyone else's actual Turn).
	if not _is_players_own_turn():
		_clear(target_container)
		_clear(side_actions_container)
		return
	_next_turn()

## Commits a move onto `square` if it's actually one of the squares move
## mode highlighted as reachable FROM THE CURRENT WAYPOINT ANCHOR (see
## _move_anchor) — or is the anchor itself, letting the player stop
## exactly at the last waypoint they set rather than being forced to move
## further — a click anywhere else while in move mode is simply ignored
## (per the request: "only apply the move if they click within movement
## range"), leaving move mode active so the player can just try again.
## `movement_remaining` drops by the real total path length — every
## locked waypoint leg plus this final one, not a flat cost — so a
## shorter partial move (or a move that stops short of using every
## waypoint's full range) leaves the rest to spend later in the same
## turn. Only the FINAL square actually matters for game state; the
## waypoints themselves were purely a routing choice.
##
## Per the request: Move and Action can be spent in any order, so this no
## longer special-cases "finishing off a Sprint" as the only reason a
## move might end the Turn — the Turn only actually ends once the Action
## has ALSO been spent (action_used_this_turn, set by Sprint itself, or
## by any other Action-consuming handler used before this move) AND
## there's no movement left either; otherwise the menu simply reopens
## with whatever Move (and/or Action) is still available.
##
## Per the follow-up request: also enforces core rulebook Disengaging
## (p.165) — a Move that leaves an adversary's melee range without
## having Disengaged first (disengaged_this_turn, see _on_disengage)
## gives that adversary a free, undefended attack (_resolve_free_attack)
## before the menu reopens.
func _try_commit_move(square: Vector2i) -> void:
	var anchor: Vector2i = _move_anchor()
	var stopping_at_anchor: bool = square == anchor and not _move_waypoints.is_empty()
	if not stopping_at_anchor and not _move_mode_reachable.has(square):
		return

	## Fear (Rating), p.190-191: "you cannot move closer to the source of
	## your Fear unless you pass a Challenging (+0) Cool Test." Per the
	## request ("let implement ... Fear ... fully" / "restrict their
	## actions and movement appropriately"): checked here, the single
	## real commit point for every player Move, against every monster
	## `player` currently fears whose distance to the clicked destination
	## would be less than its distance to player's current square. A
	## failed Test cancels the whole move attempt outright — nothing
	## about a Move can be "partially" committed — rather than silently
	## letting it through; one passed (or skipped, if nothing feared is
	## actually being approached) Test covers the whole move even if
	## several feared sources would all be approached by it at once.
	if battle_positions.has(player) and _fear_sources.has(player):
		for m in _fear_sources[player].keys():
			if encounter.is_defeated(m) or not battle_positions.has(m):
				continue
			var before_dist := BattleGrid.footprint_distance(battle_positions[player], player.get_footprint_size(), battle_positions[m], m.get_footprint_size())
			var after_dist := BattleGrid.footprint_distance(square, player.get_footprint_size(), battle_positions[m], m.get_footprint_size())
			if after_dist >= before_dist:
				continue
			var fear_test := TestResolver.resolve_skill_test(player, GameData.skill_db.find_by_name("Cool"), "")
			var extra: Array[String] = []
			if fear_test.success:
				extra.append("%s steels themselves and moves in anyway." % player.character_name)
			else:
				extra.append("%s can't bring themselves to move any closer to %s!" % [player.character_name, m.character_name])
			_show_single_card(player, "Fear: Cool Test", "Challenging (+0)", "ally", fear_test, extra)
			_render_status()
			await _wait_for_continue()
			if not fear_test.success:
				_exit_move_mode()
				_prompt_player_turn(false)
				return
			break   ## one passed Test covers the whole move
	var full_path: Array = _move_confirmed_path()
	if not stopping_at_anchor:
		full_path.append_array(battle_grid.find_path(anchor, square, _occupied_squares_excluding(player), player.get_footprint_size()))
	var steps: int = full_path.size()

	## Captured BEFORE the position actually updates — only the start and
	## end squares matter here, same as movement_remaining above treats
	## waypoints as purely a routing choice, not a series of individually
	## checked legs.
	var engaged_before: Array = _player_engaged_enemies() if not disengaged_this_turn else []

	_update_charge_blocked_targets(battle_positions[player], square)

	var pre_move_pos: Vector2i = battle_positions[player]
	battle_positions[player] = square
	movement_remaining = max(0, movement_remaining - steps)
	## Move and Fire (p.204) — see moved_this_turn's own comment.
	if steps > 0:
		moved_this_turn = true
	## Dungeon hazard tiles (Chasm/Spike trap, per the "New Dungeon
	## building rules" Hazard Table): checked right as the mover's
	## position is finalized, before fog-of-war/exploration hooks run, so
	## a failed Chasm crossing can revert `battle_positions[player]` back
	## to `pre_move_pos` and have everything downstream (vision reveal,
	## camera centering) reflect where the mover ACTUALLY ends up, not
	## where they were headed.
	if not dungeon_state.is_empty():
		await _maybe_trigger_hazard(player, square, pre_move_pos)
	var landed_square: Vector2i = battle_positions[player]
	## Ground Fire visual/mechanics (see _check_ground_fire_crossing()'s
	## own comment): `full_path` already IS the exact list of squares
	## just entered by this move (find_path()'s own convention). Trimmed
	## to wherever the mover actually ended up in the rare case a Chasm
	## above cut the move short of `square` -- everything past that
	## point was never actually reached, so it shouldn't count as
	## crossed either.
	var traveled_this_move: Array = full_path
	if landed_square != square:
		var landed_idx: int = full_path.find(landed_square)
		if landed_idx != -1:
			traveled_this_move = full_path.slice(0, landed_idx + 1)
	_check_ground_fire_crossing(player, traveled_this_move)
	## Exploration mode (see the big section above _exit_tree()): every
	## committed move on the dungeon tile grid reveals fog-of-war around
	## the mover's new square and checks for wandering monsters — see
	## _handle_exploration_move_arrival(). A no-op for a plain (non-
	## dungeon) combat encounter, where dungeon_state is always empty.
	## Per the real bug fix on _update_dungeon_visibility()'s own comment:
	## vision must keep updating on every dungeon move even once
	## _exploration_mode has flipped false (monsters encountered, real
	## combat under way) — only the exploration-only extras (wandering-
	## monster checks) stay gated on _exploration_mode itself.
	if _exploration_mode:
		_handle_exploration_move_arrival(landed_square)
	elif not dungeon_state.is_empty():
		_update_dungeon_visibility(landed_square)
	_exit_move_mode()
	_render_status()
	## "cropped viewport centered on the party" — re-center the grid view
	## on whoever just moved so the party never has to manually pan
	## around the dungeon, in combat or out of it, the way a normal
	## (much smaller, non-dungeon) battle map never needed to.
	if not dungeon_state.is_empty() and grid_view != null:
		grid_view.center_on(landed_square)

	## Frightening's own mirror of the Fear gate just above: any monster
	## that fears the player (via _monster_fear_sources — see
	## _apply_reverse_fear_approach_checks' own comment) reacts to the
	## player closing in on IT, rather than the player's own move being
	## blocked the way it is above when the fear runs the other way.
	await _apply_reverse_fear_approach_checks(pre_move_pos, square)

	for m in engaged_before:
		if encounter.is_defeated(m) or BattleGrid.footprint_distance(battle_positions[player], player.get_footprint_size(), battle_positions[m], m.get_footprint_size()) <= 1:
			continue   ## still adjacent (repositioned within the same melee) — no free attack
		await _resolve_free_attack(m)
		if battle_over:
			return

	if action_used_this_turn and movement_remaining <= 0:
		_next_turn()
	elif awaiting_player_target:
		_prompt_player_turn(false)

## Resolves one Flee free attack (Up in Arms, p.140) from `attacker`
## against the player — see _try_commit_move's own comment for when this
## triggers. Unopposed, like a ranged attack (p.158): success alone
## determines a hit, since the player has no Reaction available to
## contest it — see resolve_free_melee_attack for the +20-to-hit/
## Advantage-gain side of the rule; the Cool Test below is the other
## half: "If you are hit... you must enact a Challenging (+0) Cool
## Test: if failed, gain a Broken Condition, and a further +1 Broken
## condition per SL below 0" — same stacking formula
## _check_fear_and_terror already uses for Terror.
func _resolve_free_attack(attacker: Character) -> void:
	if encounter.is_defeated(attacker) or player.wounds_current <= 0:
		return
	var weapon: WeaponDefinition = weapons.get(attacker)
	if weapon == null or weapon.is_ranged:
		return   ## only a melee threat can punish leaving its melee range
	melee_has_begun = true
	var result := CombatResolver.resolve_free_melee_attack(attacker, player, weapon, encounter.advantage_pool, 0, -1, encounter.get_living(player.allegiance))
	_add_notice("[b]%s[/b] moves away from melee without Disengaging — [b]%s[/b] gets a free, undefended attack!" % [player.character_name, attacker.character_name])
	_show_attack_cards(attacker, player, weapon.weapon_name, result)
	_render_status()
	await _wait_for_continue()
	if result.caused_critical_wound:
		await _handle_critical_wound_on_player(result)
		await _wait_for_continue()
	_apply_fumble_effects(attacker, weapon, result.fumble)

	if result.hit and not battle_over and player.wounds_current > 0:
		var cool_test := TestResolver.resolve_skill_test(player, GameData.skill_db.find_by_name("Cool"), "")
		var extra: Array[String] = []
		if cool_test.success:
			extra.append("%s keeps their nerve." % player.character_name)
		else:
			var broken_stacks: int = 1 + max(0, -cool_test.success_levels)
			player.add_condition("Broken", broken_stacks)
			extra.append("%s panics as they flee — %d Broken Condition(s)!" % [player.character_name, broken_stacks])
		_show_single_card(player, "Flee: Cool Test", "Challenging (+0)", "ally", cool_test, extra)
		_render_status()
		await _wait_for_continue()

## Mirror of _resolve_free_attack, from the other side of the same
## rule. Per the request ("enemy should suffer the same penalty from
## disengaging as player"): monsters previously paid no price at all
## for walking out of an ally's melee range — only the player-vs-
## monster direction above ever triggered a Flee free attack. This
## resolves the same Up in Arms p.140 free attack, but with `ally`
## (whoever was already engaging `monster`) as the one throwing the
## free, undefended strike, and `monster` as the one who broke away
## without Disengaging (monsters have no Disengage Action of their own
## to spend here — see _monster_should_pursue_new_target for how
## reluctant they now are to ever trigger this at all, rather than
## giving them a way to pay for and avoid it like the player has).
## Structurally identical to _resolve_free_attack otherwise: unopposed,
## +20-to-hit for the ally, and the same Cool Test half of the rule —
## just rolled by the fleeing monster instead of the fleeing player —
## for a Broken Condition on a hit. Critical Wound / kill / fumble
## handling is routed through the same monster-side helpers a normal
## attack on a monster already uses (_check_for_kill_xp,
## _apply_critical_wound_to_monster), not the player-side ones.
func _resolve_monster_free_attack(ally: Character, monster: Character) -> void:
	if encounter.is_defeated(monster) or ally.wounds_current <= 0:
		return
	var weapon: WeaponDefinition = weapons.get(ally)
	if weapon == null or weapon.is_ranged:
		return   ## only a melee threat can punish leaving its melee range
	melee_has_begun = true
	var result := CombatResolver.resolve_free_melee_attack(ally, monster, weapon, encounter.advantage_pool, 0, -1, encounter.get_living(monster.allegiance))
	_add_notice("[b]%s[/b] breaks off from melee without Disengaging — [b]%s[/b] gets a free, undefended attack!" % [monster.character_name, ally.character_name])
	_show_attack_cards(ally, monster, weapon.weapon_name, result)
	_render_status()
	await _wait_for_continue()
	## _check_for_kill_xp -> _generate_loot attributes any loot to the
	## shared `player` variable (same simplification every other kill
	## already relies on — see that function's own comment) — pointed
	## at `ally` here so a kill landed by THIS free attack credits the
	## character who actually swung, not whoever `player` was last left
	## pointing at from an earlier, unrelated turn.
	player = ally
	_check_for_kill_xp(monster)
	if result.caused_critical_wound:
		_apply_critical_wound_to_monster(result, monster)
	_apply_fumble_effects(ally, weapon, result.fumble)

	if result.hit and not battle_over and monster.wounds_current > 0:
		var cool_test := TestResolver.resolve_skill_test(monster, GameData.skill_db.find_by_name("Cool"), "")
		var extra: Array[String] = []
		if cool_test.success:
			extra.append("%s keeps its nerve." % monster.character_name)
		else:
			var broken_stacks: int = 1 + max(0, -cool_test.success_levels)
			monster.add_condition("Broken", broken_stacks)
			extra.append("%s panics as it flees — %d Broken Condition(s)!" % [monster.character_name, broken_stacks])
		_show_single_card(monster, "Flee: Cool Test", "Challenging (+0)", "adversary", cool_test, extra)
		_render_status()
		await _wait_for_continue()

## Sprint (core rulebook Movement rules): once movement_remaining is
## fully spent, the player can commit their Action itself to Sprint
## instead of Attacking/Casting/etc — an Average (+20) Athletics Test.
## On success, it grants Run distance + Success Levels in extra squares
## of movement this turn (on top of whatever's already been moved),
## which the player then spends exactly like a normal Move — the
## highlighted range appears immediately and committing that move ends
## the turn, since the Action (Sprint itself) was already spent getting
## it. On failure, no bonus movement, and the turn simply ends like any
## other resolved Action.
func _on_sprint() -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	## See _is_players_own_turn()'s own comment: Sprint spends the Action
	## itself and grants real bonus movement, so it needs the exact same
	## guard Move itself now has — nothing here should ever be able to
	## fire for someone other than the genuine current combatant.
	if not _is_players_own_turn():
		_clear(target_container)
		_clear(side_actions_container)
		return
	sprint_used_this_turn = true
	action_used_this_turn = true
	awaiting_player_target = false
	_clear(target_container)
	var skill: SkillDefinition = GameData.skill_db.find_by_name("Athletics")
	var effort := _consume_effort_bonus()
	var modifier: int = 20 + effort[0]
	var modifier_breakdown: Array = [{"name": "Sprint (Average)", "amount": 20}]
	modifier_breakdown.append_array(effort[1])

	var test := TestResolver.resolve_skill_test(player, skill, "", modifier, modifier_breakdown)
	_apply_sprint_outcome(test, false)
	_render_status()

	var choice := await _offer_fortune_spend(test)
	while choice == "reroll" or choice == "sl":
		if choice == "reroll":
			test = TestResolver.resolve_skill_test(player, skill, "", modifier, modifier_breakdown)
		_apply_sprint_outcome(test, true)
		_render_status()
		choice = await _offer_fortune_spend(test)

	if movement_remaining > 0 and battle_grid != null and battle_positions.has(player):
		var reachable: Array = battle_grid.reachable_squares(battle_positions[player], movement_remaining, _occupied_squares_excluding(player), player.get_footprint_size())
		if not reachable.is_empty():
			sprint_finish_pending = true
			move_mode_active = true
			_move_waypoints = []
			_move_mode_reachable = reachable
			grid_view.highlight_squares(reachable)
			_add_notice("%s: click within the highlighted range to sprint there." % player.character_name)
			## Real bug fix: this branch used to just highlight the map
			## and return, without ever rebuilding the turn action menu
			## the way _enter_move_mode() does right after the same
			## "highlight then click" setup — awaiting_player_target had
			## already been set false at the top of this function (and
			## the whole menu container cleared, both by this function's
			## own opening _clear(target_container) and by whatever
			## _render_turn_action_menu() call last ran), so the button
			## row was left permanently empty with no way to reach
			## Move/End Turn/etc. again until the map's highlighted
			## squares happened to be clicked exactly right. Matches
			## _enter_move_mode()'s own call here exactly — is_fresh_turn
			## =false preserves every bit of turn state just set above
			## (move_mode_active, sprint_finish_pending, movement_
			## remaining), it only restores awaiting_player_target and
			## rebuilds the menu (which shows "Cancel Move" for the Move
			## button while move_mode_active is true, same as a normal
			## Move already relies on).
			_prompt_player_turn(false)
			return
	_finish_player_action()

## Per the core rulebook's own Sprint rule (p.157): "you sprint your Run
## movement + SL in yards" — this applies Success Levels whether the
## Test succeeds or fails, per the book's own worked example (a
## character who rolls -2 SL still sprints Run-2 yards, not zero
## outright). A real rules bug fix: this used to gate the whole bonus
## behind `test.success`, zeroing out movement entirely on any failed
## Test instead of just applying its (negative) SL like the book says.
## Floored at 0 — a bad enough failure means no extra distance, not a
## negative one.
func _apply_sprint_outcome(test: TestResolver.TestResult, merge: bool) -> void:
	var extra: Array[String] = []
	## Stride (p.343) applies to the Run-movement portion of the sprint
	## (player.get_movement() * 2) before the Test's own SL are added —
	## the SL bonus is a Skill-check result, not itself "Run Movement".
	var run_pool: int = int(round(player.get_movement() * 2 * player.get_stride_multiplier()))
	var bonus_squares: int = max(0, run_pool + test.success_levels)
	movement_remaining = bonus_squares
	if bonus_squares > 0:
		extra.append("+%d squares of movement this turn!" % bonus_squares)
	else:
		extra.append("Fails to find any extra burst of speed.")
	_show_single_card(player, "Athletics", "Sprint", "ally", test, extra, merge)

## Renders a genuine "you cannot act" turn for Unconscious/Stunned/
## Surprised — Master Condition List (p.167-169) — instead of the
## normal action menu. Space (the project's main accept convention —
## see the button's own "[Space]" label), Enter, or clicking the button
## itself all auto-pass the turn identically. Uses its own dedicated
## awaiting_incapacitated_turn flag rather than the overloaded
## awaiting_player_target — reusing that flag caused a real,
## previously-fixed bug where the primary hotkey fell through to the
## wrong branch and re-triggered an action; the same risk applies here.
func _prompt_incapacitated_turn() -> void:
	var message := ""
	if player.conditions.has("Unconscious"):
		message = "%s is Unconscious and can do nothing this turn." % player.character_name
	elif player.conditions.has("Stunned"):
		message = "%s is Stunned and cannot take an Action this turn." % player.character_name
	elif player.conditions.has("Surprised"):
		message = "%s is Surprised and cannot Move or Act this turn." % player.character_name
	## Flight (p.343) — see _ground_flying_creature_if_incapacitated's
	## own comment. Covers the rare case of a player-controlled flying
	## ally (e.g. a Pegasus) rather than only monster-side Flight.
	_ground_flying_creature_if_incapacitated(player)
	var label := Label.new()
	label.text = message
	label.add_theme_color_override("font_color", Color(0.85, 0.6, 0.55))
	label.add_theme_font_size_override("font_size", 10)
	target_container.add_child(label)
	## Cordelia's Apothecary spec's own critical fix: a genuinely Stunned
	## character's turn is routed ENTIRELY here — the normal skills_row
	## button (see _prompt_player_turn()'s own build) is never actually
	## reachable in the one situation Salwort exists for. Offered here
	## instead, but ONLY while genuinely Stunned and only if carried
	## ("hide these until they are needed") — using it cures Stunned and
	## re-enters a real turn via _prompt_player_turn(true) afterward,
	## rather than auto-passing straight to _next_turn() like every
	## other incapacitated turn does.
	_used_salwort_this_incapacitated_turn = false
	if player.conditions.has("Stunned") and player.inventory.has(SALWORT):
		var salwort_btn := _make_button()
		salwort_btn.text = "Sniff Salwort (Free) — cures Stunned"
		salwort_btn.pressed.connect(func():
			_used_salwort_this_incapacitated_turn = true
			awaiting_incapacitated_turn = false
		)
		target_container.add_child(salwort_btn)
	var pass_btn := _make_button()
	pass_btn.text = "Continue  [Space]"
	pass_btn.pressed.connect(func():
		awaiting_incapacitated_turn = false
	)
	target_container.add_child(pass_btn)
	_active_primary_hotkey_button = pass_btn
	_auto_focus_default_button()
	awaiting_player_target = false   ## not a real target-selection turn — nothing else should treat this as one
	awaiting_incapacitated_turn = true
	while awaiting_incapacitated_turn:
		await get_tree().process_frame
	if _used_salwort_this_incapacitated_turn:
		_on_use_salwort()
		return
	## Surprised is specifically removed "after the first attempt to
	## attack you" or "at the end of each Round" (p.168) — since this
	## incapacitated turn already represents the player's own turn
	## having come and gone, it's a reasonable point to also drop
	## Surprised here rather than waiting purely for the Round-end tick.
	if player.conditions.has("Surprised"):
		player.conditions.erase("Surprised")
	_next_turn()

## Broken (p.168): "You must use your Move and Action to flee from
## combat and attempt to hide." Mirrors _prompt_incapacitated_turn()'s
## own auto-resolved-turn shape (no real choice for the player to make
## here per the book's own "must" wording) but, unlike a genuinely
## incapacitated turn, this one actually moves the character — away
## from the nearest threat, with their own full Move (_advance_away_from,
## the same helper Bestial/Broken's own monster-side forced Flee
## reuses) — before narrating what happened and handing the turn on.
## The character's own Action this Turn is spent "hiding," a flavour-only
## step in this project beyond the movement itself — see
## _is_hidden_from_enemies() for hiding's one real mechanical payoff
## (Broken's own out-of-line-of-sight auto-recovery at Round end).
func _prompt_broken_turn() -> void:
	_clear(target_container)
	_clear(side_actions_container)
	var engaged_before: Array = _player_engaged_enemies()
	var threats: Array[Character] = encounter.get_living("adversary" if player.allegiance == "ally" else "ally")
	var moved := _advance_away_from(player, threats, player.get_movement())
	var message: String
	if moved > 0:
		message = "%s is Broken — panicking, they flee toward cover instead of fighting." % player.character_name
	else:
		message = "%s is Broken and tries to flee, but there's nowhere left to run — they cower in place instead." % player.character_name
	_render_status()
	## Same Flee free attack (Up in Arms p.140) a normal Move-triggered
	## Disengage already pays elsewhere in this file — a forced Broken
	## flee is still leaving melee without Disengaging, so there's no
	## reason it should be exempt from the same penalty.
	for m in engaged_before:
		if encounter.is_defeated(m) or battle_over:
			continue
		if not battle_positions.has(player) or BattleGrid.footprint_distance(battle_positions[player], player.get_footprint_size(), battle_positions[m], m.get_footprint_size()) <= 1:
			continue
		await _resolve_free_attack(m)
		if battle_over or player.wounds_current <= 0:
			break
	var label := Label.new()
	label.text = message
	label.add_theme_color_override("font_color", Color(0.85, 0.6, 0.55))
	label.add_theme_font_size_override("font_size", 10)
	target_container.add_child(label)
	var pass_btn := _make_button()
	pass_btn.text = "Continue  [Space]"
	pass_btn.pressed.connect(func():
		awaiting_incapacitated_turn = false
	)
	target_container.add_child(pass_btn)
	_active_primary_hotkey_button = pass_btn
	_auto_focus_default_button()
	awaiting_player_target = false
	awaiting_incapacitated_turn = true
	while awaiting_incapacitated_turn:
		await get_tree().process_frame
	_next_turn()

func _section_label(text: String) -> Label:
	var l := Label.new()
	l.text = text
	l.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
	return l

## A Button with a font size ~20% larger than this screen's own
## previous size (13 → 16), per the request. Buttons auto-size to
## their text plus padding, so this also genuinely grows the button's
## own footprint, not just its label.
##
## `font_size` is optional so the 3-column action menu (see
## _make_action_column/_prompt_player_turn) can request a slightly
## smaller size to keep each column compact, without touching the
## ~40 other call sites elsewhere in this file that still want the
## normal 16.
func _make_button(font_size: int = 12) -> Button:
	var btn := Button.new()
	btn.add_theme_font_size_override("font_size", font_size)
	return btn

## First focusable, enabled Button/OptionButton found (depth-first)
## under `node`, visible or not — used only to give WASD keyboard
## navigation somewhere to start from when nothing has focus yet (see
## _unhandled_input's own WASD fallback block). Skips disabled buttons
## (see _refresh_focus_for_disabled_buttons) so the very first WASD
## press can't land on a greyed-out one.
func _find_first_focusable(node: Node) -> Control:
	if (node is Button or node is OptionButton) and (node as Control).visible and not (node as BaseButton).disabled:
		return node
	for child in node.get_children():
		var found := _find_first_focusable(child)
		if found != null:
			return found
	return null

## Per the request ("skip past grayed out buttons"): a disabled button
## still defaults to focus_mode FOCUS_ALL in Godot, so Godot's own
## built-in WASD/arrow-key focus-neighbor search would happily land on
## one and let Enter "activate" a control that visibly can't be used.
## Setting a disabled button's focus_mode to FOCUS_NONE removes it from
## that search entirely (Godot only considers controls with a
## non-NONE focus_mode), so navigation jumps straight past it to the
## next real, usable button — no changes needed to the navigation
## logic itself, since it's all Godot's own built-in behavior. Swept
## over a whole subtree in one pass (rather than touched at each of
## the many individual `.disabled = ...` call sites scattered through
## the action-menu building code) so nothing can be missed; called
## once at the end of each function that (re)builds a button menu.
func _refresh_focus_for_disabled_buttons(node: Node) -> void:
	if node is BaseButton:
		var btn := node as BaseButton
		btn.focus_mode = Control.FOCUS_NONE if btn.disabled else Control.FOCUS_ALL
	for child in node.get_children():
		_refresh_focus_for_disabled_buttons(child)

## Per the follow-up request ("place the WASD default focus
## automatically, don't wait for WASD input first"): every function
## that (re)builds a button menu during combat now calls this at the
## end, right after _refresh_focus_for_disabled_buttons — instead of
## only granting keyboard focus lazily on the player's first WASD
## press (see _unhandled_input's own fallback block, still kept as a
## safety net for any menu this helper doesn't cover). Prefers
## whichever button currently carries the "[Enter]" hotkey hint
## (_active_primary_hotkey_button — Attack, Charge, Parry, Continue,
## etc., same as the WASD-fallback default), falling back to the first
## focusable button when there isn't one (e.g. mid-Move).
##
## Deliberately does NOT check "does something already have focus"
## first and skip if so: every call site here follows a full
## _clear(target_container)-and-rebuild, which queue_free()s the old
## buttons without releasing their focus until later in the same
## frame (Control only releases focus once it actually exits the
## tree) — checking gui_get_focus_owner() at this point would often
## see a stale, about-to-vanish button and wrongly skip focusing the
## new menu's real default. Since a full rebuild always replaces every
## button wholesale, there's no old focus worth preserving here
## anyway — always (re)claiming focus on the fresh menu's own default
## button is the correct behaviour.
func _auto_focus_default_button() -> void:
	if get_viewport() == null:
		return
	var target: Control = null
	if is_instance_valid(_active_primary_hotkey_button) and _active_primary_hotkey_button.visible and not _active_primary_hotkey_button.disabled:
		target = _active_primary_hotkey_button
	else:
		target = _find_first_focusable(target_container)
	if target != null:
		target.grab_focus()

## Builds one column of the 3-column player-turn action menu (see
## _prompt_player_turn). Returns the inner HFlowContainer that
## callers should add buttons/labels to — the header Label and the
## flow container both live in a VBoxContainer wrapper, retrievable
## via `flow.get_parent()`, which is what actually gets added to the
## 3-column HBoxContainer. Per the request ("split the window into 3
## similar sized parts... resize buttons if you need too"): each
## column is given equal stretch so the 3 parts stay similarly sized
## regardless of content, and buttons within columns use a smaller
## font (see ACTION_COLUMN_FONT_SIZE) to reduce how much each column
## wraps in its own, narrower share of the width.
const ACTION_COLUMN_FONT_SIZE := 9
func _make_action_column(header_text: String) -> HFlowContainer:
	var wrapper := VBoxContainer.new()
	wrapper.add_theme_constant_override("separation", 4)
	wrapper.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	wrapper.size_flags_stretch_ratio = 1.0
	var header := Label.new()
	header.text = header_text
	header.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
	header.add_theme_font_size_override("font_size", 9)
	wrapper.add_child(header)
	var flow := HFlowContainer.new()
	flow.add_theme_constant_override("separation", 6)
	wrapper.add_child(flow)
	return flow

## Rebuilds the same empty 3-column skeleton _prompt_player_turn() uses
## for the normal action menu (same headers, same widths), but leaves
## every column empty except the one matching `column_header` — used by
## a choice prompt that needs to take over part of the action-menu area
## (Overcast's own picker, the Frenzy/Furious Assault bonus-action
## choice, the Deathblow chain-attack choice) without blanking the OTHER
## two columns' worth of space, the way _clear(target_container) +
## building straight into it used to. Per the request ("keep it in the
## 3 sections"): stays a 3-way split rather than taking over the full
## width — the "no need to scroll" goal is instead met by keeping this
## column's own content compact (see each caller's own font-size/
## spacing choices). Returns the HFlowContainer for the requested
## column; callers add their own content into that, exactly as they
## would have into target_container directly before this helper existed.
func _build_scoped_column(column_header: String) -> HFlowContainer:
	_clear(target_container)
	var columns_row := HBoxContainer.new()
	columns_row.add_theme_constant_override("separation", 10)
	var result: HFlowContainer = null
	var headers := ["Movement / Free Actions", "Attack / Defence", "Magic / Prayers"]
	for i in range(headers.size()):
		if i > 0:
			columns_row.add_child(VSeparator.new())
		var col := _make_action_column(headers[i])
		if headers[i] == column_header:
			result = col
		columns_row.add_child(col.get_parent())
	target_container.add_child(columns_row)
	return result

func _on_defensive_stance() -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	defensive_stance_active = true
	_add_notice("[b]%s takes a Defensive Stance[/b] — +20 to Parry/Dodge until their next turn." % player.character_name)
	_render_status()
	await _wait_for_continue_after_own_action()
	_finish_player_action()

## Every distinct WeaponDefinition-backed item name in `who`'s inventory
## other than `exclude_name` (the weapon already in that slot) — the
## candidate list for a free-action weapon switch. Deduped so a stack
## of e.g. 3 Swords only offers "Sword" once.
func _switchable_weapons(who: Character, exclude_name: String) -> Array[String]:
	var names: Array[String] = []
	## Per the follow-up request ("allow switch to Unarmed on both
	## hands"): always offered regardless of inventory — every
	## character can always fight bare-handed, whether or not "Unarmed"
	## itself ever sits in their inventory list (it doesn't; it's a
	## virtual fallback weapon, not a real carried item — see
	## _resolve_weapon/_resolve_offhand_weapon's own use of it).
	if exclude_name != "Unarmed":
		names.append("Unarmed")
	for item_name in who.inventory:
		if item_name == exclude_name or names.has(item_name):
			continue
		if GameData.weapon_db.find_by_name(item_name) != null:
			names.append(item_name)
			continue
		## Per the request ("allow light sources in inventory to be
		## equipped by character with the switch weapon button"): a
		## Lantern/Storm Lantern/Davrich Lamp/Candle sits in
		## equipped_weapon/equipped_offhand exactly like a real weapon
		## (see Character.get_equipped_light_item()), so it belongs in
		## this same switch list too, not just worn passively from
		## before the fight started — see _apply_main_weapon_switch()/
		## _apply_offhand_weapon_switch()'s own _auto_light_switched_
		## item() call for what happens when one of these is picked.
		var item_def: ItemDefinition = GameData.item_db.find_by_name(item_name)
		if item_def != null and item_def.light_radius_tiles > 0:
			names.append(item_name)
	return names

## Lights an item just switched into equipped_weapon/equipped_offhand,
## per the request — switching a Lantern in mid-combat should actually
## light it, not just leave it equipped-but-dark until some other
## toggle nobody has in the middle of a fight. Mirrors Overworld's own
## _toggle_light_source() lighting logic (oil auto-reload from
## inventory / self-fuel from stock) but only ever the "turn it on"
## half — there's no equivalent of the L hotkey's on/low/off cycle
## available mid-combat. Returns a short trailing note for the switch
## notice ("" for anything that isn't a light source at all).
func _auto_light_switched_item(c: Character, item_name: String) -> String:
	var item: ItemDefinition = GameData.item_db.find_by_name(item_name)
	if item == null or item.light_radius_tiles <= 0:
		return ""
	if item.light_requires_oil and c.light_fuel_minutes <= 0.0:
		if c.inventory.has("Lamp Oil"):
			c.inventory.erase("Lamp Oil")
			c.light_fuel_minutes = Character.LAMP_OIL_MINUTES
		else:
			return " It's out of oil and stays unlit."
	elif item.light_self_fuel_minutes > 0.0 and c.light_fuel_minutes <= 0.0:
		if not c.inventory.has(item.item_name):
			return ""   ## shouldn't happen — the switch list only offers items actually in inventory
		c.light_fuel_minutes = item.light_self_fuel_minutes
	c.light_mode = "on"
	return " Lit."

## Handles the "Light/Turn Up/Extinguish <item>" Free Action button built
## in _render_turn_action_menu() above. Mirrors Overworld._toggle_light_
## source()'s own off -> on -> low -> off cycle (skipping "low" for a
## source with no dedicated low-flame radius) and its oil/self-fuel
## reload rules, but scoped to whichever Character is actually taking
## this turn (`player`) rather than always GameState.player_character —
## any ally's turn can toggle their own held light, not just the lead
## Wanderer's. Fog-of-war has to be recomputed right away whenever the
## party is on a dungeon tile grid at all (_reveal_around_party()
## re-reads each member's own _member_light_radius() fresh — see that
## function's own comment) — not just while _exploration_mode, since
## lighting or extinguishing a lantern mid-fight (see
## _update_dungeon_visibility()'s own comment for why vision has to
## keep tracking through combat too) can change what's currently
## visible without the player even needing to take a step.
func _on_toggle_light_pressed() -> void:
	if not awaiting_player_target or not pending_defense.is_empty():
		return
	var item := player.get_equipped_light_item()
	if item == null:
		return
	var note := ""
	if player.light_mode == "off":
		if item.light_requires_oil and player.light_fuel_minutes <= 0.0:
			if player.inventory.has("Lamp Oil"):
				player.inventory.erase("Lamp Oil")
				player.light_fuel_minutes = Character.LAMP_OIL_MINUTES
			else:
				_add_notice("[b]Free Action:[/b] %s has no lamp oil left to light the %s." % [player.character_name, item.item_name])
				_prompt_player_turn(false)
				return
		elif item.light_self_fuel_minutes > 0.0 and player.light_fuel_minutes <= 0.0:
			if player.inventory.has(item.item_name):
				player.light_fuel_minutes = item.light_self_fuel_minutes
			else:
				_add_notice("[b]Free Action:[/b] %s has no more %s left to light." % [player.character_name, item.item_name])
				_prompt_player_turn(false)
				return
		player.light_mode = "on"
		note = "%s lights the %s." % [player.character_name, item.item_name]
	elif player.light_mode == "on":
		if item.light_radius_tiles_low > 0:
			player.light_mode = "low"
			note = "%s turns the %s down to a low flame." % [player.character_name, item.item_name]
		else:
			player.light_mode = "off"
			note = "%s extinguishes the %s." % [player.character_name, item.item_name]
	else:   ## "low"
		player.light_mode = "off"
		note = "%s extinguishes the %s." % [player.character_name, item.item_name]
	_add_notice("[b]Free Action:[/b] %s" % note)
	if not dungeon_state.is_empty():
		_reveal_around_party()
	_render_status()
	_prompt_player_turn(false)

## Popup menu of switch-target weapon names, anchored under whichever
## button opened it — same pattern as character_menu_screen.gd's own
## _open_send_menu. `apply_callback` is called with the chosen weapon
## name once the player picks one.
func _open_weapon_switch_menu(names: Array[String], anchor_button: Button, apply_callback: Callable) -> void:
	var menu := PopupMenu.new()
	add_child(menu)
	for n in names:
		menu.add_item(n)
	menu.id_pressed.connect(func(id: int): apply_callback.call(names[id]))
	menu.popup_hide.connect(func(): menu.queue_free())
	var pos: Vector2 = anchor_button.global_position + Vector2(0, anchor_button.size.y)
	menu.popup(Rect2i(Vector2i(pos), Vector2i(180, 0)))

## Applies a main-hand weapon switch. Critically re-resolves the
## `weapons` cache (populated once at encounter start — see
## _resolve_weapon) so the rest of the encounter's attack/UI code
## actually sees the new weapon instead of the stale one; equipping a
## two-handed weapon also clears the off-hand, same rule the Equipment
## tab enforces.
func _apply_main_weapon_switch(item_name: String) -> void:
	if not awaiting_player_target or not pending_defense.is_empty() or main_weapon_switched_this_turn:
		return
	## A pending ranged-target arrow set was computed for whichever
	## weapon was equipped a moment ago — switching main-hand mid-
	## targeting would leave those arrows (and the eventual roll) stale,
	## so just cancel targeting rather than risk that mismatch. The
	## player can re-open it with the new weapon from a fresh Attack
	## click.
	if ranged_target_mode_active:
		_exit_ranged_target_mode()
	player.equipped_weapon = item_name
	var w: WeaponDefinition = GameData.weapon_db.find_by_name(item_name)
	if w != null and w.is_two_handed:
		player.equipped_offhand = ""
	weapons[player] = _resolve_weapon(player)
	main_weapon_switched_this_turn = true
	var light_note := _auto_light_switched_item(player, item_name)
	_add_notice("[b]Free Action:[/b] %s switches their main-hand weapon to the %s.%s" % [player.character_name, item_name, light_note])
	_render_status()
	_prompt_player_turn(false)

## Applies an off-hand weapon switch. No `weapons` cache refresh needed
## here — get_offhand_weapon() is already read live at attack time.
func _apply_offhand_weapon_switch(item_name: String) -> void:
	if not awaiting_player_target or not pending_defense.is_empty() or offhand_weapon_switched_this_turn or player.main_weapon_is_two_handed():
		return
	player.equipped_offhand = item_name
	offhand_weapon_switched_this_turn = true
	var light_note := _auto_light_switched_item(player, item_name)
	_add_notice("[b]Free Action:[/b] %s switches their off-hand to the %s.%s" % [player.character_name, item_name, light_note])
	_render_status()
	_prompt_player_turn(false)

## Applies a mid-combat ammo switch for `weapon` — per the "allow
## switching ammo during combat if available" request. Sets Character.
## active_ammo (see get_active_ammo_item/consume_ammo_for), which takes
## effect on the very next shot fired with this weapon: its Range/
## Damage/Qualities all read off whichever ammo is active at the moment
## of firing, not at the moment it was selected. A Free Action, same
## once-per-Turn-per-weapon cap as _apply_main_weapon_switch/_apply_
## offhand_weapon_switch above (ammo_switched_this_turn).
func _apply_ammo_switch(weapon: WeaponDefinition, ammo_name: String) -> void:
	if weapon == null or not awaiting_player_target or not pending_defense.is_empty() or ammo_switched_this_turn.get(weapon.weapon_name, false):
		return
	player.active_ammo[weapon.weapon_name] = ammo_name
	ammo_switched_this_turn[weapon.weapon_name] = true
	_add_notice("[b]Free Action:[/b] %s loads %s into their %s." % [player.character_name, ammo_name, weapon.weapon_name])
	_render_status()
	_prompt_player_turn(false)

func _on_toggle_dual_wield() -> void:
	if not awaiting_player_target or not pending_defense.is_empty():
		return
	dual_wield_active = not dual_wield_active
	GameState.dual_wield_toggle_remembered = dual_wield_active
	_prompt_player_turn(false)

func _on_toggle_strike_to_stun() -> void:
	if not awaiting_player_target or not pending_defense.is_empty():
		return
	strike_to_stun_active = not strike_to_stun_active
	_prompt_player_turn(false)

## Frightening (p.190): a Free Action toggle — flicking it ON immediately
## puts every living, not-yet-tested monster present through a Fear
## Psychology Test against the player's own Frightening rank (see
## _check_reverse_fear_from_frightening()'s own comment for why this is
## the one-shot moment the player's copy gets checked, unlike a passive
## ally's, which is always assumed active from the start of the fight).
## Flicking it back OFF doesn't undo any monster already marked Subject
## to Fear — same as the book's own Fear Rating, once triggered it takes
## an Extended Test to shake off (_tick_fear_extended_tests()), not
## simply "the source stopped trying."
func _on_toggle_frightening() -> void:
	if not awaiting_player_target or not pending_defense.is_empty():
		return
	frightening_active = not frightening_active
	if frightening_active:
		await _check_reverse_fear_from_frightening([player])
	_prompt_player_turn(false)

## Frenzy (p.190): a Willpower Test to work yourself into it. Implements
## the Free Action bonus attack each Round (see _on_player_attack) and
## +1 Strength Bonus (see Character.get_characteristic_bonus) — the
## forced pursue-only/attack-only behaviour and the natural "ends when
## all enemies pacified" tracking aren't modelled (this project doesn't
## track battlefield position or line-of-sight pacification state), a
## documented simplification. Ending Frenzy and gaining the resulting
## Fatigued Condition is handled by Battle Rage below, for characters
## who have that Talent; without it, Frenzy simply lasts the rest of
## the encounter.
func _on_enter_frenzy() -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var test := TestResolver.resolve_characteristic_test(player, "willpower")
	if test.success:
		player.add_condition("Frenzy")
		_add_notice("[b]%s works themselves into a Frenzy![/b] +1 Strength Bonus and a Free Action bonus attack each Round for the rest of this fight." % player.character_name)
	else:
		_add_notice("%s tries to work themselves into a Frenzy, and fails." % player.character_name)
	_render_status()
	await _wait_for_continue_after_own_action()
	_finish_player_action()

## Battle Rage (p.132): "You can end your Frenzy with a successful Cool
## Test at the end of the round." On success, Frenzy ends and — per the
## base Frenzy rule itself ("After your Frenzy is over you immediately
## receive a Fatigued condition") — a Fatigued Condition is applied.
func _on_end_frenzy_battle_rage() -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var test := TestResolver.resolve_skill_test(player, GameData.skill_db.find_by_name("Cool"), "")
	if test.success:
		player.remove_condition("Frenzy")
		player.add_condition("Fatigued")
		_add_notice("[b]%s reins in their Frenzy.[/b] Fatigued from the exertion." % player.character_name)
	else:
		_add_notice("%s tries to master their Frenzy, but it still burns too hot." % player.character_name)
	_render_status()
	await _wait_for_continue_after_own_action()
	_finish_player_action()

## Hatred (p.190): a Psychology Test (Cool Test, GM-set Difficulty —
## Challenging here) to become Subject to Hatred. While active: +1 SL
## on combat Tests against the hated group (see _on_player_attack's
## conditional scope) and immunity to Fear/Intimidate (not Terror) —
## see _apply_and_describe_fear_terror. Doesn't model the book's own
## "must immediately attempt to destroy" forced-action requirement, or
## the specific group targeting (this project doesn't track enemy
## faction tags), a documented simplification.
func _on_succumb_to_hatred() -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var test := TestResolver.resolve_skill_test(player, GameData.skill_db.find_by_name("Cool"), "")
	if test.success:
		player.add_condition("Hatred")
		_add_notice("[b]%s succumbs to Hatred![/b] +1 SL on combat Tests against this foe, and immune to Fear/Intimidate from it, for the rest of this fight." % player.character_name)
	else:
		_add_notice("%s fights down the urge to give in to Hatred, for now." % player.character_name)
	_render_status()
	await _wait_for_continue_after_own_action()
	_finish_player_action()

## --- Attack (melee or ranged, per equipped weapon) -----------------------

## `is_offhand`, per the follow-up request ("it should be possible to
## initiate a Dual wield attack both both main hand or off hand"): true
## when this whole attack was launched from the new Off: button rather
## than the main Attack button — the strike `weapon_override` describes
## is then the OFF-hand weapon striking FIRST, so Dual Wielder's own
## follow-up strike below needs to swing the MAIN hand instead of its
## usual off-hand default. Doesn't change anything else about how the
## attack itself resolves — CombatResolver has no notion of "which
## hand," only which WeaponDefinition is actually swinging.
func _on_player_attack(target: Character, weapon_override: WeaponDefinition = null, is_charge: bool = false, is_offhand: bool = false, forced_hit_location: String = "") -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	## See _is_players_own_turn()'s own comment (same "player controlling
	## monster" bug class this whole file keeps re-fighting) — a stale
	## Attack button must never be able to fire for someone other than the
	## genuine current combatant.
	if not _is_players_own_turn():
		_clear(target_container)
		_clear(side_actions_container)
		return
	## Per the request ("allow targeting of allies, but don't allow
	## offensive actions against them"): a defense-in-depth guard —
	## every real caller already filters `target` to a living adversary
	## before ever reaching here (see _render_turn_action_menu's own
	## `target` and the Enter-hotkey default), but this is the one
	## choke point every single Attack path funnels through, so it's
	## the backstop that guarantees an ally can never actually be hit
	## regardless of how `target` got here.
	##
	## Same backstop logic, same choke point, for the newer real bug fix
	## ("player should not be able to target monster they can not see
	## yet with melee (including charge) and ranged attacks") — see
	## _can_see_target()'s own comment. _select_target()/_ensure_valid_
	## target() and _render_turn_action_menu's own `target` derivation
	## already refuse a hidden adversary well before this point, but this
	## is the one place both the melee AND the ranged (via
	## _resolve_ranged_target -> here) attack paths both funnel through.
	if target == null or target.allegiance == "ally" or not _can_see_target(target):
		return
	var weapon_check: WeaponDefinition = weapon_override if weapon_override != null else _weapon_for(player)

	## Phase 1b: melee requires actual adjacency on the battle grid, per
	## the rework's own request. Charge gets a nice-to-have first: it
	## tries to close the distance itself (reusing the same movement
	## helper monsters use to close in) before the adjacency check, so
	## Charging into range still works in one click when there's a clear
	## path; if it still can't get there (blocked, out of movement), the
	## attack is refused with a clear notice rather than resolving from
	## too far away.
	if battle_grid != null and not weapon_check.is_ranged:
		if is_charge:
			## Per the request: Charge requires the target to actually be
			## within charge range — reachable within
			## movement_remaining squares (Charge grants no movement of
			## its own — see _target_in_charge_range) — rather than
			## blindly advancing toward it and only discovering
			## afterward (via the distance check below) that it wasn't
			## close enough, which used to burn the movement and the
			## turn for nothing.
			if not _target_in_charge_range(target):
				_add_notice("%s is too far away to Charge — out of charge range." % target.character_name)
				return
			## Per the follow-up request ("charge does not add
			## movement, only allows the charge bonus to be added to
			## attacks"): the squares actually travelled come straight
			## out of the turn's own remaining Move, exactly like a
			## normal Move would — Charge itself grants nothing extra.
			var squares_moved := _advance_toward(player, target, movement_remaining)
			movement_remaining = max(0, movement_remaining - squares_moved)
			## Move and Fire (p.204) — see moved_this_turn's own comment.
			## Charge is melee-only by definition, but a later Action this
			## same Turn (Act Again) could still fire a ranged weapon after
			## it, so this still needs to be recorded here too.
			if squares_moved > 0:
				moved_this_turn = true
		if BattleGrid.footprint_distance(battle_positions.get(player, Vector2i.ZERO), player.get_footprint_size(), battle_positions.get(target, Vector2i.ZERO), target.get_footprint_size()) > 1:
			_add_notice("%s is too far away to strike in melee — Move or Run closer first." % target.character_name)
			_render_status()
			return

	## Phase 1b: ranged attacks auto-compute a range band from grid
	## distance rather than a manual band selection — Point Blank/Short
	## give a bonus, Long/Extreme a penalty, and beyond Extreme the
	## target simply can't be hit with this weapon at all yet (no
	## positioning fix available here the way Charge fixes melee).
	var range_modifier := 0
	var range_band := BattleGrid.RangeBand.SHORT
	var range_band_active := false
	## Per the follow-up request ("Cover works against Ranged attack if
	## the target is standing behind the obstacle from the line of sight
	## of the attack... light -10/medium -20/hard -30... dont allow to
	## shoot if there is no line of sight"): replaces the old flat -10
	## Soft Cover penalty with a real line-of-sight scan between shooter
	## and target — see BattleGrid.get_ranged_cover(). A genuinely
	## sight-blocking obstacle (a Huge Boulder/Structure) refuses the
	## shot outright rather than just penalizing it.
	var cover_modifier := 0
	var cover_level_label := ""
	if battle_grid != null and weapon_check.is_ranged and battle_positions.has(player) and battle_positions.has(target):
		var dist_yd := BattleGrid.distance_yards(battle_positions[player], battle_positions[target])
		range_band = BattleGrid.get_range_band(dist_yd, player.get_effective_weapon_range(weapon_check))
		## Flight (p.343): "When targeting it, measure horizontal distance
		## as normal, then increase range by 1 step. So, a Long Range shot
		## would become Extreme Range, and if it was at Extreme Range it
		## could not be shot at all." Written as an explicit match rather
		## than arithmetic on the enum (int + 1 then cast back) to avoid
		## any ambiguity about GDScript's enum/int typing — the existing
		## OUT_OF_RANGE check right below already turns "bumped past
		## Extreme" into "can't be shot at all" for free.
		if currently_flying.get(target, false):
			match range_band:
				BattleGrid.RangeBand.POINT_BLANK:
					range_band = BattleGrid.RangeBand.SHORT
				BattleGrid.RangeBand.SHORT:
					range_band = BattleGrid.RangeBand.LONG
				BattleGrid.RangeBand.LONG:
					range_band = BattleGrid.RangeBand.EXTREME
				_:
					range_band = BattleGrid.RangeBand.OUT_OF_RANGE
		if range_band == BattleGrid.RangeBand.OUT_OF_RANGE:
			_add_notice("%s is out of range for your %s (%d yards away)." % [target.character_name, weapon_check.weapon_name, dist_yd])
			return
		range_modifier = BattleGrid.get_range_band_modifier(range_band)
		range_band_active = true
		var cover_info: Dictionary = battle_grid.get_ranged_cover(battle_positions[player], battle_positions[target])
		if cover_info["blocked"]:
			_add_notice("%s has no line of sight to %s — something too big to see past is in the way." % [player.character_name, target.character_name])
			return
		cover_modifier = cover_info["penalty"]
		cover_level_label = String(cover_info["level"]).capitalize()

	## Reload (Flaw, p.299): checked BEFORE the ammo check below — a
	## weapon mid-reload (Character.can_fire_weapon() false) can't be
	## fired at all regardless of how much physical ammo is in
	## inventory. Rather than just refusing the Action outright (like
	## the range/ammo checks above, which cost nothing), using the
	## ranged Action on an unloaded weapon spends the Action on a real
	## Reload attempt instead — Character.attempt_reload() runs the
	## Extended (Ranged) Test and reports whether it finished.
	if weapon_check.is_ranged and not player.can_fire_weapon(weapon_check):
		awaiting_player_target = false
		_clear(target_container)
		action_used_this_turn = true
		var reload_test: TestResolver.TestResult = player.attempt_reload(weapon_check)
		if reload_test != null:
			var now_ready := player.can_fire_weapon(weapon_check)
			var reload_extra: Array[String] = []
			if now_ready:
				reload_extra.append("%s finishes reloading the %s — ready to fire again!" % [player.character_name, weapon_check.weapon_name])
			else:
				reload_extra.append("%s works the %s's action, but it's not ready to fire yet." % [player.character_name, weapon_check.weapon_name])
			## Gunner (p.138, Up in Arms): "Reloading during combat counts
			## as an Assess action, and that Assess Test gains an extra +1
			## Advantage" — grants the same success-scaled Advantage a real
			## Assess would (gain_assess), plus Gunner's own extra +1, on
			## a successful reload roll with a Blackpowder weapon.
			if reload_test.success and weapon_check.qualities.has("Blackpowder") and player.has_talent("Gunner") and not player.is_advantage_denied():
				encounter.advantage_pool.gain_assess(player.allegiance, reload_test.success_levels)
				encounter.advantage_pool.add(player.allegiance, 1)
				reload_extra.append("+Advantage (Gunner: reloading counts as Assess, plus 1 extra)")
			_show_single_card(player, "Reload", weapon_check.weapon_name, "ally", reload_test, reload_extra)
			_add_notice(reload_extra[0])
		_render_status()
		return

	## Ammunition (p.294), per the request: "without it you can't
	## shoot." Checked here, alongside the other reasons an attack can
	## be refused (out of range, too far for melee) — before the
	## Action is actually spent, so a genuinely empty weapon doesn't
	## cost the Turn. Sling gets the book's own free-rock exception on
	## Round 1 (see Character.has_ammo_for) — everything else with no
	## ammo in inventory is a hard refusal.
	if not player.has_ammo_for(weapon_check, encounter.round_number):
		_add_notice("%s has no ammunition left for the %s." % [player.character_name, weapon_check.weapon_name])
		return

	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var effort := pending_effort_bonus
	pending_effort_bonus = 0
	var weapon: WeaponDefinition = weapon_check
	## Consumed exactly once here — before the do_attack closure below,
	## which a Fortune-spend Reroll calls again for the SAME shot, not
	## a second one. Returns "" for melee/Throwing (nothing to
	## consume) or the free Sling Round-1 shot (nothing in inventory to
	## remove).
	var ammo_consumed := player.consume_ammo_for(weapon, encounter.round_number)
	if ammo_consumed == "" and AmmoLookup.is_sling(weapon):
		_add_notice("%s slings a stone snatched up off the ground — free on the opening Round." % player.character_name)
	## Charging (Up in Arms p.136, which explicitly supersedes the core
	## rulebook's own +1 Advantage version): "Charging now gives you a
	## +10 bonus to the first Melee Test you initiate after completing
	## your move." A flat roll modifier, not an Advantage gain — added to
	## the attack modifier below rather than granted separately after
	## the fact.
	var charge_bonus := 10 if is_charge else 0
	## Dual Wielder only applies to a real melee attack with your actual
	## equipped weapon — never a ranged attack (excluded by the
	## `not weapon.is_ranged` check below) — and only while genuinely
	## eligible (see _dual_wield_eligible's own
	## comment: a real weapon, or an empty-defaults-to-Unarmed slot, in
	## BOTH hands). The eligibility check is re-verified here rather
	## than trusted from the toggle button's own visibility, since nothing
	## stops a weapon switch between toggling Dual Wield on and actually
	## attacking. Consumed here regardless of outcome — it was for this
	## Action.
	var use_dual_wield := dual_wield_active and not weapon.is_ranged and _dual_wield_eligible(player)
	dual_wield_active = false
	GameState.dual_wield_toggle_remembered = false
	## Deadeye Shot's dropdown selection — consumed here regardless of
	## outcome, same as Dual Wield above, so a stale choice never lingers
	## onto some later, unrelated shot.
	deadeye_shot_location = ""

	## Off-hand penalty (p.136 sidebar): fighting with the weapon in
	## your off hand — the actual hand throwing THIS strike, per the
	## `is_offhand` flag the Off: button passes in — costs -20, -10, or
	## 0 depending on Ambidextrous rank (see Character.get_offhand_
	## penalty()), and applies only to melee (there's no off-hand
	## concept for a ranged weapon here). Per the correction: this is a
	## property of which hand is swinging THIS strike, never a
	## Dual-Wield-only thing and never appliable to the main hand —
	## so it belongs on the opening hit whenever that hit itself was
	## thrown by the off-hand (solo off-hand attack, or a Dual Wield
	## combo initiated from the Off: button), not on the Dual Wielder
	## follow-up in general (see that block below, which now mirrors
	## this same is_offhand-driven logic for the OTHER hand).
	var primary_off_hand_penalty := 0
	if is_offhand and not weapon.is_ranged:
		primary_off_hand_penalty = player.get_offhand_penalty()

	var result: CombatResolver.AttackResult
	var outnumbering := 0
	var dual_wield_scopes: Array = ["Melee when attacking with two weapons"] if use_dual_wield else []
	## Hatred (p.190): "+1 SL on all combat Tests against the specified
	## group" while genuinely Subject to Hatred (a temporary state
	## entered via _on_succumb_to_hatred, not just from knowing the
	## Talent) — added as an extra scope so the same generic talent-SL
	## mechanism Dual Wielder already uses picks it up automatically,
	## rather than a bespoke bonus applied after the fact (which
	## wouldn't actually affect Damage, since that's computed from the
	## Test's SL before any post-hoc adjustment could apply).
	if player.conditions.has("Hatred"):
		var hatred_scope: String = "Ranged when subject to Hatred" if weapon.is_ranged else "Melee when subject to Hatred"
		dual_wield_scopes.append(hatred_scope)
	## Hunter's Eye (p.138): "gain a bonus to Ranged Tests made at long
	## range outdoors" — added as the same kind of extra scope, gated on
	## the real range band already computed above. This project doesn't
	## track indoor/outdoor encounters at all, so "outdoors" is assumed
	## unconditionally — a documented simplification, same principle as
	## the rest of this Talent-scope block.
	if weapon.is_ranged and (range_band == BattleGrid.RangeBand.LONG or range_band == BattleGrid.RangeBand.EXTREME):
		dual_wield_scopes.append("Ranged when at Long Range or greater")
	## Fear (p.190): "you suffer -1 SL on all Tests to affect the
	## source of your fear." Applied here as a -10 roll-target penalty
	## instead of a strict SL deduction — the existing combat resolver
	## infrastructure has a clean, well-tested path for target-number
	## modifiers (the same one Charging/Additional Effort/Outnumbering
	## already use) but no attacker-side path for a raw SL penalty, and
	## a straight SL subtraction after the fact wouldn't correctly
	## affect Damage (computed from the Test's SL before any post-hoc
	## adjustment). A documented simplification, same principle as the
	## rest of this pass's Psychology implementation.
	var fear_penalty := -10 if _fear_sources.get(player, {}).has(target) else 0
	## Darkness (per the request): computed once here, same as fear_
	## penalty above — attacker/target/is_ranged (weapon.is_ranged)
	## don't change across a Fortune-spend reroll of this same attack,
	## so there's no need to recompute it inside do_attack every call.
	var darkness_mod := _darkness_penalty(player, target, weapon.is_ranged)
	## Move and Fire (p.204): "if a character moves any distance during
	## a Round and then makes a Ranged Attack, they suffer a -10
	## penalty." moved_this_turn is set the moment any real movement
	## (a Move, or the movement portion of a Charge) is committed this
	## Turn — see _try_commit_move()/_on_player_attack's own Charge
	## branch — and only ever cleared at the start of a fresh Turn, so
	## it's still correctly set here even if the shot comes from a
	## later Action this same Turn (Act Again) rather than the Turn's
	## first Action.
	var move_fire_penalty := -10 if (weapon.is_ranged and moved_this_turn) else 0
	## Flight (p.343): "When flying, it suffers a penalty of -20 to all
	## ranged combat attempts as it swoops and wheels in the sky." Reads
	## currently_flying, not just has_creature_trait("Flight") — a
	## Flight-capable creature that's currently grounded doesn't eat
	## this penalty.
	var flying_attack_penalty := -20 if (weapon.is_ranged and currently_flying.get(player, false)) else 0
	var attack_breakdown: Array = []

	## A local closure so the whole attack (melee or ranged, with all
	## its bonuses) can be re-run cleanly for Fortune's Reroll option,
	## or re-run with a specific forced roll for the +1 SL option —
	## without duplicating the branch logic below twice more.
	##
	## Bug fix ("Reroll only affect your own rolls, not the opposing
	## roll"): the defender's own Defence roll used to be hardcoded to
	## -1 (i.e. "roll fresh") on EVERY call, including a Fortune-spend
	## redo of the ATTACKER's roll — so spending Fortune to reroll your
	## own attack was silently also re-rolling the defender's Dodge/
	## Parry, letting a lucky reroll turn their original successful
	## defence into a failure (or vice versa) even though Fortune is
	## only ever the player's own resource. `forced_defender_roll`
	## defaults to -1 for the very first, genuinely fresh roll of this
	## whole opposed test; the reroll loop below now passes the
	## defender's ALREADY-ROLLED number back in on every redo, so only
	## the attacker's own d100 changes.
	var do_attack := func(forced_roll: int, forced_defender_roll: int = -1, forced_location: String = "") -> CombatResolver.AttackResult:
		if weapon.is_ranged:
			var r := CombatResolver.resolve_ranged_attack(player, target, weapon, encounter.advantage_pool, effort + fear_penalty + range_modifier + cover_modifier + darkness_mod + move_fire_penalty + flying_attack_penalty, forced_roll, encounter.get_living(target.allegiance), forced_location, dual_wield_scopes, encounter.round_number)
			attack_breakdown = []
			if effort > 0:
				attack_breakdown.append({"name": "Additional Effort", "amount": effort})
			if fear_penalty != 0:
				attack_breakdown.append({"name": "Fear", "amount": fear_penalty})
			if range_band_active and range_modifier != 0:
				attack_breakdown.append({"name": "Range (%s)" % BattleGrid.get_range_band_name(range_band), "amount": range_modifier})
			if cover_modifier != 0:
				attack_breakdown.append({"name": "Target in Cover (%s)" % cover_level_label, "amount": cover_modifier})
			if darkness_mod != 0:
				attack_breakdown.append({"name": "Target in Darkness", "amount": darkness_mod})
			if move_fire_penalty != 0:
				attack_breakdown.append({"name": "Moved before firing", "amount": move_fire_penalty})
			if flying_attack_penalty != 0:
				attack_breakdown.append({"name": "Flying (swooping and wheeling)", "amount": flying_attack_penalty})
			r.attacker_test.target_modifiers = attack_breakdown
			return r
		else:
			encounter.mark_melee_engaged(player, target)
			outnumbering = encounter.get_outnumbering_bonus(player, _local_melee_cluster(player))
			var r := CombatResolver.resolve_melee_attack(player, target, weapon, encounter.advantage_pool, null, "", false,
				effort + outnumbering + charge_bonus + fear_penalty + darkness_mod + primary_off_hand_penalty, 0, forced_roll, [], 0, dual_wield_scopes, forced_defender_roll, is_charge,
				[], encounter.get_living(target.allegiance), forced_location)
			attack_breakdown = []
			if effort > 0:
				attack_breakdown.append({"name": "Additional Effort", "amount": effort})
			if outnumbering > 0:
				attack_breakdown.append({"name": "Outnumbering", "amount": outnumbering})
			if charge_bonus > 0:
				attack_breakdown.append({"name": "Charging", "amount": charge_bonus})
			if fear_penalty != 0:
				attack_breakdown.append({"name": "Fear", "amount": fear_penalty})
			if darkness_mod != 0:
				attack_breakdown.append({"name": "Darkness", "amount": darkness_mod})
			if primary_off_hand_penalty != 0:
				attack_breakdown.append({"name": "Off-hand penalty", "amount": primary_off_hand_penalty})
			r.attacker_test.target_modifiers = attack_breakdown
			melee_has_begun = true
			## Berserk Charge (p.133): "When you Charge, you gain +1
			## Damage to all Melee attacks per level in this Talent."
			## Applied as a direct extra Wound loss on a hit, alongside
			## updating the result's own Damage/Wounds fields so the
			## roll card displayed right after correctly shows it,
			## rather than a hidden bonus the player can't see.
			if is_charge and r.hit:
				var berserk_rank := player.get_talent_rank("Berserk Charge")
				if berserk_rank > 0:
					target.take_wounds(berserk_rank)
					r.wounds_dealt += berserk_rank
					r.damage += berserk_rank
			return r

	## Deathblow (p.160/p.341 — see _offer_deathblow_chain): one shared
	## budget for every melee hit this whole Action lands (this main
	## attack, Dual Wielder's off-hand strike, Frenzy, Furious Assault),
	## so the Weapon Skill Bonus cap and the never-the-same-Character-
	## twice rule both apply across the whole Action rather than
	## resetting per sub-attack. Seeded with `target` itself so a later
	## chain attack can't loop back onto the Character this Action
	## already attacked once.
	var deathblow_budget: Dictionary = {"used": 0, "hit": [target]}
	var wounds_before_main := target.wounds_current
	## Captured now, before this hit resolves — see _offer_deathblow_
	## chain's own comment on why this can no longer be read off
	## battle_positions[target] at call time (a genuine kill gets culled
	## out of battle_positions by _render_status() well before the
	## Deathblow offer down below ever runs).
	var target_square_before_main: Vector2i = battle_positions.get(target, Vector2i(-1, -1))
	result = do_attack.call(-1, -1, forced_hit_location)
	## Repeater (Rating)/Reload (Rating) (p.298-299): recorded exactly
	## once per shot actually fired, hit or miss — right after this
	## genuinely fresh first roll, NOT inside the Fortune reroll loop
	## below (a reroll re-resolves the SAME shot, it doesn't fire a
	## second one).
	if weapon.is_ranged:
		player.record_shot_fired(weapon)
	## Captured once, right after this test's genuinely fresh first
	## roll — see do_attack's own comment. -1 (fresh roll) for a
	## ranged attack, which has no opposed defender_test at all.
	var original_defender_roll: int = result.defender_test.roll if result.defender_test != null else -1

	selected_target = target
	if player != null:
		ally_focus_target[player] = target
	_show_attack_cards(player, target, weapon.weapon_name, result)
	_check_for_kill_xp(target)
	if result.caused_critical_wound:
		_apply_critical_wound_to_monster(result, target)
	_apply_hack_quality(player, weapon, target, result)
	_apply_pummel_quality(player, weapon, target, result)
	_apply_fumble_effects(player, weapon, result.fumble)
	## Per the follow-up request: the monster's own fumbled Parry now has a real
	## consequence too, same as the player's own fumble does — checked
	## against the monster's own weapon (if it has one to damage).
	if target in weapons:
		_apply_fumble_effects(target, weapons[target], result.defender_fumble)
	## Per the follow-up request: a critical Parry riposte here damages
	## the PLAYER (the attacker in this specific flow, since target is
	## the defending monster) — if the riposte's own Critical Wound
	## roll was a Death-tier result, reuse the exact same, already-
	## tested handling a normal Critical Wound gets (Fate Point offer,
	## etc.) rather than building a second, parallel death path.
	if result.critical_parry_counter_triggered and result.critical_parry_counter_causes_death:
		result.critical_wound_entry = result.critical_parry_counter_wound_entry
		result.critical_wound_location = result.critical_parry_counter_wound_location
		result.critical_wound_causes_death = true
		await _handle_critical_wound_on_player(result)
	_render_status()

	## Careful Strike (p.134): "you may modify your Hit Location result
	## by up to +/-10 per time you have this Talent" — offered here as a
	## real choice between locations reachable via that shift, but per
	## the request NOT a blocking one: the buttons are posted alongside
	## this hit's own roll card and the player is free to do anything
	## else first (spend Fortune below, Move, End Turn, Act Again...).
	## Skipped entirely when Deadeye Shot's own explicit pre-roll choice
	## already decided this shot's location outright (forced_hit_location
	## != "" — there's no natural roll left to modify in that case), and
	## never offered on a miss.
	if result.hit and forced_hit_location == "" and player.get_talent_rank("Careful Strike") > 0:
		var cs_alt_locations: Array = CombatResolver.careful_strike_reachable_locations(CombatResolver.reverse_roll(result.attacker_test.roll), player.get_talent_rank("Careful Strike"))
		if not cs_alt_locations.is_empty():
			## Captured by this closure and re-read live at click time
			## (whenever that ends up being — there's no await here to
			## wait for it), so a relocation always applies to whatever
			## `result` currently is, e.g. after a Fortune reroll.
			var cs_relocate := func(loc: String) -> void:
				## Undo this hit's Wound/extra-Wound effects, and any
				## Prone this specific hit caused, before redoing the
				## SAME roll (forced_roll/forced_defender_roll) with the
				## chosen Hit Location — same undo-then-redo pattern the
				## Fortune reroll loop further down already uses for a
				## full redo of the same roll.
				if target.wounds_current <= 0 and (result.wounds_dealt > 0 or result.critical_wound_extra_wounds > 0):
					target.remove_condition("Prone")
				target.wounds_current = min(target.wounds_max, target.wounds_current + result.wounds_dealt + result.critical_wound_extra_wounds)
				result = do_attack.call(result.attacker_test.roll, original_defender_roll, loc)
				result.attacker_test.target_modifiers = attack_breakdown
				_show_attack_cards(player, target, weapon.weapon_name, result, true)
				_check_for_kill_xp(target)
				if result.caused_critical_wound:
					_apply_critical_wound_to_monster(result, target)
				_render_status()
			_present_careful_strike_choice(result.hit_location, cs_alt_locations, cs_relocate)

	## Per the request: don't offer to spend Fortune on this attack roll
	## if it just defeated `target` outright — nothing left for +1 SL or
	## a reroll to meaningfully change. Act Again is also suppressed
	## here (suppress_act_again=true) — a Deathblow chain, Dual
	## Wielder, and Frenzy/Furious Assault all still get a chance to
	## fire below before Act Again is ever offered, at the very end of
	## this whole Action.
	var choice := await _offer_fortune_spend(result.attacker_test, false, encounter.is_defeated(target), true, result.hit)
	while choice == "reroll" or choice == "sl":
		var forced := -1 if choice == "reroll" else _roll_with_plus_one_sl(result.attacker_test.roll)
		## Undo the previous attempt's Wounds dealt before reapplying —
		## a redo shouldn't stack damage from both attempts. Includes
		## both the normal hit damage AND any Critical Wound table
		## "extra Wounds" (a real bug caught during testing: reversing
		## only wounds_dealt left the Critical Wound's own unavoidable
		## extra damage double-counted on a redo). Critical Wound
		## Conditions already applied from a first attempt aren't
		## un-applied here (cleanly reversing an arbitrary Condition set
		## is a lot more involved than reversing a Wound total) — a
		## documented simplification for this specific redo path, given
		## how rare "reroll right after rolling a Critical" actually is.
		if result.hit:
			target.wounds_current = min(target.wounds_max, target.wounds_current + result.wounds_dealt + result.critical_wound_extra_wounds)
		result = do_attack.call(forced, original_defender_roll)
		result.attacker_test.target_modifiers = attack_breakdown
		_show_attack_cards(player, target, weapon.weapon_name, result, true)
		_check_for_kill_xp(target)
		if result.caused_critical_wound:
			_apply_critical_wound_to_monster(result, target)
		_render_status()
		choice = await _offer_fortune_spend(result.attacker_test, false, encounter.is_defeated(target), true, result.hit)

	await _offer_deathblow_chain(player, weapon, target, wounds_before_main, result.hit, deathblow_budget, target_square_before_main)

	## Strike to Stun — a documented simplified homebrew (see the toggle's
	## own comment): applies Stunned on a hit rather than touching Called
	## Shot rules this project doesn't model. Consumed regardless of hit
	## or miss — it was for this Action.
	if strike_to_stun_active:
		if result.hit and not encounter.is_defeated(target):
			target.add_condition("Stunned")
			_add_notice("[b]Strike to Stun:[/b] %s is Stunned!" % target.character_name)
		strike_to_stun_active = false

	## Dual Wielder (p.136): only triggers if the FIRST strike hit.
	## Reuses the same roll, digits reversed (34 -> 43), rather than
	## rolling fresh — a real Opposed Test against a fresh defensive
	## roll. Swings whichever hand DIDN'T throw the first strike — per
	## the follow-up request ("initiate a Dual wield attack both both
	## main hand or off hand"), the combo can now start from either
	## Attack button, so the follow-up is the complement of `is_offhand`
	## rather than always defaulting to the off-hand. Both resolvers
	## default an empty slot to Unarmed (see _resolve_weapon/
	## _resolve_offhand_weapon) rather than falling back to re-swinging
	## the SAME weapon twice, matching the follow-up request's own
	## "Unarmed... should be the default weapon if nothing is equipped
	## in either hand" — _dual_wield_eligible already guarantees a real
	## weapon (or an empty slot) sits in both hands before
	## use_dual_wield is ever true, so this always has a genuine second
	## weapon to swing.
	##
	## Per the correction: the off-hand penalty (rank-scaled by
	## Ambidextrous — see Character.get_offhand_penalty()) belongs to
	## whichever hand is ACTUALLY the off-hand, never the main hand — it
	## is not "whichever strike goes second." When the combo opened on
	## the main hand (is_offhand == false), this follow-up swings the
	## off-hand and takes the penalty; when the combo opened on the
	## off-hand instead (is_offhand == true, already penalized on that
	## opening hit above via primary_off_hand_penalty), this follow-up
	## swings the MAIN hand and takes no penalty at all.
	if use_dual_wield and result.hit and not encounter.is_defeated(target):
		var second_weapon: WeaponDefinition = _resolve_weapon(player) if is_offhand else _resolve_offhand_weapon(player)
		var second_hand_label := "main-hand" if is_offhand else "off-hand"
		var reversed_roll := CombatResolver.reverse_roll(result.attacker_test.roll)
		var second_off_hand_penalty := 0
		if not is_offhand:
			second_off_hand_penalty = player.get_offhand_penalty()
		var offhand_wounds_before := target.wounds_current
		var target_square_before_offhand: Vector2i = battle_positions.get(target, Vector2i(-1, -1))
		var second_result := CombatResolver.resolve_melee_attack(player, target, second_weapon, encounter.advantage_pool,
			null, "", false, second_off_hand_penalty + outnumbering, 0, reversed_roll, [], 0, ["Melee when attacking with two weapons"],
			-1, false, [], encounter.get_living(target.allegiance))
		var second_breakdown: Array = []
		if outnumbering > 0:
			second_breakdown.append({"name": "Outnumbering", "amount": outnumbering})
		if second_off_hand_penalty != 0:
			second_breakdown.append({"name": "Off-hand penalty", "amount": second_off_hand_penalty})
		second_result.attacker_test.target_modifiers = second_breakdown
		_show_attack_cards(player, target, "%s (%s)" % [second_weapon.weapon_name, second_hand_label], second_result, true)
		_check_for_kill_xp(target)
		await _offer_deathblow_chain(player, second_weapon, target, offhand_wounds_before, second_result.hit, deathblow_budget, target_square_before_offhand)

	## Per the request: Frenzy's free attack and Furious Assault are now
	## real, player-chosen bonus actions — offered only when the talent
	## is actually learned (or the Frenzy Condition is active) AND every
	## other activation requirement is met, never triggered
	## automatically. Both share one combined prompt since either (or
	## neither) might be available after any given hit.
	var frenzy_available := player.conditions.has("Frenzy") and not weapon.is_ranged and not encounter.is_defeated(target)
	var furious_assault_available := player.has_talent("Furious Assault") and not weapon.is_ranged and result.hit \
		and not player.furious_assault_used_this_round and not encounter.is_defeated(target) \
		and encounter.advantage_pool.get_pool("ally") >= 1
	if frenzy_available or furious_assault_available:
		var bonus_choice := await _offer_bonus_action_choice(frenzy_available, furious_assault_available)
		if bonus_choice == "frenzy":
			await _execute_frenzy_attack(target, weapon, outnumbering, deathblow_budget, charge_bonus, fear_penalty, darkness_mod, primary_off_hand_penalty)
		elif bonus_choice == "furious_assault":
			await _execute_furious_assault(target, weapon, outnumbering, deathblow_budget, charge_bonus, fear_penalty, darkness_mod, primary_off_hand_penalty)

	_refresh_enemy_display()
	_render_status()
	## Per the request: if this attack (or one of its follow-ups —
	## Dual Wielder, Frenzy) just defeated the last living adversary,
	## skip the "press Continue" gate entirely and go straight to
	## _next_turn() — which immediately calls _end_battle() and shows
	## the report — rather than making the player click through one
	## more prompt before reaching a battle that's already effectively
	## over. Still shown normally mid-fight, when there's a real reason
	## to pause and read what just happened.
	##
	## Per the follow-up request: always reaches this call now (dropped
	## the old `extra_content_shown and` condition) rather than only
	## when Deathblow/Stun/Dual Wielder/Frenzy fired — Act Again was
	## suppressed from every earlier Fortune prompt above specifically
	## so it could be offered here instead, after the WHOLE chain
	## (Deathblow and any of its own follow-up Deathblows, Dual
	## Wielder, Frenzy/Furious Assault) has genuinely finished
	## resolving. This is still a no-op with no extra click when
	## neither Act Again nor anything else is actually on offer —
	## _wait_for_continue_after_own_action() already returns
	## immediately in that case (see its own comment).
	if not encounter.get_living("adversary").is_empty():
		await _wait_for_continue_after_own_action()
	_finish_player_action()

## --- Advantage Actions (Up in Arms p.133-134) --------------------------

func _consume_effort_bonus() -> Array:
	var bonus := pending_effort_bonus
	pending_effort_bonus = 0
	var breakdown: Array = []
	if bonus > 0:
		breakdown.append({"name": "Additional Effort", "amount": bonus})
	return [bonus, breakdown]

func _on_assess(skill_name: String) -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var skill: SkillDefinition = GameData.skill_db.find_by_name(skill_name)
	var effort := _consume_effort_bonus()
	var adv_before := encounter.advantage_pool.get_pool("ally")

	var test := TestResolver.resolve_skill_test(player, skill, "", effort[0], effort[1])
	_apply_assess_outcome(test, skill_name, adv_before, false)
	_render_status()

	var choice := await _offer_fortune_spend(test)
	while choice == "reroll" or choice == "sl":
		if choice == "reroll":
			test = TestResolver.resolve_skill_test(player, skill, "", effort[0], effort[1])
		## Revert this Action's Advantage gain back to the pre-roll
		## baseline before reapplying with the new result — otherwise a
		## redo would stack gains from both attempts instead of
		## replacing the first with the second.
		encounter.advantage_pool.add("ally", adv_before - encounter.advantage_pool.get_pool("ally"))
		_apply_assess_outcome(test, skill_name, adv_before, true)
		_render_status()
		choice = await _offer_fortune_spend(test)

	_finish_player_action()

func _apply_assess_outcome(test: TestResolver.TestResult, skill_name: String, adv_before: int, merge: bool) -> void:
	var extra: Array[String] = []
	## Distract (p.142): a Distracted player still rolls Assess (it's
	## still their Action to spend), but generates no Advantage from it.
	if test.success and not player.is_advantage_denied():
		encounter.advantage_pool.gain_assess("ally", test.success_levels)
		var gained := 3 if test.success_levels >= 6 else 2
		extra.append("+%d Advantage (Assess)" % gained)
	elif test.success:
		extra.append("Assess succeeds, but %s can generate no Advantage right now (Distracted)." % player.character_name)
	else:
		extra.append("No tactical opening found")
	_show_single_card(player, skill_name, "Assess", "ally", test, extra, merge)
	_note_advantage_change("ally", adv_before, "Assess")

func _on_batter(target: Character) -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var adv_before := encounter.advantage_pool.get_pool("ally")
	var result := GroupAdvantageActions.spend_batter(encounter.advantage_pool, player, target)
	_show_opposed_action_cards(player, target, "Batter", result)
	_note_advantage_change("ally", adv_before, "Batter")
	_refresh_enemy_display()
	_render_status()
	## Defensive fix: an unsuccessful spend (see
	## _show_opposed_action_cards' own comment) leaves opposed_test
	## null — nothing to offer a Fortune spend against, and
	## _offer_fortune_spend would crash reading `test.success` off a
	## null test. Not currently reachable (the Batter button is only
	## shown with enough Advantage to begin with).
	if result.success:
		## Batter/Trick are opposed actions — Fortune is only ever the
		## player's own resource, so it's offered against the player's own
		## half of the opposition (result.opposed_test). Rerolling re-runs
		## the whole action (a documented simplification: the opponent's
		## side rerolls too, and Advantage is spent again, rather than just
		## the player's roll being redone) — shown as an additional merged
		## card, same as every other Fortune-eligible action.
		var choice := await _offer_fortune_spend(result.opposed_test, true, false, false, result.attacker_won)
		while choice == "reroll":
			result = GroupAdvantageActions.spend_batter(encounter.advantage_pool, player, target)
			_show_opposed_action_cards(player, target, "Batter (reroll)", result, true)
			_refresh_enemy_display()
			_render_status()
			if not result.success:
				break
			choice = await _offer_fortune_spend(result.opposed_test, true, false, false, result.attacker_won)
	_finish_player_action()

func _on_trick(target: Character, condition: String) -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var adv_before := encounter.advantage_pool.get_pool("ally")
	var result := GroupAdvantageActions.spend_trick(encounter.advantage_pool, player, target, condition)
	_show_opposed_action_cards(player, target, "Trick", result)
	_note_advantage_change("ally", adv_before, "Trick")
	_render_status()
	## Defensive fix: see the matching comment in _on_batter — an
	## unsuccessful spend leaves opposed_test null, and there'd be
	## nothing valid to offer a Fortune spend against.
	if result.success:
		var choice := await _offer_fortune_spend(result.opposed_test, true, false, false, result.attacker_won)
		while choice == "reroll":
			result = GroupAdvantageActions.spend_trick(encounter.advantage_pool, player, target, condition)
			_show_opposed_action_cards(player, target, "Trick (reroll)", result, true)
			_render_status()
			if not result.success:
				break
			choice = await _offer_fortune_spend(result.opposed_test, true, false, false, result.attacker_won)
	_finish_player_action()

## Entangled (p.168): "For your Action, you can remove an Entangled
## Distract (Talent, Up in Arms p.142): "You may use your Move to
## perform a Distraction. This is resolved by an Opposed Athletics/Cool
## Test against your target. If you win, your opponent can generate no
## Advantage for their Pool until the end of the next Round." Spends the
## Move, not the Action (see the button's own movement_remaining gate,
## same shape as Stand Up) — the player can still Attack/Cast/etc.
## afterward with whatever Action they have. On a win, marks `target`
## via Character.advantage_denied_rounds_remaining = 2, read by every
## Advantage-gain call site attributable to that character's own
## actions (see Character.is_advantage_denied()'s own comment for the
## exact "rest of this Round + all of next Round" timing).
func _on_distract(target: Character) -> void:
	if not awaiting_player_target or movement_remaining <= 0:
		return
	awaiting_player_target = false
	_clear(target_container)
	movement_remaining = 0
	var athletics_skill: SkillDefinition = GameData.skill_db.find_by_name("Athletics")
	var cool_skill: SkillDefinition = GameData.skill_db.find_by_name("Cool")
	var attacker_test := TestResolver.resolve_skill_test(player, athletics_skill, "")
	var defender_test := TestResolver.resolve_skill_test(target, cool_skill, "")
	var opposed := TestResolver.resolve_opposed(attacker_test, defender_test)
	var extra: Array[String] = []
	if opposed.attacker_wins:
		target.advantage_denied_rounds_remaining = 2
		extra.append("%s is Distracted — no Advantage from %s until the end of next Round." % [target.character_name, target.character_name])
	elif opposed.is_true_tie:
		extra.append("Dead even — %s isn't fooled, but isn't caught out either." % target.character_name)
	else:
		extra.append("%s isn't fooled." % target.character_name)
	_show_single_card(player, "Distract", target.character_name, "ally", attacker_test, extra)
	_render_status()
	## Only the Move was spent — same as Stand Up, no Act Again offer
	## here (that's an extra ACTION, and the player hasn't used their
	## own Action yet) and straight back into the action menu so they
	## still can.
	_prompt_player_turn(false)

## Condition if you win an Opposed Strength Test against the source of
## the entanglement... with each SL removing an extra Entangled
## Condition." A real Opposed Strength Test, resolved and logged the
## same way Batter/Trick's opposed actions are.
func _on_struggle_free(source: Character) -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var attacker_test := TestResolver.resolve_characteristic_test(player, "strength")
	var defender_test := TestResolver.resolve_characteristic_test(source, "strength")
	var opposed := TestResolver.resolve_opposed(attacker_test, defender_test)
	var extra: Array[String] = []
	if opposed.attacker_wins:
		var removed: int = max(1, attacker_test.success_levels - defender_test.success_levels)
		var remaining: int = max(0, int(player.conditions.get("Entangled", 0)) - removed)
		if remaining <= 0:
			player.conditions.erase("Entangled")
		else:
			player.conditions["Entangled"] = remaining
		extra.append("%s breaks free (-%d Entangled)!" % [player.character_name, removed])
	elif opposed.is_true_tie:
		extra.append("Dead even — %s can't quite break free this time." % player.character_name)
	else:
		extra.append("%s fails to break free." % player.character_name)
	_show_single_card(player, "Struggle Free", source.character_name, "ally", attacker_test, extra)
	_render_status()
	await _wait_for_continue_after_own_action()
	_finish_player_action()

## Ablaze (p.167): "One Ablaze Condition can be removed with a successful
## Athletics Test, with each SL removing an extra Ablaze Condition" — a
## self-directed Action, same real-Test shape as Struggle Free above.
func _on_douse_flames() -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var test := player.attempt_douse_ablaze()
	var extra: Array[String] = []
	if test != null and test.success:
		extra.append("%s smothers the flames!" % player.character_name)
	else:
		extra.append("%s fails to put the fire out." % player.character_name)
	_show_single_card(player, "Douse Flames (Ablaze)", "", "ally", test, extra)
	_render_status()
	await _wait_for_continue_after_own_action()
	_finish_player_action()

## Prone (p.169): "You lose the Prone Condition when you stand up" — no
## Test, just spending your Move on it (per the book, "your Move can
## only be used to stand up or crawl" while Prone — treated here as
## using up the whole remaining Move for the Turn, not a partial cost,
## matching that either/or framing). Does not spend the Action, so the
## player can still Attack/Cast/etc. afterward with whatever Action they
## have left.
func _on_stand_up() -> void:
	if not awaiting_player_target or movement_remaining <= 0:
		return
	if not player.attempt_stand_up():
		return
	movement_remaining = 0
	_add_notice("%s stands back up." % player.character_name)
	_render_status()
	_prompt_player_turn(false)

## p.171 Spending Resolve — offers whichever of the two implemented
## options actually apply right now (see the button-build comment
## above for why "immune to Psychology" isn't one of them): ignoring
## active Critical Wound modifiers for the rest of this round, or
## removing one stack of a Condition currently held (healing 1 Wound
## if that Condition is Prone). Costs the player's Action, same as
## Douse Flames/Struggle Free above — the book doesn't specify a cost
## for spending Resolve, but treating it as an Action keeps it
## consistent with every other self-directed Condition-clearing option
## already in this file.
func _on_spend_resolve() -> void:
	if not awaiting_player_target or action_used_this_turn or player.resolve <= 0:
		return
	awaiting_player_target = false
	_clear(target_container)

	awaiting_resolve_choice = true
	_pending_choice_str = ""
	target_container.add_child(_section_label("Spend Resolve (%d available)" % player.resolve))

	if not player.critical_wound_penalties.is_empty():
		var ignore_btn := _make_button()
		ignore_btn.text = "Ignore all Critical Wound modifiers until next round"
		ignore_btn.pressed.connect(func():
			_pending_choice_str = "ignore_crit"
			awaiting_resolve_choice = false
		)
		target_container.add_child(ignore_btn)

	for cond_name in player.conditions.keys():
		var stacks: int = int(player.conditions[cond_name])
		var remove_btn := _make_button()
		remove_btn.text = "Remove Condition: %s%s" % [cond_name, (" (1 of %d stacks)" % stacks) if stacks > 1 else ""]
		remove_btn.pressed.connect(func():
			_pending_choice_str = "remove_condition:%s" % cond_name
			awaiting_resolve_choice = false
		)
		target_container.add_child(remove_btn)

	var cancel_btn := _make_button()
	cancel_btn.text = "Cancel"
	cancel_btn.pressed.connect(func():
		_pending_choice_str = ""
		awaiting_resolve_choice = false
	)
	target_container.add_child(cancel_btn)

	## Real bug fix (user report: "combat getting stuck sometimes on
	## creature's turn") — see _handle_critical_wound_on_player()'s own
	## identical fix for the full explanation; this prompt had the same
	## gap. Defaults to Cancel (spends nothing, removes nothing) rather
	## than whichever real option happened to be built first, so an
	## accidental Space press can't burn the player's Resolve or strip a
	## Condition they didn't mean to touch.
	cancel_btn.text += "  [Space]"
	_active_primary_hotkey_button = cancel_btn
	_refresh_focus_for_disabled_buttons(self)
	_auto_focus_default_button()

	while awaiting_resolve_choice:
		await get_tree().process_frame

	var choice := _pending_choice_str
	if choice == "":
		_clear(target_container)
		_prompt_player_turn(false)
		return

	action_used_this_turn = true
	if choice == "ignore_crit":
		player.attempt_spend_resolve_ignore_critical_wound_penalties()
		_add_notice("[color=#8fbf6a]%s spends a Resolve point — ignores all Critical Wound modifiers until the start of next round. (%d Resolve remaining)[/color]" % [player.character_name, player.resolve])
	elif choice.begins_with("remove_condition:"):
		var cond_name: String = choice.substr("remove_condition:".length())
		var was_prone := cond_name == "Prone"
		var wounds_before_recovery := player.wounds_current
		if player.attempt_spend_resolve_remove_condition(cond_name):
			var heal_note := " Surging to their feet, they're back up to 1 Wound." if (was_prone and wounds_before_recovery <= 0) else ""
			_add_notice("[color=#8fbf6a]%s spends a Resolve point — removes a stack of %s.%s (%d Resolve remaining)[/color]" % [player.character_name, cond_name, heal_note, player.resolve])
	_clear(target_container)
	_render_status()
	await _wait_for_continue_after_own_action()
	_finish_player_action()

func _on_additional_effort(spend: int) -> void:
	var adv_before := encounter.advantage_pool.get_pool("ally")
	var bonus := GroupAdvantageActions.spend_additional_effort(encounter.advantage_pool, player, spend)
	if bonus > 0:
		pending_effort_bonus = bonus
		_add_notice("[b]Additional Effort:[/b] %d Advantage spent (%d → %d) for +%d%% on your next Test this turn." % [
			spend, adv_before, encounter.advantage_pool.get_pool("ally"), bonus
		])
	_render_status()
	if not pending_defense.is_empty():
		_prompt_player_defense(pending_defense["attacker"], pending_defense["weapon"],
			pending_defense["attacker_effort"], pending_defense.get("charge_bonus", 0))
	else:
		_prompt_player_turn(false)

## Disengage (renamed from the old Flee-from-Harm-always-ends-the-fight
## button per the request): no longer ends the encounter outright — now
## that the battle grid gives this project real in-combat positioning
## (v0.2.283+), spending the Advantage instead marks the player safe to
## Move away from melee this Turn, same as the core rulebook's own
## Disengage Action (p.165) but without costing the Action itself — see
## spend_flee_from_harm's own doc comment for how the Group Advantage
## variant replaces that book rule with a flat Advantage spend.
func _on_disengage() -> void:
	if disengaged_this_turn or _player_engaged_enemies().is_empty():
		return
	if not GroupAdvantageActions.spend_flee_from_harm(encounter.advantage_pool, player):
		return
	disengaged_this_turn = true
	_add_notice("[b]Disengage:[/b] %s carefully breaks away — free to Move without leaving an opening this Turn." % player.character_name)
	_render_status()
	_prompt_player_turn(false)

## Rock (p.294): the Action-costing fallback for a Sling once the
## Round-1 free rock is gone and inventory is empty — spends the whole
## Turn to find just one more, no roll involved. Per the request, this
## grants a real "Rock" (the Throwing weapon) rather than a bundle of
## Stone Bullet — AmmoLookup.REQUIRED_AMMO now accepts Rock as valid
## Sling ammo, so the same item is equally usable thrown on its own
## (via the free-action weapon switch) or fired from a Sling.
const ROCKS_GATHERED := 1
func _on_pick_up_rocks() -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	for i in range(ROCKS_GATHERED):
		player.inventory.append("Rock")
	_add_notice("[b]Rock:[/b] %s spends the Turn finding one more rock (+%d Rock)." % [player.character_name, ROCKS_GATHERED])
	_render_status()
	_finish_player_action()

## Real bug fix (user report: "Davrin used act again, but he didn't get
## to use it" — the combat log clearly showed "Additional Action: 4
## Advantage spent — Davrin acts again," but no action menu ever
## appeared for him afterward). Root cause: none of Act Again's three
## eligibility checks (this one, plus the two `offer_act_again` checks
## in _wait_for_continue()/_wait_for_continue_after_own_action())
## accounted for the Master Condition List conditions that
## _render_turn_action_menu() itself auto-passes instead of rendering a
## real menu for — Unconscious/Stunned/Surprised (p.167-169, "incapable
## of taking an Action" or worse) route straight to
## _prompt_incapacitated_turn(), and Broken (p.168, "you cannot use your
## Action for anything else") routes to _prompt_broken_turn() — both of
## which show only a narrated "cannot act" Continue button and then call
## _next_turn() for real once dismissed. A character left with one of
## these Conditions after their normal Action (e.g. Stunned by a
## Critical Wound, or a monster's free attack, in between their own
## attack and clicking Act Again) could still spend the 4 Advantage —
## _on_additional_action() below has no reason to know about Conditions,
## it just spends the cost and reopens the menu — only to have that
## fresh _prompt_player_turn(false) call immediately hit one of those
## auto-pass branches and end the Turn for real, with nothing to show
## for the spend. Shared by all three eligibility checks so they can
## never drift out of sync with _render_turn_action_menu()'s own list.
func _can_use_act_again(actor: Character) -> bool:
	return not (actor.conditions.has("Unconscious") or actor.conditions.has("Stunned") \
		or actor.conditions.has("Surprised") or actor.conditions.has("Broken"))

## Reachable from two places: the permanent sidebar button
## _prompt_player_turn() builds in side_actions_container (only ever
## enabled once the whole Action has genuinely finished resolving — see
## that button's own comment, no skip_next_turn_call_once handshake
## needed there, there's no outer coroutine still mid-flight to skip a
## trailing call for), and the "Act Again (4 Adv)" option
## _wait_for_continue() still renders in the combat log at turn end
## (which DOES need that handshake — see its own callback).
func _on_additional_action() -> void:
	## Defence-in-depth for the fix above: even if a stale click somehow
	## still reaches this handler (e.g. a queued _decline_fortune_prompt_
	## and_run() action, fired later than the frame its button was built
	## on, after a Condition changed in between), never spend the 4
	## Advantage for a fresh Action that's just going to be auto-passed
	## anyway — the three call-site checks above are what normally
	## prevent the click from ever happening at all.
	if not _can_use_act_again(player):
		return
	if not GroupAdvantageActions.spend_additional_action(encounter.advantage_pool, player):
		return
	additional_action_used_this_turn = true
	## Per the request: Act Again grants a genuine second Action —
	## clearing action_used_this_turn here is what makes every
	## Action-consuming button reappear on the fresh menu below instead
	## of staying hidden from the first Action.
	action_used_this_turn = false
	_add_notice("[b]Additional Action:[/b] 4 Advantage spent — %s acts again." % player.character_name)
	_render_status()
	_prompt_player_turn(false)

## --- Skills: Intimidate (Fear), Heal (self) -------------------------------

## Intimidate: a Skill Test (Challenging +0, modified by Additional
## Effort if banked). On success the target gains the Feared Condition.
## Like Prone/Stunned elsewhere in this project, Feared is tracked as a
## real Condition on the Character but doesn't yet have an enforced
## mechanical penalty wired into every Test — a documented
## simplification, not an oversight (see README).
func _on_intimidate(target: Character) -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var skill: SkillDefinition = GameData.skill_db.find_by_name("Intimidate")
	var effort := _consume_effort_bonus()

	var test := TestResolver.resolve_skill_test(player, skill, "", effort[0], effort[1])
	_apply_intimidate_outcome(test, target, false)
	_render_status()

	var choice := await _offer_fortune_spend(test)
	while choice == "reroll" or choice == "sl":
		if choice == "reroll":
			test = TestResolver.resolve_skill_test(player, skill, "", effort[0], effort[1])
		target.remove_condition("Feared")   ## undo the previous attempt's Condition before reapplying, so a redo doesn't stack Feared
		_apply_intimidate_outcome(test, target, true)
		_render_status()
		choice = await _offer_fortune_spend(test)

	_finish_player_action()

func _apply_intimidate_outcome(test: TestResolver.TestResult, target: Character, merge: bool) -> void:
	var extra: Array[String] = []
	if test.success:
		target.add_condition("Feared")
		extra.append("%s is Feared!" % target.character_name)
	else:
		extra.append("%s isn't intimidated." % target.character_name)
	_show_single_card(player, "Intimidate", target.character_name, "ally", test, extra, merge)

## Heal (self or ally): a simplified, homebrew combat action — the
## book's real Heal rules are about treating Critical Wounds over
## downtime, not quick in-combat recovery, but a solo/simplified combat
## context needs *something* to spend a turn on for recovery.
## Challenging (+0) Heal Test; success restores Wounds equal to the
## Success Level (min 1). `_on_heal_self`/`_on_heal_ally` are both thin
## wrappers around the shared `_run_heal_action`, generalized from what
## used to be a self-only action so Field Dressing (p.138) — "trained
## to stabilise the wounded... in the heat of battle" — has an actual
## ally to treat. `target == player` is still allowed through this same
## path (that's what "Heal Self" resolves to), so nothing about the
## original self-heal behaviour changes.
func _on_heal_self() -> void:
	_run_heal_action(player)

func _on_heal_ally(target: Character) -> void:
	_run_heal_action(target)

func _run_heal_action(target: Character) -> void:
	if not awaiting_player_target or action_used_this_turn or target == null:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var skill: SkillDefinition = GameData.skill_db.find_by_name("Heal")
	var effort := _consume_effort_bonus()
	## Field Dressing (p.138): "+SL per rank on a Heal Test made to treat
	## a companion in combat" — this project's Heal action never modelled
	## the book's own "-20 penalty for lacking proper facilities" Field
	## Dressing is written to waive (see the class comment above: this
	## whole action already ignores that penalty for EVERYONE, self or
	## ally, so there was nothing left for Field Dressing to actually
	## waive), so rather than a talent with no real effect at all, this
	## project gives it a genuine, on-brand hook scoped specifically to
	## treating a companion — via the generic Tests-bonus engine, same
	## pattern as Hunter's Eye's own range-conditional scope, rather than
	## bespoke code. Never applies to Heal Self.
	var extra_scopes: Array = ["Heal an ally in combat"] if target != player else []
	var roll_test := func() -> TestResolver.TestResult:
		return TestResolver.resolve_skill_test(player, skill, "", effort[0], effort[1], -1, [], extra_scopes)

	var test: TestResolver.TestResult = roll_test.call()
	var wounds_before := target.wounds_current
	## Baselines for the Bleeding/Poisoned side-effect below, captured
	## once here — same reasoning as wounds_before: a Fortune-triggered
	## redo must reset from the ORIGINAL pre-Heal stack counts, not
	## whatever the previous attempt already reduced them to, or a redo
	## would double-dip the reduction across both attempts.
	var bleeding_before: int = int(target.conditions.get("Bleeding", 0))
	var poisoned_before: int = int(target.conditions.get("Poisoned", 0))
	_apply_heal_outcome(target, test, wounds_before, bleeding_before, poisoned_before, false)
	_render_status()

	var choice := await _offer_fortune_spend(test)
	while choice == "reroll" or choice == "sl":
		if choice == "reroll":
			test = roll_test.call()
		target.wounds_current = wounds_before   ## undo the previous attempt's healing before reapplying with the new result
		## Mirrors the wounds_current reset above: if the previous attempt
		## fully cleared Bleeding/Poisoned and granted the follow-on
		## Fatigued Condition for it, undo that grant too before
		## reapplying — same reasoning as Intimidate's own
		## target.remove_condition("Feared") before its redo.
		for cond_name in ["Bleeding", "Poisoned"]:
			if not target.conditions.has(cond_name):
				var baseline: int = bleeding_before if cond_name == "Bleeding" else poisoned_before
				if baseline > 0:
					var stacks: int = int(target.conditions.get("Fatigued", 0))
					if stacks > 0:
						target.conditions["Fatigued"] = stacks - 1
						if target.conditions["Fatigued"] <= 0:
							target.conditions.erase("Fatigued")
		_apply_heal_outcome(target, test, wounds_before, bleeding_before, poisoned_before, true)
		_render_status()
		choice = await _offer_fortune_spend(test)

	_finish_player_action()

## Shared by the initial roll and any Fortune-triggered redo — computes
## and applies the Heal outcome for `test` against `target` (the player
## themselves for Heal Self, a party member for Heal Ally), then shows
## (or merges) the card reflecting it. `wounds_before` is always the
## value from BEFORE the very first attempt, so a redo heals from the
## same baseline rather than stacking on top of an already-applied
## result. Kept generalized over `target` (rather than hard-coded to
## `player`) so a later pass on ally-targeted healing MAGIC (Blessing of
## Healing, Drain, Soothe — see _add_spell_or_prayer_row and
## _show_ally_target_popup's own comments on that same gap) can reuse
## this same apply/merge/card shape once those effects gain a real
## target picker of their own, instead of hard-coding a fresh "heal
## this Character" formula from scratch.
func _apply_heal_outcome(target: Character, test: TestResolver.TestResult, wounds_before: int, bleeding_before: int, poisoned_before: int, merge: bool) -> void:
	var extra: Array[String] = []
	var target_label: String = "Self" if target == player else target.character_name
	if test.success:
		## Heal (p.138): "the patient recovers a number of Wounds equal to
		## your Intelligence Bonus plus the SL". Per the follow-up request
		## ("heal skill should add Intelligence Bonus + SL outcome on a
		## successful roll") this was previously missing the Intelligence
		## Bonus term entirely — SL alone (floored at 1, so a bare-minimum
		## success still recovers something) is still the SL half of the
		## formula, with the healer's (player's, not the patient's — Heal
		## is a Test the healer makes, same as any other skill Test in
		## this project) own Intelligence Bonus now added on top.
		var sl_healed: int = max(1, test.success_levels)
		var int_bonus: int = player.get_characteristic_bonus("intelligence")
		var healed: int = sl_healed + int_bonus
		target.wounds_current = min(target.wounds_max, wounds_before + healed)
		extra.append("Healed %d Wound(s) (now %d/%d)" % [target.wounds_current - wounds_before, target.wounds_current, target.wounds_max])
		if int_bonus > 0:
			extra.append("(SL %d + Intelligence Bonus %d)" % [sl_healed, int_bonus])
		## Bleeding (p.167) and Poisoned (p.169): "A Heal Test provides the
		## same results" as their own dedicated Endurance-Test recovery —
		## this same roll does double duty rather than needing a second
		## Test, each SL removing an extra stack of either. Reduced from
		## the *_before baselines (not whatever's currently on the
		## character), so a Fortune-triggered redo overwrites rather than
		## stacks its reduction on top of the first attempt's.
		for pair in [["Bleeding", bleeding_before], ["Poisoned", poisoned_before]]:
			var cond_name: String = pair[0]
			var stacks: int = pair[1]
			if stacks <= 0:
				continue
			var removed: int = max(1, test.success_levels)
			var remaining: int = max(0, stacks - removed)
			if remaining <= 0:
				target.conditions.erase(cond_name)
				target.add_condition("Fatigued", 1)
				extra.append("Also clears %s entirely (-%d — now Fatigued)" % [cond_name, removed])
			else:
				target.conditions[cond_name] = remaining
				extra.append("Also eases %s (-%d)" % [cond_name, removed])
	else:
		extra.append("No improvement — the wound needs proper rest.")
	_show_single_card(player, "Heal", target_label, "ally", test, extra, merge)

## --- Items ------------------------------------------------------------

## A Free Action, per the request — doesn't end the turn, same as
## Additional Effort. No official item table is implemented yet, so this
## is a simple documented homebrew: 1d10 Wounds healed, capped at max.
func _on_use_healing_draught() -> void:
	if not player.inventory.has(HEALING_DRAUGHT):
		return
	player.inventory.erase(HEALING_DRAUGHT)
	var healed := Dice.d10()
	var before := player.wounds_current
	player.wounds_current = min(player.wounds_max, player.wounds_current + healed)
	var actual := player.wounds_current - before
	_add_notice("[b]%s drinks a Healing Draught[/b] — recovers %d Wound(s) (now %d/%d)." % [
		player.character_name, actual, player.wounds_current, player.wounds_max
	])
	_render_status()
	_prompt_player_turn(false)

## Cordelia's Apothecary spec: "Implement Faxtoryll... add options to
## consume them and gain their benefits during battle." A free action,
## same shape as Healing Draught above — +10 Weapon Skill/+10 Ballistic
## Skill for 3 Rounds, via the normal timed-buff mechanism every other
## Round-scoped bonus already uses.
func _on_use_faxtoryll() -> void:
	if not player.inventory.has(FAXTORYLL):
		return
	player.inventory.erase(FAXTORYLL)
	player.add_timed_buff(FAXTORYLL, "Cordelia's Apothecary", {"weapon_skill": 10, "ballistic_skill": 10}, 3)
	_add_notice("[b]%s chews a pinch of Faxtoryll[/b] — +10 Weapon Skill, +10 Ballistic Skill for 3 Rounds." % player.character_name)
	_render_status()
	_prompt_player_turn(false)

## Cordelia's Apothecary spec: "Implement... Vitality Draught... add
## options to consume them and gain their benefits during battle." +10
## Toughness and +2 Movement for 6 Rounds — the Toughness bonus rides
## the normal characteristic_bonuses path every timed buff already uses;
## the Movement bonus needed a new movement_bonus field on
## add_timed_buff() (see Character.get_active_movement_bonus()).
func _on_use_vitality_draught() -> void:
	if not player.inventory.has(VITALITY_DRAUGHT):
		return
	player.inventory.erase(VITALITY_DRAUGHT)
	player.add_timed_buff(VITALITY_DRAUGHT, "Cordelia's Apothecary", {"toughness": 10}, 6, 0, 2)
	_add_notice("[b]%s drinks a Vitality Draught[/b] — +10 Toughness, +2 Movement for 6 Rounds." % player.character_name)
	_render_status()
	_prompt_player_turn(false)

## Cordelia's Apothecary spec: "Implement Salwort... add options to
## consume them and gain their benefits during battle (hide these until
## they are needed)." Unlike Faxtoryll/Vitality Draught, this isn't a
## timed buff — it's an immediate cure, and only ever useful while
## genuinely Stunned, so its own button lives in
## _prompt_incapacitated_turn()'s Stunned branch instead of here (see
## that function's own comment on why the normal skills_row button was
## never actually reachable for this one case). `re_enter_turn`
## re-enters a real turn afterward instead of leaving the incapacitated
## auto-pass screen up.
func _on_use_salwort() -> void:
	if not player.inventory.has(SALWORT):
		return
	if not player.conditions.has("Stunned"):
		return
	player.inventory.erase(SALWORT)
	player.remove_condition("Stunned")
	_add_notice("[b]%s sniffs a pinch of Salwort[/b] — clears the Stunned Condition instantly." % player.character_name)
	_render_status()
	_prompt_player_turn(true)

## --- Magic & Prayers ----------------------------------------------------
## Casting/Praying consumes the turn (an Action), same as an attack.
## Offensive spells/prayers (magic missiles) target the selected enemy
## and deal Damage the same way a weapon does; most non-damaging spells/
## prayers apply their narrative effect as a notice only — full
## mechanical buffs/conditions for every one of the 33 spells and 12
## prayers is out of scope for this pass. Drain (spell) and Soothe
## (prayer) are wired with real mechanical healing since they're
## explicitly about that.

## Damage effects use the same top-of-screen enemy selector as a normal
## Attack (selected_target) — "the normal target selector," per the
## request — rather than a separate dropdown; everything else (all the
## stat Blessings, Sigmar's Fiery Hammer, Blessing of Healing, and any
## other spell/prayer without a modelled damage effect) is a buff or
## utility effect and defaults its target dropdown to the caster.
const AOE_PRAYERS := ["Soulfire"]   ## hits every living enemy, not just one
## Free-target AoE prayers — unlike Soulfire (emanates from the caster,
## range_text "You", hits everyone in the fight), these strike a chosen
## point within range, so they need a battle-map click (see
## _enter_aoe_target_mode) rather than just "cast it." Spells use
## SpellDefinition.is_area_of_effect for the same purpose (Blast) — no
## equivalent per-prayer flag exists on PrayerDefinition, so this is a
## small explicit list instead.
const FREE_TARGET_AOE_PRAYERS := ["Twin-tailed Comet"]

## Real bug fix, discovered while wiring up the new Lore spells: a
## Condition-only spell (Shock's "leaves the target Stunned" was already
## the one live example, e.g. p.142) was never actually reachable here —
## only is_magic_missile/Drain counted as "needs an enemy target", so a
## Condition-only spell always fell through to "final_target = player"
## a few lines below, and _apply_cast_spell_outcome's own `target !=
## player` guard on its inflicts_condition branch then silently did
## nothing. Widened to cover any spell with a real Condition payload —
## fixes Shock, and is what lets the new Lore-of-Magic Condition spells
## (Choking Shadows, T'Essla's Arc, Net of Amyntok, and the like)
## actually land on an enemy instead of being flavour text only.
func _is_damage_effect(effect_name: String, is_spell: bool) -> bool:
	if is_spell:
		var sp: SpellDefinition = GameData.spell_db.find_by_name(effect_name)
		return sp != null and (sp.is_magic_missile or sp.inflicts_condition != "" or effect_name == "Drain")
	else:
		return AOE_PRAYERS.has(effect_name)

## AoE radius, in grid squares, for a free-target spell/prayer — Blast
## is "WP Bonus yards", Twin-tailed Comet is "Fellowship Bonus yards".
## Converted to squares via BattleGrid.YARDS_PER_SQUARE (2 yards/square,
## same conversion distance_yards() uses elsewhere) — integer division
## rounds down, since a square only counts as "in range" if it's wholly
## within the yardage (a half-covered square at the edge doesn't count),
## consistent with distance_squares()*YARDS_PER_SQUARE being how a
## square distance is turned back into yards everywhere else in this
## project.
func _aoe_radius_squares(is_spell: bool) -> int:
	var yards: int = player.get_characteristic_bonus("willpower") if is_spell else player.get_characteristic_bonus("fellowship")
	return yards / BattleGrid.YARDS_PER_SQUARE

## Registers a new ground hazard covering `squares` -- see
## persistent_aoe_hazards' own declaration comment for the full shape
## and reasoning. `damage_dice` is a Dice.roll_dice_string() spec
## ("1d10") or "" for a purely flat hit; `damage_flat` adds on top
## either way (so Great Fires' own "1d10+6" is damage_dice="1d10",
## damage_flat=6, while Firewall's flat "equal to your Willpower
## Bonus" is damage_dice="", damage_flat=<WB, snapshotted at cast
## time>). `ignore_armour` true drops the target's own Armour Points
## from the soak calculation (both spells' book text says "ignoring
## APs"/is silent on APs but explicitly says "handled like a magical
## missile" -- Firewall's own crossing hit is NOT flagged to ignore
## armour, only Great Fires' is, per each spell's own book wording).
func _add_persistent_aoe_hazard(hazard_name: String, squares: Dictionary, rounds: int, damage_dice: String, damage_flat: int, ignore_armour: bool, ablaze_stacks: int) -> void:
	if rounds <= 0 or squares.is_empty():
		return
	persistent_aoe_hazards.append({
		"name": hazard_name,
		"squares": squares.duplicate(),
		"rounds_remaining": rounds,
		"damage_dice": damage_dice,
		"damage_flat": damage_flat,
		"ignore_armour": ignore_armour,
		"ablaze_stacks": ablaze_stacks,
	})

## Union of every currently-active hazard's own `squares` Dictionary,
## flattened to one Vector2i -> true set -- shared by the ground fire
## visual (_render_turn_order_panel()'s own grid_view.set_state() call)
## and _advance_toward()'s own movement-cost avoidance below, so both
## agree on exactly what counts as "on fire right now" from one place.
func _ground_fire_squares_union() -> Dictionary:
	var seen: Dictionary = {}
	for hz: Dictionary in persistent_aoe_hazards:
		for s in hz.get("squares", {}):
			seen[s] = true
	return seen

## Same union, for active_smoke_clouds — shared by the Smoke Breath
## visual (_render_turn_order_panel()'s own grid_view.set_state() call)
## just like _ground_fire_squares_union() above is for the flame.
func _smoke_squares_union() -> Dictionary:
	var seen: Dictionary = {}
	for cloud: Dictionary in active_smoke_clouds:
		for s in cloud.get("squares", {}):
			seen[s] = true
	return seen

## Shared damage/soak/Ablaze application for one hazard hitting one
## character -- same math for both ways a hazard actually hits someone
## (standing in it when a Round ticks, below, or walking through it
## mid-move, see _check_ground_fire_crossing() below), just phrased
## differently in the combat log so a "lingering tick" doesn't read
## identically to a "just stepped in it" hit. `verb_phrase` is dropped
## straight into "%s <verb_phrase> %s" (character name, then hazard
## name), e.g. "is caught in the"/"strides through the".
func _apply_ground_fire_hit(c: Character, hz: Dictionary, verb_phrase: String) -> void:
	var dmg: int = hz["damage_flat"]
	if hz["damage_dice"] != "":
		dmg += Dice.roll_dice_string(hz["damage_dice"])
	var soak: int = c.get_characteristic_bonus("toughness") + (0 if hz["ignore_armour"] else c.get_armour_points("Body"))
	var wounds: int = max(1, dmg - soak)
	c.take_wounds(wounds)
	if int(hz["ablaze_stacks"]) > 0:
		c.add_condition("Ablaze", hz["ablaze_stacks"])
	_add_notice("[color=#c9564b]%s %s %s — %d Wound(s)%s (now %d/%d).[/color]" % [
		c.character_name, verb_phrase, hz["name"], wounds,
		(" and +%d Ablaze" % int(hz["ablaze_stacks"])) if int(hz["ablaze_stacks"]) > 0 else "",
		c.wounds_current, c.wounds_max,
	])
	_check_for_kill_xp(c)

## Ticks every registered ground hazard once -- called only on a
## genuine Round wrap (see _next_turn()'s own round_number !=
## round_before gate, same "only once per real Round, not per Turn"
## timing _tick_fear_extended_tests() already uses). Anyone (ally OR
## adversary -- the ground doesn't pick sides) standing on any of a
## hazard's own squares takes that hazard's damage and Ablaze stacks,
## via the same footprint-aware overlap check _resolve_aoe_cast's own
## targeting already uses (so a Large/Enormous creature counts as
## caught if ANY cell of its footprint overlaps). Each hazard's own
## rounds_remaining counts down AFTER applying this tick's damage
## (so a Duration of "Willpower Bonus Rounds" really does tick that
## many times, starting the Round after the one it was cast in), and
## is dropped from the array entirely once it reaches 0 -- the whole
## reason this doesn't need any bespoke removal call anywhere else.
## Per the request ("walking through hazard like fire on the ground
## should dmg just like stopping in it"): this only ever covers whoever
## is standing in the fire at the instant a Round wraps -- someone who
## crosses it mid-Turn and ends up elsewhere is covered separately by
## _check_ground_fire_crossing(), called right where a move commits.
func _tick_persistent_aoe_hazards() -> void:
	if persistent_aoe_hazards.is_empty():
		return
	var living: Array = encounter.get_living("ally") + encounter.get_living("adversary")
	var still_active: Array = []
	for hz: Dictionary in persistent_aoe_hazards:
		var squares: Dictionary = hz["squares"]
		for c: Character in living:
			if not battle_positions.has(c) or encounter.is_defeated(c):
				continue
			var caught := false
			for sq in BattleGrid.footprint_cells(battle_positions[c], c.get_footprint_size()):
				if squares.has(sq):
					caught = true
					break
			if not caught:
				continue
			_apply_ground_fire_hit(c, hz, "is caught in the")
		hz["rounds_remaining"] -= 1
		if hz["rounds_remaining"] > 0:
			still_active.append(hz)
		else:
			_add_notice("[color=#8fbf6a]The %s dies down.[/color]" % hz["name"])
	persistent_aoe_hazards = still_active
	_refresh_enemy_display()
	_tick_smoke_clouds()

## Adds a new Smoke-type Breath cloud covering `squares` for `rounds`
## Rounds — see active_smoke_clouds' own declaration comment for the
## refcounted blocks_los shape. A square that's already a real wall (or
## already smoked by an earlier overlapping cloud) is harmless to add
## again; the refcount just goes up an extra notch and comes back down
## the same way when this cloud itself expires.
func _add_smoke_cloud(squares: Dictionary, rounds: int) -> void:
	if rounds <= 0 or squares.is_empty() or battle_grid == null:
		return
	for sq in squares:
		_smoke_square_refcount[sq] = int(_smoke_square_refcount.get(sq, 0)) + 1
		battle_grid.blocks_los[sq] = true
	active_smoke_clouds.append({"squares": squares.duplicate(), "rounds_remaining": rounds})

## Ticked alongside persistent_aoe_hazards, once per real Round wrap —
## decrements every active cloud's own Round counter, and un-blocks any
## square whose LAST covering cloud has just dispersed (see the refcount
## comment on active_smoke_clouds).
func _tick_smoke_clouds() -> void:
	if active_smoke_clouds.is_empty():
		return
	var still_active: Array = []
	for cloud: Dictionary in active_smoke_clouds:
		cloud["rounds_remaining"] -= 1
		if cloud["rounds_remaining"] > 0:
			still_active.append(cloud)
		else:
			_release_smoke_cloud(cloud["squares"])
			_add_notice("[color=#8fbf6a]The choking smoke finally clears.[/color]")
	active_smoke_clouds = still_active

## Drops one cloud's own refcount contribution from every square it
## covered, only actually un-blocking sight (battle_grid.blocks_los)
## once nothing else still needs that square smoked.
func _release_smoke_cloud(squares: Dictionary) -> void:
	if battle_grid == null:
		return
	for sq in squares:
		var remaining: int = int(_smoke_square_refcount.get(sq, 1)) - 1
		if remaining > 0:
			_smoke_square_refcount[sq] = remaining
		else:
			_smoke_square_refcount.erase(sq)
			battle_grid.blocks_los.erase(sq)

## Full teardown — called at the exact same three reset points
## persistent_aoe_hazards.clear() already is (see that var's own
## declaration comment), so a Smoke cloud from one fight/room can never
## leak into the next and leave stray squares permanently sight-blocked.
func _clear_active_smoke_clouds() -> void:
	for cloud: Dictionary in active_smoke_clouds:
		_release_smoke_cloud(cloud["squares"])
	active_smoke_clouds.clear()
	_smoke_square_refcount.clear()

## Per the request ("walking through hazard like fire on the ground
## should dmg just like stopping in it"): _tick_persistent_aoe_hazards()
## above only ever catches whoever is standing in a hazard at the exact
## instant a Round wraps -- someone who moved INTO burning ground and
## back out again within the same Turn, without ever being there at a
## Round boundary, used to take nothing at all. Called right after a
## move actually commits (both the player's own move and every monster
## move via _advance_toward()), with the list of squares the mover just
## stepped onto. `entered_squares` follows BattleGrid.find_path()'s own
## return convention -- includes the destination, not the start square
## -- so this is exactly "every square newly entered this move," not
## wherever the mover already was. One hit per hazard actually entered,
## not per square of it crossed -- matches Firewall's own book wording
## ("anyone crossing... suffers a hit," a single crossing, not one
## stack per square of a wide wall) -- via the same _apply_ground_fire_
## hit() math _tick_persistent_aoe_hazards() itself uses, just phrased
## as a crossing rather than a lingering tick. A mover who ALSO ends
## their move standing in the hazard still gets the usual Round-start
## tick too, same as anyone else caught there when the Round wraps --
## that's correct, not a double-count of the same event: one hit for
## walking through the flame, a separate one for however much longer
## they go on standing in it.
func _check_ground_fire_crossing(actor: Character, entered_squares: Array) -> void:
	if persistent_aoe_hazards.is_empty() or entered_squares.is_empty():
		return
	if not battle_positions.has(actor) or encounter.is_defeated(actor):
		return
	var footprint: int = actor.get_footprint_size()
	for hz: Dictionary in persistent_aoe_hazards:
		var squares: Dictionary = hz["squares"]
		var crossed := false
		for step_sq in entered_squares:
			for fc in BattleGrid.footprint_cells(step_sq, footprint):
				if squares.has(fc):
					crossed = true
					break
			if crossed:
				break
		if crossed:
			_apply_ground_fire_hit(actor, hz, "strides through the")

## Which Channelling specialisations the player has actually purchased
## Skill advances in (e.g. "Fire" from "Channelling (Fire)" in
## skill_advances) — one Channel action button per specialisation
## known, per the request.
##
## Explicitly excludes "Any Colour" (and any other unresolved "(Any
## ...)" leftover) — per the book, you can only Channel a specific Wind
## you've actually learned; "Any Colour" was never a real option to
## Channel by itself, only ever a placeholder qualifier meant to be
## resolved into one specific Wind at purchase time. This is a genuine
## defensive filter, not just cosmetic: it guards against this button
## reappearing from any stale/legacy skill_advances data (e.g. an
## earlier session, before the "(Any ...)" purchase-resolution fix,
## that stored the literal unresolved string), not just the current
## purchase path.
func _get_known_channelling_specs() -> Array[String]:
	var specs: Array[String] = []
	for key in player.skill_advances.keys():
		var key_str: String = key
		if key_str.begins_with("Channelling (") and player.skill_advances[key] > 0:
			var spec: String = key_str.trim_prefix("Channelling (").trim_suffix(")")
			if not Advancement.is_any_qualifier("(%s)" % spec):
				specs.append(spec)
	return specs

## Channelling (p.237): an Extended Test that powers up a Wind of Magic
## generally, not one spell picked in advance — per the request, and
## matching the book's own "Arcane Spells" rule (p.242) that treats
## Arcane spells as a single shared pool. Whichever known Arcane spell
## the player actually casts next checks its own CN against however
## much has been channelled, at cast time (see MagicResolver.
## is_channelled_for). Doesn't apply to Petty spells at all — they
## already have CN 0 and can't be reduced further.
## A single Channel button (so hotkey X always maps to exactly one
## action) plus a small Magic Type selector when the player knows more
## than one Channelling specialisation — replacing the previous
## one-button-per-Lore layout, per the request. _selected_channel_lore
## tracks which Lore the button currently applies to; defaults to the
## first known spec (or whatever was already selected, if it's still
## valid) rather than resetting every rebuild.
## `into_row`, when given, merges the lore picker/Channel button into an
## existing row (used to keep Channel on the same packed action_row line
## as everything else — see _prompt_player_turn) rather than building
## its own, mirroring the same pattern _add_spell_or_prayer_row already
## uses for Cast/Pray.
func _add_channelling_row(specs: Array[String], into_row: HFlowContainer = null) -> HFlowContainer:
	var row: HFlowContainer = into_row
	if row == null:
		row = HFlowContainer.new()
		row.add_theme_constant_override("separation", 8)
	if not specs.has(_selected_channel_lore):
		_selected_channel_lore = specs[0]

	if specs.size() > 1:
		var type_picker := OptionButton.new()
		type_picker.add_theme_font_size_override("font_size", 8)
		for i in range(specs.size()):
			type_picker.add_item(specs[i])
			if specs[i] == _selected_channel_lore:
				type_picker.selected = i
		## Disabled while a Fortune/Dark Deal prompt is open: picking a
		## different Lore is just a display preference, not a real
		## decision the player is making about that prompt — unlike every
		## other button in this shared menu, it has nothing sensible to
		## queue through _decline_fortune_prompt_and_run(), so it's simply
		## not interactive until the prompt resolves (Channel's own button
		## right below already correctly stays disabled/greyed the whole
		## time regardless, via action_used_this_turn).
		type_picker.disabled = awaiting_fortune_choice
		type_picker.item_selected.connect(func(idx: int):
			_selected_channel_lore = specs[idx]
			_prompt_player_turn(false)
		)
		row.add_child(type_picker)

	var btn := _make_button()
	var label := "Channel  [X]"
	if _channelling_progress.has(_selected_channel_lore):
		var p: MagicResolver.ChannellingProgress = _channelling_progress[_selected_channel_lore]
		label += " (READY)" if p.critical_ready else " (%d SL)" % p.accumulated_sl
	btn.text = label
	btn.disabled = action_used_this_turn
	if btn.disabled:
		btn.tooltip_text = ACTION_USED_TOOLTIP
	btn.pressed.connect(func(): _on_channel(_selected_channel_lore))
	row.add_child(btn)
	_active_channel_button = btn
	return row

func _on_channel(lore: String) -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	if not _channelling_progress.has(lore):
		_channelling_progress[lore] = MagicResolver.ChannellingProgress.new()
	var progress: MagicResolver.ChannellingProgress = _channelling_progress[lore]

	var has_attunement := player.has_talent("Aethyric Attunement")
	var effort := _consume_effort_bonus()
	## Per the request ("channelling should allow spending fortune to
	## reroll/+1 SL, and dark deal to recast as normal"): the Channelling
	## Test used to resolve with no chance to improve or redo a bad roll
	## at all — every other Skill Test in this file already offers the
	## same Spend Fortune/Dark Deal prompt (see _offer_fortune_spend),
	## Channelling was just missing it. pre_sl/pre_critical snapshot
	## `progress` from BEFORE this attempt so a genuine "reroll"/Dark
	## Deal redo can cleanly replay the whole attempt from scratch
	## (resetting progress first) instead of stacking a second roll's SL
	## on top of the first's.
	var pre_sl := progress.accumulated_sl
	var pre_critical := progress.critical_ready
	var channel_result: Dictionary = MagicResolver.channel_round(player, progress, lore, effort[0], has_attunement)
	channel_result["test_result"].target_modifiers = effort[1]
	## Real bug fix, per the report ("I click channel, but it didnt
	## actually do it" / "it should of shown the roll card, but didnt"):
	## this used to build the whole "Fumble/Critical/accumulated SL"
	## message and only call _show_single_card() at the very END of this
	## function, AFTER the Spend Fortune/Dark Deal loop below had already
	## finished. _offer_fortune_spend()'s own comment explicitly assumes
	## the roll card it's attaching a prompt to already exists ("render
	## as a button row in the combat log, right after the roll card(s)
	## they apply to") — every other Test in this file (see
	## _apply_sprint_outcome, or _on_cast_spell's own _apply_cast_spell_
	## outcome call) shows/merges its card BEFORE offering Fortune, not
	## after. Skipping that step left a Dark Deal/Spend Fortune prompt
	## with no roll card above it at all, and the player had no visible
	## sign anything had happened until the Turn was finally ended (which
	## itself just silently declines the pending prompt) and the delayed
	## card appeared. _show_channel_card() below now shows the card right
	## away, and again (merged into the same card) after every reroll —
	## exactly like Sprint's own _apply_sprint_outcome(test, merge).
	_show_channel_card(lore, progress, channel_result, false)
	_render_status()

	var choice := await _offer_fortune_spend(channel_result["test_result"])
	while choice == "reroll" or choice == "sl":
		if choice == "reroll":
			## Dark Deal normalises to "reroll" too (see
			## _offer_fortune_spend's own comment) — recast the whole
			## Channelling Test as normal, same as any other reroll.
			progress.accumulated_sl = pre_sl
			progress.critical_ready = pre_critical
			channel_result = MagicResolver.channel_round(player, progress, lore, effort[0], has_attunement)
			channel_result["test_result"].target_modifiers = effort[1]
		elif not channel_result["test_result"].is_fumble and not channel_result["test_result"].is_critical:
			## "sl" doesn't reroll — _offer_fortune_spend already bumped
			## test_result.success_levels by 1 directly; accumulated_sl
			## needs the same +1 to actually reflect it in what this
			## Channelling attempt banked (a Fumble/Critical Channel's own
			## effect on progress doesn't scale with success_levels at
			## all, so there's nothing to add on top of either of those).
			progress.accumulated_sl += 1
		_show_channel_card(lore, progress, channel_result, true)
		_render_status()
		choice = await _offer_fortune_spend(channel_result["test_result"])

	await _wait_for_continue_after_own_action()
	_finish_player_action()

## Shared by _on_channel() for both the initial roll and every reroll
## afterward (merge=true merges into the same card instead of adding a
## new one) — mirrors _apply_sprint_outcome's identical "show/merge card
## before offering Fortune" shape. Builds the same "Fumble/Critical/
## accumulated SL" messaging _on_channel used to only ever build once,
## right at the very end.
func _show_channel_card(lore: String, progress: MagicResolver.ChannellingProgress, channel_result: Dictionary, merge: bool) -> void:
	var extra: Array[String] = []
	if channel_result["test_result"].is_fumble:
		extra.append("Fumble! All %s magic channelled so far is lost." % lore)
		if not channel_result["miscast"].is_empty():
			extra.append("Major Miscast: " + _apply_and_describe_miscast(player, channel_result["miscast"]))
	elif progress.critical_ready and channel_result["test_result"].is_critical:
		extra.append("Critical Channelling! Ready to cast a %s spell at CN 0, regardless of its Casting Number — this stays ready until you actually cast, not just for the next Round." % lore)
		if not channel_result["miscast"].is_empty():
			extra.append("Minor Miscast: " + _apply_and_describe_miscast(player, channel_result["miscast"]))
	else:
		## Real bug fix, per the report ("channelling should reduce the
		## CN by the channelling SL... partial CN reduction as well and
		## to CN 0"): accumulated_sl now reduces EVERY known spell's
		## Casting Number by that amount (see
		## MagicResolver.channelled_cn_reduction), not just the ones it
		## happens to fully cover — this message used to only ever
		## report the latter, making a real partial discount (e.g. 6 SL
		## toward a CN 10 spell) look like it did nothing at all.
		##
		## Follow-up correction: the wording used to say the discount
		## only applied "next Round," mirroring p.237's own phrasing —
		## but per the explicit follow-up ("channelling is accumulative,
		## and lasts longer than the next round"), and matching how
		## _channelling_progress is actually implemented (see its own
		## declaration comment and _on_cast_spell/_on_cast_spell_aoe's
		## `_channelling_progress.clear()`), accumulated_sl keeps
		## building for as many Rounds as the player keeps Channelling
		## and stays fully available whenever they finally do cast — it
		## is never cleared just because a Round passed. The message
		## below no longer implies a one-Round deadline that doesn't
		## actually exist.
		var ready_spells: Array[String] = []
		for spell_name in player.known_spells:
			var sp: SpellDefinition = GameData.spell_db.find_by_name(spell_name)
			if sp != null and MagicResolver.is_channelled_for(progress, sp):
				ready_spells.append(spell_name)
		if not ready_spells.is_empty():
			extra.append("Channelling %s: %d SL accumulated — enough to cast %s at CN 0 whenever you cast (and reduces any other %s spell's Casting Number by %d) — keep Channelling and it keeps building." % [lore, progress.accumulated_sl, ", ".join(ready_spells), lore, progress.accumulated_sl])
		else:
			extra.append("Channelling %s: %d SL accumulated so far — already reduces your next %s spell's Casting Number by %d, and keeps building for as many Rounds as you keep Channelling." % [lore, progress.accumulated_sl, lore, progress.accumulated_sl])
	_show_single_card(player, "Channel (%s)" % lore, "Channelling", "ally", channel_result["test_result"], extra, merge)

## A simple popup list of names anchored near the button that opened
## it — appears on click, disappears the instant something is picked
## (PopupMenu's own built-in behaviour), per the request: "a list of
## available spells pops up on screen when Cast is clicked to select
## the spell and then disappears after its selected." on_picked is
## called with the chosen name; nothing happens if the popup is
## dismissed without a selection.
func _show_name_popup(names: Array[String], anchor_button: Button, on_picked: Callable) -> void:
	var popup := NavPopupMenu.new()
	add_child(popup)
	for n in names:
		popup.add_item(n)
	popup.id_pressed.connect(func(id: int):
		popup.hide()
		on_picked.call(names[id])
	)
	popup.close_requested.connect(func(): popup.queue_free())
	popup.popup_hide.connect(func(): popup.queue_free())
	var anchor_pos: Vector2 = anchor_button.global_position + Vector2(0, anchor_button.size.y)
	popup.popup(Rect2i(Vector2i(anchor_pos), Vector2i(220, 0)))

## Same popup pattern as _show_name_popup above, but keyed on live
## Character objects (via `label_fn` for each row's display text)
## rather than a plain Array[String] -- built for Heal Ally, and
## deliberately kept generic/reusable rather than Heal-specific, so a
## later pass on ally-targeted healing MAGIC (Blessing of Healing,
## Drain, Soothe -- see _add_spell_or_prayer_row's "everything else
## defaults to the caster" comment, which is what currently forces
## every non-damage spell/prayer including those three to target only
## the caster) can reuse this exact picker instead of re-solving "which
## living ally needs treatment" from scratch. `on_picked` is called
## with the chosen Character; nothing happens if the popup is dismissed
## without a selection.
func _show_ally_target_popup(candidates: Array[Character], anchor_button: Button, label_fn: Callable, on_picked: Callable) -> void:
	var popup := NavPopupMenu.new()
	add_child(popup)
	for c in candidates:
		popup.add_item(label_fn.call(c))
	popup.id_pressed.connect(func(id: int):
		popup.hide()
		on_picked.call(candidates[id])
	)
	popup.close_requested.connect(func(): popup.queue_free())
	popup.popup_hide.connect(func(): popup.queue_free())
	var anchor_pos: Vector2 = anchor_button.global_position + Vector2(0, anchor_button.size.y)
	popup.popup(Rect2i(Vector2i(anchor_pos), Vector2i(240, 0)))

## Living, conscious allies (excluding the player -- the actor doing
## the treating, who has their own separate "Heal Self" button) who
## could actually benefit from a Heal Test: wounded, Bleeding, or
## Poisoned. An ally who is Unconscious is deliberately excluded here
## too -- see the Heal Ally button's own comment for why.
func _allies_needing_heal() -> Array[Character]:
	var result: Array[Character] = []
	if encounter == null:
		return result
	for ally in encounter.get_living("ally"):
		if ally == player or ally.conditions.has("Unconscious"):
			continue
		if ally.wounds_current < ally.wounds_max or ally.conditions.has("Bleeding") or ally.conditions.has("Poisoned"):
			result.append(ally)
	return result

## Flaming Sword of Rhuin (Lore of Fire): per the explicit request ("It
## should only allow casting it on swords"), a valid target is any
## living ally (self included — this can be self-cast) currently
## wielding an actual Sword. Matched by name suffix against this
## project's own Sword-family weapons (Sword, Bastard Sword, Fine
## Sword, Fine Bastard Sword) — deliberately excludes Swordbreaker/Fine
## Swordbreaker despite the shared substring; a parrying tool, not a
## real sword to wreathe in fire.
func _characters_wielding_sword() -> Array[Character]:
	var result: Array[Character] = []
	if encounter == null:
		return result
	for c in encounter.get_living("ally"):
		if _weapon_for(c).weapon_name.ends_with("Sword"):
			result.append(c)
	return result

## Builds just the Cast/Pray button (and, for spells, the War Wizard
## free-cast button) — no upfront name picker anymore, per the request.
## Clicking Cast opens a popup list of every known spell/prayer
## (_show_name_popup); picking one resolves its target (damage effects
## use the normal enemy-portrait selector, everything else defaults to
## the caster) and casts/prays immediately. `into_row`, when given,
## merges this button into an existing row (used to put Cast on the
## same line as Channel/Colour Effect) rather than building its own.
func _add_spell_or_prayer_row(is_spell: bool, into_row: HFlowContainer = null) -> void:
	var names: Array[String] = player.known_spells if is_spell else player.get_effective_known_prayers()
	if names.is_empty():
		return
	var row: HFlowContainer = into_row
	if row == null:
		row = HFlowContainer.new()
		row.add_theme_constant_override("separation", 8)

	var resolve_and_cast := func(chosen_name: String, is_war_wizard_free: bool):
		## Free-target AoE (Blast, Twin-tailed Comet): no selected enemy
		## needed at all — the player places the effect on the battle map
		## instead (see _enter_aoe_target_mode). Checked before the normal
		## damage-effect/selected_target gate below so these never hit it.
		var spell_def_check: SpellDefinition = GameData.spell_db.find_by_name(chosen_name) if is_spell else null
		var free_target_aoe: bool = (is_spell and spell_def_check != null and spell_def_check.is_area_of_effect) or (not is_spell and FREE_TARGET_AOE_PRAYERS.has(chosen_name))
		if free_target_aoe:
			if is_spell:
				_last_selected_spell = chosen_name
			else:
				_last_selected_prayer = chosen_name
			_enter_aoe_target_mode(is_spell, chosen_name, is_war_wizard_free)
			return
		## Flaming Sword of Rhuin (Lore of Fire): a real, mechanical
		## weapon-enchant now (see _apply_cast_spell_outcome's own
		## branch and Character.get_equipped_weapon()) — per the
		## explicit request ("It should only allow casting it on
		## swords"), restricted to whichever living ally (self included)
		## is actually wielding a Sword right now, via its own target
		## picker rather than either the enemy-portrait selector (this
		## isn't a damage effect) or the "everything else defaults to
		## the caster" fallback below (it can enchant an ally's sword
		## too, not just your own).
		if is_spell and chosen_name == "Flaming Sword of Rhuin":
			var sword_wielders := _characters_wielding_sword()
			if sword_wielders.is_empty():
				_add_notice("[color=#c9a24b]No one in your party is currently wielding a Sword — Flaming Sword of Rhuin needs one.[/color]")
				return
			_last_selected_spell = chosen_name
			_show_ally_target_popup(sword_wielders, _active_cast_button,
				func(c: Character) -> String: return "%s (%s)" % [c.character_name, _weapon_for(c).weapon_name],
				func(c: Character): _on_cast_spell(chosen_name, c, is_war_wizard_free))
			return
		## Cauterise (Lore of Fire): a real heal spell now (per the
		## explicit request), and per its own book phrasing ("upon an
		## ally") it targets a party member, not the caster — so it gets
		## its own target picker here too, reusing the exact same "who
		## actually needs treatment" candidate list (_allies_needing_heal)
		## the mundane Heal Ally action already uses, rather than either
		## the enemy-portrait selector (not a damage effect) or the
		## "everything else defaults to the caster" fallback below (which
		## would make it heal the caster, not an ally, every time).
		if is_spell and chosen_name == "Cauterise":
			var heal_candidates := _allies_needing_heal()
			if heal_candidates.is_empty():
				_add_notice("[color=#c9a24b]No one in your party currently needs Cauterise.[/color]")
				return
			_last_selected_spell = chosen_name
			_show_ally_target_popup(heal_candidates, _active_cast_button,
				func(c: Character) -> String: return "%s (%d/%d Wounds)" % [c.character_name, c.wounds_current, c.wounds_max],
				func(c: Character): _on_cast_spell(chosen_name, c, is_war_wizard_free))
			return
		var is_damage := _is_damage_effect(chosen_name, is_spell)
		var aoe_effect := not is_spell and AOE_PRAYERS.has(chosen_name)
		## Per the request: a single-target damage spell/prayer (not You,
		## not AoE, not a "Special"-target effect like Breath's cone —
		## the book's own target_text value for those) now opens the same
		## arrow-based targeting mode a ranged Attack does, rather than
		## requiring an enemy portrait pre-selected before Cast/Pray is
		## even clicked. Range comes straight from the spell/prayer's own
		## range_text (see _spell_or_prayer_range_yards) — "add range
		## data and don't allow casting out of max spell range."
		var prayer_def_check: PrayerDefinition = GameData.prayer_db.find_by_name(chosen_name) if not is_spell else null
		var target_text: String = (spell_def_check.target_text if spell_def_check != null else "") if is_spell else (prayer_def_check.target_text if prayer_def_check != null else "")
		if is_damage and not aoe_effect and target_text != "Special":
			var range_text: String = (spell_def_check.range_text if spell_def_check != null else "You") if is_spell else (prayer_def_check.range_text if prayer_def_check != null else "You")
			if is_spell:
				_last_selected_spell = chosen_name
				_enter_ranged_target_mode("spell", {"spell_name": chosen_name, "is_war_wizard_free": is_war_wizard_free}, _targets_in_spell_range(range_text))
			else:
				_last_selected_prayer = chosen_name
				_enter_ranged_target_mode("prayer", {"prayer_name": chosen_name, "is_war_wizard_free": is_war_wizard_free}, _targets_in_spell_range(range_text))
			return
		## Special-target damage effects (Breath) and every non-damage
		## spell/prayer (buffs, utility) keep the old flow: a damage
		## effect still needs the normal enemy-portrait selector
		## pre-picked; anything else just defaults to the caster.
		if is_damage and not aoe_effect and selected_target == null:
			_add_notice("[color=#c9a24b]Select an enemy portrait above before casting %s.[/color]" % chosen_name)
			return
		var final_target: Character = selected_target if (is_damage and selected_target != null) else player
		if is_spell:
			_last_selected_spell = chosen_name
			_on_cast_spell(chosen_name, final_target, is_war_wizard_free)
		else:
			_last_selected_prayer = chosen_name
			_on_pray(chosen_name, final_target)

	var btn := _make_button()
	btn.text = "Cast  [C]" if is_spell else "Pray  [T]"
	## Casting a normal (non-free) Spell, or Praying, both use the Action
	## (the War Wizard free-cast branch below is the one exception — it
	## explicitly doesn't use the Action, so it isn't gated on
	## action_used_this_turn).
	btn.disabled = (is_spell and war_wizard_used_this_turn) or action_used_this_turn
	if action_used_this_turn:
		btn.tooltip_text = ACTION_USED_TOOLTIP
	elif is_spell and war_wizard_used_this_turn:
		btn.tooltip_text = "You've already cast your free spell this turn (War Wizard)."
	btn.pressed.connect(func():
		_show_name_popup(names, btn, func(chosen_name: String): resolve_and_cast.call(chosen_name, false))
	)
	row.add_child(btn)
	if is_spell:
		_active_cast_button = btn
	else:
		_active_pray_button = btn

	## War Wizard (p.132): "you may cast one Spell with a Casting Number
	## of 5 or less for free without using your Action." The popup here
	## is pre-filtered to only spells that actually qualify — checked
	## against each spell's real effective CN (Channelling's CN-0
	## discount counts), not just its printed one.
	if is_spell and player.get_talent_rank("War Wizard") > 0 and not war_wizard_used_this_turn:
		var qualifying: Array[String] = []
		for n in names:
			var sp: SpellDefinition = GameData.spell_db.find_by_name(n)
			if sp != null and _get_effective_cn(sp) <= 5:
				qualifying.append(n)
		if not qualifying.is_empty():
			var free_btn := _make_button()
			free_btn.text = "Cast Free (War Wizard)"
			free_btn.pressed.connect(func():
				_show_name_popup(qualifying, free_btn, func(chosen_name: String): resolve_and_cast.call(chosen_name, true))
			)
			row.add_child(free_btn)

	if into_row == null:
		target_container.add_child(row)

## The spell's actual Casting Number once Channelling's discount is
## factored in — shared by the normal cast flow and War Wizard's
## CN-5-or-less eligibility check, so both agree on what "the CN"
## means for a given cast.
## Real bug fix: this used to only ever return 0 (fully channelled) or
## the spell's full, un-discounted CN — nothing in between — so 6 SL
## accumulated toward a CN 10 spell paid off exactly as much as 0 SL
## would have. Now takes the BEST available partial-or-full reduction
## across every Lore currently being Channelled (see
## MagicResolver.channelled_cn_reduction's own comment for why it's
## always the caster's own strongest Channelling, not summed across
## Lores — accumulated_sl per Lore already represents everything banked
## into that one Wind).
func _get_effective_cn(spell: SpellDefinition) -> int:
	var best_reduction := 0
	for lore in _channelling_progress.keys():
		var reduction: int = MagicResolver.channelled_cn_reduction(_channelling_progress[lore], spell)
		if reduction > best_reduction:
			best_reduction = reduction
	return max(0, spell.casting_number - best_reduction)

## Overcasting (Winds of Magic p.20-23): "Overcast: SL beyond those
## required to cast the spell" — subtracts the spell's effective CN
## directly from the Test's own success_levels right after the roll,
## so the card's actual "Success Level" row shows the net value the
## spell has to work with (and what's left over for Overcasting), not
## just the raw Language (Magick) roll with the CN's effect buried in
## a separate line of text afterward. A real, visible "−4 Casting
## Number" breakdown entry is added alongside it — the same labeled
## pattern every other post-roll SL change in this project uses (see
## Fortune Point's own +1 SL) — rather than silently changing the
## number with no way for the player to see why. Doesn't touch
## cast_result.success or cast_result.overcast_sl, which were already
## correctly determined inside MagicResolver.cast() using the real raw
## SL — only the display value (and its own breakdown) changes here.
## `effective_cn` is the ALREADY-Channelling-discounted CN (see
## _get_effective_cn) — the same value handed to MagicResolver.cast()
## for this exact attempt, so the displayed breakdown always matches
## what actually decided success/failure, whether that's a full,
## partial, or zero discount.
func _apply_cn_to_displayed_sl(cast_result: MagicResolver.CastResult, effective_cn: int) -> void:
	if not cast_result.test_result.success:
		return
	if effective_cn <= 0:
		return
	cast_result.test_result.success_levels -= effective_cn
	cast_result.test_result.sl_breakdown.append({"name": "Casting Number", "amount": -effective_cn})

## Resolves a free-target AoE cast (Blast/Twin-tailed Comet) centered on
## `square` — the equivalent of _on_cast_spell/_on_pray for these two,
## except there's no single selected Character to hand off, so the
## affected target list is computed here from squares_within_radius and
## handed to the dedicated AoE cast/pray functions below.
func _resolve_aoe_cast(square: Vector2i) -> void:
	if not aoe_target_mode_active or not awaiting_player_target:
		return
	var is_spell: bool = _pending_aoe_cast.get("is_spell", true)
	var effect_name: String = _pending_aoe_cast.get("name", "")
	var is_war_wizard_free: bool = _pending_aoe_cast.get("is_war_wizard_free", false)
	if action_used_this_turn and not is_war_wizard_free:
		return
	_exit_aoe_target_mode()
	awaiting_player_target = false
	_clear(target_container)
	if not is_war_wizard_free:
		action_used_this_turn = true

	var radius: int = _aoe_radius_squares(is_spell)
	var hit_squares: Array = battle_grid.squares_within_radius(square, radius) if battle_grid != null else [square]
	var hit_set: Dictionary = {}
	for s in hit_squares:
		hit_set[s] = true
	## Per the request ("allow large creatures to be hit in any of the
	## cells it occupies, not only top left one"): a multi-square
	## adversary now counts as caught in the blast if ANY cell of its
	## footprint falls in the hit area, not just its anchor cell — matches
	## the same footprint-aware fix applied to melee/ranged/hover
	## targeting above.
	var targets: Array = []
	for m in encounter.get_living("adversary"):
		if not battle_positions.has(m):
			continue
		for sq in BattleGrid.footprint_cells(battle_positions[m], m.get_footprint_size()):
			if hit_set.has(sq):
				targets.append(m)
				break

	if is_spell:
		## hit_set/square threaded through for Great Fires of U'Zhul
		## (needs to know which exact square was clicked, to tell its
		## own primary target apart from splash) and Firewall (needs
		## the actual hit squares, to lay down its own lingering fire
		## on the same ground) — see _apply_cast_spell_outcome_aoe's
		## own bespoke branches for both. Every other AoE spell simply
		## ignores these two extra arguments.
		await _on_cast_spell_aoe(effect_name, targets, is_war_wizard_free, hit_set, square)
	else:
		await _on_pray_aoe(effect_name, targets)

func _on_cast_spell(spell_name: String, target: Character, is_war_wizard_free: bool = false) -> void:
	## War Wizard's free cast doesn't use the Action (see below), so it's
	## the one Cast path allowed through even after the Action's already
	## spent this turn.
	if not awaiting_player_target or (action_used_this_turn and not is_war_wizard_free):
		return
	## See _is_players_own_turn()'s own comment — same guard every other
	## Action-initiating handler in this file now carries.
	if not _is_players_own_turn():
		_clear(target_container)
		_clear(side_actions_container)
		return
	awaiting_player_target = false
	_clear(target_container)
	if not is_war_wizard_free:
		action_used_this_turn = true
	var spell: SpellDefinition = GameData.spell_db.find_by_name(spell_name)
	var effort := _consume_effort_bonus()
	## Channelling (p.237): "each SL scored on the Channelling Test
	## reduces the Casting Number of a spell cast within the next round
	## by 1, to a minimum of 0" — a real, partial, 1-for-1 discount
	## (see _get_effective_cn/MagicResolver.channelled_cn_reduction's
	## own comments for the bug this fixed: 6 SL accumulated toward a
	## CN 10 spell used to pay off NOTHING at all, only ever kicking in
	## once accumulated_sl reached the spell's full CN). Checked across
	## every Lore the player has been channelling, since Channelling
	## powers up a Wind generally rather than one spell chosen upfront.
	## Petty spells never qualify — they already have CN 0.
	var effective_cn := _get_effective_cn(spell)
	var was_channelled: bool = effective_cn < spell.casting_number
	var cast_result := MagicResolver.cast(player, spell, effort[0], effective_cn)
	cast_result.test_result.target_modifiers = effort[1]
	_apply_cn_to_displayed_sl(cast_result, effective_cn)
	var prev_delta := {"target_wounds": 0, "caster_wounds": 0}
	prev_delta = _apply_cast_spell_outcome(cast_result, spell, spell_name, target, false, effective_cn)
	_render_status()

	var choice := await _offer_fortune_spend(cast_result.test_result)
	while choice == "reroll" or choice == "sl":
		if choice == "reroll":
			cast_result = MagicResolver.cast(player, spell, effort[0], effective_cn)
			cast_result.test_result.target_modifiers = effort[1]
			_apply_cn_to_displayed_sl(cast_result, effective_cn)
		## Undo the previous attempt's Wound changes before reapplying —
		## target.take_wounds() and the caster's own Drain self-heal
		## both already happened once; a redo shouldn't stack on top.
		target.wounds_current = min(target.wounds_max, target.wounds_current + prev_delta["target_wounds"])
		player.wounds_current = max(0, player.wounds_current - prev_delta["caster_wounds"])
		## Same reasoning, generalized for a spell that hits MULTIPLE
		## characters at once (Breath's own line+burst struck set — see
		## "wound_deltas" on _apply_cast_spell_outcome's own initial delta
		## dict) rather than just the one target_wounds/caster_wounds
		## pair above — mirrors _on_pray's own identical wound_deltas
		## redo handling.
		for character_ref in prev_delta.get("wound_deltas", {}):
			var wd_amount: int = prev_delta["wound_deltas"][character_ref]
			character_ref.wounds_current = clamp(character_ref.wounds_current + wd_amount, 0, character_ref.wounds_max)
		## Same reasoning, for a Crown of Flame/Flaming Hearts-style spell
		## buff (see _apply_cast_spell_outcome's "buff_added" comment):
		## pop the previous attempt's active_buffs entry back off before
		## reapplying, mirroring _on_pray's own identical redo handling
		## for Blessings, so a redo can never leave two stacked entries
		## (or, if the redo's new roll fails outright, a stale one) behind.
		if prev_delta.get("buff_added", false) and not target.active_buffs.is_empty():
			target.active_buffs.pop_back()
		prev_delta = _apply_cast_spell_outcome(cast_result, spell, spell_name, target, true, effective_cn)
		_render_status()
		choice = await _offer_fortune_spend(cast_result.test_result)

	## Channelling is a continuous act of concentration (p.237); actually
	## attempting to cast — any spell, any outcome, whether or not this
	## particular cast used the Channelled discount — breaks that
	## concentration and disperses whatever was built up across every
	## Lore, not just the one used for this specific cast. Per the
	## request: "any accumulated Channeling SLs should be removed after
	## attempting to cast the next spell even if it fails to cast."
	## The Minor Miscast penalty stays scoped to a genuinely Channelled
	## cast that then failed, though — that's a real cost of wasting
	## built-up energy, not a blanket penalty for casting at all.
	if was_channelled and not cast_result.test_result.success:
		var extra_miscast := MagicResolver.roll_minor_miscast()
		if not extra_miscast.is_empty():
			_add_notice("[color=#c98a6a]The channelled magic writhes free — Minor Miscast: %s[/color]" % _apply_and_describe_miscast(player, extra_miscast))
	_channelling_progress.clear()

	## Overcasting (Winds of Magic p.23, superseding the core rulebook's
	## simpler rule): success_levels is already the net value here —
	## _apply_cn_to_displayed_sl subtracted the CN right after the roll
	## (and any Fortune Point SL bump since then simply added to that
	## same net value) — so no further CN subtraction is needed.
	if cast_result.test_result.success:
		var final_overcast_sl: int = max(0, cast_result.test_result.success_levels)
		## Flaming Sword of Rhuin's own Overcasting (Targets/Duration
		## only, no Damage column — see _offer_flaming_sword_overcast's
		## own comment) takes over from the generic _offer_overcasting()
		## for exactly this spell, the same way _apply_prayer_buff_effect/
		## _offer_blessing_overcast already split off from the plain
		## damage-spell Overcast path for Blessings.
		var flaming_sword_shape: Dictionary = prev_delta.get("flaming_sword_shape", {})
		## Crown of Flame/Flaming Hearts' own Overcasting: same split-off
		## as Flaming Sword just above, one step further down the elif
		## chain — a Duration/Targets-only picker (_offer_buff_spell_
		## overcast, shared with any future spell-granted timed buff)
		## instead of the damage-spell path, since neither of these two
		## spells deals any Damage at all for that path to act on.
		var buff_shape: Dictionary = prev_delta.get("buff_shape", {})
		if not flaming_sword_shape.is_empty():
			await _offer_flaming_sword_overcast(target, final_overcast_sl, flaming_sword_shape)
		elif not buff_shape.is_empty():
			await _offer_buff_spell_overcast(spell_name, target, final_overcast_sl, buff_shape)
		else:
			await _offer_overcasting(spell, spell_name, target, final_overcast_sl, cast_result.test_result.success_levels)

	## War Wizard (p.132): "you may cast one Spell with a Casting Number
	## of 5 or less for free without using your Action. However, if you
	## do this, you may not cast another spell this Turn." The free
	## cast doesn't consume the Turn — return to the same Turn's action
	## menu instead of advancing — but using it (successfully invoked,
	## regardless of whether the cast itself then succeeds or fails)
	## still blocks any further spellcasting this Turn.
	if is_war_wizard_free:
		war_wizard_used_this_turn = true
		_prompt_player_turn(false)
		return

	_finish_player_action()

## Flaming Sword of Rhuin's own Overcasting — mirrors
## _offer_blessing_overcast()'s exact Duration/Targets pattern (2 SL per
## stage, Duration MULTIPLIES the base Rounds x2/x3/... rather than a
## flat top-up, Targets adds +1 extra Sword-wielding ally per stage,
## picked from living allies other than the one already enchanted) —
## but per the explicit request ("overcast should allow more targets
## and duration only, not extra dmg") this deliberately has NO Damage
## column at all: the +Willpower Bonus Damage this spell grants is
## fixed once at cast time (`shape["dmg_bonus"]`) and never rescaled by
## Overcast SL, for the original target OR any extra one bought here.
func _offer_flaming_sword_overcast(original_target: Character, sl: int, shape: Dictionary) -> void:
	var max_stages: int = int(sl / 2.0)
	if max_stages < 1:
		return

	var candidates: Array[Character] = []
	for c in _characters_wielding_sword():
		if c != original_target:
			candidates.append(c)
	var max_targets: int = min(max_stages, candidates.size())

	awaiting_overcast_choice = true
	_pending_choice_str = ""
	var chosen: Array[Character] = []

	var col := _build_scoped_column("Magic / Prayers")
	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override("separation", 3)
	col.get_parent().add_child(vbox)
	var header := Label.new()
	header.text = "Flaming Sword Overcast: %d SL available to spend (2 SL per stage)." % sl
	header.autowrap_mode = TextServer.AUTOWRAP_WORD
	header.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
	header.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	vbox.add_child(header)

	var remaining_row := HBoxContainer.new()
	remaining_row.add_theme_constant_override("separation", 6)
	var remaining_label := Label.new()
	remaining_label.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	remaining_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	remaining_row.add_child(remaining_label)
	vbox.add_child(remaining_row)

	var duration_picker := OptionButton.new()
	duration_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	duration_picker.add_item("Duration: skip")
	for stage in range(1, max_stages + 1):
		duration_picker.add_item("Duration: %d SL → x%d Duration" % [stage * 2, stage + 1])
	remaining_row.add_child(duration_picker)

	var target_picker := OptionButton.new()
	target_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	var candidate_row := HFlowContainer.new()
	candidate_row.add_theme_constant_override("separation", 4)
	if max_targets >= 1:
		target_picker.add_item("Targets: skip")
		for n in range(1, max_targets + 1):
			target_picker.add_item("Targets: %d SL → +%d Sword(s)" % [n * 2, n])
		remaining_row.add_child(target_picker)
		for c in candidates:
			var btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			btn.text = "%s (%s)" % [c.character_name, _weapon_for(c).weapon_name]
			btn.toggle_mode = true
			btn.pressed.connect(func():
				if btn.button_pressed:
					chosen.append(c)
				else:
					chosen.erase(c)
			)
			candidate_row.add_child(btn)
		vbox.add_child(candidate_row)

	var update_remaining := func():
		var duration_spend: int = duration_picker.selected * 2 if duration_picker.selected > 0 else 0
		var targets_spend: int = target_picker.selected * 2 if (max_targets >= 1 and target_picker.selected > 0) else 0
		var remaining: int = sl - duration_spend - targets_spend
		if remaining < 0:
			remaining_label.text = "Overspent by %d SL — reduce a choice." % -remaining
			remaining_label.add_theme_color_override("font_color", Color(0.85, 0.35, 0.3))
		else:
			remaining_label.text = "%d SL remaining" % remaining
			remaining_label.add_theme_color_override("font_color", Color(0.55, 0.75, 0.4) if remaining > 0 else Color(0.75, 0.6, 0.4))
	update_remaining.call()
	duration_picker.item_selected.connect(func(_index): update_remaining.call())
	if max_targets >= 1:
		target_picker.item_selected.connect(func(_index): update_remaining.call())

	var status_label_local := Label.new()
	status_label_local.add_theme_font_size_override("font_size", 7)
	status_label_local.add_theme_color_override("font_color", Color(0.75, 0.6, 0.4))
	vbox.add_child(status_label_local)

	var confirm_row := HBoxContainer.new()
	confirm_row.add_theme_constant_override("separation", 6)
	var confirm_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	confirm_btn.text = "Confirm Overcast  [C]"
	confirm_btn.pressed.connect(func():
		var duration_spend: int = duration_picker.selected * 2 if duration_picker.selected > 0 else 0
		var targets_spend: int = target_picker.selected * 2 if (max_targets >= 1 and target_picker.selected > 0) else 0
		if duration_spend + targets_spend > sl:
			status_label_local.text = "That spends %d SL, but only %d is available — reduce a choice." % [duration_spend + targets_spend, sl]
			return
		var wanted_targets: int = target_picker.selected if (max_targets >= 1 and target_picker.selected > 0) else 0
		if chosen.size() != wanted_targets:
			status_label_local.text = "You've selected %d extra Sword(s), but this spend buys %d — pick exactly that many." % [chosen.size(), wanted_targets]
			return
		_pending_choice_str = "confirm"
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(confirm_btn)
	_active_overcast_confirm_button = confirm_btn
	var skip_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	skip_btn.text = "Skip Overcasting  [Enter]"
	skip_btn.pressed.connect(func():
		_pending_choice_str = ""
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(skip_btn)
	_active_overcast_skip_button = skip_btn
	_active_primary_hotkey_button = skip_btn
	col.add_child(confirm_row)
	_auto_focus_default_button()

	while awaiting_overcast_choice:
		await get_tree().process_frame
	_clear(target_container)

	if _pending_choice_str != "confirm":
		return

	var duration_stage: int = duration_picker.selected
	var targets_count: int = target_picker.selected if max_targets >= 1 else 0
	var final_rounds: int = int(shape["rounds"]) * (duration_stage + 1)

	var lines: Array[String] = []
	if duration_stage > 0:
		original_target.flaming_sword_rounds_remaining = final_rounds
		lines.append("%s's Flaming Sword Duration multiplied to x%d (%d Rounds)" % [original_target.character_name, duration_stage + 1, final_rounds])

	for c in chosen.slice(0, targets_count):
		var original_name: String = _weapon_for(c).weapon_name
		var extra_weapon := _weapon_for(c).duplicate(true) as WeaponDefinition
		extra_weapon.weapon_name = "Flaming Sword of Rhuin"
		## Same fixed SB+6 + Impact as the original target's own enchant
		## above (see _apply_cast_spell_outcome's "Flaming Sword of
		## Rhuin" branch) — an extra Overcast target gets the identical
		## real weapon stats, never a bigger bonus, per the original
		## request's own "not extra dmg" rule for this spell's Overcast.
		extra_weapon.damage_flat = 6
		if not extra_weapon.qualities.has("Impact"):
			extra_weapon.qualities.append("Impact")
		c.flaming_sword_weapon = extra_weapon
		c.flaming_sword_item_name = c.equipped_weapon
		c.flaming_sword_rounds_remaining = final_rounds
		weapons[c] = extra_weapon
		lines.append("%s's %s also bursts into flame (%d Rounds)" % [c.character_name, original_name, final_rounds])

	_render_status()
	if not lines.is_empty():
		_add_notice("[color=#8fbf6a]Overcast (Flaming Sword of Rhuin): %s[/color]" % ", ".join(lines))

## Shared Overcasting for any spell whose own effect is a plain timed
## Characteristic/Damage buff via Character.add_timed_buff (Crown of
## Flame, Flaming Hearts today; any future spell shaped the same way
## tomorrow) — mirrors _offer_blessing_overcast()'s exact Duration/
## Targets pattern (2 SL per stage, Duration MULTIPLIES the base Rounds
## x2/x3/... rather than a flat top-up, Targets adds +1 extra living
## ally per stage) one-for-one, just sourced from `buff_shape` (a
## spell's own delta["buff_shape"], shaped exactly like
## _apply_prayer_buff_effect()'s return value) instead of a Blessing's.
## No Damage column, same reasoning Flaming Sword's own picker has one:
## neither of these spells deals any Damage at all for one to act on.
func _offer_buff_spell_overcast(spell_name: String, original_target: Character, sl: int, buff_shape: Dictionary) -> void:
	var max_stages: int = int(sl / 2.0)
	if max_stages < 1:
		return

	var candidates: Array[Character] = []
	for ally in encounter.get_living("ally"):
		if ally != original_target:
			candidates.append(ally)
	var max_targets: int = min(max_stages, candidates.size())

	awaiting_overcast_choice = true
	_pending_choice_str = ""
	var chosen: Array[Character] = []

	var col := _build_scoped_column("Magic / Prayers")
	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override("separation", 3)
	col.get_parent().add_child(vbox)
	var header := Label.new()
	header.text = "Overcast (%s): %d SL available to spend (2 SL per stage)." % [spell_name, sl]
	header.autowrap_mode = TextServer.AUTOWRAP_WORD
	header.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
	header.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	vbox.add_child(header)

	var remaining_row := HBoxContainer.new()
	remaining_row.add_theme_constant_override("separation", 6)
	var remaining_label := Label.new()
	remaining_label.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	remaining_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	remaining_row.add_child(remaining_label)
	vbox.add_child(remaining_row)

	var duration_picker := OptionButton.new()
	duration_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	duration_picker.add_item("Duration: skip")
	for stage in range(1, max_stages + 1):
		duration_picker.add_item("Duration: %d SL → x%d Duration" % [stage * 2, stage + 1])
	remaining_row.add_child(duration_picker)

	var target_picker := OptionButton.new()
	target_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	var candidate_row := HFlowContainer.new()
	candidate_row.add_theme_constant_override("separation", 4)
	if max_targets >= 1:
		target_picker.add_item("Targets: skip")
		for n in range(1, max_targets + 1):
			target_picker.add_item("Targets: %d SL → +%d Target(s)" % [n * 2, n])
		remaining_row.add_child(target_picker)
		for c in candidates:
			var btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			btn.text = c.character_name
			btn.toggle_mode = true
			btn.pressed.connect(func():
				if btn.button_pressed:
					chosen.append(c)
				else:
					chosen.erase(c)
			)
			candidate_row.add_child(btn)
		vbox.add_child(candidate_row)

	var update_remaining := func():
		var duration_spend: int = duration_picker.selected * 2 if duration_picker.selected > 0 else 0
		var targets_spend: int = target_picker.selected * 2 if (max_targets >= 1 and target_picker.selected > 0) else 0
		var remaining: int = sl - duration_spend - targets_spend
		if remaining < 0:
			remaining_label.text = "Overspent by %d SL — reduce a choice." % -remaining
			remaining_label.add_theme_color_override("font_color", Color(0.85, 0.35, 0.3))
		else:
			remaining_label.text = "%d SL remaining" % remaining
			remaining_label.add_theme_color_override("font_color", Color(0.55, 0.75, 0.4) if remaining > 0 else Color(0.75, 0.6, 0.4))
	update_remaining.call()
	duration_picker.item_selected.connect(func(_index): update_remaining.call())
	if max_targets >= 1:
		target_picker.item_selected.connect(func(_index): update_remaining.call())

	var status_label_local := Label.new()
	status_label_local.add_theme_font_size_override("font_size", 7)
	status_label_local.add_theme_color_override("font_color", Color(0.75, 0.6, 0.4))
	vbox.add_child(status_label_local)

	var confirm_row := HBoxContainer.new()
	confirm_row.add_theme_constant_override("separation", 6)
	var confirm_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	confirm_btn.text = "Confirm Overcast  [C]"
	confirm_btn.pressed.connect(func():
		var duration_spend: int = duration_picker.selected * 2 if duration_picker.selected > 0 else 0
		var targets_spend: int = target_picker.selected * 2 if (max_targets >= 1 and target_picker.selected > 0) else 0
		if duration_spend + targets_spend > sl:
			status_label_local.text = "That spends %d SL, but only %d is available — reduce a choice." % [duration_spend + targets_spend, sl]
			return
		var wanted_targets: int = target_picker.selected if (max_targets >= 1 and target_picker.selected > 0) else 0
		if chosen.size() != wanted_targets:
			status_label_local.text = "You've selected %d extra target(s), but this spend buys %d — pick exactly that many." % [chosen.size(), wanted_targets]
			return
		_pending_choice_str = "confirm"
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(confirm_btn)
	_active_overcast_confirm_button = confirm_btn
	var skip_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	skip_btn.text = "Skip Overcasting  [Enter]"
	skip_btn.pressed.connect(func():
		_pending_choice_str = ""
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(skip_btn)
	_active_overcast_skip_button = skip_btn
	_active_primary_hotkey_button = skip_btn
	col.add_child(confirm_row)
	_auto_focus_default_button()

	while awaiting_overcast_choice:
		await get_tree().process_frame
	_clear(target_container)

	if _pending_choice_str != "confirm":
		return

	var duration_stage: int = duration_picker.selected
	var targets_count: int = target_picker.selected if max_targets >= 1 else 0
	var final_rounds: int = int(buff_shape["rounds"]) * (duration_stage + 1)

	var lines: Array[String] = []
	if duration_stage > 0 and not original_target.active_buffs.is_empty():
		var applied_buff: Dictionary = original_target.active_buffs.back()
		if applied_buff["name"] == spell_name:
			applied_buff["rounds_remaining"] = final_rounds
			lines.append("%s's %s Duration multiplied to x%d (%d Rounds)" % [original_target.character_name, spell_name, duration_stage + 1, final_rounds])

	for c in chosen.slice(0, targets_count):
		c.add_timed_buff(spell_name, "Fire", buff_shape["characteristic_bonuses"], final_rounds, buff_shape["damage_bonus"])
		lines.append("%s also gains %s (%d Rounds)" % [c.character_name, spell_name, final_rounds])

	_render_status()
	if not lines.is_empty():
		_add_notice("[color=#8fbf6a]Overcast (%s): %s[/color]" % [spell_name, ", ".join(lines)])

## Applies one attempt's spell outcome and shows/merges its card.
## Returns how many Wounds were actually dealt to the target and healed
## on the caster this attempt, so a later redo can reverse exactly that
## much before reapplying with a new result.
## Overcasting (Winds of Magic p.20-23, superseding the core rulebook's
## simpler "+2 SL = 1 generic increment" rule): "Overcasting can be
## used to add additional Range, Area of Effect, Duration, or Targets
## to the initial values listed in the spell. If the spell is a magic
## missile, Overcasting can also add to the Damage it inflicts...
## Effects can be drawn from multiple columns, but each column may
## only be accessed once per casting." Applies to any successful
## Casting Test (Petty or Arcane) that beats its CN by 1+ SL — no
## Arcane-only restriction, and the new table's lowest threshold is 1
## SL, not 2. Spells with a Target of "special" cannot use the Targets
## column at all (a real, explicit book restriction, not an oversight).
##
## This project only mechanically implements the Targets and Damage
## columns, for single-target damage spells (a magic missile, or
## Drain) whose Range isn't "You" — Range/Area of Effect have no real
## effect without battlefield position tracking, and spell buffs
## beyond the handful specifically modelled aren't tracked as timed
## effects at all, so extending their Duration wouldn't do anything
## either. A documented gap, not a silent omission — the player is
## told plainly when SL is available but nothing here can spend it.
func _offer_overcasting(spell: SpellDefinition, spell_name: String, original_target: Character, overcast_sl: int, success_levels: int) -> void:
	if overcast_sl < 1:
		return

	var is_damage_spell := spell.is_magic_missile or spell_name == "Drain"
	var qualifies_for_damage := is_damage_spell
	var qualifies_for_targets := is_damage_spell and spell.target_text == "1" and spell.range_text != "You"

	var candidates: Array[Character] = []
	if qualifies_for_targets:
		for m in encounter.get_living("adversary"):
			if m != original_target:
				candidates.append(m)
		if candidates.is_empty():
			qualifies_for_targets = false

	## Per the request: if the target already died from the base hit
	## (before any Overcasting), there's nothing left for the Damage
	## column to do — it only ever adds bonus Damage to original_target
	## or to extra targets bought via the Targets column — so skip the
	## whole prompt unless there's at least one other living target to
	## redirect the spell toward via that column.
	if original_target != null and encounter.is_defeated(original_target) and not qualifies_for_targets:
		return

	if not qualifies_for_damage and not qualifies_for_targets:
		_add_notice("[color=#8a9bc9]Overcast: %d SL available to spend (Winds of Magic table) — Range/Area of Effect/Duration extension isn't modelled in this project for %s.[/color]" % [overcast_sl, spell_name])
		return

	var damage_options: Array[int] = []
	if qualifies_for_damage:
		damage_options = MagicResolver.get_overcast_spend_options("damage", overcast_sl)
	var target_options: Array[int] = []
	if qualifies_for_targets:
		target_options = MagicResolver.get_overcast_spend_options("targets", overcast_sl)

	awaiting_overcast_choice = true
	_pending_choice_str = ""
	var chosen: Array[Character] = []
	## Per the request: confined to the Magic/Prayers column instead of
	## blanking the whole action-menu area — see _build_scoped_column.
	## `col` itself is an HFlowContainer (it's the same helper the
	## normal action-menu buttons flow into), which would lay the
	## header/pickers/rows below out side-by-side instead of stacked —
	## so this content gets its own VBox, exactly how it used to stack
	## when it was added straight into target_container (a VBox) before
	## this scoping existed.
	##
	## Per the follow-up request ("use the full size of these sections so
	## there is never a need to scroll"): that VBox is added as a sibling
	## of `col` (into `col.get_parent()`, the column's own VBoxContainer
	## wrapper) rather than as a CHILD of `col` itself. `col` is an
	## HFlowContainer, and an HFlowContainer doesn't stretch a lone child
	## to fill its own width the way a VBoxContainer stretches ITS
	## children — nesting the VBox inside `col` left it sized to only as
	## much width as its own content's minimum needed, which was
	## narrower than the actual column, forcing the header text and the
	## button row below it to wrap far more than the column's real width
	## required (this is what pushed these prompts past the bottom
	## panel's fixed height and forced a scrollbar). Parenting to
	## `col.get_parent()` instead lets it inherit that wrapper's normal
	## full-column-width stretching, the same as the column's own title
	## label already gets.
	var col := _build_scoped_column("Magic / Prayers")
	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override("separation", 3)
	col.get_parent().add_child(vbox)
	var header := Label.new()
	header.text = "Overcast: %d SL available to spend (Winds of Magic table)." % overcast_sl
	header.autowrap_mode = TextServer.AUTOWRAP_WORD
	header.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
	## Per the request ("resize this overcast text and buttons so there is
	## no need to scroll"): this whole panel used to render at the theme's
	## plain default sizes (16px labels/OptionButtons, 16px buttons) —
	## noticeably larger than the compact ACTION_COLUMN_FONT_SIZE (13) the
	## rest of the action-menu columns already use, which was enough on
	## its own to push this panel's content past the BottomPanel's fixed
	## height and force a scrollbar. Matching that same compact size here
	## (header, remaining_label, both pickers, every button below) — plus
	## tighter row/column separation — brings the whole panel back within
	## the visible area without a scrollbar, even with the Targets
	## candidate row showing.
	header.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	vbox.add_child(header)

	## Per the request: the unspent SL total updates live as the player
	## changes either dropdown, instead of only surfacing a spend problem
	## after they hit Confirm.
	##
	## Per the follow-up request ("move the Overcast Damage and target
	## drop down buttons to the right of the text"): both pickers now
	## sit on the same row as the "N SL remaining" label instead of each
	## stacked on its own full-width line below it — remaining_label
	## takes the row's expand-fill share so the pickers land flush right.
	var remaining_row := HBoxContainer.new()
	remaining_row.add_theme_constant_override("separation", 6)
	var remaining_label := Label.new()
	remaining_label.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	remaining_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	remaining_row.add_child(remaining_label)
	vbox.add_child(remaining_row)

	var damage_picker := OptionButton.new()
	damage_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	if qualifies_for_damage:
		damage_picker.add_item("Damage: skip")
		for opt in damage_options:
			damage_picker.add_item("Damage: %d SL → +%d Damage" % [opt, MagicResolver.get_overcast_benefit("damage", opt)])
		remaining_row.add_child(damage_picker)

	var target_picker := OptionButton.new()
	target_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	var candidate_row := HFlowContainer.new()
	candidate_row.add_theme_constant_override("separation", 4)
	var candidate_buttons: Dictionary = {}
	if qualifies_for_targets:
		target_picker.add_item("Targets: skip")
		for opt in target_options:
			target_picker.add_item("Targets: %d SL → +%d Target(s)" % [opt, MagicResolver.get_overcast_benefit("targets", opt)])
		remaining_row.add_child(target_picker)

		for m in candidates:
			var btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			btn.text = m.character_name
			btn.toggle_mode = true
			candidate_buttons[m] = btn
			btn.pressed.connect(func():
				if btn.button_pressed:
					chosen.append(m)
				else:
					chosen.erase(m)
			)
			candidate_row.add_child(btn)
		vbox.add_child(candidate_row)

	var update_remaining := func():
		var damage_spend: int = damage_options[damage_picker.selected - 1] if qualifies_for_damage and damage_picker.selected > 0 else 0
		var targets_spend: int = target_options[target_picker.selected - 1] if qualifies_for_targets and target_picker.selected > 0 else 0
		var remaining: int = overcast_sl - damage_spend - targets_spend
		if remaining < 0:
			remaining_label.text = "Overspent by %d SL — reduce a choice." % -remaining
			remaining_label.add_theme_color_override("font_color", Color(0.85, 0.35, 0.3))
		else:
			remaining_label.text = "%d SL remaining" % remaining
			remaining_label.add_theme_color_override("font_color", Color(0.55, 0.75, 0.4) if remaining > 0 else Color(0.75, 0.6, 0.4))
	update_remaining.call()
	if qualifies_for_damage:
		damage_picker.item_selected.connect(func(_index): update_remaining.call())
	if qualifies_for_targets:
		target_picker.item_selected.connect(func(_index): update_remaining.call())

	var status_label_local := Label.new()
	status_label_local.add_theme_font_size_override("font_size", 7)
	status_label_local.add_theme_color_override("font_color", Color(0.75, 0.6, 0.4))
	vbox.add_child(status_label_local)

	var confirm_row := HBoxContainer.new()
	confirm_row.add_theme_constant_override("separation", 6)
	var confirm_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	confirm_btn.text = "Confirm Overcast  [C]"
	confirm_btn.pressed.connect(func():
		var damage_spend: int = damage_options[damage_picker.selected - 1] if qualifies_for_damage and damage_picker.selected > 0 else 0
		var targets_spend: int = target_options[target_picker.selected - 1] if qualifies_for_targets and target_picker.selected > 0 else 0
		if damage_spend + targets_spend > overcast_sl:
			status_label_local.text = "That spends %d SL, but only %d is available — reduce a choice." % [damage_spend + targets_spend, overcast_sl]
			return
		var wanted_targets: int = MagicResolver.get_overcast_benefit("targets", targets_spend) if targets_spend > 0 else 0
		if chosen.size() > wanted_targets:
			status_label_local.text = "You've selected %d extra target(s), but this spend only buys %d." % [chosen.size(), wanted_targets]
			return
		_pending_choice_str = "confirm"
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(confirm_btn)
	_active_overcast_confirm_button = confirm_btn
	var skip_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	skip_btn.text = "Skip Overcasting  [Enter]"
	skip_btn.pressed.connect(func():
		_pending_choice_str = ""
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(skip_btn)
	_active_overcast_skip_button = skip_btn
	_active_primary_hotkey_button = skip_btn
	col.add_child(confirm_row)
	_auto_focus_default_button()

	while awaiting_overcast_choice:
		await get_tree().process_frame
	_clear(target_container)

	if _pending_choice_str != "confirm":
		return

	var final_damage_spend: int = damage_options[damage_picker.selected - 1] if qualifies_for_damage and damage_picker.selected > 0 else 0
	var final_targets_spend: int = target_options[target_picker.selected - 1] if qualifies_for_targets and target_picker.selected > 0 else 0
	var damage_bonus: int = MagicResolver.get_overcast_benefit("damage", final_damage_spend) if final_damage_spend > 0 else 0

	var lines: Array[String] = []
	## Damage column: extra Damage to the original target, on top of
	## the base hit already applied in _apply_cast_spell_outcome. Per
	## the request, this now folds the bonus directly into the base
	## hit and re-soaks exactly once — reversing the wounds already
	## applied, recombining the raw (pre-soak) damage with the
	## Overcast bonus, and re-applying a single soak calculation —
	## rather than treating the bonus as a second, separate damage
	## instance that gets soaked again on its own. The existing log
	## line for the original hit is updated in place to show the new
	## combined total; nothing new is added to the log for this part.
	if damage_bonus > 0 and original_target != null and not encounter.is_defeated(original_target):
		if not _last_damage_spell_hit.is_empty() and _last_damage_spell_hit.get("target") == original_target:
			var hit: Dictionary = _last_damage_spell_hit
			original_target.wounds_current = min(original_target.wounds_max, original_target.wounds_current + int(hit["wounds_applied"]))
			var soak := original_target.get_characteristic_bonus("toughness") + original_target.get_armour_points("Body")
			var combined_raw: int = int(hit["raw_damage"]) + damage_bonus
			var combined_wounds: int = max(1, combined_raw - soak)
			original_target.take_wounds(combined_wounds)
			## Per the request: fold the Overcast bonus into the card's own
			## boxed Damage row instead of rewriting a plain-text line —
			## append it to the breakdown, bump the total, and update the
			## target's Wounds/mitigated entry to match.
			var breakdown: Array = hit.get("breakdown", [])
			if not breakdown.is_empty():
				breakdown.append({"name": "Overcast", "amount": damage_bonus})
			var card_data: Dictionary = hit.get("card_data", {})
			if not card_data.is_empty():
				card_data["damage"] = combined_raw
			var hit_entry: Dictionary = hit.get("hit_entry", {})
			if not hit_entry.is_empty():
				hit_entry["wounds"] = combined_wounds
				hit_entry["mitigated"] = max(0, combined_raw - combined_wounds)
			if not breakdown.is_empty() or not card_data.is_empty() or not hit_entry.is_empty():
				_rebuild_history_display()
			_check_for_kill_xp(original_target)
		else:
			## Fallback for the rare case Overcast is confirmed without a
			## matching tracked base hit (e.g. a future caller of
			## _offer_overcasting that doesn't go through
			## _apply_cast_spell_outcome first) — still correct on its
			## own, just not folded into an existing line, since there
			## isn't a reliably matching one to fold into.
			var soak := original_target.get_characteristic_bonus("toughness") + original_target.get_armour_points("Body")
			var wounds: int = max(1, damage_bonus - soak)
			original_target.take_wounds(wounds)
			lines.append("+%d Overcast Damage to %s (%d Wound(s) after soak)" % [damage_bonus, original_target.character_name, wounds])
			_check_for_kill_xp(original_target)

	## Targets column: extra targets take the spell's own base Damage
	## formula, plus the same Damage-column bonus if any was also
	## bought — the whole spell is boosted, not just the original hit.
	for m in chosen:
		if encounter.is_defeated(m):
			continue
		var dmg := spell.damage_flat + player.get_characteristic_bonus("willpower") + damage_bonus
		var soak2 := m.get_characteristic_bonus("toughness") + m.get_armour_points("Body")
		var wounds2: int = max(1, dmg - soak2)
		m.take_wounds(wounds2)
		lines.append("%d Wound(s) to extra target %s" % [wounds2, m.character_name])
		_check_for_kill_xp(m)

	_refresh_enemy_display()
	_render_status()
	if not lines.is_empty():
		_add_notice("[color=#8fbf6a]Overcast (%s): %s[/color]" % [spell_name, ", ".join(lines)])

## Breath's own bracketed type (Cold/Corrosion/Fire/Electricity/Poison/
## Smoke — Breath Rating Trait, p.338), chosen from the caster's Arcane
## Magic Lore rather than a live GM call. Each of the book's 6 types is
## used exactly once, picked for the closest thematic fit: Fire (Lore of
## Fire — the obvious one), Corrosion (Lore of Metal — rust unmaking
## metal), Electricity (Lore of Heavens — lightning from the sky),
## Poison (Lore of Death — decay and disease), Smoke (Lore of Shadow —
## choking, obscuring dark), Cold (Lore of Beasts — a primal chill).
## Life and Light have no natural elemental correspondence and are left
## unbracketed — plain force, normal Toughness+Armour soak, no
## Condition — exactly like a real Breath Trait with no type at all.
func _breath_type_for_lore(lore: String) -> String:
	match lore:
		"Fire":
			return "Fire"
		"Metal":
			return "Corrosion"
		"Heavens":
			return "Electricity"
		"Death":
			return "Poison"
		"Shadow":
			return "Smoke"
		"Beasts":
			return "Cold"
		_:
			return ""   ## Life, Light, and no/unknown Lore — plain force

## Every `elif spell_name == "..."` branch below (and in
## _apply_cast_spell_outcome_aoe just past it) is a bespoke, hand-
## written implementation — SpellDefinition.BESPOKE_IMPLEMENTED_SPELLS
## is the authoritative list this must stay in sync with (it drives the
## "Learn a Spell" screens' grey-out-if-unimplemented display), so add a
## spell's name there the moment a genuine branch for it lands here.
## Every OTHER real spell (a magic missile, or one with
## inflicts_condition set) is detected automatically over there from
## its own data flags — no list maintenance needed for those.
##
## `effective_cn` is the actual, Channelling-discounted CN this cast
## used (see _get_effective_cn) — -1 means "not applicable, use the
## spell's own full Casting Number" (kept as the default purely so
## nothing else calling this with the old positional shape breaks).
## `cauterise_agony_forced_roll`, if >= 1, pins the d100 roll for
## Cauterise's own extra Cool Test below instead of rolling fresh — the
## same "forced_roll" test-determinism pattern TestResolver.resolve()
## and combat_resolver.gd's attacker/defender tests already use. Every
## real call site (Cauterise's own casting in _on_cast_spell) leaves
## this at its default -1, so real play always rolls normally; only
## fire_lore_buff_and_heal_spells_test.gd passes a real value, to make
## the agony/Unconscious-threshold branch deterministic to test.
func _apply_cast_spell_outcome(cast_result: MagicResolver.CastResult, spell: SpellDefinition, spell_name: String, target: Character, merge: bool, effective_cn: int = -1, cauterise_agony_forced_roll: int = -1) -> Dictionary:
	## "buff_added" mirrors _apply_pray_outcome's own result_info shape
	## (see its declaration) -- set true whenever this call appends a
	## fresh entry onto target.active_buffs (Crown of Flame/Flaming
	## Hearts below), so a Fortune-triggered redo in _on_cast_spell can
	## pop that entry back off before reapplying, the same way its own
	## redo loop already resets target_wounds/caster_wounds. Without
	## this, a redo would append a SECOND buff entry on top of the
	## first's rather than replacing it.
	## "wound_deltas" (Character -> Wounds actually lost) mirrors
	## _apply_pray_outcome's own shape — added for "Breath" below, the
	## first single-target-UI spell in this function that can still hit
	## MULTIPLE characters at once (the line+burst struck set), unlike
	## target_wounds/caster_wounds above which only ever cover the one
	## `target`/caster pair. _on_cast_spell's own redo loop reverses
	## whichever of these two shapes a given spell actually populated.
	var delta := {"target_wounds": 0, "caster_wounds": 0, "buff_added": false, "wound_deltas": {}}
	var extra: Array[String] = []
	var targets_hit: Array = []
	var spell_damage_data: Dictionary = {}
	_last_damage_spell_hit = {}
	var cn_for_display := effective_cn if effective_cn >= 0 else spell.casting_number
	if cast_result.success:
		extra.append("Cast successfully (CN %d)" % cn_for_display)
		if spell_name == "Drain" and target != player:
			## p.142: "Draws a sliver of life from your target through
			## touch, and mends one of your own Wounds with it" — a real
			## damage-to-target AND heal-to-caster hybrid, not an
			## either/or with the generic magic missile branch below.
			## Winds of Magic's revised formula (p.20-23) drops the SL
			## from the base Damage — SL now only adds Damage through an
			## explicit Overcasting spend (see _offer_overcasting), not
			## automatically.
			var dmg := player.get_characteristic_bonus("willpower")
			var soak := target.get_characteristic_bonus("toughness") + target.get_armour_points("Body")
			var wounds: int = max(1, dmg - soak)
			target.take_wounds(wounds)
			_play_magic_missile_fx(player, target, wounds)
			delta["target_wounds"] = wounds
			var caster_before := player.wounds_current
			player.wounds_current = min(player.wounds_max, player.wounds_current + 1)
			delta["caster_wounds"] = player.wounds_current - caster_before
			## Per the request: the Damage/Wounds numbers now live in their
			## own boxed row on the card (see spell_damage_data below) —
			## the only thing left for Effects to say in prose is the
			## non-numeric heal, which doesn't have a card row of its own.
			extra.append("Healed 1 Wound (now %d/%d)" % [player.wounds_current, player.wounds_max])
			selected_target = target
			ally_focus_target[player] = target
			_check_for_kill_xp(target)
			_refresh_enemy_display()
			var breakdown: Array = [{"name": "Willpower Bonus", "amount": dmg}]
			var hit_entry := {"name": target.character_name, "wounds": wounds, "mitigated": max(0, dmg - wounds)}
			targets_hit.append(hit_entry)
			spell_damage_data = {"damage": dmg, "damage_breakdown": breakdown}
			_last_damage_spell_hit = {
				"target": target, "raw_damage": dmg, "wounds_applied": wounds,
				"breakdown": breakdown, "hit_entry": hit_entry,
				"actor_name": player.character_name, "title": spell_name,
			}
		elif spell_name == "Breath" and target != player:
			## "Breath" (spell): "You immediately make a Breath attack,
			## as if you had spent 2 Advantage to activate the Breath
			## Creature Trait (see page 338). Breath is a magic missile
			## with a Damage equal to your Toughness Bonus. The GM
			## decides which type of Breath attack best suits your
			## Arcane Magic Talent." The Breath Rating (Type) Creature
			## Trait it references: "Choose 1 target it can see within
			## 20+Toughness Bonus yards. All characters within Strength
			## Bonus yards of that target are struck, as are all
			## characters between the creature and the target. Perform
			## an Opposed Ballistic Skill/Dodge Test against all
			## affected targets (the creature's single roll opposed by
			## each individual target). All targets that fail take
			## Damage equal to the attack's Rating... if marked with any
			## of the following types in brackets, apply the associated
			## rules... The creature is immune to its own Breath. This
			## attack is Magical." (No "Magical" bypass exists anywhere
			## in this project yet — see magic_item_generator.gd's own
			## "bypasses non-magical-attack immunity... not implemented"
			## comments — so there's nothing further to wire up for that
			## line.)
			##
			## `target` here is just the book's own "1 target" step,
			## already picked via the normal enemy-portrait selector
			## (see _is_damage_effect's Special-target carve-out above)
			## — the real struck set is computed fresh below rather than
			## hitting only that one character.
			##
			## Per the request ("map each Lore to a book type" — see
			## _breath_type_for_lore's own comment for the exact
			## mapping): the bracketed type is read off the caster's own
			## Arcane Magic Lore instead of being left to a live GM call.
			var breath_type := _breath_type_for_lore(player.get_arcane_lore())
			var caster_sq: Vector2i = battle_positions.get(player, Vector2i(-999999, -999999))
			var target_sq: Vector2i = battle_positions.get(target, Vector2i(-999999, -999999))
			var sb_squares: int = player.get_characteristic_bonus("strength") / BattleGrid.YARDS_PER_SQUARE
			var hit_set: Dictionary = {}
			if battle_grid != null and target_sq.x > -999999:
				for sq in battle_grid.squares_within_radius(target_sq, sb_squares):
					hit_set[sq] = true
				if caster_sq.x > -999999:
					for sq in BattleGrid.direct_line(caster_sq, target_sq):
						hit_set[sq] = true
			else:
				hit_set[target_sq] = true
			var struck: Array = []
			for c: Character in encounter.get_living("ally") + encounter.get_living("adversary"):
				if c == player or encounter.is_defeated(c) or not battle_positions.has(c):
					continue   ## "The creature is immune to its own Breath."
				for sq in BattleGrid.footprint_cells(battle_positions[c], c.get_footprint_size()):
					if hit_set.has(sq):
						struck.append(c)
						break
			if struck.is_empty():
				extra.append("The blast catches no one.")
			else:
				var tb: int = player.get_characteristic_bonus("toughness")
				## One Ballistic Skill roll for the caster, opposed
				## individually by each struck character's own Dodge —
				## "the creature's single roll opposed by each individual
				## target," never re-rolled per target.
				var attacker_test := TestResolver.resolve_characteristic_test(player, "ballistic_skill")
				var dodge_skill: SkillDefinition = GameData.skill_db.find_by_name("Dodge")
				var breath_hits: Array = []
				var ignore_armour: bool = breath_type in ["Fire", "Electricity", "Poison"]
				for t: Character in struck:
					var defender_test: TestResolver.TestResult = TestResolver.resolve_skill_test(t, dodge_skill) if dodge_skill != null else TestResolver.resolve_characteristic_test(t, "agility")
					var opposed := TestResolver.resolve_opposed(attacker_test, defender_test)
					if not opposed.attacker_wins:
						extra.append("%s dodges clear of the Breath." % t.character_name)
						continue
					var soak: int = t.get_characteristic_bonus("toughness") + (0 if ignore_armour else t.get_armour_points("Body"))
					var wounds: int = max(1, tb - soak)
					var before_wounds := t.wounds_current
					t.take_wounds(wounds)
					var actual: int = before_wounds - t.wounds_current
					delta["wound_deltas"][t] = actual
					targets_hit.append({"name": t.character_name, "wounds": actual, "mitigated": max(0, tb - actual)})
					breath_hits.append({"target": t, "wounds": actual})
					_check_for_kill_xp(t)
					match breath_type:
						"Fire":
							t.add_condition("Ablaze", 1)
							extra.append("%s is caught Ablaze by the Breath." % t.character_name)
						"Electricity":
							t.add_condition("Stunned", 1)
							extra.append("%s is left Stunned by the Breath." % t.character_name)
						"Poison":
							t.add_condition("Poisoned", 1)
							extra.append("%s is Poisoned by the Breath." % t.character_name)
						"Cold":
							## "Targets gain a Stunned Condition for every
							## full 5 Wounds suffered (minimum of 1)."
							var stacks: int = max(1, actual / 5)
							t.add_condition("Stunned", stacks)
							extra.append("%s is Stunned (%d) by the freezing Breath." % [t.character_name, stacks])
						"Corrosion":
							## "All Armour and Weapons carried by affected
							## targets suffer 1 Damage" — routed through
							## the same per-character durability tracking
							## a fumbled weapon/Shoddy armour already uses
							## (Character.damage_weapon/damage_armour_piece),
							## rather than mutating the shared item
							## Resource everyone else's copy points at.
							if t.equipped_weapon != "":
								t.damage_weapon(t.equipped_weapon)
							if t.equipped_offhand != "":
								t.damage_weapon(t.equipped_offhand)
							var corroded_piece: ArmourDefinition = t._pick_armour_to_damage("Body")
							if corroded_piece != null:
								t.damage_armour_piece(corroded_piece.armour_name, "Body")
							extra.append("%s's gear corrodes in the Breath." % t.character_name)
						_:
							extra.append("%s takes the full force of the Breath." % t.character_name)
				selected_target = target
				ally_focus_target[player] = target
				_refresh_enemy_display()
				if not breath_hits.is_empty():
					_play_magic_aoe_fx(breath_hits)
				var breath_breakdown: Array = [{"name": "Toughness Bonus", "amount": tb}]
				spell_damage_data = {"damage": tb, "damage_breakdown": breath_breakdown}
				extra.append("Breath (%s)" % (breath_type if breath_type != "" else "Force"))
				## "The area fills with smoke, blocking Line of Sight for
				## Toughness Bonus Rounds" — a real, if simplified,
				## battlefield effect (see active_smoke_clouds' own
				## comment), laid down over the exact same line+burst
				## squares regardless of who (if anyone) failed their
				## Dodge, same as the other types' Conditions only ever
				## apply to whoever actually got hit.
				if breath_type == "Smoke":
					_add_smoke_cloud(hit_set, tb)
					extra.append("Choking smoke fills the area for %d more Round(s)." % tb)
		elif spell.is_magic_missile and target != player:
			## Same Winds of Magic revision: base Damage is the spell's
			## listed Damage plus Willpower Bonus only — no automatic SL.
			var dmg := spell.damage_flat + player.get_characteristic_bonus("willpower")
			var soak := target.get_characteristic_bonus("toughness") + target.get_armour_points("Body")
			var wounds: int = max(1, dmg - soak)
			target.take_wounds(wounds)
			_play_magic_missile_fx(player, target, wounds)
			delta["target_wounds"] = wounds
			selected_target = target
			ally_focus_target[player] = target
			_check_for_kill_xp(target)
			_refresh_enemy_display()
			## Per the request: shown as its own boxed "Spell + Willpower
			## Bonus = N" Damage row (see spell_damage_data below) instead
			## of a plain-text "N Wound(s) to X" line — the wounds
			## themselves still show via targets_hit, same as a weapon hit.
			var breakdown: Array = [{"name": "Spell", "amount": spell.damage_flat}, {"name": "Willpower Bonus", "amount": player.get_characteristic_bonus("willpower")}]
			var hit_entry := {"name": target.character_name, "wounds": wounds, "mitigated": max(0, dmg - wounds)}
			targets_hit.append(hit_entry)
			spell_damage_data = {"damage": dmg, "damage_breakdown": breakdown}
			_last_damage_spell_hit = {
				"target": target, "raw_damage": dmg, "wounds_applied": wounds,
				"breakdown": breakdown, "hit_entry": hit_entry,
				"actor_name": player.character_name, "title": spell_name,
			}
			## Some Lore spells are BOTH a magic missile AND inflict a
			## Condition on the same hit (e.g. Steal Life's Fatigued,
			## T'Essla's Arc's Blinded) — applied here rather than falling
			## to the dedicated inflicts_condition branch below, since this
			## whole chain is an elif and the missile branch above already
			## claims the cast. Skipped if the missile just reduced the
			## target to 0 Wounds.
			if spell.inflicts_condition != "" and not encounter.is_defeated(target):
				target.add_condition(spell.inflicts_condition, spell.inflicts_condition_stacks)
				extra.append("%s inflicted on %s." % [spell.inflicts_condition, target.character_name])
		elif spell_name == "Light":
			## Per the request ("make Light function like a Lamp... when
			## cast add it to the top of the turn order with number of
			## remaining turns (1 min per round), recasting will refresh
			## the duration/counter"): all the actual lighting mechanics
			## live in Character.light_spell_rounds_remaining/
			## has_active_light_source()/get_active_light_radius_tiles()
			## (see character.gd) — this just sets the counter, which is
			## enough for every existing lighting consumer in this file
			## (exploration vision reveal, the battle map's lit squares,
			## Darkness combat penalties) to pick it up automatically, and
			## for _render_turn_order_panel() below to display it. Setting
			## (not adding to) the field is what makes recasting a refresh
			## rather than a stack. Duration is "Willpower minutes"
			## (p.142) — the caster's raw current Willpower value, in
			## Rounds, per the request's own "1 min per round" framing.
			var light_rounds: int = max(1, player.get_effective_characteristic_value("willpower"))
			player.light_spell_rounds_remaining = light_rounds
			## Per the follow-up request ("...should have the same
			## bright/dim/out options as lamps"): every (re)cast starts
			## at full "bright" — see light_spell_mode's own comment —
			## regardless of whatever mode a still-running previous cast
			## might have been left in, matching the counter's own
			## "recasting always refreshes" rule just above.
			player.light_spell_mode = "bright"
			## Real bug fix, per the report ("when casting light and
			## succeeding, add the light to the map instantly, right now
			## the character has to move before it comes on"): setting
			## the counter/mode above is enough for the NEXT fog-of-war
			## recompute to pick the new light radius up, but nothing
			## here actually triggered one -- _render_status() (called
			## right after this whole function returns, in _on_cast_
			## spell()) only refreshes the status/turn-order panels, not
			## fog-of-war/lit-squares, so the caster's own tile stayed
			## exactly as dim as it was before casting until some LATER,
			## unrelated action (a Move) recomputed vision and finally
			## picked the new light up. Same fix, same guard
			## (not dungeon_state.is_empty() -- vision keeps tracking
			## through combat too, not just while _exploration_mode) as
			## the equivalent "Light/Turn Up/Extinguish <item>" Free
			## Action already uses for exactly this reason (see
			## _on_toggle_light_pressed()) -- recompute right now rather
			## than waiting for the next incidental trigger.
			if not dungeon_state.is_empty():
				_reveal_around_party()
			extra.append("A small light glows from your hand, lasting %d Rounds (recasting refreshes it)." % light_rounds)
		elif spell_name == "Flaming Sword of Rhuin":
			## Real feature, per the explicit request ("wire it up...
			## only allow casting it on swords, and temporarily replace
			## the sword's normal stats... overcast should allow more
			## targets and duration only, not extra dmg"). `target` is
			## already guaranteed to be wielding a real Sword-family
			## weapon here — enforced by _characters_wielding_sword()'s
			## own gate on the target picker in _add_spell_or_prayer_row,
			## not re-checked here.
			##
			## Duration is "Willpower Bonus Rounds" per the spell's own
			## duration_text — the CASTER's Willpower Bonus, same
			## convention every other Fire-lore effect in this file uses
			## for the caster's own magic strength (not the wielder's,
			## when cast on an ally's blade). The "savage damage" from
			## the spell's summary is modelled as that same Willpower
			## Bonus added straight onto the weapon's Damage rating —
			## this project's existing "Spell + Willpower Bonus" magic-
			## damage convention (see every magic missile above) applied
			## to a weapon's own stats instead of a direct hit. A
			## documented interpretation (no verbatim book text loaded
			## here), not a silent guess — see this version's own
			## project doc.
			##
			## The clone REPLACES the wielder's normal weapon stats for
			## the Duration (a real .duplicate(true), never the shared
			## weapon_db original — mutating that would set every other
			## Sword in the game on fire too) — both in the per-encounter
			## `weapons` cache (read by every existing Attack/damage path
			## via _weapon_for()) and, more durably, on the Character
			## itself (flaming_sword_weapon/_rounds_remaining/_item_name
			## — see Character.get_equipped_weapon()), so the enchant
			## survives even if this screen's own cache gets rebuilt.
			## Deliberately bypasses _weapon_for()/get_equipped_weapon()'s
			## own flaming override and reads the canonical weapon_db
			## entry directly, by item name — a Fortune Point redo (see
			## _on_cast_spell's own reroll/sl loop) calls this whole
			## function a second time, and by then _weapon_for(target)
			## would already be returning the FIRST attempt's enchanted
			## clone; cloning that again would double the Damage bonus.
			## Reading straight from the item name is always the
			## pristine, un-enchanted original, making this branch
			## idempotent no matter how many times a redo re-runs it.
			var real_weapon: WeaponDefinition = GameData.weapon_db.find_by_name(target.equipped_weapon)
			var enchanted := real_weapon.duplicate(true) as WeaponDefinition
			enchanted.weapon_name = "Flaming Sword of Rhuin"
			## CORRECTED per the follow-up request ("turn the sword from
			## SB+4 to SB+6, and add Impact to the temporary weapon"):
			## this project's earlier v0.3.85 build invented a "+Willpower
			## Bonus on top of whatever the real sword's own Damage is"
			## mechanic (no verbatim book text loaded at the time). Now
			## fixed to a flat SB+6 Damage rating — replacing the plain
			## Sword's own SB+4 outright, not stacking onto it — plus the
			## Impact Quality (p.298: add the units die of the attack roll
			## to Damage caused), on top of the Ablaze-on-hit this
			## weapon's name already triggers in _show_attack_cards.
			enchanted.damage_flat = 6
			if not enchanted.qualities.has("Impact"):
				enchanted.qualities.append("Impact")
			var rounds: int = max(1, player.get_characteristic_bonus("willpower"))
			target.flaming_sword_weapon = enchanted
			target.flaming_sword_item_name = target.equipped_weapon
			target.flaming_sword_rounds_remaining = rounds
			weapons[target] = enchanted
			delta["flaming_sword_shape"] = {
				"real_weapon_name": real_weapon.weapon_name, "rounds": rounds,
			}
			extra.append("%s's %s bursts into magical flame — SB+6 Damage with Impact, and anyone it cuts catches Ablaze, for %d Rounds." % [target.character_name, real_weapon.weapon_name, rounds])
		elif spell_name == "Cauterise":
			## CORRECTED per the real Core Rulebook text the user
			## supplied directly (this project's earlier v0.3.86 build
			## was its own invented interpretation of just the flavor
			## text, documented as such at the time, not the actual book
			## mechanic — the user's own follow-up: "correctly implement
			## cauterise"). The real text: "Channelling Aqshy through
			## your hands you lay them on an ally's wounds. Immediately
			## heal 1d10 Wounds and remove all Bleeding Conditions.
			## Further, the wounds will not become infected. Targets
			## without the Arcane Magic (Fire) Talent, must pass a
			## Challenging (+0) Cool Test or scream in agony. If Failed
			## by −6 or more SL, the target gains the Unconscious
			## Condition and is permanently scarred, waking up 1d10
			## hours later." `target` is guaranteed to be an ally other
			## than the caster here — enforced by _allies_needing_heal's
			## own gate on the target picker in _add_spell_or_prayer_row,
			## not re-checked here.
			var healed := Dice.d10()
			var wounds_before_heal := target.wounds_current
			target.wounds_current = min(target.wounds_max, target.wounds_current + healed)
			var actual_healed: int = target.wounds_current - wounds_before_heal
			## Negative, unlike every damage branch above — this file's
			## shared redo-undo in _on_cast_spell always does
			## `target.wounds_current += prev_delta["target_wounds"]`, so
			## a heal has to store its OWN reversal (subtracting the
			## healed amount back off) rather than the usual "add the
			## damage back" sign a Wound-dealing spell uses.
			delta["target_wounds"] = -actual_healed
			extra.append("%s's wound sears shut — heals %d Wound(s) (now %d/%d)" % [target.character_name, actual_healed, target.wounds_current, target.wounds_max])
			## "Remove all Bleeding Conditions" — the real text prices
			## no cost at all for this. The earlier build's "1 Fatigued"
			## charge was invented (not book text) and is removed here.
			## Naturally redo-safe with no extra bookkeeping: once
			## cured, Bleeding is already gone, so a second call (a
			## successful Fortune redo) finds nothing left to cure and
			## skips this whole block — it only ever fires while
			## Bleeding is still genuinely present.
			if target.conditions.has("Bleeding"):
				target.remove_condition("Bleeding")
				extra.append("Bleeding stops entirely.")
			## "The wounds will not become infected" — an honest no-op:
			## this project tracks no infection mechanic anywhere, so
			## there's nothing for this clause to actually turn off.
			## Recorded here in prose only, the same honest treatment
			## other unmodelled book clauses get elsewhere in this
			## project rather than silently dropping the line.
			extra.append("The wound will not become infected.")
			## "Targets without the Arcane Magic (Fire) Talent must pass
			## a Challenging (+0) Cool Test or scream in agony" — a
			## second, independent Test from the casting roll itself,
			## with its own card, same pattern as the extra Cool Test
			## _check_reverse_fear_from_frightening() rolls and shows
			## above. resolve_skill_test's own default modifier (0) IS
			## Challenging (+0), so nothing extra needs passing for that.
			if not target.has_talent("Arcane Magic (Fire)"):
				var agony_test := TestResolver.resolve_skill_test(target, GameData.skill_db.find_by_name("Cool"), "", 0, [], cauterise_agony_forced_roll)
				var agony_extra: Array[String] = []
				if agony_test.success:
					agony_extra.append("%s grits their teeth against the searing pain." % target.character_name)
				else:
					agony_extra.append("%s screams in agony as the wound cauterises." % target.character_name)
					## "If Failed by −6 or more SL, the target gains the
					## Unconscious Condition and is permanently scarred,
					## waking up 1d10 hours later" — a real-hours
					## duration, not a combat-Round one, same shape as
					## the existing alcohol-recovery timer (see
					## Character.tick_cauterise_recovery()'s own comment
					## and GameState.advance_minutes()'s hook into it).
					if agony_test.success_levels <= -6:
						target.permanently_scarred = true
						target.add_condition("Unconscious", 1)
						var recovery_hours := Dice.d10()
						target.cauterise_recovery_hours_remaining = float(recovery_hours)
						agony_extra.append("The pain is too much — %s is knocked Unconscious and permanently scarred, waking in %d hour(s)." % [target.character_name, recovery_hours])
				_show_single_card(target, "Cauterise (Agony)", "Cool Test", "ally", agony_test, agony_extra)
		elif spell_name == "Crown of Flame" or spell_name == "Flaming Hearts":
			## Real feature, per the explicit request ("Crown of Flame/
			## Flaming Hearts (Blessing-style buffs)"). Both are Fire-lore
			## morale spells ("steeling the resolve of those who follow
			## you" / "...steeling them to fight on") — modelled as the
			## exact same +10-to-a-Characteristic timed buff shape and
			## magnitude every BLESSING_STAT_MAP prayer already grants
			## (see _apply_prayer_buff_effect above), just granted by a
			## spell instead of a prayer. Willpower, not a book-specified
			## Characteristic, is a documented interpretation (no verbatim
			## book text loaded here, same caveat Flaming Sword of Rhuin's
			## own doc already carries) — chosen because Willpower is
			## already this project's own "resolve/Fear-resistance" stat
			## (Cool Tests — Fear, Terror, Broken recovery — are
			## Willpower-linked) and every read of it already goes
			## through get_effective_characteristic_value(), which
			## active_buffs already feeds straight into — so this
			## genuinely makes the target harder to frighten or break,
			## with no new Fear-specific plumbing needed.
			##
			## Flaming Hearts additionally does the "burning the fear
			## FROM your allies' hearts" half literally, on top of the
			## shared buff: it clears every Fear source already tracked
			## against the target (_fear_sources — see its own
			## declaration comment; battle-start-only, so this is a real,
			## lasting cure for the rest of the encounter, not something
			## that silently reappears next Round) and cures an existing
			## Broken Condition outright. That's the one real mechanical
			## difference between the two spells beyond their name.
			var rounds: int = max(1, player.get_characteristic_bonus("willpower"))
			var char_bonuses: Dictionary = {"willpower": 10}
			if spell_name == "Flaming Hearts":
				var cured_fear := false
				if _fear_sources.has(target) and not _fear_sources[target].is_empty():
					_fear_sources.erase(target)
					cured_fear = true
				if target.conditions.has("Broken"):
					target.remove_condition("Broken")
					cured_fear = true
				if cured_fear:
					extra.append("%s's fear burns away." % target.character_name)
			target.add_timed_buff(spell_name, "Fire", char_bonuses, rounds)
			delta["buff_added"] = true
			delta["buff_shape"] = {"characteristic_bonuses": char_bonuses, "damage_bonus": 0, "rounds": rounds}
			extra.append("%s's resolve is steeled by flame — +10 Willpower for %d Rounds." % [target.character_name, rounds])
		elif spell.inflicts_condition != "" and target != player and not encounter.is_defeated(target):
			## Per the request: a real, generic fix for a pre-existing
			## gap — a spell like Shock had flavor text describing its
			## own Condition effect but no actual mechanical
			## implementation at all, for anyone. Data-driven now, so
			## any current or future spell tagged this way works
			## automatically.
			target.add_condition(spell.inflicts_condition, spell.inflicts_condition_stacks)
			extra.append("%s inflicted on %s." % [spell.inflicts_condition, target.character_name])
		else:
			extra.append(spell.summary)
	else:
		extra.append("The spell fails to take hold.")
	if cast_result.critical:
		extra.append("Critical Cast!")
	if not cast_result.miscast.is_empty():
		extra.append("Miscast: " + _apply_and_describe_miscast(player, cast_result.miscast))

	## Magic Colour effect (p.245-256): each Lore's own optional target
	## Condition, toggled on by the player beforehand. Only applies to
	## a real target (not a self-cast), only to Arcane spells (Petty
	## spells aren't tied to any Lore), and only on an actual success —
	## consumed either way once this cast resolves, matching how
	## Strike to Stun is a one-shot toggle rather than a standing
	## effect.
	if magic_colour_effect_active:
		magic_colour_effect_active = false
		if cast_result.success and spell.spell_type == "Arcane" and target != player and not encounter.is_defeated(target):
			var lore := player.get_arcane_lore()
			if MAGIC_COLOUR_EFFECTS.has(lore):
				var effect: Dictionary = MAGIC_COLOUR_EFFECTS[lore]
				var immunity: String = effect.get("immunity_talent", "")
				var already_capped: bool = effect.get("cap_one", false) and target.conditions.has(effect["condition"])
				if immunity != "" and target.has_talent(immunity):
					extra.append("%s's Magic Colour has no effect — %s already possesses %s." % [lore, target.character_name, immunity])
				elif already_capped:
					extra.append("%s's Magic Colour has no further effect — %s already has %s." % [lore, target.character_name, effect["condition"]])
				else:
					target.add_condition(effect["condition"], 1)
					extra.append("%s's Magic Colour: %s gains %s." % [lore, target.character_name, effect["condition"]])

	var card_data := _show_single_card(player, spell_name, "Spell (CN %d)" % cn_for_display, "ally", cast_result.test_result, extra, merge, targets_hit, spell_damage_data)
	if not _last_damage_spell_hit.is_empty():
		_last_damage_spell_hit["card_data"] = card_data
	return delta

## AoE counterpart to _on_cast_spell — called by _resolve_aoe_cast once
## the player's clicked a square, `targets` already computed as
## "living adversaries standing in the affected radius." Mirrors
## _on_cast_spell's own structure (Channelling, Fortune reroll loop,
## Overcasting, War Wizard) but never uses a single `target` Character —
## everything downstream works off the `targets` list instead.
## `hit_squares`/`center_square` are only ever consumed by Great Fires
## of U'Zhul and Firewall's own bespoke branches in
## _apply_cast_spell_outcome_aoe (see that function's comment) — every
## other AoE spell/prayer path through here leaves them at their
## defaults and never looks at them.
func _on_cast_spell_aoe(spell_name: String, targets: Array, is_war_wizard_free: bool, hit_squares: Dictionary = {}, center_square: Vector2i = Vector2i(-99999, -99999)) -> void:
	var spell: SpellDefinition = GameData.spell_db.find_by_name(spell_name)
	var effort := _consume_effort_bonus()
	## See _on_cast_spell's own comment on _get_effective_cn -- same
	## real, partial Channelling discount, not the old all-or-nothing gate.
	var effective_cn := _get_effective_cn(spell)
	var was_channelled: bool = effective_cn < spell.casting_number
	var cast_result := MagicResolver.cast(player, spell, effort[0], effective_cn)
	cast_result.test_result.target_modifiers = effort[1]
	_apply_cn_to_displayed_sl(cast_result, effective_cn)
	var prev_delta := _apply_cast_spell_outcome_aoe(cast_result, spell, spell_name, targets, false, effective_cn, hit_squares, center_square)
	_render_status()

	var choice := await _offer_fortune_spend(cast_result.test_result)
	while choice == "reroll" or choice == "sl":
		if choice == "reroll":
			cast_result = MagicResolver.cast(player, spell, effort[0], effective_cn)
			cast_result.test_result.target_modifiers = effort[1]
			_apply_cn_to_displayed_sl(cast_result, effective_cn)
		## Undo the previous attempt's Wounds before reapplying — same
		## current+amount restore as _on_cast_spell's own undo (amount is
		## Wounds actually lost, per target).
		for t in prev_delta["aoe_wound_deltas"]:
			var amount: int = prev_delta["aoe_wound_deltas"][t]
			t.wounds_current = min(t.wounds_max, t.wounds_current + amount)
		## Ground hazards (Great Fires of U'Zhul, Firewall) laid down by
		## the PREVIOUS attempt must be pulled back off before a Fortune
		## redo lays down a fresh one — same "pop the last entry back off
		## before reapplying" idea _on_cast_spell's own buff_added
		## handling already uses for Crown of Flame/Flaming Hearts,
		## just for persistent_aoe_hazards instead of active_buffs.
		if prev_delta.get("hazard_added", false) and not persistent_aoe_hazards.is_empty():
			persistent_aoe_hazards.pop_back()
		prev_delta = _apply_cast_spell_outcome_aoe(cast_result, spell, spell_name, targets, true, effective_cn, hit_squares, center_square)
		_render_status()
		choice = await _offer_fortune_spend(cast_result.test_result)

	if was_channelled and not cast_result.test_result.success:
		var extra_miscast := MagicResolver.roll_minor_miscast()
		if not extra_miscast.is_empty():
			_add_notice("[color=#c98a6a]The channelled magic writhes free — Minor Miscast: %s[/color]" % _apply_and_describe_miscast(player, extra_miscast))
	_channelling_progress.clear()

	if cast_result.test_result.success:
		var final_overcast_sl: int = max(0, cast_result.test_result.success_levels)
		## Per the request ("great fires of uzhul should allow overcast
		## like all arcane spells"): its own bespoke Damage/Duration
		## prompt (see _offer_great_fires_overcast's own comment for why
		## it can't just reuse the generic flat-Damage AoE picker below)
		## instead of the generic _offer_overcasting_aoe(), which
		## deliberately skips this spell outright (see its own comment).
		if spell_name == "Great Fires of U'Zhul":
			await _offer_great_fires_overcast(final_overcast_sl)
		else:
			await _offer_overcasting_aoe(spell, spell_name, final_overcast_sl)

	if is_war_wizard_free:
		war_wizard_used_this_turn = true
		_prompt_player_turn(false)
		return

	_finish_player_action()

## AoE counterpart to _apply_cast_spell_outcome — computes the spell's
## Damage value ONCE per the request ("should only calculate damage once
## and apply that to all the targets it hits") rather than re-deriving
## it per target, then applies that same raw value to every target in
## `targets`, each still soaked (Toughness Bonus + Armour) individually,
## since soak is a property of the target being hit, not part of "the
## damage" the spell itself deals. Returns {aoe_wound_deltas:
## {Character: int}} (Wounds actually lost, per target) so a later
## Fortune redo can reverse exactly that.
## See _apply_cast_spell_outcome's own comment on `effective_cn`.
## `great_fires_dodge_forced_roll`, if >= 1, pins the d100 roll for
## Great Fires of U'Zhul's own splash-target Dodge Test below instead
## of rolling fresh — same test-determinism "forced_roll" seam
## Cauterise's own agony Cool Test uses (cauterise_agony_forced_roll on
## _apply_cast_spell_outcome). Every real call site leaves this at its
## default -1; only the test suite passes a real value.
func _apply_cast_spell_outcome_aoe(cast_result: MagicResolver.CastResult, spell: SpellDefinition, spell_name: String, targets: Array, merge: bool, effective_cn: int = -1, hit_squares: Dictionary = {}, center_square: Vector2i = Vector2i(-99999, -99999), great_fires_dodge_forced_roll: int = -1) -> Dictionary:
	var result_info := {"aoe_wound_deltas": {}, "hazard_added": false}
	var extra: Array[String] = []
	var targets_hit: Array = []
	var spell_damage_data: Dictionary = {}
	_last_aoe_damage_hits = []
	## Reset alongside _last_aoe_damage_hits — see these two vars' own
	## declaration comment — so a later Overcast confirmation can never
	## fold into a stale card left over from an earlier, unrelated cast.
	_last_aoe_card_data = {}
	_last_aoe_damage_breakdown = []
	var cn_for_display := effective_cn if effective_cn >= 0 else spell.casting_number
	if cast_result.success:
		extra.append("Cast successfully (CN %d)" % cn_for_display)
		if spell_name == "Great Fires of U'Zhul":
			## CORRECTED per the real Core Rulebook text the user
			## supplied (image): "You hurl a great, explosive blast of
			## Aqshy into an enemy, which erupts into a furious blaze,
			## burning with the heat of a forge. This is a magical
			## missile with Damage +10 that ignores Armour Points and
			## inflicts +2 Ablaze Conditions and the Prone Condition on
			## a target. Everyone within the Area of Effect of that
			## target suffers a Damage +5 hit ignoring Armour Points,
			## and must pass a Dodge Test or also gain +1 Ablaze
			## Condition. The spell stops behaving like a magic missile
			## as the fire continues to burn in the Area of Effect for
			## the duration. Anyone within the Area of Effect at the
			## start of a round suffers 1d10+6 Damage, ignoring APs, and
			## gains +1 Ablaze Condition." Previously this project's own
			## generic is_magic_missile+is_area_of_effect path (still
			## used below by Blast/Twin-tailed Comet) dealt the SAME
			## damage to everyone uniformly and left nothing behind —
			## no primary/splash split, no ignored Armour, no lingering
			## fire at all.
			##
			## `primary` is whoever occupies the exact clicked square
			## (`center_square`) — the real "hurl it into an enemy"
			## target. Everyone else caught in the radius is splash. If
			## the player clicked an empty square, there's simply no
			## primary — every hit character takes splash only, an
			## honest fallback for this project's own click-a-point
			## (not click-a-character) AoE targeting, which has no
			## other way to name a single "the" target.
			if targets.is_empty():
				extra.append("No one was caught in the blast.")
			else:
				var primary: Character = null
				for t: Character in targets:
					if encounter.is_defeated(t):
						continue
					if battle_positions.has(t) and BattleGrid.footprint_cells(battle_positions[t], t.get_footprint_size()).has(center_square):
						primary = t
						break
				var wb: int = player.get_characteristic_bonus("willpower")
				var dodge_skill: SkillDefinition = GameData.skill_db.find_by_name("Dodge")
				for t: Character in targets:
					if encounter.is_defeated(t):
						continue
					var is_primary: bool = t == primary
					var dmg: int = (spell.damage_flat if is_primary else 5) + wb
					var soak: int = t.get_characteristic_bonus("toughness")   ## ignores Armour Points entirely, per the book
					var wounds: int = max(1, dmg - soak)
					t.take_wounds(wounds)
					result_info["aoe_wound_deltas"][t] = wounds
					var hit_entry := {"name": t.character_name, "wounds": wounds, "mitigated": max(0, dmg - wounds)}
					targets_hit.append(hit_entry)
					_last_aoe_damage_hits.append({"target": t, "raw_damage": dmg, "wounds_applied": wounds, "hit_entry": hit_entry})
					_check_for_kill_xp(t)
					if is_primary:
						t.add_condition("Ablaze", 2)
						t.add_condition("Prone", 1)
						extra.append("%s takes the full blast — knocked Prone, +2 Ablaze." % t.character_name)
					elif dodge_skill != null:
						var dodge_test := TestResolver.resolve_skill_test(t, dodge_skill, "", 0, [], great_fires_dodge_forced_roll)
						if dodge_test.success:
							extra.append("%s dodges clear of the worst of the blaze." % t.character_name)
						else:
							t.add_condition("Ablaze", 1)
							extra.append("%s fails to Dodge the splash — +1 Ablaze." % t.character_name)
				extra.append("Blast (%d yard radius)" % (_aoe_radius_squares(true) * BattleGrid.YARDS_PER_SQUARE))
				var fx_hits: Array = []
				for hit in _last_aoe_damage_hits:
					fx_hits.append({"target": hit["target"], "wounds": hit["wounds_applied"]})
				_play_magic_aoe_fx(fx_hits)
				_refresh_enemy_display()
			## "The spell stops behaving like a magic missile as the
			## fire continues to burn in the Area of Effect for the
			## duration. Anyone within the Area of Effect at the start
			## of a round suffers 1d10+6 Damage, ignoring APs, and
			## gains +1 Ablaze Condition" — a real, lingering ground
			## hazard now, covering this cast's own hit_squares, for
			## Willpower Bonus Rounds. Laid down even if `targets` came
			## back empty (the player can still hurl this into open
			## ground and have the resulting fire actually persist).
			if not hit_squares.is_empty():
				var wb_duration: int = player.get_characteristic_bonus("willpower")
				_add_persistent_aoe_hazard("Great Fires of U'Zhul", hit_squares, wb_duration, "1d10", 6, true, 1)
				result_info["hazard_added"] = true
				extra.append("The area continues to burn for %d more Round(s)." % wb_duration)
		elif spell_name == "Firewall":
			## CORRECTED per the same real Core Rulebook page (image):
			## "You channel a fiery streak of Aqshy, creating a wall of
			## flame. The Firewall is Willpower Bonus yards wide, and 1
			## yard deep. For every +2 SL you may extend the length of
			## the Firewall by +Willpower Bonus yards. Anyone crossing
			## the firewall gains 1 Ablaze condition and suffers a hit
			## with a Damage equal to your Willpower Bonus, handled
			## like a magical missile." Previously this project routed
			## Firewall through the generic single-target inflicts_
			## condition path (is_area_of_effect was wrongly left
			## false) — a one-shot Ablaze on one chosen enemy, no
			## actual wall, no lingering ground effect, no Overcast
			## extension at all.
			##
			## This project's own targeting has no directional
			## line-and-extend-by-SL geometry anywhere (see the AoE
			## radius/box helper every other AoE spell already shares)
			## — a true wall shape would need bespoke UI this project
			## doesn't have. Documented, honest simplification: Firewall
			## uses the exact same click-a-point radius-box AoE geometry
			## every other AoE spell here already uses, and — since
			## there's no movement-crossing detection anywhere in this
			## project either (confirmed: nothing hooks into a move
			## commit to check "did this path cross a hazard's
			## squares") — anyone standing in the wall's own squares at
			## the START of a Round takes the hit, the same tick timing
			## Great Fires of U'Zhul's own persistent fire above uses,
			## rather than only on the specific act of crossing it.
			var wb: int = player.get_characteristic_bonus("willpower")
			if targets.is_empty():
				extra.append("The wall of flame roars up over open ground — no one was caught in it.")
			else:
				for t: Character in targets:
					if encounter.is_defeated(t):
						continue
					var soak: int = t.get_characteristic_bonus("toughness") + t.get_armour_points("Body")
					var wounds: int = max(1, wb - soak)
					t.take_wounds(wounds)
					result_info["aoe_wound_deltas"][t] = wounds
					t.add_condition("Ablaze", 1)
					var hit_entry := {"name": t.character_name, "wounds": wounds, "mitigated": max(0, wb - wounds)}
					targets_hit.append(hit_entry)
					_last_aoe_damage_hits.append({"target": t, "raw_damage": wb, "wounds_applied": wounds, "hit_entry": hit_entry})
					_check_for_kill_xp(t)
					extra.append("%s is caught as the wall roars up — +1 Ablaze." % t.character_name)
				extra.append("Wall of Flame (%d yard radius)" % (_aoe_radius_squares(true) * BattleGrid.YARDS_PER_SQUARE))
				var fx_hits: Array = []
				for hit in _last_aoe_damage_hits:
					fx_hits.append({"target": hit["target"], "wounds": hit["wounds_applied"]})
				_play_magic_aoe_fx(fx_hits)
				_refresh_enemy_display()
			if not hit_squares.is_empty():
				var wb_duration: int = player.get_characteristic_bonus("willpower")
				_add_persistent_aoe_hazard("Firewall", hit_squares, wb_duration, "", wb, false, 1)
				result_info["hazard_added"] = true
				extra.append("The wall of flame burns on for %d more Round(s)." % wb_duration)
		elif targets.is_empty():
			extra.append("No one was caught in the blast.")
		else:
			var dmg := spell.damage_flat + player.get_characteristic_bonus("willpower")
			for t: Character in targets:
				if encounter.is_defeated(t):
					continue
				var soak: int = t.get_characteristic_bonus("toughness") + t.get_armour_points("Body")
				var wounds: int = max(1, dmg - soak)
				t.take_wounds(wounds)
				result_info["aoe_wound_deltas"][t] = wounds
				## hit_entry is the exact Dictionary object placed into
				## targets_hit below (and, once _show_single_card stores
				## it into the roll card's own history entry, the exact
				## object the card renders from) — kept here too so
				## _offer_overcasting_aoe can update its "wounds"/
				## "mitigated" keys in place later, the same fold-in
				## pattern _last_damage_spell_hit's own "hit_entry"
				## already uses for a single-target spell.
				var hit_entry := {"name": t.character_name, "wounds": wounds, "mitigated": max(0, dmg - wounds)}
				targets_hit.append(hit_entry)
				_last_aoe_damage_hits.append({"target": t, "raw_damage": dmg, "wounds_applied": wounds, "hit_entry": hit_entry})
				_check_for_kill_xp(t)
			if not targets_hit.is_empty():
				extra.append("Blast (%d yard radius)" % (_aoe_radius_squares(true) * BattleGrid.YARDS_PER_SQUARE))
				## Per the request ("do the same for magic spells"): the
				## same boxed "Spell + Willpower Bonus = N" Damage row
				## Twin-tailed Comet's card now gets, instead of the raw
				## number only ever appearing per-target in the Wounds
				## lines below it. `breakdown` is kept in
				## _last_aoe_damage_breakdown (the SAME Array object,
				## since spell_damage_data just hands the reference
				## straight through to the roll card) so a later
				## Overcast confirmation can append an "Overcast" row to
				## this exact list rather than to a disconnected copy.
				var breakdown: Array = [{"name": "Spell", "amount": spell.damage_flat}, {"name": "Willpower Bonus", "amount": player.get_characteristic_bonus("willpower")}]
				spell_damage_data = {"damage": dmg, "damage_breakdown": breakdown}
				_last_aoe_damage_breakdown = breakdown
				var fx_hits: Array = []
				for hit in _last_aoe_damage_hits:
					fx_hits.append({"target": hit["target"], "wounds": hit["wounds_applied"]})
				_play_magic_aoe_fx(fx_hits)
			_refresh_enemy_display()
	else:
		extra.append("The spell fails to take hold.")
	if cast_result.critical:
		extra.append("Critical Cast!")
	if not cast_result.miscast.is_empty():
		extra.append("Miscast: " + _apply_and_describe_miscast(player, cast_result.miscast))
	var card_data := _show_single_card(player, spell_name, "Spell (CN %d)" % cn_for_display, "ally", cast_result.test_result, extra, merge, targets_hit, spell_damage_data)
	if not _last_aoe_damage_hits.is_empty():
		_last_aoe_card_data = card_data
	return result_info

## AoE counterpart to _offer_overcasting — an AoE spell's own Targets
## column never qualifies (real book rule: it only applies to
## single-target spells; Blast's target_text is "AoE (WP Bonus yards)",
## not "1" — the spell already hits everyone in its radius), so this
## only ever offers the Damage column, applying the bonus once to every
## target that was actually hit, per the request ("including overcast
## damage and targets").
func _offer_overcasting_aoe(spell: SpellDefinition, spell_name: String, overcast_sl: int) -> void:
	if overcast_sl < 1 or not spell.is_magic_missile:
		return
	## Great Fires of U'Zhul's own bespoke branch above already splits
	## Damage into a primary (+10) / splash (+5) shape and then lays
	## down a lingering ground fire — none of which is the flat
	## "same Damage number for everyone" shape this generic Overcast
	## flow assumes. Per the follow-up request ("great fires of uzhul
	## should allow overcast like all arcane spells"), it now gets its
	## own bespoke Overcast prompt instead — see _offer_great_fires_
	## overcast() below, dispatched from _on_cast_spell_aoe() before
	## this function is ever reached for that spell. This guard stays
	## as a defensive no-op in case something else ever calls this
	## function directly for it.
	if spell_name == "Great Fires of U'Zhul":
		return
	var living_hits: Array = []
	for hit in _last_aoe_damage_hits:
		if not encounter.is_defeated(hit["target"]):
			living_hits.append(hit)
	if living_hits.is_empty():
		return
	var damage_options: Array[int] = MagicResolver.get_overcast_spend_options("damage", overcast_sl)
	if damage_options.is_empty():
		_add_notice("[color=#8a9bc9]Overcast: %d SL available to spend (Winds of Magic table) — no Damage increment is affordable.[/color]" % overcast_sl)
		return

	awaiting_overcast_choice = true
	_pending_choice_str = ""
	## Per the request: confined to the Magic/Prayers column instead of
	## blanking the whole action-menu area — see _build_scoped_column and
	## _offer_overcasting's own matching comment on why this VBox is
	## parented to `col.get_parent()` rather than to `col` itself (an
	## HFlowContainer, which doesn't stretch a lone child to the full
	## column width the way the wrapper VBoxContainer does).
	var col := _build_scoped_column("Magic / Prayers")
	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override("separation", 3)
	col.get_parent().add_child(vbox)
	var header := Label.new()
	header.text = "Overcast: %d SL available to spend (Winds of Magic table). %s's Targets column doesn't apply to an Area of Effect spell — it already hits everyone in radius." % [overcast_sl, spell_name]
	header.autowrap_mode = TextServer.AUTOWRAP_WORD
	header.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
	## Per the request ("resize this overcast text and buttons so there is
	## no need to scroll") — see _offer_overcasting's matching comment;
	## same compact ACTION_COLUMN_FONT_SIZE and tighter spacing applied
	## here too, so this AoE variant fits without a scrollbar either.
	header.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	vbox.add_child(header)

	## Per the request: the unspent SL total updates live as the player
	## changes the dropdown.
	##
	## Per the follow-up request ("move the Overcast Damage ... drop
	## down button to the right of the text"): same same-row layout as
	## _offer_overcasting above — see its matching comment.
	var remaining_row := HBoxContainer.new()
	remaining_row.add_theme_constant_override("separation", 6)
	var remaining_label := Label.new()
	remaining_label.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	remaining_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	remaining_row.add_child(remaining_label)
	vbox.add_child(remaining_row)

	var damage_picker := OptionButton.new()
	damage_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	damage_picker.add_item("Damage: skip")
	for opt in damage_options:
		damage_picker.add_item("Damage: %d SL → +%d Damage" % [opt, MagicResolver.get_overcast_benefit("damage", opt)])
	remaining_row.add_child(damage_picker)

	var update_remaining := func():
		var damage_spend: int = damage_options[damage_picker.selected - 1] if damage_picker.selected > 0 else 0
		var remaining: int = overcast_sl - damage_spend
		remaining_label.text = "%d SL remaining" % remaining
		remaining_label.add_theme_color_override("font_color", Color(0.55, 0.75, 0.4) if remaining > 0 else Color(0.75, 0.6, 0.4))
	update_remaining.call()
	damage_picker.item_selected.connect(func(_index): update_remaining.call())

	var confirm_row := HBoxContainer.new()
	confirm_row.add_theme_constant_override("separation", 6)
	var confirm_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	confirm_btn.text = "Confirm Overcast  [C]"
	confirm_btn.pressed.connect(func():
		_pending_choice_str = "confirm"
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(confirm_btn)
	_active_overcast_confirm_button = confirm_btn
	var skip_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	skip_btn.text = "Skip Overcasting  [Enter]"
	skip_btn.pressed.connect(func():
		_pending_choice_str = ""
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(skip_btn)
	_active_overcast_skip_button = skip_btn
	_active_primary_hotkey_button = skip_btn
	vbox.add_child(confirm_row)
	_auto_focus_default_button()

	while awaiting_overcast_choice:
		await get_tree().process_frame
	_clear(target_container)

	if _pending_choice_str != "confirm" or damage_picker.selected <= 0:
		return

	var damage_bonus: int = MagicResolver.get_overcast_benefit("damage", damage_options[damage_picker.selected - 1])
	if damage_bonus <= 0:
		return

	## Real bug fix (user report, with a screenshot: "overcast dmg should
	## be adding dmg after mitigation... can we update the roll card dmg
	## rather then add the green text afterwards"): this used to leave
	## the roll card showing its original pre-Overcast Damage/Wounds
	## numbers and announce the real, combined total in a separate
	## plain-text notice below it instead — the card and the log
	## disagreed about what actually happened. Now folds directly into
	## the card itself, the same "reverse the wounds already applied,
	## recombine the raw (pre-soak) damage with the Overcast bonus,
	## re-apply a single soak calculation, then update the existing
	## card's own boxed Damage row and each hit target's Wounds/mitigated
	## entry in place" pattern _offer_overcasting() already uses for a
	## single-target spell — see _last_aoe_card_data/_last_aoe_damage_
	## breakdown's own declaration comment for why mutating them here is
	## mutating the actual displayed card directly. combined_raw is the
	## same for every target (an AoE spell's own Damage is computed once
	## and applied to everyone in the blast — see _apply_cast_spell_
	## outcome_aoe's own comment), so the boxed Damage total only needs
	## updating once, outside the per-target loop.
	var combined_raw := 0
	var any_hit := false
	for hit in _last_aoe_damage_hits:
		var t: Character = hit["target"]
		if encounter.is_defeated(t):
			continue
		t.wounds_current = min(t.wounds_max, t.wounds_current + int(hit["wounds_applied"]))
		var soak := t.get_characteristic_bonus("toughness") + t.get_armour_points("Body")
		combined_raw = int(hit["raw_damage"]) + damage_bonus
		var combined_wounds: int = max(1, combined_raw - soak)
		t.take_wounds(combined_wounds)
		var hit_entry: Dictionary = hit.get("hit_entry", {})
		if not hit_entry.is_empty():
			hit_entry["wounds"] = combined_wounds
			hit_entry["mitigated"] = max(0, combined_raw - combined_wounds)
		any_hit = true
		_check_for_kill_xp(t)
	if not _last_aoe_damage_breakdown.is_empty():
		_last_aoe_damage_breakdown.append({"name": "Overcast", "amount": damage_bonus})
	if not _last_aoe_card_data.is_empty() and combined_raw > 0:
		_last_aoe_card_data["damage"] = combined_raw
	if any_hit:
		_rebuild_history_display()
	_refresh_enemy_display()
	_render_status()

## Per the request ("great fires of uzhul should allow overcast like all
## arcane spells"): a bespoke Overcast prompt for Great Fires of U'Zhul,
## since it genuinely doesn't fit the generic _offer_overcasting_aoe's
## single flat "same Damage number for everyone" Damage column (its own
## damage is a primary +10 / splash +5 split, and it also leaves a
## lingering ground fire behind — two real, separate things a straight
## port of the generic picker would either have to ignore or force into
## a shape that isn't what actually happens). Reuses the SAME shared
## Winds of Magic OVERCAST_TABLE every other arcane spell's Overcast
## picker already reads from (MagicResolver.get_overcast_spend_options/
## get_overcast_benefit) — so mechanically this is still "the same
## table," just applied to this spell's own two real axes:
##   Damage — added to primary AND splash's raw damage (both are hits
##     from the same casting, so the same bonus applies to each,
##     mirroring how every other spell's Damage overcast adds one flat
##     bonus regardless of the base amount), and to the lingering fire's
##     own per-Round damage too, once laid down — a hotter blast leaves
##     hotter embers behind.
##   Duration — genuinely uses the OVERCAST_TABLE's own `duration_mult`
##     column (defined there but, before this, never actually read by
##     anything) to multiply how many Rounds the ground fire keeps
##     burning, matching the book's own "the fire continues to burn...
##     for the duration" line far more literally than a flat SL-per-
##     Round add would.
## Targets/Range/Area of Effect stay unmodelled here for the same
## reason _offer_overcasting's own header comment gives for every other
## spell: no real battlefield-range tracking or dynamic blast-radius
## resizing exists in this project to hook either into.
func _offer_great_fires_overcast(overcast_sl: int) -> void:
	if overcast_sl < 1:
		return
	var living_hits: Array = []
	for hit in _last_aoe_damage_hits:
		if not encounter.is_defeated(hit["target"]):
			living_hits.append(hit)
	var hazard: Dictionary = persistent_aoe_hazards.back() if not persistent_aoe_hazards.is_empty() else {}
	var has_hazard: bool = not hazard.is_empty() and hazard.get("name", "") == "Great Fires of U'Zhul"
	if living_hits.is_empty() and not has_hazard:
		return

	var damage_options: Array[int] = MagicResolver.get_overcast_spend_options("damage", overcast_sl)
	var duration_options: Array[int] = MagicResolver.get_overcast_spend_options("duration_mult", overcast_sl) if has_hazard else []
	if damage_options.is_empty() and duration_options.is_empty():
		_add_notice("[color=#8a9bc9]Overcast: %d SL available to spend (Winds of Magic table) — no Damage or Duration increment is affordable.[/color]" % overcast_sl)
		return

	awaiting_overcast_choice = true
	_pending_choice_str = ""
	var col := _build_scoped_column("Magic / Prayers")
	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override("separation", 3)
	col.get_parent().add_child(vbox)
	var header := Label.new()
	header.text = "Overcast: %d SL available to spend (Winds of Magic table)." % overcast_sl
	header.autowrap_mode = TextServer.AUTOWRAP_WORD
	header.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
	header.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	vbox.add_child(header)

	var remaining_row := HBoxContainer.new()
	remaining_row.add_theme_constant_override("separation", 6)
	var remaining_label := Label.new()
	remaining_label.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	remaining_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	remaining_row.add_child(remaining_label)
	vbox.add_child(remaining_row)

	var damage_picker := OptionButton.new()
	damage_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	if not damage_options.is_empty():
		damage_picker.add_item("Damage: skip")
		for opt in damage_options:
			damage_picker.add_item("Damage: %d SL → +%d Damage" % [opt, MagicResolver.get_overcast_benefit("damage", opt)])
		remaining_row.add_child(damage_picker)

	var duration_picker := OptionButton.new()
	duration_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	if not duration_options.is_empty():
		duration_picker.add_item("Duration: skip")
		for opt in duration_options:
			duration_picker.add_item("Duration: %d SL → x%d Duration" % [opt, MagicResolver.get_overcast_benefit("duration_mult", opt)])
		remaining_row.add_child(duration_picker)

	var update_remaining := func():
		var damage_spend: int = damage_options[damage_picker.selected - 1] if (not damage_options.is_empty() and damage_picker.selected > 0) else 0
		var duration_spend: int = duration_options[duration_picker.selected - 1] if (not duration_options.is_empty() and duration_picker.selected > 0) else 0
		var remaining: int = overcast_sl - damage_spend - duration_spend
		if remaining < 0:
			remaining_label.text = "Overspent by %d SL — reduce a choice." % -remaining
			remaining_label.add_theme_color_override("font_color", Color(0.85, 0.35, 0.3))
		else:
			remaining_label.text = "%d SL remaining" % remaining
			remaining_label.add_theme_color_override("font_color", Color(0.55, 0.75, 0.4) if remaining > 0 else Color(0.75, 0.6, 0.4))
	update_remaining.call()
	if not damage_options.is_empty():
		damage_picker.item_selected.connect(func(_index): update_remaining.call())
	if not duration_options.is_empty():
		duration_picker.item_selected.connect(func(_index): update_remaining.call())

	var status_label_local := Label.new()
	status_label_local.add_theme_font_size_override("font_size", 7)
	status_label_local.add_theme_color_override("font_color", Color(0.75, 0.6, 0.4))
	vbox.add_child(status_label_local)

	var confirm_row := HBoxContainer.new()
	confirm_row.add_theme_constant_override("separation", 6)
	var confirm_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	confirm_btn.text = "Confirm Overcast  [C]"
	confirm_btn.pressed.connect(func():
		var damage_spend: int = damage_options[damage_picker.selected - 1] if (not damage_options.is_empty() and damage_picker.selected > 0) else 0
		var duration_spend: int = duration_options[duration_picker.selected - 1] if (not duration_options.is_empty() and duration_picker.selected > 0) else 0
		if damage_spend + duration_spend > overcast_sl:
			status_label_local.text = "That spends %d SL, but only %d is available — reduce a choice." % [damage_spend + duration_spend, overcast_sl]
			return
		_pending_choice_str = "confirm"
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(confirm_btn)
	_active_overcast_confirm_button = confirm_btn
	var skip_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	skip_btn.text = "Skip Overcasting  [Enter]"
	skip_btn.pressed.connect(func():
		_pending_choice_str = ""
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(skip_btn)
	_active_overcast_skip_button = skip_btn
	_active_primary_hotkey_button = skip_btn
	vbox.add_child(confirm_row)
	_auto_focus_default_button()

	while awaiting_overcast_choice:
		await get_tree().process_frame
	_clear(target_container)

	if _pending_choice_str != "confirm":
		return

	var damage_bonus: int = MagicResolver.get_overcast_benefit("damage", damage_options[damage_picker.selected - 1]) if (not damage_options.is_empty() and damage_picker.selected > 0) else 0
	var duration_mult: int = MagicResolver.get_overcast_benefit("duration_mult", duration_options[duration_picker.selected - 1]) if (not duration_options.is_empty() and duration_picker.selected > 0) else 0

	if damage_bonus > 0:
		var combined_raw := 0
		var any_hit := false
		for hit in _last_aoe_damage_hits:
			var t: Character = hit["target"]
			if encounter.is_defeated(t):
				continue
			t.wounds_current = min(t.wounds_max, t.wounds_current + int(hit["wounds_applied"]))
			## Great Fires ignores Armour Points entirely (see the real
			## cast's own soak calc just above in
			## _apply_cast_spell_outcome_aoe) — Toughness Bonus only,
			## unlike the generic AoE reapply's Toughness+Armour soak.
			var soak := t.get_characteristic_bonus("toughness")
			combined_raw = int(hit["raw_damage"]) + damage_bonus
			var combined_wounds: int = max(1, combined_raw - soak)
			t.take_wounds(combined_wounds)
			hit["raw_damage"] = combined_raw
			hit["wounds_applied"] = combined_wounds
			var hit_entry: Dictionary = hit.get("hit_entry", {})
			if not hit_entry.is_empty():
				hit_entry["wounds"] = combined_wounds
				hit_entry["mitigated"] = max(0, combined_raw - combined_wounds)
			any_hit = true
			_check_for_kill_xp(t)
		if any_hit:
			_add_notice("[color=#8fbf6a]Overcast: +%d Damage to the blast.[/color]" % damage_bonus)
			_rebuild_history_display()
		if has_hazard:
			## The ongoing burn hits harder too, not just the initial
			## burst — see this function's own header comment.
			hazard["damage_flat"] = int(hazard.get("damage_flat", 0)) + damage_bonus

	if duration_mult > 1 and has_hazard:
		var base_rounds: int = int(hazard.get("rounds_remaining", 0))
		var extended_rounds: int = base_rounds * duration_mult
		hazard["rounds_remaining"] = extended_rounds
		_add_notice("[color=#8fbf6a]Overcast: the blaze's Duration is multiplied x%d — now burning for %d more Round(s).[/color]" % [duration_mult, extended_rounds])

	_refresh_enemy_display()
	_render_status()

## Blessings whose real book effect (p.221) is a flat "+10 [Characteristic]
## for 6 Rounds" — the cleanest, most literal case of "a timed stat buff,"
## and exactly what get_effective_characteristic_value() above actually
## reads from, so these genuinely change Test targets while active, not
## just a label. The other 9 Blessings (Healing/Breath/Fortune/
## Protection/Conscience/Recuperation/Righteousness/Savagery/Tenacity)
## have effects that don't fit this same "+10 stat" shape — Healing and
## Soulfire (a Miracle) already have their own real mechanics above;
## the rest remain flavour-text only, a documented gap rather than a
## forced, inaccurate simplification.
const BLESSING_STAT_MAP := {
	"Blessing of Battle": "weapon_skill",
	"Blessing of Charisma": "fellowship",
	"Blessing of Courage": "willpower",
	"Blessing of Finesse": "dexterity",
	"Blessing of Grace": "agility",
	"Blessing of Hardiness": "toughness",
	"Blessing of Might": "strength",
	"Blessing of The Hunt": "ballistic_skill",
	"Blessing of Wisdom": "intelligence",
	"Blessing of Wit": "initiative",
}

## Success Levels in Combat / Blessings (p.221): "For every +2 SL you
## score in a Pray Test when attempting a Blessing, you may choose one
## of the following benefits: Range +6 yards / Targets +1 / Duration +6
## Rounds." Per the follow-up request ("blessings should allow overcast
## like spending on additional friendly targets (cost 2 SL), and
## multiply duration by x2/3/4/5..etc for 2 SL per stage") this is now a
## real interactive choice — see _offer_blessing_overcast() right below
## _apply_prayer_buff_effect() — rather than every increment of SL being
## silently auto-spent on Duration alone the way it used to be. Range
## still isn't modelled (no battlefield-distance tracking for Blessings
## any more than for spells — same documented gap _offer_overcasting's
## own header comment notes there).
##
## Applies the real, timed mechanical effect for a successfully cast
## Blessing/Miracle where this project actually models one, using the
## prayer's own BASE Duration only (no SL spent yet — that's now
## _offer_blessing_overcast()'s job, called separately after this, once
## the full Pray Test result — including any Fortune Point spend — is
## final). Returns {} if this prayer has no modelled timed-buff effect
## (still resolves as a successful Test either way, just without a
## mechanical consequence beyond that); otherwise a Dictionary shaped
## exactly like add_timed_buff()'s own parameters —
## {"desc": String, "characteristic_bonuses": Dictionary, "damage_bonus": int, "rounds": int}
## — so _offer_blessing_overcast() can replicate this SAME buff onto
## extra targets, and/or rescale its Duration in place, without
## re-deriving any of it from scratch.
func _apply_prayer_buff_effect(prayer_name: String, target: Character) -> Dictionary:
	if BLESSING_STAT_MAP.has(prayer_name):
		var char_key: String = BLESSING_STAT_MAP[prayer_name]
		var rounds := 6
		target.add_timed_buff(prayer_name, "Sigmar", {char_key: 10}, rounds)
		return {
			"desc": "%s gains +10 %s for %d Rounds." % [target.character_name, CharacteristicSet.SHORT_NAMES.get(char_key, char_key), rounds],
			"characteristic_bonuses": {char_key: 10}, "damage_bonus": 0, "rounds": rounds,
		}
	elif prayer_name == "Sigmar's Fiery Hammer":
		## p.226: "If wielding a warhammer, it counts as Magical, deals
		## +Fellowship Bonus Damage, and any target struck receives the
		## Ablaze and Prone Conditions" — Range: You, Target: You, so
		## this always lands on the caster (the targeting flow above
		## already defaults non-damage Prayers/Spells to `player`, so
		## `target` here is always `player` in practice; read off
		## `target` anyway rather than `player` for correctness).
		## The Damage bonus is really gated on wielding a Warhammer —
		## see Character.get_active_damage_bonus(weapon), which only
		## counts this specific buff's damage_bonus while the attacking
		## weapon's name contains "Warhammer" OR is this Miracle's own
		## renamed clone (see the rename just below — its shortened name
		## no longer contains "Warhammer" itself, so the gate checks for
		## either) — and the Ablaze+Prone hit effect is applied in
		## _show_attack_cards() alongside the Flaming Sword of Rhuin
		## precedent, gated the same way. "Counts as Magical" is left as
		## a documented, unimplemented gap: this project has no "bypass
		## non-magical-attack immunity" mechanic anywhere yet (see the
		## Breath spell's own comment on this).
		var rounds := target.get_characteristic_bonus("fellowship")
		var dmg_bonus := target.get_characteristic_bonus("fellowship")
		target.add_timed_buff(prayer_name, "Sigmar", {}, rounds, dmg_bonus)
		var desc := "%s's Warhammer deals +%d Damage for %d Rounds (any target struck catches Ablaze and falls Prone)." % [target.character_name, dmg_bonus, rounds]
		## Per the explicit follow-up request ("should rename the weapon
		## while its active"): while `target` is actually wielding a
		## Warhammer, clone it and rename the clone for the Duration —
		## mirroring Flaming Sword of Rhuin's own weapon-rename pattern
		## (Character.fiery_hammer_weapon/_item_name, get_equipped_
		## weapon()'s own override) — but leaving Damage/Qualities alone,
		## since the +Fellowship Bonus Damage is already granted
		## separately and generically above via active_buffs +
		## get_active_damage_bonus(weapon)'s own Warhammer gate. This
		## clone exists purely so every weapon-name display (attack
		## cards, the equipment panel, _weapon_for()'s own combat cache)
		## shows the enchanted name while the buff is live. If `target`
		## isn't currently wielding a Warhammer, there's nothing to
		## rename — same "no Damage bonus either" case the gate above
		## already documents — so this is silently skipped rather than
		## renaming an unrelated weapon.
		var real_weapon: WeaponDefinition = GameData.weapon_db.find_by_name(target.equipped_weapon)
		if real_weapon != null and real_weapon.weapon_name.contains("Warhammer"):
			var enchanted := real_weapon.duplicate(true) as WeaponDefinition
			## Per the explicit follow-up ("shorten it just Sigmar's Fiery
			## Hammer (1/2H)"): drop the base weapon's own name (and any
			## "Fine" prefix) entirely rather than appending onto it the
			## way Flaming Sword's own naming did — just the Miracle's
			## name plus a bare (1H)/(2H) hand-count suffix, read off the
			## real weapon's own name (every Warhammer entry in
			## weapon_db carries exactly one of these two literal
			## substrings, "Fine" or not).
			var hand_suffix := "(2H)" if real_weapon.weapon_name.contains("(2H)") else "(1H)"
			enchanted.weapon_name = "Sigmar's Fiery Hammer %s" % hand_suffix
			target.fiery_hammer_weapon = enchanted
			target.fiery_hammer_item_name = target.equipped_weapon
			weapons[target] = enchanted
		return {
			"desc": desc,
			"characteristic_bonuses": {}, "damage_bonus": dmg_bonus, "rounds": rounds,
			"self_only": true,
		}
	return {}

## Blessings/Miracles' own Overcasting, called once the whole Pray Test
## (including any Fortune Point redo) is fully resolved — same call
## timing _on_cast_spell uses for _offer_overcasting(), after its own
## Fortune-spend loop. `buff_shape` is exactly what
## _apply_prayer_buff_effect() just returned and already applied once to
## `target`'s own active_buffs (as the very last entry there — nothing
## else appends to active_buffs between that call and this one, so
## `target.active_buffs.back()` below is reliably that same entry, no
## extra matching needed).
##
## Per the request: two columns, both costing 2 SL per stage (matching
## the book's own "+2 SL per increment" pacing for Blessings) —
## Targets (RAW, unchanged: +1 friendly recipient per stage, picked from
## living allies other than the original target) and Duration, which
## is a DELIBERATE house-rule departure from RAW's flat "+6 Rounds per
## stage": each stage instead MULTIPLIES the base Duration (x2, then x3,
## x4, x5...) rather than adding a same-size flat top-up regardless of
## how long the base already was — the user's own explicit ask, and
## more satisfying for a prayer like Sigmar's Fiery Hammer whose base
## Duration (Fellowship Bonus Rounds) can be quite different from the
## flat-Duration Blessings' own fixed 6. Both columns can be bought in
## the same casting (independent stages, same as the book's "effects can
## be drawn from multiple columns" wording for spell Overcasting), each
## paid for out of the same shared SL pool.
func _offer_blessing_overcast(prayer_name: String, target: Character, sl: int, buff_shape: Dictionary) -> void:
	var max_stages: int = int(sl / 2.0)
	if max_stages < 1:
		return

	## Self-only Blessings/Miracles (currently just Sigmar's Fiery Hammer,
	## per its own "Target: You" and the explicit request "its self
	## only") never offer the Targets column below — Overcast SL can
	## still be spent on Duration as usual, just not to spread the buff
	## onto other party members.
	var self_only: bool = buff_shape.get("self_only", false)
	var candidates: Array[Character] = []
	if not self_only:
		for ally in encounter.get_living("ally"):
			if ally != target:
				candidates.append(ally)
	var max_targets: int = min(max_stages, candidates.size())

	awaiting_overcast_choice = true
	_pending_choice_str = ""
	var chosen: Array[Character] = []

	## Per the request: confined to the Magic/Prayers column, same
	## reasoning (and same helper) _offer_overcasting() already uses for
	## spells — see that function's own comment on why the content gets
	## its own VBox parented to the column's wrapper rather than nested
	## inside the HFlowContainer column itself.
	var col := _build_scoped_column("Magic / Prayers")
	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override("separation", 3)
	col.get_parent().add_child(vbox)
	var header := Label.new()
	header.text = "Blessing Overcast: %d SL available to spend (2 SL per stage)." % sl
	header.autowrap_mode = TextServer.AUTOWRAP_WORD
	header.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
	header.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	vbox.add_child(header)

	var remaining_row := HBoxContainer.new()
	remaining_row.add_theme_constant_override("separation", 6)
	var remaining_label := Label.new()
	remaining_label.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	remaining_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	remaining_row.add_child(remaining_label)
	vbox.add_child(remaining_row)

	var duration_picker := OptionButton.new()
	duration_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	duration_picker.add_item("Duration: skip")
	for stage in range(1, max_stages + 1):
		duration_picker.add_item("Duration: %d SL → x%d Duration" % [stage * 2, stage + 1])
	remaining_row.add_child(duration_picker)

	var target_picker := OptionButton.new()
	target_picker.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	var candidate_row := HFlowContainer.new()
	candidate_row.add_theme_constant_override("separation", 4)
	if max_targets >= 1:
		target_picker.add_item("Targets: skip")
		for n in range(1, max_targets + 1):
			target_picker.add_item("Targets: %d SL → +%d Target(s)" % [n * 2, n])
		remaining_row.add_child(target_picker)
		for c in candidates:
			var btn := _make_button(ACTION_COLUMN_FONT_SIZE)
			btn.text = c.character_name
			btn.toggle_mode = true
			btn.pressed.connect(func():
				if btn.button_pressed:
					chosen.append(c)
				else:
					chosen.erase(c)
			)
			candidate_row.add_child(btn)
		vbox.add_child(candidate_row)

	var update_remaining := func():
		var duration_spend: int = duration_picker.selected * 2 if duration_picker.selected > 0 else 0
		var targets_spend: int = target_picker.selected * 2 if (max_targets >= 1 and target_picker.selected > 0) else 0
		var remaining: int = sl - duration_spend - targets_spend
		if remaining < 0:
			remaining_label.text = "Overspent by %d SL — reduce a choice." % -remaining
			remaining_label.add_theme_color_override("font_color", Color(0.85, 0.35, 0.3))
		else:
			remaining_label.text = "%d SL remaining" % remaining
			remaining_label.add_theme_color_override("font_color", Color(0.55, 0.75, 0.4) if remaining > 0 else Color(0.75, 0.6, 0.4))
	update_remaining.call()
	duration_picker.item_selected.connect(func(_index): update_remaining.call())
	if max_targets >= 1:
		target_picker.item_selected.connect(func(_index): update_remaining.call())

	var status_label_local := Label.new()
	status_label_local.add_theme_font_size_override("font_size", 7)
	status_label_local.add_theme_color_override("font_color", Color(0.75, 0.6, 0.4))
	vbox.add_child(status_label_local)

	var confirm_row := HBoxContainer.new()
	confirm_row.add_theme_constant_override("separation", 6)
	var confirm_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	confirm_btn.text = "Confirm Overcast  [C]"
	confirm_btn.pressed.connect(func():
		var duration_spend: int = duration_picker.selected * 2 if duration_picker.selected > 0 else 0
		var targets_spend: int = target_picker.selected * 2 if (max_targets >= 1 and target_picker.selected > 0) else 0
		if duration_spend + targets_spend > sl:
			status_label_local.text = "That spends %d SL, but only %d is available — reduce a choice." % [duration_spend + targets_spend, sl]
			return
		var wanted_targets: int = target_picker.selected if (max_targets >= 1 and target_picker.selected > 0) else 0
		if chosen.size() != wanted_targets:
			status_label_local.text = "You've selected %d extra target(s), but this spend buys %d — pick exactly that many." % [chosen.size(), wanted_targets]
			return
		_pending_choice_str = "confirm"
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(confirm_btn)
	_active_overcast_confirm_button = confirm_btn
	var skip_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	skip_btn.text = "Skip Overcasting  [Enter]"
	skip_btn.pressed.connect(func():
		_pending_choice_str = ""
		awaiting_overcast_choice = false
	)
	confirm_row.add_child(skip_btn)
	_active_overcast_skip_button = skip_btn
	_active_primary_hotkey_button = skip_btn
	col.add_child(confirm_row)
	_auto_focus_default_button()

	while awaiting_overcast_choice:
		await get_tree().process_frame
	_clear(target_container)

	if _pending_choice_str != "confirm":
		return

	var duration_stage: int = duration_picker.selected
	var targets_count: int = target_picker.selected if max_targets >= 1 else 0
	var final_rounds: int = buff_shape["rounds"] * (duration_stage + 1)

	var lines: Array[String] = []
	if duration_stage > 0 and not target.active_buffs.is_empty():
		var applied_buff: Dictionary = target.active_buffs.back()
		if applied_buff["name"] == prayer_name:
			applied_buff["rounds_remaining"] = final_rounds
			lines.append("%s's %s Duration multiplied to x%d (%d Rounds)" % [target.character_name, prayer_name, duration_stage + 1, final_rounds])

	for c in chosen.slice(0, targets_count):
		c.add_timed_buff(prayer_name, "Sigmar", buff_shape["characteristic_bonuses"], final_rounds, buff_shape["damage_bonus"])
		lines.append("%s also gains the Blessing (%d Rounds)" % [c.character_name, final_rounds])

	_render_status()
	if not lines.is_empty():
		_add_notice("[color=#8fbf6a]Overcast (%s): %s[/color]" % [prayer_name, ", ".join(lines)])

func _on_pray(prayer_name: String, target: Character) -> void:
	if not awaiting_player_target or action_used_this_turn:
		return
	## See _is_players_own_turn()'s own comment — same guard every other
	## Action-initiating handler in this file now carries.
	if not _is_players_own_turn():
		_clear(target_container)
		_clear(side_actions_container)
		return
	awaiting_player_target = false
	_clear(target_container)
	action_used_this_turn = true
	var prayer: PrayerDefinition = GameData.prayer_db.find_by_name(prayer_name)
	var effort := _consume_effort_bonus()
	var pray_result := PrayerResolver.pray(player, prayer, effort[0])
	pray_result.test_result.target_modifiers = effort[1]

	var prev_delta := _apply_pray_outcome(pray_result, prayer, prayer_name, target, false)
	_render_status()

	var choice := await _offer_fortune_spend(pray_result.test_result)
	while choice == "reroll" or choice == "sl":
		if choice == "reroll":
			pray_result = PrayerResolver.pray(player, prayer, effort[0])
			pray_result.test_result.target_modifiers = effort[1]
		## Undo the previous attempt's effects before reapplying: Wound
		## deltas (Blessing of Healing, Soulfire's per-enemy AoE) get
		## reversed by character, and a buff Blessing's just-added
		## active_buffs entry gets popped off before a fresh one is
		## granted, so a redo can never double up.
		## Bug fix: `amount` is stored as (wounds_current before this
		## attempt) - (wounds_current after) — positive for damage taken,
		## negative for a heal (see Blessing of Healing/Soulfire below) —
		## so undoing it means moving wounds_current back UP by that same
		## amount (current + amount), not subtracting it again. The old
		## `- amount` doubled damage down toward 0 instead of restoring it,
		## and doubled a heal upward instead of reversing it.
		for character_ref in prev_delta["wound_deltas"]:
			var amount: int = prev_delta["wound_deltas"][character_ref]
			character_ref.wounds_current = clamp(character_ref.wounds_current + amount, 0, character_ref.wounds_max)
		if prev_delta["buff_added"] and not target.active_buffs.is_empty():
			target.active_buffs.pop_back()
		prev_delta = _apply_pray_outcome(pray_result, prayer, prayer_name, target, true)
		_render_status()
		choice = await _offer_fortune_spend(pray_result.test_result)

	## Blessing Overcasting (see _offer_blessing_overcast's own comment):
	## only offered once the whole Test — Fortune redo included — is
	## fully settled, and only when this specific prayer actually landed
	## a modelled timed-buff effect (buff_shape is only ever stashed in
	## that case; a damage/heal prayer like Soulfire or Blessing of
	## Healing has nothing here to spend SL on).
	var buff_shape: Dictionary = prev_delta.get("buff_shape", {})
	if not buff_shape.is_empty():
		await _offer_blessing_overcast(prayer_name, target, pray_result.test_result.success_levels, buff_shape)

	_finish_player_action()

## Applies one attempt's prayer outcome and shows/merges its card.
## Returns {wound_deltas: {Character: int}, buff_added: bool} so a
## later redo can precisely reverse this attempt's effects.
func _apply_pray_outcome(pray_result: PrayerResolver.PrayerResult, prayer: PrayerDefinition, prayer_name: String, target: Character, merge: bool) -> Dictionary:
	var result_info := {"wound_deltas": {}, "buff_added": false}
	var extra: Array[String] = []
	var targets_hit: Array = []
	var pray_damage_data: Dictionary = {}
	if pray_result.success:
		if prayer_name == "Blessing of Healing":
			var before := target.wounds_current
			target.wounds_current = min(target.wounds_max, target.wounds_current + 1)
			result_info["wound_deltas"][target] = -(target.wounds_current - before)   ## negative: this was healing, not damage, so undoing it means SUBTRACTING a Wound back
			extra.append("%s heals 1 Wound (now %d/%d)" % [target.character_name, target.wounds_current, target.wounds_max])
		elif prayer_name == "Soulfire" and target != player:
			## p.226: "Holy fire explodes from your body, blasting
			## outwards for Fellowship Bonus yards. All targets within
			## range take 1d10 Wounds, ignoring Toughness Bonus and
			## Armour Points" — a real Area of Effect, not a single-
			## target bolt, so every living adversary is hit, not just
			## whichever one was selected. This project doesn't track
			## battlefield distance, so "within range" is simplified to
			## "every enemy currently in the fight" — documented, not
			## silently narrowed to one target.
			## Per the request: the damage is rolled ONCE for the whole
			## blast, not re-rolled per enemy — every enemy caught in it
			## takes the same 1d10 result.
			## Holy Hatred (p.145): "+1 Damage with Miracles per level in
			## this Talent" — a flat rank-scaled bonus added straight into
			## the rolled Damage, same as Strike Mighty Blow/Accurate Shot
			## do for weapon Damage in CombatResolver._apply_hit.
			var holy_hatred_bonus := player.get_talent_rank("Holy Hatred")
			var wounds: int = Dice.d10() + holy_hatred_bonus
			var soulfire_hits: Array = []
			for enemy in encounter.get_living("adversary"):
				var before := enemy.wounds_current
				enemy.take_wounds(wounds)
				var actual: int = before - enemy.wounds_current
				result_info["wound_deltas"][enemy] = actual
				targets_hit.append({"name": enemy.character_name, "wounds": actual, "mitigated": 0})
				soulfire_hits.append({"target": enemy, "wounds": actual})
				_check_for_kill_xp(enemy)
			extra.append("Holy fire blasts every enemy (ignores Toughness/Armour)")
			var soulfire_breakdown: Array = [{"name": "1d10", "amount": wounds - holy_hatred_bonus}]
			if holy_hatred_bonus > 0:
				soulfire_breakdown.append({"name": "Holy Hatred", "amount": holy_hatred_bonus})
			pray_damage_data = {"damage": wounds, "damage_breakdown": soulfire_breakdown}
			## Per the request: Soulfire hits every enemy at once — a real
			## AoE despite being offered through the single-target Pray UI
			## — so it gets the same explosion-per-target treatment as a
			## true AoE spell/prayer, not a single magic missile.
			_play_magic_aoe_fx(soulfire_hits)
			selected_target = target
			ally_focus_target[player] = target
			_refresh_enemy_display()
		else:
			var buff_result := _apply_prayer_buff_effect(prayer_name, target)
			if not buff_result.is_empty():
				extra.append(buff_result["desc"])
				result_info["buff_added"] = true
				## Stashed for _offer_blessing_overcast(), called once the
				## whole Pray Test (including any Fortune redo) is final —
				## see that function's own comment for why this exact shape.
				result_info["buff_shape"] = buff_result
			else:
				extra.append(prayer.summary)
	else:
		extra.append("Your god does not answer this time.")
	if not pray_result.wrath.is_empty():
		var applied := PrayerResolver.apply_wrath_tags(player, pray_result.wrath.get("tags", []))
		var wrath_line: String = pray_result.wrath.get("text", "")
		if not applied.is_empty():
			wrath_line += " (" + " ".join(applied) + ")"
		extra.append("[color=#c9506a]Wrath of the Gods (roll %d, Sin %d): %s[/color]" % [pray_result.wrath.get("roll", 0), player.sin_points, wrath_line])

	_show_single_card(player, prayer_name, prayer.prayer_type, "ally", pray_result.test_result, extra, merge, targets_hit, pray_damage_data)
	return result_info

## AoE counterpart to _on_pray — called by _resolve_aoe_cast for
## Twin-tailed Comet once the player's clicked an impact square,
## `targets` already computed as "living adversaries standing in the
## affected radius." Mirrors _on_pray's own structure (Fortune reroll
## loop, Wrath) but never uses a single `target` Character.
func _on_pray_aoe(prayer_name: String, targets: Array) -> void:
	var prayer: PrayerDefinition = GameData.prayer_db.find_by_name(prayer_name)
	var effort := _consume_effort_bonus()
	var pray_result := PrayerResolver.pray(player, prayer, effort[0])
	pray_result.test_result.target_modifiers = effort[1]

	var prev_delta := _apply_pray_outcome_aoe(pray_result, prayer, prayer_name, targets, false)
	_render_status()

	var choice := await _offer_fortune_spend(pray_result.test_result)
	while choice == "reroll" or choice == "sl":
		if choice == "reroll":
			pray_result = PrayerResolver.pray(player, prayer, effort[0])
			pray_result.test_result.target_modifiers = effort[1]
		for character_ref in prev_delta["wound_deltas"]:
			var amount: int = prev_delta["wound_deltas"][character_ref]
			character_ref.wounds_current = clamp(character_ref.wounds_current + amount, 0, character_ref.wounds_max)
		prev_delta = _apply_pray_outcome_aoe(pray_result, prayer, prayer_name, targets, true)
		_render_status()
		choice = await _offer_fortune_spend(pray_result.test_result)

	_finish_player_action()

## AoE counterpart to _apply_pray_outcome, currently only for
## Twin-tailed Comet — rolls the prayer's damage (1d10 + this Test's own
## SL) ONCE, per the request, and applies that same value to every
## target in `targets`, ignoring Toughness Bonus and Armour Points (per
## the prayer's own summary, same as Soulfire) and granting Ablaze.
## Returns {wound_deltas: {Character: int}} for Fortune-reroll undo.
func _apply_pray_outcome_aoe(pray_result: PrayerResolver.PrayerResult, prayer: PrayerDefinition, prayer_name: String, targets: Array, merge: bool) -> Dictionary:
	var result_info := {"wound_deltas": {}}
	var extra: Array[String] = []
	var targets_hit: Array = []
	var pray_damage_data: Dictionary = {}
	if pray_result.success:
		if prayer_name == "Twin-tailed Comet":
			if targets.is_empty():
				extra.append("The comet strikes empty ground — no one was caught in it.")
			else:
				var roll := Dice.d10()
				## Holy Hatred (p.145): "+1 Damage with Miracles per level
				## in this Talent" — same flat rank-scaled bonus as
				## Soulfire above, applying to every damaging Miracle.
				var holy_hatred_bonus := player.get_talent_rank("Holy Hatred")
				var dmg: int = max(0, roll + pray_result.test_result.success_levels + holy_hatred_bonus)
				var comet_hits: Array = []
				for t: Character in targets:
					var before: int = t.wounds_current
					t.take_wounds(dmg)
					result_info["wound_deltas"][t] = before - t.wounds_current
					t.add_condition("Ablaze", 1)
					targets_hit.append({"name": t.character_name, "wounds": before - t.wounds_current, "mitigated": 0})
					comet_hits.append({"target": t, "wounds": before - t.wounds_current})
					_check_for_kill_xp(t)
				## Per the request: the 1d10 roll now shows as its own boxed
				## number on the card (same "5+13=18" Damage row a weapon
				## attack gets) instead of only appearing baked into this
				## flavour text — the numeric formula is dropped here since
				## it's now redundant with the card's own Damage breakdown.
				extra.append("A blazing comet strikes — ignores Toughness/Armour, gains Ablaze")
				var comet_breakdown: Array = [{"name": "1d10", "amount": roll}, {"name": "SL", "amount": pray_result.test_result.success_levels}]
				if holy_hatred_bonus > 0:
					comet_breakdown.append({"name": "Holy Hatred", "amount": holy_hatred_bonus})
				pray_damage_data = {"damage": dmg, "damage_breakdown": comet_breakdown}
				_play_magic_aoe_fx(comet_hits)
				_refresh_enemy_display()
		else:
			extra.append(prayer.summary)
	else:
		extra.append("Your god does not answer this time.")
	if not pray_result.wrath.is_empty():
		var applied := PrayerResolver.apply_wrath_tags(player, pray_result.wrath.get("tags", []))
		var wrath_line: String = pray_result.wrath.get("text", "")
		if not applied.is_empty():
			wrath_line += " (" + " ".join(applied) + ")"
		extra.append("[color=#c9506a]Wrath of the Gods (roll %d, Sin %d): %s[/color]" % [pray_result.wrath.get("roll", 0), player.sin_points, wrath_line])
	_show_single_card(player, prayer_name, prayer.prayer_type, "ally", pray_result.test_result, extra, merge, targets_hit, pray_damage_data)
	return result_info

## --- Monster turn / battle end -------------------------------------------

## Deliberately simple heuristics, not a full utility AI:
## - A "boss" (is_important/is_nemesis) spends the Advantage its side
##   has built up — Additional Effort to press its attack, and
##   occasionally a genuine extra Additional Action afterward if there's
##   enough banked. Ordinary monsters mostly just fight, which is itself
##   one of the easiest ways to keep building Advantage for their side
##   (Winning/Outmaneuver).
## - Any monster not in immediate danger (over half Wounds) has a
##   chance to Assess instead of attacking — sizing up the fight rather
##   than swinging — more often if it isn't a boss (a boss already has
##   a use for Advantage once it has some banked).
## Per the request: which of this project's own damage- or Condition-
## inflicting spells a Spellcaster creature can actually use. The
## specific Lore named in the Trait (e.g. "Spellcaster (Beasts)")
## doesn't have its own dedicated spell list in this project's data —
## a real, documented gap — so every Spellcaster creature draws from
## this same pool of mechanically-real spells regardless of which
## Lore its own Trait names, rather than being unable to cast
## anything at all.
## Per the follow-up request ("firstly give them Bolt and Blast"): a
## Spellcaster's own kit now grows with the encounter's Difficulty
## Tier rather than swapping — Dart alone at Tier 1 (a weak creature
## sticking to the cheap, always-castable option), Dart PLUS Bolt and
## Blast from Tier 2 up, so a tougher spellcaster has real single-
## target (Bolt, more damage) and area (Blast) options to actually
## weigh against each other — see _monster_cast_spell's own spell-
## selection scoring for how it picks between them.
func _get_monster_castable_spells(_actor: Character) -> Array[SpellDefinition]:
	var result: Array[SpellDefinition] = []
	var dart: SpellDefinition = GameData.spell_db.find_by_name("Dart")
	if dart != null:
		result.append(dart)
	if GameState.current_field_difficulty_tier >= 2:
		var bolt: SpellDefinition = GameData.spell_db.find_by_name("Bolt")
		if bolt != null:
			result.append(bolt)
		var blast: SpellDefinition = GameData.spell_db.find_by_name("Blast")
		if blast != null:
			result.append(blast)
	return result

## Monster-side counterpart to _aoe_radius_squares — identical Blast
## math (WP Bonus yards, converted to squares), just keyed off whatever
## creature is casting instead of always reading the module-level
## `player` (that helper is written specifically for the player's own
## AoE targeting UI and has no `actor` parameter to reuse here).
func _monster_aoe_radius_squares(actor: Character) -> int:
	return actor.get_characteristic_bonus("willpower") / BattleGrid.YARDS_PER_SQUARE

## Per the request ("make them consider using [Bolt/Blast] carefully"):
## for the AoE option specifically, finds whichever living ally's own
## square — used as the Blast's epicenter — catches the most OTHER
## living allies within the caster's own Blast radius alongside them.
## Returns the empty array (and a null center) if nobody's clustered
## enough for Blast to ever be worth it over a single-target spell —
## _monster_cast_spell's own scoring below then naturally never picks
## Blast in that case (see its `value` calc), rather than this needing
## its own separate "is it worth it" gate.
func _best_monster_blast_cluster(actor: Character, living_allies: Array[Character]) -> Dictionary:
	var radius := _monster_aoe_radius_squares(actor)
	var best_hits: Array[Character] = []
	var best_center: Character = null
	if battle_grid == null:
		return {"center": null, "hits": best_hits}
	for candidate in living_allies:
		if not battle_positions.has(candidate):
			continue
		var hits: Array[Character] = []
		for other in living_allies:
			if battle_positions.has(other) and battle_grid.distance_squares(battle_positions[candidate], battle_positions[other]) <= radius:
				hits.append(other)
		if hits.size() > best_hits.size():
			best_hits = hits
			best_center = candidate
	return {"center": best_center, "hits": best_hits}

## Returns true if this consumed the monster's own Turn (either
## actually casting or spending the Turn Channelling toward one),
## false if it declined entirely (no Spellcaster Trait, no living
## target to aim at, or — per the follow-up request below — it
## deliberately chose not to this Turn).
func _monster_cast_spell(actor: Character) -> bool:
	if not actor.has_creature_trait("Spellcaster") or encounter.is_defeated(actor):
		return false
	var castable := _get_monster_castable_spells(actor)
	if castable.is_empty():
		return false
	var living_allies := encounter.get_living("ally")
	if living_allies.is_empty():
		return false

	var language_magick: SkillDefinition = GameData.skill_db.find_by_name("Language (Magick)")
	if language_magick == null:
		return false
	var skill_value := actor.get_skill_value(language_magick)

	## Per the request ("ask themselves if they should cast at all if
	## they are engaged, or if Melee simply yields a better statistical
	## chance of success"): both Casting (Language (Magick), the exact
	## skill MagicResolver.cast() tests) and a Melee attack (the Melee
	## skill, the exact skill CombatResolver.resolve_melee_attack()
	## tests) are plain roll-under-d100 Tests, so each skill's own raw
	## value already IS its % chance of a bare success — directly
	## comparable without needing a new probability model. Only
	## considered for a creature that actually HAS a melee option
	## (a ranged-weapon caster has nothing here to fall back to, so it
	## always at least considers casting).
	## "Engaged" per this project's own combat_encounter.gd is now a real
	## hit-exchange graph (is_currently_engaged: has a still-living
	## partner actually traded blows with this encounter — see
	## combat_encounter.gd's own comments) rather than mere proximity —
	## checked directly here too via genuine current adjacency (battle_grid
	## distance), since a caster that's RIGHT NOW standing next to an ally
	## is the case that actually matters for "should I risk casting
	## instead of swinging," even before any blow's actually landed
	## between them. Either counts: a real, if rough, proxy for "magic is
	## dangerous to attempt with a blade at your throat" — this project
	## has no explicit Casting-while-threatened penalty to model
	## directly, so an engaged caster's own effective Casting chance is
	## knocked down as a deliberate thumb on the scale toward melee
	## instead, on top of comparing the raw numbers.
	var currently_engaged: bool = encounter.is_currently_engaged(actor)
	if not currently_engaged and battle_grid != null and battle_positions.has(actor):
		for ally in living_allies:
			if battle_positions.has(ally) and BattleGrid.footprint_distance(battle_positions[actor], actor.get_footprint_size(), battle_positions[ally], ally.get_footprint_size()) <= 1:
				currently_engaged = true
				break

	var melee_skill: SkillDefinition = GameData.skill_db.find_by_name("Melee")
	var has_melee_option: bool = melee_skill != null and not _weapon_for(actor).is_ranged
	if has_melee_option:
		var melee_chance: float = actor.get_skill_value(melee_skill, _weapon_for(actor).skill_group)
		var effective_cast_chance: float = skill_value * (0.6 if currently_engaged else 1.0)
		if melee_chance > effective_cast_chance:
			return false

	var target: Character = _choose_monster_target(actor, living_allies)

	## Per the request ("make them consider using them carefully"):
	## rather than a flat random pick among every castable spell, score
	## each candidate on the tactical value it'd actually deliver right
	## now (Blast only pays off with 2+ allies caught in its radius;
	## Bolt's extra flat damage over Dart is real but modest; Dart is
	## always the safe CN-0 fallback) discounted by how confidently this
	## creature can land that spell's own CN outright (the same
	## skill_value-vs-20+CN*10 threshold the old single-spell version
	## already used) — a spell that's technically better but needs a
	## Turn spent Channelling first isn't automatically worth reaching
	## for over one this creature can just cast right now.
	var cluster := _best_monster_blast_cluster(actor, living_allies)
	var blast_hits: Array[Character] = cluster["hits"]
	var best_spell: SpellDefinition = null
	var best_score := -1.0
	for sp in castable:
		var confidently_castable: bool = skill_value >= 20 + sp.casting_number * 10
		var confidence: float = 1.0 if confidently_castable else clampf(skill_value / float(max(1, 20 + sp.casting_number * 10)), 0.15, 0.85)
		var value: float
		if sp.is_area_of_effect:
			## Never worth reaching for with fewer than 2 allies caught —
			## scores 0 so Dart/Bolt (which always score > 0) win by
			## default rather than this needing its own separate gate.
			value = 0.0 if blast_hits.size() < 2 else 1.5 + 0.6 * float(blast_hits.size())
		else:
			value = 1.0 + float(sp.damage_flat) * 0.2   ## Dart (0 flat) = 1.0, Bolt (4 flat) = 1.8
		var score := value * confidence
		if score > best_score:
			best_score = score
			best_spell = sp
	var chosen_spell: SpellDefinition = best_spell

	## Per the request ("channel if they need to... [but] ask themselves
	## if they should cast at all if engaged"): the same real Channelling/
	## Casting process a Character follows — unless already sufficiently
	## Channelled for the chosen spell (cast now, free), or this
	## creature's own Language (Magick) is comfortably high relative to
	## that spell's own CN (cast outright, no need to spend a Turn
	## Channelling first). An engaged creature that would otherwise need
	## to spend a whole Turn Channelling — standing still while it's
	## already being traded blows with — downgrades to Dart instead, if
	## Dart is available and (being CN 0) always outright-castable: a
	## guaranteed small spell right now beats gambling a full exposed
	## Turn on a bigger one it isn't confident in yet.
	var progress: MagicResolver.ChannellingProgress = _monster_channelling_progress.get(actor)
	## Real bug fix, same one the player's own casting flow needed (see
	## _get_effective_cn/MagicResolver.channelled_cn_reduction's own
	## comments): partial accumulated Channelling SL now actually
	## reduces this CN 1-for-1, not just an all-or-nothing gate that
	## only ever paid off once accumulated_sl reached the spell's FULL
	## Casting Number.
	var channelled_cn: int = chosen_spell.casting_number - (MagicResolver.channelled_cn_reduction(progress, chosen_spell) if progress != null else 0)
	var can_cast_outright: bool = skill_value >= 20 + channelled_cn * 10
	if not can_cast_outright and currently_engaged:
		var dart_fallback: SpellDefinition = GameData.spell_db.find_by_name("Dart")
		if dart_fallback != null and castable.has(dart_fallback):
			chosen_spell = dart_fallback
			channelled_cn = chosen_spell.casting_number - (MagicResolver.channelled_cn_reduction(progress, chosen_spell) if progress != null else 0)
			can_cast_outright = true   ## Dart's CN 0 means skill_value >= 20 is true for any creature that even qualifies as a Spellcaster

	if can_cast_outright:
		var cast_result := MagicResolver.cast(actor, chosen_spell, 0, channelled_cn)
		_monster_channelling_progress.erase(actor)
		## Per the request: a monster Spellcaster was already rolling a
		## real Casting Test (MagicResolver.cast, same call a player
		## makes) — it just never showed the roll, only a plain-text
		## "casts X!"/"fails to take hold" notice, so it looked like it
		## might be faked. Now shown as a real roll card, same as every
		## player cast (_on_cast_spell above).
		var extra: Array[String] = []
		var targets_hit: Array = []
		var spell_damage_data: Dictionary = {}
		if cast_result.success:
			if chosen_spell.is_magic_missile and chosen_spell.is_area_of_effect:
				## Blast (per the request: give this creature a real
				## reason to reach for an area spell) — mirrors the
				## player's own _apply_cast_spell_outcome_aoe damage/soak
				## math, applied to every ally caught in the cluster this
				## function's own scoring already picked out above.
				var dmg := chosen_spell.damage_flat + actor.get_characteristic_bonus("willpower")
				var fx_hits: Array = []
				for hit_target: Character in blast_hits:
					if encounter.is_defeated(hit_target):
						continue
					var soak := hit_target.get_characteristic_bonus("toughness") + hit_target.get_armour_points("Body")
					var wounds: int = max(1, dmg - soak)
					hit_target.take_wounds(wounds)
					targets_hit.append({"name": hit_target.character_name, "wounds": wounds, "mitigated": max(0, dmg - wounds)})
					fx_hits.append({"target": hit_target, "wounds": wounds})
				if not targets_hit.is_empty():
					extra.append("Blast (%d yard radius)" % (_monster_aoe_radius_squares(actor) * BattleGrid.YARDS_PER_SQUARE))
					spell_damage_data = {"damage": dmg, "damage_breakdown": [{"name": "Spell", "amount": chosen_spell.damage_flat}, {"name": "Willpower Bonus", "amount": actor.get_characteristic_bonus("willpower")}]}
					_play_magic_aoe_fx(fx_hits)
					_refresh_enemy_display()
				else:
					extra.append("No one was caught in the blast.")
			elif chosen_spell.is_magic_missile:
				var dmg := chosen_spell.damage_flat + actor.get_characteristic_bonus("willpower")
				var soak := target.get_characteristic_bonus("toughness") + target.get_armour_points("Body")
				var wounds: int = max(1, dmg - soak)
				target.take_wounds(wounds)
				_play_magic_missile_fx(actor, target, wounds)
				var breakdown: Array = [{"name": "Spell", "amount": chosen_spell.damage_flat}, {"name": "Willpower Bonus", "amount": actor.get_characteristic_bonus("willpower")}]
				var hit_entry := {"name": target.character_name, "wounds": wounds, "mitigated": max(0, dmg - wounds)}
				targets_hit.append(hit_entry)
				spell_damage_data = {"damage": dmg, "damage_breakdown": breakdown}
			elif chosen_spell.inflicts_condition != "":
				target.add_condition(chosen_spell.inflicts_condition, chosen_spell.inflicts_condition_stacks)
				extra.append("%s inflicted on %s." % [chosen_spell.inflicts_condition, target.character_name])
			else:
				extra.append(chosen_spell.summary)
		else:
			extra.append("The spell fails to take hold.")
		if cast_result.critical:
			extra.append("Critical Cast!")
		_show_single_card(actor, chosen_spell.spell_name, "Spell (CN %d)" % channelled_cn, actor.allegiance, cast_result.test_result, extra, false, targets_hit, spell_damage_data)
	else:
		if not _monster_channelling_progress.has(actor):
			_monster_channelling_progress[actor] = MagicResolver.ChannellingProgress.new()
		var chan_progress: MagicResolver.ChannellingProgress = _monster_channelling_progress[actor]
		var channel_result: Dictionary = MagicResolver.channel_round(actor, chan_progress, "", 0, false)
		var channel_extra: Array[String] = []
		if channel_result["test_result"].is_fumble:
			channel_extra.append("Fumble! All magic channelled so far is lost.")
		elif chan_progress.critical_ready and channel_result["test_result"].is_critical:
			channel_extra.append("Critical Channelling! Ready to cast %s at CN 0 whenever it does — stays ready, not just for one Round." % chosen_spell.spell_name)
		else:
			channel_extra.append("%d SL accumulated so far, gathering power for %s." % [chan_progress.accumulated_sl, chosen_spell.spell_name])
		_show_single_card(actor, "Channel", "Channelling", actor.allegiance, channel_result["test_result"], channel_extra)

	_render_status()
	_refresh_enemy_display()
	await _wait_for_continue()
	_next_turn()
	return true

func _do_monster_turn(actor: Character) -> void:
	## Surprised (p.167-169, same handling as the player-side check
	## elsewhere in this file): "can take no Action or Move" — skips
	## this Turn entirely, then clears itself after this first
	## attempt, exactly like the player's own Surprised handling.
	## Previously only ever checked on the player's own turn — a
	## Surprised monster (from a successful player ambush) would have
	## acted completely normally, since nothing here ever looked for
	## the condition on the monster side.
	if actor.conditions.has("Surprised"):
		_add_notice("[b]%s[/b] is Surprised and cannot Move or Act this turn." % actor.character_name)
		actor.conditions.erase("Surprised")
		_ground_flying_creature_if_incapacitated(actor)
		await get_tree().create_timer(0.6).timeout
		_next_turn()
		return

	## Stunned (p.167-169, same "cannot act" handling the player-side
	## already had via _prompt_player_turn's own Unconscious/Stunned/
	## Surprised check) — a real, previously-missing gap on the monster
	## side: Pummel Quality already applies Stunned to a monster target
	## (see _apply_pummel_quality), and the Oops! Table's own
	## lose_next_move/miss_next_action/hit_random_ally_or_self results
	## (see _apply_fumble_effects) can too, but nothing here ever
	## checked for it before, so a Stunned monster fought completely
	## normally regardless. Not manually cleared here, unlike Surprised
	## above — Stunned already has its own stack-based recovery (a
	## Challenging Endurance Test at Round end, see Character's own
	## round-end tick) that already runs for monsters exactly as it does
	## for allies.
	if actor.conditions.has("Stunned"):
		_add_notice("[b]%s[/b] is Stunned and cannot Move or Act this turn." % actor.character_name)
		_ground_flying_creature_if_incapacitated(actor)
		await get_tree().create_timer(0.6).timeout
		_next_turn()
		return

	## Broken (p.168): "You must use your Move and Action to flee from
	## combat and attempt to hide... you cannot use your Action for
	## anything else." Per the request ("IF players gain Broken, Fear or
	## Terror restrict their actions and movement appropriately" —
	## applied symmetrically to monsters too, same principle as the Flee
	## free-attack penalty already being shared both ways): a Broken
	## monster no longer fights normally at all this Turn, checked ahead
	## of every other branch below (Stupid confusion, Bestial's own
	## half-Wounds Flee, Opening Exchange, casting, ...) since a
	## genuinely panicking creature doesn't pause to weigh any of those.
	## Reuses the same forced-flee movement Bestial's own Flee uses.
	if actor.conditions.has("Broken"):
		await _flee_and_maybe_escape(
			actor,
			"is Broken and panicking, but has nowhere left to flee — it cowers in place.",
			"is Broken and panics, fleeing the fight!"
		)
		return

	## A brief automatic "thinking" pause before the monster's turn even
	## starts — deliberately NOT an Enter-wait like the pacing after a
	## roll card, since there's nothing on screen yet for the player to
	## review or acknowledge.
	await get_tree().create_timer(0.6).timeout

	## Regenerate (p.339): "At the start of your Turn, you heal a
	## number of Wounds equal to your Toughness Bonus." A real,
	## previously-missing mechanical effect — this Trait was documented
	## in the reference database and specifically called out in the
	## Troll's own README entry as making it dangerous, but had no
	## actual implementation anywhere in combat until now. Only while
	## still alive and below max Wounds — nothing to regenerate
	## otherwise, and a defeated creature shouldn't come back from this.
	if actor.has_creature_trait("Regenerate") and actor.wounds_current > 0 and actor.wounds_current < actor.wounds_max:
		var heal_amount: int = actor.get_characteristic_bonus("toughness")
		if heal_amount > 0:
			var actual_heal: int = min(heal_amount, actor.wounds_max - actor.wounds_current)
			actor.wounds_current += actual_heal
			_add_notice("[color=#8fbf6a][b]%s[/b] regenerates %d Wound(s)! (%d/%d)[/color]" % [actor.character_name, actual_heal, actor.wounds_current, actor.wounds_max])
			_render_status()

	var pool := encounter.advantage_pool
	var is_boss: bool = actor.is_important or actor.is_nemesis
	var health_frac := float(actor.wounds_current) / float(max(actor.wounds_max, 1))
	var safe := health_frac > 0.5
	var is_first_turn: bool = not monster_turn_count.has(actor)
	monster_turn_count[actor] = monster_turn_count.get(actor, 0) + 1
	var is_lone: bool = encounter.get_living("adversary").size() == 1

	## Stupid (p.341): "must pass an Easy (+40) Intelligence Test at the
	## start of each round, or become very confused... losing both its
	## Move and Action" — unless a non-Stupid ally is nearby to guide
	## it, which this project simplifies to "any other living ally
	## without Stupid" rather than tracking actual battlefield position.
	if actor.has_creature_trait("Stupid"):
		var has_guiding_ally := false
		for ally in encounter.get_living(actor.allegiance):
			if ally != actor and not ally.has_creature_trait("Stupid"):
				has_guiding_ally = true
				break
		if not has_guiding_ally:
			var stupid_test := TestResolver.resolve_characteristic_test(actor, "intelligence", 40)
			if not stupid_test.success:
				_add_notice("[b]%s[/b] is Stupid, and fumbles about uselessly this Round instead of acting." % actor.character_name)
				_next_turn()
				return

	## Bestial (p.338): "If it loses more than half its Wounds, it will
	## attempt to Flee unless protecting its young or cornered, or
	## unless it has the Territorial Trait. If so, it enters Frenzy."
	## Per the request ("Let enemies run away if they need to and if
	## they reach the edge of the battle map remove them from the
	## battle"): a fleeing Bestial creature now genuinely runs (see
	## _flee_and_maybe_escape, shared with Broken's own forced flee
	## below) instead of the previous "cowers defensively, doesn't
	## actually move" stand-in — "cornered" (nowhere left to retreat
	## to) still falls back to that same cower behaviour, now as a real
	## consequence of _advance_away_from finding no open ground, not a
	## separate hardcoded case. A Territorial creature (or one already
	## Frenzied) enters Frenzy instead of fleeing at all, unchanged.
	if actor.has_creature_trait("Bestial") and health_frac <= 0.5:
		if actor.has_creature_trait("Territorial") or actor.has_creature_trait("Frenzy"):
			if not actor.conditions.has("Frenzy"):
				actor.add_condition("Frenzy")
				_add_notice("[b]%s[/b] is cornered and flies into a Frenzy!" % actor.character_name)
		else:
			await _flee_and_maybe_escape(
				actor,
				"is Bestial and badly hurt, but has nowhere left to flee — it cowers defensively.",
				"is Bestial and badly hurt — it turns and flees the fight!"
			)
			return

	## Per the request: a creature with the Spellcaster Trait gets a
	## real chance to cast a damage- or Condition-inflicting spell
	## before falling through to a normal attack — checked ahead of
	## the Opening Exchange below, since a spellcaster should keep
	## using its own spells throughout the fight, not just at the
	## start of it.
	if await _monster_cast_spell(actor):
		return

	## Opening Exchange: before anyone's committed to melee, this monster
	## gets first crack at the same choice the player does — Charge in
	## for the Advantage bonus, or hold off and let the round proceed to
	## the normal tactical decisions below. Deliberately simple and
	## separate from the boss Effort/Assess logic below: that logic is
	## about pressing an ALREADY-engaged fight, not about opening one,
	## and bosses get their chance at it starting the round after
	## they've closed the distance.
	if not melee_has_begun:
		## Tongue Attack (p.343): "can use a Free Attack to hook an
		## opponent up to 12 yards away toward itself... then perform
		## another Free Attack on the Entangled Character." Checked
		## first among the Opening Exchange options — a creature with
		## this Trait always tries it rather than rolling for a normal
		## Charge, since closing the whole distance in one motion (and
		## Entangling the target) is strictly better.
		if actor.has_creature_trait("Tongue Attack") and not _weapon_for(actor).is_ranged:
			await _monster_tongue_pull(actor)
			if not pending_defense.is_empty():
				return
			_next_turn()
			return
		## Bounce (p.338): "doubles its already considerable Movement
		## when Charging or Running, and can ignore terrain and
		## intervening Characters." This project doesn't track actual
		## distance, so the real, meaningful translation is that a
		## Bounce creature can always close the distance no matter
		## what's between it and its target — it never rolls to decide
		## whether to stay at range this Round, it always Charges.
		if actor.has_creature_trait("Bounce") and not _weapon_for(actor).is_ranged:
			await _monster_attack(actor, 0, null, true)   ## Charge
			if not pending_defense.is_empty():
				return
			_next_turn()
			return
		var roll := randf()
		if not _weapon_for(actor).is_ranged and roll < 0.7:
			## Charging commits to melee — _monster_attack routes this to
			## _prompt_player_defense, which only SETS UP the "how do you
			## defend" choice and returns immediately; it does not itself
			## wait for the player. A real bug here called _next_turn()
			## unconditionally right after, silently abandoning the
			## attack and jumping straight back to a normal player turn
			## before they'd ever been asked to defend — which is exactly
			## why monsters looked like they never actually attacked.
			## _resolve_player_defense is what correctly continues the
			## round once the player responds, so nothing further happens
			## here while a defense choice is still pending.
			await _monster_attack(actor, 0, null, true)   ## Charge
			if not pending_defense.is_empty():
				return
			_next_turn()
			return

	## Additional Effort (p.163): available to any enemy with enough
	## Advantage now, not just bosses — per the request, "make all
	## enemies use their available Advantage as they see fit." Bosses
	## remain more likely to press it (a tactical veteran vs. an
	## ordinary grunt), but it's no longer boss-exclusive.
	var effort_bonus := 0
	var effort_chance := 0.6 if is_boss else 0.3
	if pool.get_pool("adversary") >= 2 and randf() < effort_chance:
		var adv_before := pool.get_pool("adversary")
		effort_bonus = GroupAdvantageActions.spend_additional_effort(pool, actor, 2)
		if effort_bonus > 0:
			_add_notice("[b]%s[/b] presses the advantage (%d → %d Advantage spent for +%d%% on this attack)." % [
				actor.character_name, adv_before, pool.get_pool("adversary"), effort_bonus
			])

	## Per the request: Batter/Trick/Assess are tactical, guileful combat
	## options — feinting, sizing up an opponent's capabilities, using
	## leverage instead of brute force. True Animals (wolves, giant rats,
	## bears, and the like) fight with tooth and claw, not tactics, so
	## they never reach for any of these three no matter how the dice
	## land — checked once here via the same MonsterDefinition.
	## creature_type == "Animal" test _is_animal_monster() itself uses.
	## Non-animal creatures (Humanoid/Monster) still only consider them
	## situationally — see
	## the "makes sense" checks below — scaled further by how genuinely
	## intelligent this particular creature is (_monster_smart_factor,
	## shared with target selection above).
	## Bestial (p.338, "no capacity for rational thought") folded into
	## this same gate, per the request to implement Bestial fully — a
	## Bestial creature never feints, sizes an opponent up, or uses
	## leverage no matter its raw Intelligence score, same as a True
	## Animal, rather than just being steeply unlikely to via
	## _monster_smart_factor's own separate 0.25 clamp for Bestial below.
	var is_animal: bool = _is_animal_monster(actor) or actor.has_creature_trait("Bestial")
	var tactical_factor: float = _monster_smart_factor(actor)

	## Per the request ("stop monsters using assess and trick so much,
	## it should be a last resort option if they can't do anything
	## else"): a genuine attack on the table beats feinting or sizing an
	## opponent up every time — Assess/Trick used to compete with a
	## perfectly good attack on pure die-roll odds regardless of whether
	## one was actually available, which read as constant, unmotivated
	## hesitation. Both are now hard-gated behind NOT currently being
	## able to land a real attack on this monster's own likely target
	## (see _monster_can_attack_now's own comment) — everything below
	## this point (is_lone/likely_to_succeed/tactical_factor scaling,
	## melee_has_begun, health, Advantage cost) still applies on TOP of
	## that gate, so this only narrows when they're even possible, it
	## doesn't loosen anything that used to hold them back.
	var likely_target: Character = monster_focus_target.get(actor)
	if likely_target == null or not encounter.get_living("ally").has(likely_target):
		likely_target = _choose_monster_target(actor, encounter.get_living("ally"))
	var can_attack_now: bool = _monster_can_attack_now(actor, likely_target)

	## A lone enemy (no allies backing it up) has nobody to size up the
	## fight FOR — it's just it and the party. It should never Assess
	## once the fight is properly underway, and even as its opening move
	## should only very rarely choose to size things up instead of just
	## engaging, and only when it's genuinely likely to pay off (a
	## Perception Test it'd probably succeed at, i.e. target >= 60).
	var can_assess := not is_animal and not can_attack_now
	var assess_chance := (0.2 if is_boss else 0.3) * tactical_factor
	if is_lone:
		if not is_first_turn:
			can_assess = false
		else:
			var perception: SkillDefinition = GameData.skill_db.find_by_name("Perception")
			var likely_to_succeed: bool = actor.get_skill_value(perception, "") >= 60
			can_assess = can_assess and likely_to_succeed
			assess_chance = (0.1 if likely_to_succeed else 0.0) * tactical_factor

	## Batter/Trick (p.134): real monster AI options too, not just the
	## player's — 1 Advantage each, only considered once melee is
	## actually underway (both are opposed melee/combat Tests, not
	## useful before anyone's engaged), only when Additional Effort
	## wasn't already spent this turn (same mutual-exclusivity the core
	## action choice below already has), and only while this creature
	## itself is in reasonable shape — a badly hurt creature needs to be
	## fighting for its life or fleeing, not trying to be clever.
	var can_batter_trick: bool = not is_animal and not can_attack_now and melee_has_begun and pool.get_pool("adversary") >= 1 and effort_bonus == 0 and health_frac > 0.3
	var batter_trick_chance := 0.15 * tactical_factor

	var roll := randf()
	if can_assess and safe and effort_bonus == 0 and roll < assess_chance:
		await _monster_assess(actor)
	elif can_batter_trick and roll < assess_chance + batter_trick_chance:
		## Real bug fix: this used to always target `player` — not
		## GameState's actively-controlled character, but a stale
		## leftover from whichever ally most recently took a Turn (see
		## _next_turn's own reassignment of this same variable), so
		## Batter/Trick landed on an essentially arbitrary party member
		## instead of a deliberately chosen one, and never on a target
		## _monster_attack's own random pick could ever have missed.
		## Now runs through the same tactical target selection as every
		## other monster action (and per the decisiveness fix above,
		## the same locked-in target that action keeps using turn after
		## turn).
		var bt_target: Character = _choose_monster_target(actor, encounter.get_living("ally"))
		var bt_target_wounds_frac: float = float(bt_target.wounds_current) / float(maxi(bt_target.wounds_max, 1)) if bt_target != null else 1.0
		if bt_target == null or bt_target_wounds_frac < 0.25:
			## Doesn't make sense either — a target already nearly beaten
			## needs finishing off, not feinting or tricking.
			await _monster_attack(actor, effort_bonus)
			if not pending_defense.is_empty():
				return
		elif randf() < 0.5:
			await _monster_batter(actor, bt_target)
		else:
			await _monster_trick(actor, bt_target)
	else:
		await _monster_attack(actor, effort_bonus)
		if not pending_defense.is_empty():
			## Same fix as above — a melee attack against the player is
			## still awaiting their defense choice; don't continue the
			## round (Additional Action included) until they respond.
			return

	## A genuine EXTRA action, on top of the one just taken — not instead
	## of it — right now, before the turn passes to anyone else. Also no
	## longer boss-exclusive, per the request; bosses remain more likely
	## to find and press an opening.
	var extra_action_chance := 0.25 if is_boss else 0.12
	if pool.get_pool("adversary") >= 4 and randf() < extra_action_chance:
		var adv_before2 := pool.get_pool("adversary")
		if GroupAdvantageActions.spend_additional_action(pool, actor):
			_add_notice("[b]%s[/b] finds an opening (%d → %d Advantage spent) — acts again immediately." % [
				actor.character_name, adv_before2, pool.get_pool("adversary")
			])
			_render_status()
			await _wait_for_continue()
			await _monster_attack(actor)
			if not pending_defense.is_empty():
				return

	_next_turn()

## A monster's attack. Ranged is unopposed and resolves immediately;
## melee against the player pauses for the player to choose HOW to
## defend before any dice are rolled (see _prompt_player_defense).
## `weapon_override` lets a caller substitute a weapon other than the
## monster's own equipped one when needed; `is_charge` applies the
## Charging Advantage bonus (p.165).
## Tongue Attack (p.343): "can use a Free Attack to hook an opponent
## up to 12 yards away toward itself using this Trait. It can then
## perform another Free Attack on the Entangled Character." This
## project doesn't model a separate Free Attack economy for monsters
## (see creature_traits.gd's own documented simplification for the
## same Trait's damage-dealing side), so this stands in as the whole
## Opening Exchange turn for a creature with it: an Agility Test to
## land the pull, opposed by the target's own Agility (representing a
## dodge/resistance attempt), and on success, the target is genuinely
## yanked into melee immediately — regardless of whatever distance
## they'd normally still be at — and Entangled, followed by a real,
## ordinary attack against them with the same natural weapon.
func _monster_tongue_pull(actor: Character) -> void:
	## Real bug fix: this used to resolve entirely against `player` —
	## the same stale "whoever last had an interactive turn" leftover
	## Batter/Trick used to hit (see _choose_monster_target's own
	## doc comment) — rather than a deliberately chosen party member,
	## so a Tongue Attack always grabbed whichever ally happened to be
	## sitting in that variable instead of a real target. Now runs
	## through the same tactical target selection as every other
	## monster action, and reassigns `player` to the real target (same
	## pattern _monster_attack already uses) so the rest of this turn
	## — including the follow-up attack below — acts on the right
	## character.
	var living_allies := encounter.get_living("ally")
	var target: Character = _choose_monster_target(actor, living_allies) if not living_allies.is_empty() else player
	player = target
	_refresh_player_display()
	var pull_test := TestResolver.resolve_characteristic_test(actor, "agility")
	var resist_test := TestResolver.resolve_characteristic_test(target, "agility")
	var pulled := pull_test.success and (not resist_test.success or pull_test.success_levels >= resist_test.success_levels)
	if pulled:
		melee_has_begun = true
		target.add_condition("Entangled")
		_add_notice("[b]%s[/b]'s tongue lashes out and hauls %s in close, coiling tight around them!" % [actor.character_name, target.character_name])
		_render_status()
		await _wait_for_continue()
		await _monster_attack(actor, 0)
	else:
		_add_notice("[b]%s[/b]'s tongue lashes out, but %s twists free before it can find purchase." % [actor.character_name, target.character_name])
		await _wait_for_continue()

## Per the request ("let's stop monsters using assess and trick so
## much, it should be a last resort option if they can't do anything
## else"): whether `actor` has a genuine attack on the table against
## `target` RIGHT NOW this Turn — melee already adjacent, or close
## enough to cover the rest of the distance with this Turn's own
## Movement and land a real hit, or ranged with an actual line of sight
## inside the weapon's own range. Mirrors the same distance/range/cover
## checks _monster_attack() itself makes just ahead of time, purely so
## _do_monster_turn can tell "attacking isn't actually on the table
## right now" (the only time Assess/Trick should even be considered)
## apart from "attacking is available, but I'm choosing not to" (which
## used to be how often they actually fired — reads as a monster
## constantly holding back from a fight it could easily be pressing).
## Neither Assess nor Batter/Trick move the monster at all (see their
## own function bodies) — standing still to feint or size things up
## instead of an attack that would otherwise land, or at least close
## real distance, is never the better tactical choice.
func _monster_can_attack_now(actor: Character, target: Character) -> bool:
	if target == null or not battle_positions.has(actor) or not battle_positions.has(target):
		return false
	var weapon: WeaponDefinition = _weapon_for(actor)
	if weapon.is_ranged:
		if battle_grid == null:
			return true
		var dist_yd := BattleGrid.distance_yards(battle_positions[actor], battle_positions[target])
		var band := BattleGrid.get_range_band(dist_yd, actor.get_effective_weapon_range(weapon))
		if band == BattleGrid.RangeBand.OUT_OF_RANGE:
			return false
		var cover_info: Dictionary = battle_grid.get_ranged_cover(battle_positions[actor], battle_positions[target])
		return not cover_info["blocked"]
	var dist: int = BattleGrid.footprint_distance(battle_positions[actor], actor.get_footprint_size(), battle_positions[target], target.get_footprint_size())
	if dist <= 1:
		return true
	var reach: int = int(round(actor.get_movement() * actor.get_stride_multiplier()))
	return dist - 1 <= reach   ## can close the rest of the way this Turn and still land adjacent

## Chooses which living ally a monster should target for an action —
## attack, spellcasting, or the Batter/Trick Advantage actions all
## route through this one shared brain, rather than each picking (or,
## for Batter/Trick until this fix, NOT picking) a target on its own.
##
## Real tactical weighting, not a uniform coin-flip: a target close to
## falling is a far more attractive kill than one at full Wounds
## (focus fire), a lightly-armoured/low-Toughness target is an easier
## kill than a walking tank (go for the soft one), and a target that
## hasn't yet been Engaged in melee reads as a backline threat (a
## caster hanging back, say) worth interrupting. How strongly a
## creature actually reasons about this scales with its own
## Intelligence — a Stupid or Bestial creature (already modelled
## elsewhere in this file as barely able to plan) stays close to the
## old blind-random behaviour, while an Important/Nemesis boss always
## picks with close to full tactical intent. Still genuinely
## randomised (weighted, not a strict best-target argmax) so even a
## clever monster doesn't become perfectly, predictably optimal.
## How tactically a creature reasons about combat, 0.15 (barely at all)
## to 1.0 (fully deliberate) — shared by target selection above and the
## Batter/Trick/Assess "does this actually make sense" gating in
## _do_monster_turn, so both use the same notion of how smart a given
## monster is rather than two independently-drifting formulas.
## True Animals (wolves, giant rats, bears, ...) never reach for the
## guileful Advantage options (Batter/Trick/Assess) — see _do_monster_turn.
## Player-side characters have no monster_defs entry at all and are
## never gated by this (only monster-turn code calls it).
func _is_animal_monster(actor: Character) -> bool:
	var mdef: MonsterDefinition = monster_defs.get(actor)
	return mdef != null and mdef.creature_type == "Animal"

func _monster_smart_factor(actor: Character) -> float:
	var int_value := actor.get_effective_characteristic_value("intelligence")
	var smart_factor: float = clampf(int_value / 50.0, 0.15, 1.0)
	if actor.has_creature_trait("Stupid") or actor.has_creature_trait("Bestial"):
		smart_factor = minf(smart_factor, 0.25)
	if actor.is_important or actor.is_nemesis:
		smart_factor = maxf(smart_factor, 0.75)
	return smart_factor

func _choose_monster_target(actor: Character, living_allies: Array[Character]) -> Character:
	if living_allies.is_empty():
		return null

	## Per the request: once this monster has picked a target, it keeps
	## attacking (and moving toward) that SAME target on every later
	## call — this turn and every following turn — rather than
	## re-rolling a fresh weighted pick each time one's needed, which is
	## what read as "not being decisive." The lock only breaks once the
	## target is no longer a valid choice (defeated or otherwise removed
	## from living_allies), at which point a fresh pick is made below and
	## re-locked.
	var locked: Character = monster_focus_target.get(actor)
	if locked != null and living_allies.has(locked):
		return locked

	if living_allies.size() == 1:
		monster_focus_target[actor] = living_allies[0]
		return living_allies[0]

	var smart_factor: float = _monster_smart_factor(actor)

	var weights: Array[float] = []
	for target in living_allies:
		var w := _monster_target_weight(actor, target)
		## Blend the tactical weight with a flat 1.0 (pure random) by
		## how smart this creature is — low smart_factor keeps the
		## pick close to the old uniform-random behaviour.
		weights.append(lerpf(1.0, w, smart_factor))

	var chosen := _weighted_random_pick(living_allies, weights)
	monster_focus_target[actor] = chosen
	return chosen

## Raw tactical "how attractive is this target" weight, shared by
## _choose_monster_target's own weighted pick (blended with a flat 1.0
## by smart_factor there) and _monster_should_pursue_new_target below
## (used unblended, since that's a deliberate "is it worth abandoning
## someone already in my face" judgement, not a raw pick). Extracted
## out of _choose_monster_target's own inline loop — no behaviour
## change there.
func _monster_target_weight(actor: Character, target: Character) -> float:
	var w := 1.0
	var wounds_frac: float = float(target.wounds_current) / float(maxi(target.wounds_max, 1))
	w *= 1.0 + (1.0 - wounds_frac) * 2.0   ## up to 3x on a target near death, no bonus at full Wounds
	var toughness := target.get_characteristic_bonus("toughness") + target.get_armour_points("Body")
	w *= 1.0 + maxf(0.0, 6.0 - float(toughness)) * 0.12   ## softer targets are more attractive
	if not encounter.is_currently_engaged(target):
		w *= 1.3   ## not yet Engaged reads as an unguarded backline target
	## Per the follow-up request ("let creatures consider cover when
	## moving and fighting" — "tho animals should have little
	## understand[ing] of cover"): a ranged attacker discounts a target
	## it can't get a clean shot at, EXCEPT a True Animal or Bestial
	## creature — same "no capacity for rational thought" gate
	## _do_monster_turn's own is_animal already uses for Batter/Trick/
	## Assess — which has no real notion of cover at all and just shoots
	## at whoever it's already inclined to. Cover only ever applies
	## against a Ranged attack in the first place (per the earlier
	## request), so this only kicks in when `actor` itself is armed to
	## shoot, never for a melee attacker sizing up who to charge.
	var actor_weapon: WeaponDefinition = weapons.get(actor)
	var actor_is_animal: bool = _is_animal_monster(actor) or actor.has_creature_trait("Bestial")
	if not actor_is_animal and actor_weapon != null and actor_weapon.is_ranged and battle_grid != null and battle_positions.has(actor) and battle_positions.has(target):
		var cover_info: Dictionary = battle_grid.get_ranged_cover(battle_positions[actor], battle_positions[target])
		if cover_info["blocked"]:
			w *= 0.05   ## no real shot from here at all -- almost never worth "choosing" this target
		elif cover_info["penalty"] != 0:
			w *= 1.0 + float(cover_info["penalty"]) / 100.0   ## hard cover (-30) -> x0.7, light (-10) -> x0.9
	return w

## Per the request ("they should not consider [disengaging] unless they
## desperately want to change target for a good reason"): whether
## `actor` should actually go through with abandoning `engaged` (living
## allies already adjacent to it right now) to chase `preferred` (its
## locked target, currently NOT adjacent — see the one call site in
## _monster_attack). A mindless/animal creature never reasons this
## out — it just keeps fighting whatever's already in its face. A
## tactical creature only breaks away when the new target is
## substantially more attractive than the best target it would be
## walking away from (near death, much softer, or an unguarded
## backline target) — not merely a marginal preference — and the bar
## rises further the less sharp the creature is, via smart_factor.
func _monster_should_pursue_new_target(actor: Character, preferred: Character, engaged: Array) -> bool:
	var smart_factor: float = _monster_smart_factor(actor)
	if smart_factor <= 0.0 or engaged.is_empty():
		return true
	var preferred_weight: float = _monster_target_weight(actor, preferred)
	var best_engaged_weight: float = 0.0
	for e in engaged:
		best_engaged_weight = maxf(best_engaged_weight, _monster_target_weight(actor, e))
	var required_ratio: float = 1.5 + (1.0 - smart_factor) * 1.5   ## 1.5x (sharpest) up to 3x (dullest)
	return preferred_weight > best_engaged_weight * required_ratio

## Picks one entry from `items` with probability proportional to its
## same-index `weights` value. Falls back to a uniform pick if every
## weight is non-positive (only possible from a degenerate weight
## upstream — every weight above is always >= 0).
func _weighted_random_pick(items: Array[Character], weights: Array[float]) -> Character:
	var total := 0.0
	for w in weights:
		total += maxf(w, 0.0)
	if total <= 0.0:
		return items[randi() % items.size()]
	var roll := randf() * total
	var cumulative := 0.0
	for i in range(items.size()):
		cumulative += maxf(weights[i], 0.0)
		if roll <= cumulative:
			return items[i]
	return items[items.size() - 1]

func _monster_attack(actor: Character, effort_bonus: int = 0, weapon_override: WeaponDefinition = null, is_charge: bool = false) -> void:
	var monster_weapon: WeaponDefinition = weapon_override if weapon_override != null else _weapon_for(actor)
	## Charging (Up in Arms p.136): +10 to the attack roll, not +1
	## Advantage — Charging always means a Melee attack (never ranged),
	## so this only ever matters on the melee path below.
	var charge_bonus := 10 if is_charge else 0
	var living_allies := encounter.get_living("ally")
	var attack_target: Character = _choose_monster_target(actor, living_allies) if not living_allies.is_empty() else player

	## Per the request ("enemy should suffer the same penalty from
	## disengaging as player... should not consider doing it unless
	## they desperately want to change target for a good reason"):
	## before actually walking away from anyone already engaging this
	## monster in melee to go chase attack_target, weigh whether it's
	## genuinely worth it (_monster_should_pursue_new_target) — most of
	## the time it isn't, and the monster simply keeps fighting whoever
	## is already in its face rather than wandering off toward a
	## target it isn't even adjacent to yet. Only relevant when a move
	## away is actually about to happen — an attack_target the monster
	## is already adjacent to needs no repositioning, so there's
	## nothing to reconsider. engaged_before_move stays populated only
	## when the monster does go through with abandoning them, so the
	## free-attack check below the move knows who to punish it for
	## leaving.
	var engaged_before_move: Array = []
	if not monster_weapon.is_ranged and battle_grid != null and BattleGrid.footprint_distance(battle_positions.get(actor, Vector2i.ZERO), actor.get_footprint_size(), battle_positions.get(attack_target, Vector2i.ZERO), attack_target.get_footprint_size()) > 1:
		engaged_before_move = _monster_engaged_allies(actor)
		if not engaged_before_move.is_empty() and not _monster_should_pursue_new_target(actor, attack_target, engaged_before_move):
			## Not a good enough reason — stick with whoever's already
			## engaging it (the most tactically attractive of them, by
			## the same weighting used everywhere else) instead of
			## walking away.
			var redirect: Character = engaged_before_move[0]
			var best_weight := -1.0
			for e in engaged_before_move:
				var w := _monster_target_weight(actor, e)
				if w > best_weight:
					best_weight = w
					redirect = e
			attack_target = redirect
			monster_focus_target[actor] = redirect
			engaged_before_move = []   ## staying put — nothing to punish leaving

	## Per the request: the battle-map's yellow focus ring moves onto
	## whoever this monster just committed to attacking, immediately —
	## same "move it right now, don't wait for the next full render"
	## convention grid_view.set_selected_target() already gives the
	## player's own target clicks. See enemy_attack_focus_target's own
	## comment for how this stays out of the player's own selected_target.
	enemy_attack_focus_target = attack_target
	grid_view.set_selected_target(attack_target)

	## Phase 1b: a melee monster not yet adjacent to its target closes
	## the distance first (up to its own Movement) before attacking —
	## this is the single shared funnel every monster melee attack goes
	## through, so injecting it here covers Opening Exchange/Charge/
	## Batter-Trick-fallback/Additional Action/Tongue Attack follow-up
	## alike without touching _do_monster_turn's own branching.
	if not monster_weapon.is_ranged and battle_grid != null and BattleGrid.footprint_distance(battle_positions.get(actor, Vector2i.ZERO), actor.get_footprint_size(), battle_positions.get(attack_target, Vector2i.ZERO), attack_target.get_footprint_size()) > 1:
		_monster_move_toward(actor, attack_target)
		await _apply_fear_approach_checks(actor)
		## Per the request: show the monster actually closing the
		## distance on the battle map BEFORE the attack/defense sequence
		## plays out, rather than the position silently updating behind
		## the scenes and only becoming visible once the attack result
		## itself renders. _render_status() pushes the moved token to
		## BattleGridView right away; the brief pause afterward (same
		## 0.6s "thinking beat" convention _do_monster_turn already uses
		## elsewhere) gives the player a moment to actually see it move
		## before the attack/defense prompt takes over the screen.
		_render_status()
		await get_tree().create_timer(0.6).timeout

		## Per the request ("enemy should suffer the same penalty from
		## disengaging as player"): any ally captured in
		## engaged_before_move above who is no longer adjacent now that
		## the monster has actually moved gets a free, undefended
		## attack against it — exactly mirroring _try_commit_move's own
		## engaged_before handling for the player's side of this rule.
		## Monsters have no Disengage Action of their own to spend to
		## avoid this, which is precisely why the reconsideration above
		## makes them so reluctant to trigger it in the first place.
		for a in engaged_before_move:
			if encounter.is_defeated(a) or BattleGrid.footprint_distance(battle_positions.get(actor, Vector2i.ZERO), actor.get_footprint_size(), battle_positions.get(a, Vector2i.ZERO), a.get_footprint_size()) <= 1:
				continue
			await _resolve_monster_free_attack(a, actor)
			if battle_over or encounter.is_defeated(actor):
				_render_status()
				return

		if BattleGrid.footprint_distance(battle_positions.get(actor, Vector2i.ZERO), actor.get_footprint_size(), battle_positions.get(attack_target, Vector2i.ZERO), attack_target.get_footprint_size()) > 1:
			_add_notice("%s closes in but isn't close enough to strike." % actor.character_name)
			_render_status()
			return

	## Per the follow-up request ("let creatures consider cover when
	## moving and fighting"): a ranged-armed monster gets a chance to
	## duck into cover from any of the party's own ranged threats before
	## it actually shoots — see _monster_seek_cover's own comment. A
	## no-op (moves nowhere) whenever there's nothing to gain, so this
	## costs nothing on a battlefield with no cover or no ranged allies.
	if monster_weapon.is_ranged and battle_grid != null:
		_monster_seek_cover(actor, attack_target, monster_weapon)

	if monster_weapon.is_ranged:
		## Phase 1b: monsters respect ranged range bands too — a bonus/
		## penalty at Point Blank/Short/Long/Extreme, same as the
		## player, and simply no attack at all beyond Extreme range
		## (monsters don't reposition for a ranged shot in this phased
		## skeleton — only melee monsters close distance, above).
		var range_modifier := 0
		## Per the follow-up request: cover is symmetric on this grid —
		## a monster's ranged shot goes through the same real line-of-
		## sight scan (BattleGrid.get_ranged_cover) the player's own
		## ranged attacks now use, including refusing the shot outright
		## if a Huge Boulder/Structure sits in the way.
		var cover_modifier := 0
		if battle_grid != null and battle_positions.has(actor) and battle_positions.has(attack_target):
			var dist_yd := BattleGrid.distance_yards(battle_positions[actor], battle_positions[attack_target])
			var band := BattleGrid.get_range_band(dist_yd, actor.get_effective_weapon_range(monster_weapon))
			## Flight (p.343) — see _on_player_attack's own comment for
			## the exact rule text; same explicit-match bump, symmetric
			## for a monster shooting at a flying ally.
			if currently_flying.get(attack_target, false):
				match band:
					BattleGrid.RangeBand.POINT_BLANK:
						band = BattleGrid.RangeBand.SHORT
					BattleGrid.RangeBand.SHORT:
						band = BattleGrid.RangeBand.LONG
					BattleGrid.RangeBand.LONG:
						band = BattleGrid.RangeBand.EXTREME
					_:
						band = BattleGrid.RangeBand.OUT_OF_RANGE
			if band == BattleGrid.RangeBand.OUT_OF_RANGE:
				_add_notice("%s is out of range of %s and holds its shot." % [attack_target.character_name, actor.character_name])
				_render_status()
				return
			range_modifier = BattleGrid.get_range_band_modifier(band)
			var cover_info: Dictionary = battle_grid.get_ranged_cover(battle_positions[actor], battle_positions[attack_target])
			if cover_info["blocked"]:
				_add_notice("%s has no line of sight to %s and holds its shot." % [actor.character_name, attack_target.character_name])
				_render_status()
				return
			cover_modifier = cover_info["penalty"]
		var darkness_mod := _darkness_penalty(actor, attack_target, true)
		## Fear (p.190): "-1 SL on all Tests to affect the source of your
		## fear" — same -10 roll-target translation _on_player_attack's own
		## fear_penalty already uses for the ally-vs-monster direction (see
		## its comment), applied here for a monster afraid of a Frightening
		## ally instead.
		var fear_penalty := -10 if _monster_fear_sources.get(actor, {}).has(attack_target) else 0
		## Flight (p.343): "-20 to all ranged combat attempts" while the
		## ATTACKING monster itself is currently airborne — see
		## _on_player_attack's own flying_attack_penalty for the mirror.
		var flying_attack_penalty := -20 if currently_flying.get(actor, false) else 0
		var result := CombatResolver.resolve_ranged_attack(actor, attack_target, monster_weapon, encounter.advantage_pool, effort_bonus + range_modifier + cover_modifier + darkness_mod + fear_penalty + flying_attack_penalty, -1, encounter.get_living(attack_target.allegiance), "", [], encounter.round_number)
		_show_attack_cards(actor, attack_target, monster_weapon.weapon_name, result)
		_render_status()
		await _wait_for_continue()
	else:
		## Per the request: every present party member gets the real,
		## full defense prompt (Parry/Dodge choice, Fortune spends) —
		## reassigning `player` to whoever was actually targeted, the
		## same mechanism the turn dispatch above uses, so the
		## existing defense UI operates on the correct character
		## without needing its own separate code path per ally.
		player = attack_target
		_refresh_player_display()
		await _prompt_player_defense(actor, monster_weapon, effort_bonus, charge_bonus)

## Phase 1b: relocates `actor` up to its own get_movement() squares along
## a path toward the nearest open square adjacent to `target` — a melee
## monster closing the distance before it can attack. Thin wrapper
## around the shared _advance_toward helper (also used by the player's
## own Charge) with the monster's Movement as the cap.
## Per the request ("follow it if its a Enemy and its moving, slow down
## the visible moving a bit"): eases the battle-map camera toward wherever
## an enemy's own movement just left it, via BattleGridView.center_on_
## animated (a genuine tween on pan_offset, not an instant snap the way
## the fresh-Turn focus in _next_turn() is) — the deliberately unhurried
## pace is the "slow down" itself, since there's no separate token-glide
## animation in this project for the camera to merely keep pace with (a
## monster's own move just relocates its battle_positions entry outright;
## see _advance_toward's own comment). Never called for an ally's own
## movement — the player already fully controls the camera there via
## mouse-drag pan, and the request is specifically about following the
## enemy. A no-op if there's no grid view or `actor` isn't on the map
## (e.g. it just fled off the edge).
func _follow_camera_on_enemy_move(actor: Character) -> void:
	if grid_view == null or actor.allegiance == "ally" or not battle_positions.has(actor):
		return
	grid_view.center_on_animated(battle_positions[actor])

func _monster_move_toward(actor: Character, target: Character) -> void:
	## Flight (p.343): a Flight-capable creature always prefers to fly
	## when closing distance — it's strictly better positioning (bypasses
	## terrain/obstacles/other combatants entirely) with no downside for
	## a melee-focused flyer (the -20 ranged-attack/defender-range-band
	## effects only matter for ranged combat, and every current Flight
	## monster in this project's roster fights in melee). Once airborne
	## it simply stays flying for the rest of the battle in this
	## simplified model — see currently_flying's own comment.
	var flight_budget := _flight_budget_squares(actor)
	if flight_budget > 0:
		currently_flying[actor] = true
		_advance_toward_flying(actor, target, flight_budget)
		_follow_camera_on_enemy_move(actor)
		return
	## Stride (p.343): this flat per-turn cap is the closest equivalent
	## monster AI has to "Run Movement" in this simplified system (no
	## separate Walk-then-Run choice) — see Character.get_stride_
	## multiplier()'s own comment.
	_advance_toward(actor, target, int(round(actor.get_movement() * actor.get_stride_multiplier())))
	_follow_camera_on_enemy_move(actor)

## Per the follow-up request ("let creatures consider cover when moving
## and fighting"): before a ranged-armed monster takes its shot, it
## looks for a reachable square (within its own Movement) that gives IT
## real cover from whichever living ally carries a ranged weapon of
## their own — the same threat its own target selection already
## discounts a well-covered target for (see _monster_target_weight).
## Never strays anywhere that would put its own already-chosen `target`
## out of THIS weapon's range — a shot not worth taking isn't worth
## ducking behind cover to set up either — and never moves at all once
## it's already about as covered as it can get (hard cover or fully
## hidden). A no-op if there's no battle grid, no ranged ally to worry
## about, or nowhere better to stand.
func _monster_seek_cover(actor: Character, target: Character, weapon: WeaponDefinition) -> void:
	## Per the follow-up request ("tho animals should have little
	## understand[ing] of cover"): a True Animal or Bestial creature
	## never deliberately repositions for cover — same gate as the
	## target-weight discount in _monster_target_weight above.
	if _is_animal_monster(actor) or actor.has_creature_trait("Bestial"):
		return
	if not battle_positions.has(actor) or not battle_positions.has(target):
		return
	var ranged_threats: Array = []
	for a in encounter.get_living("ally"):
		var w: WeaponDefinition = weapons.get(a)
		if w != null and w.is_ranged and battle_positions.has(a):
			ranged_threats.append(a)
	if ranged_threats.is_empty():
		return
	var current_sq: Vector2i = battle_positions[actor]
	var current_penalty := _worst_cover_penalty(current_sq, ranged_threats)
	if current_penalty <= -30:
		return   ## already at best (hard cover, or fully hidden) -- nothing to gain
	var actor_size: int = actor.get_footprint_size()
	var blocked := _occupied_squares_excluding(actor)
	var flight_budget := _flight_budget_squares(actor)
	var reachable: Array = []
	if flight_budget > 0:
		## Flight (p.343): repositioning for cover while airborne still
		## ignores terrain/obstacles/characters along the way — only the
		## final square it settles into needs to be a real, legal,
		## unoccupied one, same distinction _advance_toward_flying draws.
		currently_flying[actor] = true
		for sq in battle_grid.squares_within_radius(current_sq, flight_budget):
			if _footprint_landable(sq, actor_size, blocked):
				reachable.append(sq)
	else:
		## Stride (p.343) — see _monster_move_toward's own comment.
		var move_cap: int = int(round(actor.get_movement() * actor.get_stride_multiplier()))
		if move_cap <= 0:
			return
		reachable = battle_grid.reachable_squares(current_sq, move_cap, blocked, actor_size)
	var best_sq := current_sq
	var best_penalty := current_penalty
	for sq in reachable:
		var dist_yd := BattleGrid.distance_yards(sq, battle_positions[target])
		if BattleGrid.get_range_band(dist_yd, actor.get_effective_weapon_range(weapon)) == BattleGrid.RangeBand.OUT_OF_RANGE:
			continue   ## would lose its own shot on the target it already picked -- not worth it
		var pen := _worst_cover_penalty(sq, ranged_threats)
		if pen < best_penalty:
			best_penalty = pen
			best_sq = sq
	if best_sq == current_sq:
		return
	var path: Array = battle_grid.find_path(current_sq, best_sq, blocked, actor_size)
	if path.is_empty():
		return
	battle_positions[actor] = best_sq
	_refresh_enemy_display()
	_follow_camera_on_enemy_move(actor)

## Worst (most negative) ranged-cover penalty `square` would get from
## any of `threats`, per BattleGrid.get_ranged_cover() — -999 (treated
## as "as good as it gets") if any of them would have their shot fully
## blocked from there.
func _worst_cover_penalty(square: Vector2i, threats: Array) -> int:
	var worst := 0
	for t in threats:
		if not battle_positions.has(t):
			continue
		var info: Dictionary = battle_grid.get_ranged_cover(battle_positions[t], square)
		if info["blocked"]:
			return -999
		worst = mini(worst, int(info["penalty"]))
	return worst

## Fear (Rating), p.190-191: "if the source of your Fear approaches you,
## you must pass a Challenging (+0) Cool Test or gain the Broken
## Condition." Per the request ("let implement ... Fear ... fully"):
## checked here, right after the single shared funnel every monster
## melee-closing move already goes through (see the comment on that
## call site) — against every living ally who currently fears `actor`
## specifically (per-character, see _fear_sources) and who `actor` just
## closed all the way to melee range against. Simplified to "ended up
## adjacent" rather than tracking a strict per-square distance delta —
## this call site only ever fires for a monster actually closing in to
## attack, so proximity after the move is exactly the case the book
## means by "approaches."
func _apply_fear_approach_checks(actor: Character) -> void:
	if not battle_positions.has(actor):
		return
	for ally in encounter.get_living("ally"):
		if not _fear_sources.get(ally, {}).has(actor) or not battle_positions.has(ally):
			continue
		if BattleGrid.footprint_distance(battle_positions[actor], actor.get_footprint_size(), battle_positions[ally], ally.get_footprint_size()) > 1:
			continue
		var test := TestResolver.resolve_skill_test(ally, GameData.skill_db.find_by_name("Cool"), "")
		var extra: Array[String] = []
		if test.success:
			extra.append("%s stands their ground against %s." % [ally.character_name, actor.character_name])
		else:
			ally.add_condition("Broken", 1)
			extra.append("%s's fear overwhelms them as %s closes in — Broken!" % [ally.character_name, actor.character_name])
		_show_single_card(ally, "Fear: Cool Test", "Challenging (+0)", "ally", test, extra)
		_render_status()
		await _wait_for_continue()

## Frightening's own mirror of _apply_fear_approach_checks above (Fear,
## p.190-191: "if the source of your Fear approaches you, you must pass
## a Challenging (+0) Cool Test or gain the Broken Condition"). That
## function handles a MONSTER approaching an ally who fears it; this is
## the other direction, triggered from the player's own Move
## (_try_commit_move) since the player is always the one actually
## choosing to approach in this direction — a present ally with their
## own Frightening has no move of their own that could trigger this
## (monsters don't get scared of allies they're not currently fighting
## toward). Checked against every living monster that fears the player
## specifically (_monster_fear_sources), for whom this Move just closed
## the distance to melee range. Unlike the player's own gate above, this
## does NOT cancel or block the Move — it's the MONSTER's psychology
## reacting here, not the mover's own, so there's nothing about the
## player's Move to stop.
func _apply_reverse_fear_approach_checks(old_pos: Vector2i, new_pos: Vector2i) -> void:
	for m in encounter.get_living("adversary"):
		if not _monster_fear_sources.get(m, {}).has(player) or not battle_positions.has(m):
			continue
		var before_dist := battle_grid.distance_squares(old_pos, battle_positions[m])
		var after_dist := battle_grid.distance_squares(new_pos, battle_positions[m])
		## Simplified to "ended up adjacent" rather than tracking a strict
		## per-square distance delta, same as _apply_fear_approach_checks'
		## own comment — this only ever fires for a Move that actually
		## closed the distance, so proximity after the move is exactly
		## what "approaches" means here.
		if after_dist >= before_dist or after_dist > 1:
			continue
		var test := TestResolver.resolve_skill_test(m, GameData.skill_db.find_by_name("Cool"), "")
		var extra: Array[String] = []
		if test.success:
			extra.append("%s stands its ground against %s." % [m.character_name, player.character_name])
		else:
			m.add_condition("Broken", 1)
			extra.append("%s's fear overwhelms it as %s closes in — Broken!" % [m.character_name, player.character_name])
		_show_single_card(m, "Fear: Cool Test", "Challenging (+0)", "adversary", test, extra)
		_render_status()
		await _wait_for_continue()

## Per the request ("if they reach the edge of the battle map remove
## them from the battle (they will count as defeated but NOT drop any
## loot)"): reuses the exact same kill-resolution path a real death goes
## through — XP, quest progress, Victory Advantage for an Important/
## Nemesis — by forcing wounds_current to 0 first (satisfies
## CombatEncounter.is_defeated() with no changes needed there, so
## get_living("adversary")/get_living("ally") and every existing
## win-condition check downstream of them pick this up automatically),
## but calls _check_for_kill_xp with drop_loot=false — a monster that
## legged it off the map didn't leave its gear where anyone could reach
## it. Removed from battle_positions (not `monsters`, which several
## other lookups — monster_defs, weapons — still key off of) so its
## token actually vanishes from the battle map rather than lying there
## looking like a corpse it isn't.
func _monster_flees_off_map(actor: Character) -> void:
	_add_notice("[b]%s[/b] reaches the edge of the battlefield and disappears from view!" % actor.character_name)
	actor.wounds_current = 0
	_check_for_kill_xp(actor, false)
	## Per the follow-up request (Battle Report popup listing "combatants
	## defeated or escaped" separately): satisfying is_defeated() alone
	## can't tell a real kill apart from this — recorded here, the one
	## place that actually knows the difference.
	if not _fled_monsters.has(actor):
		_fled_monsters.append(actor)
	battle_positions.erase(actor)
	_refresh_enemy_display()
	_render_status()

## Shared forced-flee movement for Bestial's own "attempt to Flee" (p.338)
## and Broken's "flee from combat" (p.168) — moves `actor` as far away
## from every living enemy as its own Movement allows (_advance_away_from),
## pays the same Flee free attack (Up in Arms p.140) any ally it was
## already engaging gets to throw, per the request ("enemy should suffer
## the same penalty from disengaging as player" — this project doesn't
## special-case a FORCED flee as somehow exempt from that same penalty),
## and finally despawns it (_monster_flees_off_map) if that flight
## genuinely carried it onto the grid's own edge. A monster that flees
## without reaching the edge just ends its turn there, still in the
## fight. `cower_reason`/`flee_reason` let Bestial and Broken each supply
## their own flavour text for the same underlying mechanic.
func _flee_and_maybe_escape(actor: Character, cower_reason: String, flee_reason: String) -> void:
	var engaged_before: Array = _monster_engaged_allies(actor)
	var threats: Array[Character] = encounter.get_living("ally" if actor.allegiance == "adversary" else "adversary")
	var flight_budget := _flight_budget_squares(actor)
	var moved: int
	if flight_budget > 0:
		## Flight (p.343) — see _monster_move_toward's own comment.
		currently_flying[actor] = true
		moved = _advance_away_from_flying(actor, threats, flight_budget)
	else:
		## Stride (p.343) — see _monster_move_toward's own comment.
		moved = _advance_away_from(actor, threats, int(round(actor.get_movement() * actor.get_stride_multiplier())))
	if moved <= 0:
		_add_notice("[b]%s[/b] %s" % [actor.character_name, cower_reason])
		_next_turn()
		return
	_add_notice("[b]%s[/b] %s" % [actor.character_name, flee_reason])
	_render_status()
	_follow_camera_on_enemy_move(actor)
	for a in engaged_before:
		if encounter.is_defeated(a) or battle_over:
			continue
		if not battle_positions.has(actor) or BattleGrid.footprint_distance(battle_positions[actor], actor.get_footprint_size(), battle_positions[a], a.get_footprint_size()) <= 1:
			continue
		await _resolve_monster_free_attack(a, actor)
		if battle_over or encounter.is_defeated(actor):
			break   ## the fleeing creature died (or the battle ended) paying for its own free-attack-punished escape -- nothing left to check below
	## Unlike _monster_attack's own early-return for this same case, this
	## function always falls through to a single _next_turn() call below
	## (idempotent — _next_turn() itself no-ops once battle_over is set)
	## rather than relying on its own caller to fall through to one, so
	## the despawn check here is explicitly skipped once the fleeing
	## creature is already dead — awarding its kill XP a second time
	## through the "fled" path, or narrating an escape that didn't
	## actually happen, would both be wrong.
	if not battle_over and not encounter.is_defeated(actor) and battle_positions.has(actor) and _is_at_battle_edge(battle_positions[actor]):
		_monster_flees_off_map(actor)
	_next_turn()

## The player is shown WHAT is attacking them (weapon, Qualities) and
## asked HOW to defend — Parry with their own weapon, or Dodge — before
## any dice are rolled. They can still spend their own Additional Effort
## on their defensive roll while deciding. Nothing about the outcome is
## revealed until after the choice is locked in.
## Stale-comment fix: this used to describe an older behaviour where a
## non-actively-controlled party member's defense resolved
## automatically (always Dodge). That was superseded — see
## _monster_attack's own comment just above its `player = attack_target`
## line — every present party member now gets this same real,
## interactive prompt on their own defense, not just whoever the
## player is actively controlling.
func _prompt_player_defense(actor: Character, weapon: WeaponDefinition, attacker_effort: int, charge_bonus: int = 0) -> void:
	pending_defense = {"attacker": actor, "weapon": weapon, "attacker_effort": attacker_effort, "charge_bonus": charge_bonus}
	awaiting_player_target = true
	## Per the follow-up request ("lets keep the parry options within
	## the Attack / Defence segment of the action window, rather then
	## taking up the entire window"): confined to the Attack/Defence
	## column instead of blanking the whole action-menu area — same
	## treatment _offer_overcasting()/_prompt_bonus_action_choice() already
	## give their own choice prompts (see _build_scoped_column).
	var col := _build_scoped_column("Attack / Defence")
	var section := col.get_parent()

	section.add_child(_section_label("%s attacks with a %s!" % [actor.character_name, weapon.weapon_name]))
	if not weapon.qualities.is_empty() or not weapon.item_qualities.is_empty() or not weapon.item_flaws.is_empty():
		var qual_label := Label.new()
		qual_label.text = "Qualities: " + ItemQualityRules.combined_display(weapon.qualities, weapon.item_qualities, weapon.item_flaws)
		qual_label.add_theme_font_size_override("font_size", 7)
		qual_label.add_theme_color_override("font_color", Color(0.65, 0.6, 0.5))
		section.add_child(qual_label)

	if pending_effort_bonus > 0:
		var note := Label.new()
		note.text = "Additional Effort ready: +%d%% to your defensive Test." % pending_effort_bonus
		note.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
		section.add_child(note)
	if defensive_stance_active:
		var stance_note := Label.new()
		stance_note.text = "Defensive Stance active: +20 to this defence."
		stance_note.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
		section.add_child(stance_note)

	section.add_child(_section_label("How do you defend?"))

	var melee_skill: SkillDefinition = GameData.skill_db.find_by_name("Melee")
	var dodge_skill: SkillDefinition = GameData.skill_db.find_by_name("Dodge")
	var player_weapon: WeaponDefinition = _weapon_for(player)
	var offhand: WeaponDefinition = player.get_offhand_weapon()

	## Defensive Quality (p.298): grants its +1 SL whenever it's being
	## wielded, regardless of which hand actually makes the Parry
	## roll — so both buttons below need to reflect a Defensive item in
	## *either* hand, not just the one each button parries with. A
	## Quality, so lost entirely if the player has no Advances in that
	## weapon's own Group (p.296) — see get_effective_weapon_qualities().
	var main_has_defensive := player.get_effective_weapon_qualities(player_weapon).has("Defensive")
	var offhand_has_defensive := offhand != null and player.get_effective_weapon_qualities(offhand).has("Defensive")
	var any_defensive := main_has_defensive or offhand_has_defensive

	## Parry (p.296): "Any one-handed weapon with the Defensive Quality
	## can be used with Melee (Parry)" — whether to actually test THAT
	## specialisation instead of the weapon's own Group is the player's
	## own standing choice (see Character.wants_parry_skill(), set from
	## the Character Menu's Weapons sub-tab), not automatic. Eligibility
	## itself checks the weapon's raw Quality (not the training-filtered
	## effective list) — the choice of which specialisation to test is a
	## separate question from whether that Quality's own bonus ends up
	## active once training is factored in.
	var main_parry_eligible := not player_weapon.is_two_handed and player_weapon.qualities.has("Defensive")
	var main_uses_parry_skill := main_parry_eligible and player.wants_parry_skill(player_weapon)
	var main_defense_spec := "Parry" if main_uses_parry_skill else player_weapon.skill_group

	## Per the follow-up request ("give these buttons the same format
	## the Attack buttons have, ie Weapon/Skill Name - [Target Number],
	## and default the Enter hotkey and WASD focus the one with the
	## highest target number available to Defend with"): each option's
	## real preview target number (see _preview_defense_target_number,
	## which mirrors exactly what _resolve_player_defense() ->
	## CombatResolver.resolve_melee_attack() will actually roll against)
	## both drives its own "Name - NN" label — the same convention the
	## Attack button already established, with everything else (Defensive
	## bonus, off-hand penalty, Melee (Parry) choice) moved to the
	## tooltip, matching how the Attack button keeps its own extra detail
	## out of the visible label too — and decides which button gets the
	## "[Enter]"/default-focus treatment. Collected as candidates first,
	## rather than always defaulting to the main-hand Parry regardless of
	## the real numbers.
	var candidates: Array = []   ## [{button: Button, target: int}]

	var main_target := _preview_defense_target_number(melee_skill, main_defense_spec, player_weapon, false, actor, weapon)
	var parry_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	var main_note := "Defensive: +1 SL" if any_defensive else ""
	if main_uses_parry_skill:
		main_note += (", " if main_note != "" else "") + "using Melee (Parry)"
	parry_btn.text = "%s - %d" % [player_weapon.weapon_name, main_target]
	if main_note != "":
		parry_btn.tooltip_text = main_note
	parry_btn.pressed.connect(func(): _resolve_player_defense(melee_skill, main_defense_spec, player_weapon, false))
	section.add_child(parry_btn)
	candidates.append({"button": parry_btn, "target": main_target})

	## Off-hand Parry — a genuinely separate weapon/shield, not just the
	## same main-hand weapon again. Only offered for a one-handed off-hand
	## item, since a two-handed weapon can never be paired with one.
	if offhand != null:
		## Same standing player choice as the main hand above — an
		## off-hand item is always one-handed already (a two-handed
		## weapon leaves no off-hand free at all), so eligibility only
		## needs the raw Defensive Quality check.
		var offhand_parry_eligible := not offhand.is_two_handed and offhand.qualities.has("Defensive")
		var offhand_uses_parry_skill := offhand_parry_eligible and player.wants_parry_skill(offhand)
		var offhand_defense_spec := "Parry" if offhand_uses_parry_skill else offhand.skill_group
		var offhand_target := _preview_defense_target_number(melee_skill, offhand_defense_spec, offhand, true, actor, weapon)
		var offhand_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		## Rank-scaled per Ambidextrous (see Character.get_offhand_penalty()):
		## 0/-10/-20 depending on rank, so this note text always matches
		## the penalty _resolve_player_defense() -> get_defense_modifiers()
		## will actually apply — same detail as before, just moved to the
		## tooltip now (see the main-hand comment above for why).
		var offhand_note := ""
		if offhand_has_defensive:
			offhand_note = "Defensive: +1 SL, no off-hand penalty"
		else:
			var offhand_parry_penalty := player.get_offhand_penalty()
			if offhand_parry_penalty < 0:
				offhand_note = "%d off-hand penalty" % offhand_parry_penalty
		if main_has_defensive and not offhand_has_defensive:
			offhand_note += (", " if offhand_note != "" else "") + "+1 SL from main-hand Defensive"
		if offhand_uses_parry_skill:
			offhand_note += (", " if offhand_note != "" else "") + "using Melee (Parry)"
		offhand_btn.text = "Off-hand: %s - %d" % [offhand.weapon_name, offhand_target]
		if offhand_note != "":
			offhand_btn.tooltip_text = offhand_note
		offhand_btn.pressed.connect(func(): _resolve_player_defense(melee_skill, offhand_defense_spec, offhand, true))
		section.add_child(offhand_btn)
		candidates.append({"button": offhand_btn, "target": offhand_target})

	var dodge_target := _preview_defense_target_number(dodge_skill, "", null, false, actor, weapon)
	var dodge_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	dodge_btn.text = "Dodge - %d" % dodge_target
	dodge_btn.pressed.connect(func(): _resolve_player_defense(dodge_skill, ""))
	section.add_child(dodge_btn)
	candidates.append({"button": dodge_btn, "target": dodge_target})

	## Whichever option gives the best real odds becomes the default —
	## ties keep whatever was found first (main-hand Parry), matching
	## the old unconditional default when everything's otherwise equal.
	var best: Dictionary = candidates[0]
	for c in candidates:
		if int(c["target"]) > int(best["target"]):
			best = c
	var best_btn: Button = best["button"]
	best_btn.text += "  [Enter]"
	_active_primary_hotkey_button = best_btn

	var effort_row := HFlowContainer.new()
	effort_row.add_theme_constant_override("separation", 8)
	effort_row.add_child(_section_label("Effort [Shift]:"))
	var pool := encounter.advantage_pool
	for spend in [2, 3, 4]:
		var eff_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		eff_btn.text = "%d Adv (+%d%%)" % [spend, (spend - 1) * 10]
		eff_btn.disabled = pool.get_pool("ally") < spend or pending_effort_bonus > 0
		if pending_effort_bonus > 0:
			eff_btn.tooltip_text = "Additional Effort is already queued for your next Test."
		elif pool.get_pool("ally") < spend:
			eff_btn.tooltip_text = "Not enough Advantage (%d available, need %d)." % [pool.get_pool("ally"), spend]
		eff_btn.pressed.connect(func(): _on_additional_effort(spend))
		effort_row.add_child(eff_btn)
	section.add_child(effort_row)

	## WASD navigation should never be able to land focus on a
	## greyed-out button — see _refresh_focus_for_disabled_buttons.
	_refresh_focus_for_disabled_buttons(self)
	_auto_focus_default_button()

## Preview of the real target number a given defend option would roll
## against, mirroring exactly what _resolve_player_defense() ->
## CombatResolver.resolve_melee_attack() computes for the defender's
## side of the Opposed Test (see get_defense_modifiers() and the
## defender_mod modifiers built directly inside resolve_melee_attack) —
## so the "Name - NN" label the player sees before committing matches
## the real roll, same convention _preview_attack_target_number()
## already establishes for the Attack button.
## `defense_weapon` null means Dodge (no weapon-based modifiers apply).
## Deliberately mirrors only the TARGET-number modifiers, not the
## SL-only ones resolve_melee_attack() also applies after the roll
## (Wrap, Slow, Size-vs-Parry) — those change success levels, not the
## displayed percentage, so they'd make this preview lie if included.
func _preview_defense_target_number(defense_skill: SkillDefinition, defense_spec: String, defense_weapon: WeaponDefinition, is_offhand: bool, attacker: Character, attacker_weapon: WeaponDefinition) -> int:
	var base_target := player.get_skill_value(defense_skill, defense_spec)
	var modifier := pending_effort_bonus
	if defensive_stance_active:
		modifier += 20
	if defense_weapon != null:
		var defense_mods := CombatResolver.get_defense_modifiers(player, defense_weapon, is_offhand)
		for entry in defense_mods["target_breakdown"]:
			modifier += int(entry["amount"])
	if attacker.has_creature_trait("Distracting") and not player.has_creature_trait("Distracting"):
		modifier -= 20
	var blinded_stacks: int = int(player.conditions.get("Blinded", 0))
	if blinded_stacks > 0:
		modifier -= 10 * blinded_stacks
	if player.conditions.has("Prone"):
		modifier -= 20
	if player.conditions.has("Surprised"):
		modifier -= 20
	## Fast (p.297): "all Melee Tests to defend against Fast weapons
	## suffer a penalty of -10 if your opponent is using a weapon
	## without the Fast Quality" — mirrors resolve_melee_attack()'s own
	## unconditional check (applied regardless of Parry vs Dodge, same
	## as the real roll does).
	if attacker_weapon != null and attacker.get_effective_weapon_qualities(attacker_weapon).has("Fast"):
		var defender_weapon_for_fast := player.get_equipped_weapon()
		if defender_weapon_for_fast == null or not player.get_effective_weapon_qualities(defender_weapon_for_fast).has("Fast"):
			modifier -= 10
	return base_target + modifier

func _resolve_player_defense(defense_skill: SkillDefinition, defense_spec: String, defense_weapon: WeaponDefinition = null, is_offhand: bool = false) -> void:
	if pending_defense.is_empty():
		return
	awaiting_player_target = false
	_clear(target_container)
	melee_has_begun = true
	var actor: Character = pending_defense["attacker"]
	var weapon: WeaponDefinition = pending_defense["weapon"]
	var attacker_effort: int = pending_defense["attacker_effort"]
	var charge_bonus: int = pending_defense.get("charge_bonus", 0)
	var stance_bonus := 20 if defensive_stance_active else 0
	var effort := _consume_effort_bonus()

	## Defensive Quality / Shield (Rating) / off-hand penalty (p.296/298)
	## — only relevant when actually Parrying with a weapon, not Dodging.
	var defense_mods := CombatResolver.get_defense_modifiers(player, defense_weapon, is_offhand) if defense_weapon != null else {"sl_breakdown": [], "target_breakdown": [], "shield_ap": 0}
	var offhand_penalty := 0
	for entry in defense_mods["target_breakdown"]:
		offhand_penalty += entry["amount"]

	var defender_bonus: int = stance_bonus + effort[0] + offhand_penalty
	pending_defense.clear()

	encounter.mark_melee_engaged(actor, player)
	var outnumbering := encounter.get_outnumbering_bonus(actor, _local_melee_cluster(actor))

	## Darkness (per the request): a monster's own Melee attack is
	## penalized by ITS OWN darkness/vision, exactly like the player's
	## melee attack above — see _darkness_penalty()'s own comment.
	var darkness_mod := _darkness_penalty(actor, player, false)
	## Fear (p.190): same -10 roll-target translation as the ranged
	## monster-attack path above (_monster_attack) and _on_player_attack's
	## own fear_penalty for the ally-vs-monster direction — `player` here
	## has already been reassigned to whichever ally `actor` is attacking
	## (see _monster_attack's own comment on that reassignment), so this
	## correctly reads as "is the monster afraid of the character it's
	## currently attacking."
	var fear_penalty := -10 if _monster_fear_sources.get(actor, {}).has(player) else 0
	var attacker_breakdown: Array = []
	if attacker_effort > 0:
		attacker_breakdown.append({"name": "Additional Effort", "amount": attacker_effort})
	if outnumbering > 0:
		attacker_breakdown.append({"name": "Outnumbering", "amount": outnumbering})
	if charge_bonus > 0:
		attacker_breakdown.append({"name": "Charging", "amount": charge_bonus})
	if darkness_mod != 0:
		attacker_breakdown.append({"name": "Darkness", "amount": darkness_mod})
	if fear_penalty != 0:
		attacker_breakdown.append({"name": "Fear", "amount": fear_penalty})
	var defender_breakdown: Array = []
	if stance_bonus > 0:
		defender_breakdown.append({"name": "Defensive Stance", "amount": stance_bonus})
	defender_breakdown.append_array(effort[1])
	defender_breakdown.append_array(defense_mods["target_breakdown"])

	## Bug fix ("Reroll only affect your own rolls, not the opposing
	## roll"): the attacker's (monster's) own roll used to be hardcoded
	## to -1 (i.e. "roll fresh") on EVERY call, including a Fortune-spend
	## redo of the PLAYER's own Defence roll — so rerolling your own
	## Dodge/Parry was silently also re-rolling the monster's attack.
	## `forced_attacker_roll` defaults to -1 for the very first,
	## genuinely fresh roll of this whole opposed test; the reroll loop
	## below now passes the monster's ALREADY-ROLLED number back in on
	## every redo, so only the player's own d100 changes.
	var do_defense := func(forced_defender_roll: int, forced_attacker_roll: int = -1) -> CombatResolver.AttackResult:
		var r := CombatResolver.resolve_melee_attack(actor, player, weapon, encounter.advantage_pool,
			defense_skill, defense_spec, false, attacker_effort + outnumbering + charge_bonus + darkness_mod + fear_penalty, defender_bonus,
			forced_attacker_roll, defense_mods["sl_breakdown"], defense_mods["shield_ap"], [], forced_defender_roll, charge_bonus > 0,
			[], encounter.get_living(player.allegiance))
		r.attacker_test.target_modifiers = attacker_breakdown
		r.defender_test.target_modifiers = defender_breakdown
		return r

	var wounds_before_defense := player.wounds_current
	## Ally corpses are deliberately never culled from battle_positions
	## (see _cull_dead_monsters_from_map()'s own comment — only an
	## adversary's own presence gets swept), so reading this square is
	## still safe at call time below; captured here anyway for the same
	## "snapshot before the hit resolves" shape every other Deathblow
	## call site now uses.
	var player_square_before_defense: Vector2i = battle_positions.get(player, Vector2i(-1, -1))
	var result: CombatResolver.AttackResult = do_defense.call(-1)
	## Captured once, right after this test's genuinely fresh first roll.
	var original_attacker_roll: int = result.attacker_test.roll
	_show_attack_cards(actor, player, weapon.weapon_name, result)
	_render_status()

	## Bug fix: this fires while defending against a MONSTER's attack —
	## not the player's own Turn — so Act Again (spending Advantage for
	## an extra Action this Turn) never belongs here. `suppress_act_again`
	## (4th param) is now true; every other _offer_fortune_spend call
	## site in this file is the player's own action and is unaffected.
	## Same reasoning for `own_turn` (6th param, now false): there's no
	## "rest of my own turn" to preview in the action-menu area while
	## defending against someone else's attack, so
	## _render_fortune_prompt_turn_preview() is skipped here — see
	## _offer_fortune_spend's own comment.
	var choice := await _offer_fortune_spend(result.defender_test, false, false, true, not result.hit, false)
	while choice == "reroll" or choice == "sl":
		var forced := -1 if choice == "reroll" else _roll_with_plus_one_sl(result.defender_test.roll)
		## Undo the previous attempt's Wounds to the player before
		## reapplying — same reasoning as the attack side: a redo
		## shouldn't stack damage from both attempts. Critical Wound
		## interaction (Accept/Deflect/Fate) is deliberately only ever
		## triggered once, after Fortune is fully resolved below — not
		## once per intermediate reroll, which would mean prompting the
		## player through the same interactive choice multiple times
		## for one single action.
		if result.hit:
			player.wounds_current = min(player.wounds_max, player.wounds_current + result.wounds_dealt + result.critical_wound_extra_wounds)
		result = do_defense.call(forced, original_attacker_roll)
		_show_attack_cards(actor, player, weapon.weapon_name, result, true)
		_render_status()
		choice = await _offer_fortune_spend(result.defender_test, false, false, true, not result.hit, false)

	if result.caused_critical_wound:
		await _handle_critical_wound_on_player(result)
		await _wait_for_continue()
	## Per the request: real fumble consequences here too — this was a
	## complete gap before (neither side's fumble had any effect in
	## this specific flow, monster attacking the player). The monster's
	## own attack fumble uses its own weapon; the player's own fumbled
	## Parry uses whichever weapon they actually defended with.
	_apply_fumble_effects(actor, weapon, result.fumble)
	if defense_weapon != null:
		_apply_fumble_effects(player, defense_weapon, result.defender_fumble)
	## Per the follow-up request: a critical Parry riposte here damages
	## the MONSTER (actor is the attacker in this flow) — checked via
	## the same generic kill-check every other monster death already
	## goes through, so XP/loot/Advantage all apply correctly.
	if result.critical_parry_counter_triggered or result.riposte_talent_triggered:
		_check_for_kill_xp(actor)
	## Deathblow (p.160/p.341 — see _offer_deathblow_chain): the monster
	## side of the same rule. Guarded on the monster still being alive —
	## a Critical Parry Riposte or Riposte Talent trigger just above can
	## kill `actor` in return, and a dead attacker obviously can't chain
	## into a follow-up strike of its own.
	if not encounter.is_defeated(actor):
		await _offer_deathblow_chain(actor, weapon, player, wounds_before_defense, result.hit, {"used": 0, "hit": [player]}, player_square_before_defense)
	_next_turn()

## Offers Critical Deflection (p.299) when a Critical Wound lands on the
## player: accept it as rolled (apply the table's Conditions, or die if
## the result was a Death entry), or deflect it — the blow's Wounds
## still land either way (that part was already applied by the
## resolver, unavoidably, before this is even shown), but the
## Condition/text effects are avoided at the cost of 1 AP from whatever
## armour was actually hit. Only offered at all if there's real AP
## there to spend — nothing to damage otherwise.
## No interactive Deflection choice for a monster target — "allow the
## player to choose" (per the request) is specifically a player-facing
## option; enemies just take the full rolled effect automatically.
## Shared by every place a Critical Wound gets shown on screen — the
## request specifically wanted the actual rolled table value visible,
## plus the overkill bonus baked into it (if any), not just used
## silently for the internal table lookup.
func _critical_wound_roll_text(result: CombatResolver.AttackResult) -> String:
	var text := "roll %d" % result.critical_wound_roll
	if result.critical_wound_overkill_bonus > 0:
		text += " (includes +%d overkill bonus)" % result.critical_wound_overkill_bonus
	return text

## "Make a [Difficulty] [Skill] Test or gain [Condition(s)]" — genuinely
## rolled now rather than the Condition being applied unconditionally
## as an earlier pass did. Empty test_or_condition is a no-op.
func _apply_critical_wound_test_or_condition(character: Character, entry: Dictionary) -> void:
	var toc: Dictionary = entry.get("test_or_condition", {})
	if toc.is_empty():
		return
	var skill: SkillDefinition = GameData.skill_db.find_by_name(toc.get("skill", "Endurance"))
	if skill == null:
		return
	## Iron Jaw (p.139): "+10 per rank to any Test made to resist or
	## recover from being Stunned" — this generic Test-or-Condition
	## resolver covers many different Critical Wound outcomes (Stubbed
	## Toe's -10 Agility, various Bleeding/other fail_conditions), so the
	## bonus only applies when THIS particular roll is actually gating a
	## Stunned Condition, not to every Endurance Test that happens to
	## flow through here.
	var toc_fail_conditions: Dictionary = toc.get("fail_conditions", {})
	var iron_jaw_bonus := character.get_talent_rank("Iron Jaw") * 10 if toc_fail_conditions.has("Stunned") else 0
	var iron_jaw_breakdown: Array = [{"name": "Iron Jaw", "amount": iron_jaw_bonus}] if iron_jaw_bonus > 0 else []
	var test := TestResolver.resolve_skill_test(character, skill, "", int(toc.get("difficulty", 0)) + iron_jaw_bonus, iron_jaw_breakdown)
	if not test.success:
		var fail_conditions: Dictionary = toc.get("fail_conditions", {})
		for cond_name in fail_conditions.keys():
			character.add_condition(cond_name, int(fail_conditions[cond_name]))
		if not fail_conditions.is_empty():
			_add_notice("[color=#c9a24b]%s fails the %s Test — %s.[/color]" % [character.character_name, toc.get("skill", "Endurance"), ", ".join(fail_conditions.keys())])
		## Audit fix: a few Trivial results gate their own `penalty` behind
		## this same Test rather than applying it unconditionally (e.g.
		## Stubbed Toe: "Pass an Average Endurance Test or suffer -10
		## Agility") — `fail_penalty` marks that case so the caller
		## (_handle_critical_wound_on_player/_apply_critical_wound_to_monster)
		## knows to skip its own unconditional apply and let this failure
		## branch do it instead, only on an actual failed Test.
		if toc.get("fail_penalty", false):
			var notice := _apply_critical_wound_penalty(character, entry)
			if notice != "":
				_add_notice(notice)

## Amputation (p.83-86's various "lose your X" / "arm counts as lost"
## results): a real functional tag rather than a purely-flavour
## Condition as an earlier pass modelled it. "drop_only"/"hand_temp"/
## "hand" all unequip whatever's held in the struck arm's hand
## (Left Arm hit -> off-hand, Right Arm hit -> main hand, a reasonable
## right-handed-default mapping since this project doesn't track
## handedness); "leg"/"leg_temp" apply a genuine Movement-halving
## Condition. "finger"/"ear"/"eye" stay flavour-only, since a Blinded/
## Deafened Condition already covers their mechanical weight.
func _apply_critical_wound_amputation(character: Character, location: String, amputation: String) -> void:
	if amputation in ["drop_only", "hand_temp", "hand"]:
		var slot: String
		if location == "Left Arm":
			slot = "offhand"
		elif location == "Right Arm":
			slot = "main"
		else:
			## Audit fix: a Body-location result that also reaches an arm
			## (e.g. "Wrenched Collar Bone" — "Randomly select one arm")
			## doesn't know WHICH arm from its own hit location alone,
			## unlike a genuine Arm-table result — the book says to
			## randomly pick one rather than always defaulting to main.
			slot = "offhand" if randi() % 2 == 0 else "main"
		if slot == "offhand" and character.equipped_offhand != "":
			_add_notice("[color=#c9a24b]%s drops their off-hand item![/color]" % character.character_name)
			character.equipped_offhand = ""
		elif slot == "main" and character.equipped_weapon != "":
			_add_notice("[color=#c9a24b]%s drops their weapon![/color]" % character.character_name)
			character.equipped_weapon = ""
	elif amputation in ["leg", "leg_temp"]:
		character.add_condition("Crippled Leg", 1)
		_add_notice("[color=#c9a24b]%s's leg is crippled — Movement is halved until healed.[/color]" % character.character_name)

## Applies a Critical Wound table entry's `penalty` dict — a temporary
## characteristic hit — and returns a ready-to-display notice string (or
## "" if there was no penalty to apply). Shared by both the unconditional
## case (most entries: the penalty just applies) and the conditional case
## (a `fail_penalty` entry like Stubbed Toe, only applied on a failed
## Test, from _apply_critical_wound_test_or_condition above).
##
## Audit fix: the penalty's `duration_unit` (default "days", matching all
## pre-existing data) routes to the correct duration-tracking system —
## "days" keeps using the existing day-scoped `critical_wound_penalties`
## (ticked via Camp/Sleep), while "rounds" now uses the genuinely
## Round-scoped `active_buffs` system (ticked once per combat Round) via
## `add_timed_buff()`, matching results like Twisted Knee ("1d10 Rounds")
## and Stubbed Toe ("until the end of your next turn") that the book
## specifies in Rounds rather than days. `duration_days_max` is kept as
## the field name for the roll range regardless of unit, to avoid a
## global data-file rename.
func _apply_critical_wound_penalty(character: Character, entry: Dictionary) -> String:
	var penalty_data: Dictionary = entry.get("penalty", {})
	if penalty_data.is_empty():
		return ""
	var duration := randi_range(1, int(penalty_data["duration_days_max"]))
	var characteristic: String = penalty_data["characteristic"]
	var amount := int(penalty_data["amount"])
	var char_label: String = CharacteristicSet.SHORT_NAMES.get(characteristic, characteristic)
	if penalty_data.get("duration_unit", "days") == "rounds":
		character.add_timed_buff(entry.get("name", "Critical Wound"), "Critical Wound", {characteristic: amount}, duration, 0)
		return "[color=#c9986a]%s: %+d %s for %d Round(s).[/color]" % [entry.get("name", ""), amount, char_label, duration]
	character.critical_wound_penalties.append({
		"name": entry.get("name", ""), "source": "Critical Wound",
		"characteristic_bonuses": {characteristic: amount},
		"rounds_remaining": duration, "damage_bonus": 0,
	})
	return "[color=#c9986a]%s: %+d %s for %d day(s).[/color]" % [entry.get("name", ""), amount, char_label, duration]

func _apply_critical_wound_to_monster(result: CombatResolver.AttackResult, target: Character) -> void:
	var entry: Dictionary = result.critical_wound_entry
	if entry.is_empty():
		return
	## Painless (p.339): a creature that doesn't feel pain isn't
	## affected by a Critical Wound's Condition or amputation effects
	## the way a normal creature would — the raw trauma (Wounds loss,
	## and an outright fatal result) still applies regardless, since
	## Painless is about pain, not physical invulnerability. Previously
	## documented in the reference database with no actual mechanical
	## effect anywhere.
	var is_painless := target.has_creature_trait("Painless")
	if not is_painless:
		for cond_name in entry.get("conditions", {}).keys():
			target.add_condition(cond_name, int(entry["conditions"][cond_name]))
		_apply_critical_wound_test_or_condition(target, entry)
		_apply_critical_wound_amputation(target, result.critical_wound_location, entry.get("amputation", ""))
	if result.critical_wound_causes_death:
		target.wounds_current = 0
	## Per the request ("replace crit and fumble text in the combat log
	## with their own type of roll card"): the roll/name/location/flavor
	## this used to repeat as plain text now live on the Critical Wound
	## card _show_attack_cards() already added to this same history
	## entry — nothing left to say here except the Painless caveat,
	## which isn't shown on the card.
	if is_painless:
		_add_notice("[color=#c9a24b]%s is Painless — shrugs off the Critical Wound's Condition/amputation effects (the raw Wounds and any fatal result still apply).[/color]" % target.character_name)

func _handle_critical_wound_on_player(result: CombatResolver.AttackResult) -> void:
	var entry: Dictionary = result.critical_wound_entry
	if entry.is_empty():
		return
	var location := result.critical_wound_location

	if result.critical_wound_causes_death:
		## A Death-tier Critical Wound table result (p.173: "a few
		## results... can result in death. Should any of these occur,
		## it is time to permanently spend a Fate point if you have
		## one") — not deflectable with armour; only a Fate Point saves
		## you here, per the request.
		await _handle_fatal_moment(entry, location, "%s (%s)" % [entry.get("name", ""), location])
		return

	var can_deflect := player.can_deflect_critical_wound(location)
	## Real bug fix (see awaiting_critical_wound_choice's own declaration
	## comment): this used to be awaiting_player_target, which crashed the
	## game when Enter was pressed with a stale selected_target still set
	## from earlier in the fight.
	awaiting_critical_wound_choice = true
	_clear(target_container)
	target_container.add_child(_section_label("Critical Wound (%s): %s (%s)" % [_critical_wound_roll_text(result), entry.get("name", ""), location]))
	var flavor_lbl := Label.new()
	flavor_lbl.text = entry.get("flavor", "")
	flavor_lbl.autowrap_mode = TextServer.AUTOWRAP_WORD
	target_container.add_child(flavor_lbl)

	_pending_choice = false
	var accept_btn := _make_button()
	accept_btn.text = "Accept the wound as dealt"
	accept_btn.pressed.connect(func():
		_pending_choice = true
		awaiting_critical_wound_choice = false
	)
	target_container.add_child(accept_btn)

	if can_deflect:
		var deflect_btn := _make_button()
		deflect_btn.text = "Deflect (%s)" % location
		deflect_btn.pressed.connect(func():
			_pending_choice = false
			awaiting_critical_wound_choice = false
		)
		target_container.add_child(deflect_btn)
	else:
		var no_armour_note := Label.new()
		no_armour_note.text = "(No armour at %s to deflect with.)" % location
		no_armour_note.add_theme_font_size_override("font_size", 7)
		no_armour_note.add_theme_color_override("font_color", Color(0.6, 0.55, 0.48))
		target_container.add_child(no_armour_note)

	## Real bug fix (user report: "combat getting stuck sometimes on
	## creature's turn"): every OTHER button menu in this file finishes
	## by calling _auto_focus_default_button() so WASD/Space (per the
	## project's own stated convention, "Space is the main way to accept
	## a choice menu") have somewhere to land right away — this prompt
	## was a silent exception, added back when it was first split out
	## into its own awaiting_critical_wound_choice flag (see that flag's
	## own declaration comment) purely to fix a crash in the Enter/
	## awaiting_player_target dispatch path, without ever restoring a
	## working keyboard default afterward. With nothing focused, Space
	## does nothing here (KEY_SPACE in _unhandled_input only handles
	## awaiting_incapacitated_turn/awaiting_continue) and Enter is
	## deliberately absorbed (see this flag's own branch below) — a
	## monster landing a Critical Wound left the screen showing this
	## prompt with no visible way to respond except finding the right
	## button to click, reading exactly like a stuck/frozen turn.
	## Defaults to Accept (the no-resource-spent, "do nothing extra"
	## option) rather than Deflect (which costs armour AP) — same "safe,
	## reversible choice wins the accidental keypress" reasoning as
	## _handle_fatal_moment()'s own default just below.
	accept_btn.text += "  [Space]"
	_active_primary_hotkey_button = accept_btn
	_refresh_focus_for_disabled_buttons(self)
	_auto_focus_default_button()

	while awaiting_critical_wound_choice:
		await get_tree().process_frame

	var accepted := _pending_choice
	if accepted or not can_deflect:
		for cond_name in entry.get("conditions", {}).keys():
			player.add_condition(cond_name, int(entry["conditions"][cond_name]))
		_apply_critical_wound_test_or_condition(player, entry)
		_apply_critical_wound_amputation(player, location, entry.get("amputation", ""))
		_add_notice("%s accepts the wound's full effect: %s" % [player.character_name, entry.get("name", "")])
	else:
		player.deflect_critical_wound(location)
		_add_notice("[color=#8fbf6a]%s deflects the critical effect — armour at %s absorbs it (-1 AP there).[/color]" % [player.character_name, location])

	## Deflection avoids the Condition/text effects, per the book and
	## the earlier request — but the Wound itself, and the fact of
	## having BEEN critically wounded, aren't avoidable. The accumulated
	## count (for the Toughness Bonus death threshold below) and any
	## mechanical stat penalty apply either way.
	##
	## Audit fix: Trivial ("T") results explicitly do NOT count towards
	## the number of Critical Wounds that count towards killing a
	## Character (p.173) — only non-Trivial results advance the counter.
	##
	## Real bug fix (user report: "deflecting a critical hit on the body
	## leather jack location is still crashing the game, happened twice
	## now"): `entry.get("wounds")` is usually an int (a flat extra-
	## wounds table entry, e.g. 1/2/3) or the string "Death" — comparing
	## an int directly against the String "T" throws a genuine GDScript
	## runtime error ("Invalid operands 'int' and 'String' in operator
	## '!='"), which aborted this whole function right after Deflect (or
	## Accept) had already resolved — skipping _clear(target_container)/
	## _render_status() below and leaving the screen stuck showing the
	## already-answered prompt with no way forward, reading as a crash/
	## freeze even though the engine itself kept running. Same type-safe
	## check _apply_fumble_critical_wound() already uses a few hundred
	## lines down (`not (wounds_val is String and wounds_val == "T")`).
	if not (entry.get("wounds") is String and entry.get("wounds") == "T"):
		player.active_critical_wound_count += 1
	## Audit fix: a `fail_penalty` entry (e.g. Stubbed Toe) already had
	## its penalty conditionally applied by
	## _apply_critical_wound_test_or_condition() above, only on an
	## actual failed Test — applying it again here unconditionally would
	## double it up (and apply it even on a pass).
	if not entry.get("test_or_condition", {}).get("fail_penalty", false):
		var penalty_notice := _apply_critical_wound_penalty(player, entry)
		if penalty_notice != "":
			_add_notice(penalty_notice)

	_clear(target_container)
	_render_status()

	## p.173: "If you take the Unconscious Condition and have 0 Wounds,
	## compare the total number of Critical Wounds you currently suffer
	## with your Toughness Bonus. If you have more Critical Wounds than
	## your Toughness Bonus, you succumb..." Approximated here as
	## "reached 0 Wounds" rather than tracking Unconscious separately,
	## consistent with how this project already treats 0 Wounds as the
	## defeat trigger everywhere else.
	if player.wounds_current <= 0 and player.active_critical_wound_count > player.get_characteristic_bonus("toughness"):
		await _handle_fatal_moment({}, "", "accumulated Critical Wounds (%d) exceeding your Toughness Bonus (%d)" % [player.active_critical_wound_count, player.get_characteristic_bonus("toughness")])

## Shared by both real permadeath triggers (a Death-tier table result,
## and accumulated Critical Wounds exceeding Toughness Bonus) — offers
## to spend a permanent Fate Point to survive ("Die Another Day," p.170:
## battered and taken out of the fight, but alive) if the player has
## one, otherwise it's genuine, final permadeath.
func _handle_fatal_moment(entry: Dictionary, location: String, description: String) -> void:
	awaiting_fatal_moment_choice = true
	_clear(target_container)
	target_container.add_child(_section_label("[color=salmon]FATAL: %s[/color]" % description))
	if entry.get("flavor", "") != "":
		var flavor_lbl := Label.new()
		flavor_lbl.text = entry.get("flavor", "")
		flavor_lbl.autowrap_mode = TextServer.AUTOWRAP_WORD
		target_container.add_child(flavor_lbl)

	_pending_choice_str = ""
	if player.fate_points > 0:
		## p.170: spending a permanent Fate point offers a choice of
		## TWO outcomes, not one — this used to only ever offer Die
		## Another Day. Added "How Did That Miss?" as the second: you
		## avoid the incoming damage entirely and keep fighting (no
		## penalty), but you're still in the fight and at risk again in
		## later Rounds — unlike Die Another Day, which takes you out of
		## the current encounter but guarantees you survive it.
		var fate_btn := _make_button()
		fate_btn.text = "Spend 1 Fate Point — Die Another Day: knocked out, but survive (%d Fate remaining after)" % (player.fate_points - 1)
		fate_btn.pressed.connect(func():
			_pending_choice_str = "die_another_day"
			awaiting_fatal_moment_choice = false
		)
		target_container.add_child(fate_btn)
		var miss_btn := _make_button()
		miss_btn.text = "Spend 1 Fate Point — How Did That Miss?: keep fighting, no penalty (%d Fate remaining after)" % (player.fate_points - 1)
		miss_btn.pressed.connect(func():
			_pending_choice_str = "how_did_that_miss"
			awaiting_fatal_moment_choice = false
		)
		target_container.add_child(miss_btn)
		var accept_btn := _make_button()
		accept_btn.text = "Accept your fate"
		accept_btn.pressed.connect(func():
			_pending_choice_str = ""
			awaiting_fatal_moment_choice = false
		)
		target_container.add_child(accept_btn)
		## Real bug fix (user report: "combat getting stuck sometimes on
		## creature's turn") — see _handle_critical_wound_on_player()'s
		## own identical fix just above for the full explanation; this
		## prompt had the exact same gap. Defaults to "Accept your fate"
		## rather than either Fate-Point-spending option, so an
		## accidental Space press can never spend a permanent Fate Point
		## the player didn't mean to spend — same "safe/no-op wins"
		## reasoning _prompt_bonus_action_choice()'s own Enter-declines
		## behaviour already uses for its ambiguous case.
		accept_btn.text += "  [Space]"
		_active_primary_hotkey_button = accept_btn
	else:
		var no_fate_lbl := Label.new()
		no_fate_lbl.text = "You have no Fate Points left to spend. There is no other way back from this."
		no_fate_lbl.autowrap_mode = TextServer.AUTOWRAP_WORD
		target_container.add_child(no_fate_lbl)
		var continue_btn := _make_button()
		continue_btn.text = "..."
		continue_btn.pressed.connect(func():
			_pending_choice_str = ""
			awaiting_fatal_moment_choice = false
		)
		target_container.add_child(continue_btn)
		continue_btn.text += "  [Space]"
		_active_primary_hotkey_button = continue_btn

	_refresh_focus_for_disabled_buttons(self)
	_auto_focus_default_button()

	while awaiting_fatal_moment_choice:
		await get_tree().process_frame

	var fate_choice := _pending_choice_str
	if fate_choice == "die_another_day":
		player.fate_points -= 1
		player.wounds_current = 1
		if entry.is_empty():
			## The accumulated-Critical-Wounds trigger survives by one
			## of the Critical Wounds being treated as healed (p.173's
			## own "someone heals one of your Critical Wounds" out),
			## bringing the count back under the Toughness Bonus.
			player.active_critical_wound_count = max(0, player.active_critical_wound_count - 1)
		_add_notice("[b][color=#8fbf6a]%s spends a Fate Point — Die Another Day! Battered, but alive. (%d Fate Point(s) remaining)[/color][/b]" % [player.character_name, player.fate_points])
		GameState.autosave()
		_end_battle(false)
	elif fate_choice == "how_did_that_miss":
		## Per p.170's own wording ("your character can continue on
		## without penalty, but has no guarantee of survival in later
		## rounds"): unlike Die Another Day, the encounter does NOT end
		## here — the fight continues. wounds_current is floored to 1
		## (the same survival floor Die Another Day uses) since this
		## project approximates "the fatal moment" as "reached/stayed at
		## 0 Wounds" rather than tracking a separate hit-by-hit damage
		## log to fully reverse; the accumulated-Critical-Wounds trigger
		## gets the same one-Critical-Wound reprieve Die Another Day
		## grants, for the same p.173 reason cited above.
		player.fate_points -= 1
		player.wounds_current = 1
		if entry.is_empty():
			player.active_critical_wound_count = max(0, player.active_critical_wound_count - 1)
		_add_notice("[b][color=#8fbf6a]%s spends a Fate Point — How Did That Miss?! The killing blow somehow doesn't land — %s fights on. (%d Fate Point(s) remaining)[/color][/b]" % [player.character_name, player.character_name, player.fate_points])
		GameState.autosave()
		_clear(target_container)
		_render_status()
	else:
		## Party-wipe/permadeath rework, per the request ("if a character
		## dies he should lie on the floor where he was and simply be
		## dead (skip his turn)... remove the old revive mechanic"): this
		## used to be permadeath — change_scene_to_file() straight to
		## Death.tscn, unconditionally, with no battle_over flag set
		## first. That's the exact crash reported ("crashed when
		## accepting fate and letting a character die... inside the
		## Sewer"): the caller (_resolve_player_defense, and others —
		## see _wait_for_continue()'s own comment) always follows up with
		## `await _wait_for_continue()`, whose poll loop calls
		## `get_tree().process_frame` — but by then change_scene_to_file()
		## had already freed this very node, so get_tree() came back
		## null and the await threw "Invalid access to property or key
		## 'process_frame' on a base object of type 'null instance'."
		##
		## Now: no scene change at all here. The character is simply
		## marked is_dead (see Character.is_dead's own doc comment) and
		## left at 0 Wounds exactly where they fell — CombatEncounter.
		## is_defeated() already treats 0 Wounds as "skip this turn,
		## exclude from get_living()" for anyone, ally or adversary, so
		## no separate turn-skip logic is needed here. The fight simply
		## continues around them. If this death empties get_living("ally")
		## entirely (the whole party is now down, dead or merely
		## unconscious), _next_turn()'s own existing party-wipe check
		## fires _end_battle(false) on its own very next call — see that
		## function's own comment for what that now does (routes the
		## party to the nearest healer instead of the old free
		## auto-revive-in-the-village mechanic).
		player.is_dead = true
		player.wounds_current = 0
		_add_notice("[b][color=salmon]%s has no Fate left to spend, and falls where they stand — dead.[/color][/b] (%s)" % [player.character_name, description])
		GameState.autosave()
		_clear(target_container)
		_render_status()

## A monster's Assess: sizes up the fight using Perception (a universal,
## reasonable "read the battlefield" skill every creature has some
## value in, even untrained) rather than building out skill-choice logic
## monster data doesn't really support yet.
func _monster_assess(actor: Character) -> void:
	var skill: SkillDefinition = GameData.skill_db.find_by_name("Perception")
	var test := TestResolver.resolve_skill_test(actor, skill, "")
	var extra: Array[String] = []
	var adv_before := encounter.advantage_pool.get_pool("adversary")
	## Distract (p.142): a Distracted monster still rolls Assess, but
	## generates no Advantage from it.
	if test.success and not actor.is_advantage_denied():
		encounter.advantage_pool.gain_assess("adversary", test.success_levels)
		var gained := 3 if test.success_levels >= 6 else 2
		extra.append("+%d Advantage (Assess)" % gained)
	elif test.success:
		extra.append("Assess succeeds, but %s can generate no Advantage right now (Distracted)." % actor.character_name)
	else:
		extra.append("No tactical opening found")
	_show_single_card(actor, "Perception", "Assess", "adversary", test, extra)
	_note_advantage_change("adversary", adv_before, "Assess")
	_render_status()
	await _wait_for_continue()

## Batter (p.134): 1 Advantage for an Opposed Test that, on a win,
## worsens the target's next defensive Test — a monster AI option now,
## not just the player's, mirroring _on_batter's own logic exactly
## (GroupAdvantageActions.spend_batter already takes any attacker/
## target pair, no player-specific assumptions to work around).
func _monster_batter(actor: Character, target: Character) -> void:
	var adv_before := encounter.advantage_pool.get_pool("adversary")
	var result := GroupAdvantageActions.spend_batter(encounter.advantage_pool, actor, target)
	_show_opposed_action_cards(actor, target, "Batter", result)
	_note_advantage_change("adversary", adv_before, "Batter")
	_refresh_enemy_display()
	_render_status()
	await _wait_for_continue()

## Trick (p.134): 1 Advantage for an Opposed Test that, on a win,
## inflicts a Condition on the target — picks whichever Condition in
## TRICK_CONDITIONS actually applies right now (skips the "no
## Condition" option and anything the target already has), rather than
## a fixed choice, since a monster doesn't have a UI dropdown to pick
## one from.
func _monster_trick(actor: Character, target: Character) -> void:
	var usable_conditions: Array[String] = []
	for cond in TRICK_CONDITIONS:
		if cond != "" and not target.conditions.has(cond):
			usable_conditions.append(cond)
	if usable_conditions.is_empty():
		await _monster_batter(actor, target)   ## nothing useful left to Trick with — Batter instead
		return
	var condition: String = usable_conditions[randi() % usable_conditions.size()]
	var adv_before := encounter.advantage_pool.get_pool("adversary")
	var result := GroupAdvantageActions.spend_trick(encounter.advantage_pool, actor, target, condition)
	_show_opposed_action_cards(actor, target, "Trick", result)
	_note_advantage_change("adversary", adv_before, "Trick")
	_refresh_enemy_display()
	_render_status()
	await _wait_for_continue()

## Awards a flat XP bounty the moment a monster's Wounds hit 0 — once
## per monster, tracked via xp_awarded_for so a monster that's already
## down can't somehow pay out twice. Also fires Victory (Up in Arms
## p.133): +1 Advantage for an "important" monster, +2 for a nemesis.
## `drop_loot` (per the request: a monster that flees off the edge of
## the battle map "will count as defeated but NOT drop any loot"): every
## real call site (an actual kill) leaves this at its default true;
## _monster_flees_off_map() below is the one exception, passing false so
## a fled monster's own death-resolution path (XP, quest progress,
## Victory Advantage for an Important/Nemesis) still runs in full, just
## without _generate_loot() at the end of it.
func _check_for_kill_xp(target: Character, drop_loot: bool = true) -> void:
	if target.wounds_current > 0 or xp_awarded_for.has(target):
		return
	xp_awarded_for.append(target)
	## Per the request: XP always goes to every present party member,
	## each with their own real, separate XP pool (their own
	## experience_total) — not just whoever happened to land the
	## killing blow. Everyone in the fight shares the credit.
	for member in GameState.party:
		member.experience_total += XP_PER_KILL
	## Per the request: XP is no longer announced individually after each
	## kill — same treatment loot already got (see _generate_loot's own
	## comment). xp_awarded_for (appended just above) is still tracked
	## per-kill so _end_battle's own "total_xp = xp_awarded_for.size() *
	## XP_PER_KILL" final report adds up correctly; there's just no
	## notice logged here anymore.
	## Per the request: Stage 1 of the Elder's own quest chain counts
	## real, individual kills — not encounters or groups — so this
	## fires once per monster actually killed, exactly like the XP
	## bounty just above it. Quest progress itself stays on the
	## party's own shared record (party[0]) rather than duplicated
	## per member — per the request, Quests/Journal are shared for the
	## whole group, not each member's own separate copy.
	if not GameState.party.is_empty():
		GameState.party[0].progress_elder_kill()

	if target.is_important or target.is_nemesis:
		var adv_before := encounter.advantage_pool.get_pool("ally")
		encounter.advantage_pool.gain_victory("ally", target.is_nemesis)
		var gained := 2 if target.is_nemesis else 1
		_add_notice("[color=#c9a24b]★ Victory! +%d Advantage (%d → %d) for defeating %s.[/color]" % [
			gained, adv_before, encounter.advantage_pool.get_pool("ally"), target.character_name
		])

	if drop_loot:
		_generate_loot(target)

## Loot by creature type, per the request: Animals drop food (raw meat)
## and a sellable trophy; Humanoids drop their own gear via independent
## 50% rolls — one roll for their equipped weapon, one roll per piece
## of armour they wore, each a separate 50% chance rather than a
## grab-bag of 1-2 random items — plus coin scaled to their career
## Status. The book doesn't give a hard "how much money does a slain
## NPC carry" table (that's left to GM judgement), so this is a
## documented, reasonable formula: 1d10 of whichever coin their Status
## Tier normally uses (p.289's own Brass/Silver/Gold spending
## guidance), per Status star.
## Per the follow-up request ("instead of auto picking up loot, i want a
## new pop up window with the battle report"): tangible items no longer
## go straight into player.inventory the instant a monster dies — they're
## staged in _pending_loot instead, and the Battle Report popup
## (_show_battle_report(), built in _end_battle()) is what actually adds
## a chosen item to whichever party member is selected there, per the
## player's own Loot/Drop toggle. Coin stays auto-collected exactly as
## before (no per-coin toggle makes sense — see _show_battle_report()'s
## own comment on why coin is summarised, not itemised), and
## progress_task_gather() still fires at generation time, same as
## before: it's tracking "you found the thing," not "you carried it
## home," and that's still true regardless of whether the item is later
## toggled to Drop.
func _generate_loot(target: Character) -> void:
	var mdef: MonsterDefinition = monster_defs.get(target)
	if mdef == null:
		return
	var loot_lines: Array[String] = []

	if mdef.creature_type == "Animal":
		var meat_count: int = max(1, int(mdef.wounds_max / 4.0))
		for i in range(meat_count):
			_pending_loot.append("Uncooked Meat")
		loot_lines.append("%dx Uncooked Meat" % meat_count)
		var trophy := _pick_trophy_for(mdef.monster_name)
		if trophy != "":
			_pending_loot.append(trophy)
			loot_lines.append(trophy)
			player.progress_task_gather(trophy)
	elif mdef.creature_type == "Humanoid":
		## Independent 50% rolls: the weapon they carried, and
		## separately each piece of armour they wore, each has its own
		## 50% chance to actually turn up in the loot — not a "pick 1-2
		## from everything they own" grab bag. A humanoid with no real
		## weapon (or nothing left after the rolls) drops no gear at
		## all, which is a fair outcome, not a bug to work around.
		if mdef.weapon_name != "" and randf() < 0.5:
			_pending_loot.append(mdef.weapon_name)
			loot_lines.append(mdef.weapon_name + " (low quality)")
		for a in mdef.armour:
			if randf() < 0.5:
				_pending_loot.append(a)
				loot_lines.append(a + " (low quality)")

		var stars: int = max(mdef.status_stars, 1)
		var roll := 0
		for i in range(stars):
			roll += Dice.d10()
		## Per the request ("add the amount of gold found to the battle
		## report"): coin is auto-collected straight into the player's own
		## purse (gold_crowns/silver_shillings/brass_pennies) the instant a
		## Humanoid dies, same as before -- these `_battle_*_found`
		## accumulators are a separate running total of THIS battle's own
		## coin only, reset alongside _pending_loot in _start_encounter(),
		## purely so _show_battle_report() has something to display without
		## having to diff the purse before/after.
		match mdef.status_tier:
			"Gold":
				player.gold_crowns += roll
				_battle_gold_found += roll
				loot_lines.append("%d GC" % roll)
			"Silver":
				player.silver_shillings += roll
				_battle_silver_found += roll
				loot_lines.append("%d/–" % roll)
			_:
				player.brass_pennies += roll
				_battle_brass_found += roll
				loot_lines.append("%dd" % roll)

		## Per the request: a faction trophy on top of gear/coin, for
		## the factions that actually make sense as one (Greenskin,
		## Skaven) — not Human, whose existing gear-and-coin loot
		## already covers what a defeated bandit realistically leaves
		## behind.
		var humanoid_trophy := TrophyLookup.pick_trophy_for_monster(mdef)
		if humanoid_trophy != "":
			_pending_loot.append(humanoid_trophy)
			loot_lines.append(humanoid_trophy)
			player.progress_task_gather(humanoid_trophy)
	elif mdef.creature_type == "Monster":
		## Per the request: Monster-type creatures (Undead, and now
		## also the large/dangerous Troll and Giant) previously
		## dropped nothing at all if they had no gear/coin either. A
		## trophy alone — no gear/coin, since these don't carry a
		## purse the way a living Humanoid would.
		var monster_trophy := TrophyLookup.pick_trophy_for_monster(mdef)
		if monster_trophy != "":
			_pending_loot.append(monster_trophy)
			loot_lines.append(monster_trophy)
			player.progress_task_gather(monster_trophy)

	## Per the request: no longer announced individually after each
	## kill — still accumulated here for the existing scrolling combat
	## log (the Battle Report popup is now the primary place loot is
	## actually reviewed/claimed, but this log line is still useful
	## color for "who dropped what," so it's kept).
	if not loot_lines.is_empty():
		var line := "Loot from %s: %s." % [target.character_name, ", ".join(loot_lines)]
		_battle_loot_log.append(line)

## Both delegate to the shared TrophyLookup utility now — needed so
## Overworld.gd can also determine a monster's trophy, for the
## gather-task gold-marker coloring (see TrophyLookup's own header).
func _pick_trophy_for(monster_name: String) -> String:
	return TrophyLookup.pick_trophy_for(monster_name)

func _pick_faction_trophy_for(faction: String) -> String:
	return TrophyLookup.pick_faction_trophy_for(faction)

func _end_battle(victory: bool) -> void:
	battle_over = true
	## Per the request ("Flaming sword of rhuin should turn back to a
	## sword if the field encounter ends"): the enchant was previously
	## ONLY reverted by its own per-Round timer (flaming_sword_rounds_
	## remaining, ticked by CombatEncounter._on_round_end()) hitting 0.
	## Characters persist across encounters (the player especially), so
	## a fight ending mid-Duration used to leave the enchant sitting on
	## the Character indefinitely — it would still silently be "on fire"
	## the next time combat started, with no in-fight Round ever ticking
	## it down outside a live encounter. Force-clearing it here for
	## every combatant (living or dead — no harm clearing an already-
	## dead character's stale enchant) closes that gap: leaving a fight,
	## for any reason, always restores the wielder's real sword.
	for c in encounter.combatants:
		if c.flaming_sword_rounds_remaining > 0:
			c.flaming_sword_rounds_remaining = 0
			c.flaming_sword_weapon = null
			c.flaming_sword_item_name = ""
		## Sigmar's Fiery Hammer: per the explicit request ("clear out
		## when the field encounter screen closes") — same reasoning as
		## Flaming Sword of Rhuin just above (a fight ending mid-Duration
		## leaves no live encounter left to ever tick the buff down to 0
		## on its own), but this one also removes the underlying
		## active_buffs entry itself (not just the weapon rename), since
		## the Damage bonus it grants is otherwise gated only on that
		## buff still being present — get_equipped_weapon()'s own
		## self-heal (see fiery_hammer_weapon's comment) would clear the
		## rename regardless the next time it's called, but doing both
		## here immediately means no combatant is left "still on fire"
		## even for the one frame between this function returning and
		## that next call.
		if c.has_active_buff("Sigmar's Fiery Hammer"):
			c.remove_active_buff("Sigmar's Fiery Hammer")
			c.fiery_hammer_weapon = null
			c.fiery_hammer_item_name = ""
	## Per the request ("Lingering AoE effects should be fully removed
	## after combat"): a ground hazard (Great Fires of U'Zhul,
	## Firewall) has no reason to survive the fight it was cast in —
	## also cleared at both _start_encounter()/_start_exploration_mode()
	## sites below, since a dungeon room-to-room transition never
	## actually calls this function at all.
	persistent_aoe_hazards.clear()
	_clear_active_smoke_clouds()
	_clear(target_container)
	if victory:
		var total_xp := xp_awarded_for.size() * XP_PER_KILL
		_add_notice("[b][color=lightgreen]★ Victory! All enemies defeated.[/color][/b] (%d XP earned this fight)" % total_xp)
		_add_notice("[color=#c9a04b]Enemies defeated: %d.[/color]" % xp_awarded_for.size())
		if not _battle_loot_log.is_empty():
			_add_notice("[b]Loot this battle:[/b] " + " | ".join(_battle_loot_log))
		else:
			_add_notice("Loot this battle: none.")
		_log_final_round_condition_summary()
		## Per the request: a real, explicit "this quest monster was
		## defeated" flag, set the moment a genuine victory includes
		## it — checked against every Active quest's own monster list
		## by real monster_name, since a fight may include monsters
		## that aren't part of any quest at all.
		for m in monster_defs:
			var mdef: MonsterDefinition = monster_defs[m]
			if not encounter.is_defeated(m):
				continue
			for qq in player.quests:
				if qq.get("status", "") != "Active":
					continue
				var qid: String = qq.get("quest_id", "")
				if qid == "":
					continue
				var quest_def: QuestDefinition = load("res://data/quests/%s.tres" % qid) as QuestDefinition
				if quest_def == null:
					continue
				for qmdef in quest_def.monsters:
					if qmdef.monster_name == mdef.monster_name:
						player.set_quest_monster_defeated(qid, qmdef.monster_id)
		## Per the request: a quest never formally completed before
		## this — evaluate_quest_win_conditions() existed but nothing
		## anywhere actually called it, so a quest like Gotheim's own
		## stayed "Active" forever even after its own monster was
		## genuinely defeated. Checked once per Active quest right
		## after monster-defeated flags are updated above, so a
		## defeat-based win condition is evaluated with fresh data.
		for qq2 in player.quests:
			if qq2.get("status", "") != "Active":
				continue
			var qid2: String = qq2.get("quest_id", "")
			if qid2 == "":
				continue
			var win_eval: Dictionary = player.evaluate_quest_win_conditions(qid2)
			if win_eval.get("won", false):
				qq2["status"] = "Completed"
				_add_notice("[color=#c9a24b]★ Quest Complete: %s[/color]" % str(qq2.get("title", qid2)))
	else:
		## Party-wipe rework, per the request ("If the entire party dies
		## move them from any screen they are on to the Temple of
		## Shallya in Ubersreik (or the healer in Giessingen if they are
		## on the same map as him)... remove the old revive mechanic"):
		## this branch used to be the "old revive mechanic" itself — a
		## free, instant full heal (see the old `player.wounds_current =
		## player.wounds_max` this replaced, further below) plus
		## quietly resetting return/camp position so Overworld's own
		## default-spawn fallback dropped the party back in the village,
		## narrated as "no permadeath here yet." Losing now actually
		## costs something: the party arrives at a real Shallyan Priest
		## still hurt (and, if this defeat included any genuine deaths —
		## see Character.is_dead — still dead), needing to pay for
		## treatment same as any other healer visit, rather than waking
		## up already patched up for free. _on_return_pressed() is what
		## actually performs the hand-off, once the player closes this
		## Battle Report — see _party_wiped/_party_wipe_healer_city_id's
		## own declaration comment.
		##
		## A defeated party doesn't get to stand their ground where they
		## fell either way — clearing the remembered position makes
		## Overworld fall back to the map's normal spawn point (the
		## village) once the party eventually leaves the healer, instead
		## of restoring them to the battlefield. Also clears the
		## persistent camp position, not just the session-only return
		## position, for the same reason.
		GameState.return_position = Vector2i(-1, -1)
		player.camp_position = Vector2i(-1, -1)
		_party_wiped = true
		## Same "which map is actually active" signal _do_exit_dungeon()
		## already uses for its own "which screen to return to" choice.
		## Giessingen only gets its own closer healer if the party is
		## genuinely standing on Giessingen's own local map right now
		## (not inside any city, e.g. mid-dungeon under Ubersreik's own
		## Sewer) — every other case defaults to Ubersreik's Temple of
		## Shallya, per the request's own explicit priority.
		if GameState.last_active_city_id == "" and GameState.last_active_map_path == "res://data/maps/giessingen_village.tres":
			_party_wipe_healer_city_id = ""
			_add_notice("[b][color=salmon]Your party has fallen![/color][/b] Word reaches Giessingen's own healer, who has you carried to safety — battered, unhealed, and needing real care.")
		else:
			_party_wipe_healer_city_id = "ubersreik"
			_add_notice("[b][color=salmon]Your party has fallen![/color][/b] Word reaches a Shallyan Priest in Ubersreik, who has you carried to the Temple of Shallya — battered, unhealed, and needing real care.")
		if xp_awarded_for.size() > 0:
			_add_notice("[color=#c9a04b]Enemies defeated before going down: %d.[/color]" % xp_awarded_for.size())

		## Per the request: losing specifically to the Village Elder
		## quest's own forced idol ambush costs the idol and every
		## coin the player was carrying — the goblins recover their
		## own idol and whatever else was on you. The coin is stashed
		## in the chest (added to anything already stashed there from
		## an earlier loss) rather than simply deleted, and the chest
		## itself is relocked and made lootable again so there's a
		## real way to go try again.
		if GameState.pending_idol_ambush:
			GameState.pending_idol_ambush = false
			if player.inventory.has("Stolen Idol"):
				player.inventory.erase("Stolen Idol")
			GameState.goblin_fort_chest_stashed_bp += player.brass_pennies
			GameState.goblin_fort_chest_stashed_ss += player.silver_shillings
			GameState.goblin_fort_chest_stashed_gc += player.gold_crowns
			var lost_line := "The goblins recover the idol — and every coin you had on you, %d GC %d SS %d BP — before you wake." % [player.gold_crowns, player.silver_shillings, player.brass_pennies]
			player.gold_crowns = 0
			player.silver_shillings = 0
			player.brass_pennies = 0
			GameState.goblin_fort_chest_locked = true
			GameState.goblin_fort_chest_looted = false
			_add_notice("[color=salmon]%s[/color]" % lost_line)

		_log_final_round_condition_summary()

	_clear_conditions_at_battle_end()
	_restore_pre_battle_equipment()
	## Per the follow-up request ("instead of auto picking up loot, i
	## want a new pop up window with the battle report"): shown as the
	## very last step, after Conditions have already been cleared above
	## — so the Battle Report's own Conditions Remaining section (see
	## _rebuild_battle_report_conditions) reflects what's genuinely
	## still left on each character afterward (Critical Wounds, and any
	## Fatigued picked up from Frenzy wearing off), not a mid-fight
	## snapshot that's about to be wiped a moment later anyway.
	_show_battle_report(victory)

## Counterpart to the snapshot taken at the top of _start_encounter():
## puts each party member's main-hand and off-hand back to exactly
## what they were carrying into this fight — a light source (Lantern,
## Storm Lantern, Davrich Lamp, Candle...) that got left "equipped but
## useless" because it doesn't resolve to a real WeaponDefinition, a
## weapon the player manually switched away from mid-battle to
## actually fight with, or an off-hand item a Critical Wound amputation
## result knocked out of their hand, are all quietly put back. The only
## thing that does NOT come back is an item actually destroyed during
## the fight (e.g. the "weapon damaged/destroyed by the impact" fumble
## result) — checked the same way that result itself confirms
## destruction, by whether the item is still in the character's own
## inventory, since a destroyed item is erased from there.
## Un-equipped (i.e. pre-battle "") is always restorable, since there's
## nothing that could have been "destroyed" — bare hands can't break.
func _restore_pre_battle_equipment() -> void:
	for c in _pre_battle_equip.keys():
		if c == null:
			continue
		var snap: Dictionary = _pre_battle_equip[c]
		var pre_weapon: String = snap.get("weapon", "")
		var pre_offhand: String = snap.get("offhand", "")
		if pre_weapon == "" or c.inventory.has(pre_weapon):
			c.equipped_weapon = pre_weapon
		if pre_offhand == "" or c.inventory.has(pre_offhand):
			c.equipped_offhand = pre_offhand
	_pre_battle_equip.clear()

## Per the request: "all conditions except Fatigue should be removed
## at the end of combat as the final resolution" — called as the very
## last step of _end_battle, after the final-round summary has already
## reported what was active during the fight, so nothing is silently
## hidden from that report before it's shown.
##
## "Some conditions cause Fatigue when they are removed" — Frenzy is
## the one this project actually models that way (p.190: "After your
## Frenzy is over you immediately receive a Fatigued condition"), so
## clearing it here at battle end triggers that same real cost, not
## just a silent wipe. Every other Condition is removed outright with
## no such side effect, since none of the others in this project's
## Condition list have a documented "causes Fatigue on removal" rule.
## Real bug fix: this used to only ever touch `player` (whoever last
## acted, per the reassignment in _prompt_player_turn) instead of the
## whole party — an ally who simply wasn't the last to act that round
## kept simulation-only Conditions (e.g. Broken, Entangled) past the
## fight's own end, contradicting this function's own documented "all
## Conditions except Fatigue are removed at combat's end" rule.
## Iterating GameState.party makes that rule actually apply to every
## party member — which the Battle Report's own Conditions Remaining
## section (see _rebuild_battle_report_conditions) now depends on
## being accurate for characters other than whoever swung last.
func _clear_conditions_at_battle_end() -> void:
	for member in GameState.party:
		var had_frenzy := member.conditions.has("Frenzy")
		## Unconscious (p.169): "When you lose the Unconscious Condition,
		## you gain the Prone and Fatigued Conditions" — this project has
		## no other Unconscious-removal path yet (waking mid-combat needs
		## rules this session doesn't have source text for — see the
		## v0.2.434 project doc), so this battle-end clear is currently
		## the only place Unconscious ever actually goes away.
		var had_unconscious := member.conditions.has("Unconscious")
		var fatigued_stacks: int = int(member.conditions.get("Fatigued", 0))
		member.conditions.clear()
		if fatigued_stacks > 0:
			member.conditions["Fatigued"] = fatigued_stacks
		if had_frenzy:
			member.add_condition("Fatigued")
		if had_unconscious:
			member.add_condition("Prone")
			member.add_condition("Fatigued")

## Summarises the most recent Round's Condition ticks for the
## battle-end report specifically — separate from
## _log_round_end_condition_results' own scrolling-log entries (which
## may or may not have already been shown this Round depending on
## timing), so the end-of-battle report always has an explicit,
## consolidated recap rather than relying on the player having
## scrolled past it earlier.
func _log_final_round_condition_summary() -> void:
	var results: Dictionary = encounter.last_round_end_condition_results
	if results.is_empty():
		return
	var lines: Array[String] = []
	for c in results.keys():
		var result: Dictionary = results[c]
		var parts: Array[String] = []
		if result.get("died_from_bleeding", false):
			parts.append("bled out and died")
		if result.get("wounds_lost", 0) > 0:
			parts.append("lost %d Wound(s)" % result["wounds_lost"])
		if result.get("fell_unconscious", false):
			parts.append("fell Unconscious")
		for note in result.get("notes", []):
			parts.append(note)
		if not parts.is_empty():
			lines.append("%s: %s" % [c.character_name, "; ".join(parts)])
	if not lines.is_empty():
		_add_notice("[b]Final Round conditions:[/b] " + " | ".join(lines))

## Exploration mode's own hand-off: a dungeon-hosted fight (see the big
## exploration section above _exit_tree()) resumes the SAME live
## encounter in place instead of leaving the scene the normal way —
## _hosted_by_exploration stays true for the whole visit (both while
## exploring and while mid-fight), so this is checked before falling back
## to the normal "leave the screen entirely" behavior every other
## encounter still uses unchanged.
func _on_return_pressed() -> void:
	## Party-wipe rework, per the request ("If the entire party dies
	## move them from any screen they are on to the Temple of Shallya
	## in Ubersreik (or the healer in Giessingen if they are on the
	## same map as him)"): checked FIRST, ahead of both fallbacks below
	## — a wiped party obviously can't keep exploring the same dungeon
	## (_hosted_by_exploration's own branch), and doesn't belong back
	## on the open map either (the plain Overworld.tscn fallback).
	## Mirrors _do_exit_dungeon()'s own "abandon the in-progress
	## dungeon" bookkeeping when the wipe happened mid-delve, then
	## hands off straight to the healer _end_battle(false) already
	## chose, via the same pending_healer_city_id + direct
	## change_scene_to_file("Healer.tscn") convention
	## CityScreen._enter_temple() already uses.
	if _party_wiped:
		if _hosted_by_exploration:
			GameState.dungeon_state = {}
			## Same "delve is over" reset as _do_exit_dungeon() -- see
			## that function's own comment.
			GameState.dungeon_floor_states = {}
			dungeon_state = {}
		GameState.pending_healer_city_id = _party_wipe_healer_city_id
		GameState.autosave()
		get_tree().change_scene_to_file("res://scenes/Healer.tscn")
		return
	if _hosted_by_exploration:
		_return_to_exploration_after_combat()
		return
	get_tree().change_scene_to_file("res://scenes/Overworld.tscn")

## Instead of the normal "leave the screen" path _on_return_pressed()
## falls back to above: just closes the Battle Report and lets the SAME
## CombatEncounter/turn_order keep going — there was never a second
## "exploration encounter" to hand off to, so resuming is just clearing
## the fight bookkeeping and letting _next_turn() carry on; the very next
## ally turn's _render_turn_action_menu() automatically shows the
## exploration menu again the moment it sees _exploration_mode back to
## true, with zero monsters left in encounter.get_living("adversary").
func _return_to_exploration_after_combat() -> void:
	if _active_combat_room != null:
		_active_combat_room["cleared"] = true
		_persist_room(_active_combat_room)
	_active_combat_room = null
	battle_report_overlay.visible = false
	battle_over = false
	_exploration_mode = true
	## Real bug fix (per the request: "clear combat Advantage when game
	## enters exploration mode after a fight"): the SAME CombatEncounter
	## (and its own advantage_pool) carries straight through from combat
	## back into exploration — see this function's own header comment —
	## so without this, whatever Advantage either side happened to be
	## sitting on on the exact Round combat ended stuck around and
	## quietly carried into the NEXT, entirely unrelated fight further
	## into the dungeon. Advantage (Up in Arms, p.133) is explicitly a
	## per-fight resource, not a running total across separate
	## encounters, so both pools genuinely reset to 0 the moment there's
	## no more combat to spend it in.
	encounter.advantage_pool.ally = 0
	encounter.advantage_pool.adversary = 0
	GameState.dungeon_state = dungeon_state
	GameState.autosave()
	_render_status()
	_next_turn()

## --- Battle Report popup ------------------------------------------------
## Per the follow-up request ("instead of auto picking up loot, i want a
## new pop up window with the battle report... when the player closes
## this window the battle encounter screen should close without further
## prompts"): shown once, from _end_battle(), in place of the old
## "enable the Return button" flow. _loot_entries groups _pending_loot
## (which _generate_loot() now stages instead of auto-adding to
## player.inventory) into one row per distinct item name; each row
## carries its own keep/drop toggle and, once toggled to "keep", the
## party member it's earmarked for (whoever is the currently-selected
## character via the Q/E switcher at the moment it's toggled on — so
## switching character mid-review genuinely lets loot be split across
## more than one party member, not just handed as one lump to whoever
## happens to be selected when Close is pressed).

var _loot_entries: Array[Dictionary] = []   ## [{name, qty, enc_each, keep, assigned_char}]
var _battle_report_selected_char: Character = null

func _show_battle_report(victory: bool) -> void:
	battle_report_title.text = "You Won!" if victory else "You Lost..."
	battle_report_title.add_theme_color_override("font_color", Color(0.6, 0.85, 0.55) if victory else Color(0.85, 0.4, 0.35))

	_build_battle_report_loot_entries()
	_battle_report_selected_char = GameState.party[0] if not GameState.party.is_empty() else player

	_rebuild_battle_report_combatants()
	_rebuild_battle_report_conditions()
	_rebuild_battle_report_loot_grid()
	_update_battle_report_char_switch_label()
	_update_battle_report_gold_found_label()

	battle_report_overlay.visible = true
	if is_instance_valid(battle_report_close_button):
		battle_report_close_button.grab_focus()

	## Per the request ("do not dim the combat log window when the End
	## of Battle Report pop up appears and allow scrolling on the
	## combat log while its the pop up is up too"): BattleReportOverlay's
	## own "Dim" ColorRect covers the entire screen (see FieldEncounter.
	## tscn) since it's a later sibling of OuterVBox -- which is exactly
	## what dims/blocks everything BEHIND the popup, including the
	## combat log over on the right. Pulling history_scroll out to be a
	## later sibling of BattleReportOverlay itself (last child of this
	## root Control) puts it on top of the dim both visually (drawn
	## after it) and for input picking (Godot gives mouse/wheel events
	## to whichever Control is topmost in tree order), while `top_level`
	## keeps it pinned at its own real on-screen rect regardless of its
	## new parent's layout. _on_close_battle_report() puts it right back.
	_pull_history_log_above_dim()

## Captures history_scroll's current on-screen rect, reparents it to be
## the last child of this screen's root Control (after
## battle_report_overlay), and pins it there with `top_level` so it
## keeps rendering at the exact same spot it already occupied inside
## RightCol -- just now drawn (and hit-tested) on top of the dim
## overlay instead of underneath it. A plain opaque backdrop the same
## colour as the scene's own Background is drawn immediately behind it
## (also above the dim) so the log reads as a genuinely undimmed panel,
## not just undimmed text glowing over a still-darkened gap.
func _pull_history_log_above_dim() -> void:
	if not is_instance_valid(history_scroll) or history_scroll.get_parent() == self:
		return   ## already pulled out (e.g. Battle Report reopened without closing first)
	var log_rect := history_scroll.get_global_rect()

	if _history_backdrop == null:
		_history_backdrop = ColorRect.new()
		_history_backdrop.color = Color(0.075, 0.06, 0.045, 1)   ## matches FieldEncounter.tscn's own "Background" ColorRect
		_history_backdrop.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_history_backdrop.top_level = true
	if _history_backdrop.get_parent() != self:
		add_child(_history_backdrop)
	_history_backdrop.global_position = log_rect.position
	_history_backdrop.size = log_rect.size
	_history_backdrop.visible = true
	move_child(_history_backdrop, get_child_count() - 1)

	history_scroll.get_parent().remove_child(history_scroll)
	add_child(history_scroll)
	move_child(history_scroll, get_child_count() - 1)   ## after both battle_report_overlay AND the backdrop
	history_scroll.top_level = true
	history_scroll.global_position = log_rect.position
	history_scroll.size = log_rect.size

## Reverses _pull_history_log_above_dim(): puts history_scroll back as
## RightCol's own last child (its original slot) and lets normal
## VBoxContainer layout take over its position/size again.
func _restore_history_log_to_right_col() -> void:
	if not is_instance_valid(history_scroll) or history_scroll.get_parent() != self:
		return
	remove_child(history_scroll)
	history_scroll.top_level = false
	history_scroll.position = Vector2.ZERO
	right_col.add_child(history_scroll)
	if is_instance_valid(_history_backdrop):
		_history_backdrop.visible = false

## Per the request ("add the amount of gold found to the battle
## report"): summarises this battle's own _battle_gold_found/_silver/
## _brass accumulators (see _generate_loot()'s own comment) into one
## line, e.g. "Gold Found: 4 GC, 12 SS, 8 BP" -- omitting any coin type
## that was 0, and hiding the whole label if nothing was found at all
## (an all-Animal fight, or a fight where every Humanoid happened to
## roll into 0... which can't actually happen since roll is at least
## 1d10, but a fight with zero Humanoid kills is common).
func _update_battle_report_gold_found_label() -> void:
	if not is_instance_valid(battle_report_gold_found_label):
		return
	var parts: Array[String] = []
	if _battle_gold_found > 0:
		parts.append("%d GC" % _battle_gold_found)
	if _battle_silver_found > 0:
		parts.append("%d SS" % _battle_silver_found)
	if _battle_brass_found > 0:
		parts.append("%d BP" % _battle_brass_found)
	if parts.is_empty():
		battle_report_gold_found_label.visible = false
		return
	battle_report_gold_found_label.visible = true
	battle_report_gold_found_label.text = "Gold Found: " + ", ".join(parts)

## Groups the flat, possibly-repeated _pending_loot list (e.g. three
## separate "Uncooked Meat" appends) into one row per distinct item name
## with a real quantity — a "grid... with item name, quantity and Enc
## shown in neat rows" reads one row per item, not one row per unit.
func _build_battle_report_loot_entries() -> void:
	_loot_entries.clear()
	var counts: Dictionary = {}
	var order: Array[String] = []
	for item_name in _pending_loot:
		if not counts.has(item_name):
			counts[item_name] = 0
			order.append(item_name)
		counts[item_name] = int(counts[item_name]) + 1
	for item_name in order:
		_loot_entries.append({
			"name": item_name,
			"qty": counts[item_name],
			"enc_each": _item_enc_lookup(item_name),
			## Per the follow-up request ("set looting default to Drop"):
			## every item now starts at keep_qty 0 (fully dropped) —
			## the player has to actively step the stepper up to pick
			## anything up, the opposite of the old "kept unless you
			## touch it" default.
			"keep_qty": 0,
			"assigned_char": null,
		})

## Mirrors Character.get_current_encumbrance()'s own per-inventory-item
## lookup exactly (item_db only, 0 if absent) — an unequipped weapon or
## armour piece sitting in `inventory` doesn't count toward Enc there
## either (only item_db-registered Trappings do), so this preview never
## shows phantom weight that then doesn't match the Character Menu once
## Close actually adds the item.
func _item_enc_lookup(item_name: String) -> float:
	if GameData == null or GameData.item_db == null:
		return 0.0
	var it: ItemDefinition = GameData.item_db.find_by_name(item_name)
	return it.encumbrance if it != null else 0.0

func _format_enc(value: float) -> String:
	if is_equal_approx(value, roundi(value)):
		return str(roundi(value))
	return "%.1f" % value

func _rebuild_battle_report_combatants() -> void:
	_clear(battle_report_combatants_list)
	if monster_defs.is_empty():
		var lbl := Label.new()
		lbl.text = "None."
		battle_report_combatants_list.add_child(lbl)
		return
	for actor in monster_defs:
		var mdef: MonsterDefinition = monster_defs[actor]
		var status: String
		var color: Color
		if _fled_monsters.has(actor):
			status = "Escaped"
			color = Color(0.85, 0.75, 0.4)
		elif encounter.is_defeated(actor):
			status = "Defeated"
			color = Color(0.75, 0.4, 0.35)
		else:
			## Only reachable on a defeat (the fight ended with this
			## monster neither killed nor fled) — still listed so a
			## losing Battle Report doesn't silently omit who's still
			## standing over you.
			status = "Still standing"
			color = Color(0.7, 0.7, 0.65)
		var lbl := Label.new()
		lbl.text = "%s — %s" % [mdef.monster_name, status]
		lbl.add_theme_color_override("font_color", color)
		battle_report_combatants_list.add_child(lbl)

## Whole-party Conditions/Critical Wounds recap — this runs AFTER
## _clear_conditions_at_battle_end() (see _end_battle), so what's shown
## here is genuinely what's left afterward, matching the request's own
## "conditions remaining on the characters" wording, not a mid-fight
## snapshot of Conditions that are about to be wiped a moment later.
func _rebuild_battle_report_conditions() -> void:
	_clear(battle_report_conditions_list)
	var any_shown := false
	for member in GameState.party:
		var parts: Array[String] = []
		for cond_name in member.conditions.keys():
			var stacks: int = member.conditions[cond_name]
			parts.append("%s x%d" % [cond_name, stacks] if stacks > 1 else cond_name)
		if member.active_critical_wound_count > 0:
			var wound_names: Array[String] = []
			for penalty in member.critical_wound_penalties:
				var wname: String = penalty.get("name", "")
				if wname != "" and not wound_names.has(wname):
					wound_names.append(wname)
			var wound_desc := "%d Critical Wound(s)" % member.active_critical_wound_count
			if not wound_names.is_empty():
				wound_desc += " (%s)" % ", ".join(wound_names)
			parts.append(wound_desc)
		if parts.is_empty():
			continue
		any_shown = true
		var lbl := Label.new()
		lbl.text = "%s: %s" % [member.character_name, ", ".join(parts)]
		lbl.add_theme_color_override("font_color", Color(0.85, 0.55, 0.5))
		battle_report_conditions_list.add_child(lbl)
	if not any_shown:
		var lbl := Label.new()
		lbl.text = "No lasting Critical Wounds or Conditions."
		lbl.add_theme_color_override("font_color", Color(0.6, 0.8, 0.55))
		battle_report_conditions_list.add_child(lbl)

## One row per _loot_entries item — Name / total Qty / Enc (for however
## much is currently picked up) / a -  count/total  + stepper, per the
## follow-up request ("allow pick up less than the full stack, ie 4 of
## the 6 meat") replacing the old single Loot-or-Drop toggle button.
## Stepper floor of 0 (fully dropped, the new default) and ceiling of
## the stack's own total quantity (fully kept) — same "+/- buttons,
## disabled at each bound" idiom as the Career Skill Advance stepper in
## character_creation_screen.gd's own _build_career_skill_row().
func _rebuild_battle_report_loot_grid() -> void:
	_clear(battle_report_loot_grid)
	if _loot_entries.is_empty():
		var lbl := Label.new()
		lbl.text = "No loot this battle."
		battle_report_loot_grid.add_child(lbl)
		return
	for entry in _loot_entries:
		var name_lbl := Label.new()
		name_lbl.text = str(entry["name"])
		battle_report_loot_grid.add_child(name_lbl)

		var total_qty: int = int(entry["qty"])
		var qty_lbl := Label.new()
		qty_lbl.text = "x%d" % total_qty
		battle_report_loot_grid.add_child(qty_lbl)

		var kept_qty: int = int(entry["keep_qty"])
		var enc_lbl := Label.new()
		var total_enc: float = float(entry["enc_each"]) * kept_qty
		enc_lbl.text = "%s Enc" % _format_enc(total_enc)
		enc_lbl.add_theme_color_override("font_color", Color(0.6, 0.8, 0.55) if kept_qty > 0 else Color(0.85, 0.55, 0.5))
		battle_report_loot_grid.add_child(enc_lbl)

		var stepper := HBoxContainer.new()
		stepper.add_theme_constant_override("separation", 4)
		var minus := Button.new()
		minus.text = "-"
		minus.disabled = kept_qty <= 0
		minus.pressed.connect(_adjust_loot_entry_qty.bind(entry, -1))
		stepper.add_child(minus)
		var count_lbl := Label.new()
		count_lbl.text = "%d/%d" % [kept_qty, total_qty]
		count_lbl.custom_minimum_size = Vector2(40, 0)
		count_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		count_lbl.add_theme_color_override("font_color", Color(0.6, 0.8, 0.55) if kept_qty > 0 else Color(0.85, 0.55, 0.5))
		stepper.add_child(count_lbl)
		var plus := Button.new()
		plus.text = "+"
		plus.disabled = kept_qty >= total_qty
		plus.pressed.connect(_adjust_loot_entry_qty.bind(entry, 1))
		stepper.add_child(plus)
		battle_report_loot_grid.add_child(stepper)

## Dictionaries are reference types in GDScript, so mutating `entry`
## here mutates the very same Dictionary sitting inside _loot_entries —
## no separate write-back needed. Clamped to [0, qty] so the stepper
## can never pick up more than the stack actually contains nor go
## negative. Re-stamps assigned_char to whichever character is
## currently selected any time the kept amount goes above 0, mirroring
## the old toggle-button's "assign on Loot" behaviour.
func _adjust_loot_entry_qty(entry: Dictionary, delta: int) -> void:
	var new_qty: int = clampi(int(entry["keep_qty"]) + delta, 0, int(entry["qty"]))
	entry["keep_qty"] = new_qty
	if new_qty > 0:
		entry["assigned_char"] = _battle_report_selected_char
	_rebuild_battle_report_loot_grid()
	_update_battle_report_char_switch_label()

## Per the request: "add character switch (with Q/E hotkey)" — same
## idiom as healer_screen.gd/shop_screen.gd's own Q/E character cycling.
func _battle_report_switch_char(direction: int) -> void:
	if GameState.party.size() <= 1:
		return
	var idx := GameState.party.find(_battle_report_selected_char)
	if idx < 0:
		idx = 0
	idx = posmod(idx + direction, GameState.party.size())
	_battle_report_selected_char = GameState.party[idx]
	_update_battle_report_char_switch_label()

## Mirrors Character.get_encumbrance_penalty()'s own tier thresholds
## (see character.gd), applied to a PROJECTED total (current real Enc
## plus whatever's currently toggled "keep" and earmarked for this
## character) rather than the character's real current Enc — the whole
## point of this label is a live preview of what happens once Close
## actually hands the loot over.
func _projected_encumbrance_tier(current: float, capacity: int) -> String:
	var cap: int = max(capacity, 1)
	if current <= cap:
		return "None"
	elif current <= cap * 2:
		return "Encumbered"
	elif current <= cap * 3:
		return "Heavily Encumbered"
	else:
		return "Overloaded"

## Per the request: "showing current selected char Enc x/x (updated as
## items are picked up, and coloured like the in inventory screen)" —
## same salmon/green convention as character_menu_screen.gd's own
## Encumbrance row.
func _update_battle_report_char_switch_label() -> void:
	if _battle_report_selected_char == null:
		battle_report_char_switch_label.text = "Giving loot to: —"
		return
	var current := _battle_report_selected_char.get_current_encumbrance()
	var pending := 0.0
	for entry in _loot_entries:
		var kept_qty: int = int(entry["keep_qty"])
		if kept_qty <= 0:
			continue
		## An entry that's never been individually adjusted yet has no
		## assigned_char (null) — same "falls back to whoever's
		## currently selected" convention _apply_kept_battle_report_loot()
		## itself uses at Close time, so an item nobody's touched still
		## shows up in whichever character's preview you're currently
		## looking at, rather than silently vanishing from every
		## character's Enc readout until it's explicitly adjusted once.
		var assigned: Character = entry.get("assigned_char")
		if assigned == _battle_report_selected_char or assigned == null:
			pending += float(entry["enc_each"]) * kept_qty
	var capacity := _battle_report_selected_char.get_carrying_capacity()
	var projected := current + pending
	var tier := _projected_encumbrance_tier(projected, capacity)
	battle_report_char_switch_label.text = "Giving loot to: %s — %d / %d" % [_battle_report_selected_char.character_name, roundi(projected), capacity]
	battle_report_char_switch_label.add_theme_color_override("font_color", Color(0.85, 0.55, 0.5) if tier != "None" else Color(0.6, 0.8, 0.55))

## Per the request: "when the player closes this window the battle
## encounter screen should close without further prompts" — applies
## every "keep" item to whichever character it's earmarked for, then
## reuses _on_return_pressed()'s own scene change exactly (no separate
## confirmation).
## Split out from _on_close_battle_report() so the loot-application logic
## can be verified on its own (see battle_report_test.gd) without also
## having to drive the real scene transition below.
func _apply_kept_battle_report_loot() -> void:
	for entry in _loot_entries:
		var kept_qty: int = int(entry["keep_qty"])
		if kept_qty <= 0:
			continue
		var recipient: Character = entry.get("assigned_char")
		if recipient == null:
			recipient = _battle_report_selected_char
		if recipient == null and not GameState.party.is_empty():
			recipient = GameState.party[0]
		if recipient == null:
			continue
		for i in range(kept_qty):
			recipient.inventory.append(str(entry["name"]))
	_pending_loot.clear()
	_loot_entries.clear()

func _on_close_battle_report() -> void:
	_apply_kept_battle_report_loot()
	battle_report_overlay.visible = false
	_restore_history_log_to_right_col()
	_on_return_pressed()

## --- History (roll cards + short notices, newest first) -------------------
## Replaces the old free-form prose log. Every action becomes one entry;
## entries are kept newest-first (prepended) and the whole list is
## rebuilt on each addition — cheap enough for a combat encounter's
## realistic length, and simpler than trying to retroactively "demote"
## an already-built widget's styling.

## `merge_into_latest`: when true, this attack's cards join the most
## recent history entry (appended alongside it) instead of creating a
## brand new one. Needed for Dual Wielder's off-hand strike — without
## this, the off-hand's own _show_attack_cards call would push the
## primary hand's card out of "latest" status and into compact
## rendering, which is exactly the "the SL breakdown isn't showing"
## report: it wasn't missing data, the card just silently became a
## compacted older entry the instant the second strike logged itself.
## Per the request ("add battle map animated attack gfx to Melee/
## Ranged and Magic/Pray rolls"): the single shared hook every melee
## and ranged attack in this whole screen already funnels through —
## _show_attack_cards() itself, called by every one of player attack,
## monster attack, Frenzy, Furious Assault, and Deathblow. `is_ranged`
## and `result` are exactly what battle_grid_view.gd's play_melee_fx/
## play_ranged_fx need: result.hit == false on a melee attack means the
## defender's own Dodge/Parry won the opposed Test (CombatResolver
## .AttackResult's own doc comment calls this "avoids the blow") — the
## "if they defend a shield blocks it" case — while on a ranged attack
## it just means the unopposed shot missed outright. result.wounds_dealt
## is already the real post-mitigation Wounds value (see
## CombatResolver.resolve_*_attack, which sets it to
## max(..., damage - soak)) — exactly "damage (after mitigation)."
## Silently does nothing if either combatant's battle-map square isn't
## known (shouldn't happen mid-combat, but a missing position is a
## reason to skip an animation, not a reason to crash).
func _play_combat_attack_fx(attacker: Character, defender: Character, is_ranged: bool, result: CombatResolver.AttackResult) -> void:
	var atk_sq: Vector2i = battle_positions.get(attacker, Vector2i(-1, -1))
	var def_sq: Vector2i = battle_positions.get(defender, Vector2i(-1, -1))
	if atk_sq == Vector2i(-1, -1) or def_sq == Vector2i(-1, -1):
		return
	var dmg: int = result.wounds_dealt if result.hit else 0
	if is_ranged:
		grid_view.play_ranged_fx(atk_sq, def_sq, result.hit, dmg)
	else:
		grid_view.play_melee_fx(atk_sq, def_sq, not result.hit, dmg)

## Per the same request: single-target damage spell/prayer that
## succeeded (Drain, a magic-missile-flagged spell, a monster's own
## magic missile cast — see each call site). Only ever called once the
## caster has already been confirmed to have actually struck `target`,
## so this always shows as a hit.
func _play_magic_missile_fx(caster: Character, target: Character, wounds: int) -> void:
	var caster_sq: Vector2i = battle_positions.get(caster, Vector2i(-1, -1))
	var target_sq: Vector2i = battle_positions.get(target, Vector2i(-1, -1))
	if caster_sq == Vector2i(-1, -1) or target_sq == Vector2i(-1, -1):
		return
	grid_view.play_magic_missile_fx(caster_sq, target_sq, wounds)

## Per the same request: an AoE spell/prayer (Blast, Twin-tailed Comet,
## Soulfire's own "blasts every enemy") that succeeded — `hits`: Array
## of {"target": Character, "wounds": int}, one explosion per target
## whose battle-map square is known.
func _play_magic_aoe_fx(hits: Array) -> void:
	var squares: Array = []
	for h in hits:
		var sq: Vector2i = battle_positions.get(h["target"], Vector2i(-1, -1))
		if sq != Vector2i(-1, -1):
			squares.append({"square": sq, "damage": h["wounds"]})
	if not squares.is_empty():
		grid_view.play_aoe_explosion_fx(squares)

func _show_attack_cards(attacker: Character, defender: Character, weapon_name: String, result: CombatResolver.AttackResult, merge_into_latest: bool = false) -> void:
	_play_combat_attack_fx(attacker, defender, _weapon_for(attacker).is_ranged, result)
	var cards: Array = []
	var attacker_effects: Array[String] = []
	if result.attacker_test.is_critical:
		attacker_effects.append("Critical!")
	## Per the request: a genuine tie (same SL AND same Target Number —
	## see TestResolver.resolve_opposed()'s own comment) reads as "Tied"
	## rather than a plain miss, and isn't dimmed the way a real loss is.
	if result.is_true_tie:
		attacker_effects.append("Tied")
	var attacker_data := {
		"character_name": attacker.character_name,
		"title": weapon_name,
		"subtitle": "Ranged Attack" if _weapon_for(attacker).is_ranged else "Melee Attack",
		"side": attacker.allegiance,
		"test": result.attacker_test,
		"effects": attacker_effects,
		"dimmed": not result.hit and not result.is_true_tie,   ## the attacker "lost" this opposition if the attack didn't land
	}
	if result.hit:
		attacker_data["hit_location"] = result.hit_location
		attacker_data["damage"] = result.damage
		## Per the request: every damage source listed separately and
		## clearly, not folded into one lump "+ N SL" text string.
		## Per the follow-up request (weapon damage looking "wrong" when
		## it was actually a durability-damaged weapon quietly eating
		## into it): if this specific weapon has taken any of the
		## Character.weapon_damage_taken durability damage tracked by
		## WeaponDefinition.get_weapon_damage(), say so right on the
		## breakdown label instead of leaving the lower number
		## unexplained — this was previously invisible anywhere except a
		## one-time combat-log line at the moment it happened.
		var attacker_weapon: WeaponDefinition = weapons.get(attacker)
		var weapon_dmg_reduction := 0
		if attacker_weapon != null and not attacker_weapon.is_indestructible:
			weapon_dmg_reduction = int(attacker.weapon_damage_taken.get(weapon_name, 0))
		var weapon_breakdown_name := "Weapon (damaged -%d)" % weapon_dmg_reduction if weapon_dmg_reduction > 0 else "Weapon"
		var breakdown: Array = [{"name": weapon_breakdown_name, "amount": result.weapon_damage}]
		breakdown.append({"name": "SL", "amount": result.damage_sl_used})
		if result.impact_bonus > 0:
			breakdown.append({"name": "Impact", "amount": result.impact_bonus})
		if result.talent_damage_bonus > 0:
			breakdown.append({"name": result.talent_damage_source, "amount": result.talent_damage_bonus})
			attacker_effects.append("+%d Damage from %s" % [result.talent_damage_bonus, result.talent_damage_source])
		if result.active_buff_bonus > 0:
			breakdown.append({"name": "Buff", "amount": result.active_buff_bonus})
		## Ammunition (p.294): whichever ammo type actually fired this
		## shot, named directly (e.g. "Elf Arrow", "Lead Bullet") rather
		## than a generic "Ammo" label, same as every other source here.
		if result.ammo_damage_bonus > 0:
			breakdown.append({"name": result.ammo_name, "amount": result.ammo_damage_bonus})
		attacker_data["damage_breakdown"] = breakdown
		if result.size_damage_multiplier > 1:
			attacker_data["damage_multiplier"] = result.size_damage_multiplier
	cards.append(attacker_data)

	var defender_data: Dictionary = {}
	if result.defender_test != null:
		var defender_effects: Array[String] = []
		if result.reversal_used:
			defender_effects.append("Reversal! Steals 1 Advantage instead")
		if result.is_true_tie:
			defender_effects.append("Tied")
		elif not result.hit:
			defender_effects.append("Avoids the blow")
		## Per the follow-up request's own clarification: the real
		## Riposte Talent deals real weapon damage back to the attacker
		## on a successful Parry — a genuinely separate effect from the
		## doubles-based counter-strike below, gated by actually having
		## the Talent and by its own per-Round usage limit.
		if result.riposte_talent_triggered:
			defender_effects.append("Riposte! %d Wound(s) to %s" % [result.riposte_talent_wounds_dealt, attacker.character_name])
		## Per the follow-up request: renamed away from "Riposte" — that's
		## a real, separate Talent with its own distinct trigger (any
		## successful Parry) and effect (bonus to a follow-up attack),
		## not this doubles-triggered counter-hit available to everyone.
		if result.critical_parry_counter_triggered:
			defender_effects.append("Critical Parry — Counter-Strike!")
		if not result.defender_fumble.is_empty():
			defender_effects.append("Fumbled Parry!")
		defender_data = {
			"character_name": defender.character_name,
			"title": "Defence",
			"subtitle": "Opposed Test",
			"side": defender.allegiance,
			"test": result.defender_test,
			"effects": defender_effects,
			"dimmed": result.hit,   ## the defender "lost" this opposition if the attack landed
		}
		cards.append(defender_data)

	## Per the request: the actual post-soak Wounds dealt now lives on
	## the roll card itself instead of only the plain-text notice below
	## it — on the defender's own Defence card for an opposed (melee)
	## roll, since that's the card representing what happened to them;
	## on the attacker's own card for an unopposed (ranged) roll, since
	## there's no separate defender card there at all.
	if result.hit:
		var mitigated: int = max(0, result.damage - result.wounds_dealt)
		var hit_entry := {"name": defender.character_name, "wounds": result.wounds_dealt, "mitigated": mitigated}
		if not defender_data.is_empty():
			defender_data["targets_hit"] = [hit_entry]
		else:
			attacker_data["targets_hit"] = [hit_entry]

	var notice := "%s attacks %s with a %s." % [attacker.character_name, defender.character_name, weapon_name]
	## Per the request ("replace crit and fumble text in the combat log
	## with their own type of roll card"): a Critical Wound or a Fumble
	## (Oops! Table) used to be folded into this plain-text notice
	## line — now each gets its own dedicated card, appended to `cards`
	## right alongside the attacker/defender roll cards, styled like
	## the reference sheet (a red header, the actual rolled number
	## boxed, the table result's name/flavor text). The notice line
	## keeps only the plain "who attacked whom" framing.
	if result.is_true_tie:
		notice = "%s Blade and guard meet dead even — nothing happens." % notice
	elif not result.hit:
		notice = "%s %s avoids the blow." % [notice, defender.character_name]
	## Flaming Sword of Rhuin (Lore of Fire): "setting anyone it cuts
	## alight" — matched by the enchanted blade's own name (see
	## _apply_cast_spell_outcome's own "Flaming Sword of Rhuin" branch)
	## rather than a dedicated flag, so this fires automatically for
	## EVERY attack that actually used the enchanted weapon, whatever
	## path delivered it (a normal Attack, Charge, Frenzy's free
	## attack, Furious Assault, Deathblow — every one of them already
	## passes this exact weapon's own name straight through as
	## `weapon_name`, with at most a " (Something)" suffix appended,
	## hence begins_with rather than an exact match). Only a genuine
	## landed hit sets anyone alight — same "not just an opposed roll
	## win, an actual connect" gate every other on-hit effect in this
	## file already uses — and only if the hit didn't just finish the
	## target off outright (same convention as every other Condition-
	## on-hit spell here, e.g. Steal Life/T'Essla's Arc above).
	if result.hit and weapon_name.begins_with("Flaming Sword of Rhuin") and not encounter.is_defeated(defender):
		defender.add_condition("Ablaze", 1)
		notice += " %s catches Ablaze!" % defender.character_name
	## Sigmar's Fiery Hammer (p.226): "any target struck receives the
	## Ablaze and Prone Conditions" — same "landed hit, target not
	## already defeated" gate as Flaming Sword of Rhuin just above.
	## Unlike Flaming Sword's fixed rename, this Miracle's own renamed
	## clone (see _apply_prayer_buff_effect(), "Sigmar's Fiery Hammer
	## (1H)"/"(2H)") no longer contains "Warhammer" in its shortened
	## name, so the gate checks for either the plain real weapon's name
	## OR the renamed clone's — plus the attacker currently having the
	## buff active (same two conditions Character.
	## get_active_damage_bonus(weapon) already checks for the
	## Damage-bonus half of this Miracle, kept in sync here for the
	## Condition half).
	if result.hit and (weapon_name.contains("Warhammer") or weapon_name.begins_with("Sigmar's Fiery Hammer")) and attacker.has_active_buff("Sigmar's Fiery Hammer") and not encounter.is_defeated(defender):
		defender.add_condition("Ablaze", 1)
		defender.add_condition("Prone", 1)
		notice += " %s catches Ablaze and is knocked Prone!" % defender.character_name
	## Per the latest request ("critical and fumble roll cards should
	## always display after the attack/defence roll cards, not before"):
	## a Critical Wound/Fumble card is APPENDED to `cards`, after the
	## attacker/defender roll cards already appended above — since the
	## row renders left-to-right in insertion order, this puts the
	## crit/fumble banner last (trailing) instead of ahead of the plain
	## roll cards that actually caused it.
	if result.caused_critical_wound:
		## Per the follow-up request: "wounds" here MUST be the Critical
		## Wound table's own separate "Wounds" column (already applied to
		## the defender by the time this runs — see
		## critical_wound_extra_wounds's own comment on AttackResult), not
		## the normal opposed-hit damage (result.wounds_dealt) shown
		## moments earlier on the Defence card above — those are two
		## different wound totals from two different tables, and reusing
		## the hit's own number here was a real bug (the Defence card's
		## "Wolf 2: 15 Wound(s)" and this card's own "Wounds" ended up
		## showing the identical, wrong figure). "hide_wounds" suppresses
		## the row entirely — per the request, when the target was
		## already at 0 Wounds before this hit, the table's Wounds column
		## is meaningless (only whether they're now unconscious or dead
		## matters); a Death-tier result is the same story, since "Death"
		## isn't a Wounds count at all.
		cards.append({
			"kind": "critical_wound", "character_name": defender.character_name,
			"roll": result.critical_wound_roll, "overkill_bonus": result.critical_wound_overkill_bonus,
			"location": result.critical_wound_location, "name": result.critical_wound_entry.get("name", ""),
			"flavor": result.critical_wound_entry.get("flavor", ""), "wounds": result.critical_wound_extra_wounds,
			"hide_wounds": result.critical_wound_target_already_down or result.critical_wound_causes_death,
		})
	if not result.fumble.is_empty():
		cards.append({
			"kind": "fumble", "character_name": attacker.character_name,
			"roll": result.fumble.get("roll", 0), "text": result.fumble.get("text", ""),
		})
	## Per the request: the defender's own Parry fumble is a real, separate
	## mishap from the attacker's own fumble above — shown regardless of
	## whether the attack itself landed, since a botched Parry attempt
	## is its own consequence either way.
	if not result.defender_fumble.is_empty():
		cards.append({
			"kind": "fumble", "character_name": defender.character_name,
			"roll": result.defender_fumble.get("roll", 0), "text": result.defender_fumble.get("text", ""),
		})
	## Per the follow-up request: a critical Parry counter-strike is its own
	## real, separate consequence too — a genuine counter-hit and
	## Critical Wound landed back on the attacker, shown regardless of
	## whether their own original attack happened to land. Named
	## "counter-strike," not "riposte" — Riposte is a real, separate
	## Talent (bonus to a follow-up attack after ANY successful Parry),
	## not this doubles-triggered effect available to everyone.
	if result.critical_parry_counter_triggered:
		notice += " %s's Parry becomes a counter-strike — %d Wound(s) to %s!" % [
			defender.character_name, result.critical_parry_counter_wounds_dealt, attacker.character_name,
		]
		## Same fix as the critical_wound card above — the counter-strike's
		## own Critical Wound table Wounds column
		## (critical_parry_counter_extra_wounds), not the flat 1-Wound
		## counter-hit itself (critical_parry_counter_wounds_dealt, which
		## the notice text above already reports on its own terms).
		cards.append({
			"kind": "critical_wound", "character_name": attacker.character_name,
			"roll": result.critical_parry_counter_wound_roll, "overkill_bonus": 0,
			"location": result.critical_parry_counter_wound_location,
			"name": result.critical_parry_counter_wound_entry.get("name", ""),
			"flavor": result.critical_parry_counter_wound_entry.get("flavor", ""),
			"wounds": result.critical_parry_counter_extra_wounds,
			"hide_wounds": result.critical_parry_counter_target_already_down or result.critical_parry_counter_causes_death,
		})
	## Blackpowder (p.297): fires whether or not the shot itself hit —
	## the report of the gun going off is what rattles the target.
	if result.blackpowder_cool_test != null:
		if result.blackpowder_broken_applied:
			notice += " %s is rattled by the gunshot and fails their nerve — Broken!" % defender.character_name
		else:
			notice += " %s keeps their nerve against the gunshot." % defender.character_name
	## Entangle/Distract (p.298): only meaningful on an actual hit.
	if result.hit and result.entangle_applied:
		notice += " %s is entangled!" % defender.character_name
	if result.hit and result.distract_applied:
		notice += " %s is knocked back, stunned by the blow, but takes no real damage." % defender.character_name
	## Blast (Rating) (p.297): every splashed character gets its own
	## line — wounds have already been applied by the resolver by the
	## time this runs (see combat_resolver.gd's _apply_hit).
	for blast_entry in result.blast_hits:
		var blast_char: Character = blast_entry.get("character")
		if blast_char != null:
			notice += " The blast also catches %s for %d Wound(s)!" % [blast_char.character_name, blast_entry.get("wounds_dealt", 0)]
	## Trap Blade (p.298): a Critical Parry against a bladed weapon with
	## Trap Blade runs an Opposed Strength Test instead of the normal
	## doubles counter-hit — describe how that exchange went.
	if result.trap_blade_triggered:
		if result.trap_blade_disarmed:
			if result.trap_blade_weapon_destroyed:
				notice += " Trap Blade! %s wrenches the weapon from %s's grip and it's destroyed in the struggle!" % [defender.character_name, attacker.character_name]
			else:
				notice += " Trap Blade! %s disarms %s!" % [defender.character_name, attacker.character_name]
		else:
			notice += " Trap Blade! %s tries to wrench the weapon free, but %s holds on." % [defender.character_name, attacker.character_name]
	if merge_into_latest and not history.is_empty():
		_merge_into_latest_entry(cards, notice)
	else:
		_add_history_entry(cards, notice)

	## Per the request: float this exchange's own SL outcome between the
	## Attacker/Defender boxes — only when there was a real opposed
	## Defence test (a Dodge/Parry roll actually made against it), not
	## an unopposed ranged shot at a flat Target Number.
	if result.defender_test != null:
		_record_opposed_sl_result(attacker, result.attacker_test, result.hit, defender, result.defender_test, not result.hit)
	else:
		_clear_opposed_sl_result()

## `targets_hit`: optional list of {name, wounds, mitigated} dicts — per
## the request, an AoE spell/prayer's actual per-target Wounds now live
## structured on the card itself (see RollCardBuilder.build_roll_card),
## same as a normal weapon attack's, rather than only as a joined
## sentence buried in `effects`. Empty for the many non-damage callers
## of this function (Assess, Heal Self, Intimidate, buffs, ...).
## `damage_data`: optional {"damage": int, "damage_breakdown": Array,
## "damage_multiplier": int} — same boxed "5+13=18" Damage row a weapon
## attack card gets (see _show_attack_cards), for a spell/prayer that
## rolls or computes its own Damage (Twin-tailed Comet's 1d10+SL,
## Soulfire's 1d10, a magic missile's Spell+WB, ...). Empty for callers
## with no Damage of their own.
## Returns the card's own `data` dict (by reference) so a caller that
## needs to revise it later — Overcasting folding a bonus into an
## already-shown card — can mutate it in place and re-render, the same
## pattern already used for `effects` before this change.
func _show_single_card(actor: Character, title: String, subtitle: String, side: String,
		test: TestResolver.TestResult, effects: Array, merge_into_latest: bool = false, targets_hit: Array = [], damage_data: Dictionary = {}) -> Dictionary:
	var data := {
		"character_name": actor.character_name,
		"title": title,
		"subtitle": subtitle,
		"side": side,
		"test": test,
		"effects": effects,
	}
	if not targets_hit.is_empty():
		data["targets_hit"] = targets_hit
	for key in damage_data:
		data[key] = damage_data[key]
	## Per the request: the plain-text notice line that used to sit right
	## below the card was pure duplication — every piece of it (actor,
	## title, and each effect) is already rendered on the card itself, so
	## it only ever repeated what the player could already read. Left as
	## an empty notice (rather than removing the parameter from
	## _add_history_entry/_merge_into_latest_entry) so their shared
	## (cards, notice) shape doesn't need a single-card special case.
	if merge_into_latest and not history.is_empty():
		_merge_into_latest_entry([data], "")
	else:
		_add_history_entry([data], "")
	return data

func _show_opposed_action_cards(actor: Character, opponent: Character, action_name: String,
		result: GroupAdvantageActions.ActionResult, merge_into_latest: bool = false) -> void:
	## Defensive fix: spend_batter/spend_trick (group_advantage_actions.gd)
	## return an incomplete ActionResult — opposed_test/opponent_test
	## both still null — when the Advantage spend itself fails (not
	## enough Advantage to even attempt the action). Every real caller
	## already guarantees Advantage is available before calling either
	## (the player's own Batter/Trick buttons only show when there's
	## enough; _do_monster_turn checks pool.get_pool("adversary") >= 1
	## first), so this shouldn't currently be reachable — but building
	## cards from a null test would crash (roll_card_builder.gd reading
	## a null test's target_modifiers) rather than just doing nothing,
	## which is a far worse failure mode if anything ever does reach
	## this without that guarantee. Log why and stop instead.
	if not result.success:
		_add_notice(result.text)
		return
	## Per the request: a genuine tie (same SL AND same Target Number —
	## see TestResolver.resolve_opposed()'s own comment) reads as "Tied"
	## on both cards, neither dimmed, rather than the binary Won/Lost
	## that fits every other outcome.
	var actor_effect := "Won" if result.attacker_won else ("Tied" if result.is_true_tie else "Lost")
	var cards: Array = []
	var actor_data := {
		"character_name": actor.character_name,
		"title": action_name,
		"subtitle": "Opposed Test",
		"side": actor.allegiance,
		"test": result.opposed_test,
		"effects": [actor_effect] as Array[String],
		"dimmed": not result.attacker_won and not result.is_true_tie,
	}
	cards.append(actor_data)
	var opp_data := {
		"character_name": opponent.character_name,
		"title": "Resist",
		"subtitle": "Opposed Test",
		"side": opponent.allegiance,
		"test": result.opponent_test,
		"effects": [] as Array[String],
		"dimmed": result.attacker_won,
	}
	cards.append(opp_data)
	if merge_into_latest and not history.is_empty():
		_merge_into_latest_entry(cards, result.text)
	else:
		_add_history_entry(cards, result.text)

	## Per the request: float this opposed action's own SL outcome
	## between the Attacker/Defender boxes too, same as a weapon attack.
	_record_opposed_sl_result(actor, result.opposed_test, result.attacker_won, opponent, result.opponent_test, not result.attacker_won)

## Clarifies exactly when and why Advantage changed, right in the log,
## rather than leaving the player to notice the pool number moved.
func _note_advantage_change(side: String, before: int, source: String) -> void:
	var after := encounter.advantage_pool.get_pool(side)
	if after == before:
		return
	var who := "Ally" if side == "ally" else "Adversary"
	if after > before:
		_add_notice("[color=#8fbf6a]%s Advantage +%d (%d → %d) from %s.[/color]" % [who, after - before, before, after, source])
	else:
		_add_notice("[color=salmon]%s Advantage %d (%d → %d) from %s.[/color]" % [who, after - before, before, after, source])

## Applies a Miscast's real mechanical effects to `character` (Condition
## stacks, Corruption points, direct Wounds, save-or-suffer Tests) and
## returns a single combined description — the table's flavour text
## plus what actually happened, rather than the flavour text alone.
func _apply_and_describe_miscast(character: Character, miscast: Dictionary) -> String:
	if miscast.is_empty():
		return ""
	var applied := MagicResolver.apply_miscast_tags(character, miscast.get("tags", []))
	var line: String = miscast.get("text", "")
	if not applied.is_empty():
		line += " (" + " ".join(applied) + ")"
	## A Miscast can be one of the sources that pushes Corruption Points
	## over the Corruption Threshold — check after every application,
	## same as the Dark Deal path in _offer_fortune_spend.
	var mutation_notice := CorruptionResolver.check_and_apply_threshold(character)
	if mutation_notice != "":
		line += "\n" + mutation_notice
		_refresh_player_display()
	return line

func _add_notice(text: String) -> void:
	_add_history_entry([], text)

## Builds a fresh entry's ordered segment list: a cards-row segment
## (if any cards) followed by a notice-line segment (if any text) —
## the same cards-then-notice order every non-merged entry has always
## rendered in. See `history`'s own comment for why this is now an
## ordered list rather than two fixed fields.
func _build_segments(cards: Array, notice: String) -> Array:
	var segments: Array = []
	if not cards.is_empty():
		segments.append({"kind": "cards", "cards": cards})
	if notice != "":
		segments.append({"kind": "notice", "text": notice})
	return segments

func _add_history_entry(cards: Array, notice: String) -> void:
	history.push_front({"segments": _build_segments(cards, notice)})
	if history.size() > MAX_HISTORY_ENTRIES:
		history.resize(MAX_HISTORY_ENTRIES)
	_rebuild_history_display()

## Appends to the current newest entry rather than pushing a new one —
## keeps a multi-strike action (Dual Wielder's off-hand follow-up), or
## a Fortune-spend notice immediately followed by its own reroll's
## cards, as one still-latest, still-fully-rendered entry instead of
## bumping the previous content into compact mode the instant the next
## bit logs. Appends new segments onto the end of the existing list —
## see `history`'s own comment on why this (not a fixed cards-then-
## notice pair) is what actually gets the ordering right.
func _merge_into_latest_entry(cards: Array, notice: String) -> void:
	var latest: Dictionary = history[0]
	var segments: Array = latest.get("segments", [])
	segments.append_array(_build_segments(cards, notice))
	latest["segments"] = segments
	history[0] = latest
	_rebuild_history_display()

func _rebuild_history_display() -> void:
	_clear(history_list)
	## Per the request: rendered oldest-first, newest-last — a normal
	## scrolling log, not newest-on-top. history[] itself still stores
	## newest at index 0 internally (unchanged, other code still reads
	## history[0] as "the latest entry"); only the render order and the
	## is_latest check below are flipped to match the new layout.
	for i in range(history.size() - 1, -1, -1):
		var entry: Dictionary = history[i]
		var is_latest := i == 0
		var entry_box := VBoxContainer.new()
		entry_box.add_theme_constant_override("separation", 4)

		## Per the request ("move the green spent fortune to reroll text
		## in the combat log to before the actual rerolled test"):
		## segments render in the exact order they were actually added
		## (see `history`'s own comment) — a cards-row segment for each
		## "cards" entry, a text label for each "notice" entry,
		## interleaved in real chronological order, rather than every
		## entry's cards unconditionally rendering above its notice
		## regardless of which was logged first.
		var segments: Array = entry.get("segments", [])
		for segment in segments:
			if segment.get("kind", "") == "cards":
				var row := HFlowContainer.new()
				row.add_theme_constant_override("h_separation", 10)
				row.add_theme_constant_override("v_separation", 10)
				## Per the request: the newest card and historic cards are now
				## the same (compact) size — RollCardBuilder.build_roll_card's
				## `compact` only affects sizing, never content, so this no
				## longer trades detail for size the way `not is_latest` used
				## to (every historic entry showed a stripped-down card before).
				## Per the follow-up request ("make all combat log roll card
				## 20% bigger"): COMBAT_LOG_CARD_SCALE is passed as every
				## card builder's own `size_scale` — see roll_card_builder.gd's
				## class-level comment for why this only grows THIS log's own
				## (always-compact) cards, not every other screen's compact
				## cards.
				for card_data in segment.get("cards", []):
					var kind: String = card_data.get("kind", "")
					if kind == "critical_wound":
						row.add_child(RollCardBuilder.build_critical_wound_card(card_data, true, COMBAT_LOG_CARD_SCALE))
					elif kind == "fumble":
						row.add_child(RollCardBuilder.build_fumble_card(card_data, true, COMBAT_LOG_CARD_SCALE))
					else:
						row.add_child(RollCardBuilder.build_roll_card(card_data, true, COMBAT_LOG_CARD_SCALE))
				entry_box.add_child(row)
			else:   ## "notice"
				var notice_label := RichTextLabel.new()
				notice_label.bbcode_enabled = true
				notice_label.fit_content = true
				notice_label.scroll_active = false
				notice_label.text = str(segment.get("text", ""))
				## Per the request ("make combat log text font 20% smaller"):
				## COMBAT_LOG_NOTICE_FONT_LATEST/HISTORIC are the original
				## 18/15 sizes scaled to 80% (rounded) — see their own
				## declarations near the top of this file.
				notice_label.add_theme_font_size_override("normal_font_size", COMBAT_LOG_NOTICE_FONT_LATEST if is_latest else COMBAT_LOG_NOTICE_FONT_HISTORIC)
				if not is_latest:
					notice_label.modulate = Color(0.6, 0.6, 0.6)
				entry_box.add_child(notice_label)

		## Per the request: "Spend Fortune: +1 SL"/"Spend Fortune: Reroll"
		## (or "Dark Deal: Reroll") render right here — after this whole
		## entry's own content (its roll card(s) and any notice text
		## logged so far). Only ever populated for the latest entry, the
		## one _offer_fortune_spend is currently prompting on. Neither a
		## "Continue" nor an "Act Again" button among them any more (per
		## the two follow-up requests) — Enter, and
		## _render_fortune_prompt_turn_preview()'s own End Turn/Move
		## buttons down in the action-menu area, both already decline
		## this prompt just as well; see _offer_fortune_spend's own
		## comment. Act Again itself now lives as a permanent sidebar
		## button instead (see _prompt_player_turn()).
		if is_latest and not _pending_fortune_options.is_empty():
			var fortune_row := HFlowContainer.new()
			fortune_row.add_theme_constant_override("h_separation", 8)
			fortune_row.add_theme_constant_override("v_separation", 8)
			for opt in _pending_fortune_options:
				var btn := _make_button()
				btn.text = opt["text"]
				btn.pressed.connect(opt["callback"])
				fortune_row.add_child(btn)
			entry_box.add_child(fortune_row)

		## Careful Strike (p.134): its own separate, NON-blocking row of
		## "Move to X" buttons — see _present_careful_strike_choice.
		## Rendered alongside the Spend Fortune row above (both can be up
		## on the same entry at once) rather than sharing its list, since
		## this one never gates anything the way Fortune's own
		## awaiting_fortune_choice loop does.
		if is_latest and not _pending_careful_strike_options.is_empty():
			var careful_strike_row := HFlowContainer.new()
			careful_strike_row.add_theme_constant_override("h_separation", 8)
			careful_strike_row.add_theme_constant_override("v_separation", 8)
			for opt in _pending_careful_strike_options:
				var btn2 := _make_button()
				btn2.text = opt["text"]
				btn2.pressed.connect(opt["callback"])
				careful_strike_row.add_child(btn2)
			entry_box.add_child(careful_strike_row)

		if not is_latest:
			entry_box.modulate = Color(0.65, 0.65, 0.65)
		history_list.add_child(entry_box)
		## Per the request ("continue buttons in the combat log should
		## auto-focus without needing WASD pressed first"): real bug fix
		## — this used to call _auto_focus_default_button() back up at
		## the point fortune_row was built, but entry_box (and the
		## Continue button inside it) hadn't been added to history_list
		## yet at that point, so grab_focus() was being called on a
		## Control that wasn't inside the SceneTree yet — Godot silently
		## no-ops that, so the button never actually took focus until the
		## player's first WASD press triggered _unhandled_input's own
		## fallback focus grab. Moved here, after history_list.add_child
		## (entry_box) just above, so the button genuinely is in the tree
		## by the time grab_focus() runs.
		if is_latest and not _pending_fortune_options.is_empty():
			_auto_focus_default_button()
		if i > 0:
			history_list.add_child(HSeparator.new())
	_scroll_history_to_bottom()

## Per the request: the log should always focus on the newest entry,
## now at the bottom, without the player needing to scroll manually.
## The real fix is history_list.sort_children (connected in _ready)
## firing this directly and reliably once layout genuinely settles;
## this manual call is a redundant safety net for cases where
## sort_children might not fire on its own.
func _scroll_history_to_bottom() -> void:
	_do_scroll_history_to_bottom()

func _do_scroll_history_to_bottom() -> void:
	if is_instance_valid(history_scroll) and history_list.get_child_count() > 0:
		history_scroll.ensure_control_visible(history_list.get_child(history_list.get_child_count() - 1))
		history_scroll.scroll_vertical = int(history_scroll.get_v_scroll_bar().max_value)

## --- Status / hotkeys / misc ------------------------------------------

func _turn_order_string() -> String:
	var parts: Array[String] = []
	for c in encounter.turn_order:
		var score: int = encounter._initiative_scores.get(c, 0)
		parts.append("%s (%d)" % [c.character_name, score])
	return " → ".join(parts)

## Per the request ("allow player to move over dead monsters, and...
## actually remove monster immediately when they die"): a defeated
## MONSTER (adversary side only — an ally stays on the map even at 0
## Wounds, per the party-wipe rework's own "left at 0 Wounds, not
## removed from the party or teleported" behaviour, so this deliberately
## never touches battle_positions for an ally) is erased from
## battle_positions the instant its own kill has already been fully
## processed. Reuses xp_awarded_for as the dedup signal rather than a
## bare wounds_current <= 0 check: xp_awarded_for is only ever appended
## by _check_for_kill_xp() once a kill has genuinely finished resolving
## (loot/XP/quest-progress already applied), which is also the exact
## point every attack-resolution code path is done reading
## battle_positions[target] for its own FX (hit markers, damage
## numbers, attack-line drawing) — erasing any earlier (e.g. inline
## inside _check_for_kill_xp itself, which runs mid-resolution) risked
## pulling the rug out from under that still-in-flight FX code. Called
## from the very top of _render_status(), which — per that function's
## own header comment — already runs after essentially every state-
## changing action, so this reads as "immediate" to the player (the
## very next redraw shows the corpse gone) while staying safely after
## everything that still needed the position.
##
## Vacates the square right away for movement (BattleGrid._occupied_
## squares_excluding() reads straight from battle_positions, so a
## culled monster's old square is just open ground the instant this
## runs — no separate "let the player walk through a corpse" exception
## needed anywhere else) and removes its token from the very next
## grid_view.set_state() push in _render_turn_order_panel() below (it
## builds icons/names/positions straight from battle_positions too) —
## no separate "hide dead tokens" logic needed, they're just gone.
## Loot/XP/Battle Report tracking (xp_awarded_for, _battle_loot_log)
## are entirely unaffected: both are independent of battle_positions
## and already fully recorded by the time this runs.
func _cull_dead_monsters_from_map() -> void:
	if battle_positions.is_empty() or xp_awarded_for.is_empty():
		return
	var dead: Array = []
	for c in battle_positions:
		if c.allegiance != "ally" and xp_awarded_for.has(c):
			dead.append(c)
	for c in dead:
		battle_positions.erase(c)

func _render_status() -> void:
	_cull_dead_monsters_from_map()
	## Drilled (p.141) Bonus Tests gate — refreshed here (called after
	## essentially every state-changing action, including Move) so the
	## flag reflects CURRENT position by the time any Melee Test actually
	## resolves, rather than being stale from the start of the Turn.
	_refresh_drilled_adjacency()
	var lines: Array[String] = []
	lines.append("[b]Round %d[/b]" % encounter.round_number)
	## Per the request: right-aligned and stacked (Ally above Adversary)
	## rather than one left-aligned "Ally Adv: X   Adversary Adv: Y" line —
	## [right]...[/right] keeps both lines right-aligned as a single block
	## even with the newline between them.
	lines.append("[right]Ally Adv: %d\nAdversary Adv: %d[/right]" % [
		encounter.advantage_pool.get_pool("ally"), encounter.advantage_pool.get_pool("adversary")
	])
	## Per the follow-up request ("move blessing buff count to same place
	## as the Light spell counter and show it all the time its active"):
	## the old "Active: X (Y)" line that used to live here (reading only
	## player.active_buffs) has moved to _render_turn_order_panel(),
	## pinned alongside the Light spell's own row — see that function's
	## own comment for why this is also a real fix, not just a move.
	status_label.text = "\n".join(lines)
	_refresh_enemy_display()
	_refresh_player_display()
	_render_turn_order_panel()

## Per the request: moves the "Press [Space] to continue" / Fortune-
## spend / bonus-action prompts from plain text in the combat log
## (RightCol) to real clickable Buttons in the action button area
## (target_container, LeftCol) — consistent with every other choice
## in this screen, which are all real buttons there already. The
## keyboard shortcuts (Enter/F/R/1/2) still work exactly as before,
## completely unchanged — these buttons are an additional way to make
## the same choice, not a replacement for the hotkeys. `options` is a
## list of {"text": String, "callback": Callable} — each callback
## just needs to set the same state the matching hotkey already sets.
func _show_choice_buttons(options: Array) -> void:
	_clear(target_container)
	var row := HFlowContainer.new()
	row.add_theme_constant_override("h_separation", 8)
	row.add_theme_constant_override("v_separation", 8)
	for opt in options:
		var btn := _make_button()
		btn.text = opt["text"]
		btn.pressed.connect(opt["callback"])
		## "Continue" is always what Enter itself triggers for whichever
		## awaiting_* choice is currently open (see _unhandled_input) —
		## tracked here, generically, so the very first WASD press can
		## default focus onto it (or onto Frenzy/Furious Assault's own
		## Continue-equivalent), matching every other primary-hotkey
		## button's own _active_primary_hotkey_button tracking.
		if opt["text"] == "Continue":
			_active_primary_hotkey_button = btn
		row.add_child(btn)
	target_container.add_child(row)
	_auto_focus_default_button()

func _clear(container: Node) -> void:
	for child in container.get_children():
		child.queue_free()

## Fortune Points (p.170's "Spending Fortune"): "Reroll a failed Test"
## or "Add +1 SL to a Test after it is rolled" — the third book option
## (act first in the Round, ignoring Initiative) isn't offered here,
## out of scope for this pass. Returns "reroll", "sl", or "" (declined/
## no Fortune to spend) — the caller applies "reroll" itself (each Test
## type needs its own re-roll call), while "" and "sl" need no further
## action from the caller beyond what's already been done here (the SL
## bump is applied directly to `test` before returning, since every
## caller wants that same behaviour).
## Combines the "Press [Space] to continue" prompt with the option to
## spend a Fortune Point, per the request — one single prompt after
## every combat roll instead of two separate steps, with [F]/[R] shown
## as hotkeys directly in the message rather than as buttons. [R] to
## Reroll only appears (and only works) when the Test actually failed,
## matching the book's own restriction on when a Reroll is meaningful.
## Callers no longer need a separate _wait_for_continue() after their
## Fortune loop ends — the final call here (the one that returns "",
## meaning the player pressed the primary hotkey — Enter, per the
## Enter/Space swap) already served as that wait.
## `target_defeated`, per the request: true when this specific attack
## just defeated its own target — spending Fortune on a Test that
## already ended in a kill has nothing left to meaningfully affect
## (more SL doesn't matter to an already-dead target, and rerolling
## risks undoing a good kill for no upside), so the Spend Fortune
## options are skipped here the same way `fight_still_active` already
## skips them once every adversary is dead.
## `suppress_act_again` is now a legacy no-op, kept only so every
## existing call site's own argument list still lines up — Act Again
## no longer comes from this function at all (see `own_turn` below and
## _prompt_player_turn()'s permanent sidebar button). Originally: a
## Deathblow (and any chained follow-up Deathblows), Dual Wielder's
## off-hand strike, and Frenzy/Furious Assault all needed first
## priority over Act Again, so the main attack flow passed true here to
## withhold it until that whole chain had actually finished — the
## sidebar button's own `awaiting_player_target` gating now enforces
## exactly that, for every caller, without needing this flag at all.
## `own_turn`, per the follow-up request ("don't leave the action-menu
## area blank while this prompts"): true for the player's own turn
## (the default — attacking, casting, sprinting, etc.), where
## _render_fortune_prompt_turn_preview() previews the real End Turn/
## Move buttons in target_container while this prompt is up. False for
## a reactive Defence roll against someone else's attack (see
## _resolve_player_defense) — there's no "rest of my own turn" to
## preview there at all.
## Per the request: a Dark Deal — a further, Corruption-costing chance
## to reroll — is offered "after Fortune reroll fails (ie. in its
## place) or if not Fortune is available, as a final chance at
## rerolling." Both cases collapse to the same rule here: once this
## reroll chain either has no Fortune left to spend on it, or has
## already spent Fortune on one reroll that also failed, the plain
## "Spend Fortune: Reroll" option stops being offered and "Dark Deal:
## Reroll" takes its place instead — and Dark Deal itself is offered
## at most once per chain ("final chance"), tracked by
## _reroll_used_this_fortune_chain/_dark_deal_used_this_fortune_chain.
## _fortune_chain_active (reset below) is what lets this function tell
## "a fresh action's first prompt" apart from "the same chain calling
## back in after a reroll" without every call site needing to say so
## explicitly — every exit from this function's own reroll loop below
## returns something other than "reroll"/"sl", which is exactly when
## the chain is considered over.
## `already_won`: per the request — for an OPPOSED Test, `test.success`
## (the player's own half of the opposition, raw) can be false while the
## player still won the exchange outright (e.g. rolled 50 against a
## target of 45 — a raw failure — but the opponent's own Test came out
## even worse, so the player's Success Levels were still higher). Reroll
## and Dark Deal exist to turn a loss into a win; if the exchange is
## already won, spending a Fortune Point (or worse, taking Corruption)
## on either one has no possible upside and a real chance of undoing an
## already-landed hit/successful defence for nothing — so both are
## withheld whenever the caller reports the exchange as already won,
## regardless of what the raw `test.success` says. +1 SL is unaffected
## (still strictly beneficial — a bigger win, never a smaller one).
## Every non-opposed call site simply leaves this at its default
## (false), matching the exact behaviour before this parameter existed.
## Careful Strike (p.134): "You may modify your Hit Location result by
## up to +/-10 per time you have this Talent" — offered right here in
## the combat log the moment a qualifying hit lands (see the call site
## in _on_player_attack), as one "Move to X" button per OTHER location
## reachable via the Talent's own +/-10-per-rank shift. Per the
## request, this is deliberately NOT a blocking prompt and there's no
## "Keep" option — doing nothing (or anything else: spending Fortune,
## Moving, Ending Turn, Act Again...) simply leaves the hit where it
## naturally landed. Reuses the exact same "row of buttons on the
## latest log entry" rendering _offer_fortune_spend's own prompt uses
## (see _rebuild_history_display), in its own _pending_careful_strike_
## options list so the two rows can render side by side on the same
## entry rather than one clobbering the other.
func _present_careful_strike_choice(natural_location: String, alt_locations: Array, relocate_callback: Callable) -> void:
	var options: Array = []
	for loc in alt_locations:
		options.append({"text": "Careful Strike: Move to %s" % loc, "callback": _on_careful_strike_location_clicked.bind(loc, relocate_callback)})
	_pending_careful_strike_options = options
	_rebuild_history_display()

## A single click both retires the offer (so it can't be double-spent,
## and so the buttons vanish on the next render) and runs the caller's
## own relocate logic — see the call site in _on_player_attack for what
## that actually does (undo/redo the hit at the new location).
func _on_careful_strike_location_clicked(location: String, relocate_callback: Callable) -> void:
	_pending_careful_strike_options = []
	_rebuild_history_display()
	relocate_callback.call(location)

func _offer_fortune_spend(test: TestResolver.TestResult, auto_apply_sl: bool = true, target_defeated: bool = false, suppress_act_again: bool = false, already_won: bool = false, own_turn: bool = true) -> String:
	if not _fortune_chain_active:
		_reroll_used_this_fortune_chain = false
		_dark_deal_used_this_fortune_chain = false
	_pending_choice_str = ""
	awaiting_player_target = false
	awaiting_fortune_choice = true
	_fortune_prompt_test = test

	## "Spend Fortune: +1 SL"/"Spend Fortune: Reroll" (or "Dark Deal:
	## Reroll") render as a button row in the combat log, right after
	## the roll card(s) they apply to (see _rebuild_history_display).
	## Neither "Continue" nor "Act Again" is one of these any more — see
	## the next comment, just below, on why.
	var options: Array = []
	## Per the request: once every adversary is already dead, there's
	## nothing left for a Fortune spend or an extra action to
	## meaningfully affect — the roll being offered a boost here was
	## likely the very blow that ended the fight.
	var fight_still_active: bool = not encounter.get_living("adversary").is_empty()
	if player.fortune_points > 0 and fight_still_active and not target_defeated:
		options.append({"text": "Spend Fortune: +1 SL", "callback": func():
			_pending_choice_str = "sl"
			awaiting_fortune_choice = false
		})
	if fight_still_active and not target_defeated and not test.success and not already_won:
		## Bug fix (user correction: "note that Luck add +1 to maximum
		## fortune per lvl, its not separate"): an earlier pass here
		## shipped a wrong reading of the Luck Talent as a free "reroll
		## one failed Test per session" option. The real book text (p.??)
		## is "your maximum Fortune Points now equal your current Fate
		## points plus the number of times you've taken Luck" — a bigger
		## Fortune cap, not a separate reroll currency. See
		## Character.get_max_fortune_points() for where that's actually
		## applied now; there is no standalone Luck option here any more.
		if player.fortune_points > 0 and not _reroll_used_this_fortune_chain:
			options.append({"text": "Spend Fortune: Reroll", "callback": func():
				_pending_choice_str = "reroll"
				awaiting_fortune_choice = false
			})
		elif not _dark_deal_used_this_fortune_chain:
			options.append({"text": "Dark Deal: Reroll\n(1 Corruption)", "callback": func():
				_pending_choice_str = "dark_deal"
				awaiting_fortune_choice = false
			})
	## Per the follow-up request ("move the Act Again button above the
	## Effort buttons, disable until conditions for its usage are met"):
	## Act Again is no longer offered here at all — it's a real,
	## permanent button in the action-menu sidebar now (built in
	## _prompt_player_turn(), right above the Effort row), simply
	## disabled/enabled live rather than surfaced through this or any
	## other transient prompt. `suppress_act_again` accordingly no
	## longer does anything within this function (every call site still
	## passes it, harmlessly, per the existing call signature) — see
	## _prompt_player_turn()'s own comment on why gating Act Again's
	## enabled state on `awaiting_player_target` (only ever true once
	## the WHOLE Action, Deathblow chain and all, is genuinely done)
	## keeps the exact same "never mid-resolution" safety this parameter
	## used to provide by hand, for every caller, for free.

	## Per the follow-up request ("remove all the combat log continue
	## buttons when Spend Fortune/Dark deal are offered... it should
	## simply leave the Spend buttons visible, and if the user does
	## anything else (ie not spend) treat it as if they had clicked
	## continue"): when there's nothing left to spend on, behave exactly
	## as if Continue had already been clicked — same as before. When
	## there IS a real choice, no "Continue" button is rendered any more
	## at all: Enter already resolves this prompt as declined (see
	## _unhandled_input's own awaiting_fortune_choice branch, now routed
	## through _decline_fortune_prompt() below), and — for the player's
	## own turn specifically, not a reactive Defence roll —
	## _render_fortune_prompt_turn_preview() below puts the real
	## upcoming End Turn/Move buttons back in the action-menu area
	## immediately, rather than leaving it blank until this resolves.
	## Clicking either of THOSE only ever declines this prompt too (same
	## as Enter) — it doesn't also End the Turn/start a Move in the same
	## click, so nothing still waiting on this Action (a Deathblow
	## chain, etc.) ever gets skipped out from under it; the genuinely
	## live buttons reappear on their own once the caller's post-Fortune
	## flow reaches _finish_player_action(), same as always.
	if not options.is_empty():
		_pending_fortune_options = options
		## Set BEFORE _rebuild_history_display(), not after — that call
		## is what actually runs _auto_focus_default_button() (once the
		## new log entry's buttons exist in the tree), and that reads
		## _active_primary_hotkey_button to decide what to focus. Setting
		## it here first means the very first render already focuses the
		## right button, rather than only catching up on a later
		## rebuild.
		if own_turn:
			_render_fortune_prompt_turn_preview()
		else:
			## Bug fix (user report: "unable to continue combat with
			## accepting Spend for +1SL for the defence roll, this is the
			## only case where we need to keep the continue button
			## intact"): a reactive Defence-roll prompt has no "rest of my
			## own turn" to preview the way the player's own-turn prompt
			## does just above — there's no Move/End Turn button that
			## could double as a visible decline affordance. Leaving
			## _active_primary_hotkey_button null here (the prior
			## behaviour) meant the ONLY way to decline (not spend the
			## offered Fortune Point) was the invisible Enter/Space
			## hotkey, with no on-screen cue it even existed — this
			## renders one explicit "Continue" button instead, wired to
			## the exact same _decline_fortune_prompt() every other
			## decline path (Enter, the Move/End Turn preview buttons)
			## already uses.
			_render_fortune_prompt_continue_only()
		_rebuild_history_display()
		while awaiting_fortune_choice:
			await get_tree().process_frame
	else:
		awaiting_fortune_choice = false
	_pending_fortune_options = []
	_rebuild_history_display()
	_clear(target_container)
	_fortune_prompt_test = null

	if _pending_choice_str == "sl":
		_fortune_chain_active = true
		player.fortune_points -= 1
		if auto_apply_sl:
			test.success_levels += 1
			test.sl_breakdown.append({"name": "Fortune Point", "amount": 1})
		_add_notice("[color=#8fbf6a]%s spends a Fortune Point: +1 SL (now %+d).[/color]" % [player.character_name, test.success_levels + (0 if auto_apply_sl else 1)])
	elif _pending_choice_str == "reroll":
		_fortune_chain_active = true
		_reroll_used_this_fortune_chain = true
		player.fortune_points -= 1
		_add_notice("[color=#8fbf6a]%s spends a Fortune Point to reroll.[/color]" % player.character_name)
	elif _pending_choice_str == "dark_deal":
		_fortune_chain_active = true
		_reroll_used_this_fortune_chain = true
		_dark_deal_used_this_fortune_chain = true
		player.corruption_points += 1
		_add_notice("[color=#a05a9c]%s makes a Dark Deal with the Ruinous Powers to reroll — gains 1 Corruption point (now %d/%d).[/color]" % [player.character_name, player.corruption_points, player.get_corruption_threshold()])
		var mutation_notice := CorruptionResolver.check_and_apply_threshold(player)
		if mutation_notice != "":
			_add_notice(mutation_notice)
		_refresh_player_display()
		## Normalised to "reroll" so every existing call site's own
		## `while choice == "reroll" or choice == "sl":` loop (unchanged,
		## see each call site) treats a Dark Deal exactly like a Fortune
		## reroll — same redo behaviour, only the cost differs.
		_pending_choice_str = "reroll"
	else:
		_fortune_chain_active = false
	return _pending_choice_str

## Shared by the Enter-key handler in _unhandled_input and the preview
## buttons _render_fortune_prompt_turn_preview() builds below — resolves
## whichever of _offer_fortune_spend's own Spend Fortune/Dark Deal
## prompt (awaiting_fortune_choice) or _wait_for_continue()'s own Act
## Again prompt (awaiting_continue) is currently open as "declined",
## same outcome the removed "Continue" button used to give in either
## case. A no-op if neither prompt is actually open. Both flags are
## checked (never both true at once in practice — see
## _render_fortune_prompt_turn_preview's own comment on why the two
## Act Again entry points can't race) rather than needing the preview
## buttons to know which specific prompt they're currently attached to.
func _decline_fortune_prompt() -> void:
	if awaiting_fortune_choice:
		_pending_choice_str = ""
		awaiting_fortune_choice = false
	if awaiting_continue:
		awaiting_continue = false

## Per the user's own clarification ("clicking act again or a free
## action... should resolve the roll AND execute the selected
## function"): declines whichever prompt is open exactly like
## _decline_fortune_prompt() above, but also queues `action` to actually
## run — see _pending_decline_action's own declaration for why it can't
## just run immediately, and _prompt_player_turn()/_next_turn() for
## where it actually gets consumed (or discarded, if the Turn ends
## before ever reaching a safe moment to fire it).
func _decline_fortune_prompt_and_run(action: Callable) -> void:
	_pending_decline_action = action
	_pending_decline_action_player = player
	_decline_fortune_prompt()

## Per _offer_fortune_spend's own comment: rather than leaving the
## action-menu area blank (or, per the user's own repeated correction —
## "again do not hidden all the other actions buttons, just leave them
## grayed out" — showing only a curated subset) while a Spend Fortune/
## Dark Deal choice is up, this now just renders the exact same menu a
## normal turn would (_render_turn_action_menu(), the shared body every
## call site including the real _prompt_player_turn() uses): Attack/
## Charge/Ranged/Magic/Prayers/Skills all stay visible and correctly
## disabled (action_used_this_turn is already true by the time a roll's
## Fortune prompt can even open — see ACTION_USED_TOOLTIP), while Move/
## End Turn/the Free Action toggles/weapon switches/Act Again stay
## genuinely clickable — that shared body itself checks
## awaiting_fortune_choice per button and routes through
## _decline_fortune_prompt_and_run() (decline this prompt, then run the
## real handler at the first safe moment) instead of the real handler
## directly whenever it's true, so nothing here needs its own duplicate
## copy of that logic any more.
func _render_fortune_prompt_turn_preview() -> void:
	_render_turn_action_menu()

## See _offer_fortune_spend's own comment (the `else` branch, own_turn ==
## false) for why this exists: the reactive-Defence-roll counterpart to
## _render_fortune_prompt_turn_preview() just above, for the one case
## with no "rest of my own turn" to preview at all — a single explicit
## "Continue" button so declining the prompt always has a visible,
## clickable affordance, not just the invisible Enter/Space hotkey.
func _render_fortune_prompt_continue_only() -> void:
	_clear(target_container)
	var continue_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	continue_btn.text = "Continue  [Space]"
	continue_btn.pressed.connect(_decline_fortune_prompt)
	target_container.add_child(continue_btn)
	_active_primary_hotkey_button = continue_btn

## Per the request: Frenzy's free attack and Furious Assault are now
## real player choices, offered as their own prompt only when actually
## eligible — never triggered automatically. Returns "frenzy",
## "furious_assault", or "" (the player chose to skip/continue without
## using either). If only one is available, it's still an offer, not
## an automatic use — the player can always decline.
func _offer_bonus_action_choice(frenzy_available: bool, furious_assault_available: bool) -> String:
	_pending_bonus_action_str = ""
	awaiting_bonus_action_choice = true

	var options: Array = [{"text": "Continue", "callback": func():
		_pending_bonus_action_str = ""
		awaiting_bonus_action_choice = false
	}]
	if frenzy_available:
		options.append({"text": "Frenzy — Free Attack", "callback": func():
			_pending_bonus_action_str = "frenzy"
			awaiting_bonus_action_choice = false
		})
	if furious_assault_available:
		options.append({"text": "Furious Assault — 1 Advantage", "callback": func():
			_pending_bonus_action_str = "furious_assault"
			awaiting_bonus_action_choice = false
		})
	## Per the request: confined to the Attack/Defence column instead of
	## blanking the whole action-menu area (same treatment Overcast's
	## own choice prompt gets, scoped to Magic/Prayers — see
	## _build_scoped_column) — built directly here rather than via the
	## shared _show_choice_buttons(), which every other choice prompt
	## (Continue, Fortune spend) still uses unchanged, full-width.
	##
	## Per the follow-up request ("use the full size of these sections"):
	## `row` is added to `col.get_parent()` (the column's own
	## VBoxContainer wrapper), not to `col` itself (an HFlowContainer) —
	## see _offer_overcasting's matching comment on why nesting inside
	## `col` directly leaves it narrower than the real column width.
	var col := _build_scoped_column("Attack / Defence")
	var row := HFlowContainer.new()
	row.add_theme_constant_override("h_separation", 8)
	row.add_theme_constant_override("v_separation", 8)
	for opt in options:
		var btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		btn.text = opt["text"]
		btn.pressed.connect(opt["callback"])
		row.add_child(btn)
		## See _show_choice_buttons's own identical tracking — Continue
		## is what Enter itself triggers here too.
		if opt["text"] == "Continue":
			_active_primary_hotkey_button = btn
	col.get_parent().add_child(row)
	_auto_focus_default_button()

	while awaiting_bonus_action_choice:
		await get_tree().process_frame
	_clear(target_container)
	return _pending_bonus_action_str

## Frenzy (p.190): "you may take a Free Action Melee Test each Round
## as you are throwing everything you have into your attacks" — a
## genuine bonus attack, not costing the turn or any Advantage.
## Melee only, per the book's own wording. This project doesn't track
## "already used this Round," so if the player attacks more than
## once in a Round (e.g. via Additional Action) each one gets its own
## Frenzy offer — a documented simplification in the generous
## direction, not a strict once-per-Round cap.
## Real bug fix (user report, with a screenshot: "outnumbering bonus and
## other melee action modifiers should be adding to Furious Assault/
## Frenzy attacks too"): this used to only ever pass `outnumbering`
## through to the actual roll (and show it, and only it, in the card's
## own Modifier breakdown) — every other situational modifier that
## genuinely still applies to this exact same attacker, weapon, and
## target this Round (Charging, Fear, Darkness, and an off-hand penalty
## if this weapon is the off-hand) was silently dropped, both from the
## real roll target AND the display, even though the triggering attack
## right before it correctly included all of them. `charge_bonus`/
## `fear_penalty`/`darkness_mod`/`off_hand_penalty` are the exact same
## values `_on_player_attack`'s own main-attack closure already computed
## for this identical situation — passed through here rather than
## recomputed, so there's no risk of the two ever disagreeing. Additional
## Effort is deliberately NOT included — that's a one-time spend the
## player commits to a single specific Test, and (per the pre-existing
## convention every other follow-up attack in this file — Dual Wielder's
## own off-hand swing included — already follows) never carries over to
## a bonus follow-up attack the player didn't separately pay Effort for.
func _execute_frenzy_attack(target: Character, weapon: WeaponDefinition, outnumbering: int, deathblow_budget: Dictionary = {}, charge_bonus: int = 0, fear_penalty: int = 0, darkness_mod: int = 0, off_hand_penalty: int = 0) -> void:
	var wounds_before := target.wounds_current
	var target_square_before: Vector2i = battle_positions.get(target, Vector2i(-1, -1))
	var frenzy_modifier := outnumbering + charge_bonus + fear_penalty + darkness_mod + off_hand_penalty
	var frenzy_result := CombatResolver.resolve_melee_attack(player, target, weapon, encounter.advantage_pool,
		null, "", false, frenzy_modifier, 0, -1, [], 0, [], -1, false, [], encounter.get_living(target.allegiance))
	var frenzy_breakdown: Array = []
	if outnumbering > 0:
		frenzy_breakdown.append({"name": "Outnumbering", "amount": outnumbering})
	if charge_bonus > 0:
		frenzy_breakdown.append({"name": "Charging", "amount": charge_bonus})
	if fear_penalty != 0:
		frenzy_breakdown.append({"name": "Fear", "amount": fear_penalty})
	if darkness_mod != 0:
		frenzy_breakdown.append({"name": "Darkness", "amount": darkness_mod})
	if off_hand_penalty != 0:
		frenzy_breakdown.append({"name": "Off-hand penalty", "amount": off_hand_penalty})
	frenzy_result.attacker_test.target_modifiers = frenzy_breakdown
	_show_attack_cards(player, target, weapon.weapon_name + " (Frenzy — Free Attack)", frenzy_result, true)
	_check_for_kill_xp(target)
	if not deathblow_budget.is_empty():
		await _offer_deathblow_chain(player, weapon, target, wounds_before, frenzy_result.hit, deathblow_budget, target_square_before)

## Furious Assault (Talent, p.1100 of this project's own talent
## data): "once per Round, after hitting in close combat, spend an
## Advantage... to make an extra attack." Per the request, this
## project's combat doesn't track movement, so only the Advantage-
## spend option exists here — the book's own "or your Move"
## alternative is dropped rather than faked. The extra attack's
## own bonus (+10 per Talent rank) is scoped to ONLY this one
## follow-up attack, per the request's own clarification — it
## never applies to the original triggering hit, and never carries
## over to any later attack.
## Real bug fix (user report, with a screenshot: "outnumbering bonus and
## other melee action modifiers should be adding to Furious Assault/
## Frenzy attacks too") — see _execute_frenzy_attack's own identical fix
## just above for the full explanation; this follow-up attack had the
## same gap. `charge_bonus`/`fear_penalty`/`darkness_mod`/
## `off_hand_penalty` are passed straight through from the triggering
## attack's own already-computed values.
func _execute_furious_assault(target: Character, weapon: WeaponDefinition, outnumbering: int, deathblow_budget: Dictionary = {}, charge_bonus: int = 0, fear_penalty: int = 0, darkness_mod: int = 0, off_hand_penalty: int = 0) -> void:
	encounter.advantage_pool.spend("ally", 1)
	player.furious_assault_used_this_round = true
	var furious_rank := player.get_talent_rank("Furious Assault")
	var wounds_before := target.wounds_current
	var target_square_before: Vector2i = battle_positions.get(target, Vector2i(-1, -1))
	## Per the request: Furious Assault grants +1 Success Level per rank
	## of the Talent, NOT a flat +10-per-rank roll-target modifier (i.e.
	## +20 at rank 2) — that used to make the follow-up attack easier to
	## land, but a real +10-per-SL modifier is a much bigger and
	## differently-shaped bonus than "+1 SL," and doesn't match the
	## Talent's own wording. Routed through attacker_extra_sl_breakdown
	## (the same mechanism weapon qualities like Precise/Imprecise
	## already use) rather than attacker_extra_modifier, so it correctly
	## adds Success Levels after a genuine hit — improving Damage and
	## Critical Wound chances — instead of just shifting the number
	## needed to hit.
	var furious_modifier := outnumbering + charge_bonus + fear_penalty + darkness_mod + off_hand_penalty
	var furious_result := CombatResolver.resolve_melee_attack(player, target, weapon, encounter.advantage_pool,
		null, "", false, furious_modifier, 0, -1, [], 0, [], -1, false,
		[{"name": "Furious Assault", "amount": furious_rank}], encounter.get_living(target.allegiance))
	var furious_breakdown: Array = []
	if outnumbering > 0:
		furious_breakdown.append({"name": "Outnumbering", "amount": outnumbering})
	if charge_bonus > 0:
		furious_breakdown.append({"name": "Charging", "amount": charge_bonus})
	if fear_penalty != 0:
		furious_breakdown.append({"name": "Fear", "amount": fear_penalty})
	if darkness_mod != 0:
		furious_breakdown.append({"name": "Darkness", "amount": darkness_mod})
	if off_hand_penalty != 0:
		furious_breakdown.append({"name": "Off-hand penalty", "amount": off_hand_penalty})
	furious_result.attacker_test.target_modifiers = furious_breakdown
	_show_attack_cards(player, target, weapon.weapon_name + " (Furious Assault — 1 Adv)", furious_result, true)
	_check_for_kill_xp(target)
	if not deathblow_budget.is_empty():
		await _offer_deathblow_chain(player, weapon, target, wounds_before, furious_result.hit, deathblow_budget, target_square_before)

## --- Deathblow (Options, p.160) -----------------------------------------
## Adopted as an always-on rule per the request, rather than left as the
## book's own opt-in table variant: "If you kill a melee opponent in a
## single blow, you may move into the space the character occupied and
## attack another opponent if there is one available. You may keep
## doing this a number of times equal to your Weapon Skill Bonus, and
## may not attack the same Character more than once on the same Turn.
## Some creatures... are so big they can activate this rule without
## killing any opponents." That last sentence is the book's own pointer
## to the Size rule (p.341): "all successful strikes against smaller
## targets activate the Deathblow rule even if the target survives" —
## so a Size-larger attacker can chain off ANY successful hit against a
## smaller defender, not only a kill.
##
## Call this once right after every melee hit resolves (main attack,
## Dual Wielder off-hand, Frenzy, Furious Assault, and Deathblow's own
## follow-up hits below — it recurses on itself). `budget` is a
## caller-owned Dictionary ({"used": int, "hit": Array[Character]})
## created once per Action and threaded through every one of those call
## sites unchanged, so the Weapon Skill Bonus cap and the
## never-the-same-Character-twice rule both apply across the WHOLE
## Action's worth of hits, not reset per sub-attack.
##
## Documented simplification: every follow-up hit here (both sides)
## resolves its opposing defense automatically — same as Frenzy/Furious
## Assault/Dual Wielder already do against a monster defender — rather
## than re-entering the full interactive Parry/Dodge prompt
## (_prompt_player_defense) for a second party member on a monster's own
## Deathblow chain. Giving every chained hit against a different ally
## its own real interactive defense choice would mean re-opening that
## whole prompt-and-await cycle per follow-up target; this project's
## existing bonus-attack mechanics already accept the same trade-off
## when the player is the one chaining, so this keeps both directions
## consistent rather than making the monster side the one exception.
## Returns true if a follow-up Deathblow attack actually happened
## (anywhere in the recursion) — callers use this to know whether they
## need to pause for a "Continue" beat before moving on, same as every
## other optional extra content this Action might have shown.
func _offer_deathblow_chain(attacker: Character, weapon: WeaponDefinition, defender: Character, wounds_before: int, hit: bool, budget: Dictionary, defender_square_before_hit: Vector2i) -> bool:
	if weapon.is_ranged:
		return false   ## the book rule is melee-only ("attack another opponent" after closing distance)
	## Per the follow-up request: "kill a melee opponent in a single
	## blow" means genuinely in one blow — the defender has to have
	## been at full health going into this specific hit, not already
	## worn down by earlier hits this fight. A kill that only lands
	## because the target was already at partial Wounds doesn't count,
	## even though it's still the hit that finishes them off. This
	## applies symmetrically to whichever side is attacking (see the
	## function doc above — the same chain serves both the player
	## killing a monster and a monster killing a party member).
	var killed_outright: bool = wounds_before > 0 and wounds_before >= defender.wounds_max and encounter.is_defeated(defender)
	## Size (p.341): a Size-larger attacker qualifies on any successful
	## hit, kill or not — same size_step comparison combat_resolver.gd
	## already uses for the to-hit bonus/damage multiplier/Damaging-
	## Impact grants.
	var size_qualifies: bool = hit and attacker.get_size_step() > defender.get_size_step()
	if not killed_outright and not size_qualifies:
		return false
	var wsb: int = attacker.get_characteristic_bonus("weapon_skill")
	if budget["used"] >= wsb:
		return false
	if battle_grid == null or not battle_positions.has(attacker):
		return false
	## "Move into the space the character occupied" — only meaningful
	## when that space was actually vacated by a kill; for the Size-
	## larger/no-kill case the defender is still standing on it, so the
	## attacker simply strikes again from where it already is. Per the
	## request, stepping into that square is something ONLY an actual
	## Deathblow follow-up attack earns — computed here as a hypothetical
	## `vacated_square` (used only to find candidates within reach of
	## it) rather than applied to battle_positions yet, so a normal kill
	## with nobody left to chain into, or a player who Declines the
	## follow-up below, leaves the attacker exactly where they actually
	## are instead of silently teleporting them into the kill square.
	##
	## Real, confirmed bug fix (user report: "Felix performed 2 deathblow
	## in this fight, but was never moved into his targets square, and
	## now cant reach the last target at all"): this used to read
	## `battle_positions[defender]` directly here — but every caller
	## already calls _check_for_kill_xp(defender) and then _render_status()
	## (which calls _cull_dead_monsters_from_map() from its very top,
	## see dead_monster_removed_from_map_test.gd's own fix) BEFORE this
	## function ever runs, so a genuinely-killed defender was already
	## erased from battle_positions by the time this line executed —
	## will_vacate was false on every single real kill, every time,
	## silently. The chain-attack part still worked (it fell back to
	## searching for candidates near the ATTACKER's own square instead,
	## which happens to still find nearby targets when enemies are
	## clustered together), masking the fact that the actual "move into
	## the vacated square" half of the rule never fired at all. Each
	## caller now snapshots the defender's square BEFORE resolving the
	## hit that might kill them (see wounds_before's own capture point at
	## every call site) and passes it in here as defender_square_before_
	## hit, so this check no longer depends on battle_positions still
	## holding a corpse that a different, later-added feature has every
	## right to have already swept away.
	var vacated_square: Vector2i = battle_positions[attacker]
	var will_vacate: bool = killed_outright and defender_square_before_hit != Vector2i(-1, -1)
	if will_vacate:
		vacated_square = defender_square_before_hit
	var opposite_side: String = "adversary" if attacker.allegiance == "ally" else "ally"
	var candidates: Array[Character] = []
	for c in encounter.get_living(opposite_side):
		if budget["hit"].has(c):
			continue
		if not battle_positions.has(c):
			continue
		if battle_grid.distance_squares(vacated_square, battle_positions[c]) <= 1:
			candidates.append(c)
	if candidates.is_empty():
		return false
	var chosen: Character = await _offer_deathblow_choice(attacker, defender, candidates, killed_outright)
	if chosen == null:
		return false
	## Only now — once a follow-up Deathblow attack is actually
	## happening — does the attacker really step into the vacated
	## square, per the request.
	if will_vacate:
		battle_positions.erase(defender)   ## the space is now open — scoped to Deathblow's own move rather than a general "remove every corpse" change
		battle_positions[attacker] = vacated_square
		_refresh_enemy_display()
		_render_status()
	budget["used"] += 1
	budget["hit"].append(chosen)
	## Real bug fix: this Deathblow follow-up strike is a genuine new
	## melee attack against `chosen` — it needs its own
	## mark_melee_engaged() call same as any other melee attack (see
	## combat_encounter.gd), or `chosen` would never join the attacker's
	## engaged cluster even though a real blow is about to land on them.
	encounter.mark_melee_engaged(attacker, chosen)
	var outnumbering := encounter.get_outnumbering_bonus(attacker, _local_melee_cluster(attacker))
	var next_wounds_before := chosen.wounds_current
	var chosen_square_before: Vector2i = battle_positions.get(chosen, Vector2i(-1, -1))
	var db_result := CombatResolver.resolve_melee_attack(attacker, chosen, weapon, encounter.advantage_pool, null, "", false, outnumbering,
		0, -1, [], 0, [], -1, false, [], encounter.get_living(chosen.allegiance))
	var db_breakdown: Array = []
	if outnumbering > 0:
		db_breakdown.append({"name": "Outnumbering", "amount": outnumbering})
	db_result.attacker_test.target_modifiers = db_breakdown
	_show_attack_cards(attacker, chosen, weapon.weapon_name + " (Deathblow)", db_result, true)
	if attacker.allegiance == "ally":
		_check_for_kill_xp(chosen)
	_refresh_enemy_display()
	_render_status()

	## Per the request ("deathblows should also allow spending fortune to
	## reroll/+1 SL, and dark deal"): a Deathblow follow-up hit used to be
	## the one melee attack in the whole file with no Fortune Point/Dark
	## Deal offer at all — every other real attack roll (the main hit,
	## Dual Wielder's off-hand) already gets one. Scoped to attacker.
	## allegiance == "ally" only: Fortune Points are the human player's
	## own resource, and a MONSTER's Deathblow chain against the party
	## already resolves its follow-up hit fully automatically by this
	## same function's own documented design just above (no interactive
	## defense prompt for the second ally either) — staying consistent
	## with that existing simplification rather than making this one hit
	## type the sole exception on the monster side.
	if attacker.allegiance == "ally":
		## Captured once, before any redo, and threaded back into every
		## reroll below exactly like the main attack's own do_attack()
		## closure — see that closure's own bug-fix comment ("Reroll only
		## affect your own rolls, not the opposing roll"): Fortune is
		## only ever the ATTACKER's resource, so a redo must never also
		## silently re-roll the defender's already-resolved Dodge/Parry.
		var original_db_defender_roll: int = db_result.defender_test.roll if db_result.defender_test != null else -1
		var db_choice := await _offer_fortune_spend(db_result.attacker_test, false, encounter.is_defeated(chosen), true, db_result.hit)
		while db_choice == "reroll" or db_choice == "sl":
			var forced_db_roll: int = -1 if db_choice == "reroll" else _roll_with_plus_one_sl(db_result.attacker_test.roll)
			## Same undo-then-redo pattern as the main attack's own
			## Fortune loop — a redo shouldn't stack Wounds from both
			## attempts.
			if db_result.hit:
				chosen.wounds_current = min(chosen.wounds_max, chosen.wounds_current + db_result.wounds_dealt + db_result.critical_wound_extra_wounds)
			db_result = CombatResolver.resolve_melee_attack(attacker, chosen, weapon, encounter.advantage_pool, null, "", false, outnumbering,
				0, forced_db_roll, [], 0, [], original_db_defender_roll, false, [], encounter.get_living(chosen.allegiance))
			db_result.attacker_test.target_modifiers = db_breakdown
			_show_attack_cards(attacker, chosen, weapon.weapon_name + " (Deathblow)", db_result, true)
			_check_for_kill_xp(chosen)
			_refresh_enemy_display()
			_render_status()
			db_choice = await _offer_fortune_spend(db_result.attacker_test, false, encounter.is_defeated(chosen), true, db_result.hit)

	await _offer_deathblow_chain(attacker, weapon, chosen, next_wounds_before, db_result.hit, budget, chosen_square_before)
	return true

## The choice of which newly-in-range opponent to strike with a
## just-earned Deathblow follow-up — see _offer_deathblow_chain just
## above. A player-controlled attacker gets a real interactive choice
## (or may Decline); a monster attacker never declines a free follow-up
## and just presses the advantage, picking whichever candidate is
## closest to death (without touching monster_focus_target — this is
## an opportunistic follow-up, not a change to the monster's own locked
## focus for the rest of the fight).
func _offer_deathblow_choice(attacker: Character, defender: Character, candidates: Array[Character], killed_outright: bool) -> Character:
	if attacker.allegiance != "ally":
		await get_tree().create_timer(0.4).timeout
		var best: Character = candidates[0]
		var best_frac: float = float(best.wounds_current) / float(maxi(best.wounds_max, 1))
		for c in candidates:
			var frac: float = float(c.wounds_current) / float(maxi(c.wounds_max, 1))
			if frac < best_frac:
				best = c
				best_frac = frac
		return best

	awaiting_deathblow_choice = true
	_pending_deathblow_target = null
	## Per the request: confined to the Attack/Defence column instead of
	## blanking the whole action-menu area (same treatment Overcast's own
	## choice prompt gets — see _build_scoped_column). Font sizes matched
	## to ACTION_COLUMN_FONT_SIZE (the rest of the action menu's own
	## compact size, per the follow-up "resize... so there is no need to
	## scroll" request) so the header and a handful of "Attack <name>
	## (W/W)" buttons fit within this column's own 1/3 width without
	## pushing the panel past its fixed height.
	##
	## Per the further follow-up ("use the full size of these sections"):
	## `vbox` is parented to `col.get_parent()` (the column's own
	## VBoxContainer wrapper), not to `col` itself (an HFlowContainer) —
	## see _offer_overcasting's matching comment. This was the real
	## culprit behind the button row still stacking one-per-line even
	## after the font-size pass above: nested inside `col`, `vbox` was
	## sized to only as much width as its own content's bare minimum,
	## noticeably narrower than the column's actual available width, so
	## "Attack <name> (W/W)" buttons wrapped far sooner than they needed
	## to. Parenting to the wrapper instead lets it inherit the same
	## full-column-width stretching the column's own title label already
	## gets, so 2-3 candidate buttons now sit on one row.
	var col := _build_scoped_column("Attack / Defence")
	var vbox := VBoxContainer.new()
	vbox.add_theme_constant_override("separation", 4)
	col.get_parent().add_child(vbox)
	var header := Label.new()
	header.text = ("Deathblow! %s falls in a single blow — move in and strike another foe?" % defender.character_name) if killed_outright \
		else "Deathblow: %s is too big for %s to stop alone — attack another foe?" % [attacker.character_name, defender.character_name]
	header.autowrap_mode = TextServer.AUTOWRAP_WORD
	header.add_theme_color_override("font_color", Color(0.85, 0.7, 0.35))
	header.add_theme_font_size_override("font_size", ACTION_COLUMN_FONT_SIZE)
	vbox.add_child(header)
	var row := HFlowContainer.new()
	row.add_theme_constant_override("h_separation", 6)
	row.add_theme_constant_override("v_separation", 6)
	for c in candidates:
		var btn := _make_button(ACTION_COLUMN_FONT_SIZE)
		btn.text = "Attack %s (%d/%d)" % [c.character_name, c.wounds_current, c.wounds_max]
		btn.pressed.connect(func():
			_pending_deathblow_target = c
			awaiting_deathblow_choice = false
		)
		row.add_child(btn)
	var decline_btn := _make_button(ACTION_COLUMN_FONT_SIZE)
	decline_btn.text = "Decline  [Enter]"
	decline_btn.pressed.connect(func():
		_pending_deathblow_target = null
		awaiting_deathblow_choice = false
	)
	row.add_child(decline_btn)
	_active_primary_hotkey_button = decline_btn
	vbox.add_child(row)
	_auto_focus_default_button()

	while awaiting_deathblow_choice:
		await get_tree().process_frame
	_clear(target_container)
	return _pending_deathblow_target

## +1 SL is mathematically exactly "reduce the roll by one full decade"
## (TestResolver.resolve()'s own SL formula is purely tens-digit based:
## SL = floor(target/10) - floor(roll/10), so lowering the roll by 10
## always raises SL by exactly 1, with the units digit — and therefore
## which specific roll it "really" was — otherwise unchanged). Used by
## attacks/defence specifically, where SL needs to correctly propagate
## into hit/damage/Critical Wound triggers by feeding back through the
## real resolver rather than just editing success_levels after the fact.
func _roll_with_plus_one_sl(original_roll: int) -> int:
	return max(1, original_roll - 10)

## Applies the Oops! Table's real mechanical effects (Up in Arms
## p.160) for any failed-and-doubles Test in combat. Per the bug
## report ("this combat encounter got stuck after cultist fumbled,
## also noticed it did update his HP from the fumble..") — this used
## to give exactly ONE of the seven possible results
## (weapon_damaged_act_last) a real effect; the other six, including
## the most common band (self_inflicted_wound, "lose 1 Wound... " —
## the one actually rolled in that report) were flavour text only, so
## the stated Wound loss never actually happened. The early-return
## guard was also wrong in a second way: it bailed out of EVERY tag,
## not just the weapon-damage one, whenever the weapon was null or
## indestructible — silently no-op'ing an entire fumble (including its
## Wound loss) for any indestructible-weapon wielder, which covers
## most monster natural weapons (claws, bites, etc.). Both fixed here;
## all seven results now do something.
##
## Per the follow-up request: takes the fumble Dictionary explicitly
## now (rather than always reading result.fumble) so this same
## function can be reused for the DEFENDER's own fumbled Parry
## (result.defender_fumble), not just the attacker's.
func _apply_fumble_effects(actor: Character, weapon: WeaponDefinition, fumble_data: Dictionary) -> void:
	if fumble_data.is_empty():
		return
	var tag: String = fumble_data.get("tag", "")
	match tag:
		"self_inflicted_wound":
			## "lose 1 Wound, ignoring Toughness Bonus and Armour Points"
			## — take_wounds() is the same direct-subtraction helper the
			## Bleeding/Poisoned/Ablaze round-end ticks already use
			## elsewhere in this file, which is exactly "ignoring all
			## modifiers."
			var was_alive := actor.wounds_current > 0
			actor.take_wounds(1)
			_add_notice("[color=#c98a6a]%s catches themselves awkwardly — loses 1 Wound.[/color]" % actor.character_name)
			if was_alive and actor.allegiance == "adversary":
				_check_for_kill_xp(actor)
		"weapon_damaged_act_last":
			if weapon != null and not weapon.is_indestructible:
				var was_carrying := actor.inventory.has(weapon.weapon_name)
				actor.damage_weapon(weapon.weapon_name)
				if was_carrying and not actor.inventory.has(weapon.weapon_name):
					_add_notice("[color=#c98a6a]%s's %s is destroyed by the impact![/color]" % [actor.character_name, weapon.weapon_name])
				else:
					_add_notice("[color=#c98a6a]%s's %s takes damage from the fumble.[/color]" % [actor.character_name, weapon.weapon_name])
			## "...and you act last next round regardless of Initiative":
			## this project's turn order is a single fixed array rolled
			## once at the start of combat (CombatEncounter.roll_initiative)
			## rather than re-rolled/reseated every Round, so there's no
			## cheap per-Round "act last" slot to move this character
			## into without disturbing everyone else's ordering. Left as
			## a documented, narrative-only remainder of this one result.
		"next_action_penalty":
			## "your next Action suffers a -10 penalty" — approximated
			## as a flat -10 to Weapon Skill and Ballistic Skill for the
			## rest of this Round (this project's buff system is
			## Round-scoped, not single-Action-scoped, and the table
			## doesn't specify which Characteristic — WS/BS between them
			## cover the overwhelming majority of "next Actions" that
			## matter in a fight).
			actor.add_timed_buff("Off-Balance (Fumble)", "Oops! Table", {"weapon_skill": -10, "ballistic_skill": -10}, 1)
			_add_notice("[color=#c98a6a]%s is left badly out of position — -10 to their next Action this Round.[/color]" % actor.character_name)
		"lose_next_move", "miss_next_action":
			## "you lose your next Move" / "you miss your next Action
			## entirely" — this project doesn't separately track a
			## partial Move-only or Action-only loss, so both fold into
			## a single Stunned Condition stack, reusing the exact same
			## "cannot Move or Act this Turn" handling (and its own
			## Endurance-Test recovery) every other "skip this Turn"
			## Condition already goes through on both the ally and
			## monster sides.
			actor.add_condition("Stunned", 1)
			_add_notice("[color=#c98a6a]%s stumbles badly — Stunned until they recover.[/color]" % actor.character_name)
		"critical_wound_minor":
			_apply_fumble_critical_wound(actor)
		"hit_random_ally_or_self":
			_apply_fumble_stray_hit(actor, weapon, fumble_data)

## Oops! Table's critical_wound_minor result (81-90): "you overextend
## and wrench something; you suffer a minor Critical Wound." A real
## Critical Wound roll (Up in Arms p.81-86), genuinely "minor" here
## because — unlike a combat hit — there's no overkill bonus pushing
## the roll into the table's nastier upper bands. Applied
## non-interactively (no Accept/Deflect choice, no Fate-spend prompt):
## this is a clumsy self-inflicted mishap, not a blow an opponent
## landed, so the book's armour-deflection option doesn't fit, and
## this shared helper can be reached for an arbitrary actor (an
## un-controlled ally, or a monster) whose turn a modal choice can't
## practically interrupt the way it does for the player's own
## defended hits.
func _apply_fumble_critical_wound(actor: Character) -> void:
	var loc_roll := Dice.d100()
	var location := CombatResolver.get_hit_location(loc_roll)
	var effect_roll := Dice.d100()
	var entry: Dictionary = GameData.critical_wound_db.lookup(location, effect_roll)
	if entry.is_empty():
		return
	var is_painless := actor.has_creature_trait("Painless")
	if not is_painless:
		for cond_name in entry.get("conditions", {}).keys():
			actor.add_condition(cond_name, int(entry["conditions"][cond_name]))
		_apply_critical_wound_test_or_condition(actor, entry)
		_apply_critical_wound_amputation(actor, location, entry.get("amputation", ""))
	var wounds_val: Variant = entry.get("wounds", 0)
	if wounds_val is int:
		actor.take_wounds(int(wounds_val))
	elif wounds_val is String and wounds_val == "Death":
		## A Death-tier result is a Fate Point save (p.173/341) for a
		## character who has one — spent automatically here (no
		## interactive prompt, per this function's own comment above)
		## rather than leaving an arbitrary actor with no chance at all.
		if actor.allegiance == "ally" and actor.fate_points > 0:
			actor.fate_points -= 1
			actor.wounds_current = 1
			_add_notice("[color=#e0b060]%s spends a Fate Point to survive a fumbled, near-fatal mishap![/color]" % actor.character_name)
		else:
			actor.wounds_current = 0
	if not (wounds_val is String and wounds_val == "T"):
		actor.active_critical_wound_count += 1
	_add_notice("[color=#c98a6a]%s suffers a minor Critical Wound (%s): %s.[/color]" % [actor.character_name, location, entry.get("name", "")])
	if actor.allegiance == "adversary":
		_check_for_kill_xp(actor)

## Oops! Table's hit_random_ally_or_self result (91-100): "you badly
## mishandle the attack — it lands on a random ally in range (using
## your roll's units digit as SL), or if none in range, on yourself,
## leaving you Stunned." "Your roll" here reuses this same Oops! Table
## d100 roll's own units digit (fumble_data["roll"]) rather than the
## original attack Test's roll — that original roll isn't threaded
## through to this one shared helper from all of its call sites, and
## reusing the Oops roll is a small, documented simplification (its
## units digit is just as uniformly 0-9 either way) rather than a
## rules change to the SL itself.
func _apply_fumble_stray_hit(actor: Character, weapon: WeaponDefinition, fumble_data: Dictionary) -> void:
	var candidates: Array[Character] = []
	if battle_grid != null and battle_positions.has(actor):
		for ally in encounter.get_living(actor.allegiance):
			if ally == actor or not battle_positions.has(ally):
				continue
			var in_range: bool
			if weapon != null and weapon.is_ranged:
				in_range = BattleGrid.distance_yards(battle_positions[actor], battle_positions[ally]) <= actor.get_effective_weapon_range(weapon)
			else:
				in_range = BattleGrid.footprint_distance(battle_positions[actor], actor.get_footprint_size(), battle_positions[ally], ally.get_footprint_size()) <= 1
			if in_range:
				candidates.append(ally)
	if candidates.is_empty():
		actor.add_condition("Stunned", 1)
		_add_notice("[color=#c98a6a]%s badly mishandles the attack — it lands on no one, leaving %s Stunned.[/color]" % [actor.character_name, actor.character_name])
		return
	var victim: Character = candidates[randi() % candidates.size()]
	var sl: int = fumble_data.get("roll", 0) % 10
	var loc_roll := Dice.d100()
	var location := CombatResolver.get_hit_location(loc_roll)
	var weapon_damage: int = 0
	if weapon != null:
		weapon_damage = weapon.get_weapon_damage(actor)
	var soak := victim.get_characteristic_bonus("toughness") + victim.get_armour_points(location)
	var wounds: int = max(1, weapon_damage + sl - soak)
	var was_alive := victim.wounds_current > 0
	victim.take_wounds(wounds)
	_add_notice("[color=#c98a6a]%s badly mishandles the attack — it lands on %s instead, for %d Wound(s) to the %s![/color]" % [actor.character_name, victim.character_name, wounds, location])
	if was_alive and victim.allegiance == "adversary":
		_check_for_kill_xp(victim)

## Hack Quality (p.298): "Hacking weapons have heavy blades that can
## hack through armour with horrific ease. If you hit an opponent, you
## Damage a struck piece of armour or shield by 1 point as well as
## wounding the target." Only fires on an actual hit, and only if the
## defender has any (destructible) armour at the location actually hit
## — same "pick the piece with the most AP left" rule as Deflection.
func _apply_hack_quality(attacker: Character, weapon: WeaponDefinition, target: Character, result: CombatResolver.AttackResult) -> void:
	if not result.hit or not attacker.get_effective_weapon_qualities(weapon).has("Hack"):
		return
	var piece := target._pick_armour_to_damage(result.hit_location)
	if piece == null:
		return
	var was_equipped := target.equipped_armour.has(piece.armour_name)
	target.damage_armour_piece(piece.armour_name, result.hit_location)
	if was_equipped and not target.equipped_armour.has(piece.armour_name):
		## Per the request: a piece that hits AP 0 is unequipped and
		## marked Broken rather than destroyed outright — see
		## Character.broken_armour.
		_add_notice("[color=#c98a6a]Hack: %s's %s is Broken — unequipped, and can only be sold for salvage now![/color]" % [target.character_name, piece.armour_name])
	else:
		_add_notice("[color=#c98a6a]Hack: %s's %s takes 1 point of Armour Damage.[/color]" % [target.character_name, piece.armour_name])

## Pummel Quality (p.297): "If you score a Head hit with a Pummel
## weapon, attempt an Opposed Strength/Endurance test against the
## struck opponent. If you win the test, your opponent gains a
## Stunned Condition." A real Opposed Test, resolved and logged the
## same way Batter/Trick's opposed actions are.
func _apply_pummel_quality(attacker: Character, weapon: WeaponDefinition, target: Character, result: CombatResolver.AttackResult) -> void:
	if not result.hit or result.hit_location != "Head" or not attacker.get_effective_weapon_qualities(weapon).has("Pummel"):
		return
	var endurance_skill: SkillDefinition = GameData.skill_db.find_by_name("Endurance")
	var attacker_test := TestResolver.resolve_characteristic_test(attacker, "strength")
	var defender_test := TestResolver.resolve_skill_test(target, endurance_skill)
	var opposed := TestResolver.resolve_opposed(attacker_test, defender_test)
	if opposed.attacker_wins:
		target.add_condition("Stunned")
		_add_notice("[color=#c98a6a]Pummel: %s is Stunned by the blow to the head![/color]" % target.character_name)
	elif opposed.is_true_tie:
		_add_notice("[color=#8a8578]Pummel: dead even — %s stays on their feet.[/color]" % target.character_name)
	else:
		_add_notice("[color=#8a8578]Pummel: %s shrugs off the blow.[/color]" % target.character_name)



## player now sets their own pace, pressing the primary hotkey (Enter,
## per the Enter/Space swap — see _setup_wasd_navigation) when they're
## ready to move on, rather than the game auto-advancing after a fixed
## 0.4-0.6s regardless of how fast they're actually reading. Guards
## against a stray double-press: awaiting_continue is cleared the
## instant that key is consumed (see _unhandled_input), so a second
## rapid press before the next card renders just does nothing rather
## than skipping ahead.
##
## Per the request: once the battle is effectively decided — no living
## adversaries (victory) or no living allies (defeat) — this skips the
## wait entirely rather than making the player press the primary
## hotkey one more time first. Every call site already does
## `await _wait_for_continue()`
## immediately followed by `_next_turn()`, which is what actually
## detects the empty side and calls _end_battle() — so this one change
## makes the whole resolution chain fall straight through to the
## battle report and Return button the instant the last enemy (or the
## player) goes down, no matter which code path delivered the killing
## blow.
func _wait_for_continue() -> void:
	if battle_over or encounter.get_living("adversary").is_empty() or encounter.get_living("ally").is_empty():
		continue_prompt_label.visible = false
		return
	awaiting_continue = true
	## Bug fix (user report: clicking Move/End Turn while this prompt
	## (Act Again offered, no plain Continue button shown) was open did
	## nothing at all — the player was forced to spend 4 Advantage on
	## Act Again just to get combat moving again). Root cause: every
	## button _render_turn_action_menu() builds (Move, End Turn, weapon
	## switch, toggles, Disengage, the sidebar Act Again button, ...)
	## already guards on `awaiting_fortune_choice` and routes through
	## _decline_fortune_prompt_and_run() instead of firing its raw
	## handler directly whenever that's true — but none of them also
	## checked this function's own separate awaiting_continue flag, so
	## while ONLY awaiting_continue was open, those buttons connected
	## straight to their raw handlers and never cleared it, leaving the
	## while-loop below stuck forever (only the Act Again button itself,
	## or the invisible Enter hotkey, could actually get out).
	##
	## Per the follow-up request ("Act again should use their continue
	## mechanic" / "move Act Again to the same place Spend SL/Reroll/
	## Dark Deal are"): rather than teaching all those guards a second
	## flag to check, this prompt now also raises awaiting_fortune_choice
	## for its duration, so it's gated the exact same "fortune choice"
	## way Spend Fortune/Dark Deal already are — every one of those
	## guards, and _decline_fortune_prompt() itself (which already
	## clears both flags), already does the right thing for free.
	## awaiting_continue itself is untouched otherwise (still the flag
	## the while-loop below watches, and still what every functional
	## test that simulates "player clicks Continue" pokes directly), so
	## nothing else about this function's contract changes.
	awaiting_fortune_choice = true
	## Per the request: Act Again is still offered here, at turn end,
	## rather than during action selection — it only ever makes sense
	## once the current action has actually resolved. Gated on `player`
	## genuinely being the ally whose turn this was (not a monster's,
	## and not mid-defense), having the 4 Advantage it costs, and not
	## already having used it this turn. A second, always-visible copy
	## of this same button also lives permanently in the action-menu
	## sidebar (see _prompt_player_turn()) — per the follow-up request,
	## this one stays right here in the combat log too, rather than
	## moving out of it.
	##
	## Real bug fix ("player controlling monster" recurrence): the code
	## here only ever checked `player.allegiance == "ally"`, never
	## whether it was ACTUALLY that ally's own Turn — but `player` is a
	## shared, frequently-reassigned variable (see e.g. _monster_attack's
	## own `player = attack_target` when a monster's melee attack targets
	## an ally, or _resolve_monster_free_attack's `player = ally`), and
	## _wait_for_continue() itself is called from plenty of monster-turn
	## code paths too (a monster's ranged attack card, a monster's free
	## attack, ...). Whenever one of those fired while an ally still had
	## 4+ unspent Advantage and hadn't used Act Again yet this Round, this
	## prompt happily offered Act Again — and clicking it called
	## _on_additional_action(), which opens a full, live, interactive
	## action menu for that ally in the middle of the monster's own Turn
	## coroutine (still paused mid-await on the call stack). That's
	## exactly "player controlling monster['s turn]": the ally menu sits
	## on screen, fully clickable, while a monster is nominally acting.
	## encounter.get_current_combatant() is the one reliable "whose Turn
	## is it right now" signal — set once per _next_turn() call and left
	## untouched by every one of `player`'s own mid-turn reassignments —
	## so Act Again is now only ever offered when it's genuinely this
	## same character's own Turn.
	var pool := encounter.advantage_pool
	var offer_act_again: bool = player != null and player.allegiance == "ally" \
		and encounter.get_current_combatant() == player \
		and pool.get_pool("ally") >= 4 and not additional_action_used_this_turn \
		and _can_use_act_again(player)
	_clear(target_container)
	## Per the follow-up request: this Continue/Act Again prompt renders
	## in the combat log too, right after whatever roll/notice it
	## follows — same treatment _offer_fortune_spend's own options row
	## gets, rather than a separate box below the grid. Reuses the exact
	## same _pending_fortune_options + _rebuild_history_display
	## rendering path; only the wait itself still uses this function's
	## own awaiting_continue flag, since there's no Fortune spend
	## involved here.
	## Per the follow-up request ("remove the continue button as you
	## did with fortune spending"): once Act Again is genuinely on
	## offer, "Continue" itself is dropped from the row entirely — same
	## reasoning as _offer_fortune_spend's own Spend Fortune/Dark Deal
	## prompt. Enter still resolves this as declined either way (see
	## _unhandled_input's own awaiting_continue branch, unchanged), and
	## own_turn is always true here (this prompt only ever fires for the
	## player's own turn — offer_act_again requires player.allegiance ==
	## "ally"), so _render_fortune_prompt_turn_preview() puts the real
	## upcoming End Turn/Move buttons back in target_container too,
	## rather than leaving it blank. When Act Again ISN'T on offer (the
	## far more common case — most _wait_for_continue() calls are just a
	## narrative beat, a fumble, a Critical Wound, someone else's turn),
	## this is unchanged: a bare "Continue" button, no preview, exactly
	## as before.
	var options: Array = []
	if offer_act_again:
		options.append({"text": "Act Again (4 Adv)", "callback": func():
			awaiting_continue = false
			awaiting_fortune_choice = false
			## Mirrors _offer_fortune_spend's own former handling of
			## this same choice: _on_additional_action() opens a fresh
			## action menu immediately, but THIS function's own caller
			## is still going to run its own trailing _next_turn()/
			## _finish_player_action() call once this await returns —
			## skip_next_turn_call_once makes that one call a no-op
			## instead of advancing straight past the fresh menu Act
			## Again just built.
			skip_next_turn_call_once = true
			_on_additional_action()
		})
		_render_fortune_prompt_turn_preview()
	else:
		## Per the follow-up request ("change the default continue button
		## to Space" — matching the project's own stated convention that
		## Space is the main way to accept a choice/thought menu): both
		## Enter and Space resolve this prompt, via _unhandled_input's own
		## `if key.keycode == KEY_SPACE:`/`elif awaiting_continue:` branch
		## just above the big Enter block, and its `elif awaiting_continue:`
		## twin under KEY_ENTER — no button focus required for either; this
		## button lives in the combat-log history panel, not
		## target_container, so _auto_focus_default_button()'s own
		## _find_first_focusable(target_container) fallback can never
		## reach it. Space is what the label shows now (every other
		## primary-hotkey button in this screen — Attack "[Enter]", Charge
		## "[Enter]", End Turn "[Enter]" — still shows Enter; this one
		## prompt is a plain acknowledgement rather than a real choice, so
		## it follows the game's general Space-to-accept convention
		## instead).
		options.append({"text": "Continue  [Space]", "callback": func():
			awaiting_continue = false
			awaiting_fortune_choice = false
		})
	_pending_fortune_options = options
	_rebuild_history_display()
	while awaiting_continue:
		await get_tree().process_frame
		if battle_over:
			break
	## Defensive clear of both flags no matter which path got us here
	## (the two callbacks above, _decline_fortune_prompt() via a Move/
	## End Turn/etc. click — which already clears both itself — or a
	## functional test poking awaiting_continue directly): never leave
	## awaiting_fortune_choice stuck true once this prompt is done.
	awaiting_continue = false
	awaiting_fortune_choice = false
	_pending_fortune_options = []
	_rebuild_history_display()
	continue_prompt_label.visible = false

## Same "Continue" gate as _wait_for_continue(), but for the specific
## case of the player's own Action having just resolved, right before
## handing off to _finish_player_action(). Per the original request: a
## bare "Continue" button with nothing else on it — no Act Again offer,
## no extra content above it worth pausing on — isn't worth an extra
## click anymore now that the very next screen (the action menu, now
## mostly greyed out per v0.2.292) already shows an "End Turn [Enter]"
## the player can press right away. Only actually pauses for input
## when Act Again is genuinely on the table (a real decision, not a
## rubber stamp) — mirrors _wait_for_continue()'s own offer_act_again
## condition exactly, so this never offers Act Again in a case the
## normal Continue gate wouldn't have.
func _wait_for_continue_after_own_action() -> void:
	if battle_over or encounter.get_living("adversary").is_empty() or encounter.get_living("ally").is_empty():
		continue_prompt_label.visible = false
		return
	var pool := encounter.advantage_pool
	## Same real-Turn guard as _wait_for_continue()'s own offer_act_again —
	## see that function's comment for why checking `player.allegiance`
	## alone isn't enough.
	var offer_act_again: bool = player != null and player.allegiance == "ally" \
		and encounter.get_current_combatant() == player \
		and pool.get_pool("ally") >= 4 and not additional_action_used_this_turn \
		and _can_use_act_again(player)
	if not offer_act_again:
		return
	await _wait_for_continue()

## Enter: Attack the selected target, or — if currently being asked how
## to defend — resolve whichever defend option (Parry main-hand,
## Parry off-hand, or Dodge) currently has the best real target number
## (same key, whichever applies) — per the follow-up request ("swap
## around all functionality for Enter and Space hotkeys"), this whole
## branch moved here from Space (see _setup_wasd_navigation for the
## matching ui_accept swap).
## Shift: cycle through the Additional Effort spend amounts (2/3/4 Adv).
## WASD: move keyboard focus between the action-menu's own buttons —
## wired up as real InputMap bindings (ui_up/down/left/right) in
## _ready()/_setup_wasd_navigation(), so Godot's own built-in Control
## focus-neighbor system (the same thing arrow keys normally drive)
## does the actual spatial movement; this handler only needs a
## fallback for the very first press, before anything has focus yet
## (see the block just below). Space activates whichever button is
## currently focused — also a built-in behaviour (ui_accept), nothing
## this handler needs to implement; the mirror image of Enter's old
## role, also swapped per the follow-up request. Per the original
## request, this replaced two previous single-purpose uses of W/A/S/D
## that would otherwise have collided with using them for navigation:
## W/S no longer cycle a focused dropdown's own selected item directly
## (open it with Space and use its native popup instead — see
## nav_popup_menu.gd for the same Up/Down/accept pattern there), and
## A/D no longer double as the Act Again and Dual Wield hotkeys (both
## remain available via their own on-screen buttons, now reachable by
## WASD navigation).
func _unhandled_input(event: InputEvent) -> void:
	## Exploration mode (see the big section above _exit_tree()) needs no
	## input handling of its own here at all — it reuses the exact same
	## grid-click Move flow, action-menu buttons (folded into
	## _render_turn_action_menu()'s own "Movement / Free Actions" column),
	## and Space/Enter hotkeys every normal combat turn already uses, so
	## every branch below already works correctly for it unmodified.
	if not event.is_pressed() or event.is_echo():
		return
	if not (event is InputEventKey):
		return
	var key := event as InputEventKey

	## Per the follow-up request ("instead of auto picking up loot, i
	## want a new pop up window with the battle report... character
	## switch (with Q/E hotkey)... when the player closes this window
	## the battle encounter screen should close without further
	## prompts"): intercepted first and unconditionally, ahead of every
	## other branch below (all of which only make sense mid-turn, which
	## is already over by the time this overlay is showing).
	if battle_report_overlay.visible:
		if key.keycode == KEY_Q:
			get_viewport().set_input_as_handled()
			_battle_report_switch_char(-1)
		elif key.keycode == KEY_E:
			get_viewport().set_input_as_handled()
			_battle_report_switch_char(1)
		elif key.keycode == KEY_SPACE or key.keycode == KEY_ENTER:
			## Mark handled BEFORE closing — _on_close_battle_report()
			## ends by changing scene, and this node can already be
			## detached from its viewport by the time execution returns
			## here, same crash this project already hit once for the
			## old Return button's own Space handler (see the comment
			## that used to sit on that branch).
			get_viewport().set_input_as_handled()
			_on_close_battle_report()
		return

	## Per the request ("allow opening Character Menu during dungeon
	## exploring"): same "M" binding (the open_menu action) Overworld
	## uses for its own Character Menu instance. Gated to _exploration_mode
	## only — this is specifically about browsing/equipping while
	## exploring a dungeon's corridors and rooms, not mid-combat-turn,
	## and the whole action-menu/targeting flow below assumes a live
	## combat turn is in progress, which this deliberately stays clear
	## of. Toggles closed again on a second press, same as Overworld's
	## own character_menu.visible check.
	if _exploration_mode and character_menu != null and event.is_action_pressed("open_menu"):
		get_viewport().set_input_as_handled()
		if character_menu.visible:
			character_menu.close()
		else:
			character_menu.open()
		return
	## Same guard Overworld's own _unhandled_input() applies to every one
	## of ITS keybinds while the (same scene's) Character Menu is open —
	## nothing below here is written with "the Character Menu might be
	## open right now" in mind (WASD/Space/Enter all assume a live
	## exploration/combat turn), so leaving this screen's own hotkeys
	## live underneath the menu risked exactly the kind of "keypress
	## leaks through to whatever's behind the menu" bug this project has
	## already hit once for Overworld itself (see character_menu's own
	## declaration comment there).
	##
	## Real bug fix (user report: "the character menu doesn't allow
	## switching character while in exploration mode, fix that"):
	## Overworld's and City's own _unhandled_input() both wire Q/E to
	## character_menu.cycle_displayed_character() whenever their menu is
	## open (see overworld.gd's own Q/E branch) — this screen's Character
	## Menu (opened above via "M" while _exploration_mode is true) never
	## got the same wiring, so with nothing here to catch Q/E before this
	## catch-all "menu's open, ignore every other hotkey" return, the
	## keys did nothing at all rather than switching who's shown.
	if character_menu != null and character_menu.visible:
		if key.keycode == KEY_Q:
			get_viewport().set_input_as_handled()
			character_menu.cycle_displayed_character(-1)
		elif key.keycode == KEY_E:
			get_viewport().set_input_as_handled()
			character_menu.cycle_displayed_character(1)
		return

	## Per the request: the very first WASD press, before any button
	## has keyboard focus yet, has nothing to navigate FROM — Godot's
	## built-in ui_up/down/left/right focus-neighbor system (which is
	## what actually moves focus once something's already focused,
	## triggered earlier in the input pipeline than this handler) is a
	## no-op with no current focus owner and lets the key fall through
	## to here unhandled. Per the follow-up request ("Default WASD
	## focus position on the current space [now Enter] hotkey
	## options"): prefer grabbing focus on whichever button currently
	## carries the "[Enter]" hotkey hint (Attack, Charge, Parry, End
	## Turn, Continue, Skip Overcasting, Cancel Targeting — see
	## _active_primary_hotkey_button) over just "the first button in
	## the tree", since that's the button the player almost certainly
	## wants to act on first. Falls back to the old first-focusable
	## search if there's no such button right now (e.g. mid-Move, where
	## nothing carries the Enter hint).
	if key.keycode == KEY_W or key.keycode == KEY_A or key.keycode == KEY_S or key.keycode == KEY_D:
		if get_viewport().gui_get_focus_owner() == null:
			var first: Control = null
			if is_instance_valid(_active_primary_hotkey_button) and _active_primary_hotkey_button.visible and not _active_primary_hotkey_button.disabled:
				first = _active_primary_hotkey_button
			else:
				first = _find_first_focusable(target_container)
			if first != null:
				get_viewport().set_input_as_handled()
				first.grab_focus()
			return

	## Per the request ("change the default continue button to Space") —
	## matches the project's own stated convention that Space is the
	## main way to accept a choice/thought menu. Every OTHER "Continue
	## [Enter]" button in this screen (_prompt_incapacitated_turn's and
	## _prompt_broken_turn's own pass_btn, _render_fortune_prompt_
	## continue_only's continue_btn) already responds to Space too,
	## for free, via Godot's own built-in ui_accept — each of those sets
	## _active_primary_hotkey_button and is genuinely grab_focus()'d, and
	## Space (unlike Enter — see _setup_wasd_navigation's own removal of
	## Enter/KP Enter from ui_accept) was never stripped from that
	## action. This bare "Continue [Enter]" option is the one exception:
	## _wait_for_continue()'s own comment on it says so directly ("no
	## button focus required") — it lives in the combat-log history
	## panel, not target_container, so _auto_focus_default_button()'s
	## own _find_first_focusable(target_container) fallback can never
	## reach it, and nothing else ever points _active_primary_hotkey_
	## button at it either. Handled explicitly here instead, mirroring
	## the KEY_ENTER branch's own two equivalent cases just below —
	## Enter is left working unchanged for both (no regression), this
	## only adds Space as the newly-displayed, equally-functional way to
	## dismiss either prompt.
	if key.keycode == KEY_SPACE:
		if awaiting_incapacitated_turn:
			get_viewport().set_input_as_handled()
			awaiting_incapacitated_turn = false
			return
		elif awaiting_continue:
			get_viewport().set_input_as_handled()
			awaiting_continue = false
			return

	if key.keycode == KEY_ENTER:
		if awaiting_incapacitated_turn:
			get_viewport().set_input_as_handled()
			awaiting_incapacitated_turn = false
		elif awaiting_overcast_choice:
			get_viewport().set_input_as_handled()
			if is_instance_valid(_active_overcast_skip_button):
				_active_overcast_skip_button.pressed.emit()
		elif awaiting_fortune_choice:
			get_viewport().set_input_as_handled()
			_decline_fortune_prompt()
		elif awaiting_bonus_action_choice:
			get_viewport().set_input_as_handled()
			_pending_bonus_action_str = ""
			awaiting_bonus_action_choice = false
		elif awaiting_continue:
			get_viewport().set_input_as_handled()
			awaiting_continue = false
		elif not pending_defense.is_empty():
			## Real bug fix (per the follow-up request "default the Enter
			## hotkey... [to] the one with the highest target number
			## available to Defend with"): this used to unconditionally
			## resolve Enter as "Parry with the main weapon," regardless
			## of which defend option _prompt_player_defense() actually
			## picked as the best one — so Enter could silently pick a
			## worse option than the one it visibly showed "[Enter]" next
			## to. Dispatches through _active_primary_hotkey_button
			## instead, same generic pattern every other Enter-driven
			## choice prompt in this file already uses.
			get_viewport().set_input_as_handled()
			if is_instance_valid(_active_primary_hotkey_button):
				_active_primary_hotkey_button.pressed.emit()
		elif awaiting_fatal_moment_choice:
			## Real bug fix: this used to share awaiting_player_target
			## with normal attack-target selection — if a target was
			## still selected from earlier in the fight, this key here
			## fell into the "confirm attack" branch below instead,
			## attacking mid-death-decision and crashing. This prompt
			## is deliberately choice-only (click Spend Fate Point or
			## Accept your fate) — Enter just absorbs the key here
			## rather than doing anything.
			get_viewport().set_input_as_handled()
		elif awaiting_critical_wound_choice:
			## Real bug fix (user report: "deflecting on my body Armor
			## from a crit in combat crashed the game"):
			## _handle_critical_wound_on_player()'s Accept/Deflect prompt
			## used to share awaiting_player_target with normal
			## attack-target selection too — same crash shape as
			## awaiting_fatal_moment_choice just above. This prompt is
			## deliberately choice-only (click Accept or Deflect) — Enter
			## just absorbs the key here rather than doing anything.
			get_viewport().set_input_as_handled()
		elif awaiting_resolve_choice:
			## Same fix shape as awaiting_fatal_moment_choice/
			## awaiting_critical_wound_choice just above — this Spend
			## Resolve prompt is also deliberately choice-only (click a
			## specific option or Cancel).
			get_viewport().set_input_as_handled()
		elif aoe_target_mode_active:
			## Bug fix: without this, this key fell through to the
			## Attack branch below whenever a target was already
			## selected from earlier in the fight — attacking
			## mid-targeting instead of doing what the "Cancel
			## Targeting [Enter]" button's own label promises. Same fix
			## shape as the fatal-moment-choice case above.
			get_viewport().set_input_as_handled()
			_exit_aoe_target_mode()
			_prompt_player_turn(false)
		elif ranged_target_mode_active:
			## Same fix shape as aoe_target_mode_active above — without
			## this, Enter would fall through to the "confirm attack"
			## branch below and try to fire straight at selected_target,
			## bypassing the whole point of this mode. Enter here matches
			## the "Cancel Targeting [Enter]" button.
			get_viewport().set_input_as_handled()
			_exit_ranged_target_mode()
			_prompt_player_turn(false)
		## Per the request ("allow targeting of allies, but don't allow
		## offensive actions against them"): guarded the same way
		## _render_turn_action_menu's own `target` is — an ally
		## currently selected on the map reads as "nothing to attack"
		## for this hotkey too, same as selected_target == null already
		## did, rather than falling through to a can_charge/ranged-mode
		## check against a friendly.
		elif awaiting_player_target and selected_target != null and selected_target.allegiance != "ally" and not action_used_this_turn:
			get_viewport().set_input_as_handled()
			var w: WeaponDefinition = _weapon_for(player)
			## Mirrors the Charge button's own gate in _prompt_player_turn
			## — no longer restricted to the Opening Exchange, see that
			## comment and _target_in_charge_range.
			var can_charge := not w.is_ranged and _target_in_charge_range(selected_target)
			if can_charge:
				_on_player_attack(selected_target, null, true)
			elif w.is_ranged:
				## Per the request: Enter mirrors the Attack button's own
				## new behavior for a ranged weapon — opens targeting mode
				## instead of firing straight at selected_target.
				_enter_ranged_target_mode("attack", {"weapon_override": null}, _targets_in_weapon_range(w))
			else:
				_on_player_attack(selected_target)
		## Per the request: once the Action's already spent this Turn,
		## Enter had nothing left to do here — selecting a target and
		## pressing Enter just silently no-opped inside _on_player_attack
		## (which itself bails out on action_used_this_turn). Now falls
		## through to End Turn instead, matching the End Turn button's
		## own "the explicit escape hatch once you're done" role. Not
		## offered mid-Move (the button itself is hidden then too, per
		## _prompt_player_turn) or mid-AoE-targeting (handled above).
		elif awaiting_player_target and action_used_this_turn and not move_mode_active:
			get_viewport().set_input_as_handled()
			_on_end_turn_pressed()

	elif key.keycode == KEY_F:
		## Bug fix: this used to check only `awaiting_fortune_choice`,
		## same as every other hotkey/button here — but now that
		## _wait_for_continue()'s Act-Again/Continue prompt also raises
		## awaiting_fortune_choice (see that function's own comment on
		## why), pressing F while THAT prompt was open — no "Spend
		## Fortune: +1 SL" option actually offered, since only
		## _offer_fortune_spend() ever adds one — would silently clear
		## awaiting_fortune_choice without also clearing awaiting_
		## continue, re-stranding the very while-loop this fix is meant
		## to unstick. Requiring _fortune_prompt_test != null (only ever
		## set while a real _offer_fortune_spend() prompt is up, cleared
		## the moment it resolves) scopes this to that prompt only —
		## mirrors the [R] Reroll hotkey just below, which already
		## guards itself the same way.
		if awaiting_fortune_choice and _fortune_prompt_test != null and player.fortune_points > 0:
			get_viewport().set_input_as_handled()
			_pending_choice_str = "sl"
			awaiting_fortune_choice = false

	elif key.keycode == KEY_R:
		## [R] triggers whichever reroll-shaped option is actually on
		## offer right now — "Spend Fortune: Reroll" first, then
		## "Dark Deal: Reroll" once that's replaced it (see
		## _offer_fortune_spend's own comment on when each applies). Luck
		## no longer has its own reroll option at all — see that
		## function's own bug-fix comment.
		if awaiting_fortune_choice and _fortune_prompt_test != null and not _fortune_prompt_test.success:
			if player.fortune_points > 0 and not _reroll_used_this_fortune_chain:
				get_viewport().set_input_as_handled()
				_pending_choice_str = "reroll"
				awaiting_fortune_choice = false
			elif not _dark_deal_used_this_fortune_chain:
				get_viewport().set_input_as_handled()
				_pending_choice_str = "dark_deal"
				awaiting_fortune_choice = false

	elif key.keycode == KEY_1:
		if awaiting_bonus_action_choice:
			get_viewport().set_input_as_handled()
			_pending_bonus_action_str = "frenzy"
			awaiting_bonus_action_choice = false

	elif key.keycode == KEY_2:
		if awaiting_bonus_action_choice:
			get_viewport().set_input_as_handled()
			_pending_bonus_action_str = "furious_assault"
			awaiting_bonus_action_choice = false

	elif key.keycode == KEY_C:
		if awaiting_player_target and is_instance_valid(_active_cast_button) and not _active_cast_button.disabled:
			get_viewport().set_input_as_handled()
			_active_cast_button.pressed.emit()
		elif awaiting_overcast_choice and is_instance_valid(_active_overcast_confirm_button):
			get_viewport().set_input_as_handled()
			_active_overcast_confirm_button.pressed.emit()

	elif key.keycode == KEY_T:
		if awaiting_player_target and is_instance_valid(_active_pray_button) and not _active_pray_button.disabled:
			get_viewport().set_input_as_handled()
			_active_pray_button.pressed.emit()

	elif key.keycode == KEY_X:
		if awaiting_player_target and is_instance_valid(_active_channel_button) and not _active_channel_button.disabled:
			get_viewport().set_input_as_handled()
			_active_channel_button.pressed.emit()

	elif key.keycode == KEY_SHIFT:
		if not awaiting_player_target:
			return
		var pool := encounter.advantage_pool
		if pending_effort_bonus > 0:
			return   ## already banked — spend it (via Enter/an action) before cycling again
		for spend in [2, 3, 4]:
			if pool.get_pool("ally") >= spend:
				_on_additional_effort(spend)
				get_viewport().set_input_as_handled()
				break

	elif key.keycode == KEY_Z:
		if awaiting_player_target and pending_defense.is_empty() and is_instance_valid(_active_stance_button) and not _active_stance_button.disabled:
			get_viewport().set_input_as_handled()
			_active_stance_button.pressed.emit()
