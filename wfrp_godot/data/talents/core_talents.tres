effect_value = 0
mechanically_parked = true
parked_reason = "Needs Intimidate to actually be an opposed Test -- field_encounter_screen.gd's _on_intimidate() is a solo unopposed roll by the attacker (success alone applies Feared); the target never rolls Cool or anything else to resist, so there's no opposing roll here to add a bonus to."

[sub_resource type="Resource" id="TalentDef_74"]
script = ExtResource("2")
talent_name = "In-fighter"
situation = ""
