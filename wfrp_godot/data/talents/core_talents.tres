parked_reason = "Needs a new Opposed Melee/Melee combat action (target select, weapon-flung effects) -- no such action type exists yet."

[sub_resource type="Resource" id="TalentDef_73"]
script = ExtResource("2")
talent_name = "Iron Will"
situation = ""
