[sub_resource type="Resource" id="TalentDef_9"]
script = ExtResource("2")
talent_name = "Cat-tongued"
situation = ""
situation_options = Array[String]([])
max_mode = "characteristic_bonus"
max_fixed = 1
max_characteristic = "fellowship"
tests = Array[String](["Charm"])
overrides_default_test_effect = true
summary = "Like Ranald the Trickster God, you blend truth and lies as if there were no difference: when using Charm to lie, listeners do not get to oppose your Charm with their Intuition to detect if there is something fishy in what you say. (Data note: wired into Social Combat's own Charm attack -- see SocialEncounterScreen._attempt_social_attack() -- as a fully unopposed roll: this project's Initiative stat already stands in for Intuition on an NPC's Charm defense, so this talent simply skips that defense roll entirely.)"
effect_tags = Array[String](["suppress_intuition_opposition_when_lying"])
effect_value = 0
mechanically_parked = false
parked_reason = ""

[sub_resource type="Resource" id="TalentDef_10"]
