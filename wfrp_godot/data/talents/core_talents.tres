[sub_resource type="Resource" id="TalentDef_71"]
script = ExtResource("2")
talent_name = "Jump Up"
situation = ""
situation_options = Array[String]([])
max_mode = "fixed"
max_fixed = 1
max_characteristic = ""
tests = Array[String]([])
overrides_default_test_effect = true
summary = "Hard to keep down: a Challenging (+0) Athletics Test immediately regains your feet whenever you gain the Prone Condition."
effect_tags = Array[String](["regain_feet_from_prone"])
effect_value = 0
mechanically_parked = true
parked_reason = "Needs a reactive/interrupt system -- the real effect fires the instant Prone is gained, often mid-opponent's-turn (e.g. from a Critical Wound). This project's Character.add_condition() is a bare dictionary setter with no on-condition-gained hook, and standing up (_on_stand_up()) only exists as a normal-turn, Move-costing action with no Test at all -- not the same thing as an immediate reactive recovery."

