[sub_resource type="Resource" id="TalentDef_16"]
script = ExtResource("2")
talent_name = "Field Dressing"
situation = ""
situation_options = Array[String]([])
max_mode = "characteristic_bonus"
max_fixed = 1
max_characteristic = "intelligence"
tests = Array[String](["Heal an ally in combat"])
overrides_default_test_effect = false
summary = "Trained to stabilise the wounded in the heat of battle: gain a bonus to Heal Tests made to treat a companion (not yourself) during combat. This project's Heal action never modelled the book's own \"-20 for lacking proper facilities\" penalty in the first place (it's a flat, no-location-check homebrew action for everyone), so there was nothing left for this Talent to literally waive -- this bonus is the closest on-brand real hook available, same honest treatment as Flagellant's own partially-unmodelled clause. Waking an Unconscious companion mid-battle (\"stabilise a dying companion\") still isn't modelled -- no Condition in this project has a mid-combat wake-up path yet."
effect_tags = Array[String]([])
effect_value = 0
mechanically_parked = false
parked_reason = ""

