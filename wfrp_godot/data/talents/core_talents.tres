[sub_resource type="Resource" id="TalentDef_7"]
script = ExtResource("2")
talent_name = "Magnum Opus"
situation = ""
situation_options = Array[String]([])
max_mode = "fixed"
max_fixed = 1
max_characteristic = ""
tests = Array[String]([])
overrides_default_test_effect = true
summary = "Your life's great work: once completed, a Magnum Opus (a book, invention, or masterpiece) grants a permanent bonus to Tests related to its subject and lasting Fame."
effect_tags = Array[String](["lifework_bonus"])
effect_value = 0
mechanically_parked = true
parked_reason = "Needs an Endeavour/downtime-crafting system -- this project has no Endeavour mechanic at all (every reference in the codebase is a comment naming this exact gap), so there's no 'complete your life's work' process to attach a completion bonus to."

