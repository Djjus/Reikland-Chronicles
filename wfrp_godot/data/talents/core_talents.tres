max_mode = "characteristic_bonus"
max_fixed = 1
max_characteristic = "weapon_skill"
tests = Array[String]([])
overrides_default_test_effect = true
summary = "Skilled at drawing in close to an opponent: suffer no penalty fighting an opponent with a longer weapon (this project's own house-rule -10 for a shorter weapon is waived outright). The book's other clause, \"+10 to hit when using the optional In-Fighting rules,\" has no live trigger to hook into -- the only action that ever set the In-Fighting Condition was removed in v0.2.405, so it's never actually applied to anyone any more; not fabricating a new trigger for a dormant Condition."
