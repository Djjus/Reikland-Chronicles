situations = Array[Dictionary]([{
"combat_monster_names": Array[String](["Gor"]),
"funny_loss_text": "",
"hook": "keeps glancing back the way {subj} came, like {subj} still expects to be followed",
"is_combat": true,
"success_reveal": "\"Beastmen,\" {subj_cap} says finally, voice flat with exhaustion. \"Hit the village three nights back. I ran. Don't know who else did.\" A patrol of the very same warband turns up on the road not an hour later, clearly still hunting stragglers."
}, {
