round1_retry_text = "{subj_cap} hesitates, still not quite convinced, wringing {poss} hands. \"I don't mean to doubt you, only — I can't afford to be wrong about this.\""
round1_final_fail_text = "{subj_cap} pulls back a step, guard rising. \"Perhaps I've made a mistake asking a stranger.\""
round2_skills = Array[String](["Leadership", "Charm", "Gossip", "Intimidate"])
round2_prompt_text = "{subj_cap} is close to trusting you fully now — one more honest word should settle it."
round2_retry_text = "{subj_cap} wavers, torn between desperation and caution, and says nothing for a long moment."
reward_xp = 6
npc_reaction_lines = Array[String](["{poss_cap} hands have finally stopped wringing — {subj}'s actually listening now, not just hoping.", "{subj_cap}'s guard is nearly gone. Whatever {subj}'s been sitting on, it's right at the surface."])
situations = Array[Dictionary]([{
"combat_monster_names": Array[String](["Wolf"]),
"funny_loss_text": "",
"hook": "keeps glancing toward the treeline at the edge of {poss} own field with real dread",
"is_combat": true,
"success_reveal": "\"Something's been at the livestock,\" {subj_cap} admits, \"and it's bold now, bold enough to come right up to the fence line in daylight. I've a family here. I can't fight it and I can't just watch it happen either.\" A wolf's fresh tracks are plainly visible right at the fence."
}, {
"combat_monster_names": Array[String](["Forest Goblin"]),
"funny_loss_text": "",
"hook": "keeps {poss} voice low, glancing back at the farmhouse like {subj} doesn't want to be overheard",
"is_combat": true,
"success_reveal": "\"Goblins,\" {subj_cap} says finally, barely above a whisper. \"Small band, moved into the old quarry past the north field. Taken two sheep already. I've reported it and reported it and nobody's come.\" {subj_cap}'s hands are shaking, more from anger now than fear."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap}'s hands still on the scrap of cloth, and whatever courage it took to almost ask fades out of {obj} entirely. \"Never mind. Forget I said anything,\" {subj} manages, and turns back toward the farmhouse without another word — the boy, wherever he is, goes unlooked-for.",
"hook": "keeps twisting a torn scrap of cloth in {poss} hands the entire conversation",
"is_combat": false,
"success_reveal": "\"My boy went missing three days past,\" {subj_cap} finally manages, voice cracking. \"Found this near the old well and haven't slept since. Reeve won't send anyone for one missing farm boy. Please — even just to look.\" It turns out the boy simply wandered further than usual and is perfectly fine, curled up asleep in a hollow tree half a mile off — but {poss} genuine, unguarded relief at the news is worth more than any reward could be."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} tucks the bills back under their stone, shame plain on {poss} face, and mutters something about not wanting to trouble a stranger with it after all. Whatever word {subj} needed carried to town goes uncarried.",
"hook": "keeps glancing at a stack of unpaid-looking bills tucked under a stone on the windowsill",
"is_combat": false,
"success_reveal": "\"Reeve's doubled the tax again,\" {subj_cap} admits, shame plain on {poss} face. \"I'm not asking for coin, just — if you're passing through town, a word to anyone who'll listen wouldn't go amiss. Nobody believes one farmer alone.\" It's a small thing to promise, and {poss} gratitude for simply being heard is entirely genuine."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} straightens, pride winning out over need, and insists everything's quite fine after all. \"Wasting your time, is all this,\" {subj} says, turning back to the half-tilled field — proud, alone, and no better off than before you stopped.",
"hook": "won't quite meet your eyes when {subj} mentions {poss} own harvest this year",
"is_combat": false,
"success_reveal": "\"Truth is, the harvest failed bad this year,\" {subj_cap} admits, humiliation plain. \"Not asking for charity — asking if you know honest work needs doing anywhere close by. Pride's not worth much when there's mouths to feed.\" {subj_cap}'s dignity through the admission says more about {obj} than the request itself does."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} glances once more at the shuttered farmhouse and decides against asking a stranger to look into it after all. \"It's nothing. Family business, likely,\" {subj} says, unconvinced by {poss} own words — and heads off to check alone, however (un)wisely.",
"hook": "keeps glancing nervously at a neighbouring farmhouse, dark and shuttered",
"is_combat": false,
"success_reveal": "\"Neighbours haven't been seen in four days,\" {subj_cap} says, real worry in {poss} voice. \"Not the sort to just leave without word. I'd check myself, only—\" {subj_cap} gestures helplessly at the child watching from the doorway. It turns out the neighbours simply left early for a family wedding two towns over and forgot to mention it — an anticlimactic, entirely wholesome relief that has {subj_cap} laughing at {obj}self by the end of it."
}])

[sub_resource type="Resource" id="SocialEnc_7"]
