intro_text = "A priest in genuine, well-worn Sigmarite robes stands at a small roadside shrine, hammer symbol held loosely in one hand. {subj_cap} {situation_hook} as {subj} turns to greet you. \"Sigmar's peace upon you, traveller. A moment of your time, if you can spare it?\" {opening_flavor}"
