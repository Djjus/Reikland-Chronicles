round1_final_fail_text = "{subj_cap}'s expression cools, just slightly. \"I see. Perhaps I've misjudged your character.\""
round2_skills = Array[String](["Charm", "Leadership", "Gossip", "Intimidate"])
round2_prompt_text = "{subj_cap} is close to trusting you with the real request now."
round2_retry_text = "{subj_cap} hesitates, weighing something {subj} hasn't said aloud yet."
reward_xp = 7
npc_reaction_lines = Array[String](["{subj_cap} studies you with the particular attention of someone updating a first impression.", "{poss_cap} grip on the hammer symbol has eased — whatever test this was, you're passing it."])
situations = Array[Dictionary]([{
"combat_monster_names": Array[String](["Cultist"]),
"funny_loss_text": "",
"hook": "keeps glancing toward a stretch of forest with real unease, hammer symbol gripped a little tighter",
"is_combat": true,
"success_reveal": "\"There is a taint in those woods,\" {subj_cap} says finally, \"cultists, by the signs I've found. I've prayed on it and I've written to the temple, and I've received neither answer nor aid. If you're willing, I can point you to where I've seen their marks.\" {subj_cap} offers a genuine blessing before you go, and seems to mean every word of it."
}, {
"combat_monster_names": Array[String](["Wolf"]),
"funny_loss_text": "",
"hook": "keeps one hand resting on a fresh grave at the shrine's edge as {subj} speaks",
"is_combat": true,
"success_reveal": "\"A parishioner was taken by wolves on the road not three days past,\" {subj_cap} says, grief plain and unhidden. \"I buried what could be recovered. I would see the pack that did it driven off before it takes another soul under my care.\""
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} follows your eyes to the empty box and simply closes it, faith intact but the request unspoken. \"Sigmar provides in His own time,\" {subj} says, with the tired patience of someone who's said it many times before, and turns back to the shrine.",
"hook": "keeps glancing at the empty collection box with weary, practiced resignation",
"is_combat": false,
"success_reveal": "\"The temple sends less each season,\" {subj_cap} admits, \"and this shrine survives on what little the village can spare, which is less each year besides. I don't ask for coin — only that you carry word of this place, should you meet anyone of means on your travels.\" {subj_cap}'s faith seems entirely undimmed by the hardship, which is its own kind of remarkable."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} glances at the nervous acolyte and decides against involving a stranger after all. \"{subj_cap} has enough to worry over without an audience,\" {subj} says gently, steering you both back toward simple pleasantries.",
"hook": "keeps glancing at a young acolyte hovering nervously nearby, clearly still learning the role",
"is_combat": false,
"success_reveal": "\"My acolyte's first true test of faith is soon,\" {subj_cap} says, warmth plain despite the worry underneath. \"I'd see {obj} face it prepared rather than merely willing. If you've wisdom to share with someone new to the road, {subj}'d be grateful to hear it.\" The acolyte's genuine, wide-eyed gratitude afterward is worth more than the request itself."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} tucks the cloth back over the idol without another word, deciding some questions are best left to Sigmar and not a passing stranger. \"Some things a priest keeps to himself,\" {subj} says, and the subject is plainly closed.",
"hook": "keeps a small, cracked idol half-wrapped in cloth near the shrine's own base",
"is_combat": false,
"success_reveal": "\"Recovered from a ruin some ways east,\" {subj_cap} explains. \"Older than Sigmar's own worship, I think, and I confess I don't know what to do with it — destroy it, study it, or simply leave it be. I'd value a second, less superstitious opinion, if you've one to offer.\" The conversation that follows is genuinely thoughtful, whichever way you lean."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} catches {obj_lc}self and straightens, plainly deciding a stranger isn't who {subj} should be confiding a priest's private worries to. \"Sigmar's peace go with you,\" {subj} says, a touch too formally, and turns back to watching the road alone.",
"hook": "keeps glancing toward the road behind you like {subj}'s expecting someone else entirely",
"is_combat": false,
"success_reveal": "\"Forgive me — I mistook you for someone I'm expecting,\" {subj_cap} admits, faintly embarrassed. \"A witch hunter, sent to investigate troubling rumours from the village. I confess I'm not looking forward to the conversation. Might I trouble you to simply listen to an old priest's worries for a moment instead?\" {subj_cap}'s worries, once shared, turn out to be entirely mundane — which seems to be exactly the reassurance {subj} needed."
}])

