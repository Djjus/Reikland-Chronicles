round1_retry_text = "{subj_cap} laughs it off warmly. \"You've a suspicious mind, friend. Can't say I blame you, these days.\""
round1_final_fail_text = "{subj_cap}'s smile cools by a careful degree. \"I only meant to make the road shorter, friend.\""
round2_skills = Array[String](["Intimidate", "Charm", "Leadership", "Gossip"])
round2_prompt_text = "Whatever {subj}'s really about is close to the surface now."
round2_retry_text = "{subj_cap} recovers smoothly, warmth sliding back into place a half-second too late to be entirely convincing."
reward_xp = 8
npc_reaction_lines = Array[String](["The easy smile keeps slipping and resetting, half a beat too late each time.", "{subj_cap}'s stopped bothering to smooth it back into place at all."])
situations = Array[Dictionary]([{
"combat_monster_names": Array[String](["Cultist"]),
"funny_loss_text": "",
"hook": "keeps steering the talk toward how the \"old ways\" are due to return, given enough patience",
"is_combat": true,
"success_reveal": "The pleasant mask comes off entirely, and what's underneath is considerably colder. \"You were pleasant company,\" {subj_cap} says, almost regretful, \"which is more than I can say for what happens now.\" A handful of {poss} actual fellow travellers step out from the treeline at a whistle you didn't hear {subj} give."
}, {
"combat_monster_names": Array[String](["Cultist"]),
"funny_loss_text": "",
"hook": "presses just a little too hard on whether you've ever felt the gods had truly abandoned you",
"is_combat": true,
"success_reveal": "\"You're not the sort to be brought around gently, are you,\" {subj_cap} says, and the warmth drops out of {poss} voice entirely. \"Shame. The direct approach is so much messier.\" {subj}'s \"fellow travellers\" were never far behind."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "Convinced you've seen through {obj} for the worse reason, {subj_cap}'s pleasant expression vanishes entirely, and {subj} peels off down a side path without so much as a farewell.",
"hook": "keeps glancing at the tarnished symbol at {poss} own throat like {subj} regrets wearing it in company",
"is_combat": false,
"success_reveal": "\"I'll not insult you by denying it,\" {subj_cap} says quietly, once pressed. \"I follow something older than Sigmar's temple. That's not the same as being your enemy, whatever the witch hunters would have you believe. I've never harmed a soul on this road, and I don't intend to start with you.\" {subj_cap} seems, against every expectation, to actually mean it."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap}'s easy warmth cools by exactly the careful degree it takes to end a conversation without quite ending a friendship. \"Safe travels, friend,\" {subj} says, and finds a reason to fall back a few respectful paces for the rest of the road.",
"hook": "keeps the conversation just slightly too focused on whether you'd report something you didn't understand",
"is_combat": false,
"success_reveal": "\"I'm testing you, a little,\" {subj_cap} admits eventually, almost sheepish about it. \"There are things on this road worth fearing more than honest heretics, and I needed to know which kind of stranger you were before I said too much.\" {subj_cap} shares a genuinely useful warning about a real danger further down the road, cult business set entirely aside."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} just shrugs and steers the conversation elsewhere, whatever {poss} old habits are about staying exactly {poss} own business. \"Everyone's got their quirks,\" {subj} says lightly, and the subject doesn't come up again.",
"hook": "keeps a small, careful distance from any shrine or wayside marker you pass",
"is_combat": false,
"success_reveal": "\"Old habits,\" {subj_cap} says when you notice, wry about it. \"I left that life behind some years back — the belief stuck harder than the practice did, is all, and I'd rather not be recognized by the wrong sort for old company I no longer keep.\" {subj_cap}'s relief at not being immediately condemned for {poss} own past is plainly genuine."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} lets the question drop, plainly deciding a stranger isn't who {subj} should be trusting with whatever's really behind it. \"Never mind. Idle curiosity,\" {subj} says, unconvincingly, and changes the subject for good.",
"hook": "asks careful, roundabout questions about how well-guarded the next town's temple actually is",
"is_combat": false,
"success_reveal": "\"Not what you're thinking,\" {subj_cap} says quickly, catching your look. \"My own sister's shut up in there against her will, on the flimsiest heresy charge the local priest could invent. I'm trying to work out how to get her out, not how to get anyone in.\" The desperation behind the admission is entirely real, whatever else {subj} might also be."
}])

[sub_resource type="Resource" id="SocialEnc_10"]
script = ExtResource("2")
encounter_name = "The Quiet Traveller"
portrait_career_key = "outlaw"
npc_fellowship = 30
npc_willpower = 32
intro_text = "A traveller in heavy, ill-fitting layers keeps a careful, deliberate distance as {subj} walks the same road, gloved hands never quite still. {subj_cap} {situation_hook}, polite but plainly guarded. {opening_flavor}"
opening_flavors = Array[String](["It's warm for the road, and {subj}'s dressed for a much colder one.", "{subj_cap} keeps {poss} hood up even in the full light of day.", "{subj_cap} angles {obj}self away from you slightly, out of habit more than rudeness.", "A pair of crows keep unusually close pace overhead, and {subj_cap} seems to notice them too.", "{poss} gloves are worn through at the fingertips, whatever's underneath clearly needing the cover badly.", "{subj_cap} keeps well clear of the roadside shrine you both pass, without comment."])
round1_skills = Array[String](["Charm", "Leadership", "Gossip", "Intimidate"])
round1_prompt_text = "{subj_cap} needs real reassurance before {subj}'ll let their guard down at all."
round1_success_text = "{subj_cap} relaxes, marginally, the careful distance narrowing by half a step."
round1_retry_text = "{subj_cap} draws back instead, wary. \"I mean you no trouble. I'd ask the same courtesy.\""
round1_final_fail_text = "{subj_cap} pulls {poss} hood lower, voice tight. \"I think it's best we part ways here.\""
round2_skills = Array[String](["Charm", "Leadership", "Gossip", "Intimidate"])
round2_prompt_text = "Whatever {subj}'s hiding under all those layers, {subj}'s close to trusting you with it."
round2_retry_text = "{subj_cap} hesitates, hand halfway to a glove {subj} doesn't quite remove."
reward_xp = 8
npc_reaction_lines = Array[String](["The careful distance {subj}'s kept all this time has narrowed considerably.", "{poss_cap} gloved hands have gone still, like {subj}'s finally deciding whether to remove them."])
situations = Array[Dictionary]([{
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap}'s hands stay exactly where they are, sleeves down, gloves on. \"Some things are better left covered,\" {subj} says, quiet but immovable, and the careful distance between you never quite closes.",
"hook": "keeps {poss} gloved hands tucked deep in {poss} sleeves, never once removing them",
"is_combat": false,
"success_reveal": "{subj_cap} finally, carefully, peels back one glove — the hand beneath is subtly, unmistakably wrong, fingers too long and jointed in a way no hand should be. \"Now you know why the layers,\" {subj_cap} says, flat with old, practiced resignation. \"Do what you feel you must.\" There is nothing else remarkable about {obj} at all — no other sign, no threat, no danger beyond what you decide to make of this."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "Something in your look must have given you away, because {subj_cap} simply turns and walks the other direction without another word, hood drawn tighter than ever.",
"hook": "keeps {poss} hood drawn so low you've barely seen more than {poss} own mouth this whole walk",
"is_combat": false,
"success_reveal": "\"It's my eyes,\" {subj_cap} admits eventually, voice tight with the effort of saying it at all. \"Wrong colour, wrong shape, wrong in a way people notice and never forget. I've done nothing to deserve what happens when they're seen. I only want to reach the next town without a mob deciding my fate for me.\""
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} shifts to favour the other side instead, wincing, and plainly decides the ache isn't a stranger's business. \"It's nothing,\" {subj} says, in the tone of someone who's said that particular lie a great many times before.",
"hook": "keeps unconsciously favouring one side, like something under the heavy coat sits wrong",
"is_combat": false,
"success_reveal": "\"A second spine, if you must know,\" {subj_cap} says eventually, bitter and matter-of-fact about it in the way of someone long past being surprised by their own body. \"Doesn't work. Doesn't do anything. Just aches, and marks me for burning if anyone official ever sees it. I'd be grateful for your silence, more than anything else you could offer.\""
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} just quickens {poss} pace toward the next stand of trees, plainly more interested in outrunning the weather than explaining the dread. \"Best we both keep moving,\" {subj} says, and doesn't elaborate.",
"hook": "keeps glancing skyward with plain, old dread whenever a storm cloud passes over",
"is_combat": false,
"success_reveal": "\"Lightning finds me,\" {subj_cap} admits, half a joke and half entirely serious. \"Has three times now. No priest has an explanation that isn't 'you've clearly angered someone.' I've stopped asking. I'd just like to reach shelter before the next one, if you're headed the same way.\""
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} declines the offer to rest properly, boots staying firmly laced. \"I manage well enough as I am,\" {subj} says, tired and final, and the conversation doesn't go any further than that.",
"hook": "won't remove {poss} boots even when offered a chance to rest properly",
"is_combat": false,
"success_reveal": "\"They're not really feet anymore,\" {subj_cap} admits quietly, once the silence has stretched long enough to be worse than the confession. \"Haven't been for years. I manage. I'd rather you didn't see, is all — not out of shame for what I am, just tiredness at what people do once they know.\""
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} goes very still at the mention, then very quiet, and offers nothing further no matter how gently you press. \"I'd rather not discuss it,\" {subj} manages eventually, and the hood stays low for the rest of the walk.",
"hook": "flinches, hard, at the mention of witch hunters passing through the area recently",
"is_combat": false,
"success_reveal": "\"They're not wrong to look,\" {subj_cap} says eventually, quiet and steady despite the fear plainly underneath. \"I am what they're looking for. I've also never harmed a soul, never called on anything I shouldn't, never asked to be born wrong. That won't matter to them. I don't imagine it'll matter to you either, but I'd rather say it plainly than have you find out and feel lied to.\""
}])

[sub_resource type="Resource" id="SocialEnc_11"]
script = ExtResource("2")
encounter_name = "The Broken-Down Cart"
portrait_career_key = "merchant"
npc_fellowship = 36
npc_willpower = 25
intro_text = "A merchant's cart sits canted hard to one side in a rut, a wheel shattered clean off, goods spilled half across the road. {subj_cap} {situation_hook}, sleeves already rolled up. \"Wheel's done for. Wouldn't happen to have a strong back and a spare hour, would you?\" {opening_flavor}"
opening_flavors = Array[String](["A second wheel looks close to following the first one's example.", "The cargo scattered across the road is a stranger mix of goods than a normal trade route would carry.", "A horse stands patiently nearby, entirely unbothered by the chaos.", "The rut itself looks suspiciously deliberate for something this far from the usual bad patch of road.", "{subj_cap}'s ledger, dropped in the spill, has fallen open to a page of numbers that don't look like ordinary trade.", "The light's starting to go, and neither of you has said aloud what that might mean out here."])
round1_skills = Array[String](["Leadership", "Charm", "Gossip", "Intimidate"])
round1_prompt_text = "{subj_cap} could use a hand — the question is what kind of help {subj} actually needs."
round1_success_text = "{subj_cap} wipes {poss} brow, grateful. \"Sigmar's mercy, an extra pair of hands. Let's get this sorted.\""
round1_retry_text = "{subj_cap} eyes the wheel again, unconvinced by your first attempt at a plan. \"Try again — we haven't got all evening.\""
round1_final_fail_text = "{subj_cap} waves you off, mildly annoyed. \"Perhaps just stand clear, then, if that's the best of it.\""
round2_skills = Array[String](["Leadership", "Gossip", "Charm", "Intimidate"])
round2_prompt_text = "Between the two of you, the cart's nearly sorted — one more good push should see it done."
round2_retry_text = "The wheel slips back half into the rut, both of you swearing in unison."
reward_xp = 6
npc_reaction_lines = Array[String](["{subj_cap} works a little easier now, some of the earlier tension gone out of {poss} shoulders.", "Whatever {subj}'s been dancing around, {subj}'s clearly about to just say it outright."])
situations = Array[Dictionary]([{
"combat_monster_names": Array[String](["Wild Boar"]),
"funny_loss_text": "",
"hook": "keeps glancing nervously toward the treeline while you work, more than the wheel alone explains",
"is_combat": true,
"success_reveal": "The wheel's barely back on before {subj_cap}'s worry proves well-founded — something's been stalking the cart's cargo for a while now, and the noise of the repair was apparently the last straw for its patience."
}, {
"combat_monster_names": Array[String](["Outlaw"]),
"funny_loss_text": "",
"hook": "keeps one hand near a cudgel tucked under the driver's seat the whole time you work",
"is_combat": true,
"success_reveal": "\"Wasn't just bad luck, this wheel,\" {subj_cap} admits once it's fixed. \"Someone's been harassing carts on this stretch, and I think they're circling back to finish the job now we're stopped and vulnerable.\" Sure enough, a shape steps out onto the road ahead, blocking the way forward."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} waves off any further questions, too embarrassed to admit the wheel's own trouble lies with {poss} own greed. \"Just bad luck, is all,\" {subj} insists, unconvincingly, and gets back to the repair without another word on it.",
"hook": "keeps apologizing for the mess in a way that suggests {subj}'s more embarrassed than actually worried",
"is_combat": false,
"success_reveal": "\"Overloaded her, plain and simple,\" {subj_cap} admits once the wheel's back on, sheepish about it. \"Greed got ahead of good sense. You've saved me a very long, very humiliating walk to the next town for a new axle.\" {subj_cap} insists on a genuinely fair cut of the cargo as thanks."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} just works faster instead of answering, jaw tight with an anxiety {subj} plainly doesn't want to put into words. \"No time to explain, only to finish,\" {subj} mutters, and the wheel goes back on in tense, unbroken silence.",
"hook": "keeps glancing at the sun's position, doing quiet, worried arithmetic under {poss} breath",
"is_combat": false,
"success_reveal": "\"Due at market by nightfall, or I lose the contract entirely,\" {subj_cap} explains, working fast. \"Family depends on this run more than the coin alone lets on.\" {subj_cap}'s relief at making it back on schedule, thanks to your help, is worth more to {obj} than {subj} quite manages to say aloud."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} snatches the ledger back up and tucks it well out of sight, the earlier warmth cooling considerably. \"Some books aren't for reading,\" {subj} says, flat, and the rest of the repair passes in careful, deliberate quiet.",
"hook": "keeps glancing at the ledger dropped in the spill like {subj}'d rather you hadn't seen it",
"is_combat": false,
"success_reveal": "\"Not quite an ordinary trade route, this one,\" {subj_cap} admits once you've clearly noticed. \"Nothing illegal, just — quiet. Discreet clients prefer discreet books. I'd take it as a kindness if you didn't ask further, and I'll return the kindness in coin.\""
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap}'s thanks trail off into something more like old, practiced wariness, whatever {subj} was working up the nerve to explain going unsaid after all. \"Can't be too careful, these days,\" {subj} says, apologetic but unmoved, and finishes the last strap alone.",
"hook": "won't stop thanking you, well past the point where it's actually necessary",
"is_combat": false,
"success_reveal": "\"You'll have to forgive me,\" {subj_cap} says, still fixing the last strap long after the wheel's secure. \"Last three folk who stopped to 'help' just helped themselves to the cargo instead. Forgotten what an honest hand looks like, is all.\" {subj_cap}'s gratitude, once it settles, is entirely genuine."
}])

[sub_resource type="Resource" id="SocialEnc_12"]
script = ExtResource("2")
encounter_name = "The Stagecoach"
portrait_career_key = "coachman"
npc_willpower = 35
intro_text = "A stagecoach rattles to a stop on the road ahead of you, the driver hailing you down with a raised hand. \"Ho there! A moment of your time, if you'd be so kind!\" {subj_cap} {situation_hook} from the driver's bench. {opening_flavor}"
opening_flavors = Array[String](["A curtained window shifts slightly, someone inside plainly listening.", "The horses are lathered hard, driven far faster than the road's condition really allows.", "A crest on the coach door has been hastily, imperfectly painted over.", "One wheel wobbles in a way that suggests this stop wasn't entirely voluntary.", "The driver keeps glancing back down the road the coach just came from.", "A guard rides alongside, hand resting a little too readily on {poss} own weapon."])
round1_skills = Array[String](["Charm", "Leadership", "Gossip", "Intimidate"])
round1_prompt_text = "{subj_cap}'s asking for something — worth working out exactly what before agreeing to anything."
round1_success_text = "{subj_cap} looks relieved to be dealing with someone who isn't immediately suspicious of a stopped coach."
round1_retry_text = "{subj_cap} glances toward the coach, hesitating. \"Perhaps I should explain myself better.\""
round1_final_fail_text = "{subj_cap} straightens, guarded. \"Perhaps this was a mistake. Good day to you.\""
round2_skills = Array[String](["Charm", "Leadership", "Gossip", "Intimidate"])
round2_prompt_text = "Whatever's really going on with this coach, {subj_cap}'s close to telling you outright."
round2_retry_text = "{subj_cap} glances toward the curtained window before answering, choosing words carefully."
reward_xp = 8
npc_reaction_lines = Array[String](["{subj_cap} keeps glancing toward the coach less anxiously than before, like the worst might not be coming after all.", "The guarded formality's dropped out of {poss} voice entirely — {subj}'s talking plainly now."])
situations = Array[Dictionary]([{
"combat_monster_names": Array[String](["Highway Bandit"]),
"funny_loss_text": "",
"hook": "keeps glancing back down the road with real, undisguised dread",
"is_combat": true,
"success_reveal": "\"We're being followed,\" {subj_cap} admits, voice low. \"Have been for the better part of an hour. I'd count it a great favour if you'd see them off before they catch us up entirely.\" Sure enough, riders crest the rise behind the coach within minutes."
}, {
"combat_monster_names": Array[String](["Gor"]),
"funny_loss_text": "",
"hook": "keeps the guard riding unusually close, both of them watching the treeline more than the road",
"is_combat": true,
"success_reveal": "\"There's been trouble on this stretch,\" the driver admits. \"Something in the woods, taking travellers who stop too long. We'd not have flagged you down at all, except the coach itself can't outrun it and we're out of better options.\" The trees ahead rustle, entirely unnaturally still a moment before."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "The curtained window twitches once and goes still, whoever's behind it deciding against showing {obj}self after all. \"My passenger prefers privacy,\" the driver says, a shade too quickly, and the coach doesn't linger to discuss it further.",
"hook": "keeps glancing at the hastily painted-over crest on the coach door",
"is_combat": false,
"success_reveal": "\"Not proud of the disguise,\" the passenger admits, having stepped down to explain in person. \"Fleeing an arranged marriage I want no part of, and my family's crest travels faster than I do if I don't cover it. I'd be grateful for your discretion more than anything else.\""
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "The driver checks the pocket-watch one last time and decides there's no more time to spend on explanations. \"We really must be going,\" {subj} says, already gathering the reins, and the coach pulls away before you can press further.",
"hook": "keeps checking a pocket-watch with real, mounting anxiety",
"is_combat": false,
"success_reveal": "\"We're dangerously behind schedule,\" the driver admits, \"and the coach ahead of us on this route hasn't been seen since yesterday. I don't like what that might mean, and I don't like it more the longer we sit here talking, if I'm honest.\" The warning, urgently given, seems entirely sincere."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "The driver's expression closes right along with the curtain. \"I've said what I'm going to say on the matter,\" {subj} says, firm but not unkind, and busies {obj}self checking the harness instead of talking further.",
"hook": "keeps the curtained window firmly shut despite the day's warmth",
"is_combat": false,
"success_reveal": "\"My passenger's unwell,\" the driver explains, lowering {poss} voice. \"Nothing catching, just — private. {subj_cap} asked me to keep the curtains drawn and the questions to a minimum. I'd consider it a kindness if you let it lie.\""
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "The driver seems to think better of the offer before {subj} finishes weighing it, and waves you off instead. \"We'll manage as we are,\" {subj} says, not quite believing it, and the coach rattles on shorthanded regardless.",
"hook": "keeps eyeing your own gear with plain, professional appraisal",
"is_combat": false,
"success_reveal": "\"I'll be blunt,\" the driver admits. \"We're short a guard — lost him to a twisted ankle two towns back — and this stretch of road has a poor reputation. I can't pay much, but I can pay something, if you'd ride along as far as the next town.\""
}])

