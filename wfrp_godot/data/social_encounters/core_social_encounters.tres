[sub_resource type="Resource" id="SocialEnc_1"]
script = ExtResource("2")
encounter_name = "The Roadside Peddler"
portrait_career_key = "pedlar"
npc_fellowship = 35
npc_willpower = 30
intro_text = "A hunched peddler waves you down from beside a rickety handcart piled with pots, ribbons, and dubious-looking charms. {subj_cap} {situation_hook} as {subj} talks. \"Fine goods, friend! Fair prices! And I hear things, too, if you're the sort who values what's on the road ahead...\" {opening_flavor}"
opening_flavors = Array[String](["A cold wind picks up, and neither of you mentions it.", "Somewhere behind the cart, a wheel creaks like it's about to give up entirely.", "The road here is quieter than it has any right to be.", "A crow watches the whole exchange from a nearby branch with unsettling interest.", "The cart's wares look older and stranger the longer you actually look at them.", "There's a smell of woodsmoke on the air that shouldn't be this close to the road."])
round1_prompt_text = "{subj_cap}'s clearly nervous about something. Push for a straight answer, charm {obj} into relaxing, or just walk away with whatever you can talk {obj} into."
round1_success_text = "{subj_cap} lets {poss} guard down a little and admits the road's been \"unfriendly\" further along — worth knowing, and worth something to you."
round1_retry_text = "{subj_cap} forces a laugh and changes the subject, cart wheels creaking as {subj} shifts {poss} weight. {subj_cap}'s still watching the treeline. Try a different approach."
round1_final_fail_text = "{subj_cap} clams up entirely, eyes darting to the trees. \"Just — just buy something, or move along.\""
round2_skills = Array[String](["Charm", "Gossip", "Leadership"])
round2_prompt_text = "Now that {subj}'s talking, there's clearly more {subj} isn't saying. Press gently, or lay your cards on the table."
round2_retry_text = "{subj_cap} hesitates, halfway to telling you something, then loses {poss} nerve. One more try."
reward_item = "Silver Locket"
npc_reaction_lines = Array[String](["The peddler's cheerful patter is wearing thin — {subj_cap} keeps glancing toward the treeline like {subj}'s counting on someone else to end this.", "{subj_cap}'s hands have stopped fussing with the goods entirely. Whatever the act was, it's cracking."])
situations = Array[Dictionary]([{
"combat_monster_names": Array[String](["Outlaw"]),
"funny_loss_text": "",
"hook": "keeps glancing back toward the treeline as he talks, a little too quickly, a little too loud",
"is_combat": true,
"success_reveal": "It comes out in a rush — {subj}'s not really a peddler, {subj}'s a lookout paying off a debt to some rough sorts hiding nearby by luring in \"customers.\" {subj_cap} is grateful you didn't turn violent, and presses a genuinely fine trinket into your hands as thanks for hearing {obj} out, along with what little coin {poss} has."
}, {
"combat_monster_names": Array[String](["Feral Dog"]),
"funny_loss_text": "",
"hook": "keeps one hand resting on the cart, close to a bundle wrapped in oilcloth that clearly isn't for sale",
"is_combat": true,
"success_reveal": "It turns out the cart's guarded by more than just {poss} own nerve — a couple of half-feral dogs come padding out from behind it, clearly used to {poss} whistle, clearly not used to strangers who don't leave when told to."
}, {
"combat_monster_names": Array[String](["Orc"]),
"funny_loss_text": "",
"hook": "asks a few too many careful questions about which way you're headed and how many of you there are",
"is_combat": true,
"success_reveal": "{subj_cap} finally admits {subj}'s been asked to watch the road and report back on travellers — there's an orc warband scouting the area, and {subj} very much did not sign up to actually fight them. {subj_cap} points you toward where {subj} last saw them, grateful to have someone else handle it."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} bolts the second {poss} guard is down, cart and all, muttering something about \"not risking it twice.\" You're left standing in the road with absolutely nothing to show for it.",
"hook": "flinches at every distant hoofbeat like {poss} own name's about to be called",
"is_combat": false,
"success_reveal": "{subj_cap} finally admits it — {subj}'s a deserter, three months gone from a regiment {subj} never wanted to join, and the \"peddling\" is just a way to stay moving. The moment {subj} realizes you're not here to drag {obj} back, {subj} packs up the cart and disappears down a side path faster than someone that nervous has any right to move."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "Convinced you're here about the debt after all, {subj} suddenly \"remembers\" urgent business elsewhere and is gone before you can finish your sentence, cart creaking off into the distance.",
"hook": "does the math on your coin purse a little too obviously every time you speak",
"is_combat": false,
"success_reveal": "{subj_cap} finally confesses {subj} owes a genuinely frightening sum to a moneylender in the last town, and briefly mistook you for muscle sent to collect. The relief when {subj} realizes you're not is almost funny — almost."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "Convinced you're a gamekeeper in disguise, {subj} suddenly can't recall a single thing about any of this, and edges the cart away at a pace that fools absolutely nobody.",
"hook": "keeps a weathered net and a suspiciously fresh brace of hare tucked half out of sight under the cart's tarp",
"is_combat": false,
"success_reveal": "It turns out the \"trade goods\" are considerably less legal than advertised — {subj}'s been poaching the local lord's game for months and living in genuine terror of the gamekeepers. {subj_cap} relaxes once {subj}'s sure you're not one of them, and even offers a fair cut of the trade."
}, {
"combat_monster_names": Array[String](["Cultist"]),
"funny_loss_text": "",
"hook": "keeps a small, unmarked crate roped shut at the very back of the cart, apart from everything else on offer",
"is_combat": true,
"success_reveal": "{subj_cap} finally admits {subj}'s been paid to carry the crate to a \"quiet meeting\" further down the road, no questions asked, and the coin was too good to think hard about who was asking. A handful of robed figures are already waiting at the treeline when the truth comes out, clearly expecting their delivery on schedule."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "Convinced {poss} luck has finally run out, {subj} abandons the cart outright and simply runs, leaving you standing in the road next to a pile of pots and ribbons and no explanation at all.",
"hook": "won't stop glancing at a battered ledger tucked into {poss} coat, doing sums under {poss} breath",
"is_combat": false,
"success_reveal": "{subj_cap} finally confesses {subj}'s certain you're the moneylender's collector, sent early and in disguise to catch {obj} short. The relief when {subj} realizes you're not almost knocks {obj} off {poss} feet — followed immediately by a much longer, much less guarded conversation than you expected."
}, {
"combat_monster_names": Array[String](["Wild Boar"]),
"funny_loss_text": "",
"hook": "keeps a haunch of raw meat wrapped loosely enough that the smell carries well down the road",
"is_combat": true,
"success_reveal": "It turns out the \"fresh cuts\" weren't sourced anywhere near as carefully as advertised — the smell has been drawing exactly the kind of attention {subj} was hoping to avoid, and a wild boar comes crashing out of the treeline clearly following its nose."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "Convinced for one terrible moment that you've been sent to drag {obj} back, {subj} bolts before you can get out a single reassuring word, cart abandoned and creaking to a stop in the middle of the road.",
"hook": "flinches at anything resembling a staff or a raised hand, then catches {obj_lc}self doing it",
"is_combat": false,
"success_reveal": "{subj_cap} finally admits {subj}'s a runaway apprentice, three towns and one very angry master ago, and the peddling is just the least conspicuous way {subj} could think of to stay fed and moving. There's real fear behind the admission — and real gratitude that you didn't turn out to be who {subj} was afraid of."
}])

[sub_resource type="Resource" id="SocialEnc_2"]
script = ExtResource("2")
encounter_name = "The Blustering Watchman"
portrait_career_key = "watchman"
npc_fellowship = 30
npc_willpower = 45
intro_text = "A figure in a mismatched, half-buttoned uniform plants {obj_lc}self in the middle of the road, one hand on a rusty halberd {subj} clearly doesn't know how to use. \"Halt! Road toll, in the name of... the road! Papers, or coin, or you're not passing.\" {subj_cap} {situation_hook}. {opening_flavor}"
opening_flavors = Array[String](["There's no toll booth in sight, and never has been.", "The \"uniform\" doesn't match any regiment you've ever actually seen.", "A pair of birds scatter from a nearby tree at the sound of {poss} voice.", "The road behind {obj_lc} is completely, suspiciously empty.", "{subj_cap} shifts {poss} grip on the halberd like {subj}'s never actually held one before.", "Somewhere close by, something rustles in the ditch and goes still."])
round1_skills = Array[String](["Charm", "Leadership", "Intimidate"])
round1_prompt_text = "There's no toll booth, no other guards, and {poss} uniform doesn't match anything official. Talk your way past {obj}, one way or another."
round1_success_text = "{subj_cap} wavers, uniform sagging with {poss} confidence. \"Well — I suppose — just this once...\""
round1_retry_text = "{subj_cap} puffs {poss} chest back out, unconvinced. \"That's exactly what someone dodging the toll would say!\" Try something else."
round1_final_fail_text = "{subj_cap} plants the halberd butt-first in the dirt with great ceremony. \"The toll stands!\""
round2_skills = Array[String](["Charm", "Leadership", "Intimidate", "Gossip"])
round2_prompt_text = "{subj_cap}'s rattled but digging in out of pure stubbornness now. One more push should settle it."
round2_retry_text = "{subj_cap} hesitates, halfway to giving in, then remembers {obj_lc}self. \"No! I mean — no. The toll!\""
reward_item = "Rusty Halberd"
npc_reaction_lines = Array[String](["{poss_cap} grip on the halberd has gone from confident to purely decorative.", "{subj_cap}'s uniform seems to have shrunk two sizes in the last few minutes alone."])
situations = Array[Dictionary]([{
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} draws {obj_lc}self up to {poss} full, mismatched height and refuses to budge another inch. \"The toll stands, and that's final!\" You end up paying it just to be done with the argument, no wiser about the washed-out bridge {subj} never gets around to mentioning.",
"hook": "has clearly appointed {obj_lc}self to this post with no authority whatsoever, uniform mismatched and half-buttoned",
"is_combat": false,
"success_reveal": "{poss_cap} shoulders slump, all the bluster gone out of {obj} at once. \"...Right. Yes. Go on, then. Wasn't really a toll anyway.\" {subj_cap} even mumbles a genuinely useful warning about a washed-out bridge ahead as you pass."
}, {
"combat_monster_names": Array[String](["Outlaw"]),
"funny_loss_text": "",
"hook": "seems awfully confident for someone standing alone in the middle of an empty road",
"is_combat": true,
"success_reveal": "A low whistle cuts through the trees, and it becomes very clear {subj} wasn't actually alone — a couple of rough sorts step out from the treeline, {poss} actual backup, {subj} having just been the friendly-looking bait."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "With the sergeant still watching, {subj_cap} plants the halberd and refuses to yield an inch — better a stranger's bad opinion than a superior's, apparently. The toll stands, paid in full, while {subj} straightens {poss} uniform for an audience of one.",
"hook": "keeps glancing back over {poss} shoulder toward a stern-looking figure watching from a distance",
"is_combat": false,
"success_reveal": "{subj_cap} finally cracks — {subj}'s a fresh recruit trying to impress a sergeant who's been watching this whole exchange, and desperately doesn't want to look weak in front of {obj}. The moment you let {obj} save face, {subj} waves you through, visibly relieved."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} simply repeats the \"regulations\" a third time, word for word, unbothered by how thin they sound under scrutiny. There's no arguing with someone this committed to a bit — the toll gets paid, and you're left no wiser what {subj}'s actually protecting.",
"hook": "recites the \"official toll regulations\" with the exact cadence of someone who made every word of it up on the spot",
"is_combat": false,
"success_reveal": "It turns out {subj} genuinely, sincerely believes {subj}'s still enlisted — {subj} was discharged years ago and nobody's ever had the heart to tell {obj}. There's something almost sad about how proud {subj} is of the \"post.\""
}, {
"combat_monster_names": Array[String](["Clanrat"]),
"funny_loss_text": "",
"hook": "keeps eyeing a rusted grate in the ditch beside the road, just a little too often to be nothing",
"is_combat": true,
"success_reveal": "Push too hard and {subj} panics, giving three short raps on the old grate — and the toll, it turns out, was never really {poss} own idea at all. Something considerably less human comes scrabbling up out of the dark to collect it instead."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "Something in your pressing seems to embarrass {obj} rather than open {obj} up — {subj_cap} straightens, clears {poss} throat, and retreats hard into official-sounding bluster. The toll stands, and the conversation's over, whatever {subj} might have actually wanted from it.",
"hook": "talks a little too eagerly once the conversation actually gets going, like {subj} hasn't spoken to anyone in days",
"is_combat": false,
"success_reveal": "{subj_cap} finally admits the toll was never about coin at all — it's the only excuse {subj} could think of to get someone, anyone, to actually stop and talk to {obj} out here. {subj_cap} waves you through looking almost embarrassed, and considerably less lonely."
}, {
"combat_monster_names": Array[String](["Highway Bandit"]),
"funny_loss_text": "",
"hook": "keeps glancing down a side track {subj} very clearly doesn't want you asking about",
"is_combat": true,
"success_reveal": "Push hard enough and {subj} finally breaks — the \"toll\" was never {poss} own idea, it's a cut owed to a bandit camp down that very track, and {subj}'s just the unlucky soul stuck collecting it. The bandits themselves come looking when the coin doesn't show up on schedule, apparently rather less patient than {subj} was hoping."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} only plants {obj_lc}self more firmly between you and the ruin, refusing to explain why it matters so much. Whatever {subj}'s guarding against, {subj}'d clearly rather face it alone than admit needing company — the toll stands, and {subj} doesn't move.",
"hook": "keeps positioning {obj_lc}self so the crumbling ruin behind {obj_lc} is always at {poss} back, never {poss} front",
"is_combat": false,
"success_reveal": "{subj_cap} finally admits {subj} volunteered for this post specifically because it meant never having to walk past that ruin alone after dark, and the toll was just an excuse to have someone else standing here with {obj} for a while. {subj_cap} waves you through with genuine, slightly sheepish gratitude."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap}'s hand tightens on the old stone, and whatever {subj} isn't saying stays unsaid — pride, it turns out, holds up better than logic does. The toll stands, paid same as it would've been to {poss} father, thirty years back.",
"hook": "stands beside a weathered old boundary stone, one hand resting on it like it matters more than the halberd does",
"is_combat": false,
"success_reveal": "{subj_cap} finally admits the stone marks where {poss} father stood this same watch for thirty years before {obj}, and the toll — invented, unofficial, utterly pointless — is the only way {subj} knows how to keep standing in his footsteps. There's nothing to argue with in an answer like that, and {subj} seems to know it."
}, {
"combat_monster_names": Array[String](["Goblin"]),
"funny_loss_text": "",
"hook": "keeps glancing toward a suspiciously tidy pile of brush just off the road, like {subj}'s counting on it for something",
"is_combat": true,
"success_reveal": "It turns out {subj}'s own \"post\" was chosen for {obj} rather than by {obj} — a goblin raiding party has been using this stretch of road as a killing ground, and {subj}'s halfhearted toll was the only warning {subj} dared give without getting caught helping travellers along. The goblins themselves, tired of waiting on their decoy, come out of the brush anyway."
}])

[sub_resource type="Resource" id="SocialEnc_3"]
script = ExtResource("2")
encounter_name = "The Humble Pilgrim"
portrait_career_key = "flagellant"
npc_willpower = 35
intro_text = "A traveller in plain, road-worn robes falls into step beside you, staff in hand, a wooden Sigmarite hammer swinging from a cord at {poss} neck. \"Fellow traveller! The road's safer shared, wouldn't you say?\" {subj_cap} {situation_hook} as {subj} walks. {opening_flavor}"
opening_flavors = Array[String](["The staff looks freshly cut, not the worn travelling-stick of someone who's walked far on it.", "For a pilgrim, {subj}'s boots are suspiciously fine.", "A raven keeps pace overhead for longer than seems natural.", "The road narrows here, hemmed by treeline on both sides.", "{subj_cap} keeps perfect pace with you, never quite falling behind or pulling ahead.", "There's a second set of footprints in the mud that don't match {poss} own stride."])
round1_prompt_text = "{subj_cap}'s piety feels a half-step too rehearsed — worth pressing, one way or another."
round1_success_text = "{subj_cap} relaxes a fraction, whatever act this is slipping for just a moment before {subj} catches it."
round1_retry_text = "{subj_cap} recovers smoothly, piety sliding back into place like a mask readjusted. \"Sigmar tests us all, friend.\""
round1_final_fail_text = "{subj_cap} presses a hand to the wooden hammer at {poss} neck, wounded. \"You doubt a man of faith?\""
round2_skills = Array[String](["Charm", "Leadership", "Intimidate", "Gossip"])
round2_prompt_text = "Whatever {subj}'s hiding is close to the surface now — one more push should bring it out."
round2_retry_text = "{subj_cap} nearly slips again, catching {obj_lc}self at the last moment with a practiced, pious sigh."
reward_xp = 6
npc_reaction_lines = Array[String](["The pious mask slips a fraction more with every word — {subj}'s stopped quoting scripture entirely.", "{poss_cap} hand keeps drifting toward {poss} own robes, like {subj}'s reconsidering whatever's underneath them."])
situations = Array[Dictionary]([{
"combat_monster_names": Array[String](["Highway Bandit"]),
"funny_loss_text": "",
"hook": "keeps sizing up your gear with quick, professional glances he thinks you haven't noticed",
"is_combat": true,
"success_reveal": "The pilgrim's act drops all at once — {subj}'s no more a man of Sigmar than the staff is a holy relic. \"Right then,\" {subj} says, all pretence gone, \"you're either handing over that purse, or my associates are.\" Two rough shapes step out from the treeline, already grinning."
}, {
"combat_monster_names": Array[String](["Outlaw"]),
"funny_loss_text": "",
"hook": "keeps glancing toward a bend in the road ahead with poorly-hidden anticipation",
"is_combat": true,
"success_reveal": "{subj_cap} finally drops the act with something almost like relief. \"You're sharper than most,\" {subj} admits. \"There's a real ambush waiting round that bend — I'd rather not be standing in the middle of it when it goes wrong. We can call this even, or you can come find out who's waiting.\""
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap}'s hand drifts to the wooden hammer at {poss} neck, piety sliding firmly back into place. \"Sigmar keep you, friend,\" {subj} says, in a tone that makes plain the conversation's over, and falls back a deliberate pace to let you walk on ahead alone.",
"hook": "flinches every time you mention the nearest town's watch by name",
"is_combat": false,
"success_reveal": "{subj_cap} finally admits it — {subj}'s a real highwayman between jobs, the robes stolen off an actual pilgrim {subj} won't discuss further, worn purely because armed men in fine clothes get stopped and questioned far more than beggars do. {subj_cap} seems almost grateful to stop performing piety and just talk plainly for once, and shares a genuinely useful warning about where {poss} old crew still operates."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "Convinced you've seen through {obj} for the worse reason, {subj} bolts into the treeline mid-sentence, wooden hammer bouncing against {poss} chest as {subj} runs.",
"hook": "can't quite meet your eyes when {subj} talks about {poss} own \"pilgrimage\"",
"is_combat": false,
"success_reveal": "{subj_cap} finally confesses there is no pilgrimage — {subj}'s fleeing a debt to the very sort of highwaymen {subj}'s currently disguised as, and the robes were the only disguise {subj} could steal in time. The relief when you don't turn {obj} in is real, and so is the warning {subj} offers about the road ahead."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "The moment your guard drops, so does {poss} — a hand darts for your purse strings, and {subj}'s gone into the trees before you can do more than shout after {obj}, considerably lighter in the pocket than you were a moment ago.",
"hook": "keeps one hand tucked inside {poss} robes in a way that has nothing to do with prayer",
"is_combat": false,
"success_reveal": "The \"holy relic\" {subj} finally produces from inside {poss} robes is a garrotte, not a prayer book — {subj}'s a real cutpurse who took the disguise off a dead pilgrim and never looked back. {subj_cap} weighs {poss} odds against you for a long moment before deciding they're bad, and simply melts back into the treeline rather than press the matter."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} checks the sun once more, decides against whatever {subj} was weighing, and offers a hurried blessing before peeling off down a side track without explanation. You're left with the distinct, uneasy feeling of having been sized up and dismissed.",
"hook": "keeps checking the sun's position like {subj}'s timing something down to the minute",
"is_combat": false,
"success_reveal": "{subj_cap} finally admits {subj}'s a scout for a much larger band further down the road, sent ahead in disguise specifically to judge whether passing travellers are worth the trouble of robbing. {subj_cap} seems almost impressed you talked {obj} out of the job, and heads off to report you as \"not worth it\" — which, from a highwayman, might be the nicest thing anyone's said to you all week."
}])

[sub_resource type="Resource" id="SocialEnc_4"]
script = ExtResource("2")
encounter_name = "The Hedge-Witch"
portrait_career_key = "hedge_witch"
npc_fellowship = 30
npc_willpower = 45
intro_text = "An old woman crouches at the roadside, gathering herbs into a basket with hands far steadier than her stooped back suggests they should be. {subj_cap} {situation_hook} without looking up. \"Sit a while, if you like. Or don't. The road's not going anywhere.\" {opening_flavor}"
opening_flavors = Array[String](["The herbs in her basket aren't ones you recognize, and you've walked this road before.", "A black cat watches from a fence post with far too much interest in the conversation.", "The air smells faintly of something burnt, though there's no fire in sight.", "Her shadow, for one unsettling moment, seems to fall the wrong direction.", "The birdsong nearby has gone strangely quiet since you approached.", "A ring of mushrooms circles the spot she's crouched in, a little too perfectly."])
round1_prompt_text = "There's something worth learning here, if you can find the right way to ask."
round1_success_text = "She looks up at last, weighing you properly for the first time. \"Hm. Maybe you're worth talking to after all.\""
round1_retry_text = "She goes back to her herbs without a word, entirely unbothered by the attempt."
round1_final_fail_text = "\"Careful,\" she says mildly, not looking up. \"Words have weight out here. Mind how you spend them.\""
round2_skills = Array[String](["Charm", "Leadership", "Gossip", "Intimidate"])
round2_prompt_text = "She's listening properly now — whatever you say next will decide how this actually goes."
round2_retry_text = "She tilts her head, considering, and says nothing at all for a long moment."
reward_xp = 7
npc_reaction_lines = Array[String](["She's stopped sorting her herbs entirely, watching you now with real, undivided attention.", "Something in her expression has shifted from testing you to actually deciding something."])
situations = Array[Dictionary]([{
"combat_monster_names": Array[String](["Forest Goblin"]),
"funny_loss_text": "",
"hook": "keeps glancing toward a distant treeline like she's expecting company",
"is_combat": true,
"success_reveal": "\"There's a nest of goblins gone bold past those trees,\" she says finally, \"eating into the game I rely on. Deal with them, and I'll make it worth the walk.\" She presses a small bundle of dried herbs into your hand — a real, working salve, by the look of it."
}, {
"combat_monster_names": Array[String](["Wolf"]),
"funny_loss_text": "",
"hook": "hums something old and wordless under her breath the entire time",
"is_combat": true,
"success_reveal": "\"You've a look about you that says you can handle yourself,\" she says. \"There's a wolf been circling closer to the village each night. Not natural-acting, that one. See to it, and I'll owe you a kindness.\""
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "She only clicks her tongue and goes back to her herbs, entirely unbothered by your caution. \"Suit yourself,\" she says, not looking up again, and the conversation is plainly over.",
"hook": "keeps offering you tastes of things from her basket you're fairly sure aren't food",
"is_combat": false,
"success_reveal": "\"Just herbs, dear,\" she says, amused at your caution. \"I'm no witch, whatever the village says — just an old woman who knows what grows where and doesn't waste it. Though I'll admit I don't correct them. Keeps the curious ones at a respectful distance.\" She shares a genuinely useful bit of local knowledge before you go."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "\"Rude,\" she says simply, and the basket, the herbs, and the old woman herself are somehow just gone when you next look — leaving you fairly sure you've made an enemy you can't easily find again.",
"hook": "watches you with the patient, assessing look of someone deciding whether you're worth the trouble",
"is_combat": false,
"success_reveal": "\"I test everyone who stops,\" she admits eventually. \"Most fail. You didn't. There's a difference between rudeness and honesty, and you managed the second.\" She offers a small charm — more comfort than magic, most likely, but offered sincerely."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "\"You're no different from the rest of them,\" she mutters, and gathers her basket with hands that suddenly seem a great deal less frail, leaving without another word.",
"hook": "keeps one hand resting protectively over the basket whenever you get too close",
"is_combat": false,
"success_reveal": "\"Village apothecary won't buy from a woman who lives alone in the woods,\" she says, bitterness plain, \"whatever her herbs are worth. Calls it prudence. I call it convenient.\" She's grateful enough for someone who'll simply talk to her like a person that she shares a genuinely rare recipe before you part ways."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "Her hand closes over the old scar, and whatever {subj} was about to say dies in her throat. \"Best you move along,\" she says, quiet and final, gathering her basket with hands gone suddenly unsteady. She doesn't look up again as you go.",
"hook": "keeps glancing at a scar across her own palm like it still aches",
"is_combat": false,
"success_reveal": "\"Witch-hunters came through some years back,\" she says quietly. \"Wasn't a witch then either. Doesn't much matter to men with torches.\" There's real fear behind the words, and real relief when you don't reach for a weapon. She shares what little safety she can offer in thanks — a warning about a stretch of road best avoided after dark."
}])

[sub_resource type="Resource" id="SocialEnc_5"]
script = ExtResource("2")
encounter_name = "The Amiable Swindler"
portrait_career_key = "charlatan"
npc_fellowship = 45
npc_willpower = 25
intro_text = "A cheerful stranger waves you over to a folding table set up right on the roadside, three cups arranged neatly on top. \"Friend! Friend, you look sharp-eyed — care to test it? Watch the ball, win double your coin!\" {subj_cap} {situation_hook} as {subj} shuffles the cups. {opening_flavor}"
opening_flavors = Array[String](["A small, appreciative crowd of exactly nobody has gathered to watch.", "The table wobbles on legs that look deliberately uneven.", "One of the cups has a chip in the rim you're fairly sure is meant to be a marker.", "{subj_cap}'s sleeves are a good deal roomier than fashion strictly requires.", "A dog nearby watches the cups with more suspicion than you'd expect from a dog.", "The whole setup has clearly been assembled and struck many times before."])
round1_skills = Array[String](["Gossip", "Charm", "Intimidate", "Leadership"])
round1_prompt_text = "Something about this whole setup doesn't sit right — worth pushing on."
round1_success_text = "{subj_cap}'s cheerful patter falters for just a moment, like a rehearsed line missed its cue."
round1_retry_text = "{subj_cap} laughs it off smoothly, patter never missing a beat. \"Suspicious sort, aren't you? Fair enough, fair enough.\""
round1_final_fail_text = "\"Now, now,\" {subj_cap} says, all wounded good humour. \"A man can't run an honest game round here?\""
round2_skills = Array[String](["Intimidate", "Charm", "Gossip", "Leadership"])
round2_prompt_text = "{subj_cap}'s rattled now — one more push and the whole act comes apart."
round2_retry_text = "{subj_cap} rallies with visible effort, patter sliding back into place a half-second too late to be convincing."
npc_reaction_lines = Array[String](["{poss_cap} patter's got noticeably less smooth — the cups have stopped moving as fast as {poss} mouth.", "{subj_cap}'s stopped performing entirely. Whatever's left is a lot closer to the truth."])
situations = Array[Dictionary]([{
"combat_monster_names": Array[String](["Outlaw"]),
"funny_loss_text": "",
"hook": "keeps a small weighted ball palmed in {poss} off hand the entire time, badly hidden",
"is_combat": true,
"is_opposed": true,
"success_reveal": "\"Alright, alright, you've got me,\" {subj_cap} admits, holding up both hands, the weighted ball dropping onto the table with a telling little thud. \"No ball ever leaves my hand, friend. Never has. Care to let it go, or are we doing this the hard way?\" A couple of rough sorts materialize from a nearby alley, clearly {poss} actual muscle for exactly this outcome."
}, {
"combat_monster_names": Array[String](["Highway Bandit"]),
"funny_loss_text": "",
"hook": "keeps glancing past you at two large men loitering with unconvincing casualness",
"is_combat": true,
"is_opposed": true,
"success_reveal": "The moment you call out the scam, {subj}'s \"friends\" stop pretending to loiter. \"Should've just lost your coin quietly,\" {subj_cap} sighs, already backing away as they close in."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap}'s grin never wavers — if anything it widens, patter picking back up exactly where it left off. \"No harm in a friendly game, eh?\" {subj} says, already reaching for the cups again, entirely undeterred by your scrutiny.",
"hook": "flashes a grin that's just a little too practiced to be genuine",
"is_combat": false,
"is_opposed": true,
"success_reveal": "\"Fine, fine — it's rigged, obviously,\" {subj_cap} admits, entirely unbothered. \"But you clocked it in under a minute, which is better than most. Tell you what — no hard feelings, and here's a genuinely useful tip for free: don't play the ring game two towns over, that one's actually dangerous.\""
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "\"Ah, shame,\" {subj_cap} says, packing up the table with impressive speed the moment you press too hard, gone down a side street before you can get another word in.",
"hook": "keeps a genuinely impressive collection of loose coin just visible in an open satchel",
"is_combat": false,
"is_opposed": true,
"success_reveal": "\"You got me fair,\" {subj_cap} laughs, holding up both hands. \"Honestly? Refreshing. Most marks just get angry.\" {subj_cap} seems to actually enjoy the company enough to share a few real tricks of the trade, purely for the conversation."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "Whatever {subj} was worried about, your pressing seems to confirm it — {subj_cap} goes pale, mutters something about \"remembering an appointment,\" and has the table folded and gone before you can get another word in.",
"hook": "keeps checking over {poss} shoulder like {subj}'s worried about being recognized",
"is_combat": false,
"is_opposed": true,
"success_reveal": "\"Look, you got me, fine,\" {subj_cap} admits, dropping the act entirely. \"Truth is I owe some genuinely unpleasant people money, and this table's the fastest way I know to make it. Wasn't personal.\" {subj_cap} seems almost relieved to stop performing cheer for a moment, and shares a bit of real information out of simple gratitude."
}, {
"combat_monster_names": Array[String]([]),
"funny_loss_text": "{subj_cap} just laughs it off and starts shuffling the deck instead of the cups, patter never missing a beat. \"New game, then, if the old one's rumbled,\" {subj} says, plainly not done working the road today.",
"hook": "keeps a suspiciously well-worn deck of cards tucked half-visible beneath the table",
"is_combat": false,
"is_opposed": true,
"success_reveal": "\"Alright, the cups are a warm-up,\" {subj_cap} admits with a grin. \"Real game's the cards, if you're interested — and no, I won't cheat you at that one either, not with how well you clocked this.\" {subj_cap} genuinely seems to respect a sharp mark more than a gullible one, and offers a fair trade of information for the entertainment."
}])

[sub_resource type="Resource" id="SocialEnc_6"]
script = ExtResource("2")
encounter_name = "The Desperate Farmer"
portrait_career_key = "villager"
npc_fellowship = 35
npc_willpower = 30
intro_text = "A weathered farmer flags you down at the roadside, hands still dusty from the field, worry written plainly across {poss} face. \"Please — a moment, that's all I ask.\" {subj_cap} {situation_hook} as {subj} explains. {opening_flavor}"
opening_flavors = Array[String](["A half-tilled field stretches out behind {obj}, work clearly abandoned mid-furrow.", "A child watches nervously from a nearby doorway, too young to understand but old enough to be scared.", "The farmhouse behind {obj} has seen better years, roof patched in three different kinds of thatch.", "A dog paces anxiously at the farmer's heel, picking up on {poss} own nerves.", "The whole homestead has the particular quiet of a place holding its breath.", "A neighbour watches from a fair distance away, clearly too frightened to come closer {obj}self."])
round1_skills = Array[String](["Charm", "Leadership", "Gossip", "Intimidate"])
round1_prompt_text = "{subj_cap} needs convincing you're actually here to help, not just passing through."
