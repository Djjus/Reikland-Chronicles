[sub_resource type="Resource" id="PrayerDef_20"]
script = ExtResource("2")
prayer_name = "Beacon of Righteous Virtue"
prayer_type = "Miracle"
god = "Sigmar"
range_text = "You"
target_text = "Area of Effect"
duration_text = "Fellowship Bonus Rounds"
summary = "Allies with Line of Sight to you instantly remove all Broken Conditions and gain the Fearless Talent while the Miracle is in effect and they remain in your Line of Sight. Greenskins with Line of Sight to you are subject to Fear 1."

[sub_resource type="Resource" id="PrayerDef_21"]
script = ExtResource("2")
prayer_name = "Heed Not the Witch"
prayer_type = "Miracle"
god = "Sigmar"
range_text = "You"
target_text = "Area of Effect"
duration_text = "Fellowship Bonus Rounds"
summary = "Any spells targeting anyone or anywhere within Fellowship Bonus yards of you suffer a penalty of -20 to Language (Magick) Tests, in addition to any other penalties."

[sub_resource type="Resource" id="PrayerDef_22"]
script = ExtResource("2")
prayer_name = "Sigmar's Fiery Hammer"
prayer_type = "Miracle"
god = "Sigmar"
range_text = "You"
target_text = "You"
duration_text = "Fellowship Bonus Rounds"
summary = "If wielding a warhammer, it counts as Magical, deals +Fellowship Bonus Damage, and any target struck receives the Ablaze and Prone Conditions."

[sub_resource type="Resource" id="PrayerDef_23"]
script = ExtResource("2")
prayer_name = "Soulfire"
prayer_type = "Miracle"
god = "Sigmar"
range_text = "You"
target_text = "Area of Effect"
duration_text = "Instant"
summary = "Holy fire explodes from your body, blasting outwards for Fellowship Bonus yards. All targets within range take 1d10 Wounds, ignoring Toughness Bonus and Armour Points. Targets with the Undead or Daemon Creature Traits also gain the Ablaze Condition."

[sub_resource type="Resource" id="PrayerDef_24"]
script = ExtResource("2")
prayer_name = "Twin-tailed Comet"
prayer_type = "Miracle"
god = "Sigmar"
range_text = "Fellowship yards"
target_text = "Area of Effect"
duration_text = "Instant"
summary = "A blazing comet strikes a point within Line of Sight and range. Everything within Fellowship Bonus yards of the impact suffers 1d10 + SL Damage, ignoring Toughness Bonus and Armour Points, and gains the Ablaze Condition. The target location must be outdoors, and may only target those Sigmar would deem an enemy."

[sub_resource type="Resource" id="PrayerDef_25"]
script = ExtResource("2")
prayer_name = "Vanquish the Unrighteous"
prayer_type = "Miracle"
god = "Sigmar"
range_text = "Fellowship yards"
target_text = "Fellowship Bonus allies"
duration_text = "Fellowship Bonus Rounds"
summary = "Your chosen allies gain the Hatred Psychology towards Greenskins, Undead, and any associated with Chaos."

