[gd_resource type="Resource" script_class="CreatureTemplateDatabase" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/resources/creature_template_database.gd" id="1"]
[ext_resource type="Script" path="res://scripts/resources/creature_template_definition.gd" id="2"]

[sub_resource type="Resource" id="CreatureTemplateDef_1"]
script = ExtResource("2")
template_name = "Leader"
description = "This creature leads a small band of fellows, or acts as a lieutenant to a greater commander of a larger force. They are fierce fighters who also possess some social skills."
characteristic_bonuses = {"weapon_skill": 15, "ballistic_skill": 15, "strength": 15, "toughness": 15, "initiative": 15, "agility": 15, "willpower": 15, "fellowship": 5}
movement_bonus = 0
skill_bonuses = Array[String](["Cool +15", "Dodge +15", "Intimidate +15", "Leadership +15", "Lore (Warfare) +10", "Melee (Any Two) +15", "Perception +15"])
talents = Array[String](["Combat Aware", "Combat Reflexes", "Furious Assault", "Inspiring", "Resolute", "War Leader"])
spell_note = ""
wounds_note = "Wounds need to be increased due to changes to S, T, and WP."

[sub_resource type="Resource" id="CreatureTemplateDef_2"]
script = ExtResource("2")
template_name = "Commander"
description = "A creature with the Commander template may be a tribal chieftain, great general, or warlord. They are highly skilled warriors and inspiring figures who may lead significant forces."
characteristic_bonuses = {"weapon_skill": 20, "ballistic_skill": 20, "strength": 20, "toughness": 10, "initiative": 20, "agility": 10, "willpower": 20, "fellowship": 15}
movement_bonus = 0
skill_bonuses = Array[String](["Cool +20", "Dodge +20", "Intimidate +20", "Leadership +30", "Lore (Warfare) +20", "Melee (Any Two) +20", "Perception +20"])
talents = Array[String](["Combat Aware", "Combat Reflexes", "Furious Assault", "Inspiring", "Luck", "Resolute", "Unshakeable", "War Leader"])
spell_note = ""
wounds_note = "Wounds need to be increased due to changes to S, T, and WP."

[sub_resource type="Resource" id="CreatureTemplateDef_3"]
script = ExtResource("2")
template_name = "Soldier"
description = "The Soldier template represents a creature trained for hand-to-hand combat."
characteristic_bonuses = {"weapon_skill": 10, "strength": 10, "toughness": 10, "willpower": 10}
movement_bonus = 0
skill_bonuses = Array[String](["Cool +10", "Dodge +10", "Melee (Basic or Polearm) +10"])
talents = Array[String]([])
spell_note = ""
wounds_note = "Wounds need to be increased due to changes to S, T, and WP."

[sub_resource type="Resource" id="CreatureTemplateDef_4"]
script = ExtResource("2")
template_name = "Skirmisher"
description = "The creature is skilled in ambushing enemies or harassing them from a distance. They may eschew any armour or extraneous weaponry that might otherwise slow them down."
characteristic_bonuses = {"ballistic_skill": 10, "initiative": 10, "agility": 10, "willpower": 10}
movement_bonus = 0
skill_bonuses = Array[String](["Dodge +10", "Ranged (Bow, Sling, or Throwing) +10", "Stealth (Rural or Underground) +10"])
talents = Array[String]([])
spell_note = ""
wounds_note = "Wounds need to be increased due to changes to WP."

[sub_resource type="Resource" id="CreatureTemplateDef_5"]
script = ExtResource("2")
template_name = "Elite"
description = "The creature is a veteran soldier with a few tricks up their sleeve. They may be employed as a shock trooper or bodyguard to leaders or spellcasters. They may well be equipped with better armour and weaponry than generic creatures. Skills and Talents ensure they hit hard when they want to."
characteristic_bonuses = {"weapon_skill": 15, "strength": 15, "toughness": 15, "initiative": 15, "willpower": 15}
movement_bonus = 0
skill_bonuses = Array[String](["Cool +15", "Dodge +15", "Intimidate +10", "Leadership +5", "Melee (Any Two) +15", "Perception +15"])
talents = Array[String](["Combat Aware", "Combat Reflexes", "Resolute"])
spell_note = ""
wounds_note = "Wounds need to be increased due to changes to S, T, and WP."

[sub_resource type="Resource" id="CreatureTemplateDef_6"]
script = ExtResource("2")
template_name = "Spellcaster"
description = "This creature displays some magical talent and has a small suite of spells with which to confound their foes. This template may help represent a Goblin Shaman, Ogre Butcher, or Necromancer."
characteristic_bonuses = {"initiative": 10, "intelligence": 10, "willpower": 10}
movement_bonus = 0
skill_bonuses = Array[String](["Channelling (Any) +10", "Cool +10", "Dodge +10", "Intuition +10", "Language (Magick) +15", "Melee (Basic or Polearm) +10", "Perception +10"])
talents = Array[String](["Aethyric Attunement or Instinctive Diction", "Arcane Magic (Any) or Chaos Magic (Any)", "Petty Magic", "Second Sight"])
spell_note = "Choose up to 3 spells from the Petty Magic list and up to 3 from a suitable magical Lore."
wounds_note = "Wounds need to be increased due to changes to WP."

[sub_resource type="Resource" id="CreatureTemplateDef_7"]
script = ExtResource("2")
template_name = "Spellcaster Lord"
description = "This creature is a highly capable magician and respected (or feared) by similar subordinate creatures. This template may create a powerful Necromancer, Orc Shaman Lord, Skaven Grey Seer, or other preeminent spellcaster."
characteristic_bonuses = {"weapon_skill": 10, "initiative": 20, "agility": 15, "intelligence": 20, "willpower": 20, "fellowship": 10}
movement_bonus = 0
skill_bonuses = Array[String](["Channelling (Any) +20", "Cool +20", "Dodge +20", "Intuition +20", "Language (Magick) +20", "Leadership +10", "Melee (Basic or Polearm) +10", "Perception +20"])
talents = Array[String](["Aethyric Attunement", "Arcane Magic (Any) or Chaos Magic (Any)", "Instinctive Diction 2", "Luck", "Magical Sense", "Menacing", "Petty Magic", "Second Sight", "Sixth Sense"])
spell_note = "Choose up to 6 spells from the Petty Magic list and up to 9 from a suitable magical Lore."
wounds_note = "Wounds need to be increased due to changes to WP."

[resource]
script = ExtResource("1")
templates = Array[Resource]([SubResource("CreatureTemplateDef_1"), SubResource("CreatureTemplateDef_2"), SubResource("CreatureTemplateDef_3"), SubResource("CreatureTemplateDef_4"), SubResource("CreatureTemplateDef_5"), SubResource("CreatureTemplateDef_6"), SubResource("CreatureTemplateDef_7")])
