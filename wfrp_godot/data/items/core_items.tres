item_name = "Troll Hide"
category = "Trophy"
availability = "Exotic"
price_pennies = 180
encumbrance = 3
summary = "A thick, warty hide that was still regrowing when it was taken — genuinely difficult to come by intact, and worth a small fortune to the right tanner."

[sub_resource type="Resource" id="ItemDef_56"]
script = ExtResource("2")
item_name = "Ogre Tooth"
category = "Trophy"
availability = "Rare"
price_pennies = 85
encumbrance = 1
summary = "A single tooth the size of a dagger, pulled from an Ogre's jaw — a favourite trophy among mercenaries who like to boast."

[sub_resource type="Resource" id="ItemDef_57"]
script = ExtResource("2")
item_name = "Troll Hide"
category = "Trophy"
availability = "Exotic"
price_pennies = 180
encumbrance = 3
summary = "A thick, warty slab of troll hide — genuinely difficult to obtain intact, since most of what's underneath tends to still be regenerating when you take it."

[sub_resource type="Resource" id="ItemDef_58"]
script = ExtResource("2")
item_name = "Giant's Tooth"
category = "Trophy"
availability = "Exotic"
price_pennies = 300
encumbrance = 2
summary = "A tooth the size of a dagger, pulled from something that could have flattened a house — undeniable proof of a genuinely dangerous kill."

[sub_resource type="Resource" id="ItemDef_59"]
script = ExtResource("2")
item_name = "Cultist's Sigil"
category = "Trophy"
availability = "Scarce"
price_pennies = 40
encumbrance = 0
summary = "A crude, unsettling brass sigil found on the body — worth something to a witch hunter as evidence, and worth a great deal more to keep away from anyone else."

[sub_resource type="Resource" id="ItemDef_60"]
