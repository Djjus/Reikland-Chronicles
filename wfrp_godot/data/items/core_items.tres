item_name = "Stolen Idol"
category = "Trophy"
availability = "Exotic"
price_pennies = 0
encumbrance = 1
summary = "A small, worn stone idol, carved smooth by generations of hands — sacred to Giessingen, and worth far more to the village than any coin. Not for sale."

