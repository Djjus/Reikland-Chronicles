[resource]
script = ExtResource("3_rf4vd")
quest_id = "gotheim"
quest_title = "The Ruin of Gotheim"
quest_summary = "A trading village lies in ruins, its survivors driven half-mad by whatever tore through it in the night. Some can still be reasoned with, if there's time."
npcs = Array[ExtResource("2_r2lyl")]([SubResource("Resource_emfb5"), SubResource("Resource_6wbpu"), SubResource("Resource_tl246"), SubResource("Resource_kqn70"), SubResource("Resource_2af2s"), SubResource("Resource_jvji1"), SubResource("Resource_71epq"), SubResource("Resource_4jhvj"), SubResource("Resource_spm8x")])
timeline_events = Array[ExtResource("4_obc41")]([SubResource("Resource_37usk"), SubResource("Resource_r2lyl"), SubResource("Resource_rf4vd"), SubResource("Resource_obc41"), SubResource("Resource_fw816"), SubResource("Resource_jtdnd"), SubResource("Resource_lrfha"), SubResource("Resource_romtp"), SubResource("Resource_7wtk6"), SubResource("Resource_oxmmy"), SubResource("Resource_1t5aw"), SubResource("Resource_eb4s4"), SubResource("Resource_amqeh"), SubResource("Resource_58677")])
monsters = Array[ExtResource("1_37usk")]([SubResource("Resource_3bttp")])
win_conditions = Array[ExtResource("5_fw816")]([SubResource("Resource_orx8l"), SubResource("Resource_qaukp"), SubResource("Resource_pfc50")])
