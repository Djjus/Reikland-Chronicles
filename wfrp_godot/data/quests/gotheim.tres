[sub_resource type="Resource" id="Resource_3bttp"]
script = ExtResource("1_37usk")
monster_id = "beast"
monster_name = "Jabberslythe"
starting_wounds = 15
starting_conditions = {
"Bleeding": 4,
"Blinded": 3,
"Fatigued": 3
}

[sub_resource type="Resource" id="Resource_emfb5"]
script = ExtResource("2_r2lyl")
npc_id = "wilhelm"
npc_name = "Wilhelm Kreigrisch, the Reeve"
intro_text = "An old man stands balanced on the sill of a shattered upper window, one hand gripping the frame, the other waving off a woman who clings to his sleeve and begs him down. \"It's the only way out,\" he mutters, over and over, eyes fixed on the drop below. \"The only way out.\" He does not seem to hear her at all — nor, yet, you."
skill_name = "Charm"
difficulty = -10
pass_text = "Something in your voice reaches him before your hand does. He turns, and for a moment the wild fear in his eyes gives way to something almost like recognition — the world returning to a man who'd left it. He climbs down from the sill on his own, then collapses to the floorboards, shaking, and does not try to rise again for a long while."
fail_text = "He doesn't hear you — or if he does, it isn't enough. He steps from the sill before anyone can stop him. The fall should have been survivable, if he'd kept his wits, but a man with none left rarely lands well. He does not rise again."
already_resolved_text = "The old reeve sits where you left him, staring at nothing in particular. Whatever help he still needs, it isn't from you — not right now."
quest_concluded_text = "\"It's over,\" Wilhelm says quietly. \"Whatever's left of that thing in the woods, it's not our problem to bury anymore. Gotheim owes you for that, stranger.\""
fail_removes_npc = true
pass_condition = "Fatigued"
reward_xp = 10
timeout_minutes = 30
timeout_text = "You arrive too late. A crowd has already gathered beneath the shattered window, and their silence tells you everything you need to know before you see him."

[sub_resource type="Resource" id="Resource_6wbpu"]
script = ExtResource("2_r2lyl")
npc_id = "smith"
npc_name = "Hugo Schmidt, the Blacksmith"
intro_text = "A big man in a scorched leather apron feeds log after log into a furnace already roaring far past any working need, sweat and soot streaking his face in equal measure. \"Can't let it go out,\" he mutters to no one in particular. \"Can't let it go out, can't let it go out.\" The heat coming off the forge is already making the walls smoke."
skill_name = "Intimidate"
difficulty = -10
pass_text = "Your voice cracks through his fixation like a slap. He blinks, staring at the furnace as though seeing it — really seeing it — for the first time since the attack, and lurches into motion, dragging burning logs clear with his bare, blistered hands rather than let the forge take the rest of the village with it."
fail_text = "He barely seems to register you at all, muttering his same words back at the flames. Whatever grip fear has on him, it isn't loosening today."
already_resolved_text = "Hugo sits slumped against the cold forge wall, hands wrapped in someone's torn shirt, staring at nothing."
quest_concluded_text = "Hugo sets down his hammer. \"Heard the beast's dealt with. Good. Man can finally get some sleep.\""
reward_xp = 10

[sub_resource type="Resource" id="Resource_tl246"]
script = ExtResource("2_r2lyl")
npc_id = "emil"
npc_name = "Emil Brauer, the Brewer"
intro_text = "A short, heavily-bearded man sits slumped in the corner of the forge, arms wrapped around his knees, muttering into his own beard. He flinches every time Hugo raises his voice, but doesn't move, doesn't help, doesn't leave — just sits, and mutters, and flinches."
skill_name = "Intimidate"
difficulty = -10
pass_text = "A sharp word snaps him out of it. He scrambles upright, blinking, and for a moment looks almost embarrassed — then immediately starts complaining, about his aching head, about the smoke, about anything within reach. It isn't dignity, exactly. But it's better than the corner."
fail_text = "He flinches at your voice same as he flinches at everything else, and curls a little tighter into himself. Whatever's got hold of him, a raised voice alone isn't enough to shake it loose."
already_resolved_text = "Emil trails after whoever's nearby, muttering complaints about his head, the smoke, the state of everything — but on his feet, at least, and no longer curled in the corner."
quest_concluded_text = "Emil raises a half-empty tankard. \"To the end of it, eh? Whatever it takes to forget that sound.\""
reward_xp = 10

[sub_resource type="Resource" id="Resource_kqn70"]
script = ExtResource("2_r2lyl")
npc_id = "kai"
npc_name = "Kai Bauerr, the Builder"
intro_text = "A young man hauls split logs from the woodpile outside and feeds them into the forge's furnace, over and over, without any apparent plan beyond staying busy. He glances up as you approach — not panicked, exactly, just uncertain, the way someone looks when they're waiting to be told what happens next."
pass_text = "He listens carefully, nods along to whatever sensible thing you tell him, and does it without argument — grateful, if anything, to have a plan that isn't just his own."
already_resolved_text = "Kai keeps himself busy nearby, glancing over now and then, ready to help with whatever's needed next."
quest_concluded_text = "Kai just nods, still measuring timber for the forge's own repairs."
reward_xp = 5

[sub_resource type="Resource" id="Resource_2af2s"]
script = ExtResource("2_r2lyl")
npc_id = "bruno"
npc_name = "Bruno Bäcker, the Baker"
intro_text = "A handsome, cheerful-looking man works the bellows with real enthusiasm, occasionally barking out a snatch of some marching song before catching himself mid-verse. \"This is the life, eh!\" he calls to no one, grinning too widely for the circumstances. Something about his cheer doesn't quite reach his eyes."
skill_name = "Charm"
difficulty = 40
pass_text = "A friendly word is all it takes — he lights up properly this time, falls in beside you, and keeps up a steady stream of encouragement and half-remembered song lyrics, equally useful and equally exhausting."
fail_text = "He nods along without really hearing you, already three words into another verse of something about a hammer and a skull."
already_resolved_text = "Bruno trails along nearby, humming, offering the occasional \"we're doing great, lads!\" whether or not anything is, in fact, going great."
quest_concluded_text = "\"Bread's rising again, first time in weeks,\" Bruno says. \"That's your doing, I hear.\""
reward_xp = 10

[sub_resource type="Resource" id="Resource_jvji1"]
script = ExtResource("2_r2lyl")
npc_id = "martha"
npc_name = "Martha Scheren, the Barber Surgeon"
intro_text = "An elderly woman stands at the temple's lectern, scribbling in the margins of an old book, murmuring under her breath. Nearby, three children race in circles around the dais, laughing, utterly unbothered by the devastation outside. She watches them the way a woman watches something she's about to spend."
skill_name = "Intimidate"
difficulty = -30
pass_text = "Whatever plan had taken root in her breaks all at once. She curls in on herself, shaking, and the fight goes out of her — replaced by something quieter and sadder, but no longer dangerous to the children still playing nearby."
fail_text = "She meets your anger with a thin, placating smile and murmured agreement — the practiced calm of someone who has already decided not to be talked out of anything, and is simply waiting for you to leave."
already_resolved_text = "Martha sits apart from the children now, quiet, her book closed in her lap."
quest_concluded_text = "Martha wipes her hands on her apron. \"The wounded are healing. That's all that matters to me now.\""
reward_xp = 15

[sub_resource type="Resource" id="Resource_71epq"]
script = ExtResource("2_r2lyl")
npc_id = "children"
npc_name = "Perle, Schneck, and Kal"
intro_text = "Three children race in noisy circles around the temple's own dais — a girl of about seven with dark braids, a snot-nosed younger boy, and an older boy with a shock of pale hair — utterly delighted with themselves, and utterly unbothered by the carnage outside. They compete loudly over whose account of \"the monster\" is more thrilling."
pass_text = "They quiet down readily enough once a real adult actually talks to them instead of past them — still bursting with lurid, competing theories about the monster, but willing, for now, to stay put and stay out of trouble."
already_resolved_text = "The three children stay close together near the temple, subdued now, occasionally whispering their own versions of the story to each other."
quest_concluded_text = "Perle, Schneck, and Kal are back to chasing each other around the well, like nothing ever happened."
reward_xp = 10

[sub_resource type="Resource" id="Resource_4jhvj"]
script = ExtResource("2_r2lyl")
npc_id = "gerd"
npc_name = "Gerd Fleisher, the Butcher"
intro_text = "A big, heavy-set man hacks at the old levee with a pick, sweat-soaked and single-minded, muttering about flooding \"the circle\" before whatever's out there gets away. He doesn't look up as you approach. He doesn't look like he's going to stop, either."
skill_name = "Strength"
difficulty = -20
pass_text = "It takes real effort — hauling him bodily away from the levee while he curses and strains against you — but he's spent, in the end, more than he's dangerous. He slumps, breathing hard, still muttering about the circle, but the pick stays down."
fail_text = "He's stronger than his grief has any right to leave him, and shakes free before you can properly get a grip. Whatever's driving him, it isn't finished with him yet."
already_resolved_text = "Gerd sits well back from the levee now, watching it the way a man watches something he still doesn't quite trust himself around."
quest_concluded_text = "Gerd stands a little straighter these days. \"Levee's holding. We'll manage the rest ourselves.\""
reward_xp = 15
reroute_if_npc_id = "martha"
reroute_text = "Gerd wipes sweat from his brow and squints east, toward the trees. \"I — I saw it land somewhere out that way, I think. Might've been the circle. Might've been further.\" He shakes his head, frustrated with himself. \"Ask old Martha, up at the temple. She was closer to it than I ever was. She'll know better than me.\""

[sub_resource type="Resource" id="Resource_spm8x"]
script = ExtResource("2_r2lyl")
npc_id = "maria"
npc_name = "Maria Bäcker, the Baker"
intro_text = "An elderly woman with a head of curling, greying red hair hovers near the levee, wringing her hands, agreeing with everything Gerd says the moment he says it. With him out of earshot for once, she seems smaller — confused, more than convinced, as if she's not entirely sure why she's here."
skill_name = "Charm"
pass_text = "Away from Gerd's own certainty, hers crumbles easily — she blinks, looks around at the levee as though seeing it for the first time, and lets herself be led gently away from it."
fail_text = "She nods along to whatever you say, agreeable as ever, but her feet don't move — some part of her still waiting for Gerd to tell her what happens next."
already_resolved_text = "Maria stays close to wherever Gerd ended up, quiet now, no longer insisting on anything."
quest_concluded_text = "Maria's back at her own oven. \"Things are quieter now. Thank you for that.\""
reward_xp = 10

[sub_resource type="Resource" id="Resource_37usk"]
script = ExtResource("4_obc41")
event_id = "distant_howl"
trigger_minutes = 15
description = "Somewhere beyond the broken palisade, something enormous exhales a long, wet, bubbling groan — pained, patient, and utterly inhuman. It doesn't sound close. It doesn't sound far away either."

[sub_resource type="Resource" id="Resource_r2lyl"]
script = ExtResource("4_obc41")
event_id = "forge_fire"
trigger_minutes = 60
description = "Word reaches you on the wind before you see the glow: the forge has finally gone up in earnest. By the time anyone could reach it, there's nothing left to save — Hugo, Emil, Kai, and Bruno were all still inside."
cancel_if_npc_id = "smith"
kills_npc_ids = Array[String](["smith", "emil", "kai", "bruno"])

[sub_resource type="Resource" id="Resource_rf4vd"]
script = ExtResource("4_obc41")
event_id = "martha_leaves"
trigger_minutes = 90
description = "The temple stands empty. Martha is gone — and so are the children. Whatever she led them into the forest to escape, none of them are coming back."
cancel_if_npc_id = "martha"
kills_npc_ids = Array[String](["martha", "children"])

[sub_resource type="Resource" id="Resource_obc41"]
script = ExtResource("4_obc41")
event_id = "levee_breaks"
trigger_minutes = 105
description = "A distant, grinding roar rolls down from the north — the levee has given way at last. Whatever was still standing in Gotheim, the flood is taking the rest."
cancel_if_npc_id = "gerd"
triggers_flood = true

