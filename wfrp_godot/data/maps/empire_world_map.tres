[sub_resource type="Resource" id="Resource_37bd7"]
script = ExtResource("3_7pdjj")
province_name = "Nordland"
label_tile = Vector2i(13, 3)
bounds = Rect2i(10, 1, 32, 12)
summary = "The Empire's northernmost province, a windswept coastal land bordering the Sea of Claws — its people are hardy sailors and fishermen."

[sub_resource type="Resource" id="Resource_1n5xq"]
script = ExtResource("3_7pdjj")
province_name = "Ostland"
label_tile = Vector2i(48, 4)
bounds = Rect2i(42, 1, 28, 13)
summary = "A rugged eastern province of dense forest and old feuds, its knights famed for holding the border against raiders from the wilds."

[sub_resource type="Resource" id="Resource_3pobx"]
script = ExtResource("3_7pdjj")
province_name = "Middenland"
label_tile = Vector2i(12, 20)
bounds = Rect2i(10, 13, 20, 9)
summary = "Home to the great city of Middenheim, City of the White Wolf — a proud, martial province at the Empire's own spiritual heart."

[sub_resource type="Resource" id="Resource_nid3v"]
script = ExtResource("3_7pdjj")
province_name = "Hochland"
label_tile = Vector2i(29, 15)
bounds = Rect2i(28, 13, 12, 9)
summary = "A hilly, forested province known for fine longrifles and stubborn independence, wedged between larger, louder neighbours."

[sub_resource type="Resource" id="Resource_mo0mg"]
script = ExtResource("3_7pdjj")
province_name = "Talabecland"
label_tile = Vector2i(43, 12)
bounds = Rect2i(30, 13, 22, 11)
summary = "A province of deep woodland and river trade along the Talabec, its capital Talabheim built inside a great meteor crater."

[sub_resource type="Resource" id="Resource_7l12i"]
script = ExtResource("3_7pdjj")
province_name = "Ostermark"
label_tile = Vector2i(63, 26)
bounds = Rect2i(50, 10, 20, 22)
summary = "A hard eastern frontier province, its people used to war — the Worlds Edge Mountains loom close on every horizon here."

[sub_resource type="Resource" id="Resource_1354s"]
script = ExtResource("3_7pdjj")
province_name = "Stirland"
label_tile = Vector2i(46, 33)
bounds = Rect2i(42, 24, 16, 14)
summary = "A province of dark forest and old graves, uncomfortably close to the tainted lands of Sylvania to its own east."

[sub_resource type="Resource" id="Resource_q5174"]
script = ExtResource("3_7pdjj")
province_name = "Mootland"
label_tile = Vector2i(60, 22)
bounds = Rect2i(54, 24, 10, 8)
summary = "A small, fertile province of halfling farms — the Empire's own breadbasket, more concerned with harvests than politics."

[sub_resource type="Resource" id="Resource_c506k"]
script = ExtResource("3_7pdjj")
province_name = "Averland"
label_tile = Vector2i(44, 40)
bounds = Rect2i(36, 32, 14, 10)
summary = "Rolling farmland and grazing country along the river Aver, its counts historically rivals for the Imperial throne itself."

[sub_resource type="Resource" id="Resource_n2t24"]
script = ExtResource("3_7pdjj")
province_name = "Wissenland"
label_tile = Vector2i(26, 44)
bounds = Rect2i(22, 36, 20, 10)
summary = "The former Realm of Solland, a southern province of quiet farms still shadowed by the old kingdom's own fall."

[sub_resource type="Resource" id="Resource_p5jek"]
script = ExtResource("3_7pdjj")
province_name = "Reikland"
label_tile = Vector2i(8, 26)
bounds = Rect2i(6, 20, 24, 16)
summary = "The Empire's own heartland, home to Altdorf and the Imperial throne — the most populous and powerful of all the provinces."

