[resource]
script = ExtResource("1")
head_table = [{"min": 1, "max": 3, "name": "Dramatic Injury", "wounds": "T", "flavor": "A prink to the cheek.", "conditions": {"Bleeding": 1}, "penalty": {}, "test_or_condition": {}, "amputation": ""}, {"min": 4, "max": 6, "name": "Rattling Blow", "wounds": 1, "flavor": "The blow floods your vision with flashing lights.", "conditions": {"Stunned": 1}, "penalty": {}, "test_or_condition": {}, "amputation": ""}, {"min": 7, "max": 9, "name": "Poked Eye", "wounds": 1, "flavor": "The blow glances across your eye socket.", "conditions": {"Blinded": 1}, "penalty": {}, "test_or_condition": {}, "amputation": ""}, {"min": 10, "max": 15, "name": "Ear Bash", "wounds": 1, "flavor": "Your ear is left ringing.", "conditions": {"Deafened": 1}, "penalty": {}, "test_or_condition": {}, "amputation": ""}, {"min": 16, "max": 20, "name": "Minor Cut", "wounds": 1, "flavor": "The strike opens your cheek.", "conditions": {"Bleeding": 1}, "penalty": {}, "test_or_condition": {}, "amputation": ""}, {"min": 21, "max": 25, "name": "Black Eye", "wounds": 2, "flavor": "A blow glances your eye.", "conditions": {"Blinded": 2}, "penalty": {}, "test_or_condition": {}, "amputation": ""}, {"min": 26, "max": 30, "name": "Sliced Ear", "wounds": 2, "flavor": "A blow cuts into your ear.", "conditions": {"Deafened": 2, "Bleeding": 1}, "penalty": {}, "test_or_condition": {}, "amputation": ""}, {"min": 31, "max": 35, "name": "Struck Forehead", "wounds": 2, "flavor": "A solid blow strikes your forehead — the Blindness won't lift until every Bleeding Condition is healed.", "conditions": {"Bleeding": 2, "Blinded": 1}, "penalty": {}, "test_or_condition": {}, "amputation": ""}, {"min": 36, "max": 40, "name": "Fractured Jaw", "wounds": 2, "flavor": "The blow fractures your jaw. Suffer a Broken Bone (Minor) injury.", "conditions": {"Stunned": 2, "Broken Bone (Minor)": 1}, "penalty": {}, "test_or_condition": {}, "amputation": ""}, {"min": 41, "max": 45, "name": "Major Eye Wound", "wounds": 3, "flavor": "A blow strikes 